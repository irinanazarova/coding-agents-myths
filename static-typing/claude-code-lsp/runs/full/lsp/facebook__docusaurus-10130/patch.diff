+  // Find the collected data of the target page of a link
+  // Links may not have the exact same trailing slash as the rendered page
+  // See https://github.com/facebook/docusaurus/issues/10116
+  function getTargetPage(pathname: string) {
+    const decodedPathname = decodeURI(pathname);
+    const candidates = _.uniq([
+      pathname,
+      decodedPathname,
+      addTrailingSlash(pathname),
+      removeTrailingSlash(pathname),
+      addTrailingSlash(decodedPathname),
+      removeTrailingSlash(decodedPathname),
+    ]);
+    for (const candidate of candidates) {
+      const page = collectedLinks.get(candidate);
+      if (page) {
+        return page;
+      }
+    }
+    // Fallback: find the route matching the link and use its path
+    for (const candidate of [pathname, decodedPathname]) {
+      const matches = matchRoutes(routes, candidate);
+      for (const match of matches) {
+        const page = collectedLinks.get(match.route.path as string);
+        if (page) {
+          return page;
+        }
+      }
+    }
+    return undefined;
+  }
