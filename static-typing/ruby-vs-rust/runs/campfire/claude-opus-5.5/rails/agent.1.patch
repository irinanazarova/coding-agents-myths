diff --git a/docs/bots.md b/docs/bots.md
new file mode 100644
index 0000000..088acd9
--- /dev/null
+++ b/docs/bots.md
@@ -0,0 +1,55 @@
+## Chat bots
+
+Bots are `User` records with the `bot` role (`User::Role`). Everything else, like memberships,
+avatars, message authorship, broadcasts, and push notifications, is the same as for people. So a
+bot automatically joins every open room (`User#grant_membership_to_open_rooms`), and it can be
+added to closed rooms or direct rooms like anyone else.
+
+### Data
+
+- `users.bot_token`: a random 24-character alphanumeric secret (unique index). It's `nil` for
+  people and for deleted bots.
+- `users.creator_id`: the person who created the bot. `User#bots` lists the bots someone owns.
+  There's no DB-level foreign key, because `User.destroy_all` (used in tests) would trip over the
+  self-reference. Instead, `has_many :bots, dependent: :nullify` handles it.
+- `users.password_digest` is nullable, because bots have no password or email, so they can't sign in.
+
+### Bot code (bot key)
+
+The "Bot code" shown in the UI is `User#bot_key`, which is `"<id>-<bot_token>"`.
+`User.authenticate_bot(key)` looks the bot up by id among *active* bots and compares the token
+with `secure_compare`. Banned or deactivated bots, and people, never authenticate.
+
+The bot code is a credential:
+- Only the creator and administrators can see it: `BotsController#manageable_bots` scopes every
+  action, and anyone else gets a 404.
+- The bots pages are sent with `Cache-Control: no-store` and `turbo-cache-control: no-cache`.
+- `bot_key` is filtered from logged params (it matches `_key` in `filter_parameters`), and
+  `lib/rails_ext/filtered_bot_key_path.rb` masks the key in the request path, which Rails logs
+  in its "Started POST …" line.
+
+### Posting API
+
+`POST /rooms/:room_id/:bot_key/messages` → `Messages::ByBotsController#create`
+(route helper: `room_bot_messages_url(room, bot.bot_key)`).
+
+- `Authentication.allow_bot_access` skips session auth and CSRF protection, then sets
+  `Current.user` to the authenticated bot. If the key is invalid, it returns `401`.
+- If the room isn't one of the bot's rooms (or doesn't exist), it returns `404`.
+- The raw request body (`request.raw_post`) becomes the message body. This works with
+  `curl -d`, even though curl sends it form-encoded. For multipart requests, the `attachment`
+  field (plus an optional `body` field) is used instead.
+- An empty body with no attachment returns `422`. On success it returns `201` with
+  `Location: /messages/:id`.
+- It reuses `create_with_attachment!` and `broadcast_create`, and `Message`'s
+  `after_create_commit` → `Room#receive` (unread state and web push), so bot messages behave
+  exactly like human ones.
+
+### UI
+
+- `/account/edit` has a nav link (bot icon), "Set up chat bots", that goes to `/bots`.
+- `/bots` (`BotsController`) has index/new/create/edit/update/destroy and shows every bot on
+  one page. "Delete" deactivates the bot through `User#deactivate`: memberships are removed,
+  `bot_token` is cleared, and the bot's past messages stay.
+- Bots are left out of people-oriented lists: the account users list (`AccountsController`,
+  `Accounts::UsersController`) and the sidebar's direct-message placeholders.
diff --git a/lib/rails_ext/filtered_bot_key_path.rb b/lib/rails_ext/filtered_bot_key_path.rb
new file mode 100644
index 0000000..d3def4f
--- /dev/null
+++ b/lib/rails_ext/filtered_bot_key_path.rb
@@ -0,0 +1,11 @@
+# Bot keys travel in the URL path (/rooms/:room_id/:bot_key/messages), which parameter filtering
+# doesn't cover. Mask them in the filtered path so they don't end up in request logs.
+module FilteredBotKeyPath
+  BOT_KEY_PATH = %r{\A(/rooms/[^/]+/)[^/?]+(/messages/?)(?=\?|\z)}
+
+  def filtered_path
+    @filtered_bot_key_path ||= super.sub(BOT_KEY_PATH, '\1[FILTERED]\2')
+  end
+end
+
+ActionDispatch::Request.prepend FilteredBotKeyPath
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..ea85b6c
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:deploy_bot)
+  end
+
+  test "index lists the bots created by the current user" do
+    sign_in :kevin
+
+    get bots_url
+    assert_response :success
+    assert_select "##{dom_id(@bot)}" do
+      assert_select "strong", text: "Deploy Bot"
+      assert_select "input[readonly][aria-label='Bot code'][value=?]", @bot.bot_key
+      assert_select "a[href=?]", edit_bot_path(@bot), text: "Edit Deploy Bot"
+    end
+    assert_includes response.headers["Cache-Control"], "no-store"
+  end
+
+  test "index hides other people's bots from members" do
+    sign_in :jz
+
+    get bots_url
+    assert_response :success
+    assert_select "##{dom_id(@bot)}", count: 0
+    assert_no_match @bot.bot_token, response.body
+  end
+
+  test "index shows every bot to administrators" do
+    sign_in :david
+
+    get bots_url
+    assert_select "##{dom_id(@bot)}"
+  end
+
+  test "new" do
+    sign_in :jz
+
+    get new_bot_url
+    assert_response :success
+    assert_select "input[placeholder='Name the bot']"
+  end
+
+  test "create" do
+    sign_in :jz
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "CI Bot" } }
+    end
+    assert_redirected_to bots_url
+
+    bot = User.bot.last
+    assert_equal "CI Bot", bot.name
+    assert_equal users(:jz), bot.creator
+    assert bot.bot_token.present?
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+  end
+
+  test "create requires a name" do
+    sign_in :jz
+
+    assert_no_difference -> { User.count } do
+      post bots_url, params: { bot: { name: "" } }
+    end
+    assert_response :unprocessable_content
+  end
+
+  test "edit and update" do
+    sign_in :kevin
+
+    get edit_bot_url(@bot)
+    assert_response :success
+    assert_select "button", text: "Delete this chat bot"
+
+    patch bot_url(@bot), params: { bot: { name: "Release Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", @bot.reload.name
+  end
+
+  test "members can't manage other people's bots" do
+    sign_in :jz
+
+    get edit_bot_url(@bot)
+    assert_response :not_found
+
+    patch bot_url(@bot), params: { bot: { name: "Hijacked" } }
+    assert_response :not_found
+    assert_equal "Deploy Bot", @bot.reload.name
+  end
+
+  test "administrators can manage any bot" do
+    sign_in :david
+
+    patch bot_url(@bot), params: { bot: { name: "Release Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", @bot.reload.name
+  end
+
+  test "destroy" do
+    sign_in :kevin
+
+    delete bot_url(@bot)
+    assert_redirected_to bots_url
+
+    @bot.reload
+    assert @bot.deactivated?
+    assert_nil @bot.bot_token
+    assert_nil User.authenticate_bot("#{@bot.id}-5cJgJ4F2yZQ8t7mWb3kR9xHd")
+  end
+end
diff --git a/test/controllers/messages/by_bots_controller_test.rb b/test/controllers/messages/by_bots_controller_test.rb
new file mode 100644
index 0000000..3f45f59
--- /dev/null
+++ b/test/controllers/messages/by_bots_controller_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Messages::ByBotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+
+    @bot = users(:deploy_bot)
+    @room = rooms(:watercooler)
+  end
+
+  test "create posts the raw request body as a message by the bot" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Deploy of v1.2.3 finished ✅"
+    end
+
+    message = Message.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.location
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+    assert_equal @bot, message.creator
+  end
+
+  test "create keeps the raw body intact for form-encoded requests" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "a+b=c&d", headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal "a+b=c&d", Message.last.plain_text_body
+  end
+
+  test "create broadcasts the message and notifies the room" do
+    assert_enqueued_jobs 1, only: Room::PushMessageJob do
+      assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+        post room_bot_messages_url(@room, @bot.bot_key), params: "Hello from a bot"
+      end
+    end
+  end
+
+  test "create with an attachment" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+    end
+
+    assert_response :created
+    assert Message.last.attachment.attached?
+  end
+
+  test "create with an empty body" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: ""
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "create in an unknown room" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(room_id: "nope", bot_key: @bot.bot_key), params: "Hello"
+    end
+
+    assert_response :not_found
+  end
+
+  test "create in a room the bot isn't a member of" do
+    post room_bot_messages_url(rooms(:designers), @bot.bot_key), params: "Hello"
+    assert_response :not_found
+  end
+
+  test "create with an invalid bot key" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, "#{@bot.id}-wrong"), params: "Hello"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "create with a regular user's id" do
+    post room_bot_messages_url(@room, "#{users(:david).id}-"), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "create by a deleted bot" do
+    bot_key = @bot.bot_key
+    @bot.deactivate
+
+    post room_bot_messages_url(@room, bot_key), params: "Hello"
+    assert_response :unauthorized
+  end
+end
