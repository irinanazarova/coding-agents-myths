diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..602c81a
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,55 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :prevent_caching_of_bot_keys
+
+  def index
+    @bots = manageable_bots.with_attached_avatar.ordered
+  end
+
+  def new
+    @bot = User.new(role: :bot)
+  end
+
+  def create
+    @bot = User.create_bot!(bot_params.merge(creator: Current.user))
+    redirect_to bots_url
+  rescue ActiveRecord::RecordInvalid => error
+    @bot = error.record
+    render :new, status: :unprocessable_content
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.deactivate
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      head :not_found unless @bot = manageable_bots.find_by(id: params[:id])
+    end
+
+    # Administrators manage every bot; everybody else only the bots they created.
+    def manageable_bots
+      Current.user.administrator? ? User.active.bot : Current.user.bots.active
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+
+    # Bot keys are credentials, so pages that show them shouldn't linger in any cache.
+    def prevent_caching_of_bot_keys
+      no_store
+    end
+end
