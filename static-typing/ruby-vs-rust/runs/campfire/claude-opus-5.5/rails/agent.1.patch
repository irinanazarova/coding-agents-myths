--- /dev/null
+++ b/app/views/bots/index.html.erb
@@ -0,0 +1,38 @@
+<% @page_title = "Chat bots" %>
+
+<% content_for :head do %>
+  <meta name="turbo-cache-control" content="no-cache">
+<% end %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to edit_account_path %>
+  </div>
+<% end %>
+
+<section class="panel flex flex-column gap" style="view-transition-name: bots">
+  <div class="txt-align-center pad-inline-double margin-inline">
+    <h1 class="margin-none">Chat bots</h1>
+    <p class="margin-none-block-end">
+      Bots post messages to their rooms with a simple HTTP request. The request body becomes the message:
+    </p>
+    <pre class="input input--code txt-small txt-align-start" style="overflow-x: auto; white-space: pre"><code>curl -d "Hello from a bot" <%= root_url.chomp("/") %>/rooms/&lt;room-id&gt;/&lt;bot-code&gt;/messages</code></pre>
+    <p class="flex align-center justify-center gap margin-none txt-small" style="--column-gap: 0.5ch">
+      <%= image_tag "alert.svg", class: "flex-inline colorize--black", size: 16, aria: { hidden: "true" } %>
+      <span>Keep bot codes secret: anyone with a bot code can post as that bot.</span>
+    </p>
+  </div>
+
+  <%= link_to new_bot_path, class: "btn btn--reversed center txt-large" do %>
+    <%= image_tag "add.svg", aria: { hidden: "true" }, size: 20 %>
+    <span class="for-screen-reader">Add a chat bot</span>
+  <% end %>
+
+  <% if @bots.any? %>
+    <div class="margin-block pad-inline pad-block fill-shade border-radius">
+      <menu class="flex flex-column gap margin-none pad" id="bots">
+        <%= render partial: "bots/bot", collection: @bots %>
+      </menu>
+    </div>
+  <% end %>
+</section>
