diff --git a/app/models/webhook.rb b/app/models/webhook.rb
new file mode 100644
index 0000000..30f3762
--- /dev/null
+++ b/app/models/webhook.rb
@@ -0,0 +1,106 @@
+require "net/http"
+
+# A bot's HTTP callback. When someone mentions the bot, the message is POSTed to the webhook as JSON
+# (see #payload), and a `200` text/plain or text/html response is posted back into the room as the
+# bot's reply. Delivery always happens in a job (Webhook::DeliveryJob), never during the request
+# that created the message.
+class Webhook < ApplicationRecord
+  ENDPOINT_TIMEOUT = 7.seconds
+  MAX_REPLY_SIZE = 1.megabyte
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ]
+  NETWORK_ERRORS = [ Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError ]
+
+  belongs_to :user
+
+  normalizes :url, with: ->(url) { url.strip }
+
+  validate :url_must_be_http
+
+  def deliver_later(message)
+    Webhook::DeliveryJob.perform_later(self, message)
+  end
+
+  def deliver(message)
+    if deliverable_to?(message.room)
+      response = post(payload_for(message))
+      reply_to(message.room, response)
+    end
+  rescue *NETWORK_ERRORS => error
+    Rails.logger.info "Webhook for bot #{user_id} failed: #{error.class} #{error.message}"
+    nil
+  end
+
+  def payload_for(message)
+    {
+      event: "mention",
+      author: { id: message.creator.id, name: message.creator.name },
+      room: { id: message.room.id, name: message.room.name, reply_to: url_helpers.room_bot_messages_path(message.room, user.bot_key) },
+      message: {
+        id: message.id,
+        body: { text: text_addressed_to_bot(message), html: message.body.body&.to_html.to_s },
+        link: url_helpers.room_at_message_path(message.room, message)
+      }
+    }
+  end
+
+  private
+    def url_must_be_http
+      uri = URI.parse(url.to_s)
+      errors.add :url, "must be an http:// or https:// address" unless uri.is_a?(URI::HTTP) && uri.host.present?
+    rescue URI::InvalidURIError
+      errors.add :url, "is not a valid address"
+    end
+
+    # A deactivated or banned bot, or one that has left the room, doesn't get called (or reply).
+    def deliverable_to?(room)
+      user.active? && user.bot_key.present? && user.memberships.exists?(room: room)
+    end
+
+    def post(payload)
+      uri = URI.parse(url)
+
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: ENDPOINT_TIMEOUT, read_timeout: ENDPOINT_TIMEOUT, write_timeout: ENDPOINT_TIMEOUT) do |http|
+        request = Net::HTTP::Post.new(uri, "Content-Type" => "application/json", "Accept" => REPLY_CONTENT_TYPES.join(", "))
+        request.body = payload.to_json
+        http.request(request)
+      end
+    end
+
+    # 200 with a text/plain or text/html body becomes the bot's message. Anything else (204,
+    # errors, other content types, empty bodies) posts nothing.
+    def reply_to(room, response)
+      if body = reply_body_from(response)
+        room.messages.create_with_attachment!(body: body, creator: user).tap(&:broadcast_create)
+      end
+    end
+
+    def reply_body_from(response)
+      if response.is_a?(Net::HTTPOK) && response.content_type.in?(REPLY_CONTENT_TYPES)
+        text = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+
+        if text.present? && text.bytesize <= MAX_REPLY_SIZE
+          response.content_type == "text/html" ? text : plain_text_to_html(text)
+        end
+      end
+    end
+
+    def plain_text_to_html(text)
+      ERB::Util.html_escape(text.strip).gsub(/\r?\n/, "<br>")
+    end
+
+    # The message as plain text, minus the bot's own @-mention, so it reads as the command
+    # addressed to the bot.
+    def text_addressed_to_bot(message)
+      return message.plain_text_body.strip unless content = message.body.body
+
+      content
+        .render_attachments(with_full_attributes: false) { |attachment| attachment.attachable == user ? "" : attachment.to_plain_text }
+        .fragment.to_plain_text
+        .gsub(/[[:blank:]]{2,}/, " ")
+        .gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+end
