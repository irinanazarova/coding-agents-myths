new file mode 100644
index 0000000..5494b36
--- /dev/null
+++ b/app/jobs/webhook/delivery_job.rb
@@ -0,0 +1,8 @@
+class Webhook::DeliveryJob < ApplicationJob
+  # The webhook (or the message) may be gone by the time the job runs. There's nothing to deliver then.
+  discard_on ActiveJob::DeserializationError
+
+  def perform(webhook, message)
+    webhook.deliver(message)
+  end
+end
