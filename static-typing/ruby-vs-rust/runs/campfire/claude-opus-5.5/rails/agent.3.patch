+class Webhook::JoinedDeliveryJob < ApplicationJob
+  # The webhook (or the room) may be gone by the time the job runs. There's nothing to deliver then.
+  discard_on ActiveJob::DeserializationError
+
+  def perform(webhook, room)
+    webhook.deliver_joined(room)
+  end
+end
