diff --git a/docs/bots.md b/docs/bots.md
index 42cfd2d..35513cf 100644
--- a/docs/bots.md
+++ b/docs/bots.md
@@ -125,3 +125,21 @@ The reply is handled exactly like a mention reply.
 **Not SSRF-guarded on purpose:** unlike `Opengraph::Fetch`, webhook URLs may point at private or
 loopback addresses, since bots are commonly self-hosted next to Campfire (and QA uses a local
 server). If that ever changes, `RestrictedHTTP::PrivateNetworkGuard` is the tool to use.
+
+### Bots per member (limit)
+
+- `Account#settings.bots_per_member` (`has_json` integer, default `5`). It's validated as a whole
+  number ≥ 0 (`Account#bots_per_member_is_a_whole_number`). `AccountsController#update` redirects
+  back with a flash alert when it's invalid instead of raising. Administrators edit it on
+  `/account/edit` ("Bots per member", a number field that submits on change; `0` means members
+  can't create bots at all).
+- `User#can_create_bots?` (in `User::Bot`): administrators are always allowed. Everyone else needs
+  `bots.not_deactivated.count < bots_per_member`, so deleted (deactivated) bots don't count, but banned ones do.
+- Enforcement:
+  - `/bots` hides "Add a chat bot" and shows "You've reached the limit of N bots per member"
+    (`#bot_limit_reached`).
+  - `BotsController#ensure_can_create_bots` (`new`/`create`) redirects to `/bots` with an alert.
+  - A `User` create validation (`within_creators_bot_limit`, only for bots with a creator) backs
+    this up for any other code path that calls `User.create_bot!`.
+- Lowering the limit never touches existing bots: the check only runs when a bot is created, so
+  existing bots can still be edited and posted with.
diff --git a/test/controllers/accounts_controller_test.rb b/test/controllers/accounts_controller_test.rb
index 8292c6f..3c424a3 100644
--- a/test/controllers/accounts_controller_test.rb
+++ b/test/controllers/accounts_controller_test.rb
@@ -58,4 +58,37 @@ class AccountsControllerTest < ActionDispatch::IntegrationTest
     put account_url, params: { account: { name: "Different" } }
     assert_response :forbidden
   end
+
+  test "edit shows bots per member to administrators" do
+    get edit_account_url
+    assert_select "label", text: /Bots per member/
+    assert_select "input[type=number][name='account[settings][bots_per_member]'][value='5']"
+  end
+
+  test "edit hides bots per member from members" do
+    sign_in :kevin
+
+    get edit_account_url
+    assert_select "input[name='account[settings][bots_per_member]']", count: 0
+  end
+
+  test "update bots per member" do
+    put account_url, params: { account: { settings: { bots_per_member: "2" } } }
+    assert_redirected_to edit_account_url
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "update rejects an invalid bots per member" do
+    put account_url, params: { account: { settings: { bots_per_member: "-1" } } }
+    assert_redirected_to edit_account_url
+    assert flash[:alert]
+    assert_equal 5, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "non-admins cannot change bots per member" do
+    sign_in :kevin
+
+    put account_url, params: { account: { settings: { bots_per_member: "50" } } }
+    assert_response :forbidden
+  end
 end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index 6126df4..c562469 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -198,4 +198,66 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
       delete bot_url(@bot)
     end
   end
+
+  test "members at the bot limit aren't offered to add a bot" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :kevin
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_select "#bot_limit_reached", text: /reached the limit/
+  end
+
+  test "members below the bot limit are offered to add a bot" do
+    sign_in :kevin
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, text: "Add a chat bot"
+    assert_select "#bot_limit_reached", count: 0
+  end
+
+  test "members at the bot limit can't create bots" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :kevin
+
+    get new_bot_url
+    assert_redirected_to bots_url
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { bot: { name: "CI Bot" } }
+    end
+    assert_redirected_to bots_url
+    assert_match "reached the limit", flash[:alert]
+  end
+
+  test "deleted bots don't count towards the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :kevin
+    delete bot_url(@bot)
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "CI Bot" } }
+    end
+  end
+
+  test "administrators aren't limited" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    sign_in :david
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { bot: { name: "CI Bot" } }
+    end
+  end
+
+  test "lowering the limit keeps existing bots" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    sign_in :kevin
+
+    get bots_url
+    assert_select "##{dom_id(@bot)}"
+    assert @bot.reload.active?
+  end
 end
