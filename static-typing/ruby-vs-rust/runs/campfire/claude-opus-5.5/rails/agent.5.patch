+# Suspended bots (see User::Suspendable) only come back when an administrator says so.
+class Bots::ReactivationsController < ApplicationController
+  before_action :ensure_can_administer
+  before_action :set_bot
+
+  def create
+    @bot.reactivate
+    redirect_to bots_url, notice: "#{@bot.name} is active again"
+  end
+
+  private
+    def set_bot
+      @bot = User.active.bot.find(params[:bot_id])
+    end
+end
