+            aria: { label: "Webhook URL", describedby: dom_id(bot, :webhook_url_hint) }, spellcheck: false, data: { "1p-ignore": true } %>
+    </label>
+    <p class="txt-small txt-subtle txt-align-center margin-none" id="<%= dom_id(bot, :webhook_url_hint) %>">
+      Optional. When someone @-mentions this bot, Campfire POSTs the message here as JSON.
+      Reply with text or HTML to post it back into the room.
+    </p>
+  </div>
+
+  <div class="flex flex-column gap">
+    <div class="flex align-center gap pad-block-half pad-inline fill-shade border-radius">
+      <%= form.label :joins_all_open_rooms, "Add to all open rooms", class: "flex-item-grow txt-align-start" %>
+
+      <label class="switch">
+        <%= form.check_box :joins_all_open_rooms, class: "switch__input",
+              aria: { label: "Add to all open rooms", describedby: dom_id(bot, :joins_all_open_rooms_hint) } %>
+        <span class="switch__btn round"></span>
+      </label>
+    </div>
+    <p class="txt-small txt-subtle txt-align-center margin-none" id="<%= dom_id(bot, :joins_all_open_rooms_hint) %>">
+      On: the bot joins every open room, now and as new ones are created.
+      Off: add it to the rooms you choose. Turning this off keeps the rooms it's already in.
+    </p>
+  </div>
+
+  <%= form.button class: "btn btn--reversed center txt-large", type: "submit" do %>
+    <%= image_tag "check.svg", aria: { hidden: "true" }, size: 20 %>
+    <span class="for-screen-reader">Save changes</span>
+  <% end %>
+<% end %>
