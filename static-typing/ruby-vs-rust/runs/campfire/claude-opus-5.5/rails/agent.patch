@@ -0,0 +1,57 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "create bot" do
+    bot = User.create_bot!(name: "CI Bot", creator: users(:jz))
+
+    assert bot.bot?
+    assert_match /\A#{bot.id}-\w{24}\z/, bot.bot_key
+    assert_includes users(:jz).bots, bot
+  end
+
+  test "authenticate bot" do
+    bot = users(:deploy_bot)
+
+    assert_equal bot, User.authenticate_bot(bot.bot_key)
+    assert_nil User.authenticate_bot("#{bot.id}-wrong")
+    assert_nil User.authenticate_bot("#{bot.id}")
+    assert_nil User.authenticate_bot(nil)
+    assert_nil User.authenticate_bot("#{users(:david).id}-#{bot.bot_token}")
+  end
+
+  test "bots are excluded from people" do
+    assert_not_includes User.without_bots, users(:deploy_bot)
+    assert_includes User.without_bots, users(:david)
+  end
+
+  test "members can create bots up to the account's bots per member" do
+    kevin = users(:kevin)
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+
+    assert kevin.can_create_bots?
+    User.create_bot!(name: "Second Bot", creator: kevin)
+    assert_not kevin.can_create_bots?
+
+    error = assert_raises(ActiveRecord::RecordInvalid) { User.create_bot!(name: "Third Bot", creator: kevin) }
+    assert_match "reached the limit", error.message
+  end
+
+  test "deactivated bots don't count towards the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    assert_not users(:kevin).can_create_bots?
+
+    users(:deploy_bot).deactivate
+    assert users(:kevin).can_create_bots?
+  end
+
+  test "administrators can always create bots" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert users(:david).can_create_bots?
+    assert_nothing_raised { User.create_bot!(name: "Admin Bot", creator: users(:david)) }
+  end
+
+  test "lowering the limit keeps existing bots editable" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert users(:deploy_bot).update(name: "Renamed Bot")
+  end
+end
diff --git a/test/models/user/flood_control_test.rb b/test/models/user/flood_control_test.rb
new file mode 100644
index 0000000..017455b
--- /dev/null
+++ b/test/models/user/flood_control_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class User::FloodControlTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+    @room = rooms(:watercooler)
+  end
+
+  test "posts up to the limit" do
+    assert_difference -> { @bot.messages.count }, +10 do
+      10.times { post_as_bot }
+    end
+    assert_not @bot.cooling_down?
+  end
+
+  test "the message over the limit is rejected and starts a cooldown" do
+    10.times { post_as_bot }
+
+    freeze_time
+    error = assert_raises(User::FloodControl::Flooding) { post_as_bot }
+
+    assert_equal 10, @bot.messages.count
+    assert_equal 30, error.retry_after
+    assert @bot.reload.cooling_down?
+  end
+
+  test "older messages don't count" do
+    travel_to 11.seconds.ago do
+      10.times { post_as_bot }
+    end
+
+    assert_nothing_raised { post_as_bot }
+  end
+
+  test "attempts during the cooldown are rejected and report the time left" do
+    freeze_time
+    10.times { post_as_bot }
+    assert_raises(User::FloodControl::Flooding) { post_as_bot }
+
+    travel 12.seconds do
+      error = assert_raises(User::FloodControl::Flooding) { post_as_bot }
+      assert_equal 18, error.retry_after
+    end
+  end
+
+  test "posting resumes after the cooldown" do
+    10.times { post_as_bot }
+    assert_raises(User::FloodControl::Flooding) { post_as_bot }
+
+    travel 31.seconds do
+      assert_nothing_raised { post_as_bot }
+    end
+  end
+
+  test "five more attempts during the same cooldown suspend the bot" do
+    10.times { post_as_bot }
+    assert_raises(User::FloodControl::Flooding) { post_as_bot }
+
+    4.times { assert_raises(User::FloodControl::Flooding) { post_as_bot } }
+    assert_not @bot.reload.suspended?
+
+    assert_raises(User::FloodControl::Flooding) { post_as_bot }
+    assert @bot.reload.suspended?
+    assert_equal "flooding", @bot.suspension_reason
+  end
+
+  test "attempts during an earlier cooldown don't count" do
+    10.times { post_as_bot }
+    assert_raises(User::FloodControl::Flooding) { post_as_bot }
+    4.times { assert_raises(User::FloodControl::Flooding) { post_as_bot } }
+
+    travel 31.seconds do
+      10.times { post_as_bot }
+      assert_raises(User::FloodControl::Flooding) { post_as_bot }
+      4.times { assert_raises(User::FloodControl::Flooding) { post_as_bot } }
+    end
+
+    assert_not @bot.reload.suspended?
+  end
+
+  test "reactivate clears the suspension and the cooldown" do
+    @bot.update! suspended_at: Time.current, suspension_reason: "flooding", posting_cooldown_ends_at: 20.seconds.from_now, posting_attempts_during_cooldown: 5
+    webhooks(:deploy_bot).update! consecutive_failures: 10
+
+    @bot.reactivate
+
+    assert_not @bot.suspended?
+    assert_nil @bot.suspension_reason
+    assert_not @bot.cooling_down?
+    assert_equal 0, @bot.posting_attempts_during_cooldown
+    assert_equal 0, webhooks(:deploy_bot).reload.consecutive_failures
+  end
+
+  private
+    def post_as_bot
+      @bot.post_without_flooding { @room.messages.create!(creator: @bot, body: "Beep") }
+    end
+end
diff --git a/test/models/webhook_test.rb b/test/models/webhook_test.rb
new file mode 100644
index 0000000..89cfc16
--- /dev/null
+++ b/test/models/webhook_test.rb
@@ -0,0 +1,203 @@
+require "test_helper"
+
+class WebhookTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:deploy_bot)
+    @webhook = webhooks(:deploy_bot)
+    @room = rooms(:watercooler)
+  end
+
+  test "payload" do
+    message = @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(:deploy_bot)} restart the build please</div>")
+
+    payload = @webhook.payload_for(message)
+
+    assert_equal "mention", payload[:event]
+    assert_equal({ id: users(:david).id, name: "David" }, payload[:author])
+    assert_equal({ id: @room.id, name: "All Talk", reply_to: "/rooms/#{@room.id}/#{@bot.bot_key}/messages" }, payload[:room])
+    assert_equal message.id, payload[:message][:id]
+    assert_equal "restart the build please", payload[:message][:body][:text]
+    assert_match %r{\A<div>.*restart the build please</div>\z}m, payload[:message][:body][:html]
+    assert_includes payload[:message][:body][:html], "action-text-attachment"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload[:message][:link]
+  end
+
+  test "payload text keeps mentions of other people" do
+    message = @room.messages.create!(creator: users(:david), body: "<div>Hey #{mention_attachment_for(:deploy_bot)}, ping #{mention_attachment_for(:jason)} when done</div>")
+
+    assert_equal "Hey , ping @Jason when done", @webhook.payload_for(message)[:message][:body][:text]
+  end
+
+  test "deliver posts JSON and posts a text/plain reply as the bot" do
+    message = mention_bot
+
+    request = stub_request(:post, @webhook.url)
+      .with(headers: { "Content-Type" => "application/json" }) { |request| JSON.parse(request.body)["message"]["body"]["text"] == "restart" }
+      .to_return(status: 200, body: "Restarting <now>\nhang on", headers: { "Content-Type" => "text/plain; charset=utf-8" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      @webhook.deliver(message)
+    end
+
+    assert_requested request
+    reply = @room.messages.last
+    assert_equal @bot, reply.creator
+    assert_equal "Restarting <now>\nhang on", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "&lt;now&gt;"
+  end
+
+  test "deliver posts a text/html reply" do
+    message = mention_bot
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "<strong>Done</strong>", headers: { "Content-Type" => "text/html" })
+
+    @webhook.deliver(message)
+
+    assert_includes @room.messages.last.body.body.to_html, "<strong>Done</strong>"
+  end
+
+  test "deliver posts nothing for 204, errors, other content types, or empty bodies" do
+    message = mention_bot
+
+    [
+      { status: 204 },
+      { status: 500, body: "Oops", headers: { "Content-Type" => "text/plain" } },
+      { status: 200, body: '{"a":1}', headers: { "Content-Type" => "application/json" } },
+      { status: 200, body: "", headers: { "Content-Type" => "text/plain" } }
+    ].each do |response|
+      stub_request(:post, @webhook.url).to_return(**response)
+
+      assert_no_difference -> { Message.count } do
+        @webhook.deliver(message)
+      end
+    end
+  end
+
+  test "deliver survives timeouts and connection errors" do
+    message = mention_bot
+
+    stub_request(:post, @webhook.url).to_timeout
+    assert_no_difference(-> { Message.count }) { @webhook.deliver(message) }
+
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+    assert_no_difference(-> { Message.count }) { @webhook.deliver(message) }
+  end
+
+  test "deliver skips bots that left the room" do
+    message = mention_bot
+    @room.memberships.revoke_from(@bot)
+
+    @webhook.deliver(message)
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "joined payload" do
+    assert_equal({ event: "joined", room: { id: @room.id, name: "All Talk", reply_to: "/rooms/#{@room.id}/#{@bot.bot_key}/messages" } }, @webhook.joined_payload_for(@room))
+  end
+
+  test "deliver joined posts the event and posts the reply as the bot" do
+    request = stub_request(:post, @webhook.url)
+      .with(headers: { "Content-Type" => "application/json" }) { |request| JSON.parse(request.body) == { "event" => "joined", "room" => { "id" => @room.id, "name" => "All Talk", "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_key}/messages" } } }
+      .to_return(status: 200, body: "Hello, everyone!", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { @room.messages.count }, +1 do
+      Webhook::JoinedDeliveryJob.perform_now(@webhook, @room)
+    end
+
+    assert_requested request
+    assert_equal @bot, @room.messages.last.creator
+    assert_equal "Hello, everyone!", @room.messages.last.plain_text_body
+  end
+
+  test "deliver joined posts nothing for a 204" do
+    stub_request(:post, @webhook.url).to_return(status: 204)
+
+    assert_no_difference(-> { Message.count }) { @webhook.deliver_joined(@room) }
+  end
+
+  test "deliver joined skips direct rooms and rooms the bot left" do
+    direct = Rooms::Direct.create_for({ creator: users(:kevin) }, users: [ users(:kevin), @bot ])
+    @webhook.deliver_joined(direct)
+
+    @room.memberships.revoke_from(@bot)
+    @webhook.deliver_joined(@room)
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "url must be http or https" do
+    assert Webhook.new(user: @bot, url: "http://localhost:4567/hook").valid?
+    assert_not Webhook.new(user: @bot, url: "ftp://example.com").valid?
+    assert_not Webhook.new(user: @bot, url: "not a url").valid?
+    assert_not Webhook.new(user: @bot, url: "").valid?
+  end
+
+  test "failed deliveries are counted, and a successful one resets the count" do
+    message = mention_bot
+
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    3.times { @webhook.deliver(message) }
+    assert_equal 3, @webhook.reload.consecutive_failures
+
+    stub_request(:post, @webhook.url).to_return(status: 204)
+    @webhook.deliver(message)
+    assert_equal 0, @webhook.reload.consecutive_failures
+  end
+
+  test "redirects, timeouts and connection errors are failed deliveries" do
+    message = mention_bot
+
+    stub_request(:post, @webhook.url).to_return(status: 302, headers: { "Location" => "https://example.com" })
+    @webhook.deliver(message)
+    stub_request(:post, @webhook.url).to_timeout
+    @webhook.deliver(message)
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+    @webhook.deliver_joined(@room)
+
+    assert_equal 3, @webhook.reload.consecutive_failures
+  end
+
+  test "ten failed deliveries in a row suspend the bot" do
+    message = mention_bot
+    stub_request(:post, @webhook.url).to_return(status: 503)
+
+    9.times { @webhook.deliver(message) }
+    assert_not @bot.reload.suspended?
+
+    @webhook.deliver(message)
+    assert @bot.reload.suspended?
+    assert_equal "failing_webhook", @bot.suspension_reason
+  end
+
+  test "a suspended bot receives no webhooks" do
+    message = mention_bot
+    @bot.suspend :flooding
+    stub_request(:post, @webhook.url)
+
+    @webhook.reload.deliver(message)
+    @webhook.deliver_joined(@room)
+
+    assert_not_requested :post, @webhook.url
+    assert_empty message.mentioned_bot_webhooks
+  end
+
+  test "replies count towards the rate limit and aren't posted during a cooldown" do
+    message = mention_bot
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "Beep", headers: { "Content-Type" => "text/plain" })
+
+    assert_difference -> { @bot.messages.count }, +10 do
+      11.times { @webhook.deliver(message) }
+    end
