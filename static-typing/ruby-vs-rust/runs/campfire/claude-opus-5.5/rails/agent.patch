+require "test_helper"
+
+class FilteredBotKeyPathTest < ActiveSupport::TestCase
+  test "bot keys are masked in the filtered path" do
+    assert_equal "/rooms/1/[FILTERED]/messages", filtered_path("/rooms/1/2-secret/messages")
+    assert_equal "/rooms/1/[FILTERED]/messages?a=1", filtered_path("/rooms/1/2-secret/messages?a=1")
+  end
+
+  test "other paths are left alone" do
+    assert_equal "/rooms/1/messages", filtered_path("/rooms/1/messages")
+    assert_equal "/rooms/1/messages/5", filtered_path("/rooms/1/messages/5")
+  end
+
+  private
+    def filtered_path(path)
+      ActionDispatch::Request.new(Rack::MockRequest.env_for(path)).filtered_path
+    end
+end
