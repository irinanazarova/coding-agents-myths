+  # webhooks, so two bots mentioning each other can't get stuck in an endless conversation.
+  def mentioned_bot_webhooks
+    if creator.bot? || mentioned_users.none?(&:bot?)
+      Webhook.none
+    else
+      Webhook.where(user: mentionees.active.bot.not_suspended.where.not(id: creator_id)).includes(:user)
+    end
+  end
+
