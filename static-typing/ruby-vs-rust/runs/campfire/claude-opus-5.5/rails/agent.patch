diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..8f027db
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,73 @@
+# Bots are users with the `bot` role. They're created (and owned) by a person, join rooms like
+# anybody else (open rooms, though, only when set to `joins_all_open_rooms`), and post messages over
+# HTTP using their bot key ("<id>-<token>") instead of a session.
+module User::Bot
+  extend ActiveSupport::Concern
+
+  BOT_TOKEN_LENGTH = 24
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, -> { bot }, class_name: "User", foreign_key: :creator_id, inverse_of: :creator, dependent: :nullify
+    has_one :webhook, dependent: :delete, autosave: true
+
+    validates :name, presence: true, if: :bot?
+    validate :within_creators_bot_limit, on: :create, if: -> { bot? && creator }
+
+    after_update_commit :join_all_open_rooms, if: -> { bot? && saved_change_to_joins_all_open_rooms?(to: true) }
+
+    scope :without_bots, -> { where.not(role: :bot) }
+  end
+
+  class_methods do
+    def create_bot!(attributes)
+      create!(attributes.merge(role: :bot, bot_token: generate_bot_token))
+    end
+
+    def authenticate_bot(bot_key)
+      bot_id, bot_token = bot_key.to_s.strip.split("-", 2)
+
+      if bot_token.present? && (bot = active.bot.find_by(id: bot_id)) && bot.bot_token.present?
+        bot if ActiveSupport::SecurityUtils.secure_compare(bot.bot_token, bot_token)
+      end
+    end
+
+    def generate_bot_token
+      SecureRandom.alphanumeric(BOT_TOKEN_LENGTH)
+    end
+  end
+
+  # Members can own up to the account's "Bots per member" (deleted, i.e. deactivated, bots don't
+  # count); administrators aren't limited. Lowering the limit keeps existing bots, it only stops new ones.
+  def can_create_bots?
+    administrator? || bots.not_deactivated.count < Current.account.settings.bots_per_member.to_i
+  end
+
+  def bot_key
+    "#{id}-#{bot_token}" if bot_token.present?
+  end
+
+  def webhook_url
+    webhook&.url unless webhook&.marked_for_destruction?
+  end
+
+  # Set from the bot form: a URL adds or changes the webhook, a blank one removes it (on save).
+  def webhook_url=(url)
+    if url.present?
+      (webhook || build_webhook).url = url
+    else
+      webhook&.mark_for_destruction
+    end
+  end
+
+  private
+    def within_creators_bot_limit
+      errors.add :base, "You've reached the limit of bots you can have" unless creator.can_create_bots?
+    end
+
+    # "Add to all open rooms" turned on: join every open room there is now (new ones are joined as
+    # they appear, see Rooms::Open). Turning it off leaves the memberships alone.
+    def join_all_open_rooms
+      grant_membership_to_open_rooms
+    end
+end
diff --git a/app/models/user/flood_control.rb b/app/models/user/flood_control.rb
new file mode 100644
index 0000000..1e32e54
--- /dev/null
+++ b/app/models/user/flood_control.rb
@@ -0,0 +1,65 @@
+# Bots may post at most POSTING_LIMIT messages in any POSTING_PERIOD, counting both API posts and
+# webhook replies (they're all messages created by the bot). The message that goes over the limit is
+# rejected and starts a COOLDOWN, during which every attempt to post is rejected too. Too many
+# attempts during the same cooldown suspend the bot (see User::Suspendable). The limits are fixed.
+module User::FloodControl
+  extend ActiveSupport::Concern
+
+  POSTING_LIMIT = 10
+  POSTING_PERIOD = 10.seconds
+  COOLDOWN = 30.seconds
+  ATTEMPTS_DURING_COOLDOWN_BEFORE_SUSPENSION = 5
+
+  class Flooding < StandardError
+    attr_reader :retry_after
+
+    def initialize(retry_after)
+      @retry_after = retry_after
+      super "Too many messages, retry after #{retry_after} seconds"
+    end
+  end
+
+  # Yields (to post the message) unless that would flood; raises Flooding otherwise. The check runs
+  # with the bot row locked, but the message is created outside that transaction: attachments are
+  # uploaded on commit, and Message::Attachment analyzes them right away.
+  def post_without_flooding
+    allowed = with_lock do
+      if cooling_down?
+        register_attempt_during_cooldown
+        false
+      elsif posted_too_many_recently?
+        start_posting_cooldown
+        false
+      else
+        true
+      end
+    end
+
+    allowed ? yield : raise(Flooding.new(posting_cooldown_seconds_left))
+  end
+
+  def cooling_down?
+    posting_cooldown_ends_at&.future?
+  end
+
+  def posting_cooldown_seconds_left
+    cooling_down? ? [ (posting_cooldown_ends_at - Time.current).ceil, 1 ].max : 0
+  end
+
+  private
+    def posted_too_many_recently?
+      messages.where(created_at: POSTING_PERIOD.ago..).count >= POSTING_LIMIT
+    end
+
+    def start_posting_cooldown
+      update! posting_cooldown_ends_at: COOLDOWN.from_now, posting_attempts_during_cooldown: 0
+    end
+
+    def register_attempt_during_cooldown
+      increment! :posting_attempts_during_cooldown
+
+      if posting_attempts_during_cooldown >= ATTEMPTS_DURING_COOLDOWN_BEFORE_SUSPENSION
+        suspend :flooding
+      end
+    end
+end
