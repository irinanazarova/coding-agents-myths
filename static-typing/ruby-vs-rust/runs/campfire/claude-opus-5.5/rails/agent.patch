diff --git a/app/models/user/suspendable.rb b/app/models/user/suspendable.rb
new file mode 100644
index 0000000..0f488f8
--- /dev/null
+++ b/app/models/user/suspendable.rb
@@ -0,0 +1,41 @@
+# Misbehaving bots are suspended automatically: for flooding rooms (see User::FloodControl) or for a
+# webhook that keeps failing (see Webhook#record_delivery). A suspended bot stays active, so it keeps
+# its rooms and messages, its bot code still authenticates (the posting API answers `403`), and it
+# still counts towards its creator's bot limit. It gets no webhooks. Only administrators reactivate it.
+module User::Suspendable
+  extend ActiveSupport::Concern
+
+  SUSPENSION_REASONS = {
+    "flooding" => "Kept posting too many messages while it was being rate limited",
+    "failing_webhook" => "Its webhook failed #{Webhook::FAILURES_BEFORE_SUSPENSION} times in a row"
+  }
+
+  included do
+    validates :suspension_reason, inclusion: { in: SUSPENSION_REASONS.keys }, allow_nil: true
+
+    scope :suspended, -> { where.not(suspended_at: nil) }
+    scope :not_suspended, -> { where(suspended_at: nil) }
+  end
+
+  def suspended?
+    suspended_at.present?
+  end
+
+  def suspend(reason)
+    unless suspended?
+      update! suspended_at: Time.current, suspension_reason: reason.to_s
+      Rails.logger.info "Bot #{id} suspended: #{reason}"
+    end
+  end
+
+  def reactivate
+    transaction do
+      update! suspended_at: nil, suspension_reason: nil, posting_cooldown_ends_at: nil, posting_attempts_during_cooldown: 0
+      webhook&.update! consecutive_failures: 0
+    end
+  end
+
+  def suspension_reason_description
+    SUSPENSION_REASONS[suspension_reason]
+  end
+end
diff --git a/app/models/webhook.rb b/app/models/webhook.rb
new file mode 100644
index 0000000..6319b14
--- /dev/null
+++ b/app/models/webhook.rb
@@ -0,0 +1,161 @@
+require "net/http"
+
+# A bot's HTTP callback. When someone mentions the bot, the message is POSTed to the webhook as JSON
+# (see #payload), and a `200` text/plain or text/html response is posted back into the room as the
+# bot's reply. Delivery always happens in a job (Webhook::DeliveryJob), never during the request
+# that created the message. When the bot is added to a room (direct rooms excepted), it gets a
+# `joined` event (see #joined_payload_for and Membership::BotGreeting), and may reply the same way.
+class Webhook < ApplicationRecord
+  ENDPOINT_TIMEOUT = 7.seconds
+  MAX_REPLY_SIZE = 1.megabyte
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ]
+  FAILURES_BEFORE_SUSPENSION = 10
+  NETWORK_ERRORS = [ Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError ]
+
+  belongs_to :user
+
+  normalizes :url, with: ->(url) { url.strip }
+
+  validate :url_must_be_http
+
+  def deliver_later(message)
+    Webhook::DeliveryJob.perform_later(self, message)
+  end
+
+  def deliver(message)
+    if deliverable_to?(message.room)
+      deliver_and_reply(payload_for(message), message.room)
+    end
+  end
+
+  def deliver_joined_later(room)
+    Webhook::JoinedDeliveryJob.perform_later(self, room)
+  end
+
+  def deliver_joined(room)
+    if deliverable_to?(room) && !room.direct?
+      deliver_and_reply(joined_payload_for(room), room)
+    end
+  end
+
+  def joined_payload_for(room)
+    { event: "joined", room: room_payload_for(room) }
+  end
+
+  def payload_for(message)
+    {
+      event: "mention",
+      author: { id: message.creator.id, name: message.creator.name },
+      room: room_payload_for(message.room),
+      message: {
+        id: message.id,
+        body: { text: text_addressed_to_bot(message), html: message.body.body&.to_html.to_s },
+        link: url_helpers.room_at_message_path(message.room, message)
+      }
+    }
+  end
+
+  private
+    def room_payload_for(room)
+      { id: room.id, name: room.name, reply_to: url_helpers.room_bot_messages_path(room, user.bot_key) }
+    end
+
+    def url_must_be_http
+      uri = URI.parse(url.to_s)
+      errors.add :url, "must be an http:// or https:// address" unless uri.is_a?(URI::HTTP) && uri.host.present?
+    rescue URI::InvalidURIError
+      errors.add :url, "is not a valid address"
+    end
+
+    # A deactivated, banned, or suspended bot, or one that has left the room, doesn't get called (or reply).
+    def deliverable_to?(room)
+      user.active? && !user.suspended? && user.bot_key.present? && user.memberships.exists?(room: room)
+    end
+
+    def deliver_and_reply(payload, room)
+      response = post(payload)
+      record_delivery(response)
+      reply_to(room, response)
+    rescue *NETWORK_ERRORS => error
+      Rails.logger.info "Webhook for bot #{user_id} failed: #{error.class} #{error.message}"
+      record_failed_delivery
+      nil
+    end
+
+    # Any 2xx is a successful delivery (even with nothing to reply) and resets the count of failures
+    # in a row. Anything else, timeouts and connection errors included, adds to it, and
+    # FAILURES_BEFORE_SUSPENSION in a row suspend the bot (see User::Suspendable).
+    def record_delivery(response)
+      if response.is_a?(Net::HTTPSuccess)
+        record_successful_delivery
+      else
+        Rails.logger.info "Webhook for bot #{user_id} failed: HTTP #{response.code}"
+        record_failed_delivery
+      end
+    end
+
+    def record_successful_delivery
+      update_columns(consecutive_failures: 0) unless consecutive_failures.zero?
+    end
+
+    # Counted atomically: deliveries for several mentions may run at the same time.
+    def record_failed_delivery
+      Webhook.update_counters(id, consecutive_failures: 1)
+      reload
+
+      user.suspend :failing_webhook if consecutive_failures >= FAILURES_BEFORE_SUSPENSION
+    end
+
+    def post(payload)
+      uri = URI.parse(url)
+
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: ENDPOINT_TIMEOUT, read_timeout: ENDPOINT_TIMEOUT, write_timeout: ENDPOINT_TIMEOUT) do |http|
+        request = Net::HTTP::Post.new(uri, "Content-Type" => "application/json", "Accept" => REPLY_CONTENT_TYPES.join(", "))
+        request.body = payload.to_json
+        http.request(request)
+      end
+    end
+
+    # 200 with a text/plain or text/html body becomes the bot's message. Anything else (204,
+    # errors, other content types, empty bodies) posts nothing.
+    def reply_to(room, response)
+      if body = reply_body_from(response)
+        reply = nil
+        user.post_without_flooding { reply = room.messages.create_with_attachment!(body: body, creator: user) }
+        reply.broadcast_create
+      end
+    rescue User::FloodControl::Flooding => error
+      Rails.logger.info "Reply from bot #{user_id} not posted: #{error.message}"
+      nil
+    end
+
+    def reply_body_from(response)
+      if response.is_a?(Net::HTTPOK) && response.content_type.in?(REPLY_CONTENT_TYPES)
+        text = response.body.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+
+        if text.present? && text.bytesize <= MAX_REPLY_SIZE
+          response.content_type == "text/html" ? text : plain_text_to_html(text)
+        end
+      end
+    end
+
+    def plain_text_to_html(text)
+      ERB::Util.html_escape(text.strip).gsub(/\r?\n/, "<br>")
+    end
+
+    # The message as plain text, minus the bot's own @-mention, so it reads as the command
+    # addressed to the bot.
+    def text_addressed_to_bot(message)
+      return message.plain_text_body.strip unless content = message.body.body
+
+      content
+        .render_attachments(with_full_attributes: false) { |attachment| attachment.attachable == user ? "" : attachment.to_plain_text }
+        .fragment.to_plain_text
+        .gsub(/[[:blank:]]{2,}/, " ")
+        .gsub(/\A[[:space:]]+|[[:space:]]+\z/, "")
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+end
