+require "test_helper"
+
+class Membership::BotGreetingTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @bot = users(:deploy_bot)
+    @webhook = webhooks(:deploy_bot)
+  end
+
+  test "a bot added to a room gets joined once" do
+    room = rooms(:designers)
+
+    assert_enqueued_with job: Webhook::JoinedDeliveryJob, args: [ @webhook, room ] do
+      room.memberships.grant_to @bot
+    end
+
+    assert_no_enqueued_jobs only: Webhook::JoinedDeliveryJob do
+      room.memberships.grant_to @bot
+      room.memberships.revise granted: User.where(id: [ @bot.id, users(:jz).id ])
+    end
+  end
+
+  test "a bot added while creating a room gets joined" do
+    assert_enqueued_jobs 1, only: Webhook::JoinedDeliveryJob do
+      Rooms::Closed.create_for({ name: "Ops", creator: users(:david) }, users: [ users(:david), @bot ])
+    end
+  end
+
+  test "direct rooms, people, and bots without a webhook get nothing" do
+    assert_no_enqueued_jobs only: Webhook::JoinedDeliveryJob do
+      Rooms::Direct.create_for({ creator: users(:kevin) }, users: [ users(:kevin), @bot ])
+      rooms(:designers).memberships.grant_to users(:kevin)
+
+      other_bot = User.create_bot!(name: "Quiet Bot", creator: users(:kevin))
+      rooms(:designers).memberships.grant_to other_bot
+    end
+  end
+
+  test "turning add to all open rooms on joins every open room once" do
+    assert_enqueued_jobs Rooms::Open.count, only: Webhook::JoinedDeliveryJob do
+      @bot.update!(joins_all_open_rooms: true)
+    end
+    assert_equal Rooms::Open.pluck(:id).sort, @bot.rooms.opens.pluck(:id).sort
+
+    assert_no_enqueued_jobs only: Webhook::JoinedDeliveryJob do
+      @bot.update!(joins_all_open_rooms: false)
+      @bot.update!(joins_all_open_rooms: true)
+    end
+    assert_equal Rooms::Open.pluck(:id).sort, @bot.rooms.opens.pluck(:id).sort
+  end
+
+  test "new open rooms get bots that join all open rooms" do
+    @bot.update!(joins_all_open_rooms: true)
+
+    assert_enqueued_jobs 1, only: Webhook::JoinedDeliveryJob do
+      Rooms::Open.create!(name: "Ops", creator: users(:david))
+    end
+  end
+
+  test "rooms becoming open get bots that join all open rooms" do
+    @bot.update!(joins_all_open_rooms: true)
+    room = rooms(:designers).becomes!(Rooms::Open)
+
+    assert_enqueued_with job: Webhook::JoinedDeliveryJob, args: [ @webhook, room ] do
+      room.save!
+    end
+    assert_includes room.users, @bot
+  end
+
+  test "bots created to join all open rooms join them" do
+    bot = User.create_bot!(name: "Greeter", creator: users(:kevin), joins_all_open_rooms: true, webhook_url: "https://bots.example.com/greeter")
+
+    assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+    assert_enqueued_jobs Rooms::Open.count, only: Webhook::JoinedDeliveryJob
+  end
+
+  test "bots don't join open rooms by default" do
+    bot = User.create_bot!(name: "Shy Bot", creator: users(:kevin))
+
+    assert_empty bot.rooms
+    assert_no_difference -> { bot.rooms.count } do
+      Rooms::Open.create!(name: "Ops", creator: users(:david))
+    end
+  end
+end
