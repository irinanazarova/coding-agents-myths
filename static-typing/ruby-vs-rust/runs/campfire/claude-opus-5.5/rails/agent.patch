diff --git a/app/models/membership/bot_greeting.rb b/app/models/membership/bot_greeting.rb
new file mode 100644
index 0000000..92eec0c
--- /dev/null
+++ b/app/models/membership/bot_greeting.rb
@@ -0,0 +1,35 @@
+# Bots get a `joined` webhook event whenever they're added to a room, by a person or automatically
+# (see User#joins_all_open_rooms). Direct rooms never announce. Memberships are inserted in bulk
+# (insert_all skips callbacks), so every grant goes through Membership.grant, which knows exactly
+# which memberships are new: existing ones are skipped, so each bot hears about a room only once.
+module Membership::BotGreeting
+  extend ActiveSupport::Concern
+
+  class_methods do
+    # Inserts the memberships (hashes of room_id, user_id, …), skipping those that already exist.
+    def grant(attributes)
+      if attributes.any?
+        granted = insert_all(attributes, returning: %w[ room_id user_id ]).to_a
+        greet_bots_later(granted)
+      end
+    end
+
+    private
+      def greet_bots_later(granted)
+        webhooks = Webhook.where(user: User.active.bot.not_suspended.where(id: granted.pluck("user_id"))).index_by(&:user_id)
+
+        if webhooks.any?
+          rooms = Room.without_directs.where(id: granted.pluck("room_id")).index_by(&:id)
+
+          # Rooms and memberships may still be inside a transaction; the job must find them.
+          ActiveRecord.after_all_transactions_commit do
+            granted.each do |membership|
+              if (webhook = webhooks[membership["user_id"]]) && (room = rooms[membership["room_id"]])
+                webhook.deliver_joined_later(room)
+              end
+            end
+          end
+        end
+      end
+  end
+end
