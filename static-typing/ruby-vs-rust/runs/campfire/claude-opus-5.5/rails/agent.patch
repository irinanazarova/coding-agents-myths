@@ -0,0 +1,135 @@
+require "test_helper"
+
+class Messages::ByBotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+
+    @bot = users(:deploy_bot)
+    @room = rooms(:watercooler)
+  end
+
+  test "create posts the raw request body as a message by the bot" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Deploy of v1.2.3 finished ✅"
+    end
+
+    message = Message.last
+    assert_response :created
+    assert_equal "/messages/#{message.id}", response.location
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+    assert_equal @bot, message.creator
+  end
+
+  test "create keeps the raw body intact for form-encoded requests" do
+    post room_bot_messages_url(@room, @bot.bot_key), params: "a+b=c&d", headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+
+    assert_response :created
+    assert_equal "a+b=c&d", Message.last.plain_text_body
+  end
+
+  test "create broadcasts the message and notifies the room" do
+    assert_enqueued_jobs 1, only: Room::PushMessageJob do
+      assert_turbo_stream_broadcasts [ @room, :messages ], count: 1 do
+        post room_bot_messages_url(@room, @bot.bot_key), params: "Hello from a bot"
+      end
+    end
+  end
+
+  test "create with an attachment" do
+    assert_difference -> { @room.messages.count }, +1 do
+      post room_bot_messages_url(@room, @bot.bot_key), params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+    end
+
+    assert_response :created
+    assert Message.last.attachment.attached?
+  end
+
+  test "create with an empty body" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: ""
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "create in an unknown room" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(room_id: "nope", bot_key: @bot.bot_key), params: "Hello"
+    end
+
+    assert_response :not_found
+  end
+
+  test "create in a room the bot isn't a member of" do
+    post room_bot_messages_url(rooms(:designers), @bot.bot_key), params: "Hello"
+    assert_response :not_found
+  end
+
+  test "create with an invalid bot key" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, "#{@bot.id}-wrong"), params: "Hello"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "create with a regular user's id" do
+    post room_bot_messages_url(@room, "#{users(:david).id}-"), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "create by a deleted bot" do
+    bot_key = @bot.bot_key
+    @bot.deactivate
+
+    post room_bot_messages_url(@room, bot_key), params: "Hello"
+    assert_response :unauthorized
+  end
+
+  test "create over the rate limit responds with 429 and Retry-After" do
+    10.times do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Beep"
+      assert_response :created
+    end
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "One too many"
+    end
+
+    assert_response :too_many_requests
+    assert_equal "30", response.headers["Retry-After"]
+  end
+
+  test "create during the cooldown responds with 429 and the seconds left" do
+    @bot.update! posting_cooldown_ends_at: 12.5.seconds.from_now
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Hello"
+
+    assert_response :too_many_requests
+    assert_equal "13", response.headers["Retry-After"]
+  end
+
+  test "flooding during the cooldown suspends the bot" do
+    11.times { post room_bot_messages_url(@room, @bot.bot_key), params: "Beep" }
+
+    5.times do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Beep"
+      assert_response :too_many_requests
+    end
+
+    assert @bot.reload.suspended?
+
+    post room_bot_messages_url(@room, @bot.bot_key), params: "Beep"
+    assert_response :forbidden
+  end
+
+  test "create by a suspended bot" do
+    @bot.suspend :failing_webhook
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_key), params: "Hello"
+    end
+
+    assert_response :forbidden
+  end
+end
