+require "test_helper"
+
+class Message::BotMentionsTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:watercooler)
+    @webhook = webhooks(:deploy_bot)
+  end
+
+  test "mentioning a bot enqueues its webhook" do
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(:deploy_bot)} deploy</div>")
+    end
+  end
+
+  test "messages without bot mentions don't enqueue webhooks" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:david), body: "<div>Hi #{mention_attachment_for(:jason)}</div>")
+      @room.messages.create!(creator: users(:david), body: "Deploy Bot, deploy")
+    end
+  end
+
+  test "bots without a webhook, inactive bots, and bots outside the room aren't called" do
+    @webhook.destroy
+    assert_no_enqueued_jobs(only: Webhook::DeliveryJob) { mention_bot_in @room }
+
+    @webhook = Webhook.create!(user: users(:deploy_bot), url: "https://bots.example.com/deploy")
+    assert_no_enqueued_jobs(only: Webhook::DeliveryJob) { mention_bot_in rooms(:designers) }
+
+    users(:deploy_bot).update!(status: :banned)
+    assert_no_enqueued_jobs(only: Webhook::DeliveryJob) { mention_bot_in @room }
+  end
+
+  test "messages posted by bots don't call webhooks" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      @room.messages.create!(creator: users(:deploy_bot), body: "<div>#{mention_attachment_for(:deploy_bot)} hi me</div>")
+    end
+  end
+
+  test "the delivery job delivers" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "On it", headers: { "Content-Type" => "text/plain" })
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      mention_bot_in @room
+    end
+
+    assert_equal "On it", @room.messages.last.plain_text_body
+    assert_equal users(:deploy_bot), @room.messages.last.creator
+  end
+
+  private
+    def mention_bot_in(room)
+      room.messages.create!(creator: users(:david), body: "<div>#{mention_attachment_for(:deploy_bot)} deploy</div>")
+    end
+end
