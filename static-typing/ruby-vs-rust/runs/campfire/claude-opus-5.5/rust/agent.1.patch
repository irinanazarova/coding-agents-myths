@@ -0,0 +1,93 @@
+//! Views for `bots/*`: the chat bots a member set up (all of them, for an administrator). Not in
+//! Rails Campfire.
+
+use askama::Template;
+
+use crate::ViewContext;
+use crate::helpers::{self as h, filters};
+use crate::layouts::Page;
+use crate::users::UserSummary;
+
+/// A bot as the bots page shows it.
+#[derive(Clone, Debug, Default)]
+pub struct BotSummary {
+    /// The bot's `users` row.
+    pub user: UserSummary,
+    /// `"<user id>-<token>"`: what its requests authenticate with.
+    pub key: String,
+}
+
+impl BotSummary {
+    /// The id of the bot's code field, which its label names.
+    pub fn key_field_id(&self) -> String {
+        format!("bot_{}_key", self.user.id)
+    }
+}
+
+/// `bots/index.html`.
+#[derive(Template)]
+#[template(path = "bots/index.html", blocks = ["head", "content"])]
+pub struct Index<'a> {
+    pub ctx: &'a ViewContext<'a>,
+    pub bots: Vec<BotSummary>,
+}
+
+impl Page for Index<'_> {
+    fn page_title(&self) -> Option<String> {
+        Some("Chat bots".into())
+    }
+}
+
+/// What `bots/_form.html` fills in: a new bot, or an existing one being edited.
+#[derive(Clone, Debug, Default)]
+pub struct BotForm {
+    /// The bot being edited; `None` for a new one.
+    pub bot: Option<UserSummary>,
+    /// The name as submitted, or the bot's.
+    pub name: String,
+    /// `errors.full_messages` from a submission that didn't save.
+    pub errors: Vec<String>,
+}
+
+impl BotForm {
+    fn action(&self) -> String {
+        match &self.bot {
+            Some(bot) => h::routes::bot(bot.id),
+            None => h::routes::bots(),
+        }
+    }
+
+    fn method(&self) -> &'static str {
+        if self.bot.is_some() { "patch" } else { "post" }
+    }
+}
+
+/// `bots/new.html`.
+#[derive(Template)]
+#[template(path = "bots/new.html", blocks = ["head", "content"])]
+pub struct New<'a> {
+    pub ctx: &'a ViewContext<'a>,
+    pub form: BotForm,
+}
+
+impl Page for New<'_> {
+    fn page_title(&self) -> Option<String> {
+        Some("New chat bot".into())
+    }
+}
+
+/// `bots/edit.html`.
+#[derive(Template)]
+#[template(path = "bots/edit.html", blocks = ["head", "content"])]
+pub struct Edit<'a> {
+    pub ctx: &'a ViewContext<'a>,
+    pub form: BotForm,
+    /// The bot's id, for the delete button.
+    pub bot_id: i64,
+}
+
+impl Page for Edit<'_> {
+    fn page_title(&self) -> Option<String> {
+        Some(format!("Edit {}", self.form.name))
+    }
+}
