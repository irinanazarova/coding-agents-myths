+{#- bots/index.html: the chat bots the current user can manage (not in Rails Campfire) -#}
+{% extends "layouts/application.html" %}
+{%- block head %}{% endblock %}
+
+{% block nav %}  <div class="flex-item-justify-start">
+    {{ h::link_back_to(ctx, h::routes::edit_account()) }}
+  </div>
+{% endblock %}
+{% block content %}<section class="panel txt-align-center flex flex-column gap" style="view-transition-name: bots">
+  {{ h::image_tag(ctx, "bot.svg", h::attrs().class("center colorize--black").size(48).aria_hidden()) }}
+  <h1 class="margin-none txt-x-large">Chat bots</h1>
+  <p class="margin-none txt-subtle">
+    Bots join every open room and post with an HTTP request: <code>curl -d "Hello!" {{ ctx.url(h::routes::rooms().as_str()) }}/&lt;room-id&gt;/&lt;bot-code&gt;/messages</code>.
+    Keep a bot’s code secret: anyone with it can post as the bot.
+  </p>
+
+  <div class="margin-block pad-inline pad-block fill-shade border-radius">
+    <menu class="flex flex-column gap margin-none pad" aria-label="Chat bots">
+{% for bot in bots %}{% include "bots/_bot.html" %}{% else %}      <li class="txt-subtle margin-none">No chat bots yet.</li>
+{% endfor %}    </menu>
+  </div>
+
+  {% filter link_to(h::routes::new_bot(), h::attrs().class("btn btn--reversed center txt-large")) %}
+    {{ h::image_tag(ctx, "add.svg", h::attrs().aria_hidden().size(20)) }}
+    <span class="for-screen-reader">Add a chat bot</span>
+{% endfilter %}</section>
+{% endblock %}
