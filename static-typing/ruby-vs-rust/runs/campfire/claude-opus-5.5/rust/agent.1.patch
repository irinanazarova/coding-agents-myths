@@ -0,0 +1,98 @@
+//! `Messages::ByBotsController`: the bot API (not in Rails Campfire as this app ports it).
+//!
+//! ```text
+//! curl -d "Deploy of v1.2.3 finished ✅" https://chat.example.com/rooms/<room-id>/<bot-code>/messages
+//! ```
+//!
+//! The raw request body is the message body (rich text, as a composed message's is), or a
+//! multipart `attachment` is the message's attachment. The message is created, broadcast and
+//! pushed exactly as one posted from the composer. Answers `201 Created` with the message's path
+//! in `Location`; `401` for a code that isn't an active bot's, `404` for a room the bot isn't in,
+//! and `422` for an empty message.
+
+use std::borrow::Cow;
+use std::sync::LazyLock;
+
+use axum::middleware::Next;
+use campfire_kit::body::{self, ParsedBody};
+use campfire_kit::http::header;
+use campfire_kit::{Ctx, Method, Result, StatusCode, halt};
+use regex::Regex;
+
+use super::{MessageParams, broadcast_create, create_message};
+use crate::concerns::{self, Before, before_actions};
+use crate::controllers::presenters::attachments::Assignment;
+
+/// `POST /rooms/:room_id/:bot_key/messages`
+pub async fn create(c: &mut Ctx) -> Result {
+    // A bot has no session, and no browser to forge its requests: it authenticates with its key.
+    before_actions(c, Before::default().allow_unauthenticated_access().skip_forgery_protection()).await?;
+    concerns::authenticate_bot(c).await?;
+    let (_, room) = concerns::set_room(c).await?;
+    let attributes = bot_message_params(c)?;
+    let message = create_message(c, &room, attributes).await?;
+    broadcast_create(c, &room, &message).await?;
+    Ok(c.head(StatusCode::CREATED).header(header::LOCATION, &campfire_routes::message(message.id)))
+}
+
+/// The multipart `attachment`, or else the raw body as the message's; 422 when that's blank.
+fn bot_message_params(c: &Ctx) -> Result<MessageParams> {
+    let multipart = c.request.media_type().is_some_and(|media| media.starts_with("multipart/"));
+    if multipart && c.params.contains_key("attachment") {
+        return match Assignment::from_params(&c.params, "attachment")? {
+            upload @ Assignment::Create(_) => Ok(MessageParams { attachment: Some(upload), ..MessageParams::default() }),
+            _ => halt(concerns::head(StatusCode::UNPROCESSABLE_ENTITY)),
+        };
+    }
+    match std::str::from_utf8(c.request.raw_post()) {
+        Ok(body) if !body.trim().is_empty() => Ok(MessageParams { body: Some(body.to_string()), ..MessageParams::default() }),
+        _ => halt(concerns::head(StatusCode::UNPROCESSABLE_ENTITY)),
+    }
+}
+
+// --- The request around the action ------------------------------------------------------------------
+
+/// The bot API's path, with the key as its second capture.
+static PATH: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"^(/*rooms/+[^/]+/+)([^/]+)(/+messages(?:\.[^/]*)?/*)$").unwrap());
+
+/// Middleware ahead of routing: kit refuses a body that doesn't parse as form params or JSON
+/// ("Deploy 100% done", which `curl -d` sends as a form) before any action runs. The bot API reads
+/// the body raw, so its params' errors are dropped here instead.
+pub async fn read_raw_body(max_body_bytes: Option<usize>, request: axum::extract::Request, next: Next) -> axum::response::Response {
+    if request.method() != Method::POST || !PATH.is_match(request.uri().path()) {
+        return next.run(request).await;
+    }
+    let (mut parts, body) = request.into_parts();
+    let parsed = match parts.extensions.remove::<ParsedBody>() {
+        Some(parsed) => parsed,
+        None => match body::parse(&Method::POST, &parts.headers, body, max_body_bytes).await {
+            Ok(parsed) => parsed,
+            Err(error) => {
+                let mut response = axum::response::Response::new(axum::body::Body::empty());
+                *response.status_mut() = error.status();
+                return response;
+            }
+        },
+    };
+    parts.extensions.insert(ParsedBody { raw: parsed.raw, params: Ok(parsed.params.unwrap_or_default()) });
+    next.run(axum::extract::Request::from_parts(parts, axum::body::Body::empty())).await
+}
+
+/// The path as logged, without the key (`campfire_kit::request::PathFilter`): it's a credential.
+pub fn filter_key(path: &str) -> Cow<'_, str> {
+    PATH.replace(path, "${1}[FILTERED]${3}")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn keys_are_filtered_from_logged_paths() {
+        assert_eq!(filter_key("/rooms/12/34-secret/messages"), "/rooms/12/[FILTERED]/messages");
+        assert_eq!(filter_key("/rooms/12/34-secret/messages.json"), "/rooms/12/[FILTERED]/messages.json");
+        assert_eq!(filter_key("//rooms//12//34-secret//messages/"), "//rooms//12//[FILTERED]//messages/");
+        assert_eq!(filter_key("/rooms/12/messages"), "/rooms/12/messages");
+        assert_eq!(filter_key("/rooms/12/messages/34"), "/rooms/12/messages/34");
+    }
+}
