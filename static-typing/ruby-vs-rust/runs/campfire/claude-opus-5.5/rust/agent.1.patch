+//! Request-level tests for the bots page and the bot API, against the `default` seed.
+
+use axum::http::{Method, StatusCode};
+use campfire_db::{Bot, Membership, Message, User};
+
+use crate::controllers::presenters::test_support::*;
+
+/// A browser signed in with the seed's password.
+async fn signed_in<'a>(app: &'a TestApp, email_address: &str) -> Browser<'a> {
+    let mut browser = app.anonymous();
+    let credentials = [("email_address", email_address), ("password", "secret123456")];
+    let reply = browser.write(Req::new(Method::POST, "/session").form(&credentials)).await;
+    assert_eq!(reply.status, StatusCode::FOUND, "{}", reply.text());
+    browser
+}
+
+/// A message's stored rich text.
+async fn rich_text_body(app: &TestApp, message_id: i64) -> String {
+    let sql = r#"SELECT "body" FROM "action_text_rich_texts" WHERE "record_type" = 'Message' AND "record_id" = ?"#;
+    app.db().read(move |conn| Ok(conn.query_row(sql, [message_id], |row| row.get(0))?)).await.unwrap()
+}
+
+/// The bot named `name`, and its key.
+async fn bot_named(app: &TestApp, name: &'static str) -> (User, Bot) {
+    app.db()
+        .read(move |conn| {
+            let david = User::find(conn, DAVID)?;
+            Ok(Bot::manageable_by(conn, &david)?.into_iter().find(|(user, _)| user.name == name).expect("the bot"))
+        })
+        .await
+        .unwrap()
+}
+
+async fn create_bot(browser: &mut Browser<'_>, name: &str) -> Reply {
+    browser.write(Req::new(Method::POST, "/bots").form(&[("bot[name]", name)])).await
+}
+
+/// A request as `curl -d body` makes it: a form content type, no cookies, no browser headers.
+async fn post_as_bot(app: &TestApp, room_id: i64, key: &str, body: &str) -> Reply {
+    let request = Req::new(Method::POST, &format!("/rooms/{room_id}/{key}/messages"))
+        .header("content-type", "application/x-www-form-urlencoded")
+        .header("user-agent", "curl/8.7.1")
+        .header("accept", "*/*");
+    app.anonymous().send(Req { body: body.as_bytes().to_vec(), ..request }).await
+}
+
+#[tokio::test]
+async fn a_member_sets_up_a_bot_that_joins_the_open_rooms() {
+    let app = TestApp::boot().await;
+    let mut kevin = signed_in(&app, "kevin@37signals.com").await;
+
+    let account = kevin.get("/account/edit").await;
+    assert!(account.text().contains(r#"href="/bots""#) && account.text().contains("Set up chat bots"), "{}", account.text());
+    let new = kevin.get("/bots/new").await;
+    assert_eq!(new.status, StatusCode::OK);
+    assert!(new.text().contains(r#"placeholder="Name the bot""#) && new.text().contains("Save changes"));
+    assert!(new.text().contains(r#"enctype="multipart/form-data""#));
+
+    let created = create_bot(&mut kevin, "Deploy Bot").await;
+    assert_eq!((created.status, created.location()), (StatusCode::FOUND, Some("http://campfire.test/bots")));
+    let (bot, key) = bot_named(&app, "Deploy Bot").await;
+    assert_eq!((key.creator_id, key.user_id), (KEVIN, bot.id));
+    assert!(bot.role == campfire_db::Role::Bot && bot.email_address.is_none());
+    let bot_id = bot.id;
+    let membership = app.db().read(move |conn| Membership::find_by_room_and_user(conn, HQ, bot_id)).await.unwrap();
+    assert!(membership.is_some(), "joined the open room");
+
+    let index = kevin.get("/bots").await;
+    assert_eq!(index.status, StatusCode::OK);
+    assert_eq!(index.header("cache-control"), Some("no-store"));
+    let text = index.text();
+    assert!(text.contains("Deploy Bot") && text.contains("Bot code") && text.contains(&format!(r#"value="{}""#, key.key())), "{text}");
+    assert!(text.contains(r#"aria-label="Edit Deploy Bot""#) && text.contains("Add a chat bot"));
+
+    // Administrators see everyone's bots; other members only their own.
+    assert!(app.david().get("/bots").await.text().contains(&key.key()));
+    let mut jz = signed_in(&app, "jz@37signals.com").await;
+    assert!(!jz.get("/bots").await.text().contains("Deploy Bot"));
+    assert_eq!(jz.get(&format!("/bots/{bot_id}/edit")).await.status, StatusCode::NOT_FOUND);
+    let renamed = jz.write(Req::new(Method::PATCH, &format!("/bots/{bot_id}")).form(&[("bot[name]", "Mine")])).await;
+    assert_eq!(renamed.status, StatusCode::NOT_FOUND);
+    assert_eq!(jz.write(Req::new(Method::DELETE, &format!("/bots/{bot_id}"))).await.status, StatusCode::NOT_FOUND);
+
+    // Bots aren't people on the account page.
+    assert!(!app.david().get("/account/edit").await.text().contains("Deploy Bot"));
+}
