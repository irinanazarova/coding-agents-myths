+async fn the_bot_form_sets_and_removes_the_webhook_url() {
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    let new = david.get("/bots/new").await;
+    assert!(new.text().contains("Webhook URL") && new.text().contains(r#"name="bot[webhook_url]""#), "{}", new.text());
+
+    let created = create_bot_with_webhook(&mut david, "Build Bot", " http://localhost:4567/hook ").await;
+    assert_eq!(created.status, StatusCode::FOUND, "{}", created.text());
+    let (user, bot) = bot_named(&app, "Build Bot").await;
+    assert_eq!(webhook_url_of(&app, bot.clone()).await.as_deref(), Some("http://localhost:4567/hook"));
+    let edit = david.get(&format!("/bots/{}/edit", user.id)).await;
+    assert!(edit.text().contains("Webhook URL") && edit.text().contains(r#"value="http://localhost:4567/hook""#), "{}", edit.text());
+
+    // A rename alone leaves the webhook be.
+    rename_bot(&mut david, user.id, None).await;
+    assert_eq!(webhook_url_of(&app, bot.clone()).await.as_deref(), Some("http://localhost:4567/hook"));
+
+    let invalid = rename_bot(&mut david, user.id, Some("localhost/hook")).await;
+    assert_eq!(invalid.status, StatusCode::UNPROCESSABLE_ENTITY);
+    let text = invalid.text();
+    assert!(text.contains("Webhook url must be an http:// or https:// URL") && text.contains(r#"value="localhost/hook""#), "{text}");
+    assert_eq!(webhook_url_of(&app, bot.clone()).await.as_deref(), Some("http://localhost:4567/hook"));
+
+    let changed = rename_bot(&mut david, user.id, Some("https://bots.example.com/b")).await;
+    assert_eq!(changed.status, StatusCode::FOUND);
+    assert_eq!(webhook_url_of(&app, bot.clone()).await.as_deref(), Some("https://bots.example.com/b"));
+
+    let removed = rename_bot(&mut david, user.id, Some("")).await;
+    assert_eq!(removed.status, StatusCode::FOUND);
+    assert_eq!(webhook_url_of(&app, bot.clone()).await, None);
+
+    let rejected = create_bot_with_webhook(&mut david, "Other Bot", "ftp://example.com").await;
+    assert_eq!(rejected.status, StatusCode::UNPROCESSABLE_ENTITY);
+    assert!(!david.get("/bots").await.text().contains("Other Bot"), "nothing was created");
