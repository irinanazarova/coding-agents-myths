diff --git a/crates/campfire/src/integrations/webhooks.rs b/crates/campfire/src/integrations/webhooks.rs
new file mode 100644
index 0000000..1ba5f3d
--- /dev/null
+++ b/crates/campfire/src/integrations/webhooks.rs
@@ -0,0 +1,113 @@
+//! Bots' webhooks (not in Rails Campfire as this app ports it): the `POST` that tells a bot about
+//! a message, and what its answer asks to be posted.
+//!
+//! The payload goes as `application/json`. A `200` whose `Content-Type` is `text/plain` or
+//! `text/html` is a reply for the room; anything else successful (a `204`, an empty body, another
+//! type) asks for nothing. Other statuses, timeouts and connection failures are errors, which the
+//! caller logs.
+//!
+//! Unlike the push and unfurl clients, there's no private network guard: a bot is set up by a
+//! member of the account, and often runs next to Campfire (on `localhost`, on the LAN).
+
+use std::time::Duration;
+
+use campfire_richtext::uri::Uri;
+
+use super::net::Network;
+use super::net::http::{self, Body, Endpoint, HttpError, Timeouts};
+
+/// Per connect and read.
+const TIMEOUTS: Timeouts = Timeouts { open: Duration::from_secs(7), read: Duration::from_secs(7) };
+/// For the whole exchange, however the bot trickles its answer.
+const DELIVERY_DEADLINE: Duration = Duration::from_secs(15);
+/// The largest answer that's posted.
+pub const MAX_REPLY_BYTES: usize = 1024 * 1024;
+
+/// What the bot answered with.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Reply {
+    /// `text/plain`: posted as text.
+    Text(String),
+    /// `text/html`: posted as rich text (sanitized as any message's is).
+    Html(String),
+    /// Nothing to post.
+    None,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum WebhookError {
+    #[error("not an http:// or https:// URL: {0:?}")]
+    InvalidUrl(String),
+    #[error(transparent)]
+    Http(#[from] HttpError),
+    #[error("no answer within {DELIVERY_DEADLINE:?}")]
+    Timeout,
+    #[error("the answer is over {MAX_REPLY_BYTES} bytes")]
+    ReplyTooLarge,
+    #[error("answered {0}")]
+    Status(u16),
+}
+
+/// Posts `payload` (JSON) to the webhook at `url`, and reads the bot's answer.
+pub async fn deliver(net: &Network, url: &str, payload: Vec<u8>) -> Result<Reply, WebhookError> {
+    let uri = campfire_richtext::uri::parse(url)
+        .ok()
+        .filter(|uri| uri.is_http() && uri.host.as_deref().is_some_and(|host| !host.is_empty()))
+        .ok_or_else(|| WebhookError::InvalidUrl(url.to_string()))?;
+    let endpoint = endpoint(&uri);
+    let headers = vec![
+        ("Content-Type".to_string(), "application/json".to_string()),
+        ("Content-Length".to_string(), payload.len().to_string()),
+        ("Accept".to_string(), "text/plain, text/html, */*;q=0.1".to_string()),
+        ("User-Agent".to_string(), "Campfire".to_string()),
+    ];
+    let mut request = http::Request::net_http(hyper::Method::POST, http::request_uri(&uri), None, headers).transport(true, &endpoint);
+    request.body = payload;
+    let exchange = async {
+        let response = http::exchange(net, &endpoint, request, &TIMEOUTS).await?;
+        read_reply(response).await
+    };
+    tokio::time::timeout(DELIVERY_DEADLINE, exchange).await.map_err(|_| WebhookError::Timeout)?
+}
+
+fn endpoint(uri: &Uri) -> Endpoint {
+    let https = uri.scheme.as_deref().is_some_and(|scheme| scheme.eq_ignore_ascii_case("https"));
+    let port = uri.port.unwrap_or(if https { 443 } else { 80 });
+    Endpoint { https, host: uri.host.clone().unwrap_or_default(), port: u16::try_from(port).unwrap_or(u16::MAX), pinned_ip: None }
+}
+
+async fn read_reply(response: http::Response) -> Result<Reply, WebhookError> {
+    match response.status {
+        200 => {}
+        200..=299 => return Ok(Reply::None),
+        status => return Err(WebhookError::Status(status)),
+    }
+    let content_type = response.content_type().map(|media| media.to_ascii_lowercase());
+    let reply: fn(String) -> Reply = match content_type.as_deref() {
+        Some("text/plain") => Reply::Text,
+        Some("text/html") => Reply::Html,
+        _ => return Ok(Reply::None),
+    };
+    match response.read_body(MAX_REPLY_BYTES).await? {
+        Body::Complete(bytes) => {
+            let text = String::from_utf8_lossy(&bytes).into_owned();
+            Ok(if text.trim().is_empty() { Reply::None } else { reply(text) })
+        }
+        Body::TooLarge => Err(WebhookError::ReplyTooLarge),
+    }
+}
+
+/// A `text/plain` answer as a message body: escaped, its lines kept apart.
+pub fn text_reply_html(text: &str) -> String {
+    text.trim().lines().map(ruby_compat::erb::html_escape).collect::<Vec<_>>().join("<br>")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn plain_text_answers_are_escaped() {
+        assert_eq!(text_reply_html("  Build #12 <passed> & deployed\nsee logs\n"), "Build #12 &lt;passed&gt; &amp; deployed<br>see logs");
+    }
+}
