diff --git a/crates/db/src/models/webhook.rs b/crates/db/src/models/webhook.rs
new file mode 100644
index 0000000..8cd0774
--- /dev/null
+++ b/crates/db/src/models/webhook.rs
@@ -0,0 +1,138 @@
+//! `Webhook`: where a bot hears about the messages that mention it. Not in Rails Campfire as this
+//! app ports it: a row in this app's own `bot_webhooks` table (see `schema::ADDITIONS`), at most
+//! one per bot.
+
+use rusqlite::{Connection, params};
+
+use crate::database::Tx;
+use crate::error::{Errors, Result};
+use crate::models::bot::bot_columns;
+use crate::models::user::user_columns;
+use crate::models::{Bot, User};
+use crate::sql::{CachedStatements, columns, placeholders, query_all, query_one};
+use crate::time::Timestamp;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Webhook {
+    pub id: i64,
+    /// The bot's `bots` row (not its user).
+    pub bot_id: i64,
+    /// An absolute `http://` or `https://` URL.
+    pub url: String,
+    pub created_at: Timestamp,
+    pub updated_at: Timestamp,
+}
+
+columns! {
+    Webhook, "bot_webhooks", webhook_columns {
+        id: "id",
+        bot_id: "bot_id",
+        url: "url",
+        created_at: "created_at",
+        updated_at: "updated_at",
+    }
+}
+
+/// The active bot users with webhooks, their `bots` rows and webhooks, joined.
+const SELECT_OF_ACTIVE_BOTS: &str = concat!(
+    "SELECT ",
+    user_columns!(),
+    ", ",
+    bot_columns!(),
+    ", ",
+    webhook_columns!(),
+    r#" FROM "users" INNER JOIN "bots" ON "bots"."user_id" = "users"."id""#,
+    r#" INNER JOIN "bot_webhooks" ON "bot_webhooks"."bot_id" = "bots"."id""#,
+    r#" WHERE "users"."status" = 0 AND "users"."role" = 2"#
+);
+
+impl Webhook {
+    // Finders
+
+    pub fn find_by_bot_id(conn: &Connection, bot_id: i64) -> Result<Option<Self>> {
+        let sql = concat!("SELECT ", webhook_columns!(), r#" FROM "bot_webhooks" WHERE "bot_webhooks"."bot_id" = ? LIMIT 1"#);
+        query_one(conn, sql, [bot_id], Self::from_row)
+    }
+
+    /// The active bots among `user_ids` that have a webhook, with their `bots` rows and webhooks,
+    /// in the order of `user_ids`.
+    pub fn of_active_bots(conn: &Connection, user_ids: &[i64]) -> Result<Vec<(User, Bot, Webhook)>> {
+        if user_ids.is_empty() {
+            return Ok(Vec::new());
+        }
+        let sql = format!(r#"{SELECT_OF_ACTIVE_BOTS} AND "users"."id" IN ({})"#, placeholders(user_ids.len()));
+        let mut found = query_all(conn, &sql, rusqlite::params_from_iter(user_ids), |row| {
+            let bot_at = User::COLUMNS.len();
+            Ok((User::from_row(row)?, Bot::from_row_at(row, bot_at)?, Webhook::from_row_at(row, bot_at + Bot::COLUMNS.len())?))
+        })?;
+        found.sort_by_key(|(user, _, _)| user_ids.iter().position(|id| *id == user.id));
+        Ok(found)
+    }
+
+    // Writing
+
+    /// Sets the bot's webhook to `url` (surrounding whitespace stripped), or removes it when that's
+    /// blank.
+    pub fn assign(tx: &mut Tx<'_>, bot_id: i64, url: &str) -> Result<Option<Self>> {
+        let url = url.trim();
+        if url.is_empty() {
+            Self::destroy_for(tx, bot_id)?;
+            return Ok(None);
+        }
+        validate_url(url)?;
+        let now = tx.now();
+        let webhook = tx.conn().query_row_cached(
+            concat!(
+                r#"INSERT INTO "bot_webhooks" ("bot_id", "url", "created_at", "updated_at") VALUES (?, ?, ?, ?)"#,
+                r#" ON CONFLICT ("bot_id") DO UPDATE SET "url" = excluded."url", "updated_at" = excluded."updated_at""#,
+                " RETURNING ",
+                webhook_columns!()
+            ),
+            params![bot_id, url, now, now],
+            Self::from_row,
+        )?;
+        Ok(Some(webhook))
+    }
+
+    /// Removes the bot's webhook, if it has one.
+    pub fn destroy_for(tx: &mut Tx<'_>, bot_id: i64) -> Result<()> {
+        tx.conn().execute_cached(r#"DELETE FROM "bot_webhooks" WHERE "bot_webhooks"."bot_id" = ?"#, [bot_id])?;
+        Ok(())
+    }
+}
+
+/// An absolute `http://` or `https://` URL with a host, and no whitespace.
+fn validate_url(url: &str) -> Result<()> {
+    let mut errors = Errors::default();
+    if !valid_url(url) {
+        errors.add("webhook_url", "must be an http:// or https:// URL");
+    }
+    errors.into_result()
+}
+
+fn valid_url(url: &str) -> bool {
+    if url.chars().any(|c| c.is_whitespace() || c.is_control()) {
+        return false;
+    }
+    let Some((scheme, rest)) = url.split_once("://") else { return false };
+    let authority = rest.split(['/', '?', '#']).next().unwrap_or("");
+    let host = authority.rsplit_once('@').map_or(authority, |(_, host)| host);
+    (scheme.eq_ignore_ascii_case("http") || scheme.eq_ignore_ascii_case("https")) && !host.is_empty() && !host.starts_with(':')
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn urls_must_be_absolute_http_urls() {
+        let valid = ["http://localhost:4567/hook", "https://bots.example.com/campfire?x=1", "HTTPS://example.com", "http://[::1]:80/"];
+        for url in valid {
+            assert!(valid_url(url), "{url}");
+        }
+        let invalid = ["example.com/hook", "ftp://example.com", "http://", "http:///path", "http://:80/", "http://a b.com", "data://x"];
+        for url in invalid {
+            assert!(!valid_url(url), "{url}");
+        }
+    }
+}
