diff --git a/crates/db/src/tests/bot_test.rs b/crates/db/src/tests/bot_test.rs
new file mode 100644
index 0000000..a373d93
--- /dev/null
+++ b/crates/db/src/tests/bot_test.rs
@@ -0,0 +1,95 @@
+//! Bots' rooms (not in Rails Campfire): they join only the rooms they're added to, or every open
+//! room when set to, and each room they join emits `Event::BotJoined` once.
+
+use super::*;
+use crate::{Bot, NewBot, PasswordDigest, Room, RoomType, User};
+
+fn create_bot(t: &TestDb) -> (User, Bot) {
+    let password_digest = PasswordDigest::create("unused", 4).unwrap();
+    t.write(move |tx| Bot::create(tx, NewBot { name: "Greeter".into(), creator_id: id("david"), password_digest }))
+}
+
+fn room_ids_of(t: &TestDb, user_id: i64) -> Vec<i64> {
+    let mut ids: Vec<i64> = t.read(|c| crate::Membership::for_user(c, user_id)).into_iter().map(|m| m.room_id).collect();
+    ids.sort();
+    ids
+}
+
+fn open_room_ids(t: &TestDb) -> Vec<i64> {
+    let mut ids: Vec<i64> = t.read(|c| Room::of_type(c, RoomType::Open)).into_iter().map(|room| room.id).collect();
+    ids.sort();
+    ids
+}
+
+fn joined(t: &TestDb) -> Vec<(i64, i64)> {
+    let mut joined: Vec<(i64, i64)> = t
+        .sink
+        .take()
+        .into_iter()
+        .filter_map(|event| match event {
+            Event::BotJoined { room_id, user_id } => Some((room_id, user_id)),
+            _ => None,
+        })
+        .collect();
+    joined.sort();
+    joined
+}
+
+#[test]
+fn a_new_bot_joins_no_room_and_new_open_rooms_leave_it_out() {
+    let t = TestDb::new();
+    let (user, bot) = create_bot(&t);
+    assert!(room_ids_of(&t, user.id).is_empty());
+    assert!(!t.read(|c| bot.in_all_open_rooms(c)));
+
+    let room = t.write(|tx| Room::create(tx, RoomType::Open, Some("Watercooler"), id("david")));
+    assert!(!t.read(|c| room.user_ids(c)).contains(&user.id));
+    assert!(t.read(|c| room.user_ids(c)).contains(&id("kevin")), "people still join");
+    assert_eq!(joined(&t), vec![]);
+}
+
+#[test]
+fn a_bot_in_all_open_rooms_joins_each_once_and_stays_when_switched_off() {
+    let t = TestDb::new();
+    let (user, bot) = create_bot(&t);
+    t.sink.take();
+
+    let switched = bot.clone();
+    t.write(move |tx| switched.update_all_open_rooms(tx, true));
+    let open = open_room_ids(&t);
+    assert_eq!(room_ids_of(&t, user.id), open);
+    assert_eq!(joined(&t), open.iter().map(|room_id| (*room_id, user.id)).collect::<Vec<_>>());
+
+    // On again: already in them all, so nothing to join.
+    let switched = bot.clone();
+    t.write(move |tx| switched.update_all_open_rooms(tx, true));
+    assert_eq!(joined(&t), vec![]);
+
+    let room = t.write(|tx| Room::create(tx, RoomType::Open, Some("Watercooler"), id("david")));
+    assert_eq!(joined(&t), vec![(room.id, user.id)]);
+
+    let switched = bot.clone();
+    t.write(move |tx| switched.update_all_open_rooms(tx, false));
+    assert!(!t.read(|c| bot.in_all_open_rooms(c)));
+    assert_eq!(room_ids_of(&t, user.id), open_room_ids(&t), "keeps its rooms");
+    let later = t.write(|tx| Room::create(tx, RoomType::Open, Some("Later"), id("david")));
+    assert!(!room_ids_of(&t, user.id).contains(&later.id));
+    assert_eq!(joined(&t), vec![]);
+}
+
+#[test]
+fn bots_added_to_rooms_join_them_but_never_direct_ones() {
+    let t = TestDb::new();
+    let (user, _) = create_bot(&t);
+    t.sink.take();
+    let bot_id = user.id;
+
+    let closed = t.write(move |tx| Room::create_for(tx, RoomType::Closed, Some("Ops"), id("david"), &[id("david"), bot_id]));
+    assert_eq!(joined(&t), vec![(closed.id, bot_id)]);
+    let again = closed.clone();
+    t.write(move |tx| again.grant_to(tx, &[bot_id, id("kevin")]));
+    assert_eq!(joined(&t), vec![], "already a member");
+
+    t.write(move |tx| Room::find_or_create_direct_for(tx, &[id("david"), bot_id], id("david")));
+    assert_eq!(joined(&t), vec![]);
+}
