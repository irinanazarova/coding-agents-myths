+pub(crate) fn grant_open_rooms_to(tx: &mut Tx<'_>, user_id: i64) -> Result<()> {
+    for room in Room::of_type(tx.conn(), RoomType::Open)? {
+        insert_memberships(tx, &room, &[user_id])?;
+    }
+    Ok(())
 }
