+}
+
+#[tokio::test]
+async fn administrators_set_bots_per_member_on_the_account_page() {
+    let app = TestApp::boot().await;
+    let page = app.david().get("/account/edit").await.text();
+    assert!(page.contains("Bots per member"), "{page}");
+    assert!(page.contains(r#"type="number" value="5" name="account[settings][bots_per_member]""#), "5 by default: {page}");
+    let mut kevin = signed_in(&app, "kevin@37signals.com").await;
+    assert!(!kevin.get("/account/edit").await.text().contains("Bots per member"), "administrators only");
+
+    assert_eq!(set_bots_per_member(&app, "2").await.status, StatusCode::FOUND);
+    assert!(app.david().get("/account/edit").await.text().contains(r#"value="2" name="account[settings][bots_per_member]""#));
+    let refused = kevin.write(Req::new(Method::PUT, "/account").form(&[("account[settings][bots_per_member]", "50")])).await;
+    assert_ne!(refused.status, StatusCode::FOUND, "members can't change it");
+    assert!(app.david().get("/account/edit").await.text().contains(r#"value="2" name="account[settings][bots_per_member]""#));
+}
+
+#[tokio::test]
+async fn members_can_have_only_so_many_bots() {
+    let app = TestApp::boot().await;
+    set_bots_per_member(&app, "2").await;
+    let mut kevin = signed_in(&app, "kevin@37signals.com").await;
+    for name in ["One", "Two"] {
+        assert_eq!(create_bot(&mut kevin, name).await.status, StatusCode::FOUND);
+    }
+
+    // At the limit: no "Add a chat bot", the form sends back to the list, and creating is refused.
+    let index = kevin.get("/bots").await.text();
+    assert!(index.contains("reached the limit") && !index.contains("Add a chat bot"), "{index}");
+    assert_eq!(kevin.get("/bots/new").await.location(), Some("http://campfire.test/bots"));
+    let refused = create_bot(&mut kevin, "Three").await;
+    assert_eq!(refused.status, StatusCode::UNPROCESSABLE_ENTITY);
+    assert!(refused.text().contains("reached the limit"), "{}", refused.text());
+    assert_eq!(bot_count_of(&app, KEVIN).await, 2);
+
+    // Deleted bots don't count.
+    let (one, _) = bot_named(&app, "One").await;
+    kevin.write(Req::new(Method::DELETE, &format!("/bots/{}", one.id))).await;
+    assert!(kevin.get("/bots").await.text().contains("Add a chat bot"));
+    assert_eq!(create_bot(&mut kevin, "Three").await.status, StatusCode::FOUND);
+
+    // Lowering the limit keeps the bots there are, and only stops new ones.
+    set_bots_per_member(&app, "0").await;
+    assert_eq!(bot_count_of(&app, KEVIN).await, 2);
+    let index = kevin.get("/bots").await.text();
+    assert!(index.contains("Two") && index.contains("Three") && index.contains("reached the limit"), "{index}");
+    assert_eq!(create_bot(&mut kevin, "Four").await.status, StatusCode::UNPROCESSABLE_ENTITY);
+
+    // Administrators aren't limited.
+    let mut david = app.david();
+    for name in ["Five", "Six", "Seven"] {
+        assert_eq!(create_bot(&mut david, name).await.status, StatusCode::FOUND);
+    }
+    assert!(david.get("/bots").await.text().contains("Add a chat bot"));
+}
