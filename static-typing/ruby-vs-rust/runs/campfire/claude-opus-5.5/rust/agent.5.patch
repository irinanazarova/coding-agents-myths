+// --- Misbehaving --------------------------------------------------------------------------------
+
+use crate::{Admission, Message, NewMessage, SuspensionReason, Throttle, Webhook};
+
+/// Posts as the bot, as the bot API does: admitted, then created, in one transaction.
+fn post(t: &TestDb, bot: &Bot) -> Admission {
+    let bot = bot.clone();
+    t.write(move |tx| {
+        let admission = bot.admit_message(tx)?;
+        if admission == Admission::Admitted {
+            let body = Some("<p>Beep</p>".to_string());
+            let attributes = NewMessage { room_id: id("hq"), creator_id: bot.user_id, client_message_id: None, body, attachment_blob_id: None };
+            Message::create(tx, attributes)?;
+        }
+        Ok(admission)
+    })
+}
+
+fn suspension_reason(t: &TestDb, bot: &Bot) -> Option<SuspensionReason> {
+    t.read(|c| bot.suspension(c)).map(|suspension| suspension.reason)
+}
+
+#[test]
+fn a_bot_posts_ten_messages_in_ten_seconds_then_cools_down() {
+    let t = TestDb::new();
+    t.clock.travel_to(jiff::Timestamp::from_second(1_700_000_000).unwrap());
+    let (_, bot) = create_bot(&t);
+
+    for _ in 0..10 {
+        assert_eq!(post(&t, &bot), Admission::Admitted);
+    }
+    assert_eq!(post(&t, &bot), Admission::CoolingDown { retry_after: 30 }, "the eleventh starts the cooldown");
+    t.travel(12);
+    assert_eq!(post(&t, &bot), Admission::CoolingDown { retry_after: 18 }, "however long ago the ten were");
+    let count = t.read(|c| Message::by_creator(c, bot.user_id)).len();
+    assert_eq!(count, 10);
+
+    t.travel(18);
+    assert_eq!(post(&t, &bot), Admission::Admitted, "over");
+    assert_eq!(suspension_reason(&t, &bot), None);
+}
+
+#[test]
+fn the_window_slides() {
+    let t = TestDb::new();
+    t.clock.travel_to(jiff::Timestamp::from_second(1_700_000_000).unwrap());
+    let (_, bot) = create_bot(&t);
+    for _ in 0..9 {
+        assert_eq!(post(&t, &bot), Admission::Admitted);
+    }
+    t.travel(9);
+    assert_eq!(post(&t, &bot), Admission::Admitted);
+    t.travel(2);
+    // The first nine are 11 s old: only one in the last ten seconds.
+    for _ in 0..9 {
+        assert_eq!(post(&t, &bot), Admission::Admitted);
+    }
+    assert!(matches!(post(&t, &bot), Admission::CoolingDown { .. }));
+}
+
+#[test]
+fn five_more_attempts_during_a_cooldown_suspend_the_bot() {
+    let t = TestDb::new();
+    t.clock.travel_to(jiff::Timestamp::from_second(1_700_000_000).unwrap());
+    let (user, bot) = create_bot(&t);
+    for _ in 0..10 {
+        post(&t, &bot);
+    }
+    assert!(matches!(post(&t, &bot), Admission::CoolingDown { .. }));
+    for _ in 0..4 {
+        assert!(matches!(post(&t, &bot), Admission::CoolingDown { .. }));
+    }
+    assert_eq!(suspension_reason(&t, &bot), None, "four aren't enough");
+    assert!(matches!(post(&t, &bot), Admission::CoolingDown { .. }));
+    assert_eq!(suspension_reason(&t, &bot), Some(SuspensionReason::Flooding));
+
+    // Suspended for good: the cooldown ending changes nothing.
+    t.travel(60);
+    assert_eq!(post(&t, &bot), Admission::Suspended);
+    // It's still a member, still counts, and still has its messages.
+    assert!(t.read(|c| User::find(c, user.id)).is_active());
+    assert_eq!(t.read(|c| Bot::count_created_by(c, id("david"))), 1);
+    assert_eq!(t.read(|c| Message::by_creator(c, user.id)).len(), 10);
+
+    let reactivated = bot.clone();
+    t.write(move |tx| reactivated.reactivate(tx));
+    assert_eq!(suspension_reason(&t, &bot), None);
+    assert_eq!(post(&t, &bot), Admission::Admitted);
+}
+
+#[test]
+fn a_new_cooldown_counts_its_attempts_afresh() {
+    let t = TestDb::new();
+    t.clock.travel_to(jiff::Timestamp::from_second(1_700_000_000).unwrap());
+    let (_, bot) = create_bot(&t);
+    for _ in 0..10 {
+        post(&t, &bot);
+    }
+    for _ in 0..5 {
+        post(&t, &bot);
+    }
+    assert_eq!(suspension_reason(&t, &bot), None, "the one that started the cooldown and four more");
+    t.travel(31);
+    for _ in 0..10 {
+        assert_eq!(post(&t, &bot), Admission::Admitted);
+    }
+    for _ in 0..5 {
+        post(&t, &bot);
+    }
+    assert_eq!(suspension_reason(&t, &bot), None);
+    post(&t, &bot);
+    assert_eq!(suspension_reason(&t, &bot), Some(SuspensionReason::Flooding));
+}
+
+fn record(t: &TestDb, bot: &Bot, succeeded: bool) -> bool {
+    let bot = bot.clone();
+    t.write(move |tx| bot.record_delivery(tx, succeeded))
+}
+
+#[test]
+fn ten_failed_deliveries_in_a_row_suspend_the_bot() {
+    let t = TestDb::new();
+    let (user, bot) = create_bot(&t);
+    let with_webhook = bot.clone();
+    t.write(move |tx| with_webhook.update_webhook_url(tx, "http://localhost:4567/hook"));
+    assert_eq!(t.read(|c| Webhook::of_active_bots(c, &[user.id])).len(), 1);
+
+    for _ in 0..9 {
+        assert!(!record(&t, &bot, false));
+    }
+    assert!(!record(&t, &bot, true), "a success starts over");
+    assert_eq!(t.read(|c| Throttle::find_by_bot_id(c, bot.id)).unwrap().failed_deliveries, 0);
+    for _ in 0..9 {
+        assert!(!record(&t, &bot, false));
+    }
+    assert_eq!(suspension_reason(&t, &bot), None);
+    assert!(record(&t, &bot, false));
+    assert_eq!(suspension_reason(&t, &bot), Some(SuspensionReason::FailingWebhook));
+    assert!(t.read(|c| Webhook::of_active_bots(c, &[user.id])).is_empty(), "a suspended bot hears nothing");
+    assert_eq!(post(&t, &bot), Admission::Suspended);
+
+    let reactivated = bot.clone();
+    t.write(move |tx| reactivated.reactivate(tx));
+    assert_eq!(t.read(|c| Webhook::of_active_bots(c, &[user.id])).len(), 1);
+    assert!(!record(&t, &bot, false), "the count started over");
+}
