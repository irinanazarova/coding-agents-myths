+++ b/crates/campfire/src/controllers/bots/suspensions.rs
@@ -0,0 +1,17 @@
+//! `Bots::SuspensionsController`: an administrator reactivates a suspended bot (see
+//! `campfire_db::Suspension`). Only administrators: the bot's creator can't lift what its
+//! misbehaving brought on.
+
+use campfire_kit::{Ctx, Result};
+
+use crate::app::AppCtx;
+use crate::concerns::{self, Before};
+
+/// `before_action :ensure_can_administer`
+pub async fn destroy(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    concerns::ensure_can_administer(c)?;
+    let (_, bot) = super::set_bot(c).await?;
+    c.app().write(move |tx| bot.reactivate(tx)).await?;
+    super::redirect_to_bots(c)
+}
diff --git a/crates/campfire/src/controllers/bots/tests.rs b/crates/campfire/src/controllers/bots/tests.rs
