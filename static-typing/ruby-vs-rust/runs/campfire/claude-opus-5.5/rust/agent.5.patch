@@ -616,3 +616,123 @@ async fn members_can_have_only_so_many_bots() {
     }
     assert!(david.get("/bots").await.text().contains("Add a chat bot"));
 }
+
+// --- Misbehaving --------------------------------------------------------------------------------
+
+async fn suspension_of(app: &TestApp, bot: Bot) -> Option<campfire_db::Suspension> {
+    app.db().read(move |conn| bot.suspension(conn)).await.unwrap()
+}
+
+async fn messages_by(app: &TestApp, user_id: i64) -> usize {
+    app.db().read(move |conn| Message::by_creator(conn, user_id)).await.unwrap().len()
+}
+
+/// Kevin's bot, in HQ, that's posted 10 messages: the next one goes over the limit.
+async fn a_flooding_bot(app: &TestApp) -> (Browser<'_>, User, Bot) {
+    let mut kevin = signed_in(app, "kevin@37signals.com").await;
+    create_bot(&mut kevin, "Flood Bot").await;
+    let (user, bot) = bot_named(app, "Flood Bot").await;
+    for n in 0..10 {
+        let posted = post_as_bot(app, HQ, &bot.key(), &format!("Message {n}")).await;
+        assert_eq!(posted.status, StatusCode::CREATED);
+    }
+    (kevin, user, bot)
+}
+
+#[tokio::test]
+async fn a_flooding_bot_cools_down_then_is_suspended_until_an_administrator_reactivates_it() {
+    let app = TestApp::boot().await;
+    let (mut kevin, user, bot) = a_flooding_bot(&app).await;
+
+    let refused = post_as_bot(&app, HQ, &bot.key(), "One too many").await;
+    assert_eq!(refused.status, StatusCode::TOO_MANY_REQUESTS);
+    assert_eq!(refused.header("retry-after"), Some("30"));
+    for _ in 0..4 {
+        let refused = post_as_bot(&app, HQ, &bot.key(), "Still here").await;
+        assert_eq!(refused.status, StatusCode::TOO_MANY_REQUESTS);
+        let retry_after: i64 = refused.header("retry-after").unwrap().parse().unwrap();
+        assert!((1..=30).contains(&retry_after), "{retry_after}");
+    }
+    assert!(suspension_of(&app, bot.clone()).await.is_none());
+    assert!(!kevin.get("/bots").await.text().contains("Suspended"));
+
+    assert_eq!(post_as_bot(&app, HQ, &bot.key(), "Fifth").await.status, StatusCode::TOO_MANY_REQUESTS);
+    assert!(suspension_of(&app, bot.clone()).await.is_some());
+    assert_eq!(post_as_bot(&app, HQ, &bot.key(), "Suspended").await.status, StatusCode::FORBIDDEN);
+    let user_id = user.id;
+    assert_eq!(app.db().read(move |conn| Message::by_creator(conn, user_id)).await.unwrap().len(), 10, "keeps its messages");
+    assert!(room_ids_of(&app, user.id).await.contains(&HQ), "keeps its rooms");
+    assert_eq!(bot_count_of(&app, KEVIN).await, 1, "still counts");
+
+    // Listed, suspended, with the reason; only administrators can reactivate it.
+    let index = kevin.get("/bots").await.text();
+    assert!(index.contains("Flood Bot") && index.contains("Suspended") && index.contains("more than 10 messages in 10 seconds"), "{index}");
+    assert!(!index.contains("Reactivate"), "{index}");
+    let refused = kevin.write(Req::new(Method::DELETE, &format!("/bots/{}/suspension", user.id))).await;
+    assert_eq!(refused.status, StatusCode::FORBIDDEN);
+    assert!(suspension_of(&app, bot.clone()).await.is_some());
+
+    let mut david = app.david();
+    let index = david.get("/bots").await.text();
+    assert!(index.contains("Reactivate") && index.contains("data-turbo-confirm"), "{index}");
+    assert!(index.contains(&format!(r#"action="/bots/{}/suspension""#, user.id)), "{index}");
+    let reactivated = david.write(Req::new(Method::DELETE, &format!("/bots/{}/suspension", user.id))).await;
+    assert_eq!((reactivated.status, reactivated.location()), (StatusCode::FOUND, Some("http://campfire.test/bots")));
+    assert!(suspension_of(&app, bot.clone()).await.is_none());
+    assert!(!david.get("/bots").await.text().contains("Suspended"));
+}
+
+#[tokio::test]
+async fn webhook_answers_count_towards_the_limit_and_are_not_posted_during_a_cooldown() {
+    let server = FakeServer::start(vec![Route::new("POST", "*", "/hook", 200).header("Content-Type", "text/plain").body("On it")]).await;
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    let (user, bot) = create_bot_in_hq_with_webhook(&app, &mut david, "Chatty Bot", &format!("http://{}/hook", server.addr)).await;
+    for n in 0..9 {
+        assert_eq!(post_as_bot(&app, HQ, &bot.key(), &format!("Message {n}")).await.status, StatusCode::CREATED);
+    }
+    post_message(&mut david, HQ, &mentioning(&app, user.id, "status?")).await;
+    received(&server, 1).await;
+    let started = Instant::now();
+    while messages_by(&app, user.id).await < 10 && started.elapsed() < Duration::from_secs(10) {
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    assert_eq!(messages_by(&app, user.id).await, 10, "the answer is the tenth");
+    assert_eq!(post_as_bot(&app, HQ, &bot.key(), "Eleventh").await.status, StatusCode::TOO_MANY_REQUESTS);
+
+    // It still hears mentions, but its answers aren't posted.
+    post_message(&mut david, HQ, &mentioning(&app, user.id, "again?")).await;
+    received(&server, 2).await;
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert_eq!(messages_by(&app, user.id).await, 10);
+}
+
+#[tokio::test]
+async fn a_bot_whose_webhook_keeps_failing_is_suspended_and_hears_nothing_more() {
+    let server = FakeServer::start(vec![Route::new("POST", "*", "/broken", 500), Route::new("POST", "*", "/fixed", 204)]).await;
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    let (user, bot) = create_bot_in_hq_with_webhook(&app, &mut david, "Broken Bot", &format!("http://{}/broken", server.addr)).await;
+
+    for n in 1..=10 {
+        post_message(&mut david, HQ, &mentioning(&app, user.id, "hello?")).await;
+        assert_eq!(received(&server, n).await.len(), n);
+    }
+    let started = Instant::now();
+    while suspension_of(&app, bot.clone()).await.is_none() && started.elapsed() < Duration::from_secs(10) {
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    assert!(suspension_of(&app, bot.clone()).await.is_some());
+    let index = david.get("/bots").await.text();
+    assert!(index.contains("Suspended") && index.contains("Its webhook failed 10 times in a row."), "{index}");
+    assert_eq!(post_as_bot(&app, HQ, &bot.key(), "Hi").await.status, StatusCode::FORBIDDEN);
+
+    post_message(&mut david, HQ, &mentioning(&app, user.id, "anyone?")).await;
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert_eq!(server.received().len(), 10, "no webhooks while suspended");
+
+    david.write(Req::new(Method::DELETE, &format!("/bots/{}/suspension", user.id))).await;
+    assert_eq!(post_as_bot(&app, HQ, &bot.key(), "Back").await.status, StatusCode::CREATED);
+    post_message(&mut david, HQ, &mentioning(&app, user.id, "welcome back")).await;
+    assert_eq!(received(&server, 11).await.len(), 11);
+}
