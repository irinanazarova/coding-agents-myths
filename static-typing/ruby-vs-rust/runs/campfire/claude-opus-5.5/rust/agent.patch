@@ -0,0 +1,226 @@
+//! `BotsController`: chat bots, which any member can set up (not in Rails Campfire). Members see
+//! and manage the bots they created; administrators, everyone's. See `campfire_db::Bot` and
+//! `messages::by_bots`, the API bots post through.
+
+pub mod keys;
+pub mod suspensions;
+
+use campfire_db::account::cast_boolean;
+use campfire_db::models::bot;
+use campfire_db::{Bot, NewBot, PasswordDigest, Suspension, User};
+use campfire_kit::{Ctx, Error, Result, StatusCode, format, permit_keys};
+use campfire_views::bots::{self as views, BotForm, BotSummary};
+use ruby_compat::integer_cast;
+
+use crate::app::{AppCtx, db_error};
+use crate::concerns::{self, Before};
+use crate::controllers::presenters::attachments::{self, Assignment, Record};
+use crate::controllers::presenters::page::framed_page;
+use crate::controllers::presenters::{self, accounts::string_attribute};
+
+/// Every bot the user can manage, by name, on one page; suspended ones say why.
+pub async fn index(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    c.respond_to(&[&format::HTML])?;
+    let user = concerns::require_current_user(c)?.clone();
+    let (bots, suspensions, reached_limit) = c
+        .app()
+        .read(move |conn| {
+            let bots = Bot::manageable_by(conn, &user)?;
+            let bot_ids: Vec<i64> = bots.iter().map(|(_, bot)| bot.id).collect();
+            Ok((bots, Suspension::of_bots(conn, &bot_ids)?, Bot::reached_limit(conn, &user)?))
+        })
+        .await?;
+    let limit_message = reached_limit.map(bot::limit_message);
+    let secrets = c.app().secrets.clone();
+    let bots: Vec<BotSummary> = bots
+        .iter()
+        .map(|(user, bot)| BotSummary {
+            user: presenters::user_summary(&secrets, user),
+            key: bot.key(),
+            suspension: suspensions.iter().find(|suspension| suspension.bot_id == bot.id).map(|suspension| suspension.reason.description()),
+        })
+        .collect();
+    // Bot codes are credentials: the page that shows them is never stored, by a browser or a cache.
+    c.no_store();
+    framed_page!(c, StatusCode::OK, |ctx| views::Index { ctx, bots: bots.clone(), limit_message: limit_message.clone() }).await
+}
+
+/// The form, unless the user has reached their limit: then back to the list, which says so.
+pub async fn new(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let user = concerns::require_current_user(c)?.clone();
+    if c.app().read(move |conn| Bot::reached_limit(conn, &user)).await?.is_some() {
+        return redirect_to_bots(c);
+    }
+    render_new(c, StatusCode::OK, BotForm::default()).await
+}
+
+/// Creates the bot (in every open room if asked, otherwise in none yet), then back to the list
+/// with its code. `Bot::create` refuses one past the creator's limit, which the form then shows.
+pub async fn create(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let creator_id = concerns::require_current_user(c)?.id;
+    let params = BotParams::from(c)?;
+    let password_digest = PasswordDigest::hash(Bot::unusable_password(), c.app().db.env().bcrypt_cost).await.map_err(Error::internal)?;
+    let name = params.name.clone().unwrap_or_default();
+    let (webhook_url, all_open_rooms) = (params.webhook_url.clone(), params.all_open_rooms);
+    let avatar = params.avatar.stage(c.app()).await?;
+    let saved = c
+        .app()
+        .db
+        .write(move |tx| {
+            let (user, bot) = Bot::create(tx, NewBot { name, creator_id, password_digest })?;
+            if let Some(url) = webhook_url {
+                bot.update_webhook_url(tx, &url)?;
+            }
+            if all_open_rooms == Some(true) {
+                bot.update_all_open_rooms(tx, true)?;
+            }
+            attachments::assign(tx, Record::user(user.id), "avatar", avatar)
+        })
+        .await;
+    match saved {
+        Ok(pending) => attachments::analyze_later(c.app(), pending),
+        Err(campfire_db::Error::RecordInvalid(errors)) => {
+            let form = BotForm {
+                name: params.name.unwrap_or_default(),
+                webhook_url: params.webhook_url.unwrap_or_default(),
+                all_open_rooms: params.all_open_rooms.unwrap_or_default(),
+                errors: errors.full_messages(),
+                ..BotForm::default()
+            };
+            return render_new(c, StatusCode::UNPROCESSABLE_ENTITY, form).await;
+        }
+        Err(error) => return Err(db_error(error)),
+    }
+    redirect_to_bots(c)
+}
+
+pub async fn edit(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let (user, bot) = set_bot(c).await?;
+    let (webhook_url, all_open_rooms) = c.app().read(move |conn| Ok((bot.webhook_url(conn)?, bot.in_all_open_rooms(conn)?))).await?;
+    let bot = Some(presenters::user_summary(&c.app().secrets, &user));
+    let form = BotForm { name: user.name.clone(), webhook_url: webhook_url.unwrap_or_default(), all_open_rooms, bot, errors: Vec::new() };
+    render_edit(c, StatusCode::OK, form).await
+}
+
+/// Renames the bot, sets its webhook URL (a blank one removes the webhook), switches joining every
+/// open room on or off (off keeps the rooms it's in) and replaces its avatar, then back to the list.
+pub async fn update(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let (user, bot) = set_bot(c).await?;
+    let params = BotParams::from(c)?;
+    let avatar = params.avatar.stage(c.app()).await?;
+    let (name, webhook_url, all_open_rooms) = (params.name.clone(), params.webhook_url.clone(), params.all_open_rooms);
+    let (form_user, form_bot) = (user.clone(), bot.clone());
+    let saved = c
+        .app()
+        .db
+        .write(move |tx| {
+            let mut user = user;
+            if let Some(name) = name {
+                Bot::rename(&mut user, tx, name)?;
+            }
+            if let Some(url) = webhook_url {
+                bot.update_webhook_url(tx, &url)?;
+            }
+            if let Some(all_open_rooms) = all_open_rooms {
+                bot.update_all_open_rooms(tx, all_open_rooms)?;
+            }
+            attachments::assign(tx, Record::user(user.id), "avatar", avatar)
+        })
+        .await;
+    match saved {
+        Ok(pending) => attachments::analyze_later(c.app(), pending),
+        Err(campfire_db::Error::RecordInvalid(errors)) => {
+            let all_open_rooms = match params.all_open_rooms {
+                Some(all_open_rooms) => all_open_rooms,
+                None => c.app().read(move |conn| form_bot.in_all_open_rooms(conn)).await?,
+            };
+            let bot = Some(presenters::user_summary(&c.app().secrets, &form_user));
+            let form = BotForm {
+                name: params.name.unwrap_or_default(),
+                webhook_url: params.webhook_url.unwrap_or_default(),
+                all_open_rooms,
+                bot,
+                errors: errors.full_messages(),
+            };
+            return render_edit(c, StatusCode::UNPROCESSABLE_ENTITY, form).await;
+        }
+        Err(error) => return Err(db_error(error)),
+    }
+    redirect_to_bots(c)
+}
+
+/// Deletes the bot: its code stops working, and its messages stay.
+pub async fn destroy(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let (user, bot) = set_bot(c).await?;
+    c.app()
+        .write(move |tx| {
+            let mut user = user;
+            bot.destroy(tx, &mut user)
+        })
+        .await?;
+    redirect_to_bots(c)
+}
+
+// --- Before-actions and params --------------------------------------------------------------------
+
+/// The bot `params[:bot_id] || params[:id]` names, among those the user can manage; 404 for any
+/// other, so someone else's bots can't even be told apart from missing ones.
+pub(crate) async fn set_bot(c: &Ctx) -> Result<(User, Bot)> {
+    let user = concerns::require_current_user(c)?.clone();
+    let id = c.param_str("bot_id").or_else(|| c.param_str("id")).and_then(integer_cast).ok_or(Error::NotFound)?;
+    c.app().read(move |conn| Bot::find_manageable_by(conn, &user, id)).await
+}
+
+/// `params.require(:bot).permit(:name, :webhook_url, :all_open_rooms, :avatar)`
+struct BotParams {
+    /// `None` when the key wasn't given.
+    name: Option<String>,
+    /// `None` when the key wasn't given (the webhook stays as it is); blank removes it.
+    webhook_url: Option<String>,
+    /// The "Add to all open rooms" switch, cast as Active Model casts a boolean (the check box's
+    /// hidden field sends `"0"` when it's off). `None` when the key wasn't given, or was blank.
+    all_open_rooms: Option<bool>,
+    /// Only an upload changes the avatar: the form has no way to remove one.
+    avatar: Assignment,
+}
+
+impl BotParams {
+    fn from(c: &Ctx) -> Result<Self> {
+        let params = c.params.require("bot")?.permit(&permit_keys(&["name", "webhook_url", "all_open_rooms", "avatar"]));
+        let name = string_attribute(&params, "name").map(Option::unwrap_or_default);
+        let webhook_url = string_attribute(&params, "webhook_url").map(Option::unwrap_or_default);
+        let all_open_rooms = string_attribute(&params, "all_open_rooms").flatten().and_then(|value| cast_boolean(&value));
+        let avatar = match Assignment::from_params(&params, "avatar")? {
+            upload @ Assignment::Create(_) => upload,
+            _ => Assignment::Unchanged,
+        };
+        Ok(Self { name, webhook_url, all_open_rooms, avatar })
+    }
+}
+
+// --- Rendering ------------------------------------------------------------------------------------
+
+async fn render_new(c: &mut Ctx, status: StatusCode, form: BotForm) -> Result {
+    c.respond_to(&[&format::HTML])?;
+    framed_page!(c, status, |ctx| views::New { ctx, form: form.clone() }).await
+}
+
+async fn render_edit(c: &mut Ctx, status: StatusCode, form: BotForm) -> Result {
+    c.respond_to(&[&format::HTML])?;
+    let bot_id = form.bot.as_ref().map_or(0, |bot| bot.id);
+    framed_page!(c, status, |ctx| views::Edit { ctx, form: form.clone(), bot_id }).await
+}
+
+pub(crate) fn redirect_to_bots(c: &mut Ctx) -> Result {
+    let location = c.url_for(&campfire_routes::bots());
+    c.redirect_to(&location)
+}
