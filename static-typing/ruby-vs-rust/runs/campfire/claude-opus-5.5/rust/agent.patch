+//! `Bots::KeysController`: a new code for a bot, so the old one stops working.
+
+use campfire_kit::{Ctx, Result};
+
+use crate::app::AppCtx;
+use crate::concerns::{self, Before};
+
+pub async fn update(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let (_, bot) = super::set_bot(c).await?;
+    c.app()
+        .write(move |tx| {
+            let mut bot = bot;
+            bot.reset_token(tx)
+        })
+        .await?;
+    super::redirect_to_bots(c)
+}
