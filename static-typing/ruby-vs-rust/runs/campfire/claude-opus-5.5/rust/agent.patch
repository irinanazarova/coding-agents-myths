+/// Creates an open room named `name`, and returns its id.
+async fn create_open_room(app: &TestApp, browser: &mut Browser<'_>, name: &'static str) -> i64 {
+    let created = browser.write(Req::new(Method::POST, "/rooms/opens").form(&[("room[name]", name)])).await;
