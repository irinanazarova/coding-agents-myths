diff --git a/crates/db/src/tests/bot_test.rs b/crates/db/src/tests/bot_test.rs
new file mode 100644
index 0000000..76cd2a7
--- /dev/null
+++ b/crates/db/src/tests/bot_test.rs
@@ -0,0 +1,242 @@
+//! Bots' rooms (not in Rails Campfire): they join only the rooms they're added to, or every open
+//! room when set to, and each room they join emits `Event::BotJoined` once.
+
+use super::*;
+use crate::{Bot, NewBot, PasswordDigest, Room, RoomType, User};
+
+fn create_bot(t: &TestDb) -> (User, Bot) {
+    let password_digest = PasswordDigest::create("unused", 4).unwrap();
+    t.write(move |tx| Bot::create(tx, NewBot { name: "Greeter".into(), creator_id: id("david"), password_digest }))
+}
+
+fn room_ids_of(t: &TestDb, user_id: i64) -> Vec<i64> {
+    let mut ids: Vec<i64> = t.read(|c| crate::Membership::for_user(c, user_id)).into_iter().map(|m| m.room_id).collect();
+    ids.sort();
+    ids
+}
+
+fn open_room_ids(t: &TestDb) -> Vec<i64> {
+    let mut ids: Vec<i64> = t.read(|c| Room::of_type(c, RoomType::Open)).into_iter().map(|room| room.id).collect();
+    ids.sort();
+    ids
+}
+
+fn joined(t: &TestDb) -> Vec<(i64, i64)> {
+    let mut joined: Vec<(i64, i64)> = t
+        .sink
+        .take()
+        .into_iter()
+        .filter_map(|event| match event {
+            Event::BotJoined { room_id, user_id } => Some((room_id, user_id)),
+            _ => None,
+        })
+        .collect();
+    joined.sort();
+    joined
+}
+
+#[test]
+fn a_new_bot_joins_no_room_and_new_open_rooms_leave_it_out() {
+    let t = TestDb::new();
+    let (user, bot) = create_bot(&t);
+    assert!(room_ids_of(&t, user.id).is_empty());
+    assert!(!t.read(|c| bot.in_all_open_rooms(c)));
+
+    let room = t.write(|tx| Room::create(tx, RoomType::Open, Some("Watercooler"), id("david")));
+    assert!(!t.read(|c| room.user_ids(c)).contains(&user.id));
+    assert!(t.read(|c| room.user_ids(c)).contains(&id("kevin")), "people still join");
+    assert_eq!(joined(&t), vec![]);
+}
+
+#[test]
+fn a_bot_in_all_open_rooms_joins_each_once_and_stays_when_switched_off() {
+    let t = TestDb::new();
+    let (user, bot) = create_bot(&t);
+    t.sink.take();
+
+    let switched = bot.clone();
+    t.write(move |tx| switched.update_all_open_rooms(tx, true));
+    let open = open_room_ids(&t);
+    assert_eq!(room_ids_of(&t, user.id), open);
+    assert_eq!(joined(&t), open.iter().map(|room_id| (*room_id, user.id)).collect::<Vec<_>>());
+
+    // On again: already in them all, so nothing to join.
+    let switched = bot.clone();
+    t.write(move |tx| switched.update_all_open_rooms(tx, true));
+    assert_eq!(joined(&t), vec![]);
+
+    let room = t.write(|tx| Room::create(tx, RoomType::Open, Some("Watercooler"), id("david")));
+    assert_eq!(joined(&t), vec![(room.id, user.id)]);
+
+    let switched = bot.clone();
+    t.write(move |tx| switched.update_all_open_rooms(tx, false));
+    assert!(!t.read(|c| bot.in_all_open_rooms(c)));
+    assert_eq!(room_ids_of(&t, user.id), open_room_ids(&t), "keeps its rooms");
+    let later = t.write(|tx| Room::create(tx, RoomType::Open, Some("Later"), id("david")));
+    assert!(!room_ids_of(&t, user.id).contains(&later.id));
+    assert_eq!(joined(&t), vec![]);
+}
+
+#[test]
+fn bots_added_to_rooms_join_them_but_never_direct_ones() {
+    let t = TestDb::new();
+    let (user, _) = create_bot(&t);
+    t.sink.take();
+    let bot_id = user.id;
+
+    let closed = t.write(move |tx| Room::create_for(tx, RoomType::Closed, Some("Ops"), id("david"), &[id("david"), bot_id]));
+    assert_eq!(joined(&t), vec![(closed.id, bot_id)]);
+    let again = closed.clone();
+    t.write(move |tx| again.grant_to(tx, &[bot_id, id("kevin")]));
+    assert_eq!(joined(&t), vec![], "already a member");
+
+    t.write(move |tx| Room::find_or_create_direct_for(tx, &[id("david"), bot_id], id("david")));
+    assert_eq!(joined(&t), vec![]);
+}
+
+// --- Misbehaving --------------------------------------------------------------------------------
+
+use crate::{Admission, Message, NewMessage, SuspensionReason, Throttle, Webhook};
+
+/// Posts as the bot, as the bot API does: admitted, then created, in one transaction.
+fn post(t: &TestDb, bot: &Bot) -> Admission {
+    let bot = bot.clone();
+    t.write(move |tx| {
+        let admission = bot.admit_message(tx)?;
+        if admission == Admission::Admitted {
+            let body = Some("<p>Beep</p>".to_string());
+            let attributes = NewMessage { room_id: id("hq"), creator_id: bot.user_id, client_message_id: None, body, attachment_blob_id: None };
+            Message::create(tx, attributes)?;
+        }
+        Ok(admission)
+    })
+}
+
+fn suspension_reason(t: &TestDb, bot: &Bot) -> Option<SuspensionReason> {
+    t.read(|c| bot.suspension(c)).map(|suspension| suspension.reason)
+}
+
+#[test]
+fn a_bot_posts_ten_messages_in_ten_seconds_then_cools_down() {
+    let t = TestDb::new();
+    t.clock.travel_to(jiff::Timestamp::from_second(1_700_000_000).unwrap());
+    let (_, bot) = create_bot(&t);
+
+    for _ in 0..10 {
+        assert_eq!(post(&t, &bot), Admission::Admitted);
+    }
+    assert_eq!(post(&t, &bot), Admission::CoolingDown { retry_after: 30 }, "the eleventh starts the cooldown");
+    t.travel(12);
+    assert_eq!(post(&t, &bot), Admission::CoolingDown { retry_after: 18 }, "however long ago the ten were");
+    let count = t.read(|c| Message::by_creator(c, bot.user_id)).len();
+    assert_eq!(count, 10);
+
+    t.travel(18);
+    assert_eq!(post(&t, &bot), Admission::Admitted, "over");
+    assert_eq!(suspension_reason(&t, &bot), None);
+}
+
+#[test]
+fn the_window_slides() {
+    let t = TestDb::new();
+    t.clock.travel_to(jiff::Timestamp::from_second(1_700_000_000).unwrap());
+    let (_, bot) = create_bot(&t);
+    for _ in 0..9 {
+        assert_eq!(post(&t, &bot), Admission::Admitted);
+    }
+    t.travel(9);
+    assert_eq!(post(&t, &bot), Admission::Admitted);
+    t.travel(2);
+    // The first nine are 11 s old: only one in the last ten seconds.
+    for _ in 0..9 {
+        assert_eq!(post(&t, &bot), Admission::Admitted);
+    }
+    assert!(matches!(post(&t, &bot), Admission::CoolingDown { .. }));
+}
+
+#[test]
+fn five_more_attempts_during_a_cooldown_suspend_the_bot() {
+    let t = TestDb::new();
+    t.clock.travel_to(jiff::Timestamp::from_second(1_700_000_000).unwrap());
+    let (user, bot) = create_bot(&t);
+    for _ in 0..10 {
+        post(&t, &bot);
+    }
+    assert!(matches!(post(&t, &bot), Admission::CoolingDown { .. }));
+    for _ in 0..4 {
+        assert!(matches!(post(&t, &bot), Admission::CoolingDown { .. }));
+    }
+    assert_eq!(suspension_reason(&t, &bot), None, "four aren't enough");
+    assert!(matches!(post(&t, &bot), Admission::CoolingDown { .. }));
+    assert_eq!(suspension_reason(&t, &bot), Some(SuspensionReason::Flooding));
+
+    // Suspended for good: the cooldown ending changes nothing.
+    t.travel(60);
+    assert_eq!(post(&t, &bot), Admission::Suspended);
+    // It's still a member, still counts, and still has its messages.
+    assert!(t.read(|c| User::find(c, user.id)).is_active());
+    assert_eq!(t.read(|c| Bot::count_created_by(c, id("david"))), 1);
+    assert_eq!(t.read(|c| Message::by_creator(c, user.id)).len(), 10);
+
+    let reactivated = bot.clone();
+    t.write(move |tx| reactivated.reactivate(tx));
+    assert_eq!(suspension_reason(&t, &bot), None);
+    assert_eq!(post(&t, &bot), Admission::Admitted);
+}
+
+#[test]
+fn a_new_cooldown_counts_its_attempts_afresh() {
+    let t = TestDb::new();
+    t.clock.travel_to(jiff::Timestamp::from_second(1_700_000_000).unwrap());
+    let (_, bot) = create_bot(&t);
+    for _ in 0..10 {
+        post(&t, &bot);
+    }
+    for _ in 0..5 {
+        post(&t, &bot);
+    }
+    assert_eq!(suspension_reason(&t, &bot), None, "the one that started the cooldown and four more");
+    t.travel(31);
+    for _ in 0..10 {
+        assert_eq!(post(&t, &bot), Admission::Admitted);
+    }
+    for _ in 0..5 {
+        post(&t, &bot);
+    }
+    assert_eq!(suspension_reason(&t, &bot), None);
+    post(&t, &bot);
+    assert_eq!(suspension_reason(&t, &bot), Some(SuspensionReason::Flooding));
+}
+
+fn record(t: &TestDb, bot: &Bot, succeeded: bool) -> bool {
+    let bot = bot.clone();
+    t.write(move |tx| bot.record_delivery(tx, succeeded))
+}
+
+#[test]
+fn ten_failed_deliveries_in_a_row_suspend_the_bot() {
+    let t = TestDb::new();
+    let (user, bot) = create_bot(&t);
+    let with_webhook = bot.clone();
+    t.write(move |tx| with_webhook.update_webhook_url(tx, "http://localhost:4567/hook"));
+    assert_eq!(t.read(|c| Webhook::of_active_bots(c, &[user.id])).len(), 1);
+
+    for _ in 0..9 {
+        assert!(!record(&t, &bot, false));
+    }
+    assert!(!record(&t, &bot, true), "a success starts over");
+    assert_eq!(t.read(|c| Throttle::find_by_bot_id(c, bot.id)).unwrap().failed_deliveries, 0);
+    for _ in 0..9 {
+        assert!(!record(&t, &bot, false));
+    }
+    assert_eq!(suspension_reason(&t, &bot), None);
+    assert!(record(&t, &bot, false));
+    assert_eq!(suspension_reason(&t, &bot), Some(SuspensionReason::FailingWebhook));
+    assert!(t.read(|c| Webhook::of_active_bots(c, &[user.id])).is_empty(), "a suspended bot hears nothing");
+    assert_eq!(post(&t, &bot), Admission::Suspended);
+
+    let reactivated = bot.clone();
+    t.write(move |tx| reactivated.reactivate(tx));
+    assert_eq!(t.read(|c| Webhook::of_active_bots(c, &[user.id])).len(), 1);
+    assert!(!record(&t, &bot, false), "the count started over");
+}
