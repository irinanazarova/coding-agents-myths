+// --- Webhooks ---------------------------------------------------------------------------------------
+
+use std::time::{Duration, Instant};
+
+use crate::integrations::test_support::{FakeServer, Received, Route};
+
+async fn create_bot_with_webhook(browser: &mut Browser<'_>, name: &str, url: &str) -> Reply {
+    browser.write(Req::new(Method::POST, "/bots").form(&[("bot[name]", name), ("bot[webhook_url]", url)])).await
+}
+
+/// Renames the bot "Builder", and sets its webhook URL when one's given.
+async fn rename_bot(browser: &mut Browser<'_>, bot_id: i64, webhook_url: Option<&str>) -> Reply {
+    let mut pairs = vec![("bot[name]", "Builder")];
+    pairs.extend(webhook_url.map(|url| ("bot[webhook_url]", url)));
+    browser.write(Req::new(Method::PATCH, &format!("/bots/{bot_id}")).form(&pairs)).await
+}
+
+/// Creates a bot with a webhook that's a member of HQ, without the webhook hearing it joined: the
+/// membership is inserted as one from before bots heard `joined` would be.
+async fn create_bot_in_hq_with_webhook(app: &TestApp, browser: &mut Browser<'_>, name: &'static str, url: &str) -> (User, Bot) {
+    create_bot_with_webhook(browser, name, url).await;
+    let (bot, key) = bot_named(app, name).await;
+    let bot_id = bot.id;
+    let sql = r#"INSERT INTO "memberships" ("room_id", "user_id", "involvement", "created_at", "updated_at") VALUES (?, ?, 'mentions', ?, ?)"#;
+    app.db().write(move |tx| Ok(tx.conn().execute(sql, rusqlite::params![HQ, bot_id, tx.now(), tx.now()])?)).await.unwrap();
+    (bot, key)
+}
+
+/// The JSON payloads the server received, of the event `event`.
+fn payloads_of(server: &FakeServer, event: &str) -> Vec<serde_json::Value> {
+    let payloads = server.received().into_iter().map(|request| serde_json::from_slice::<serde_json::Value>(&request.body).unwrap());
+    payloads.filter(|payload| payload["event"] == event).collect()
+}
+
+async fn webhook_url_of(app: &TestApp, bot: Bot) -> Option<String> {
+    app.db().read(move |conn| bot.webhook_url(conn)).await.unwrap()
+}
+
+/// A message body as the composer posts it, mentioning `user_id` first.
+fn mentioning(app: &TestApp, user_id: i64, text: &str) -> String {
+    let sgid = crate::controllers::presenters::accounts::attachable_sgid(&app.booted.app.secrets, user_id);
+    let mention =
+        format!(r#"<action-text-attachment sgid="{sgid}" content-type="application/vnd.campfire.mention"></action-text-attachment>"#);
+    format!("<p>{mention} {text}</p>")
+}
+
+async fn post_message(browser: &mut Browser<'_>, room_id: i64, body: &str) -> Reply {
+    let request = Req::new(Method::POST, &format!("/rooms/{room_id}/messages"))
+        .header("accept", "text/vnd.turbo-stream.html, text/html, application/xhtml+xml")
+        .form(&[("message[body]", body)]);
+    browser.write(request).await
+}
+
+/// Waits (up to 10 s) for the server to have received `count` requests.
+async fn received(server: &FakeServer, count: usize) -> Vec<Received> {
+    let started = Instant::now();
+    loop {
+        let received = server.received();
+        if received.len() >= count || started.elapsed() > Duration::from_secs(10) {
+            return received;
+        }
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+}
+
+/// Waits (up to 10 s) for a message by `creator_id` in `room_id`.
+async fn message_by(app: &TestApp, room_id: i64, creator_id: i64) -> Option<Message> {
+    let started = Instant::now();
+    loop {
+        let messages = app.db().read(move |conn| Message::last_page(conn, room_id)).await.unwrap();
+        if let Some(message) = messages.into_iter().find(|message| message.creator_id == creator_id) {
+            return Some(message);
+        }
+        if started.elapsed() > Duration::from_secs(10) {
+            return None;
+        }
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+}
+
+#[tokio::test]
+async fn the_bot_form_sets_and_removes_the_webhook_url() {
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    let new = david.get("/bots/new").await;
+    assert!(new.text().contains("Webhook URL") && new.text().contains(r#"name="bot[webhook_url]""#), "{}", new.text());
+
+    let created = create_bot_with_webhook(&mut david, "Build Bot", " http://localhost:4567/hook ").await;
+    assert_eq!(created.status, StatusCode::FOUND, "{}", created.text());
+    let (user, bot) = bot_named(&app, "Build Bot").await;
+    assert_eq!(webhook_url_of(&app, bot.clone()).await.as_deref(), Some("http://localhost:4567/hook"));
+    let edit = david.get(&format!("/bots/{}/edit", user.id)).await;
+    assert!(edit.text().contains("Webhook URL") && edit.text().contains(r#"value="http://localhost:4567/hook""#), "{}", edit.text());
+
+    // A rename alone leaves the webhook be.
+    rename_bot(&mut david, user.id, None).await;
