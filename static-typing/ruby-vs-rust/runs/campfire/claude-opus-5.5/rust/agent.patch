+#[tokio::test]
+async fn a_bot_is_renamed_and_deleted() {
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    create_bot(&mut david, "Deploy Bot").await;
+    let (bot, key) = bot_named(&app, "Deploy Bot").await;
+
+    let edit = david.get(&format!("/bots/{}/edit", bot.id)).await;
+    assert_eq!(edit.status, StatusCode::OK);
+    assert!(edit.text().contains("Delete this chat bot") && edit.text().contains("data-turbo-confirm"), "{}", edit.text());
+
+    let renamed = david.write(Req::new(Method::PATCH, &format!("/bots/{}", bot.id)).form(&[("bot[name]", "Release Bot")])).await;
+    assert_eq!(renamed.location(), Some("http://campfire.test/bots"));
+    assert!(david.get("/bots").await.text().contains("Release Bot"));
+    let blank = david.write(Req::new(Method::PATCH, &format!("/bots/{}", bot.id)).form(&[("bot[name]", "")])).await;
+    assert_eq!(blank.status, StatusCode::UNPROCESSABLE_ENTITY);
+
+    assert_eq!(post_as_bot(&app, HQ, &key.key(), "Before").await.status, StatusCode::CREATED);
+    let deleted = david.write(Req::new(Method::DELETE, &format!("/bots/{}", bot.id))).await;
+    assert_eq!(deleted.location(), Some("http://campfire.test/bots"));
+    assert!(!david.get("/bots").await.text().contains("Release Bot"));
+    assert_eq!(post_as_bot(&app, HQ, &key.key(), "After").await.status, StatusCode::UNAUTHORIZED);
+    // Its messages keep their author.
+    let bot_id = bot.id;
+    assert_eq!(app.db().read(move |conn| Message::by_creator(conn, bot_id)).await.unwrap().len(), 1);
+}
+
+#[tokio::test]
+async fn a_bot_posts_its_raw_body() {
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    create_bot(&mut david, "Deploy Bot").await;
+    let (bot, key) = bot_named(&app, "Deploy Bot").await;
+
+    for body in ["Deploy of v1.2.3 finished ✅", "100% done & dusted + more"] {
+        let reply = post_as_bot(&app, HQ, &key.key(), body).await;
+        assert_eq!(reply.status, StatusCode::CREATED, "{}", reply.text());
+        let message = app.db().read(move |conn| Message::last_page(conn, HQ)).await.unwrap().pop().unwrap();
+        assert_eq!(reply.location(), Some(format!("/messages/{}", message.id).as_str()));
+        assert_eq!(message.creator_id, bot.id);
+        let stored = rich_text_body(&app, message.id).await;
+        assert!(stored.contains(&body.replace('&', "&amp;")), "{stored}");
+    }
+
+    let page = david.get(&format!("/rooms/{HQ}")).await;
+    assert!(page.text().contains("Deploy of v1.2.3 finished ✅") && page.text().contains("Deploy Bot"));
+
+    assert_eq!(post_as_bot(&app, HQ, &key.key(), "").await.status, StatusCode::UNPROCESSABLE_ENTITY);
+    assert_eq!(post_as_bot(&app, HQ, &key.key(), " \n").await.status, StatusCode::UNPROCESSABLE_ENTITY);
+    assert_eq!(post_as_bot(&app, 1, &key.key(), "Hi").await.status, StatusCode::NOT_FOUND);
+    assert_eq!(post_as_bot(&app, ALL_TALK, &key.key(), "Hi").await.status, StatusCode::NOT_FOUND, "not a member");
+    for wrong in [format!("{}-nope", bot.id), format!("{}-{}", DAVID, key.token), "nope".to_string(), key.token.clone()] {
+        assert_eq!(post_as_bot(&app, HQ, &wrong, "Hi").await.status, StatusCode::UNAUTHORIZED, "{wrong}");
+    }
+
+    // A new code replaces the old one.
+    let reset = david.write(Req::new(Method::PATCH, &format!("/bots/{}/key", bot.id))).await;
+    assert_eq!(reset.location(), Some("http://campfire.test/bots"));
+    assert_eq!(post_as_bot(&app, HQ, &key.key(), "Old").await.status, StatusCode::UNAUTHORIZED);
+    let (_, key) = bot_named(&app, "Deploy Bot").await;
+    assert_eq!(post_as_bot(&app, HQ, &key.key(), "New").await.status, StatusCode::CREATED);
+}
+
+#[tokio::test]
+async fn a_bot_posts_an_attachment() {
