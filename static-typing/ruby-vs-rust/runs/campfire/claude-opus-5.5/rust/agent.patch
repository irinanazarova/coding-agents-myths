+    let server = FakeServer::start(vec![Route::new("POST", "*", "/hook", 200).header("Content-Type", "text/plain").body("On it")]).await;
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    let (user, bot) = create_bot_in_hq_with_webhook(&app, &mut david, "Chatty Bot", &format!("http://{}/hook", server.addr)).await;
+    for n in 0..9 {
+        assert_eq!(post_as_bot(&app, HQ, &bot.key(), &format!("Message {n}")).await.status, StatusCode::CREATED);
+    }
+    post_message(&mut david, HQ, &mentioning(&app, user.id, "status?")).await;
+    received(&server, 1).await;
+    let started = Instant::now();
+    while messages_by(&app, user.id).await < 10 && started.elapsed() < Duration::from_secs(10) {
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    assert_eq!(messages_by(&app, user.id).await, 10, "the answer is the tenth");
+    assert_eq!(post_as_bot(&app, HQ, &bot.key(), "Eleventh").await.status, StatusCode::TOO_MANY_REQUESTS);
+
+    // It still hears mentions, but its answers aren't posted.
+    post_message(&mut david, HQ, &mentioning(&app, user.id, "again?")).await;
+    received(&server, 2).await;
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert_eq!(messages_by(&app, user.id).await, 10);
+}
+
+#[tokio::test]
+async fn a_bot_whose_webhook_keeps_failing_is_suspended_and_hears_nothing_more() {
+    let server = FakeServer::start(vec![Route::new("POST", "*", "/broken", 500), Route::new("POST", "*", "/fixed", 204)]).await;
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    let (user, bot) = create_bot_in_hq_with_webhook(&app, &mut david, "Broken Bot", &format!("http://{}/broken", server.addr)).await;
+
+    for n in 1..=10 {
+        post_message(&mut david, HQ, &mentioning(&app, user.id, "hello?")).await;
+        assert_eq!(received(&server, n).await.len(), n);
+    }
+    let started = Instant::now();
+    while suspension_of(&app, bot.clone()).await.is_none() && started.elapsed() < Duration::from_secs(10) {
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    assert!(suspension_of(&app, bot.clone()).await.is_some());
+    let index = david.get("/bots").await.text();
+    assert!(index.contains("Suspended") && index.contains("Its webhook failed 10 times in a row."), "{index}");
+    assert_eq!(post_as_bot(&app, HQ, &bot.key(), "Hi").await.status, StatusCode::FORBIDDEN);
+
+    post_message(&mut david, HQ, &mentioning(&app, user.id, "anyone?")).await;
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert_eq!(server.received().len(), 10, "no webhooks while suspended");
+
+    david.write(Req::new(Method::DELETE, &format!("/bots/{}/suspension", user.id))).await;
+    assert_eq!(post_as_bot(&app, HQ, &bot.key(), "Back").await.status, StatusCode::CREATED);
+    post_message(&mut david, HQ, &mentioning(&app, user.id, "welcome back")).await;
+    assert_eq!(received(&server, 11).await.len(), 11);
+}
