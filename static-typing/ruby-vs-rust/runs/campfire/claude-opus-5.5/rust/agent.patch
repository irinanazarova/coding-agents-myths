+/// Sets the "Add to all open rooms" switch as the edit form submits it.
+async fn switch_all_open_rooms(browser: &mut Browser<'_>, bot_id: i64, on: bool) -> Reply {
+    let mut pairs = vec![("bot[name]", "Greeter"), ("bot[all_open_rooms]", "0")];
