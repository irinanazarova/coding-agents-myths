+{#- bots/_form.html: a new bot's form, and an existing one's on its edit page -#}
+{% let builder = h::form_with(form.action()).model("bot").method(form.method()).class("flex flex-column gap").data("controller", "upload-preview") %}{% filter form_with(builder) %}
+  <div class="flex justify-center">
+    <label class="btn avatar input--file txt-xx-large">
+{% if let Some(bot) = form.bot %}      {{ h::image_tag(ctx, bot.avatar_path.as_str(), h::attrs().aria_hidden().size(300).data("upload_preview_target", "image")) }}
+{% else %}      {{ h::image_tag(ctx, "default-avatar.svg", h::attrs().aria_hidden().size(300).data("upload_preview_target", "image")) }}
+{% endif %}      {{ builder.file_field("avatar", h::attrs().class("input").accept("image/*").data("upload_preview_target", "input").data("action", "upload-preview#previewImage")) }}
+      <span class="for-screen-reader">Bot avatar</span>
+    </label>
+  </div>
+
+{% if !form.errors.is_empty() %}  <ul class="margin-none txt-negative" role="alert">
+{% for error in form.errors %}    <li>{{ error }}</li>
+{% endfor %}  </ul>
+{% endif %}
+  <label class="flex align-center gap input input--actor">
+    <span class="for-screen-reader">Name the bot</span>
+    {{ builder.text_field("name", Some(form.name.as_str()), h::attrs().class("input txt-large").autocomplete("off").placeholder("Name the bot").autofocus().required(true).data("1p-ignore", true)) }}
+    {{ h::image_tag(ctx, "bot.svg", h::attrs().aria_hidden().size(24).class("colorize--black")) }}
+  </label>
+
+  <div class="flex flex-column gap txt-align-start" style="--row-gap: 0.25em">
+    <label class="flex flex-column gap" style="--row-gap: 0.25em">
+      <span class="txt-small">Webhook URL</span>
+      <span class="flex align-center gap input input--actor">
+        {{ h::image_tag(ctx, "web.svg", h::attrs().aria_hidden().size(20).class("colorize--black")) }}
+        {{ builder.url_field("webhook_url", Some(form.webhook_url.as_str()), h::attrs().class("input").autocomplete("off").placeholder("https://example.com/campfire").attr("spellcheck", "false").aria("describedby", "bot_webhook_url_hint").data("1p-ignore", true)) }}
+      </span>
+    </label>
+    <span class="txt-small txt-subtle" id="bot_webhook_url_hint">Optional. When someone mentions the bot or adds it to a room, it’s posted here, and a text or HTML answer is posted back as the bot’s.</span>
+  </div>
+
+  <div class="flex flex-column gap txt-align-start" style="--row-gap: 0.25em">
+    <label class="flex align-center gap justify-space-between">
+      <span>Add to all open rooms</span>
+      <span class="switch">
+        {{ builder.check_box("all_open_rooms", h::attrs().class("switch__input switch__input--cover").aria("describedby", "bot_all_open_rooms_hint"), "1", "0", form.all_open_rooms_value()) }}
+        <span class="switch__btn round"></span>
+      </span>
+    </label>
+    <span class="txt-small txt-subtle" id="bot_all_open_rooms_hint">The bot joins every open room, including new ones. Otherwise, add it to the rooms you choose.</span>
+  </div>
+
+  {% filter button(h::attrs().class("btn btn--reversed center txt-large").type_("submit")) %}
+    {{ h::image_tag(ctx, "check.svg", h::attrs().aria_hidden().size(20)) }}
+    <span class="for-screen-reader">Save changes</span>
+{% endfilter %}{% endfilter %}
