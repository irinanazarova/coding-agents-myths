+#[tokio::test]
+async fn a_bot_joins_only_the_rooms_its_added_to_and_hears_it_once() {
+    let hello = Route::new("POST", "*", "/hook", 200).header("Content-Type", "text/plain").body("Hello, all!");
+    let server = FakeServer::start(vec![hello]).await;
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    create_bot_with_webhook(&mut david, "Greeter", &format!("http://{}/hook", server.addr)).await;
+    let (bot, key) = bot_named(&app, "Greeter").await;
+    assert!(room_ids_of(&app, bot.id).await.is_empty(), "bots don't join the open rooms by default");
+    let edit = david.get(&format!("/bots/{}/edit", bot.id)).await;
+    assert!(!edit.text().contains(r#"checked="checked" name="bot[all_open_rooms]""#), "{}", edit.text());
+
+    // A new open room doesn't take it either, but people still join.
+    let open = create_open_room(&app, &mut david, "Watercooler").await;
+    assert!(!room_ids_of(&app, bot.id).await.contains(&open));
+    assert!(room_ids_of(&app, JASON).await.contains(&open));
+
+    // Added to a closed room by a person: it hears it joined, and its answer is posted there.
+    let created = david
+        .write(Req::new(Method::POST, "/rooms/closeds").form(&[
+            ("room[name]", "Ops"),
+            ("user_ids[]", &DAVID.to_string()),
+            ("user_ids[]", &bot.id.to_string()),
+        ]))
+        .await;
+    assert_eq!(created.status, StatusCode::FOUND);
+    let ops = room_named(&app, "Ops").await;
+    assert_eq!(received(&server, 1).await.len(), 1);
+    let payload = &payloads_of(&server, "joined")[0];
+    let expected = serde_json::json!({
+        "event": "joined",
+        "room": { "id": ops, "name": "Ops", "reply_to": format!("/rooms/{ops}/{}/messages", key.key()) },
+    });
+    assert_eq!(payload, &expected);
+    let answer = message_by(&app, ops, bot.id).await.expect("the bot's hello");
+    assert!(rich_text_body(&app, answer.id).await.contains("Hello, all!"));
+
+    // Saving the room again with the bot still in it isn't joining it again.
+    let path = format!("/rooms/closeds/{ops}");
+    let pairs = [("room[name]", "Ops!"), ("user_ids[]", &DAVID.to_string()), ("user_ids[]", &bot.id.to_string())];
+    assert_eq!(david.write(Req::new(Method::PATCH, &path).form(&pairs)).await.status, StatusCode::FOUND);
+    // A direct conversation never says `joined`.
+    let direct = david.write(Req::new(Method::POST, "/rooms/directs").form(&[("user_ids[]", &bot.id.to_string())])).await;
+    assert_eq!(direct.status, StatusCode::FOUND);
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert_eq!(joined_room_ids(&server), vec![ops]);
+
+    // Removed and added again, it joins again.
+    let pairs = [("room[name]", "Ops!"), ("user_ids[]", &DAVID.to_string())];
+    david.write(Req::new(Method::PATCH, &path).form(&pairs)).await;
+    let pairs = [("room[name]", "Ops!"), ("user_ids[]", &DAVID.to_string()), ("user_ids[]", &bot.id.to_string())];
+    david.write(Req::new(Method::PATCH, &path).form(&pairs)).await;
+    assert_eq!(received(&server, 2).await.len(), 2);
+    assert_eq!(joined_room_ids(&server), vec![ops, ops]);
+}
