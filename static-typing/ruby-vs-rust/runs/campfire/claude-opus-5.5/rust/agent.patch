+//! `Bot`: a chat member that posts through the bot API (`POST /rooms/:room_id/:bot_key/messages`)
+//! instead of signing in. Not in Rails Campfire: a bot is a `users` row with the `bot` role (so it
+//! joins rooms and authors messages like anyone), plus a row in this app's own `bots` table (see
+//! `schema::ADDITIONS`) with who created it and the token its key carries, and maybe a
+//! [`Webhook`].
+
+use rusqlite::{Connection, params};
+
+use crate::database::Tx;
+use crate::error::{Error, Errors, OptionalExt, Result};
+use crate::models::account::DEFAULT_BOTS_PER_MEMBER;
+use crate::models::room::grant_open_rooms_to;
+use crate::models::user::user_columns;
+use crate::models::suspension::SuspensionReason;
+use crate::models::throttle::Admission;
+use crate::models::{Account, NewUser, PasswordDigest, Role, Suspension, Throttle, User, UserChanges, Webhook};
+use crate::sql::{self, CachedStatements, columns, query_all, query_one};
+use crate::time::Timestamp;
+
+/// How many characters of `SecureRandom.alphanumeric` a token has: about 143 bits.
+pub const TOKEN_LENGTH: usize = 24;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Bot {
+    pub id: i64,
+    /// The bot's own `users` row.
+    pub user_id: i64,
+    /// Who set the bot up: they (and administrators) can see its key, edit and delete it.
+    pub creator_id: i64,
+    pub token: String,
+    pub created_at: Timestamp,
+    pub updated_at: Timestamp,
+}
+
+/// Attributes for [`Bot::create`].
+#[derive(Debug, Clone)]
+pub struct NewBot {
+    pub name: String,
+    pub creator_id: i64,
+    /// A bot never signs in, but `users.password_digest` is `NOT NULL` and Rails'
+    /// `has_secure_password` wants one present: the digest of a random password nobody knows.
+    pub password_digest: PasswordDigest,
+}
+
+columns! {
+    Bot, "bots", bot_columns {
+        id: "id",
+        user_id: "user_id",
+        creator_id: "creator_id",
+        token: "token",
+        created_at: "created_at",
+        updated_at: "updated_at",
+    }
+}
+
+/// The active bot users and their `bots` rows, joined (`User::SELECT`'s columns first).
+const SELECT_ACTIVE: &str = concat!(
+    "SELECT ",
+    user_columns!(),
+    ", ",
+    bot_columns!(),
+    r#" FROM "users" INNER JOIN "bots" ON "bots"."user_id" = "users"."id" WHERE "users"."status" = 0 AND "users"."role" = 2"#
+);
+
+impl Bot {
+    fn user_and_bot(row: &rusqlite::Row<'_>) -> rusqlite::Result<(User, Bot)> {
+        Ok((User::from_row(row)?, Bot::from_row_at(row, User::COLUMNS.len())?))
+    }
+
+    // Finders
+
+    /// The `bots` row of a bot's user, whatever the user's status.
+    pub fn find_by_user_id(conn: &Connection, user_id: i64) -> Result<Option<Self>> {
+        query_one(conn, concat!("SELECT ", bot_columns!(), r#" FROM "bots" WHERE "bots"."user_id" = ? LIMIT 1"#), [user_id], Self::from_row)
+    }
+
+    /// The active bots `user` may manage, by name: everyone's for an administrator, otherwise the
+    /// ones they created.
+    pub fn manageable_by(conn: &Connection, user: &User) -> Result<Vec<(User, Bot)>> {
+        if user.is_administrator() {
+            query_all(conn, &format!("{SELECT_ACTIVE} ORDER BY LOWER(\"users\".\"name\")"), [], Self::user_and_bot)
+        } else {
+            let sql = format!(r#"{SELECT_ACTIVE} AND "bots"."creator_id" = ? ORDER BY LOWER("users"."name")"#);
+            query_all(conn, &sql, [user.id], Self::user_and_bot)
+        }
+    }
+
+    /// One of [`Bot::manageable_by`], by the bot's user id; `RecordNotFound` for anyone else's.
+    pub fn find_manageable_by(conn: &Connection, user: &User, bot_user_id: i64) -> Result<(User, Bot)> {
+        let found = query_one(conn, &format!(r#"{SELECT_ACTIVE} AND "users"."id" = ? LIMIT 1"#), [bot_user_id], Self::user_and_bot)?;
+        found.filter(|(_, bot)| user.can_administer(Some(bot.creator_id), false)).or_not_found("User")
+    }
+
+    /// The active bot a bot key (`"<user id>-<token>"`, see [`Bot::key`]) belongs to. The token is
+    /// compared in constant time, so a response's timing doesn't reveal how much of it matched.
+    pub fn authenticate(conn: &Connection, key: &str) -> Result<Option<User>> {
+        let Some((id, token)) = key.split_once('-') else { return Ok(None) };
+        let Some(id) = id.parse::<i64>().ok().filter(|_| id.bytes().all(|b| b.is_ascii_digit())) else { return Ok(None) };
+        let found = query_one(conn, &format!(r#"{SELECT_ACTIVE} AND "users"."id" = ? LIMIT 1"#), [id], Self::user_and_bot)?;
+        Ok(found.filter(|(_, bot)| rails_compat::secure_compare(bot.token.as_bytes(), token.as_bytes())).map(|(user, _)| user))
+    }
+
+    // Limits
+
+    /// How many active bots `user` created. Deleted bots (no `bots` row, a deactivated user) don't
+    /// count.
+    pub fn count_created_by(conn: &Connection, user_id: i64) -> Result<i64> {
+        sql::count(
+            conn,
+            r#"SELECT COUNT(*) FROM "bots" INNER JOIN "users" ON "users"."id" = "bots"."user_id" WHERE "users"."status" = 0 AND "users"."role" = 2 AND "bots"."creator_id" = ?"#,
+            [user_id],
+        )
+    }
+
+    /// How many bots `user` may have: the account's `bots_per_member`, or `None` (no limit) for an
+    /// administrator.
+    pub fn limit_for(conn: &Connection, user: &User) -> Result<Option<i64>> {
+        if user.is_administrator() {
+            return Ok(None);
+        }
+        let settings = Account::first(conn)?.map(|account| account.settings());
+        Ok(Some(settings.map_or(DEFAULT_BOTS_PER_MEMBER, |settings| settings.bots_per_member())))
+    }
+
+    /// The limit `user` has reached, if they have: they can't set up another bot. Lowering the
+    /// limit below what someone has leaves their bots alone; it only stops new ones.
+    pub fn reached_limit(conn: &Connection, user: &User) -> Result<Option<i64>> {
+        match Self::limit_for(conn, user)? {
+            Some(limit) if Self::count_created_by(conn, user.id)? >= limit => Ok(Some(limit)),
+            _ => Ok(None),
+        }
+    }
+
+    // Creating
+
+    /// Creates the bot's user (who, unlike a person, joins no room: see
+    /// [`Bot::update_all_open_rooms`]) and its `bots` row with a new token. A creator who has
+    /// [reached their limit](Bot::reached_limit) gets an error on `base`.
+    pub fn create(tx: &mut Tx<'_>, attributes: NewBot) -> Result<(User, Bot)> {
+        validate_name(&attributes.name)?;
+        let creator = User::find(tx.conn(), attributes.creator_id)?;
+        if let Some(limit) = Self::reached_limit(tx.conn(), &creator)? {
+            let mut errors = Errors::default();
+            errors.add("base", limit_message(limit));
+            return Err(Error::RecordInvalid(errors));
+        }
+        let user = User::create(
+            tx,
+            NewUser { name: attributes.name, password_digest: Some(attributes.password_digest), role: Role::Bot, ..NewUser::default() },
+        )?;
+        let now = tx.now();
+        let token = generate_token();
+        let id: i64 = tx.conn().query_row_cached(
+            r#"INSERT INTO "bots" ("created_at", "creator_id", "token", "updated_at", "user_id") VALUES (?, ?, ?, ?, ?) RETURNING "id""#,
+            params![now, attributes.creator_id, token, now, user.id],
+            |r| r.get(0),
+        )?;
+        let bot = Bot { id, user_id: user.id, creator_id: attributes.creator_id, token, created_at: now, updated_at: now };
+        Ok((user, bot))
+    }
+
+    // Updating
+
+    /// Renames the bot's user.
+    pub fn rename(user: &mut User, tx: &mut Tx<'_>, name: String) -> Result<()> {
+        validate_name(&name)?;
+        user.update(tx, UserChanges { name: Some(name), ..UserChanges::default() })
+    }
+
+    /// The webhook's URL, or none.
+    pub fn webhook_url(&self, conn: &Connection) -> Result<Option<String>> {
+        Ok(Webhook::find_by_bot_id(conn, self.id)?.map(|webhook| webhook.url))
+    }
+
+    /// Sets the bot's webhook URL; a blank one removes the webhook.
+    pub fn update_webhook_url(&self, tx: &mut Tx<'_>, url: &str) -> Result<()> {
+        Webhook::assign(tx, self.id, url).map(drop)
+    }
+
+    /// Whether the bot joins every open room: the ones there are and the ones to come.
+    pub fn in_all_open_rooms(&self, conn: &Connection) -> Result<bool> {
+        let sql = r#"SELECT 1 FROM "bots_in_all_open_rooms" WHERE "bots_in_all_open_rooms"."bot_id" = ? LIMIT 1"#;
+        Ok(query_one(conn, sql, [self.id], |_| Ok(()))?.is_some())
+    }
+
+    /// Switches joining every open room on (the bot joins each it isn't in yet, after commit) or
+    /// off (it stays in the rooms it's in).
+    pub fn update_all_open_rooms(&self, tx: &mut Tx<'_>, all_open_rooms: bool) -> Result<()> {
+        if all_open_rooms {
+            tx.conn().execute_cached(
+                r#"INSERT INTO "bots_in_all_open_rooms" ("bot_id", "created_at") VALUES (?, ?) ON CONFLICT ("bot_id") DO NOTHING"#,
+                params![self.id, tx.now()],
+            )?;
+            let user_id = self.user_id;
+            tx.after_commit(move |tx| grant_open_rooms_to(tx, user_id));
+        } else {
+            tx.conn().execute_cached(r#"DELETE FROM "bots_in_all_open_rooms" WHERE "bots_in_all_open_rooms"."bot_id" = ?"#, [self.id])?;
+        }
+        Ok(())
+    }
+
+    /// A new token, so the old key stops working.
+    pub fn reset_token(&mut self, tx: &mut Tx<'_>) -> Result<()> {
+        self.token = generate_token();
+        self.updated_at = tx.now();
+        tx.conn().execute_cached(
+            r#"UPDATE "bots" SET "token" = ?, "updated_at" = ? WHERE "bots"."id" = ?"#,
+            params![self.token, self.updated_at, self.id],
+        )?;
+        Ok(())
+    }
+
+    // Misbehaving
+
+    /// Why the bot is suspended, if it is.
+    pub fn suspension(&self, conn: &Connection) -> Result<Option<Suspension>> {
+        Suspension::find_by_bot_id(conn, self.id)
+    }
+
+    /// Whether the bot may post a message now (see [`Throttle::admit_message`]): in the
+    /// transaction that creates it.
+    pub fn admit_message(&self, tx: &mut Tx<'_>) -> Result<Admission> {
+        Throttle::admit_message(tx, self.id, self.user_id)
+    }
+
+    /// Counts a delivery to the bot's webhook (see [`Throttle::record_delivery`]). Returns whether
+    /// it suspended the bot.
+    pub fn record_delivery(&self, tx: &mut Tx<'_>, succeeded: bool) -> Result<bool> {
+        Throttle::record_delivery(tx, self.id, succeeded)
+    }
+
+    /// Suspends the bot, unless it already is.
+    pub fn suspend(&self, tx: &mut Tx<'_>, reason: SuspensionReason) -> Result<()> {
+        Suspension::create(tx, self.id, reason)
+    }
+
+    /// Lifts the bot's suspension, and forgets its cooldown and failed deliveries, so it starts
+    /// afresh.
+    pub fn reactivate(&self, tx: &mut Tx<'_>) -> Result<()> {
+        Suspension::destroy_for(tx, self.id)?;
+        Throttle::destroy_for(tx, self.id)
+    }
+
+    // Deleting
+
+    /// Deletes the bot: its key goes, and its user is deactivated as a person removed from the
+    /// account is, so its messages keep their author.
+    pub fn destroy(&self, tx: &mut Tx<'_>, user: &mut User) -> Result<()> {
+        Webhook::destroy_for(tx, self.id)?;
+        self.reactivate(tx)?;
+        self.update_all_open_rooms(tx, false)?;
+        tx.conn().execute_cached(r#"DELETE FROM "bots" WHERE "bots"."id" = ?"#, [self.id])?;
+        user.deactivate(tx)
+    }
+
+    // Attributes
+
+    /// A random password for [`NewBot::password_digest`], which nothing ever checks.
+    pub fn unusable_password() -> String {
+        sql::alphanumeric(32)
+    }
+
+    /// What authenticates the bot's requests: its user id and token, as Rails Campfire's
+    /// `User#bot_key` has them.
+    pub fn key(&self) -> String {
+        format!("{}-{}", self.user_id, self.token)
+    }
+}
+
+/// What a member at their limit is told, on the bots page and when a bot isn't created.
+pub fn limit_message(limit: i64) -> String {
+    let bots = if limit == 1 { "bot" } else { "bots" };
+    format!("You’ve reached the limit of {limit} {bots} per member.")
+}
+
+fn generate_token() -> String {
+    sql::alphanumeric(TOKEN_LENGTH)
+}
+
+/// `validates :name, presence: true`
+fn validate_name(name: &str) -> Result<()> {
+    let mut errors = Errors::default();
+    if name.trim().is_empty() {
+        errors.add("name", "can't be blank");
+    }
+    errors.into_result()
+}
