--- /dev/null
+++ b/crates/db/src/models/suspension.rs
@@ -0,0 +1,122 @@
+//! `Suspension`: a bot stopped for misbehaving (not in Rails Campfire as this app ports it): it
+//! flooded its rooms, or its webhook kept failing (see [`Throttle`](crate::models::Throttle)).
+//! A suspended bot can't post and hears no webhooks, but stays a member of its rooms, keeps its
+//! messages and still counts towards its creator's limit. It's a row in this app's own
+//! `bot_suspensions` table (see `schema::ADDITIONS`), which only an administrator's reactivation
+//! deletes.
+
+use rusqlite::types::{FromSql, FromSqlError, FromSqlResult, ToSql, ToSqlOutput, ValueRef};
+use rusqlite::{Connection, params};
+
+use crate::database::Tx;
+use crate::error::Result;
+use crate::models::throttle::{COOLDOWN, MAX_COOLDOWN_ATTEMPTS, MAX_FAILED_DELIVERIES, MAX_MESSAGES, MESSAGES_WINDOW};
+use crate::sql::{CachedStatements, columns, placeholders, query_all, query_one};
+use crate::time::Timestamp;
+
+/// Why a bot was suspended.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum SuspensionReason {
+    /// It kept posting during the cooldown that posting too much started.
+    Flooding,
+    /// Its webhook failed too many deliveries in a row.
+    FailingWebhook,
+}
+
+impl SuspensionReason {
+    pub fn name(self) -> &'static str {
+        match self {
+            SuspensionReason::Flooding => "flooding",
+            SuspensionReason::FailingWebhook => "failing_webhook",
+        }
+    }
+
+    pub fn from_name(name: &str) -> Option<Self> {
+        match name {
+            "flooding" => Some(SuspensionReason::Flooding),
+            "failing_webhook" => Some(SuspensionReason::FailingWebhook),
+            _ => None,
+        }
+    }
+
+    /// The reason as the bots page gives it.
+    pub fn description(self) -> String {
+        match self {
+            SuspensionReason::Flooding => format!(
+                "It tried to post more than {MAX_MESSAGES} messages in {} seconds, then {MAX_COOLDOWN_ATTEMPTS} more times during the {}-second cooldown.",
+                MESSAGES_WINDOW.as_secs(),
+                COOLDOWN.as_secs()
+            ),
+            SuspensionReason::FailingWebhook => format!("Its webhook failed {MAX_FAILED_DELIVERIES} times in a row."),
+        }
+    }
+}
+
+impl ToSql for SuspensionReason {
+    fn to_sql(&self) -> rusqlite::Result<ToSqlOutput<'_>> {
+        Ok(ToSqlOutput::from(self.name()))
+    }
+}
+
+impl FromSql for SuspensionReason {
+    fn column_result(value: ValueRef<'_>) -> FromSqlResult<Self> {
+        let name = value.as_str()?;
+        SuspensionReason::from_name(name).ok_or_else(|| FromSqlError::Other(format!("unknown suspension reason {name:?}").into()))
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Suspension {
+    pub id: i64,
+    /// The bot's `bots` row (not its user).
+    pub bot_id: i64,
+    pub reason: SuspensionReason,
+    pub created_at: Timestamp,
+}
+
+columns! {
+    Suspension, "bot_suspensions", suspension_columns {
+        id: "id",
+        bot_id: "bot_id",
+        reason: "reason",
+        created_at: "created_at",
+    }
+}
+
+impl Suspension {
+    // Finders
+
+    pub fn find_by_bot_id(conn: &Connection, bot_id: i64) -> Result<Option<Self>> {
+        let sql = concat!("SELECT ", suspension_columns!(), r#" FROM "bot_suspensions" WHERE "bot_suspensions"."bot_id" = ? LIMIT 1"#);
+        query_one(conn, sql, [bot_id], Self::from_row)
+    }
+
+    /// The suspensions of the bots among `bot_ids` that are suspended, in no particular order.
+    pub fn of_bots(conn: &Connection, bot_ids: &[i64]) -> Result<Vec<Self>> {
+        if bot_ids.is_empty() {
+            return Ok(Vec::new());
+        }
+        let sql = format!(
+            r#"SELECT {} FROM "bot_suspensions" WHERE "bot_suspensions"."bot_id" IN ({})"#,
+            suspension_columns!(),
+            placeholders(bot_ids.len())
+        );
+        query_all(conn, &sql, rusqlite::params_from_iter(bot_ids), Self::from_row)
+    }
+
+    // Writing
+
+    /// Suspends the bot, unless it already is: then the first reason stays.
+    pub(crate) fn create(tx: &mut Tx<'_>, bot_id: i64, reason: SuspensionReason) -> Result<()> {
+        tx.conn().execute_cached(
+            r#"INSERT INTO "bot_suspensions" ("bot_id", "reason", "created_at") VALUES (?, ?, ?) ON CONFLICT ("bot_id") DO NOTHING"#,
+            params![bot_id, reason, tx.now()],
+        )?;
+        Ok(())
+    }
+
+    pub(crate) fn destroy_for(tx: &mut Tx<'_>, bot_id: i64) -> Result<()> {
+        tx.conn().execute_cached(r#"DELETE FROM "bot_suspensions" WHERE "bot_suspensions"."bot_id" = ?"#, [bot_id])?;
+        Ok(())
+    }
+}
diff --git a/crates/db/src/models/throttle.rs b/crates/db/src/models/throttle.rs
new file mode 100644
index 0000000..50f4f69
--- /dev/null
+++ b/crates/db/src/models/throttle.rs
@@ -0,0 +1,182 @@
+//! `Throttle`: how a bot is behaving, on the way to a [`Suspension`] (not in Rails Campfire as this
+//! app ports it). A row in this app's own `bot_throttles` table (see `schema::ADDITIONS`), made the
+//! first time a bot needs one.
+//!
+//! - Flooding: a bot posts at most [`MAX_MESSAGES`] messages in any [`MESSAGES_WINDOW`], counting
+//!   its messages themselves (bot API posts and webhook answers alike). The one over the limit is
+//!   refused and starts a [`COOLDOWN`], during which every post is refused; the
+//!   [`MAX_COOLDOWN_ATTEMPTS`]th of those suspends the bot.
+//! - Failing webhooks: [`MAX_FAILED_DELIVERIES`] failed deliveries in a row suspend the bot; a
+//!   successful one starts the count over.
+//!
+//! The limits are fixed: there are no settings for them.
+
+use jiff::SignedDuration;
+use rusqlite::{Connection, params};
+
+use crate::database::Tx;
+use crate::error::Result;
+use crate::models::Suspension;
+use crate::models::suspension::SuspensionReason;
+use crate::sql::{self, CachedStatements, columns, query_one};
+use crate::time::Timestamp;
+
+/// The most messages a bot may post in any [`MESSAGES_WINDOW`].
+pub const MAX_MESSAGES: i64 = 10;
+pub const MESSAGES_WINDOW: SignedDuration = SignedDuration::from_secs(10);
+/// How long a bot that went over [`MAX_MESSAGES`] can't post.
+pub const COOLDOWN: SignedDuration = SignedDuration::from_secs(30);
+/// The attempts to post during one cooldown that suspend the bot.
+pub const MAX_COOLDOWN_ATTEMPTS: i64 = 5;
+/// The failed webhook deliveries in a row that suspend the bot.
+pub const MAX_FAILED_DELIVERIES: i64 = 10;
+
+/// Whether a bot may post a message now.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Admission {
+    Admitted,
+    /// Refused: it's posted too much, and may post again in `retry_after` seconds.
+    CoolingDown { retry_after: i64 },
+    Suspended,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Throttle {
+    pub id: i64,
+    /// The bot's `bots` row (not its user).
+    pub bot_id: i64,
+    /// When the current (or last) cooldown ends; `None` before the first.
+    pub cooldown_ends_at: Option<Timestamp>,
+    /// The posts refused during that cooldown, after the one that started it.
+    pub cooldown_attempts: i64,
+    /// The webhook's failed deliveries since its last successful one.
+    pub failed_deliveries: i64,
+    pub created_at: Timestamp,
+    pub updated_at: Timestamp,
+}
+
+columns! {
+    Throttle, "bot_throttles", throttle_columns {
+        id: "id",
+        bot_id: "bot_id",
+        cooldown_ends_at: "cooldown_ends_at",
+        cooldown_attempts: "cooldown_attempts",
+        failed_deliveries: "failed_deliveries",
+        created_at: "created_at",
+        updated_at: "updated_at",
+    }
+}
+
+impl Throttle {
+    // Finders
+
+    pub fn find_by_bot_id(conn: &Connection, bot_id: i64) -> Result<Option<Self>> {
+        let sql = concat!("SELECT ", throttle_columns!(), r#" FROM "bot_throttles" WHERE "bot_throttles"."bot_id" = ? LIMIT 1"#);
+        query_one(conn, sql, [bot_id], Self::from_row)
+    }
+
+    // Posting
+
+    /// Whether the bot (`bot_id`, whose user is `user_id`) may post a message now, recording what
+    /// a refusal means for it. Call it in the transaction that creates the message, so concurrent
+    /// posts can't both slip under the limit.
+    pub fn admit_message(tx: &mut Tx<'_>, bot_id: i64, user_id: i64) -> Result<Admission> {
+        if Suspension::find_by_bot_id(tx.conn(), bot_id)?.is_some() {
+            return Ok(Admission::Suspended);
+        }
+        let now = tx.now();
+        let cooldown_ends_at = Self::find_by_bot_id(tx.conn(), bot_id)?.and_then(|throttle| throttle.cooldown_ends_at);
+        if let Some(ends_at) = cooldown_ends_at.filter(|ends_at| now < *ends_at) {
+            let attempts: i64 = tx.conn().query_row_cached(
+                r#"UPDATE "bot_throttles" SET "cooldown_attempts" = "cooldown_attempts" + 1, "updated_at" = ? WHERE "bot_throttles"."bot_id" = ? RETURNING "cooldown_attempts""#,
+                params![now, bot_id],
+                |row| row.get(0),
+            )?;
+            if attempts >= MAX_COOLDOWN_ATTEMPTS {
+                Suspension::create(tx, bot_id, SuspensionReason::Flooding)?;
+            }
+            return Ok(Admission::CoolingDown { retry_after: seconds_between(now, ends_at) });
+        }
+        if Self::recent_messages(tx.conn(), user_id, now)? >= MAX_MESSAGES {
+            let ends_at = now.after(COOLDOWN);
+            tx.conn().execute_cached(
+                concat!(
+                    r#"INSERT INTO "bot_throttles" ("bot_id", "cooldown_ends_at", "cooldown_attempts", "created_at", "updated_at") VALUES (?, ?, 0, ?, ?)"#,
+                    r#" ON CONFLICT ("bot_id") DO UPDATE SET "cooldown_ends_at" = excluded."cooldown_ends_at", "cooldown_attempts" = 0, "updated_at" = excluded."updated_at""#
+                ),
+                params![bot_id, ends_at, now, now],
+            )?;
+            return Ok(Admission::CoolingDown { retry_after: seconds_between(now, ends_at) });
+        }
+        Ok(Admission::Admitted)
+    }
+
+    /// The bot user's messages created in the [`MESSAGES_WINDOW`] up to `now`.
+    fn recent_messages(conn: &Connection, user_id: i64, now: Timestamp) -> Result<i64> {
+        sql::count(
+            conn,
+            r#"SELECT COUNT(*) FROM "messages" WHERE "messages"."creator_id" = ? AND "messages"."created_at" > ?"#,
+            params![user_id, now.ago(MESSAGES_WINDOW)],
+        )
+    }
+
+    // Webhooks
+
+    /// Counts a failed delivery to the bot's webhook, or starts the count over after a successful
+    /// one. Returns whether that failure suspended the bot.
+    pub fn record_delivery(tx: &mut Tx<'_>, bot_id: i64, succeeded: bool) -> Result<bool> {
+        let now = tx.now();
+        if succeeded {
+            tx.conn().execute_cached(
+                r#"UPDATE "bot_throttles" SET "failed_deliveries" = 0, "updated_at" = ? WHERE "bot_throttles"."bot_id" = ? AND "bot_throttles"."failed_deliveries" <> 0"#,
+                params![now, bot_id],
+            )?;
+            return Ok(false);
+        }
+        if Suspension::find_by_bot_id(tx.conn(), bot_id)?.is_some() {
+            return Ok(false);
+        }
+        let failed: i64 = tx.conn().query_row_cached(
+            concat!(
+                r#"INSERT INTO "bot_throttles" ("bot_id", "failed_deliveries", "created_at", "updated_at") VALUES (?, 1, ?, ?)"#,
+                r#" ON CONFLICT ("bot_id") DO UPDATE SET "failed_deliveries" = "bot_throttles"."failed_deliveries" + 1, "updated_at" = excluded."updated_at""#,
+                r#" RETURNING "failed_deliveries""#
+            ),
+            params![bot_id, now, now],
+            |row| row.get(0),
+        )?;
+        if failed >= MAX_FAILED_DELIVERIES {
+            Suspension::create(tx, bot_id, SuspensionReason::FailingWebhook)?;
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+    // Writing
+
+    /// Forgets the bot's cooldown and failures, as a reactivated (or deleted) bot starts afresh.
+    pub(crate) fn destroy_for(tx: &mut Tx<'_>, bot_id: i64) -> Result<()> {
+        tx.conn().execute_cached(r#"DELETE FROM "bot_throttles" WHERE "bot_throttles"."bot_id" = ?"#, [bot_id])?;
+        Ok(())
+    }
+}
+
+/// Whole seconds from `now` until `later`, rounded up, so a client waiting that long finds it
+/// over: what `Retry-After` says.
+fn seconds_between(now: Timestamp, later: Timestamp) -> i64 {
+    let micros = later.as_microsecond() - now.as_microsecond();
+    (micros + 999_999).div_euclid(1_000_000).max(1)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn retry_after_rounds_up() {
+        let now = Timestamp::from_second(1_000);
+        assert_eq!(seconds_between(now, now.after(SignedDuration::from_secs(30))), 30);
+        assert_eq!(seconds_between(now, now.after(SignedDuration::from_millis(29_001))), 30);
+        assert_eq!(seconds_between(now, now.after(SignedDuration::from_millis(1))), 1);
+    }
+}
