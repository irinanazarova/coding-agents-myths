diff --git a/crates/campfire/src/controllers/messages/bot_webhooks.rs b/crates/campfire/src/controllers/messages/bot_webhooks.rs
new file mode 100644
index 0000000..13650e6
--- /dev/null
+++ b/crates/campfire/src/controllers/messages/bot_webhooks.rs
@@ -0,0 +1,211 @@
+//! The webhooks of chat bots (not in Rails Campfire as this app ports it): a bot hears about the
+//! messages that mention it (`mention`) and the rooms it's added to (`joined`), and what it
+//! answers is posted into the room as its message.
+//!
+//! All of it happens on the `Bot::WebhookJob` queue: the person posting or adding the bot never
+//! waits on it. Only messages people post from the composer call webhooks, not the bot API's, so
+//! bots answering each other can't loop.
+
+use campfire_db::{Admission, Bot, Connection, Event, Membership, Message, NewMessage, RichText, Room, User, Webhook};
+use campfire_kit::Ctx;
+
+use super::{broadcast_create_at, canonicalize_body};
+use crate::app::{App, AppCtx};
+use crate::controllers::presenters::accounts::room_display_name;
+use crate::controllers::presenters::page;
+use crate::integrations::net::Network;
+use crate::integrations::webhooks::{self, Reply, WebhookError};
+use crate::jobs::{JobKind, Registry};
+
+/// Calls, later, the webhooks of the bots `message` mentions (other than its author).
+pub(crate) fn deliver_later(c: &Ctx, room: &Room, message: &Message) {
+    let call = Call {
+        answers: Answers {
+            app: c.app().clone(),
+            room: room.clone(),
+            base_url: page::renderer_base_url(c),
+            request_host: Some(c.request.host()),
+        },
+        message: message.clone(),
+    };
+    c.app().jobs.perform_later_on(JobKind::BotWebhook, JobKind::BotWebhook.name(), call.perform());
+}
+
+/// Registers the handler for `Event::BotJoined`, which the models emit whenever a bot becomes a
+/// member of a room, whoever (or whatever) added it.
+pub(crate) fn register_jobs(registry: &mut Registry) {
+    registry.handle(JobKind::BotWebhook, joined);
+}
+
+/// Tells the bot's webhook, if it has one, that it joined the room, and posts its answer.
+async fn joined(app: App, event: Event) -> anyhow::Result<()> {
+    let Event::BotJoined { room_id, user_id } = event else { return Ok(()) };
+    let found = app.db.read(move |conn| joined_delivery(conn, room_id, user_id)).await?;
+    let Some((room, delivery)) = found else { return Ok(()) };
+    // No request added the bot as far as the job knows (it may have joined in an after-commit
+    // callback), so its answer is rendered as `ApplicationController.renderer` renders without one.
+    let answers = Answers { app, room, base_url: page::DETACHED_BASE_URL.into(), request_host: None };
+    answers.deliver(&Network::system(), delivery).await;
+    Ok(())
+}
+
+/// One message's webhook calls.
+struct Call {
+    answers: Answers,
+    message: Message,
+}
+
+/// Where the bots' answers go, with what posting them needs from the request.
+struct Answers {
+    app: App,
+    room: Room,
+    /// For the broadcast answers' URLs, as the message's own broadcast had them.
+    base_url: String,
+    /// For canonicalizing the answers' bodies, as the message's own was.
+    request_host: Option<String>,
+}
+
+/// A bot to call, and what to send it.
+struct Delivery {
+    bot: User,
+    /// The bot's `bots` row.
+    bot_record: Bot,
+    url: String,
+    payload: serde_json::Value,
+}
+
+impl Call {
+    async fn perform(self) -> anyhow::Result<()> {
+        let (room, message, rich_text) = (self.answers.room.clone(), self.message.clone(), self.answers.app.db.env().rich_text.clone());
+        let deliveries = self.answers.app.db.read(move |conn| deliveries(conn, &*rich_text, &room, &message)).await?;
+        let net = Network::system();
+        futures_util::future::join_all(deliveries.into_iter().map(|delivery| self.answers.deliver(&net, delivery))).await;
+        Ok(())
+    }
+}
+
+impl Answers {
+    /// Calls one bot's webhook and posts its answer; failures are logged, and don't stop the
+    /// other bots'.
+    async fn deliver(&self, net: &Network, delivery: Delivery) {
+        let (bot_id, url) = (delivery.bot.id, delivery.url.clone());
+        let delivered = webhooks::deliver(net, &delivery.url, delivery.payload.to_string().into_bytes()).await;
+        let failed = delivered.as_ref().is_err_and(WebhookError::is_failed_delivery);
+        self.record_delivery(&delivery, !failed).await;
+        let body = match delivered {
+            Ok(Reply::Text(text)) => webhooks::text_reply_html(&text),
+            Ok(Reply::Html(html)) => html,
+            Ok(Reply::None) => return,
+            Err(error) => {
+                tracing::warn!(bot_id, url, %error, "bot webhook failed");
+                return;
+            }
+        };
+        if let Err(error) = self.post_reply(delivery.bot, delivery.bot_record, body).await {
+            tracing::error!(bot_id, error = %format_args!("{error:#}"), "posting a bot's webhook answer failed");
+        }
+    }
+
+    /// Counts the delivery towards the bot's failures in a row (see `campfire_db::Throttle`).
+    async fn record_delivery(&self, delivery: &Delivery, succeeded: bool) {
+        let (bot_id, bot) = (delivery.bot.id, delivery.bot_record.clone());
+        match self.app.db.write(move |tx| bot.record_delivery(tx, succeeded)).await {
+            Ok(true) => tracing::warn!(bot_id, "bot suspended: its webhook kept failing"),
+            Ok(false) => {}
+            Err(error) => tracing::error!(bot_id, %error, "recording a bot's webhook delivery failed"),
+        }
+    }
+
+    /// The answer, as the bot's message in the room: created and broadcast (and pushed) as one it
+    /// posted through the bot API, unless it has left the room since, or it may not post now (it's
+    /// posted too much, or is suspended), as the bot API would refuse it.
+    async fn post_reply(&self, bot: User, bot_record: Bot, body: String) -> anyhow::Result<()> {
+        let body = canonicalize_body(&self.app, body, self.request_host.clone()).await.map_err(|e| anyhow::anyhow!("{e:?}"))?;
+        let (room_id, creator_id) = (self.room.id, bot.id);
+        let message = self
+            .app
+            .db
+            .write(move |tx| {
+                if Membership::find_by_room_and_user(tx.conn(), room_id, creator_id)?.is_none() {
+                    return Ok(None);
+                }
+                if let refused @ (Admission::CoolingDown { .. } | Admission::Suspended) = bot_record.admit_message(tx)? {
+                    tracing::info!(bot_id = creator_id, ?refused, "a bot's webhook answer wasn't posted");
+                    return Ok(None);
+                }
+                let attributes = NewMessage { room_id, creator_id, client_message_id: None, body: Some(body), attachment_blob_id: None };
+                Message::create(tx, attributes).map(Some)
+            })
+            .await?;
+        let Some(message) = message else { return Ok(()) };
+        broadcast_create_at(&self.app, self.base_url.clone(), &self.room, &message).await.map_err(|e| anyhow::anyhow!("{e:?}"))
+    }
+}
+
+/// The `joined` call for a bot that joined a room: none when the bot has no webhook (or is gone),
+/// or has already left the room or the room is gone.
+fn joined_delivery(conn: &Connection, room_id: i64, user_id: i64) -> campfire_db::Result<Option<(Room, Delivery)>> {
+    let Some((bot_user, bot, webhook)) = Webhook::of_active_bots(conn, &[user_id])?.pop() else { return Ok(None) };
+    let Some(room) = Room::find_by_id(conn, room_id)?.filter(|room| !room.direct()) else { return Ok(None) };
+    if Membership::find_by_room_and_user(conn, room_id, user_id)?.is_none() {
+        return Ok(None);
+    }
+    let payload = serde_json::json!({
+        "event": "joined",
+        "room": room_payload(conn, &room, &bot_user, &bot)?,
+    });
+    Ok(Some((room, Delivery { bot: bot_user, bot_record: bot, url: webhook.url, payload })))
+}
+
+/// The payloads' `room`: the name as the bot sees it, and where to post to it.
+fn room_payload(conn: &Connection, room: &Room, bot_user: &User, bot: &campfire_db::Bot) -> campfire_db::Result<serde_json::Value> {
+    Ok(serde_json::json!({
+        "id": room.id,
+        "name": room_display_name(conn, room, bot_user)?,
+        "reply_to": campfire_routes::bot_messages(room.id, bot.key()),
+    }))
+}
+
+/// The bots with webhooks that `message` mentions, but not its author, and their payloads.
+fn deliveries(conn: &Connection, rich_text: &dyn RichText, room: &Room, message: &Message) -> campfire_db::Result<Vec<Delivery>> {
+    let mentioned: Vec<i64> =
+        message.mentionees(conn, rich_text)?.into_iter().map(|user| user.id).filter(|id| *id != message.creator_id).collect();
+    let bots = Webhook::of_active_bots(conn, &mentioned)?;
+    if bots.is_empty() {
+        return Ok(Vec::new());
+    }
+    let author = User::find(conn, message.creator_id)?;
+    let html = message.body_html(conn)?.unwrap_or_default();
+    let text = message.plain_text_body(conn, rich_text)?;
+    bots.into_iter()
+        .map(|(bot_user, bot, webhook)| {
+            let payload = serde_json::json!({
+                "event": "mention",
+                "author": { "id": author.id, "name": author.name },
+                "room": room_payload(conn, room, &bot_user, &bot)?,
+                "message": {
+                    "id": message.id,
+                    "body": { "text": without_mention_of(&text, &bot_user.name), "html": html },
+                    "link": campfire_routes::room_at_message(room.id, message.id),
+                },
+            });
+            Ok(Delivery { bot: bot_user, bot_record: bot, url: webhook.url, payload })
+        })
+        .collect()
+}
+
+/// The plain text without the bot's own mentions (`@Name`), so it reads as what the bot was asked.
+fn without_mention_of(text: &str, bot_name: &str) -> String {
+    text.replace(&format!("@{bot_name}"), "").trim().to_string()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_bots_mentions_are_left_out_of_the_text() {
+        assert_eq!(without_mention_of("@Build Bot restart the build please", "Build Bot"), "restart the build please");
+        assert_eq!(without_mention_of("Hey @Build Bot, ask @David", "Build Bot"), "Hey , ask @David");
+    }
+}
diff --git a/crates/campfire/src/controllers/messages/by_bots.rs b/crates/campfire/src/controllers/messages/by_bots.rs
new file mode 100644
index 0000000..bb081c8
--- /dev/null
+++ b/crates/campfire/src/controllers/messages/by_bots.rs
@@ -0,0 +1,132 @@
+//! `Messages::ByBotsController`: the bot API (not in Rails Campfire as this app ports it).
+//!
+//! ```text
+//! curl -d "Deploy of v1.2.3 finished ✅" https://chat.example.com/rooms/<room-id>/<bot-code>/messages
+//! ```
+//!
+//! The raw request body is the message body (rich text, as a composed message's is), or a
+//! multipart `attachment` is the message's attachment. The message is created, broadcast and
+//! pushed exactly as one posted from the composer. Answers `201 Created` with the message's path
+//! in `Location`; `401` for a code that isn't an active bot's, `403` for a suspended bot, `404` for
+//! a room the bot isn't in, `422` for an empty message, and `429` (with `Retry-After`) for a bot
+//! that's posted too much and has to wait (see `campfire_db::Throttle`).
+
+use std::borrow::Cow;
+use std::sync::LazyLock;
+
+use axum::middleware::Next;
+use campfire_kit::body::{self, ParsedBody};
+use campfire_kit::http::header;
+use campfire_db::{Admission, Bot};
+use campfire_kit::{Ctx, Method, Response, Result, StatusCode, halt};
+use regex::Regex;
+
+use super::{MessageParams, broadcast_create, create_message_admitted};
+use crate::app::AppCtx;
+use crate::concerns::{self, Before, before_actions};
+use crate::controllers::presenters::attachments::Assignment;
+
+/// `POST /rooms/:room_id/:bot_key/messages`
+pub async fn create(c: &mut Ctx) -> Result {
+    // A bot has no session, and no browser to forge its requests: it authenticates with its key.
+    before_actions(c, Before::default().allow_unauthenticated_access().skip_forgery_protection()).await?;
+    concerns::authenticate_bot(c).await?;
+    let bot = ensure_not_suspended(c).await?;
+    let (_, room) = concerns::set_room(c).await?;
+    let attributes = bot_message_params(c)?;
+    let message = match create_message_admitted(c, &room, attributes, Some(bot)).await? {
+        Ok(message) => message,
+        Err(refused) => return Ok(refusal(refused)),
+    };
+    broadcast_create(c, &room, &message).await?;
+    Ok(c.head(StatusCode::CREATED).header(header::LOCATION, &campfire_routes::message(message.id)))
+}
+
+/// The authenticated bot's `bots` row; 403 when it's suspended.
+async fn ensure_not_suspended(c: &Ctx) -> Result<Bot> {
+    let user_id = concerns::require_current_user(c)?.id;
+    let found = c
+        .app()
+        .read(move |conn| {
+            let bot = Bot::find_by_user_id(conn, user_id)?.ok_or(campfire_db::Error::RecordNotFound("Bot"))?;
+            let suspended = bot.suspension(conn)?.is_some();
+            Ok((bot, suspended))
+        })
+        .await?;
+    match found {
+        (_, true) => halt(concerns::head(StatusCode::FORBIDDEN)),
+        (bot, false) => Ok(bot),
+    }
+}
+
+/// The answer to a post the bot's throttle refused.
+fn refusal(refused: Admission) -> Response {
+    match refused {
+        Admission::CoolingDown { retry_after } => {
+            concerns::head(StatusCode::TOO_MANY_REQUESTS).header(header::RETRY_AFTER, &retry_after.to_string())
+        }
+        Admission::Suspended | Admission::Admitted => concerns::head(StatusCode::FORBIDDEN),
+    }
+}
+
+/// The multipart `attachment`, or else the raw body as the message's; 422 when that's blank.
+fn bot_message_params(c: &Ctx) -> Result<MessageParams> {
+    let multipart = c.request.media_type().is_some_and(|media| media.starts_with("multipart/"));
+    if multipart && c.params.contains_key("attachment") {
+        return match Assignment::from_params(&c.params, "attachment")? {
+            upload @ Assignment::Create(_) => Ok(MessageParams { attachment: Some(upload), ..MessageParams::default() }),
+            _ => halt(concerns::head(StatusCode::UNPROCESSABLE_ENTITY)),
+        };
+    }
+    match std::str::from_utf8(c.request.raw_post()) {
+        Ok(body) if !body.trim().is_empty() => Ok(MessageParams { body: Some(body.to_string()), ..MessageParams::default() }),
+        _ => halt(concerns::head(StatusCode::UNPROCESSABLE_ENTITY)),
+    }
+}
+
+// --- The request around the action ------------------------------------------------------------------
+
+/// The bot API's path, with the key as its second capture.
+static PATH: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"^(/*rooms/+[^/]+/+)([^/]+)(/+messages(?:\.[^/]*)?/*)$").unwrap());
+
+/// Middleware ahead of routing: kit refuses a body that doesn't parse as form params or JSON
+/// ("Deploy 100% done", which `curl -d` sends as a form) before any action runs. The bot API reads
+/// the body raw, so its params' errors are dropped here instead.
+pub async fn read_raw_body(max_body_bytes: Option<usize>, request: axum::extract::Request, next: Next) -> axum::response::Response {
+    if request.method() != Method::POST || !PATH.is_match(request.uri().path()) {
+        return next.run(request).await;
+    }
+    let (mut parts, body) = request.into_parts();
+    let parsed = match parts.extensions.remove::<ParsedBody>() {
+        Some(parsed) => parsed,
+        None => match body::parse(&Method::POST, &parts.headers, body, max_body_bytes).await {
+            Ok(parsed) => parsed,
+            Err(error) => {
+                let mut response = axum::response::Response::new(axum::body::Body::empty());
+                *response.status_mut() = error.status();
+                return response;
+            }
+        },
+    };
+    parts.extensions.insert(ParsedBody { raw: parsed.raw, params: Ok(parsed.params.unwrap_or_default()) });
+    next.run(axum::extract::Request::from_parts(parts, axum::body::Body::empty())).await
+}
+
+/// The path as logged, without the key (`campfire_kit::request::PathFilter`): it's a credential.
+pub fn filter_key(path: &str) -> Cow<'_, str> {
+    PATH.replace(path, "${1}[FILTERED]${3}")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn keys_are_filtered_from_logged_paths() {
+        assert_eq!(filter_key("/rooms/12/34-secret/messages"), "/rooms/12/[FILTERED]/messages");
+        assert_eq!(filter_key("/rooms/12/34-secret/messages.json"), "/rooms/12/[FILTERED]/messages.json");
+        assert_eq!(filter_key("//rooms//12//34-secret//messages/"), "//rooms//12//[FILTERED]//messages/");
+        assert_eq!(filter_key("/rooms/12/messages"), "/rooms/12/messages");
+        assert_eq!(filter_key("/rooms/12/messages/34"), "/rooms/12/messages/34");
+    }
+}
