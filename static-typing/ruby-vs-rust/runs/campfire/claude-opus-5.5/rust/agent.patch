+/// The ids of the rooms the server heard `joined` for, in id order.
+fn joined_room_ids(server: &FakeServer) -> Vec<i64> {
+    let mut ids: Vec<i64> = payloads_of(server, "joined").iter().map(|payload| payload["room"]["id"].as_i64().unwrap()).collect();
+    ids.sort();
+    ids
+}
