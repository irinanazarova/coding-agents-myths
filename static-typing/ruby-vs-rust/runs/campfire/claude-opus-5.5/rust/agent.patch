+#[tokio::test]
+async fn a_bot_in_all_open_rooms_joins_the_ones_there_are_and_the_ones_to_come() {
+    let server = FakeServer::start(vec![Route::new("POST", "*", "/hook", 204)]).await;
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+    create_bot_with_webhook(&mut david, "Greeter", &format!("http://{}/hook", server.addr)).await;
+    let (bot, _) = bot_named(&app, "Greeter").await;
+
+    let open = open_room_ids(&app).await;
+    assert_eq!(switch_all_open_rooms(&mut david, bot.id, true).await.status, StatusCode::FOUND);
+    assert_eq!(room_ids_of(&app, bot.id).await, open);
+    received(&server, open.len()).await;
+    assert_eq!(joined_room_ids(&server), open, "once per room");
+    let edit = david.get(&format!("/bots/{}/edit", bot.id)).await;
+    assert!(edit.text().contains(r#"checked="checked" name="bot[all_open_rooms]""#), "{}", edit.text());
+
+    // New open rooms, and closed ones opened up, take it in.
+    let watercooler = create_open_room(&app, &mut david, "Watercooler").await;
+    let path = format!("/rooms/opens/{QUIET_CORNER}");
+    let opened = david.write(Req::new(Method::PATCH, &path).form(&[("room[name]", "Quiet Corner")])).await;
+    assert_eq!(opened.status, StatusCode::FOUND, "{}", opened.text());
+    let mut expected = [open.clone(), vec![watercooler, QUIET_CORNER]].concat();
+    expected.sort();
+    received(&server, expected.len()).await;
+    assert_eq!(room_ids_of(&app, bot.id).await, expected);
+
+    // Saving with the switch still on adds no one twice.
+    switch_all_open_rooms(&mut david, bot.id, true).await;
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert_eq!(joined_room_ids(&server), expected);
+
+    // Off: it stays where it is, and new open rooms leave it out.
+    switch_all_open_rooms(&mut david, bot.id, false).await;
+    assert_eq!(room_ids_of(&app, bot.id).await, expected);
+    let later = create_open_room(&app, &mut david, "Later").await;
+    assert!(!room_ids_of(&app, bot.id).await.contains(&later));
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert_eq!(joined_room_ids(&server), expected);
+}
