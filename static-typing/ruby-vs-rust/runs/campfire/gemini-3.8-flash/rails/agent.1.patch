diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..c7b615a
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,41 @@
+class Bot < ApplicationRecord
+  has_secure_token :code
+
+  belongs_to :creator, class_name: "User"
+  belongs_to :user, class_name: "User"
+
+  delegate :rooms, :memberships, to: :user
+
+  validates :name, presence: true
+
+  scope :ordered, -> { order("LOWER(bots.name)") }
+
+  before_validation :ensure_user, on: :create
+  before_save :sync_user
+  before_destroy :deactivate_user
+
+  def avatar
+    user&.avatar
+  end
+
+  def avatar=(attachable)
+    ensure_user
+    user.avatar = attachable
+  end
+
+  private
+    def ensure_user
+      self.user ||= User.new(name: name, password: SecureRandom.hex(32))
+    end
+
+    def sync_user
+      if user
+        user.name = name
+        user.save if user.persisted?
+      end
+    end
+
+    def deactivate_user
+      user&.deactivate
+    end
+end
