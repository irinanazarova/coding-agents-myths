@@ -0,0 +1,63 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ show edit update destroy ]
+  before_action :ensure_can_manage_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = bot_scope.ordered
+  end
+
+  def show
+    redirect_to edit_bot_url(@bot)
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Bot.new(bot_params.merge(creator: Current.user))
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @bot.destroy
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      @bot = Bot.find(params[:id])
+    end
+
+    def ensure_can_manage_bot
+      head :forbidden unless Current.user.can_administer?(@bot)
+    end
+
+    def bot_scope
+      if Current.user.administrator?
+        Bot.all
+      else
+        Current.user.created_bots
+      end
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar)
+    end
+end
