@@ -0,0 +1,33 @@
+class Bots::MessagesController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :verify_authenticity_token
+
+  def create
+    bot = Bot.find_by(code: params[:bot_code])
+    return head :unauthorized unless bot
+
+    room = bot.rooms.find_by(id: params[:room_id])
+    return head :not_found unless room
+
+    attachment = params[:attachment] if params[:attachment].is_a?(ActionDispatch::Http::UploadedFile) || params[:attachment].is_a?(Rack::Test::UploadedFile)
+
+    body = if request.content_type.to_s.start_with?("multipart/form-data")
+      params[:body].to_s.strip
+    else
+      request.raw_post.to_s.force_encoding("UTF-8").strip
+    end
+
+    if body.blank? && attachment.blank?
+      return head :unprocessable_entity
+    end
+
+    message_attributes = { creator: bot.user }
+    message_attributes[:body] = body if body.present?
+    message_attributes[:attachment] = attachment if attachment.present?
+
+    message = room.messages.create_with_attachment!(message_attributes)
+    message.broadcast_create
+
+    head :created, location: message_path(message)
+  end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
