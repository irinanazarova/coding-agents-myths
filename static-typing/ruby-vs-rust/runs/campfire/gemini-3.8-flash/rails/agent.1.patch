new file mode 100644
index 0000000..db65758
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @creator = users(:david)
+    @bot = Bot.create!(name: "Deploy Bot", creator: @creator)
+    @open_room = rooms(:pets)
+    @closed_room = rooms(:watercooler)
+  end
+
+  test "post message with raw body to open room responds with 201 Created" do
+    assert_difference -> { @open_room.messages.count }, 1 do
+      post room_bot_messages_url(@open_room, @bot.code),
+        params: "Deploy of v1.2.3 finished ✅",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :created
+    message = Message.last
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+    assert_equal @bot.user, message.creator
+    assert_equal "Deploy Bot", message.creator.name
+  end
+
+  test "post message with curl default application/x-www-form-urlencoded" do
+    assert_difference -> { @open_room.messages.count }, 1 do
+      post room_bot_messages_url(@open_room, @bot.code),
+        params: "Deploy of v1.2.3 finished ✅",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_response :created
+    message = Message.last
+    assert_equal "/messages/#{message.id}", response.headers["Location"]
+    assert_equal "Deploy of v1.2.3 finished ✅", message.plain_text_body
+  end
+
+  test "post message broadcasts to room" do
+    Turbo::StreamsChannel.expects(:broadcast_append_to).once
+
+    post room_bot_messages_url(@open_room, @bot.code),
+      params: "Deploy finished"
+
+    assert_response :created
+  end
+
+  test "empty body and no attachment responds with 422 Unprocessable Content" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.code), params: ""
+    end
+
+    assert_response :unprocessable_entity
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@open_room, @bot.code), params: "   \n  "
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "bad room id responds with 404 Not Found" do
+    post "/rooms/9999999/#{@bot.code}/messages", params: "hello"
+    assert_response :not_found
+  end
+
+  test "invalid bot code responds with 401 Unauthorized" do
+    post room_bot_messages_url(@open_room, "wrong_code_xyz"), params: "hello"
+    assert_response :unauthorized
+  end
+
+  test "deleted bot can no longer post messages and responds with 401" do
+    code = @bot.code
+    @bot.destroy
+
+    post room_bot_messages_url(@open_room, code), params: "hello"
+    assert_response :unauthorized
+  end
+
+  test "bot posting to closed room" do
+    # When bot is not a member of closed room
+    assert_not_includes @closed_room.users, @bot.user
+    post room_bot_messages_url(@closed_room, @bot.code), params: "secret message"
+    assert_response :not_found
+
+    # When bot is granted membership to closed room
+    @closed_room.memberships.grant_to @bot.user
+    assert_includes @closed_room.users.reload, @bot.user
+
+    assert_difference -> { @closed_room.messages.count }, 1 do
+      post room_bot_messages_url(@closed_room, @bot.code), params: "secret message"
+    end
+    assert_response :created
+  end
+
+  test "bot posting multipart attachment" do
+    file = fixture_file_upload("test/fixtures/files/earth.png", "image/png")
+    assert_difference -> { @open_room.messages.count }, 1 do
+      post room_bot_messages_url(@open_room, @bot.code),
+        params: { attachment: file }
+    end
+
+    assert_response :created
+    message = Message.last
+    assert message.attachment.attached?
+  end
+test "bot message enqueues push notifications" do
+  assert_enqueued_with(job: Room::PushMessageJob) do
+    post room_bot_messages_url(@open_room, @bot.code), params: "Deploy finished"
+  end
+end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..0f841cd
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+    @david_bot = Bot.create!(name: "David Bot", creator: users(:david))
+    @kevin_bot = Bot.create!(name: "Kevin Bot", creator: users(:kevin))
+  end
+
+  test "admin index lists all bots" do
+    get bots_url
+    assert_response :success
+
+    assert_select "a, button", text: "Add a chat bot"
+    assert_select "li##{dom_id(@david_bot)}" do
+      assert_select "strong", text: "David Bot"
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value='#{@david_bot.code}']"
+      assert_select "a", text: /Edit David Bot/
+    end
+    assert_select "li##{dom_id(@kevin_bot)}" do
+      assert_select "strong", text: "Kevin Bot"
+      assert_select "label", text: "Bot code"
+      assert_select "input[readonly][value='#{@kevin_bot.code}']"
+      assert_select "a", text: /Edit Kevin Bot/
+    end
+  end
+
+  test "member index lists only their created bots" do
+    sign_in :kevin
+    get bots_url
+    assert_response :success
+
+    assert_select "li##{dom_id(@kevin_bot)}"
+    assert_select "li##{dom_id(@david_bot)}", count: 0
+  end
+
+  test "new renders form with required labels" do
+    get new_bot_url
+    assert_response :success
+
+    assert_select "label", text: "Name the bot"
+    assert_select "input[name='bot[name]'][placeholder='Name the bot'][required]"
+    assert_select "button[type='submit']", text: "Save changes"
+  end
+
+  test "create creates bot and redirects to bots list" do
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+
+    assert_redirected_to bots_url
+    bot = Bot.last
+    assert_equal "Deploy Bot", bot.name
+    assert_equal users(:david), bot.creator
+  end
+
+  test "create with avatar" do
+    file = fixture_file_upload("test/fixtures/files/earth.png", "image/png")
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Avatar Bot", avatar: file } }
+    end
+
+    assert_redirected_to bots_url
+    bot = Bot.last
+    assert bot.avatar.attached?
+  end
+
+  test "edit renders form with delete button" do
+    get edit_bot_url(@david_bot)
+    assert_response :success
+
+    assert_select "input[name='bot[name]'][value='#{@david_bot.name}']"
+    assert_select "button[type='submit']", text: "Save changes"
+    assert_select "button", text: "Delete this chat bot"
+  end
+
+  test "update bot" do
+    patch bot_url(@david_bot), params: { bot: { name: "Updated Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Updated Bot", @david_bot.reload.name
+  end
+
+  test "destroy bot" do
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(@david_bot)
+    end
+
+    assert_redirected_to bots_url
+    assert_nil Bot.find_by(id: @david_bot.id)
+  end
+
+  test "member cannot edit or delete another user's bot" do
+    sign_in :kevin
+
+    get edit_bot_url(@david_bot)
+    assert_response :forbidden
+
+    patch bot_url(@david_bot), params: { bot: { name: "Hacked" } }
+    assert_response :forbidden
+
+    delete bot_url(@david_bot)
+    assert_response :forbidden
+  end
+
+  test "admin can edit and delete any bot" do
+    get edit_bot_url(@kevin_bot)
+    assert_response :success
+
+    patch bot_url(@kevin_bot), params: { bot: { name: "Admin Edited" } }
+    assert_redirected_to bots_url
+    assert_equal "Admin Edited", @kevin_bot.reload.name
+
+    delete bot_url(@kevin_bot)
+    assert_redirected_to bots_url
+    assert_nil Bot.find_by(id: @kevin_bot.id)
+  end
+end
