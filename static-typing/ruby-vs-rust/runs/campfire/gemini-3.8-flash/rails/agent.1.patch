diff --git a/test/models/bot_test.rb b/test/models/bot_test.rb
new file mode 100644
index 0000000..eae132f
--- /dev/null
+++ b/test/models/bot_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "creating a bot generates a code and creates an associated user" do
+    creator = users(:david)
+    bot = Bot.create!(name: "Deploy Bot", creator: creator)
+
+    assert bot.code.present?
+    assert bot.user.present?
+    assert_equal "Deploy Bot", bot.user.name
+    assert bot.user.bot?
+  end
+
+  test "new bot automatically joins all open rooms" do
+    creator = users(:david)
+    open_room = rooms(:pets)
+    assert open_room.open?
+
+    bot = Bot.create!(name: "Room Joiner Bot", creator: creator)
+
+    assert_includes bot.rooms, open_room
+    assert_includes open_room.users, bot.user
+  end
+
+  test "name is required" do
+    bot = Bot.new(creator: users(:david))
+    assert_not bot.valid?
+    assert_includes bot.errors[:name], "can't be blank"
+  end
+
+  test "updating bot name updates user name" do
+    bot = Bot.create!(name: "Old Name", creator: users(:david))
+    bot.update!(name: "New Name")
+
+    assert_equal "New Name", bot.user.reload.name
+  end
+
+  test "destroying bot deactivates its user" do
+    bot = Bot.create!(name: "Doomed Bot", creator: users(:david))
+    bot_code = bot.code
+    user = bot.user
+
+    bot.destroy
+
+    assert_not user.reload.active?
+    assert_nil Bot.find_by(code: bot_code)
+  end
+end
