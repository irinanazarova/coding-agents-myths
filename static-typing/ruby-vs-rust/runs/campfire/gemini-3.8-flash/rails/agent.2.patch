+require "test_helper"
+
+class Bot::WebhookDeliveryTest < ActiveSupport::TestCase
+  setup do
+    @creator = users(:david)
+    @user = users(:jason)
+    @room = rooms(:pets)
+    @bot = Bot.create!(name: "Deploy Bot", creator: @creator, webhook_url: "https://example.com/bot/webhook")
+  end
+
+  test "mentioning a bot enqueues Bot::DeliverWebhookJob" do
+    assert_enqueued_with(job: Bot::DeliverWebhookJob) do
+      @room.messages.create!(
+        creator: @user,
+        body: "<div>#{mention_attachment_for(@bot.user)} restart the build please</div>"
+      )
+    end
+  end
+
+  test "mentioning a bot without webhook url does not enqueue job" do
+    @bot.update!(webhook_url: nil)
+
+    assert_no_enqueued_jobs(only: Bot::DeliverWebhookJob) do
+      @room.messages.create!(
+        creator: @user,
+        body: "<div>#{mention_attachment_for(@bot.user)} restart the build please</div>"
+      )
+    end
+  end
+
+  test "bot posting a message does not trigger webhooks" do
+    assert_no_enqueued_jobs(only: Bot::DeliverWebhookJob) do
+      @room.messages.create!(
+        creator: @bot.user,
+        body: "<div>#{mention_attachment_for(@bot.user)} restart the build please</div>"
+      )
+    end
+  end
+
+  test "delivers correct payload structure to webhook URL" do
+    message = @room.messages.create!(
+      creator: @user,
+      body: "<div>#{mention_attachment_for(@bot.user)} restart the build please</div>"
+    )
+
+    stub_request(:post, "https://example.com/bot/webhook")
+      .with(
+        headers: { "Content-Type" => "application/json" },
+        body: {
+          event: "mention",
+          author: {
+            id: @user.id,
+            name: @user.name
+          },
+          room: {
+            id: @room.id,
+            name: @room.name,
+            reply_to: "/rooms/#{@room.id}/#{@bot.code}/messages"
+          },
+          message: {
+            id: message.id,
+            body: {
+              text: "restart the build please",
+              html: message.body.body.to_html
+            },
+            link: "/rooms/#{@room.id}/@#{message.id}"
+          }
+        }.to_json
+      ).to_return(status: 204)
+
+    Bot::WebhookDelivery.new(bot: @bot, message: message).deliver
+
+    assert_requested :post, "https://example.com/bot/webhook"
+  end
+
+  test "webhook stripped text preserves other mentions" do
+    other_bot = Bot.create!(name: "Test Bot", creator: @creator, webhook_url: "https://example.com/test-bot")
+
+    message = @room.messages.create!(
+      creator: @user,
+      body: "<div>#{mention_attachment_for(@bot.user)} and #{mention_attachment_for(other_bot.user)} run build</div>"
+    )
+
+    delivery1 = Bot::WebhookDelivery.new(bot: @bot, message: message)
+    assert_equal "and @Test Bot run build", delivery1.payload[:message][:body][:text]
+
+    delivery2 = Bot::WebhookDelivery.new(bot: other_bot, message: message)
+    assert_equal "@Deploy Bot and run build", delivery2.payload[:message][:body][:text]
+  end
+
+  test "webhook stripped text handles plain text mention and punctuation" do
+    message = @room.messages.create!(
+      creator: @user,
+      body: "@Deploy Bot: restart the build please"
+    )
+
+    delivery = Bot::WebhookDelivery.new(bot: @bot, message: message)
+    assert_equal "restart the build please", delivery.payload[:message][:body][:text]
+  end
+
+  test "bot replies with 200 text/plain creates message in room" do
+    message = @room.messages.create!(
+      creator: @user,
+      body: "<div>#{mention_attachment_for(@bot.user)} restart the build please</div>"
+    )
+
+    stub_request(:post, "https://example.com/bot/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Build restarted!")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bot::WebhookDelivery.new(bot: @bot, message: message).deliver
+    end
+
+    bot_message = @room.messages.last
+    assert_equal @bot.user, bot_message.creator
+    assert_equal "Build restarted!", bot_message.plain_text_body
+  end
+
+  test "bot replies with 200 text/html creates message in room" do
+    message = @room.messages.create!(
+      creator: @user,
+      body: "<div>#{mention_attachment_for(@bot.user)} status</div>"
+    )
+
+    stub_request(:post, "https://example.com/bot/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/html" }, body: "<b>All systems nominal</b>")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bot::WebhookDelivery.new(bot: @bot, message: message).deliver
+    end
+
+    bot_message = @room.messages.last
+    assert_equal @bot.user, bot_message.creator
+    assert_includes bot_message.body.body.to_html, "<b>All systems nominal</b>"
+  end
+
+  test "bot replies with 204 creates no message" do
+    message = @room.messages.create!(
+      creator: @user,
+      body: "<div>#{mention_attachment_for(@bot.user)} run async</div>"
+    )
+
+    stub_request(:post, "https://example.com/bot/webhook")
+      .to_return(status: 204)
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookDelivery.new(bot: @bot, message: message).deliver
+    end
+  end
+
+  test "bot replies with 200 application/json creates no message" do
+    message = @room.messages.create!(
+      creator: @user,
+      body: "<div>#{mention_attachment_for(@bot.user)} hello</div>"
+    )
+
+    stub_request(:post, "https://example.com/bot/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "application/json" }, body: '{"status":"ok"}')
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookDelivery.new(bot: @bot, message: message).deliver
+    end
+  end
+
+  test "bot webhook connection error is handled gracefully" do
+    message = @room.messages.create!(
+      creator: @user,
+      body: "<div>#{mention_attachment_for(@bot.user)} hello</div>"
+    )
+
+    stub_request(:post, "https://example.com/bot/webhook")
+      .to_timeout
+
+    assert_nothing_raised do
+      Bot::WebhookDelivery.new(bot: @bot, message: message).deliver
+    end
+  end
+
+  test "full integration: posting message performs job and posts bot reply" do
+    stub_request(:post, "https://example.com/bot/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Acknowledged!")
+
+    perform_enqueued_jobs only: Bot::DeliverWebhookJob do
+      assert_difference -> { @room.messages.count }, 2 do # 1 from user, 1 from bot
+        @room.messages.create!(
+          creator: @user,
+          body: "<div>#{mention_attachment_for(@bot.user)} deploy</div>"
+        )
+      end
+    end
+
+    bot_message = @room.messages.last
+    assert_equal @bot.user, bot_message.creator
+    assert_equal "Acknowledged!", bot_message.plain_text_body
+  end
+end
