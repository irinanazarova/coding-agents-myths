+    closed_room = rooms(:watercooler)
+    bot = Bot.create!(name: "No Hook Bot", creator: @creator, webhook_url: nil)
+
+    assert_no_enqueued_jobs(only: Bot::DeliverWebhookJob) do
+      closed_room.memberships.grant_to(bot.user)
+    end
+  end
+
+  test "adding a bot to a room it is already in does not enqueue joined job (exactly once per room)" do
+    closed_room = rooms(:watercooler)
+    bot = Bot.create!(name: "Joined Bot", creator: @creator, webhook_url: "https://example.com/joined-bot")
+    closed_room.memberships.grant_to(bot.user)
+
+    assert_no_enqueued_jobs(only: Bot::DeliverWebhookJob) do
+      closed_room.memberships.grant_to(bot.user)
+    end
+  end
+
+  test "direct conversations never trigger joined event" do
+    Current.user = @creator
+    bot = Bot.create!(name: "Direct Bot", creator: @creator, webhook_url: "https://example.com/direct-bot")
+    direct_room = Rooms::Direct.find_or_create_for([users(:david), bot.user])
+
+    assert_no_enqueued_jobs(only: Bot::DeliverWebhookJob) do
+      direct_room.memberships.grant_to(bot.user)
+    end
+  end
+
+  test "delivers correct joined payload structure to webhook URL" do
+    stub_request(:post, "https://example.com/bot/webhook")
+      .with(
+        headers: { "Content-Type" => "application/json" },
+        body: {
+          event: "joined",
+          room: {
+            id: @room.id,
+            name: @room.name,
+            reply_to: "/rooms/#{@room.id}/#{@bot.code}/messages"
+          }
+        }.to_json
+      ).to_return(status: 204)
+
+    Bot::WebhookDelivery.new(bot: @bot, room: @room, event: "joined").deliver
+
+    assert_requested :post, "https://example.com/bot/webhook"
+  end
+
+  test "bot replies to joined event with 200 text/plain creates message in room" do
+    stub_request(:post, "https://example.com/bot/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Hello everyone! 👋")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bot::WebhookDelivery.new(bot: @bot, room: @room, event: "joined").deliver
+    end
+
+    bot_message = @room.messages.last
+    assert_equal @bot.user, bot_message.creator
+    assert_equal "Hello everyone! 👋", bot_message.plain_text_body
+  end
+
+  test "bot replies to joined event with 200 text/html creates message in room" do
+    stub_request(:post, "https://example.com/bot/webhook")
+      .to_return(status: 200, headers: { "Content-Type" => "text/html" }, body: "<p>Hello from <b>Deploy Bot</b>!</p>")
+
+    assert_difference -> { @room.messages.count }, 1 do
+      Bot::WebhookDelivery.new(bot: @bot, room: @room, event: "joined").deliver
+    end
+
+    bot_message = @room.messages.last
+    assert_equal @bot.user, bot_message.creator
+    assert_includes bot_message.body.body.to_html, "Hello from <b>Deploy Bot</b>!"
+  end
+
+  test "bot replies to joined event with 204 creates no message" do
+    stub_request(:post, "https://example.com/bot/webhook")
+      .to_return(status: 204)
+
+    assert_no_difference -> { @room.messages.count } do
+      Bot::WebhookDelivery.new(bot: @bot, room: @room, event: "joined").deliver
+    end
+  end
+
+  test "full integration: adding bot to room performs job and posts greeting" do
+    closed_room = rooms(:watercooler)
+    bot = Bot.create!(name: "Greeter Bot", creator: @creator, webhook_url: "https://example.com/greeter")
+
+    stub_request(:post, "https://example.com/greeter")
+      .to_return(status: 200, headers: { "Content-Type" => "text/plain" }, body: "Glad to be here!")
+
+    perform_enqueued_jobs only: Bot::DeliverWebhookJob do
+      assert_difference -> { closed_room.messages.count }, 1 do
+        closed_room.memberships.grant_to(bot.user)
+      end
+    end
+
+    bot_message = closed_room.messages.last
+    assert_equal bot.user, bot_message.creator
+    assert_equal "Glad to be here!", bot_message.plain_text_body
+  end
+
+  test "creating a new open room enqueues joined webhook for bot with all_open_rooms" do
+    bot_with_all = Bot.create!(name: "All Open Bot", creator: @creator, webhook_url: "https://example.com/all-open", all_open_rooms: true)
+    bot_without = Bot.create!(name: "Selective Bot", creator: @creator, webhook_url: "https://example.com/selective", all_open_rooms: false)
+
+    new_open_room = Rooms::Open.new(name: "New Open Room", creator: @creator)
+    assert_enqueued_with(job: Bot::DeliverWebhookJob, args: [bot_with_all, new_open_room]) do
+      new_open_room.save!
+    end
+
+    enqueued_args = enqueued_jobs.map { |j| j[:args] }; assert_not_includes enqueued_args, [bot_without, new_open_room]
+  end
+
+  test "creating bot with all_open_rooms enqueues joined webhook for each existing open room" do
+    open_rooms = Rooms::Open.all.to_a
+    assert open_rooms.size > 0
+
+    bot = nil
+    assert_enqueued_jobs open_rooms.size, only: Bot::DeliverWebhookJob do
+      bot = Bot.create!(name: "New All Open Bot", creator: @creator, webhook_url: "https://example.com/new-all-open", all_open_rooms: true)
+    end
+
+    open_rooms.each do |open_room|
+      assert_enqueued_with(job: Bot::DeliverWebhookJob, args: [bot, open_room])
+    end
+  end
 end
