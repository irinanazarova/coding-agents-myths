--- /dev/null
+++ b/crates/views/templates/bots/new.html
@@ -0,0 +1,42 @@
+{% extends "layouts/application.html" %}
+{%- block head %}{% endblock %}
+
+{% block nav %}  <div class="flex-item-justify-start">
+    {{ h::link_back_to(ctx, h::routes::bots()) }}
+  </div>
+{% endblock %}
+
+{% block content %}<section class="panel txt-align-center flex flex-column gap">
+  <h1 class="txt-x-large">New chat bot</h1>
+
+  {% let form = h::form_with(h::routes::bots()).model("bot").method("post").multipart().data("controller", "form").class("flex flex-column gap") %}
+  {% filter form_with(form) %}
+    <div class="align-center center avatar__form gap" data-controller="upload-preview">
+      <label class="btn input--file">
+        {{ h::image_tag(ctx, "camera.svg", h::attrs().aria_hidden().size(20)) }}
+        <input type="file" name="bot[avatar]" id="bot_avatar" class="input" accept="image/*" data-upload-preview-target="input" data-action="upload-preview#previewImage">
+        <span class="for-screen-reader">Upload avatar</span>
+      </label>
+
+      <label class="btn avatar input--file txt-xx-large">
+        {{ h::image_tag(ctx, "default-avatar.svg", h::attrs().aria_hidden().data("upload-preview-target", "image")) }}
+        <span class="for-screen-reader">Avatar</span>
+      </label>
+    </div>
+
+    <div class="flex flex-column align-center gap">
+      <label for="bot_name" class="flex flex-column gap full-width txt-align-start">
+        <strong>Name the bot</strong>
+        <input type="text" id="bot_name" name="bot[name]" class="input txt-large full-width" placeholder="Name the bot" aria-label="Name the bot" autofocus required>
+      </label>
+    </div>
+
+    <div class="margin-block-start flex justify-center">
+      {% filter button(h::attrs().class("btn btn--reversed center txt-large").type_("submit")) %}
+        {{ h::image_tag(ctx, "check.svg", h::attrs().aria_hidden().size(20)) }}
+        <span>Save changes</span>
+      {% endfilter %}
+    </div>
+  {% endfilter %}
+</section>
+{% endblock %}
