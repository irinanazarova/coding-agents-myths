+  </div>
+{% endblock %}
+
+{% block content %}<section class="panel txt-align-center flex flex-column gap">
+  <div class="flex align-center justify-between gap">
+    <h1 class="txt-x-large margin-none">Chat bots</h1>
+    {% filter link_to(h::routes::new_bot(), h::attrs().class("btn btn--reversed")) %}
+      Add a chat bot
+    {% endfilter %}
+  </div>
+
+  <div class="margin-block pad-inline pad-block fill-shade border-radius">
+    {% if bots.is_empty() %}
+      <p class="txt-subtle">No chat bots yet.</p>
+    {% else %}
+      <ul class="flex flex-column gap margin-none pad-none list-style-none">
+        {% for bot in bots %}
+          <li class="flex align-center justify-between gap pad-block border-bottom">
+            <div class="flex align-center gap">
+              <figure class="avatar txt-large margin-none">
+                <img alt="{{ bot.name }}" src="{{ bot.avatar_url }}" width="40" height="40" class="border-radius" />
+              </figure>
+              <strong class="txt-large">{{ bot.name }}</strong>
+            </div>
+
+            <div class="flex align-center gap">
+              <label for="bot_code_{{ bot.id }}" class="txt-subtle">Bot code</label>
+              <input type="text" id="bot_code_{{ bot.id }}" name="bot_code" value="{{ bot.code }}" aria-label="Bot code" readonly class="input" style="font-family: monospace; width: 26ch;">
+            </div>
+
+            <div>
+              {% filter link_to(h::routes::edit_bot(bot.id), h::attrs().class("btn")) %}
+                Edit {{ bot.name }}
+              {% endfilter %}
+            </div>
+          </li>
+        {% endfor %}
+      </ul>
+    {% endif %}
+  </div>
+</section>
+{% endblock %}
