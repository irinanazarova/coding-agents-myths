+        move |conn| msg.plain_text_body(conn, &*rich_text)
+    }).await.unwrap();
+    assert!(text.contains("Finished background task out-of-band!"));
+}
diff --git a/crates/campfire/src/controllers/bots/webhooks.rs b/crates/campfire/src/controllers/bots/webhooks.rs
new file mode 100644
index 0000000..5091953
--- /dev/null
+++ b/crates/campfire/src/controllers/bots/webhooks.rs
@@ -0,0 +1,285 @@
+//! Webhook dispatching for bot mentions.
+
+use std::time::Duration;
+
+use anyhow::Result;
+use campfire_db::{Bot, Message, NewMessage, RichText, Room, User};
+use hyper::Method;
+
+use crate::app::App;
+use crate::controllers::messages;
+use crate::controllers::presenters::page::{self, Rendered};
+use crate::controllers::presenters::Presenter;
+use crate::integrations::net::http::{self, Endpoint, Timeouts};
+use crate::integrations::net::Network;
+
+const MAX_BODY_SIZE: usize = 5 * 1024 * 1024;
+
+const TIMEOUTS: Timeouts = Timeouts {
+    open: Duration::from_secs(5),
+    read: Duration::from_secs(15),
+};
+
+/// Triggers webhooks for any bots mentioned in the given message.
+/// Spawns a background task so it never blocks or slows down the caller.
+pub fn trigger_bot_mentions(app: &App, room: &Room, message: &Message, base_url: String) {
+    let app = app.clone();
+    let room = room.clone();
+    let message = message.clone();
+    tokio::spawn(async move {
+        if let Err(e) = deliver_bot_mentions(&app, &room, &message, &base_url).await {
+            tracing::warn!(error = %e, "delivering bot webhooks failed");
+        }
+    });
+}
+
+async fn deliver_bot_mentions(app: &App, room: &Room, message: &Message, base_url: &str) -> Result<()> {
+    // 1. If message was authored by a bot, do not trigger webhooks (avoid loops)
+    let author_is_bot = app
+        .db
+        .read({
+            let creator_id = message.creator_id;
+            move |conn| Ok(Bot::find_by_user_id(conn, creator_id)?.is_some())
+        })
+        .await
+        .unwrap_or(false);
+
+    if author_is_bot {
+        return Ok(());
+    }
+
+    // 2. Read author, bot candidates with webhook in this room, plain text, and HTML body
+    let app_clone = app.clone();
+    let message_id = message.id;
+    let room_id = room.id;
+    let creator_id = message.creator_id;
+
+    let (author, to_notify, plain_text, body_html) = app
+        .db
+        .read(move |conn| {
+            let author = User::find(conn, creator_id)?;
+            let msg = Message::find(conn, message_id)?;
+            let body_html = msg.body_html(conn)?.unwrap_or_default();
+            let rich_text: &dyn RichText = &*app_clone.db.env().rich_text;
+            let plain_text = msg.plain_text_body(conn, rich_text)?;
+
+            let mentioned_user_ids = rich_text.mentioned_user_ids(conn, &body_html);
+            let bots = Bot::for_room_with_webhook(conn, room_id)?;
+
+            let mut to_notify = Vec::new();
+            for (bot, bot_user) in bots {
+                if bot.user_id == creator_id {
+                    continue;
+                }
+                let in_rich_text = mentioned_user_ids.contains(&bot.user_id);
+                let in_plain_text = is_bot_mentioned_in_text(&plain_text, &bot_user.name);
+                if in_rich_text || in_plain_text {
+                    to_notify.push((bot, bot_user));
+                }
+            }
+            Ok((author, to_notify, plain_text, body_html))
+        })
+        .await?;
+
+    // 3. For each mentioned bot, deliver webhook concurrently
+    for (bot, bot_user) in to_notify {
+        let app = app.clone();
+        let room = room.clone();
+        let message = message.clone();
+        let author = author.clone();
+        let plain_text = plain_text.clone();
+        let body_html = body_html.clone();
+        let base_url = base_url.to_string();
+
+        tokio::spawn(async move {
+            if let Err(e) = send_webhook_and_handle_response(
+                &app, &room, &bot, &bot_user, &author, &message, &plain_text, &body_html, &base_url,
+            )
+            .await
+            {
+                tracing::warn!(error = %e, bot_id = bot.id, "bot webhook dispatch failed");
+            }
+        });
+    }
+
+    Ok(())
+}
+
+async fn send_webhook_and_handle_response(
+    app: &App,
+    room: &Room,
+    bot: &Bot,
+    bot_user: &User,
+    author: &User,
+    message: &Message,
+    plain_text: &str,
+    body_html: &str,
+    base_url: &str,
+) -> Result<()> {
+    let Some(webhook_url) = bot.webhook_url.as_deref().filter(|u| !u.trim().is_empty()) else {
+        return Ok(());
+    };
+
+    let stripped_text = strip_bot_mention(plain_text, &bot_user.name);
+    let reply_to = campfire_routes::bot_messages(room.id, &bot.code);
+    let link = campfire_routes::room_at_message(room.id, message.id);
+
+    let payload = serde_json::json!({
+        "event": "mention",
+        "author": {
+            "id": author.id,
+            "name": author.name,
+        },
+        "room": {
+            "id": room.id,
+            "name": room.name.as_deref().unwrap_or(""),
+            "reply_to": reply_to,
+        },
+        "message": {
+            "id": message.id,
+            "body": {
+                "text": stripped_text,
+                "html": body_html,
+            },
+            "link": link,
+        }
+    });
+
+    let uri = campfire_richtext::uri::parse(webhook_url)
+        .map_err(|e| anyhow::anyhow!("Invalid webhook URL {webhook_url}: {e:?}"))?;
+    let https = uri.scheme.as_deref().is_some_and(|s| s.eq_ignore_ascii_case("https"));
+    let host = uri
+        .host
+        .clone()
+        .filter(|h| !h.is_empty())
+        .ok_or_else(|| anyhow::anyhow!("Missing host in webhook URL"))?;
+    let port = uri.port.and_then(|p| u16::try_from(p).ok()).unwrap_or(if https { 443 } else { 80 });
+    let endpoint = Endpoint {
+        https,
+        host: host.clone(),
+        port,
+        pinned_ip: None,
+    };
+    let target = http::request_uri(&uri);
+    let body_bytes = serde_json::to_vec(&payload)?;
+    let headers = vec![
+        ("Host".into(), endpoint.host_header()),
+        ("Content-Type".into(), "application/json".into()),
+        ("Accept".into(), "*/*".into()),
+        ("User-Agent".into(), "Campfire".into()),
+    ];
+    let request = http::Request {
+        method: Method::POST,
+        target,
+        headers,
+        body: body_bytes,
+        decode_content: true,
+    }
+    .transport(true, &endpoint);
+
+    let net = Network::system();
+    let response = http::exchange(&net, &endpoint, request, &TIMEOUTS).await?;
+
+    if response.status == 200 {
+        let content_type = response.content_type().unwrap_or_default().to_ascii_lowercase();
+        if content_type.starts_with("text/plain") || content_type.starts_with("text/html") {
+            let body = match response.read_body(MAX_BODY_SIZE).await? {
+                http::Body::Complete(b) => b,
+                http::Body::TooLarge => return Ok(()),
+            };
+            let body_text = String::from_utf8_lossy(&body).trim().to_string();
+            if !body_text.is_empty() {
+                post_bot_reply(app, room, bot, body_text, base_url).await?;
+            }
+        }
+    }
+
+    Ok(())
+}
+
+pub async fn post_bot_reply(
+    app: &App,
+    room: &Room,
+    bot: &Bot,
+    body_text: String,
+    base_url: &str,
+) -> Result<Message> {
+    let app_clone = app.clone();
+    let canonical_body = app
+        .db
+        .read(move |conn| Ok(messages::canonical_body(conn, &app_clone, &body_text, None)))
+        .await?;
+    let bot_user_id = bot.user_id;
+    let room_id = room.id;
+
+    let message = app
+        .db
+        .write(move |tx| {
+            Message::create(
+                tx,
+                NewMessage {
+                    room_id,
+                    creator_id: bot_user_id,
+                    client_message_id: None,
+                    body: Some(canonical_body),
+                    attachment_blob_id: None,
+                },
+            )
+        })
+        .await?;
+
+    let (broadcast_app, room_clone, message_clone) = (app.clone(), room.clone(), message.clone());
+    let base_url = base_url.to_string();
+    app.db
+        .read(move |conn| {
+            let presenter = Presenter::new(conn, &broadcast_app, None);
+            let view = presenter.message(&message_clone)?;
+            let account = campfire_db::Account::first(conn)?;
+            let html = page::render_detached_at(&broadcast_app, account.as_ref(), &base_url, |ctx| {
+                campfire_views::messages::message(ctx, &view)
+            });
+            let partials = Rendered { message: Some(html), ..Rendered::default() };
+            broadcast_app.broadcasts.message_create(conn, &room_clone, &message_clone, &partials)
+        })
+        .await?;
+
+    Ok(message)
+}
+
+pub fn is_bot_mentioned_in_text(plain_text: &str, bot_name: &str) -> bool {
+    let pattern = format!(r"(?i)@{}(?:\b(?::|,)?|(?::|,)?\b)", regex::escape(bot_name));
+    regex::Regex::new(&pattern).map(|re| re.is_match(plain_text)).unwrap_or(false)
+}
+
+pub fn strip_bot_mention(plain_text: &str, bot_name: &str) -> String {
+    let pattern = format!(r"(?i)@{}(?:\b(?::|,)?|(?::|,)?\b)", regex::escape(bot_name));
+    if let Ok(re) = regex::Regex::new(&pattern) {
+        let stripped = re.replace_all(plain_text, "");
+        let mut lines = Vec::new();
+        for line in stripped.lines() {
+            let collapsed = line.split_whitespace().collect::<Vec<_>>().join(" ");
+            lines.push(collapsed);
+        }
+        lines.join("\n").trim().to_string()
+    } else {
+        plain_text.trim().to_string()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_strip_bot_mention() {
+        assert_eq!(strip_bot_mention("@Deploy Bot restart the build please", "Deploy Bot"), "restart the build please");
+        assert_eq!(strip_bot_mention("restart the build please @Deploy Bot", "Deploy Bot"), "restart the build please");
+        assert_eq!(strip_bot_mention("@Deploy Bot: restart the build please", "Deploy Bot"), "restart the build please");
+        assert_eq!(strip_bot_mention("@Deploy Bot, restart the build please", "Deploy Bot"), "restart the build please");
+        assert_eq!(strip_bot_mention("hey @Deploy Bot, please restart", "Deploy Bot"), "hey please restart");
+        assert_eq!(strip_bot_mention("@Deploy Bot", "Deploy Bot"), "");
+        assert_eq!(strip_bot_mention("@Deploy Bot\nrun test", "Deploy Bot"), "run test");
+        assert_eq!(strip_bot_mention("@Bottle of water", "Bot"), "@Bottle of water");
+        assert_eq!(strip_bot_mention("@Alice and @Bob", "Alice"), "and @Bob");
+    }
+}
