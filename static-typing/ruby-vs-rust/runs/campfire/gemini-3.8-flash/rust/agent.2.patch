+#[tokio::test]
+async fn bot_form_has_webhook_url_and_persists() {
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+
+    // 1. Visit /bots/new and check for "Webhook URL" field
+    let reply = david.get("/bots/new").await;
+    assert_eq!(reply.status, StatusCode::OK);
+    let html = reply.text();
+    assert!(html.contains("Webhook URL"), "new bot form contains 'Webhook URL' label: {html}");
+    assert!(html.contains("name=\"bot[webhook_url]\""), "contains webhook input: {html}");
+
+    // 2. Create bot with webhook URL
+    let webhook_url = "http://127.0.0.1:9876/bot-hook";
+    let reply = david
+        .send(
+            Req::new(Method::POST, "/bots")
+                .form(&[("bot[name]", "Hook Bot"), ("bot[webhook_url]", webhook_url)]),
+        )
+        .await;
+    assert_eq!(reply.status, StatusCode::FOUND);
+
+    // Verify webhook_url in DB
+    let bot = app.db().read(|conn| {
+        let bots = Bot::all(conn)?;
+        let bot = bots.into_iter().find(|b| b.webhook_url.as_deref() == Some("http://127.0.0.1:9876/bot-hook")).unwrap();
+        Ok(bot)
+    }).await.unwrap();
+    assert_eq!(bot.webhook_url.as_deref(), Some(webhook_url));
+
+    // 3. Visit /bots/:id/edit and check that Webhook URL is pre-filled
+    let reply = david.get(&format!("/bots/{}/edit", bot.id)).await;
+    assert_eq!(reply.status, StatusCode::OK);
+    let html = reply.text();
+    assert!(html.contains("Webhook URL"), "edit form contains Webhook URL label: {html}");
+    assert!(html.contains(&format!("value=\"{webhook_url}\"")), "edit form pre-fills webhook url: {html}");
+
+    // 4. Update with empty webhook URL -> removes webhook
+    let reply = david
+        .send(
+            Req::new(Method::PATCH, &format!("/bots/{}", bot.id))
+                .form(&[("bot[name]", "Hook Bot"), ("bot[webhook_url]", "")]),
+        )
+        .await;
+    assert_eq!(reply.status, StatusCode::FOUND);
+
+    let updated_bot = app.db().read({
+        let bot_id = bot.id;
+        move |conn| Bot::find(conn, bot_id)
+    }).await.unwrap();
+    assert_eq!(updated_bot.webhook_url, None, "empty webhook URL removes webhook");
+
+    // 5. Update with new webhook URL
+    let new_webhook_url = "http://127.0.0.1:9876/new-hook";
+    let reply = david
+        .send(
+            Req::new(Method::PATCH, &format!("/bots/{}", bot.id))
+                .form(&[("bot[name]", "Hook Bot"), ("bot[webhook_url]", new_webhook_url)]),
+        )
+        .await;
+    assert_eq!(reply.status, StatusCode::FOUND);
+
+    let updated_bot = app.db().read({
+        let bot_id = bot.id;
+        move |conn| Bot::find(conn, bot_id)
+    }).await.unwrap();
+    assert_eq!(updated_bot.webhook_url.as_deref(), Some(new_webhook_url));
+}
