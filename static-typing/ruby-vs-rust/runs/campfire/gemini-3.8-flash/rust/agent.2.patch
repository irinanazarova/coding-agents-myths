+    david
+        .send(
+            Req::new(Method::POST, &format!("/rooms/{HQ}/messages"))
+                .header("accept", "text/vnd.turbo-stream.html")
+                .form(&[("message[body]", "@Async Bot run background task")]),
+        )
+        .await;
