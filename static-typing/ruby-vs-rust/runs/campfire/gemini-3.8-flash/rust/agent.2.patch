+#[tokio::test]
+async fn bot_webhook_triggered_on_mention_and_sync_reply() {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    use tokio::net::TcpListener;
+    use tokio::sync::oneshot;
+
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+
+    // 1. Spin up mock webhook server
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let (tx_payload, rx_payload) = oneshot::channel::<serde_json::Value>();
+
+    tokio::spawn(async move {
+        if let Ok((mut stream, _)) = listener.accept().await {
+            let mut buf = vec![0u8; 8192];
+            let n = stream.read(&mut buf).await.unwrap();
+            let req_str = String::from_utf8_lossy(&buf[..n]).to_string();
+
+            // Extract JSON body after \r\n\r\n
+            if let Some(pos) = req_str.find("\r\n\r\n") {
+                let body = &req_str[pos + 4..];
+                if let Ok(json) = serde_json::from_str::<serde_json::Value>(body) {
+                    let _ = tx_payload.send(json);
+                }
+            }
+
+            // Reply with 200 OK text/plain
+            let reply_body = "Build restarted synchronously!";
+            let response = format!(
+                "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
+                reply_body.len(),
+                reply_body
+            );
+            let _ = stream.write_all(response.as_bytes()).await;
+        }
+    });
+
+    // 2. Create bot with webhook URL pointing to mock server
+    let webhook_url = format!("http://127.0.0.1:{port}/callback");
+    david.send(Req::new(Method::POST, "/bots").form(&[("bot[name]", "CI Bot"), ("bot[webhook_url]", &webhook_url)])).await;
+
+    // Read bot info
+    let bot = app.db().read(|conn| {
+        let bots = Bot::all(conn)?;
+        Ok(bots.into_iter().find(|b| b.webhook_url.is_some()).unwrap())
+    }).await.unwrap();
+
+    // 3. David posts a message mentioning CI Bot
+    let reply = david
+        .send(
+            Req::new(Method::POST, &format!("/rooms/{HQ}/messages"))
+                .header("accept", "text/vnd.turbo-stream.html")
+                .form(&[("message[body]", "@CI Bot restart the build please")]),
+        )
+        .await;
+    assert_eq!(reply.status, StatusCode::OK);
+
+    // 4. Await payload received by webhook
+    let payload = tokio::time::timeout(std::time::Duration::from_secs(5), rx_payload)
+        .await
+        .expect("webhook received within 5 seconds")
+        .expect("payload channel open");
+
+    // Verify payload fields
+    assert_eq!(payload["event"], "mention");
+    assert_eq!(payload["author"]["name"], "David");
+    assert_eq!(payload["room"]["id"], HQ);
+    assert_eq!(payload["room"]["name"], "HQ");
+    assert_eq!(payload["room"]["reply_to"], format!("/rooms/{HQ}/{}/messages", bot.code));
+    assert_eq!(payload["message"]["body"]["text"], "restart the build please");
+    assert!(payload["message"]["link"].as_str().unwrap().starts_with(&format!("/rooms/{HQ}/@")));
+
+    // 5. Verify the bot's synchronous 200 reply was posted into HQ
+    // Give a brief moment for the async post_bot_reply to commit
+    let mut reply_posted = false;
+    for _ in 0..50 {
+        tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+        let messages = app.db().read(|conn| Message::last_page(conn, HQ)).await.unwrap();
+        if messages.iter().any(|m| m.creator_id == bot.user_id) {
+            reply_posted = true;
+            let msg = messages.iter().find(|m| m.creator_id == bot.user_id).unwrap();
+            let rich_text = app.booted.app.db.env().rich_text.clone();
+            let text = app.db().read({
+                let msg = msg.clone();
+                move |conn| msg.plain_text_body(conn, &*rich_text)
+            }).await.unwrap();
+            assert!(text.contains("Build restarted synchronously!"));
+            break;
+        }
+    }
+    assert!(reply_posted, "bot's reply should be posted into the room");
+}
