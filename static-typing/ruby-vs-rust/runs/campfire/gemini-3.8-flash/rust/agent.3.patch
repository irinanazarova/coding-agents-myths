+    let messages = app.db().read({
+        let room_id = silent_room.id;
+        move |conn| Message::last_page(conn, room_id)
+    }).await.unwrap();
+    assert!(!messages.iter().any(|m| m.creator_id == bot.user_id), "no message posted for 204");
+}
