+#[tokio::test]
+async fn bot_joined_webhook_payload_and_sync_reply() {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    use tokio::net::TcpListener;
+    use tokio::sync::mpsc;
+
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let (tx_payload, mut rx_payload) = mpsc::unbounded_channel::<serde_json::Value>();
+
+    tokio::spawn(async move {
+        while let Ok((mut stream, _)) = listener.accept().await {
+            let mut buf = vec![0u8; 8192];
+            let n = stream.read(&mut buf).await.unwrap();
+            let req_str = String::from_utf8_lossy(&buf[..n]).to_string();
+
+            if let Some(pos) = req_str.find("\r\n\r\n") {
+                let body = &req_str[pos + 4..];
+                if let Ok(json) = serde_json::from_str::<serde_json::Value>(body) {
+                    let _ = tx_payload.send(json.clone());
+
+                    // If joined event, reply with 200 OK text/plain greeting!
+                    if json["event"] == "joined" {
+                        let greeting = "Hello everyone! Happy to be here.";
+                        let response = format!(
+                            "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
+                            greeting.len(),
+                            greeting
+                        );
+                        let _ = stream.write_all(response.as_bytes()).await;
+                        continue;
+                    }
+
+                    let response = "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n";
+                    let _ = stream.write_all(response.as_bytes()).await;
+                }
+            }
+        }
+    });
+
+    let webhook_url = format!("http://127.0.0.1:{port}/joined-webhook");
+
+    // 1. Create bot with webhook_url and "Add to all open rooms" switch OFF
+    david.send(Req::new(Method::POST, "/bots").form(&[
+        ("bot[name]", "Friendly Bot"),
+        ("bot[webhook_url]", &webhook_url),
+    ])).await;
+
+    let bot = app.db().read(|conn| {
+        let bots = Bot::all(conn)?;
+        Ok(bots.into_iter().find(|b| bot_name(conn, b) == "Friendly Bot").unwrap())
+    }).await.unwrap();
+
+    // No joined event yet since it didn't join any rooms
+    tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+    assert!(rx_payload.try_recv().is_err());
+
+    // 2. Direct conversations NEVER trigger joined
+    app.db().write({
+        let bot_user_id = bot.user_id;
+        move |tx| {
+            Room::find_or_create_direct_for(tx, &[1, bot_user_id], 1)
+        }
+    }).await.unwrap();
+
+    tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+    assert!(rx_payload.try_recv().is_err(), "direct rooms never trigger joined event");
+
+    // 3. Adding bot to a closed room triggers `joined` event
+    let closed_room = app.db().write({
+        let bot_user_id = bot.user_id;
+        move |tx| {
+            Room::create_for(tx, RoomType::Closed, Some("Ops"), 1, &[1, bot_user_id])
+        }
+    }).await.unwrap();
+
+    let payload = tokio::time::timeout(std::time::Duration::from_secs(5), rx_payload.recv())
+        .await
+        .expect("joined webhook received")
+        .expect("channel open");
+
+    assert_eq!(payload["event"], "joined");
+    assert_eq!(payload["room"]["id"], closed_room.id);
+    assert_eq!(payload["room"]["name"], "Ops");
+    assert_eq!(payload["room"]["reply_to"], format!("/rooms/{}/{}/messages", closed_room.id, bot.code));
+
+    // Verify synchronous greeting message was posted into Ops by Friendly Bot
+    let mut greeting_posted = false;
+    for _ in 0..50 {
+        tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+        let messages = app.db().read({
+            let room_id = closed_room.id;
+            move |conn| Message::last_page(conn, room_id)
+        }).await.unwrap();
+        if messages.iter().any(|m| m.creator_id == bot.user_id) {
+            greeting_posted = true;
+            let msg = messages.iter().find(|m| m.creator_id == bot.user_id).unwrap();
+            let rich_text = app.booted.app.db.env().rich_text.clone();
+            let text = app.db().read({
+                let msg = msg.clone();
+                move |conn| msg.plain_text_body(conn, &*rich_text)
+            }).await.unwrap();
+            assert!(text.contains("Hello everyone! Happy to be here."));
+            break;
+        }
+    }
+    assert!(greeting_posted, "greeting posted in closed room");
+
+    // 4. Updating the closed room does NOT trigger joined again (exactly once per room)
+    app.db().write({
+        let room_id = closed_room.id;
+        let bot_user_id = bot.user_id;
+        move |tx| {
+            let mut room = Room::find(tx.conn(), room_id)?;
+            room.update(tx, Some(Some("Ops Renamed")), None)?;
+            room.grant_to(tx, &[bot_user_id])
+        }
+    }).await.unwrap();
+
+    tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+    assert!(rx_payload.try_recv().is_err(), "no duplicate joined event for same room");
+
+    // 5. Enabling "Add to all open rooms" on edit triggers joined for open rooms (e.g. HQ)
+    david.send(Req::new(Method::PATCH, &format!("/bots/{}", bot.id)).form(&[
+        ("bot[name]", "Friendly Bot"),
+        ("bot[all_open_rooms]", "1"),
+    ])).await;
+
+    let payload = tokio::time::timeout(std::time::Duration::from_secs(5), rx_payload.recv())
+        .await
+        .expect("joined webhook received for HQ")
+        .expect("channel open");
+
+    assert_eq!(payload["event"], "joined");
+    assert_eq!(payload["room"]["id"], HQ);
+    assert_eq!(payload["room"]["name"], "HQ");
+    assert_eq!(payload["room"]["reply_to"], format!("/rooms/{HQ}/{}/messages", bot.code));
+}
+
+fn bot_name(conn: &rusqlite::Connection, bot: &Bot) -> String {
+    User::find(conn, bot.user_id).map(|u| u.name).unwrap_or_default()
+}
