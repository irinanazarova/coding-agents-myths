+#[tokio::test]
+async fn bot_open_room_membership_switch_and_creation_behavior() {
+    let app = TestApp::boot().await;
+    let mut david = app.david();
+
+    // 1. Visit /bots/new and verify "Add to all open rooms" switch is off by default
+    let reply = david.get("/bots/new").await;
+    assert_eq!(reply.status, StatusCode::OK);
+    let html = reply.text();
+    assert!(html.contains("Add to all open rooms"), "contains switch label: {html}");
+    // Should not have checked
+    assert!(!html.contains("checked"), "switch should be off by default");
+
+    // 2. Create bot with switch OFF (default)
+    david.send(Req::new(Method::POST, "/bots").form(&[("bot[name]", "Selective Bot")])).await;
+    let bot_id = app.db().read(|conn| {
+        let bots = Bot::all(conn)?;
+        Ok(bots.into_iter().find(|b| bot_name(conn, b) == "Selective Bot").unwrap().id)
+    }).await.unwrap();
+
+    let bot = app.db().read(move |conn| Bot::find(conn, bot_id)).await.unwrap();
+    assert!(!bot.all_open_rooms);
+
+    // Bot is NOT in open rooms (HQ, etc.)
+    let in_hq = app.db().read({
+        let user_id = bot.user_id;
+        move |conn| Membership::find_by_room_and_user(conn, HQ, user_id)
+    }).await.unwrap();
+    assert!(in_hq.is_none(), "bot should not be in HQ");
+
+    // 3. Regular user (person) created STILL joins open rooms by default
+    let person = app.db().write(|tx| {
+        User::create(tx, campfire_db::NewUser {
+            name: "New Person".into(),
+            email_address: Some("person@example.com".into()),
+            password_digest: campfire_db::PasswordDigest::create("secret123", 4).ok(),
+            role: campfire_db::Role::Member,
+            ..Default::default()
+        })
+    }).await.unwrap();
+
+    let person_in_hq = app.db().read({
+        let user_id = person.id;
+        move |conn| Membership::find_by_room_and_user(conn, HQ, user_id)
+    }).await.unwrap();
+    assert!(person_in_hq.is_some(), "person still joins open rooms by default");
+
+    // 4. Create a bot with switch ON
+    david.send(Req::new(Method::POST, "/bots").form(&[
+        ("bot[name]", "Global Bot"),
+        ("bot[all_open_rooms]", "1"),
+    ])).await;
+    let global_bot = app.db().read(|conn| {
+        let bots = Bot::all(conn)?;
+        Ok(bots.into_iter().find(|b| bot_name(conn, b) == "Global Bot").unwrap())
+    }).await.unwrap();
+    assert!(global_bot.all_open_rooms);
+
+    // Global Bot IS in HQ
+    let global_in_hq = app.db().read({
+        let user_id = global_bot.user_id;
+        move |conn| Membership::find_by_room_and_user(conn, HQ, user_id)
+    }).await.unwrap();
+    assert!(global_in_hq.is_some(), "global bot is in HQ");
+
+    // 5. Create a new open room later -> global bot automatically joins it, selective bot does not
+    let new_room = app.db().write(|tx| {
+        Room::create(tx, RoomType::Open, Some("Engineering"), 1)
+    }).await.unwrap();
+
+    let global_in_eng = app.db().read({
+        let user_id = global_bot.user_id;
+        let room_id = new_room.id;
+        move |conn| Membership::find_by_room_and_user(conn, room_id, user_id)
+    }).await.unwrap();
+    assert!(global_in_eng.is_some(), "global bot joins new open room");
+
+    let selective_in_eng = app.db().read({
+        let user_id = bot.user_id;
+        let room_id = new_room.id;
+        move |conn| Membership::find_by_room_and_user(conn, room_id, user_id)
+    }).await.unwrap();
+    assert!(selective_in_eng.is_none(), "selective bot does not join new open room");
+
+    // 6. Turn switch OFF for Global Bot -> keeps existing memberships
+    let reply = david.get(&format!("/bots/{}/edit", global_bot.id)).await;
+    let html = reply.text();
+    assert!(html.contains("checked"), "switch is checked on edit page: {html}");
+
+    david.send(Req::new(Method::PATCH, &format!("/bots/{}", global_bot.id)).form(&[
+        ("bot[name]", "Global Bot"),
+        ("bot[all_open_rooms]", "0"),
+    ])).await;
+
+    // Existing memberships kept
+    let global_in_eng = app.db().read({
+        let user_id = global_bot.user_id;
+        let room_id = new_room.id;
+        move |conn| Membership::find_by_room_and_user(conn, room_id, user_id)
+    }).await.unwrap();
+    assert!(global_in_eng.is_some(), "turning switch off keeps current memberships");
+
+    // 7. Create another open room -> former global bot does NOT join it
+    let later_room = app.db().write(|tx| {
+        Room::create(tx, RoomType::Open, Some("Design"), 1)
+    }).await.unwrap();
+
+    let global_in_design = app.db().read({
+        let user_id = global_bot.user_id;
+        let room_id = later_room.id;
+        move |conn| Membership::find_by_room_and_user(conn, room_id, user_id)
+    }).await.unwrap();
+    assert!(global_in_design.is_none(), "bot with switch off does not join subsequent open rooms");
+}
