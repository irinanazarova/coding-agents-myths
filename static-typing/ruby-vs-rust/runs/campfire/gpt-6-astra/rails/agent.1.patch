new file mode 100644
index 0000000..01a986a
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,25 @@
+module User::Bot
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, -> { bot }, class_name: "User", foreign_key: :creator_id, dependent: :nullify
+
+    validates :name, presence: true, if: :bot?
+    before_validation :set_bot_credentials, on: :create, if: :bot?
+  end
+
+  def deactivate_bot
+    transaction do
+      deactivate
+      memberships.delete_all
+      update! bot_code: nil
+    end
+  end
+
+  private
+    def set_bot_credentials
+      self.bot_code ||= SecureRandom.base58(32)
+      self.password = SecureRandom.base58(32) unless password_digest?
+    end
+end
