diff --git a/docs/bots.md b/docs/bots.md
new file mode 100644
index 0000000..7d51dc4
--- /dev/null
+++ b/docs/bots.md
@@ -0,0 +1,57 @@
+# Chat bots
+
+Members manage their own bots at `/bots`, reached through **Set up chat bots**
+in account settings. Administrators can manage every non-deleted bot. The list is
+unpaginated, and each bot's code is a secret bearer credential.
+
+Bots use the existing User model with the `bot` role, a creator, and a random
+32-character code protected by a unique database index. They join existing open
+rooms on creation and new open rooms just like people. Closed-room access is
+managed using the usual room membership controls. Bots cannot sign in through
+the password login form or be promoted through the account's people controls.
+
+Deleting a bot deactivates it, removes all memberships, and clears its code.
+Existing messages keep their author, consistent with removing a human account.
+
+## Posting
+
+```sh
+curl --data-binary 'Deploy of v1.2.3 finished ✅' \
+  https://chat.example.com/rooms/ROOM_ID/BOT_CODE/messages
+```
+
+The request body is UTF-8 text, not JSON or a form. Even curl's default
+`application/x-www-form-urlencoded` content type is treated as literal text.
+For files or multiline output, use `--data-binary @file.txt`. HTML is escaped,
+not interpreted. The endpoint does not accept a multipart attachment envelope.
+
+Responses:
+
+- `201`, with `Location: /messages/MESSAGE_ID` after creation and broadcast
+- `422` for empty/whitespace-only or invalid UTF-8 text
+- `404` for an unknown room or missing bot membership
+- `401` for an invalid, deleted, or inactive bot's credential
+
+The endpoint uses only the path credential, never a browser session. CSRF
+protection remains enabled for management pages and human message endpoints.
+Message creation uses the normal room notification callbacks and broadcasts.
+
+## Credential handling
+
+Do not share bot codes or embed them in public scripts. Use a CI secret store
+and HTTPS. The management list is marked `no-store` and excluded from Turbo's
+snapshot cache. Rails filters `bot_code` parameters and the code segment in its
+filtered request paths. A small middleware prevents request bodies from being
+parsed or logged as form parameters before the controller runs.
+
+**Deployment:** configure reverse proxies, access logs, tracing, and external
+error reporting to redact `/rooms/:room_id/:bot_code/messages` URLs as well.
+Application-level Rails filtering cannot protect logs maintained outside Rails.
+
+## Regression checks
+
+```sh
+bin/rails test test/controllers/bots_controller_test.rb \
+  test/controllers/bots/messages_controller_test.rb test/models/user/bot_test.rb
+bin/rails test test/system/bots_test.rb
+```
diff --git a/lib/bot_requests.rb b/lib/bot_requests.rb
new file mode 100644
index 0000000..c40f59e
--- /dev/null
+++ b/lib/bot_requests.rb
@@ -0,0 +1,25 @@
+# Bot messages carry plain text even when curl supplies a form content type.
+# Prevent Rails' instrumentation (which runs before the controller) from parsing
+# or logging that text as request parameters.
+class BotRequests
+  PATH = %r{(/rooms/[^/]+/)[^/]+(/messages(?:\.[^/?]+)?/?)(?=\?|\z)}
+
+  def initialize(app)
+    @app = app
+  end
+
+  def call(env)
+    if PATH.match?(env["PATH_INFO"])
+      env["action_dispatch.request.request_parameters"] = {}
+    end
+
+    @app.call(env)
+  end
+
+  # Parameter filters alone do not redact credentials in URL path segments.
+  module FilteredPath
+    def filtered_path
+      super.sub(PATH, '\1[FILTERED]\2')
+    end
+  end
+end
diff --git a/test/controllers/bots/messages_controller_test.rb b/test/controllers/bots/messages_controller_test.rb
new file mode 100644
index 0000000..49ef4f0
--- /dev/null
+++ b/test/controllers/bots/messages_controller_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:jz))
+    @room = rooms(:hq)
+  end
+
+  test "raw curl body creates a bot-authored message and delivers it normally" do
+    body = "Deploy of v1.2.3 finished ✅ & version=123\n<plain text>"
+    assert_enqueued_with job: Room::PushMessageJob do
+      assert_difference "Message.count" do
+        post room_bot_messages_url(@room, @bot.bot_code), params: body.dup,
+          headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+      end
+    end
+    assert_response :created
+    message = Message.last
+    assert_equal @bot, message.creator
+    assert_equal body, message.plain_text_body
+    assert_equal message_path(message.id), response.headers["Location"]
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__body", text: /Deploy of v1.2.3/
+    end
+  end
+
+  test "body is literal text regardless of content type" do
+    [ "application/json", "application/x-www-form-urlencoded", "text/plain" ].each do |content_type|
+      body = "not JSON: a[]=1&a[b]=2 & 100% done <script>alert(1)</script>"
+      post room_bot_messages_url(@room, @bot.bot_code), params: body.dup, headers: { "Content-Type" => content_type }
+      assert_response :created
+      assert_equal body, Message.last.plain_text_body
+      assert_not_includes Message.last.body.to_s, "<script>"
+    end
+  end
+
+  test "credentials and raw body are not exposed in filtered request logs" do
+    post room_bot_messages_url(@room, @bot.bot_code), params: "private message"
+    assert_equal "/rooms/#{@room.id}/[FILTERED]/messages", request.filtered_path
+    assert_equal "[FILTERED]", request.filtered_parameters[:bot_code]
+    assert_empty request.request_parameters
+  end
+
+  test "closed rooms require an explicit membership" do
+    room = rooms(:watercooler)
+    post room_bot_messages_url(room, @bot.bot_code), params: "Nope"
+    assert_response :not_found
+    room.memberships.grant_to(@bot)
+    post room_bot_messages_url(room, @bot.bot_code), params: "Allowed"
+    assert_response :created
+  end
+
+  test "banned bots cannot post" do
+    @bot.banned!
+    assert_no_difference "Message.count" do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Nope"
+    end
+    assert_response :unauthorized
+  end
+
+  test "invalid UTF-8 is rejected" do
+    assert_no_difference "Message.count" do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "\xFF".b
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "bot requests need no CSRF token when forgery protection is enabled" do
+    previous = ActionController::Base.allow_forgery_protection
+    ActionController::Base.allow_forgery_protection = true
+    post room_bot_messages_url(@room, @bot.bot_code), params: "From CI"
+    assert_response :created
+  ensure
+    ActionController::Base.allow_forgery_protection = previous
+  end
+
+  test "empty requests are rejected without creating messages" do
+    [ "", " \n\t" ].each do |body|
+      assert_no_difference "Message.count" do
+        post room_bot_messages_url(@room, @bot.bot_code), params: body
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "invalid codes and revoked codes are unauthorized even with a human session" do
+    sign_in :jz
+    [ "invalid", users(:jz).id.to_s ].each do |code|
+      post room_bot_messages_url(@room, code), params: "Nope"
+      assert_response :unauthorized
+    end
+    code = @bot.bot_code
+    delete bot_url(@bot)
+    post room_bot_messages_url(@room, code), params: "Nope"
+    assert_response :unauthorized
+  end
+
+  test "unknown rooms and rooms without membership are not found" do
+    post room_bot_messages_url(0, @bot.bot_code), params: "Nope"
+    assert_response :not_found
+    @bot.memberships.delete_all
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Nope"
+    assert_response :not_found
+    @room.memberships.grant_to(@bot)
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Allowed"
+    assert_response :created
+  end
+end
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..cda00e2
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :jz
+  end
+
+  test "members can discover, create and edit bots" do
+    get edit_account_url
+    assert_select "a[aria-label='Set up chat bots'][href=?]", bots_path
+
+    get new_bot_url
+    assert_select "label", text: "Name the bot"
+    assert_difference "User.bot.count" do
+      post bots_url, params: { bot: { name: "Deploy Bot" } }
+    end
+    bot = User.bot.last
+    assert_redirected_to bots_url
+    assert_equal users(:jz), bot.creator
+    assert bot.bot_code.present?
+    assert_equal Rooms::Open.order(:id).ids, bot.rooms.opens.order(:id).ids
+
+    get bots_url
+    assert_select "li" do
+      assert_select "a", text: "Edit Deploy Bot"
+      assert_select "input[readonly][value=?]", bot.bot_code
+      assert_select "label", text: "Bot code"
+    end
+
+    patch bot_url(bot), params: { bot: { name: "Release Bot", role: "administrator", bot_code: "unsafe" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+    assert bot.bot?
+    assert_not_equal "unsafe", bot.bot_code
+  end
+
+  test "avatars can be uploaded on creation and editing" do
+    post bots_url, params: { bot: { name: "Avatar Bot", avatar: fixture_file_upload("earth.png", "image/png") } }
+    bot = User.bot.last
+    assert_redirected_to bots_url
+    assert bot.avatar.attached?
+    assert_equal "earth.png", bot.avatar.filename.to_s
+    patch bot_url(bot), params: { bot: { avatar: fixture_file_upload("moon.jpg", "image/jpeg") } }
+    assert_redirected_to bots_url
+    assert_equal "moon.jpg", bot.reload.avatar.filename.to_s
+  end
+
+  test "bot codes are not cached" do
+    get bots_url
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_select "meta[name='turbo-cache-control'][content='no-cache']"
+  end
+
+  test "administrators cannot manage people through bot endpoints" do
+    sign_in :david
+    get edit_bot_url(users(:kevin))
+    assert_response :not_found
+    delete bot_url(users(:kevin))
+    assert_response :not_found
+    assert users(:kevin).reload.active?
+  end
+
+  test "banned bots can still be managed without exposing deleted bots" do
+    bot = users(:jz).bots.create!(name: "Banned Bot", status: :banned)
+    get bots_url
+    assert_select "a", text: "Edit Banned Bot"
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    get bots_url
+    assert_select "a", text: "Edit Banned Bot", count: 0
+  end
+
+  test "name is required" do
+    assert_no_difference "User.count" do
+      post bots_url, params: { bot: { name: " " } }
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "members only manage their own bots while administrators manage all" do
+    bot = User.create!(name: "Private Bot", role: :bot, creator: users(:kevin))
+    get bots_url
+    assert_select "input[value=?]", bot.bot_code, count: 0
+    get edit_bot_url(bot)
+    assert_response :not_found
+    patch bot_url(bot), params: { bot: { name: "Stolen" } }
+    assert_response :not_found
+    delete bot_url(bot)
+    assert_response :not_found
+
+    sign_in :david
+    get bots_url
+    assert_select "input[value=?]", bot.bot_code
+    get edit_bot_url(bot)
+    assert_response :success
+    assert_select "button[data-turbo-confirm]", text: "Delete this chat bot"
+    delete bot_url(bot)
+    assert_redirected_to bots_url
+    assert bot.reload.deactivated?
+    assert_nil bot.bot_code
+  end
+end
