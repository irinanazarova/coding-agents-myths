+require "test_helper"
+
+class BotRequestsTest < ActiveSupport::TestCase
+  test "credential paths are filtered with suffixes and mount points" do
+    [ "/rooms/1/secret/messages", "/rooms/1/secret/messages/", "/rooms/1/secret/messages.json", "/chat/rooms/1/secret/messages" ].each do |path|
+      request = ActionDispatch::Request.new(Rack::MockRequest.env_for(path))
+      assert_equal path.sub("secret", "[FILTERED]"), request.filtered_path
+    end
+  end
+
+  test "ordinary room URLs are unaffected" do
+    request = ActionDispatch::Request.new(Rack::MockRequest.env_for("/rooms/1/messages"))
+    assert_equal "/rooms/1/messages", request.filtered_path
+  end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..98a53d1
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "bots have unique credentials and join existing and new open rooms" do
+    first = users(:jz).bots.create!(name: "First bot")
+    second = users(:jz).bots.create!(name: "Second bot")
+    assert first.bot?
+    assert_equal 32, first.bot_code.length
+    assert_not_equal first.bot_code, second.bot_code
+    assert_equal Rooms::Open.count, first.rooms.count
+    assert_not first.authenticate(first.bot_code)
+
+    room = Rooms::Open.create!(name: "New room", creator: users(:david))
+    assert_includes room.users, first
+    assert_includes room.users, second
+  end
+
+  test "deleting a bot revokes credentials but preserves message authorship" do
+    bot = users(:jz).bots.create!(name: "Deploy Bot")
+    message = bot.rooms.first.messages.create!(body: "Deployed", creator: bot)
+    bot.deactivate_bot
+    assert bot.deactivated?
+    assert_nil bot.bot_code
+    assert_empty bot.rooms
+    assert_equal "Deploy Bot", message.reload.creator.name
+  end
+end
