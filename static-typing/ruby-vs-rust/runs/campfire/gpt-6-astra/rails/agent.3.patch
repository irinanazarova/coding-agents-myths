diff --git a/test/models/room/bot_join_test.rb b/test/models/room/bot_join_test.rb
new file mode 100644
index 0000000..5bb1427
--- /dev/null
+++ b/test/models/room/bot_join_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Room::BotJoinTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:david).bots.create!(name: "Room Bot", webhook_url: "https://example.com/joined")
+    @room = rooms(:hq)
+  end
+
+  test "manual grants enqueue exactly once per room" do
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      @room.memberships.grant_to([ @bot, @bot ])
+      @room.memberships.grant_to(@bot)
+    end
+    assert_enqueued_with job: Room::BotJoinJob, args: [ @room.bot_joins.find_by!(bot: @bot) ]
+
+    assert_no_enqueued_jobs only: Room::BotJoinJob do
+      @room.memberships.revoke_from(@bot)
+      @room.memberships.grant_to(@bot)
+      @room.memberships.find_by!(user: @bot).update!(involvement: :everything)
+    end
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      rooms(:watercooler).memberships.grant_to(@bot)
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "direct membership creation also records a join" do
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      Membership.create!(room: @room, user: @bot)
+    end
+  end
+
+  test "room creation with an opted-in bot does not notify twice" do
+    @bot.update!(add_to_all_open_rooms: true)
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      Rooms::Open.create_for({ name: "Both paths", creator: users(:david) }, users: [ @bot, users(:david) ])
+    end
+  end
+
+  test "direct conversations and human memberships never record joins" do
+    assert_no_difference "Room::BotJoin.count" do
+      assert_no_enqueued_jobs only: Room::BotJoinJob do
+        Rooms::Direct.create_for({ creator: users(:david) }, users: [ @bot, users(:david) ])
+        @room.memberships.grant_to(users(:david))
+      end
+    end
+  end
+
+  test "rolled back memberships do not enqueue greetings" do
+    assert_no_difference "Room::BotJoin.count" do
+      assert_no_enqueued_jobs only: Room::BotJoinJob do
+        Membership.transaction do
+          @room.memberships.grant_to(@bot)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+    assert_not_includes @room.users, @bot
+  end
+
+  test "bots without webhooks do not enqueue greetings" do
+    @bot.update!(webhook_url: nil)
+    assert_no_enqueued_jobs only: Room::BotJoinJob do
+      @room.memberships.grant_to(@bot)
+    end
+  end
+end
