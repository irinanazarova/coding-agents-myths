diff --git a/app/models/user/bot_webhook.rb b/app/models/user/bot_webhook.rb
new file mode 100644
index 0000000..5b17301
--- /dev/null
+++ b/app/models/user/bot_webhook.rb
@@ -0,0 +1,69 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class User::BotWebhook
+  include Rails.application.routes.url_helpers
+
+  MAX_RESPONSE_SIZE = 1.megabyte
+
+  attr_reader :room, :bot
+
+  def initialize(room:, bot:)
+    @room, @bot = room, bot
+  end
+
+  def deliver
+    return unless deliverable?
+
+    url = URI.parse(bot.webhook_url)
+    ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.host)
+    request = Net::HTTP::Post.new(url, "Content-Type" => "application/json")
+    request.body = payload.to_json
+
+    # Pin the checked address and disable proxies and redirects: the payload
+    # contains a posting credential and must only reach the configured host.
+    Net::HTTP.start(url.host, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+      open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
+      http.request(request) do |response|
+        if response.is_a?(Net::HTTPOK) && response.content_type.in?(%w[ text/plain text/html ])
+          post_reply(response_body(response), html: response.content_type == "text/html")
+        end
+      end
+    end
+  rescue RestrictedHTTP::Violation, Surfguard::Unresolvable, Resolv::ResolvError,
+    URI::InvalidURIError, SocketError, SystemCallError, Timeout::Error,
+    OpenSSL::SSL::SSLError, EOFError, Net::HTTPBadResponse, Net::ProtocolError => error
+    # Do not log the URL, response, or payload; they can contain credentials.
+    Rails.logger.warn "Bot webhook failed for bot #{bot.id}, room #{room.id}: #{error.class}"
+  end
+
+  private
+    def deliverable?
+      bot.bot? && bot.active? && bot.webhook_url.present? && bot.bot_code.present? &&
+        room.users.exists?(bot.id)
+    end
+
+    def room_payload
+      { id: room.id, name: room.name, reply_to: room_bot_messages_path(room, bot.bot_code) }
+    end
+
+    def response_body(response)
+      return if response.content_length.to_i > MAX_RESPONSE_SIZE
+
+      body = +""
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_RESPONSE_SIZE
+        body << chunk
+      end
+      body.force_encoding(Encoding::UTF_8)
+      body if body.valid_encoding?
+    end
+
+    def post_reply(body, html:)
+      return if body.blank?
+      return unless bot.reload && deliverable?
+
+      body = ERB::Util.html_escape(body).gsub(/\r?\n/, "<br>") unless html
+      room.messages.create!(body: body, creator: bot).broadcast_create
+    end
+end
