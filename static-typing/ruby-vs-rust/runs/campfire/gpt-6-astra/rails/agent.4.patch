index ac27884..d6b4f4a 100644
--- a/docs/bots.md
+++ b/docs/bots.md
@@ -161,3 +161,25 @@ promise successful exactly-once delivery over an unreliable network.
 bin/rails test test/models/user/bot_test.rb test/models/room/bot_join_test.rb \
   test/jobs/room/bot_join_job_test.rb test/controllers/rooms/opens_controller_test.rb
 ```
+
+## Bots per member
+
+Administrators can set **Bots per member** in Account settings. The default is
+5, including for existing accounts without this JSON setting. Zero disables new
+member-owned bots; administrators are exempt. The limit counts each creator's
+non-deactivated bots (including banned bots), not everyone else's bots. Deleting
+a bot frees a slot.
+
+Lowering the limit never removes bots or prevents editing/deleting them. The
+bots page hides **Add a chat bot** at or above the limit. The new-bot route also
+refuses access, and creation validation rejects direct submissions or stale
+forms. The setting is stored with the existing typed account settings, so no
+migration is required.
+
+Regression checks for limits:
+
+```sh
+bin/rails test test/models/user/bot_limit_test.rb test/models/account_test.rb \
+  test/controllers/accounts_controller_test.rb test/controllers/bots_controller_test.rb
+bin/rails test test/system/bots_test.rb
+```
diff --git a/test/controllers/accounts_controller_test.rb b/test/controllers/accounts_controller_test.rb
index 8292c6f..2678b2c 100644
--- a/test/controllers/accounts_controller_test.rb
+++ b/test/controllers/accounts_controller_test.rb
@@ -58,4 +58,30 @@ class AccountsControllerTest < ActionDispatch::IntegrationTest
     put account_url, params: { account: { name: "Different" } }
     assert_response :forbidden
   end
+
+  test "administrators can set bots per member" do
+    get edit_account_url
+    assert_select "label[for='account_settings_bots_per_member']", text: "Bots per member"
+    assert_select "input[type='number'][name='account[settings][bots_per_member]'][value='5']"
+
+    patch account_url, params: { account: { settings: { bots_per_member: "2" } } }
+    assert_redirected_to edit_account_url
+    assert_equal 2, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "invalid bot limits render an error without changing the limit" do
+    patch account_url, params: { account: { settings: { bots_per_member: "-1" } } }
+    assert_response :unprocessable_entity
+    assert_select "[role='alert']", text: /Bots per member/
+    assert_equal 5, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "members cannot see or change the bot limit setting" do
+    sign_in :jz
+    get edit_account_url
+    assert_select "input[name='account[settings][bots_per_member]']", count: 0
+    patch account_url, params: { account: { settings: { bots_per_member: "100" } } }
+    assert_response :forbidden
+    assert_equal 5, accounts(:signal).reload.settings.bots_per_member
+  end
 end
