diff --git a/test/models/user/bot_limit_test.rb b/test/models/user/bot_limit_test.rb
new file mode 100644
index 0000000..2f47e58
--- /dev/null
+++ b/test/models/user/bot_limit_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class User::BotLimitTest < ActiveSupport::TestCase
+  test "members can create five bots by default but not a sixth" do
+    member = users(:jz)
+    5.times { |index| member.bots.create!(name: "Bot #{index}") }
+
+    assert_no_difference "User.bot.count" do
+      bot = member.bots.create(name: "One too many")
+      assert_not bot.persisted?
+      assert_match "reached the limit", bot.errors.full_messages.to_sentence
+    end
+  end
+
+  test "accounts default to five bots per member" do
+    assert_equal 5, accounts(:signal).settings.bots_per_member
+  end
+
+  test "deleted bots free capacity but banned bots still count" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    member = users(:jz)
+    bot = member.bots.create!(name: "Bot", status: :banned)
+    assert_not member.can_create_bot?
+
+    bot.deactivate_bot
+    assert member.can_create_bot?
+    assert member.bots.create!(name: "Replacement").persisted?
+  end
+
+  test "the limit applies to each owner independently" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    users(:jz).bots.create!(name: "JZ's bot")
+    assert users(:kevin).bots.create!(name: "Kevin's bot").persisted?
+  end
+
+  test "lowering the limit preserves existing bots and only blocks creation" do
+    member = users(:jz)
+    bots = 2.times.map { |index| member.bots.create!(name: "Bot #{index}") }
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    assert_equal 2, member.bots.where.not(status: :deactivated).count
+    assert_not member.can_create_bot?
+    assert bots.first.update(name: "Renamed")
+    assert_not member.bots.create(name: "Blocked").persisted?
+
+    bots.first.deactivate_bot
+    assert_not member.can_create_bot?
+    bots.last.deactivate_bot
+    assert member.can_create_bot?
+  end
+
+  test "zero blocks members but administrators remain unlimited" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert_not users(:jz).can_create_bot?
+    assert_not users(:jz).bots.create(name: "Blocked").persisted?
+    assert users(:david).can_create_bot?
+    6.times { |index| assert users(:david).bots.create!(name: "Admin bot #{index}").persisted? }
+  end
+end
