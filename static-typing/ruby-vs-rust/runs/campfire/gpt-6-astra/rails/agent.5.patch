@@ -0,0 +1,153 @@
+require "test_helper"
+
+class User::Bot::SafeguardsTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Noisy Bot", webhook_url: "https://example.com/bot")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    @webhook = Room::BotWebhook.new(room: @room, bot: @bot)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).returns("93.184.215.14")
+  end
+
+  test "the rolling window expires messages individually" do
+    freeze_time do
+      5.times { assert_kind_of Message, post_message }
+      travel 5.seconds
+      5.times { assert_kind_of Message, post_message }
+      travel 5.seconds
+      5.times { assert_kind_of Message, post_message }
+      assert_equal :cooldown, post_message
+      assert_equal 30, @bot.bot_retry_after
+    end
+  end
+
+  test "retry after rounds up and removing messages cannot bypass the window" do
+    freeze_time do
+      10.times { post_message }
+      @bot.messages.destroy_all
+      assert_equal :cooldown, post_message
+      @bot.update!(bot_cooldown_until: 0.2.seconds.from_now)
+      assert_equal 1, @bot.bot_retry_after
+    end
+  end
+
+  test "mention and join webhooks share a failure streak and stop when suspended" do
+    message = @room.messages.create!(creator: users(:jz), body: "Hello bot")
+    mention = Message::BotWebhook.new(message: message, bot: User.find(@bot.id))
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 500)
+    5.times do
+      @webhook.deliver
+      mention.deliver
+    end
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+    @webhook.deliver
+    mention.deliver
+    assert_requested request, times: 10
+  end
+
+  test "cooldown violations reset when the cooldown expires" do
+    freeze_time do
+      10.times { post_message }
+      assert_equal :cooldown, post_message
+      4.times { assert_equal :cooldown, post_message }
+      travel 30.seconds
+      10.times { assert_kind_of Message, post_message }
+      assert_equal :cooldown, post_message
+      assert_equal 0, @bot.bot_cooldown_attempts
+      assert_equal :cooldown, post_message
+      assert_equal 1, @bot.bot_cooldown_attempts
+      assert @bot.active?
+    end
+  end
+
+  test "separate instances share posting state and other bots have their own limit" do
+    freeze_time do
+      10.times { post_message }
+      copy = User.find(@bot.id)
+      assert_equal :cooldown, copy.with_bot_posting_permission { flunk "must not post" }
+      other_bot = users(:jz).bots.create!(name: "Quiet Bot")
+      assert_nil other_bot.with_bot_posting_permission { nil }
+      assert_empty other_bot.reload.bot_message_timestamps
+    end
+  end
+
+  test "all non 2xx responses, timeouts and connection errors count as failures" do
+    [ 301, 400, 429, 500 ].each do |status|
+      stub_request(:post, @bot.webhook_url).to_return(status: status)
+      @webhook.deliver
+    end
+    stub_request(:post, @bot.webhook_url).to_timeout
+    @webhook.deliver
+    stub_request(:post, @bot.webhook_url).to_raise(Errno::ECONNREFUSED)
+    @webhook.deliver
+    assert_equal 6, @bot.reload.bot_webhook_failures
+  end
+
+  test "any 2xx resets consecutive failures even without a usable reply" do
+    [ 200, 201, 204, 299 ].each do |status|
+      @bot.update!(bot_webhook_failures: 9)
+      stub_request(:post, @bot.webhook_url).to_return(status: status)
+      assert_no_difference "Message.count" do
+        @webhook.deliver
+      end
+      assert_equal 0, @bot.reload.bot_webhook_failures
+      assert @bot.active?
+    end
+    stub_request(:post, @bot.webhook_url).to_return(status: 503)
+    9.times { @webhook.deliver }
+    assert @bot.reload.active?
+    @webhook.deliver
+    assert @bot.reload.suspended?
+  end
+
+  test "stale webhook instances recheck suspension before sending" do
+    User.find(@bot.id).update!(status: :suspended, bot_suspension_reason: "Flooding")
+    @webhook.deliver
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "an in flight success cannot reactivate or post for a suspended bot" do
+    stub_request(:post, @bot.webhook_url).to_return do
+      User.find(@bot.id).update!(status: :suspended, bot_suspension_reason: "Flooding")
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Too late" }
+    end
+    assert_no_difference "Message.count" do
+      @webhook.deliver
+    end
+    assert @bot.reload.suspended?
+  end
+
+  test "reactivation clears all safeguard state but preserves credentials and rooms" do
+    @bot.update!(status: :suspended, bot_suspension_reason: "Flooding", bot_webhook_failures: 9,
+      bot_cooldown_attempts: 5, bot_cooldown_until: 30.seconds.from_now, bot_message_timestamps: [ Time.current.to_f ])
+    code, rooms = @bot.bot_code, @bot.room_ids
+    @bot.reactivate_bot
+    assert @bot.reload.active?
+    assert_nil @bot.bot_suspension_reason
+    assert_nil @bot.bot_cooldown_until
+    assert_empty @bot.bot_message_timestamps
+    assert_equal 0, @bot.bot_cooldown_attempts
+    assert_equal 0, @bot.bot_webhook_failures
+    assert_equal code, @bot.bot_code
+    assert_equal rooms, @bot.room_ids
+    assert_kind_of Message, post_message
+  end
+
+  test "reactivation cannot clear an active bots cooldown or undo deletion or a ban" do
+    @bot.update!(bot_cooldown_until: 30.seconds.from_now)
+    @bot.reactivate_bot
+    assert @bot.reload.bot_cooldown_until
+    @bot.banned!
+    @bot.reactivate_bot
+    assert @bot.reload.banned?
+    @bot.deactivate_bot
+    @bot.reactivate_bot
+    assert @bot.reload.deactivated?
+  end
+
+  private
+    def post_message
+      @bot.with_bot_posting_permission { @room.messages.create!(creator: @bot, body: "Hi") }
+    end
+end
