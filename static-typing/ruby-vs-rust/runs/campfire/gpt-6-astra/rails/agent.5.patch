+require "test_helper"
+
+class Bots::ReactivationsTest < ActionDispatch::IntegrationTest
+  setup do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    @bot = users(:jz).bots.create!(name: "Suspended Bot", status: :suspended,
+      bot_suspension_reason: "Failing webhooks: ten consecutive failed deliveries", bot_webhook_failures: 10)
+  end
+
+  test "owners see suspended bots and their reason but cannot reactivate them" do
+    sign_in :jz
+    get bots_url
+    assert_select "[role=status]", text: /Suspended.*Failing webhooks/
+    assert_select "button", text: "Reactivate", count: 0
+    assert_select "a", text: "Add a chat bot", count: 0
+    assert_not users(:jz).can_create_bot?
+
+    post reactivate_bot_url(@bot)
+    assert_response :forbidden
+    patch bot_url(@bot), params: { bot: { status: "active", bot_webhook_failures: 0, bot_suspension_reason: "" } }
+    assert_redirected_to bots_url
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+
+    sign_in :kevin
+    post reactivate_bot_url(@bot)
+    assert_response :forbidden
+  end
+
+  test "administrators can reactivate from the bots page with confirmation" do
+    sign_in :david
+    get bots_url
+    assert_select "button[data-turbo-confirm]", text: "Reactivate"
+    post reactivate_bot_url(@bot)
+    assert_redirected_to bots_url
+    assert @bot.reload.active?
+    assert_nil @bot.bot_suspension_reason
+    assert_equal 0, @bot.bot_webhook_failures
+    get bots_url
+    assert_select "button", text: "Reactivate", count: 0
+  end
+
+  test "reactivation does not accept people or deleted bots" do
+    sign_in :david
+    post reactivate_bot_url(users(:jz))
+    assert_response :not_found
+    @bot.deactivate_bot
+    post reactivate_bot_url(@bot)
+    assert_response :not_found
+    assert @bot.reload.deactivated?
+  end
+end
