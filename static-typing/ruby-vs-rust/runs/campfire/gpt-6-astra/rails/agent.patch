index 0000000..bdfa7ce
--- /dev/null
+++ b/test/controllers/bots/safeguards_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Bots::SafeguardsTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:jz).bots.create!(name: "Noisy Bot", webhook_url: "https://example.com/bot")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).returns("93.184.215.14")
+  end
+
+  test "ten posts are accepted and the eleventh starts a thirty second cooldown" do
+    freeze_time do
+      10.times { post_message; assert_response :created }
+      assert_no_difference "Message.count" do
+        post_message
+        assert_response :too_many_requests
+        assert_equal "30", response.headers["Retry-After"]
+        travel 12.seconds
+        post_message
+        assert_response :too_many_requests
+        assert_equal "18", response.headers["Retry-After"]
+      end
+      travel 18.seconds
+      post_message
+      assert_response :created
+    end
+  end
+
+  test "five further attempts suspend the bot and preserve its data" do
+    freeze_time do
+      11.times { post_message }
+      4.times { post_message; assert_response :too_many_requests }
+      memberships = @bot.membership_ids
+      messages = @bot.messages.ids
+      post_message
+      assert_response :forbidden
+      assert @bot.reload.suspended?
+      assert_match /flood/i, @bot.bot_suspension_reason
+      assert_equal memberships, @bot.membership_ids
+      assert_equal messages, @bot.messages.ids
+      travel 1.day
+      post_message
+      assert_response :forbidden
+    end
+  end
+
+  test "webhook replies and API posts share a bot wide limit across rooms" do
+    freeze_time do
+      9.times { post_message }
+      other_room = rooms(:watercooler)
+      other_room.memberships.grant_to(@bot)
+      webhook = Room::BotWebhook.new(room: other_room, bot: @bot)
+      stub_request(:post, @bot.webhook_url).to_return(status: 200,
+        headers: { "Content-Type" => "text/plain" }, body: "Reply")
+      assert_difference "Message.count", 1 do
+        webhook.deliver
+      end
+      post_message
+      assert_response :too_many_requests
+      assert_no_difference "Message.count" do
+        5.times { webhook.deliver }
+      end
+      assert @bot.reload.suspended?
+    end
+  end
+
+  test "ten consecutive failed webhooks suspend and stop further deliveries" do
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 500)
+    webhook = Room::BotWebhook.new(room: @room, bot: @bot)
+    9.times { webhook.deliver }
+    assert @bot.reload.active?
+    webhook.deliver
+    assert @bot.reload.suspended?
+    assert_match /webhook/i, @bot.bot_suspension_reason
+    webhook.deliver
+    assert_requested request, times: 10
+    post_message
+    assert_response :forbidden
+  end
+
+  private
+    def post_message
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Hello", headers: { "Content-Type" => "text/plain" }
+    end
+end
