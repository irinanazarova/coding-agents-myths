diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..ae0af28
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,63 @@
+module User::Bot
+  extend ActiveSupport::Concern
+  include Safeguards
+
+  included do
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, -> { bot }, class_name: "User", foreign_key: :creator_id, dependent: :nullify
+
+    has_many :bot_room_joins, class_name: "Room::BotJoin", foreign_key: :bot_id, dependent: :delete_all
+
+    scope :automatically_joining_open_rooms, -> { where.not(role: :bot).or(where(role: :bot, add_to_all_open_rooms: true)) }
+
+    after_save_commit :join_all_open_rooms, if: :bot?
+
+    normalizes :webhook_url, with: ->(url) { url.strip.presence }
+    validate :webhook_url_is_http, if: :bot?
+
+    validates :name, presence: true, if: :bot?
+    validate :creator_has_bot_capacity, on: :create, if: :bot?
+    before_validation :set_bot_credentials, on: :create, if: :bot?
+  end
+
+  def can_create_bot?
+    administrator? || bots.where.not(status: :deactivated).count < Current.account.settings.bots_per_member
+  end
+
+  def deactivate_bot
+    transaction do
+      deactivate
+      memberships.delete_all
+      update! bot_code: nil
+    end
+  end
+
+  private
+    def creator_has_bot_capacity
+      if creator && !creator.can_create_bot?
+        errors.add :base, "You’ve reached the limit of bots per member"
+      end
+    end
+
+    def join_all_open_rooms
+      if active? && add_to_all_open_rooms? && saved_change_to_add_to_all_open_rooms?
+        grant_membership_to_open_rooms
+      end
+    end
+
+    def webhook_url_is_http
+      if webhook_url.present?
+        url = URI.parse(webhook_url)
+        unless url.is_a?(URI::HTTP) && url.host.present? && url.userinfo.nil? && url.fragment.nil?
+          errors.add :webhook_url, "must be an HTTP or HTTPS URL without credentials or a fragment"
+        end
+      end
+    rescue URI::InvalidURIError
+      errors.add :webhook_url, "must be an HTTP or HTTPS URL"
+    end
+
+    def set_bot_credentials
+      self.bot_code ||= SecureRandom.base58(32)
+      self.password = SecureRandom.base58(32) unless password_digest?
+    end
+end
diff --git a/app/models/user/bot/safeguards.rb b/app/models/user/bot/safeguards.rb
new file mode 100644
index 0000000..03a3451
--- /dev/null
+++ b/app/models/user/bot/safeguards.rb
@@ -0,0 +1,70 @@
+module User::Bot::Safeguards
+  extend ActiveSupport::Concern
+
+  MESSAGE_LIMIT = 10
+  MESSAGE_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_ATTEMPT_LIMIT = 5
+  WEBHOOK_FAILURE_LIMIT = 10
+
+  # Keep the permission check and message creation in one transaction. The
+  # bounded timestamp list survives message deletion and is shared by all rooms.
+  def with_bot_posting_permission
+    with_lock do
+      return :forbidden unless bot? && active?
+
+      now = Time.current
+      if bot_cooldown_until && bot_cooldown_until > now
+        self.bot_cooldown_attempts += 1
+        suspend_bot_for "Flooding: five posting attempts during cooldown" if bot_cooldown_attempts >= COOLDOWN_ATTEMPT_LIMIT
+        save!
+        suspended? ? :forbidden : :cooldown
+      else
+        self.bot_cooldown_until = nil
+        self.bot_cooldown_attempts = 0
+        self.bot_message_timestamps = bot_message_timestamps.select { |timestamp| timestamp > (now - MESSAGE_WINDOW).to_f }
+
+        if bot_message_timestamps.size >= MESSAGE_LIMIT
+          self.bot_cooldown_until = now + COOLDOWN
+          save!
+          :cooldown
+        else
+          message = yield
+          self.bot_message_timestamps += [ now.to_f ] if message
+          save!
+          message
+        end
+      end
+    end
+  end
+
+  def bot_retry_after
+    [ (bot_cooldown_until - Time.current).ceil, 1 ].max
+  end
+
+  def record_bot_webhook_delivery(success:)
+    with_lock do
+      return unless bot? && active?
+
+      self.bot_webhook_failures = success ? 0 : bot_webhook_failures + 1
+      suspend_bot_for "Failing webhooks: ten consecutive failed deliveries" if bot_webhook_failures >= WEBHOOK_FAILURE_LIMIT
+      save!
+    end
+  end
+
+  def reactivate_bot
+    with_lock do
+      if bot? && suspended?
+        update! status: :active, bot_suspension_reason: nil,
+          bot_message_timestamps: [], bot_cooldown_until: nil,
+          bot_cooldown_attempts: 0, bot_webhook_failures: 0
+      end
+    end
+  end
+
+  private
+    def suspend_bot_for(reason)
+      self.status = :suspended
+      self.bot_suspension_reason = reason
+    end
+end
diff --git a/app/models/user/bot_webhook.rb b/app/models/user/bot_webhook.rb
new file mode 100644
index 0000000..8cef553
--- /dev/null
+++ b/app/models/user/bot_webhook.rb
@@ -0,0 +1,78 @@
+require "net/http"
+require "restricted_http/private_network_guard"
+
+class User::BotWebhook
+  include Rails.application.routes.url_helpers
+
+  MAX_RESPONSE_SIZE = 1.megabyte
+
+  attr_reader :room, :bot
+
+  def initialize(room:, bot:)
+    @room, @bot = room, bot
+  end
+
+  def deliver
+    return unless bot.reload && deliverable?
+
+    url = URI.parse(bot.webhook_url)
+    ip = RestrictedHTTP::PrivateNetworkGuard.resolve(url.host)
+    request = Net::HTTP::Post.new(url, "Content-Type" => "application/json")
+    request.body = payload.to_json
+
+    # Pin the checked address and disable proxies and redirects: the payload
+    # contains a posting credential and must only reach the configured host.
+    success, body, html = false, nil, false
+    Net::HTTP.start(url.host, url.port, nil, ipaddr: ip, use_ssl: url.scheme == "https",
+      open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
+      http.request(request) do |response|
+        success = response.is_a?(Net::HTTPSuccess)
+        if response.is_a?(Net::HTTPOK) && response.content_type.in?(%w[ text/plain text/html ])
+          body = response_body(response)
+          html = response.content_type == "text/html"
+        end
+      end
+    end
+    bot.record_bot_webhook_delivery(success: success)
+    post_reply(body, html: html) if success
+  rescue RestrictedHTTP::Violation, Surfguard::Unresolvable, Resolv::ResolvError,
+    URI::InvalidURIError, SocketError, SystemCallError, Timeout::Error,
+    OpenSSL::SSL::SSLError, EOFError, Net::HTTPBadResponse, Net::ProtocolError => error
+    bot.record_bot_webhook_delivery(success: false)
+    # Do not log the URL, response, or payload; they can contain credentials.
+    Rails.logger.warn "Bot webhook failed for bot #{bot.id}, room #{room.id}: #{error.class}"
+  end
+
+  private
+    def deliverable?
+      bot.bot? && bot.active? && bot.webhook_url.present? && bot.bot_code.present? &&
+        room.users.exists?(bot.id)
+    end
+
+    def room_payload
+      { id: room.id, name: room.name, reply_to: room_bot_messages_path(room, bot.bot_code) }
+    end
+
+    def response_body(response)
+      return if response.content_length.to_i > MAX_RESPONSE_SIZE
+
+      body = +""
+      response.read_body do |chunk|
+        return if body.bytesize + chunk.bytesize > MAX_RESPONSE_SIZE
+        body << chunk
+      end
+      body.force_encoding(Encoding::UTF_8)
+      body if body.valid_encoding?
+    end
+
+    def post_reply(body, html:)
+      return if body.blank?
+      return unless bot.reload && deliverable?
+
+      body = ERB::Util.html_escape(body).gsub(/\r?\n/, "<br>") unless html
+      result = bot.with_bot_posting_permission do
+        room.messages.create!(body: body, creator: bot) if deliverable?
+      end
+      result.broadcast_create if result.is_a?(Message)
+    end
+end
