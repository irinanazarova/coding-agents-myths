diff --git a/test/models/message/bot_webhook_test.rb b/test/models/message/bot_webhook_test.rb
new file mode 100644
index 0000000..fe7ab90
--- /dev/null
+++ b/test/models/message/bot_webhook_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Message::BotWebhookTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/mention")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    @message = @room.messages.create!(creator: users(:david), body: "<div>#{mention(@bot)} restart the build please</div>")
+    @webhook = Message::BotWebhook.new(message: @message, bot: @bot)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("example.com").returns("93.184.215.14")
+  end
+
+  test "posts a JSON mention event with the bot's posting URL and a deep link" do
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal "mention", payload["event"]
+      assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+      assert_equal({ "id" => @room.id, "name" => @room.name,
+        "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages" }, payload["room"])
+      assert_equal @message.id, payload["message"]["id"]
+      assert_equal "restart the build please", payload["message"]["body"]["text"]
+      assert_equal @message.body.to_s, payload["message"]["body"]["html"]
+      assert_equal "/rooms/#{@room.id}/@#{@message.id}", payload["message"]["link"]
+      true
+    end.to_return(status: 204)
+
+    assert_no_difference "Message.count" do
+      @webhook.deliver
+    end
+    assert_requested request
+  end
+
+  test "removes only this bot's mention attachments without modifying the original rich text" do
+    other = users(:david).bots.create!(name: "Deploy Bot")
+    body = "<div>#{mention(@bot)} ask #{mention(other)} and #{mention_attachment_for(:jason)} about @Deploy Bot #{mention(@bot)}</div>"
+    @message.update!(body: body)
+    original = @message.body.to_s
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      text = JSON.parse(request.body).dig("message", "body", "text")
+      assert_equal "ask @Deploy Bot and @Jason about @Deploy Bot", text
+      true
+    end.to_return(status: 204)
+
+    @webhook.deliver
+    assert_requested request
+    assert_equal original, @message.reload.body.to_s
+  end
+
+  test "plain text replies are escaped, retain line breaks, and broadcast as the bot" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "<b>Done</b>\nNext ✅")
+    Message.any_instance.expects(:broadcast_create).once
+
+    assert_difference "Message.count", 1 do
+      @webhook.deliver
+    end
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "<b>Done</b>\nNext ✅", reply.plain_text_body
+    assert_includes reply.body.to_s, "&lt;b&gt;Done&lt;/b&gt;"
+  end
+
+  test "HTML replies preserve rich text and are sanitized for display" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/html; charset=utf-8" }, body: "<div><strong>Done</strong><script>alert(1)</script></div>")
+
+    assert_difference "Message.count", 1 do
+      @webhook.deliver
+    end
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.to_s, "<strong>Done</strong>"
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "ignores no-content, errors, redirects, unsupported types and blank replies" do
+    [ [ 204, "text/plain", "" ], [ 500, "text/plain", "Failure" ],
+      [ 302, "text/plain", "Moved" ], [ 201, "text/plain", "Created" ],
+      [ 200, "application/json", '{"ok":true}' ], [ 200, nil, "No type" ],
+      [ 200, "text/plain", " \n " ] ].each do |status, type, body|
+      stub_request(:post, @bot.webhook_url).to_return(status: status,
+        headers: { "Content-Type" => type, "Location" => "https://elsewhere.example/" }.compact, body: body)
+      assert_no_difference "Message.count" do
+        @webhook.deliver
+      end
+    end
+  end
+
+  test "timeouts and unreachable endpoints do not create messages" do
+    request = stub_request(:post, @bot.webhook_url).to_timeout
+    assert_no_difference "Message.count" do
+      @webhook.deliver
+    end
+    assert_requested request
+  end
+
+  test "private addresses are blocked before sending the payload" do
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).raises(RestrictedHTTP::Violation)
+    assert_no_difference "Message.count" do
+      @webhook.deliver
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "oversized and invalid UTF-8 replies are ignored" do
+    [ "x" * (Message::BotWebhook::MAX_RESPONSE_SIZE + 1), "\xFF".b ].each do |body|
+      stub_request(:post, @bot.webhook_url).to_return(status: 200,
+        headers: { "Content-Type" => "text/plain" }, body: body)
+      assert_no_difference "Message.count" do
+        @webhook.deliver
+      end
+    end
+  end
+
+  test "does not deliver if the bot lost room access or was disabled before the job ran" do
+    @room.memberships.revoke_from(@bot)
+    @webhook.deliver
+    @room.memberships.grant_to(@bot)
+    @bot.update!(status: :banned)
+    @webhook.deliver
+    @bot.update!(status: :active, webhook_url: nil)
+    @webhook.deliver
+    assert_not_requested :post, "https://example.com/mention"
+  end
+
+  private
+    def mention(bot)
+      %(<action-text-attachment sgid="#{bot.attachable_sgid}"></action-text-attachment>)
+    end
+end
diff --git a/test/models/room/bot_join_test.rb b/test/models/room/bot_join_test.rb
new file mode 100644
index 0000000..5bb1427
--- /dev/null
+++ b/test/models/room/bot_join_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Room::BotJoinTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:david).bots.create!(name: "Room Bot", webhook_url: "https://example.com/joined")
+    @room = rooms(:hq)
+  end
+
+  test "manual grants enqueue exactly once per room" do
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      @room.memberships.grant_to([ @bot, @bot ])
+      @room.memberships.grant_to(@bot)
+    end
+    assert_enqueued_with job: Room::BotJoinJob, args: [ @room.bot_joins.find_by!(bot: @bot) ]
+
+    assert_no_enqueued_jobs only: Room::BotJoinJob do
+      @room.memberships.revoke_from(@bot)
+      @room.memberships.grant_to(@bot)
+      @room.memberships.find_by!(user: @bot).update!(involvement: :everything)
+    end
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      rooms(:watercooler).memberships.grant_to(@bot)
+    end
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "direct membership creation also records a join" do
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      Membership.create!(room: @room, user: @bot)
+    end
+  end
+
+  test "room creation with an opted-in bot does not notify twice" do
+    @bot.update!(add_to_all_open_rooms: true)
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      Rooms::Open.create_for({ name: "Both paths", creator: users(:david) }, users: [ @bot, users(:david) ])
+    end
+  end
+
+  test "direct conversations and human memberships never record joins" do
+    assert_no_difference "Room::BotJoin.count" do
+      assert_no_enqueued_jobs only: Room::BotJoinJob do
+        Rooms::Direct.create_for({ creator: users(:david) }, users: [ @bot, users(:david) ])
+        @room.memberships.grant_to(users(:david))
+      end
+    end
+  end
+
+  test "rolled back memberships do not enqueue greetings" do
+    assert_no_difference "Room::BotJoin.count" do
+      assert_no_enqueued_jobs only: Room::BotJoinJob do
+        Membership.transaction do
+          @room.memberships.grant_to(@bot)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+    assert_not_includes @room.users, @bot
+  end
+
+  test "bots without webhooks do not enqueue greetings" do
+    @bot.update!(webhook_url: nil)
+    assert_no_enqueued_jobs only: Room::BotJoinJob do
+      @room.memberships.grant_to(@bot)
+    end
+  end
+end
diff --git a/test/models/user/bot/safeguards_test.rb b/test/models/user/bot/safeguards_test.rb
new file mode 100644
index 0000000..ff702a9
--- /dev/null
+++ b/test/models/user/bot/safeguards_test.rb
@@ -0,0 +1,153 @@
+require "test_helper"
+
+class User::Bot::SafeguardsTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:jz).bots.create!(name: "Noisy Bot", webhook_url: "https://example.com/bot")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+    @webhook = Room::BotWebhook.new(room: @room, bot: @bot)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).returns("93.184.215.14")
+  end
+
+  test "the rolling window expires messages individually" do
+    freeze_time do
+      5.times { assert_kind_of Message, post_message }
+      travel 5.seconds
+      5.times { assert_kind_of Message, post_message }
+      travel 5.seconds
+      5.times { assert_kind_of Message, post_message }
+      assert_equal :cooldown, post_message
+      assert_equal 30, @bot.bot_retry_after
+    end
+  end
+
+  test "retry after rounds up and removing messages cannot bypass the window" do
+    freeze_time do
+      10.times { post_message }
+      @bot.messages.destroy_all
+      assert_equal :cooldown, post_message
+      @bot.update!(bot_cooldown_until: 0.2.seconds.from_now)
+      assert_equal 1, @bot.bot_retry_after
+    end
+  end
+
+  test "mention and join webhooks share a failure streak and stop when suspended" do
+    message = @room.messages.create!(creator: users(:jz), body: "Hello bot")
+    mention = Message::BotWebhook.new(message: message, bot: User.find(@bot.id))
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 500)
+    5.times do
+      @webhook.deliver
+      mention.deliver
+    end
+    assert @bot.reload.suspended?
+    assert_equal 10, @bot.bot_webhook_failures
+    @webhook.deliver
+    mention.deliver
+    assert_requested request, times: 10
+  end
+
+  test "cooldown violations reset when the cooldown expires" do
+    freeze_time do
+      10.times { post_message }
+      assert_equal :cooldown, post_message
+      4.times { assert_equal :cooldown, post_message }
+      travel 30.seconds
+      10.times { assert_kind_of Message, post_message }
+      assert_equal :cooldown, post_message
+      assert_equal 0, @bot.bot_cooldown_attempts
+      assert_equal :cooldown, post_message
+      assert_equal 1, @bot.bot_cooldown_attempts
+      assert @bot.active?
+    end
+  end
+
+  test "separate instances share posting state and other bots have their own limit" do
+    freeze_time do
+      10.times { post_message }
+      copy = User.find(@bot.id)
+      assert_equal :cooldown, copy.with_bot_posting_permission { flunk "must not post" }
+      other_bot = users(:jz).bots.create!(name: "Quiet Bot")
+      assert_nil other_bot.with_bot_posting_permission { nil }
+      assert_empty other_bot.reload.bot_message_timestamps
+    end
+  end
+
+  test "all non 2xx responses, timeouts and connection errors count as failures" do
+    [ 301, 400, 429, 500 ].each do |status|
+      stub_request(:post, @bot.webhook_url).to_return(status: status)
+      @webhook.deliver
+    end
+    stub_request(:post, @bot.webhook_url).to_timeout
+    @webhook.deliver
+    stub_request(:post, @bot.webhook_url).to_raise(Errno::ECONNREFUSED)
+    @webhook.deliver
+    assert_equal 6, @bot.reload.bot_webhook_failures
+  end
+
+  test "any 2xx resets consecutive failures even without a usable reply" do
+    [ 200, 201, 204, 299 ].each do |status|
+      @bot.update!(bot_webhook_failures: 9)
+      stub_request(:post, @bot.webhook_url).to_return(status: status)
+      assert_no_difference "Message.count" do
+        @webhook.deliver
+      end
+      assert_equal 0, @bot.reload.bot_webhook_failures
+      assert @bot.active?
+    end
+    stub_request(:post, @bot.webhook_url).to_return(status: 503)
+    9.times { @webhook.deliver }
+    assert @bot.reload.active?
+    @webhook.deliver
+    assert @bot.reload.suspended?
+  end
+
+  test "stale webhook instances recheck suspension before sending" do
+    User.find(@bot.id).update!(status: :suspended, bot_suspension_reason: "Flooding")
+    @webhook.deliver
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "an in flight success cannot reactivate or post for a suspended bot" do
+    stub_request(:post, @bot.webhook_url).to_return do
+      User.find(@bot.id).update!(status: :suspended, bot_suspension_reason: "Flooding")
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Too late" }
+    end
+    assert_no_difference "Message.count" do
+      @webhook.deliver
+    end
+    assert @bot.reload.suspended?
+  end
+
+  test "reactivation clears all safeguard state but preserves credentials and rooms" do
+    @bot.update!(status: :suspended, bot_suspension_reason: "Flooding", bot_webhook_failures: 9,
+      bot_cooldown_attempts: 5, bot_cooldown_until: 30.seconds.from_now, bot_message_timestamps: [ Time.current.to_f ])
+    code, rooms = @bot.bot_code, @bot.room_ids
+    @bot.reactivate_bot
+    assert @bot.reload.active?
+    assert_nil @bot.bot_suspension_reason
+    assert_nil @bot.bot_cooldown_until
+    assert_empty @bot.bot_message_timestamps
+    assert_equal 0, @bot.bot_cooldown_attempts
+    assert_equal 0, @bot.bot_webhook_failures
+    assert_equal code, @bot.bot_code
+    assert_equal rooms, @bot.room_ids
+    assert_kind_of Message, post_message
+  end
+
+  test "reactivation cannot clear an active bots cooldown or undo deletion or a ban" do
+    @bot.update!(bot_cooldown_until: 30.seconds.from_now)
+    @bot.reactivate_bot
+    assert @bot.reload.bot_cooldown_until
+    @bot.banned!
+    @bot.reactivate_bot
+    assert @bot.reload.banned?
+    @bot.deactivate_bot
+    @bot.reactivate_bot
+    assert @bot.reload.deactivated?
+  end
+
+  private
+    def post_message
+      @bot.with_bot_posting_permission { @room.messages.create!(creator: @bot, body: "Hi") }
+    end
+end
diff --git a/test/models/user/bot_limit_test.rb b/test/models/user/bot_limit_test.rb
