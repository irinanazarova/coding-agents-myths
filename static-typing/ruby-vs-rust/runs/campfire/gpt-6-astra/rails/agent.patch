+require "test_helper"
+
+class Bots::MessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = User.create!(name: "Deploy Bot", role: :bot, creator: users(:jz))
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "raw curl body creates a bot-authored message and delivers it normally" do
+    body = "Deploy of v1.2.3 finished ✅ & version=123\n<plain text>"
+    assert_enqueued_with job: Room::PushMessageJob do
+      assert_difference "Message.count" do
+        post room_bot_messages_url(@room, @bot.bot_code), params: body.dup,
+          headers: { "Content-Type" => "application/x-www-form-urlencoded" }
+      end
+    end
+    assert_response :created
+    message = Message.last
+    assert_equal @bot, message.creator
+    assert_equal body, message.plain_text_body
+    assert_equal message_path(message.id), response.headers["Location"]
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__body", text: /Deploy of v1.2.3/
+    end
+  end
+
+  test "a webhook can answer later using the callback posting path" do
+    @bot.update!(webhook_url: "https://example.com/mention")
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).returns("93.184.215.14")
+    callback = nil
+    stub_request(:post, @bot.webhook_url).with do |request|
+      callback = JSON.parse(request.body)
+      true
+    end.to_return(status: 204)
+
+    perform_enqueued_jobs only: Message::BotWebhookJob do
+      @room.messages.create!(creator: users(:jz),
+        body: %(<div><action-text-attachment sgid="#{@bot.attachable_sgid}"></action-text-attachment> deploy</div>))
+    end
+
+    assert_difference "Message.count", 1 do
+      post callback.dig("room", "reply_to"), params: "Deployed later", headers: { "Content-Type" => "text/plain" }
+    end
+    assert_response :created
+    assert_equal @bot, Message.last.creator
+    assert_equal @room, Message.last.room
+    assert_equal "Deployed later", Message.last.plain_text_body
+  end
+
+  test "body is literal text regardless of content type" do
+    [ "application/json", "application/x-www-form-urlencoded", "text/plain" ].each do |content_type|
+      body = "not JSON: a[]=1&a[b]=2 & 100% done <script>alert(1)</script>"
+      post room_bot_messages_url(@room, @bot.bot_code), params: body.dup, headers: { "Content-Type" => content_type }
+      assert_response :created
+      assert_equal body, Message.last.plain_text_body
+      assert_not_includes Message.last.body.to_s, "<script>"
+    end
+  end
+
+  test "credentials and raw body are not exposed in filtered request logs" do
+    post room_bot_messages_url(@room, @bot.bot_code), params: "private message"
+    assert_equal "/rooms/#{@room.id}/[FILTERED]/messages", request.filtered_path
+    assert_equal "[FILTERED]", request.filtered_parameters[:bot_code]
+    assert_empty request.request_parameters
+  end
+
+  test "closed rooms require an explicit membership" do
+    room = rooms(:watercooler)
+    post room_bot_messages_url(room, @bot.bot_code), params: "Nope"
+    assert_response :not_found
+    room.memberships.grant_to(@bot)
+    post room_bot_messages_url(room, @bot.bot_code), params: "Allowed"
+    assert_response :created
+  end
+
+  test "banned bots cannot post" do
+    @bot.banned!
+    assert_no_difference "Message.count" do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "Nope"
+    end
+    assert_response :unauthorized
+  end
+
+  test "invalid UTF-8 is rejected" do
+    assert_no_difference "Message.count" do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "\xFF".b
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "bot requests need no CSRF token when forgery protection is enabled" do
+    previous = ActionController::Base.allow_forgery_protection
+    ActionController::Base.allow_forgery_protection = true
+    post room_bot_messages_url(@room, @bot.bot_code), params: "From CI"
+    assert_response :created
+  ensure
+    ActionController::Base.allow_forgery_protection = previous
+  end
+
+  test "empty requests are rejected without creating messages" do
+    [ "", " \n\t" ].each do |body|
+      assert_no_difference "Message.count" do
+        post room_bot_messages_url(@room, @bot.bot_code), params: body
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "invalid codes and revoked codes are unauthorized even with a human session" do
+    sign_in :jz
+    [ "invalid", users(:jz).id.to_s ].each do |code|
+      post room_bot_messages_url(@room, code), params: "Nope"
+      assert_response :unauthorized
+    end
+    code = @bot.bot_code
+    delete bot_url(@bot)
+    post room_bot_messages_url(@room, code), params: "Nope"
+    assert_response :unauthorized
+  end
+
+  test "unknown rooms and rooms without membership are not found" do
+    post room_bot_messages_url(0, @bot.bot_code), params: "Nope"
+    assert_response :not_found
+    @bot.memberships.delete_all
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Nope"
+    assert_response :not_found
+    @room.memberships.grant_to(@bot)
+    post room_bot_messages_url(@room, @bot.bot_code), params: "Allowed"
+    assert_response :created
+  end
+end
