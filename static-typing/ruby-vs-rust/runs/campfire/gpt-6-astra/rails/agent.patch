diff --git a/test/jobs/message/bot_webhook_job_test.rb b/test/jobs/message/bot_webhook_job_test.rb
new file mode 100644
index 0000000..6587f61
--- /dev/null
+++ b/test/jobs/message/bot_webhook_job_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Message::BotWebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/mention")
+    @room = rooms(:hq)
+    @room.memberships.grant_to(@bot)
+  end
+
+  test "mentions enqueue once per bot without making an HTTP request" do
+    other = users(:david).bots.create!(name: "Other Bot", webhook_url: "https://other.example/mention")
+    @room.memberships.grant_to(other)
+    message = nil
+    assert_enqueued_jobs 2, only: Message::BotWebhookJob do
+      message = @room.messages.create!(creator: users(:david),
+        body: "#{mention(@bot)} #{mention(@bot)} #{mention(other)} restart")
+    end
+    assert_enqueued_with job: Message::BotWebhookJob, args: [ message, @bot ]
+    assert_enqueued_with job: Message::BotWebhookJob, args: [ message, other ]
+    assert_not_requested :post, @bot.webhook_url
+    assert_not_requested :post, other.webhook_url
+  end
+
+  test "does not enqueue for literal names, unmentioned bots or edits" do
+    assert_no_enqueued_jobs only: Message::BotWebhookJob do
+      message = @room.messages.create!(creator: users(:david), body: "@Deploy Bot hello")
+      message.update!(body: mention(@bot))
+    end
+  end
+
+  test "does not enqueue for bots without webhooks, inactive bots or nonmembers" do
+    assert_no_enqueued_jobs only: Message::BotWebhookJob do
+      @bot.update!(webhook_url: "")
+      create_mention
+      @bot.update!(webhook_url: "https://example.com/mention", status: :banned)
+      create_mention
+      @bot.update!(status: :active)
+      @room.memberships.revoke_from(@bot)
+      create_mention
+    end
+  end
+
+  test "bot authored messages do not trigger callback loops" do
+    assert_no_enqueued_jobs only: Message::BotWebhookJob do
+      @room.messages.create!(creator: @bot, body: mention(@bot))
+    end
+  end
+
+  test "job delivers a mention and posts its response" do
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/plain" }, body: "Done")
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).returns("93.184.215.14")
+
+    assert_difference "Message.count", 2 do
+      perform_enqueued_jobs only: Message::BotWebhookJob do
+        create_mention
+      end
+    end
+    assert_requested request
+    assert_equal @bot, @room.messages.order(:id).last.creator
+    broadcasts = ActionCable.server.pubsub.broadcasts("#{@room.to_gid_param}:messages")
+    assert_equal 1, broadcasts.size
+    assert_includes JSON.parse(broadcasts.first), "Done"
+  end
+
+  test "deleted messages are discarded before delivery" do
+    message = create_mention
+    message.destroy!
+    perform_enqueued_jobs only: Message::BotWebhookJob
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  private
+    def create_mention
+      @room.messages.create!(creator: users(:david), body: "#{mention(@bot)} restart")
+    end
+
+    def mention(bot)
+      %(<action-text-attachment sgid="#{bot.attachable_sgid}"></action-text-attachment>)
+    end
+end
diff --git a/test/jobs/room/bot_join_job_test.rb b/test/jobs/room/bot_join_job_test.rb
new file mode 100644
index 0000000..e8f00c1
--- /dev/null
+++ b/test/jobs/room/bot_join_job_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Room::BotJoinJobTest < ActiveSupport::TestCase
+  setup do
+    @bot = users(:david).bots.create!(name: "Room Bot", webhook_url: "https://example.com/joined")
+    @room = rooms(:watercooler)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).with("example.com").returns("93.184.215.14")
+  end
+
+  test "posts exactly the joined payload and broadcasts a plain text greeting" do
+    request = stub_request(:post, @bot.webhook_url).with do |request|
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal({ "event" => "joined", "room" => {
+        "id" => @room.id, "name" => @room.name,
+        "reply_to" => "/rooms/#{@room.id}/#{@bot.bot_code}/messages"
+      } }, JSON.parse(request.body))
+      true
+    end.to_return(status: 200, headers: { "Content-Type" => "text/plain; charset=utf-8" }, body: "Hello <all>\nWelcome ✅")
+
+    assert_difference "Message.count", 1 do
+      perform_enqueued_jobs only: Room::BotJoinJob do
+        @room.memberships.grant_to(@bot)
+      end
+    end
+    assert_requested request, times: 1
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_equal "Hello <all>\nWelcome ✅", reply.plain_text_body
+    assert_includes reply.body.to_s, "&lt;all&gt;"
+    assert_enqueued_with job: Room::PushMessageJob, args: [ @room, reply ]
+    assert_equal 1, ActionCable.server.pubsub.broadcasts("#{@room.to_gid_param}:messages").size
+    assert_no_enqueued_jobs only: Message::BotWebhookJob
+  end
+
+  test "HTML greetings use normal rich text sanitization" do
+    stub_request(:post, @bot.webhook_url).to_return(status: 200,
+      headers: { "Content-Type" => "text/html" }, body: "<strong>Hello</strong><script>alert(1)</script>")
+    perform_enqueued_jobs only: Room::BotJoinJob do
+      @room.memberships.grant_to(@bot)
+    end
+    reply = @room.messages.order(:id).last
+    assert_equal @bot, reply.creator
+    assert_includes reply.body.to_s, "<strong>Hello</strong>"
+    assert_not_includes reply.body.to_s, "<script>"
+  end
+
+  test "automatic memberships deliver joined too" do
+    request = stub_request(:post, @bot.webhook_url).to_return(status: 204)
+    perform_enqueued_jobs only: Room::BotJoinJob do
+      @bot.update!(add_to_all_open_rooms: true)
+    end
+    assert_requested request, times: Rooms::Open.count
+  end
+
+  test "removed memberships and inactive bots suppress pending delivery" do
+    @room.memberships.grant_to(@bot)
+    @room.memberships.revoke_from(@bot)
+    perform_enqueued_jobs only: Room::BotJoinJob
+    @bot.update!(status: :banned)
+    rooms(:hq).memberships.grant_to(@bot)
+    perform_enqueued_jobs only: Room::BotJoinJob
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "deleting the room discards pending delivery" do
+    @room.memberships.grant_to(@bot)
+    @room.destroy!
+    perform_enqueued_jobs only: Room::BotJoinJob
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "membership is checked again before posting the reply" do
+    stub_request(:post, @bot.webhook_url).to_return do
+      @room.memberships.revoke_from(@bot)
+      { status: 200, headers: { "Content-Type" => "text/plain" }, body: "Too late" }
+    end
+    assert_no_difference "Message.count" do
+      perform_enqueued_jobs only: Room::BotJoinJob do
+        @room.memberships.grant_to(@bot)
+      end
+    end
+  end
+
+  test "direct rooms are never delivered even if invoked explicitly" do
+    direct = Rooms::Direct.create_for({ creator: users(:david) }, users: [ @bot, users(:david) ])
+    Room::BotWebhook.new(room: direct, bot: @bot).deliver
+    assert_not_requested :post, @bot.webhook_url
+  end
+
+  test "unsafe endpoints and failed requests do not post greetings" do
+    @room.memberships.grant_to(@bot)
+    webhook = Room::BotWebhook.new(room: @room, bot: @bot)
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).raises(RestrictedHTTP::Violation)
+    webhook.deliver
+    assert_not_requested :post, @bot.webhook_url
+
+    RestrictedHTTP::PrivateNetworkGuard.stubs(:resolve).returns("93.184.215.14")
+    request = stub_request(:post, @bot.webhook_url).to_timeout
+    assert_no_difference "Message.count" do
+      webhook.deliver
+    end
+    assert_requested request, times: 1
+  end
+end
