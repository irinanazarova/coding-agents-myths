@@ -0,0 +1,59 @@
+require "test_helper"
+
+class User::BotLimitTest < ActiveSupport::TestCase
+  test "members can create five bots by default but not a sixth" do
+    member = users(:jz)
+    5.times { |index| member.bots.create!(name: "Bot #{index}") }
+
+    assert_no_difference "User.bot.count" do
+      bot = member.bots.create(name: "One too many")
+      assert_not bot.persisted?
+      assert_match "reached the limit", bot.errors.full_messages.to_sentence
+    end
+  end
+
+  test "accounts default to five bots per member" do
+    assert_equal 5, accounts(:signal).settings.bots_per_member
+  end
+
+  test "deleted bots free capacity but banned bots still count" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    member = users(:jz)
+    bot = member.bots.create!(name: "Bot", status: :banned)
+    assert_not member.can_create_bot?
+
+    bot.deactivate_bot
+    assert member.can_create_bot?
+    assert member.bots.create!(name: "Replacement").persisted?
+  end
+
+  test "the limit applies to each owner independently" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    users(:jz).bots.create!(name: "JZ's bot")
+    assert users(:kevin).bots.create!(name: "Kevin's bot").persisted?
+  end
+
+  test "lowering the limit preserves existing bots and only blocks creation" do
+    member = users(:jz)
+    bots = 2.times.map { |index| member.bots.create!(name: "Bot #{index}") }
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    assert_equal 2, member.bots.where.not(status: :deactivated).count
+    assert_not member.can_create_bot?
+    assert bots.first.update(name: "Renamed")
+    assert_not member.bots.create(name: "Blocked").persisted?
+
+    bots.first.deactivate_bot
+    assert_not member.can_create_bot?
+    bots.last.deactivate_bot
+    assert member.can_create_bot?
+  end
+
+  test "zero blocks members but administrators remain unlimited" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+    assert_not users(:jz).can_create_bot?
+    assert_not users(:jz).bots.create(name: "Blocked").persisted?
+    assert users(:david).can_create_bot?
+    6.times { |index| assert users(:david).bots.create!(name: "Admin bot #{index}").persisted? }
+  end
+end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
new file mode 100644
index 0000000..47551bd
--- /dev/null
+++ b/test/models/user/bot_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "bots have unique credentials and do not join open rooms by default" do
+    first = users(:jz).bots.create!(name: "First bot")
+    second = users(:jz).bots.create!(name: "Second bot")
+    assert first.bot?
+    assert_equal 32, first.bot_code.length
+    assert_not_equal first.bot_code, second.bot_code
+    assert_empty first.rooms
+    assert_not first.authenticate(first.bot_code)
+
+    room = Rooms::Open.create!(name: "New room", creator: users(:david))
+    assert_not_includes room.users, first
+    assert_not_includes room.users, second
+  end
+
+  test "opting in joins existing and future open rooms and opting out keeps memberships" do
+    bot = users(:jz).bots.create!(name: "Room Bot", webhook_url: "https://example.com/joined")
+    assert_not bot.add_to_all_open_rooms?
+    assert_enqueued_jobs Rooms::Open.count, only: Room::BotJoinJob do
+      bot.update!(add_to_all_open_rooms: true)
+    end
+    assert_equal Rooms::Open.order(:id).ids, bot.rooms.opens.order(:id).ids
+    assert_empty bot.rooms.closeds
+
+    room = nil
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      room = Rooms::Open.create!(name: "New room", creator: users(:david))
+    end
+    assert_includes room.users, bot
+    assert_includes room.users, users(:jz)
+
+    assert_no_enqueued_jobs only: Room::BotJoinJob do
+      room.update!(name: "Renamed")
+      bot.update!(name: "Renamed bot")
+      bot.update!(add_to_all_open_rooms: false)
+    end
+    memberships = bot.room_ids.sort
+    excluded = Rooms::Open.create!(name: "Not for the bot", creator: users(:david))
+    assert_not_includes excluded.users, bot
+    assert_equal memberships, bot.room_ids.sort
+
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      bot.update!(add_to_all_open_rooms: true)
+    end
+    assert_includes excluded.users, bot
+  end
+
+  test "bots can opt in on creation and join rooms converted to open" do
+    bot = nil
+    assert_enqueued_jobs Rooms::Open.count, only: Room::BotJoinJob do
+      bot = users(:jz).bots.create!(name: "Room Bot", add_to_all_open_rooms: true,
+        webhook_url: "https://example.com/joined")
+    end
+    manual = users(:jz).bots.create!(name: "Manual Bot")
+    room = rooms(:watercooler).becomes!(Rooms::Open)
+    assert_enqueued_jobs 1, only: Room::BotJoinJob do
+      room.save!
+    end
+    assert_includes room.users, bot
+    assert_not_includes room.users, manual
+  end
+
+  test "inactive bots do not automatically join new rooms" do
+    bot = users(:jz).bots.create!(name: "Banned Bot", add_to_all_open_rooms: true, status: :banned)
+    assert_empty bot.rooms
+    room = Rooms::Open.create!(name: "New room", creator: users(:david))
+    assert_not_includes room.users, bot
+  end
+
+  test "webhook URLs are optional normalized HTTP URLs" do
+    bot = users(:jz).bots.new(name: "Deploy Bot")
+    [ nil, "", "  ", " https://example.com/mention ", "http://example.com:8080/mention?key=value" ].each do |url|
+      bot.webhook_url = url
+      assert bot.valid?, bot.errors.full_messages.to_sentence
+      if url.present?
+        assert_equal url.strip, bot.webhook_url
+      else
+        assert_nil bot.webhook_url
+      end
+    end
+
+    [ "not a url", "/relative", "ftp://example.com", "https://", "https://user:secret@example.com", "https://example.com/#fragment" ].each do |url|
+      bot.webhook_url = url
+      assert_not bot.valid?, "Accepted invalid webhook URL: #{url}"
+      assert bot.errors[:webhook_url].present?
+    end
+  end
+
+  test "deleting a bot revokes credentials but preserves message authorship" do
+    bot = users(:jz).bots.create!(name: "Deploy Bot")
+    message = rooms(:hq).messages.create!(body: "Deployed", creator: bot)
+    bot.deactivate_bot
+    assert bot.deactivated?
+    assert_nil bot.bot_code
+    assert_empty bot.rooms
+    assert_equal "Deploy Bot", message.reload.creator.name
+  end
+end
diff --git a/test/system/bots_test.rb b/test/system/bots_test.rb
new file mode 100644
index 0000000..1042d1d
--- /dev/null
+++ b/test/system/bots_test.rb
@@ -0,0 +1,103 @@
+require "application_system_test_case"
+
+class BotsTest < ApplicationSystemTestCase
+  test "administrators confirm reactivation of suspended bots" do
+    bot = users(:jz).bots.create!(name: "Noisy Bot", status: :suspended,
+      bot_suspension_reason: "Flooding: five posting attempts during cooldown")
+    sign_in "david@37signals.com"
+    visit bots_path
+
+    within "li", text: "Noisy Bot" do
+      assert_text "Suspended"
+      assert_text "Flooding: five posting attempts during cooldown"
+      dismiss_confirm { click_on "Reactivate" }
+      assert_text "Suspended"
+      assert bot.reload.suspended?
+      accept_confirm { click_on "Reactivate" }
+    end
+    assert_current_path bots_path
+    within "li", text: "Noisy Bot" do
+      assert_no_text "Suspended"
+      assert_no_button "Reactivate"
+    end
+    assert bot.reload.active?
+  end
+
+  test "a member creates, edits and deletes a bot" do
+    sign_in "jz@37signals.com"
+    visit edit_account_path
+    click_on "Set up chat bots"
+    assert_current_path bots_path
+
+    click_on "Add a chat bot"
+    assert_unchecked_field "Add to all open rooms", visible: :all
+    fill_in "Name the bot", with: "Deploy Bot"
+    fill_in "Webhook URL", with: "https://example.com/mention"
+    click_on "Save changes"
+    assert_current_path bots_path
+
+    within "li", text: "Deploy Bot" do
+      assert_field "Bot code", readonly: true, with: User.bot.last.bot_code
+      click_on "Edit Deploy Bot"
+    end
+
+    assert_empty User.bot.last.rooms
+    check "Add to all open rooms", allow_label_click: true
+    assert_field "Webhook URL", with: "https://example.com/mention"
+    fill_in "Webhook URL", with: ""
+    fill_in "Name the bot", with: "Release Bot"
+    click_on "Save changes"
+    click_on "Edit Release Bot"
+    assert_checked_field "Add to all open rooms", visible: :all
+    assert_equal Rooms::Open.order(:id).ids, User.bot.last.rooms.order(:id).ids
+    uncheck "Add to all open rooms", allow_label_click: true
+    click_on "Save changes"
+    click_on "Edit Release Bot"
+    assert_unchecked_field "Add to all open rooms", visible: :all
+    assert_equal Rooms::Open.order(:id).ids, User.bot.last.rooms.order(:id).ids
+    assert_field "Webhook URL", with: ""
+    assert_nil User.bot.last.webhook_url
+
+    dismiss_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_selector "h1", text: "Edit Release Bot"
+
+    accept_confirm do
+      click_on "Delete this chat bot"
+    end
+    assert_current_path bots_path
+    assert_no_text "Release Bot"
+  end
+
+  test "administrators set the member bot limit" do
+    sign_in "david@37signals.com"
+    visit edit_account_path
+    assert_field "Bots per member", with: "5"
+    within "form", text: "Bots per member" do
+      fill_in "Bots per member", with: "1"
+      click_on "Save changes"
+    end
+    assert_selector ".flash", text: "✓"
+    assert_field "Bots per member", with: "1"
+    assert_equal 1, accounts(:signal).reload.settings.bots_per_member
+  end
+
+  test "members reach the bot limit and deletion frees a slot" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in "jz@37signals.com"
+    visit bots_path
+    click_on "Add a chat bot"
+    fill_in "Name the bot", with: "Only Bot"
+    click_on "Save changes"
+    assert_current_path bots_path
+    assert_text "reached the limit"
+    assert_no_link "Add a chat bot"
+
+    click_on "Edit Only Bot"
+    accept_confirm { click_on "Delete this chat bot" }
+    assert_current_path bots_path
+    assert_link "Add a chat bot"
+    assert_no_text "reached the limit"
+  end
+end
