diff --git a/app/controllers/bots/messages_controller.rb b/app/controllers/bots/messages_controller.rb
new file mode 100644
index 0000000..14d93f5
--- /dev/null
+++ b/app/controllers/bots/messages_controller.rb
@@ -0,0 +1,44 @@
+class Bots::MessagesController < ApplicationController
+  skip_forgery_protection
+
+  def create
+    result = Current.user.with_bot_posting_permission { create_message }
+
+    case result
+    when :forbidden
+      head :forbidden
+    when :cooldown
+      response.headers["Retry-After"] = Current.user.bot_retry_after.to_s
+      head :too_many_requests
+    when Message
+      result.broadcast_create
+      head :created, location: message_path(result.id)
+    end
+  end
+
+  private
+    def create_message
+      if room = Current.user.rooms.find_by(id: request.path_parameters[:room_id])
+        body = request.raw_post.dup.force_encoding(Encoding::UTF_8)
+
+        if body.valid_encoding? && body.present?
+          room.messages.create!(body: ERB::Util.html_escape(body).gsub(/\r?\n/, "<br>"))
+        else
+          head :unprocessable_entity
+          nil
+        end
+      else
+        head :not_found
+        nil
+      end
+    end
+
+    def require_authentication
+      Current.user = User.bot.where(status: %i[ active suspended ]).find_by(bot_code: request.path_parameters[:bot_code])
+      if Current.user&.suspended?
+        head :forbidden
+      elsif !Current.user
+        head :unauthorized
+      end
+    end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..1c46fd8
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,67 @@
+class BotsController < ApplicationController
+  before_action :prevent_credential_caching
+  before_action :ensure_can_administer, only: :reactivate
+  before_action :set_bot, only: %i[ edit update destroy reactivate ]
+
+  def index
+    @bots = accessible_bots.ordered.with_attached_avatar
+  end
+
+  def new
+    if Current.user.can_create_bot?
+      @bot = Current.user.bots.new
+    else
+      redirect_to bots_url, alert: "You’ve reached the limit of bots per member"
+    end
+  end
+
+  def create
+    @bot = Current.user.bots.new(bot_params)
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @bot.deactivate_bot
+    redirect_to bots_url, status: :see_other
+  end
+
+  def reactivate
+    @bot.reactivate_bot
+    redirect_to bots_url, status: :see_other
+  end
+
+  private
+    def accessible_bots
+      (Current.user.administrator? ? User.bot : Current.user.bots).where.not(status: :deactivated)
+    end
+
+    def set_bot
+      @bot = accessible_bots.find_by(id: params[:id])
+      head :not_found unless @bot
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar, :webhook_url, :add_to_all_open_rooms)
+    end
+
+    def prevent_credential_caching
+      response.headers["Cache-Control"] = "no-store"
+      response.headers["Referrer-Policy"] = "no-referrer"
+    end
+end
