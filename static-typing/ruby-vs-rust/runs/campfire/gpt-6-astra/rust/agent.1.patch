+#[tokio::test]
+async fn bots_management_is_owner_scoped_and_unpaginated() {
+    use campfire_db::{Bot, PasswordDigest, Role, User, UserChanges};
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Bot owner").await;
+    let (other, other_cookie) = bot_member(app, "Other member").await;
+    assert_eq!(owner.role, Role::Member);
+    assert_eq!(send(router, get("/bots")).await.status, StatusCode::FOUND);
+    let created = send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Members+Bot&bot[creator_id]=1&bot[role]=administrator")).await;
+    assert_eq!(created.status, StatusCode::FOUND);
+    let manager = owner.clone();
+    let bot = app.db.read(move |conn| Ok(Bot::managed_by(conn, &manager)?.remove(0))).await.unwrap();
+    let id = bot.user.id;
+    assert_eq!(bot.creator_id, owner.id);
+    assert_eq!(bot.user.role, Role::Member);
+    let list = send(router, get_with_cookie("/bots", &other_cookie)).await;
+    assert!(!list.text().contains(&bot.code));
+    assert!(!list.text().contains("Members Bot"));
+    for (method, path, body) in [
+        ("GET", format!("/bots/{id}/edit"), ""),
+        ("PATCH", format!("/bots/{id}"), "bot[name]=Stolen"),
+        ("DELETE", format!("/bots/{id}"), ""),
+    ] {
+        assert_eq!(send(router, bot_form(method, &path, &other_cookie, body)).await.status, StatusCode::NOT_FOUND);
+    }
+    let csrf = bot_form("POST", "/bots", &cookie, "bot[name]=Cross-site");
+    let (mut parts, body) = csrf.into_parts();
+    parts.headers.insert("sec-fetch-site", "cross-site".parse().unwrap());
+    assert_eq!(send(router, Request::from_parts(parts, body)).await.status, StatusCode::UNPROCESSABLE_ENTITY);
+
+    let digest = PasswordDigest::hash("unrelated password".into(), 4).await.unwrap();
+    let owner_id = owner.id;
+    let codes = app.db.write(move |tx| {
+        (0..105).map(|n| Bot::create(tx, owner_id, format!("Batch Bot {n}"), digest.clone()).map(|bot| bot.code)).collect::<campfire_db::Result<Vec<_>>>()
+    }).await.unwrap();
+    let list = send(router, get_with_cookie("/bots", &cookie)).await;
+    for code in &codes { assert!(list.text().contains(code)); }
+    let unique: std::collections::HashSet<_> = codes.iter().collect();
+    assert_eq!(unique.len(), codes.len());
+
+    let other_id = other.id;
+    app.db.write(move |tx| User::find(tx.conn(), other_id)?.update(tx, UserChanges { role: Some(Role::Administrator), ..Default::default() })).await.unwrap();
+    let admin_list = send(router, get_with_cookie("/bots", &other_cookie)).await;
+    assert!(admin_list.text().contains(&bot.code));
+    for code in &codes { assert!(admin_list.text().contains(code)); }
+    assert_eq!(send(router, get_with_cookie(&format!("/bots/{id}/edit"), &other_cookie)).await.status, StatusCode::OK);
+    assert_eq!(send(router, bot_form("PATCH", &format!("/bots/{id}"), &other_cookie, "bot[name]=Admin+renamed")).await.status, StatusCode::FOUND);
+    assert_eq!(send(router, bot_form("DELETE", &format!("/bots/{id}"), &other_cookie, "")).await.status, StatusCode::FOUND);
+}
