+//! Full-stack bot management and raw HTTP posting regressions.
+
+use super::*;
+
+#[tokio::test]
+async fn bots_listing_is_available_to_members() {
+    let test = boot_seeded().await;
+    let cookie = &vectors().sessions[0].cookie_header;
+    let reply = send(&test.booted.router, get_with_cookie("/bots", cookie)).await;
+    assert_eq!(reply.status, StatusCode::OK);
+    assert!(reply.text().contains("Add a chat bot"));
+}
+
+fn bot_form(method: &str, path: &str, cookie: &str, body: &str) -> Request<Body> {
+    Request::builder().method(method).uri(path)
+        .header(header::HOST, "campfire.test")
+        .header(header::COOKIE, cookie)
+        .header("sec-fetch-site", "same-origin")
+        .header(header::CONTENT_TYPE, "application/x-www-form-urlencoded")
+        .body(Body::from(body.to_string())).unwrap()
+}
+
+fn bot_post(path: &str, content_type: &str, body: &str) -> Request<Body> {
+    Request::post(path).header(header::HOST, "campfire.test")
+        .header(header::CONTENT_TYPE, content_type)
+        .body(Body::from(body.to_string())).unwrap()
+}
+
+#[tokio::test]
+async fn bots_lifecycle_and_raw_message_api() {
+    use campfire_db::{Bot, Message, User};
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let session = &vectors().sessions[0];
+    let cookie = &session.cookie_header;
+    let owner_name = session.user_name.clone();
+    let owner = app.db.read(move |conn| Ok(User::all(conn)?.into_iter().find(|u| u.name == owner_name).unwrap())).await.unwrap();
+    let owner_id = owner.id;
+
+    let account = send(router, get_with_cookie("/account/edit", cookie)).await;
+    assert!(account.text().contains("Set up chat bots"));
+    let new = send(router, get_with_cookie("/bots/new", cookie)).await;
+    assert_eq!(new.status, StatusCode::OK);
+    assert!(new.text().contains("Name the bot"));
+    assert!(new.text().contains("multipart/form-data"));
+    let invalid = send(router, bot_form("POST", "/bots", cookie, "bot[name]=+++")).await;
+    assert_eq!(invalid.status, StatusCode::UNPROCESSABLE_ENTITY);
+    let created = send(router, bot_form("POST", "/bots", cookie, "bot[name]=Deploy+Bot")).await;
+    assert_eq!(created.status, StatusCode::FOUND, "{}", created.text());
+    assert!(created.header("location").unwrap().ends_with("/bots"));
+    let owner2 = owner.clone();
+    let bots = app.db.read(move |conn| Bot::managed_by(conn, &owner2)).await.unwrap();
+    assert_eq!(bots.len(), 1);
+    let bot = bots.into_iter().next().unwrap();
+    assert_eq!(bot.creator_id, owner_id);
+    let bot_id = bot.user.id;
+    let code = bot.code.clone();
+    assert!(code.len() >= 32);
+    assert!(bot.user.email_address.is_none());
+
+    let list = send(router, get_with_cookie("/bots", cookie)).await;
+    assert!(list.text().contains("Edit Deploy Bot"));
+    assert!(list.text().contains("Bot code"));
+    assert!(list.text().contains(&code));
+    assert!(list.text().contains("readonly"));
+    assert!(list.header("cache-control").unwrap().contains("no-store"));
+    assert!(list.text().contains("turbo-cache-control"));
+    let room_id = app.db.read(move |conn| {
+        let open: Vec<i64> = campfire_db::query_all(conn, "SELECT id FROM rooms WHERE type = 'Rooms::Open'", [], |r| r.get(0))?;
+        assert!(!open.is_empty());
+        for id in &open {
+            assert!(campfire_db::Membership::find_by_room_and_user(conn, *id, bot_id)?.is_some());
+        }
+        Ok(open[0])
+    }).await.unwrap();
+    let path = format!("/rooms/{room_id}/{code}/messages");
+    let cases = [
+        ("application/x-www-form-urlencoded", "Deploy of v1.2.3 finished ✅"),
+        ("application/x-www-form-urlencoded", "_method=delete&body[bad=1&x=%&x[]=2"),
+        ("application/json", "not JSON { but still a message"),
+        ("text/plain", "<script>alert('x')</script> & <b>text</b>\nsecond line"),
+        ("multipart/form-data; boundary=unused", "raw multipart-looking content"),
+    ];
+    let mut first_message_id = 0;
+    for (content_type, body) in cases {
+        let reply = send(router, bot_post(&path, content_type, body)).await;
+        assert_eq!(reply.status, StatusCode::CREATED, "{}", reply.text());
+        let location = reply.header("location").unwrap();
+        assert!(location.starts_with("/messages/"));
+        let id: i64 = location.rsplit('/').next().unwrap().parse().unwrap();
+        first_message_id = id;
+        let expected = body.to_string();
+        let rich_text = app.db.env().rich_text.clone();
+        app.db.read(move |conn| {
+            let message = Message::find(conn, id)?;
+            assert_eq!(message.creator_id, bot_id);
+            assert_eq!(message.room_id, room_id);
+            assert_eq!(message.plain_text_body(conn, rich_text.as_ref())?, expected);
+            Ok(())
+        }).await.unwrap();
+    }
+    for body in ["", " \n\t"] {
+        assert_eq!(send(router, bot_post(&path, "text/plain", body)).await.status, StatusCode::UNPROCESSABLE_ENTITY);
+    }
+    assert_eq!(send(router, bot_post(&format!("/rooms/{room_id}/invalid/messages"), "text/plain", "hello")).await.status, StatusCode::UNAUTHORIZED);
+    for bad_id in ["999999999", "oops", "1abc"] {
+        assert_eq!(send(router, bot_post(&format!("/rooms/{bad_id}/{code}/messages"), "text/plain", "hello")).await.status, StatusCode::NOT_FOUND);
+    }
+    let edit_path = format!("/bots/{bot_id}/edit");
+    let edit = send(router, get_with_cookie(&edit_path, cookie)).await;
+    assert!(edit.text().contains("Delete this chat bot"));
+    assert!(edit.text().contains("data-turbo-confirm="));
+    assert!(!edit.text().contains(&code));
+    let resource = format!("/bots/{bot_id}");
+    let updated = send(router, bot_form("PATCH", &resource, cookie, "bot[name]=Release+Bot")).await;
+    assert_eq!(updated.status, StatusCode::FOUND);
+    let changed = app.db.read(move |conn| Bot::find(conn, bot_id)).await.unwrap();
+    assert_eq!(changed.user.name, "Release Bot");
+    assert_eq!(changed.code, code);
+    let deleted = send(router, bot_form("DELETE", &resource, cookie, "")).await;
+    assert_eq!(deleted.status, StatusCode::FOUND);
+    assert_eq!(send(router, bot_post(&path, "text/plain", "after delete")).await.status, StatusCode::UNAUTHORIZED);
+    app.db.read(move |conn| {
+        assert_eq!(Message::find(conn, first_message_id)?.creator(conn)?.name, "Release Bot");
+        assert_eq!(User::find(conn, bot_id)?.status, campfire_db::Status::Deactivated);
+        Ok(())
+    }).await.unwrap();
+}
+
+async fn bot_member(app: &App, name: &str) -> (campfire_db::User, String) {
+    let name = name.to_string();
+    let digest = campfire_db::PasswordDigest::hash("test password".into(), 4).await.unwrap();
+    let (user, session) = app.db.write(move |tx| {
+        let user = campfire_db::User::create(tx, campfire_db::NewUser { name, password_digest: Some(digest), ..Default::default() })?;
+        let session = campfire_db::Session::start(tx, user.id, None, None)?;
+        Ok((user, session))
+    }).await.unwrap();
+    let signed = rails_compat::cookies::sign(&app.secrets, "session_token", &session.token, None);
+    (user, format!("session_token={}", ruby_compat::cgi_escape(&signed)))
+}
