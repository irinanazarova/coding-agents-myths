+/// Runs before kit's method override and body parser, including for curl's default form type.
+async fn bot_raw_body(mut request: axum::extract::Request, next: Next) -> axum::response::Response {
+    if request.method() == campfire_kit::Method::POST
+        && let Ok(Some((route, _))) = controllers::recognize(request.method(), &controllers::normalize_path(request.uri().path()))
+        && route.endpoint == "bots#post_message"
+    {
+        request.extensions_mut().insert(campfire_kit::body::RawBody);
+    }
+    next.run(request).await
 }
 
