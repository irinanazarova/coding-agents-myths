+#[tokio::test]
+async fn bots_messages_are_broadcast_with_the_bot_as_author() {
+    use futures_util::{SinkExt, StreamExt};
+    use tokio_tungstenite::tungstenite::client::IntoClientRequest;
+    use serde_json::json;
+
+    let test = boot_seeded().await;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Subscriber").await;
+    let owner_id = owner.id;
+    let room = app.db.read(move |conn| {
+        Ok(campfire_db::Room::for_user_of_type(conn, owner_id, campfire_db::RoomType::Open)?.remove(0))
+    }).await.unwrap();
+    assert_eq!(send(&test.booted.router, bot_form("POST", "/bots", &cookie, "bot[name]=Broadcast+Bot")).await.status, StatusCode::FOUND);
+    let bot = app.db.read(move |conn| Ok(campfire_db::Bot::managed_by(conn, &owner)?.remove(0))).await.unwrap();
+
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let service = campfire_kit::front::app_service(test.booted.router.clone());
+    let shutdown = campfire_kit::front::Shutdown::when(std::future::pending());
+    let server = tokio::spawn(campfire_kit::front::serve_plain(
+        listener, service, campfire_kit::front::Protocol::Http1, Default::default(), shutdown,
+    ));
+    let mut request = format!("ws://{address}/cable").into_client_request().unwrap();
+    request.headers_mut().insert("origin", format!("http://{address}").parse().unwrap());
+    request.headers_mut().insert("sec-websocket-protocol", "actioncable-v1-json".parse().unwrap());
+    request.headers_mut().insert("cookie", cookie.parse().unwrap());
+    let (mut socket, _) = tokio_tungstenite::connect_async(request).await.unwrap();
+    assert!(socket.next().await.unwrap().unwrap().into_text().unwrap().contains("welcome"));
+    let gid = crate::channels::room_gid(&room).to_param();
+    let signed = rails_compat::turbo::signed_stream_name(&app.secrets, &[&gid, "messages"]);
+    let identifier = json!({ "channel": "RoomMessagesChannel", "signed_stream_name": signed }).to_string();
+    socket.send(tokio_tungstenite::tungstenite::Message::Text(
+        json!({ "command": "subscribe", "identifier": identifier }).to_string().into(),
+    )).await.unwrap();
+    tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        loop {
+            let frame = socket.next().await.unwrap().unwrap().into_text().unwrap();
+            if frame.contains("confirm_subscription") { break; }
+        }
+    }).await.unwrap();
+    let path = format!("/rooms/{}/{}/messages", room.id, bot.code);
+    let reply = send(&test.booted.router, bot_post(&path, "text/plain", "Build shipped ✅")).await;
+    assert_eq!(reply.status, StatusCode::CREATED);
+    let html = tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        loop {
+            let frame = socket.next().await.unwrap().unwrap().into_text().unwrap();
+            let frame: serde_json::Value = serde_json::from_str(&frame).unwrap();
+            if let Some(html) = frame["message"].as_str() { break html.to_string(); }
+        }
+    }).await.unwrap();
+    assert!(html.contains("action=\"append\""));
+    assert!(html.contains("Broadcast Bot"));
+    assert!(html.contains("Build shipped ✅"));
+    assert!(!html.contains(&bot.code));
+    socket.close(None).await.unwrap();
+    server.abort();
+}
