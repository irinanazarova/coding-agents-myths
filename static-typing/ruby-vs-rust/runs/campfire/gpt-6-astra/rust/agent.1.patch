+#[tokio::test]
+async fn bots_membership_and_avatar_use_normal_user_paths() {
+    use campfire_db::{Bot, Room, RoomType};
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Room owner").await;
+    // A real multipart upload, using a tiny SVG so this test doesn't depend on image fixtures.
+    let image = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\"><rect width=\"32\" height=\"32\"/></svg>";
+    let multipart = format!("--bot-boundary\r\nContent-Disposition: form-data; name=\"bot[name]\"\r\n\r\nAvatar Bot\r\n--bot-boundary\r\nContent-Disposition: form-data; name=\"bot[avatar]\"; filename=\"bot.svg\"\r\nContent-Type: image/svg+xml\r\n\r\n{image}\r\n--bot-boundary--\r\n");
+    let request = Request::post("/bots").header(header::HOST, "campfire.test").header(header::COOKIE, &cookie)
+        .header("sec-fetch-site", "same-origin").header(header::CONTENT_TYPE, "multipart/form-data; boundary=bot-boundary")
+        .body(Body::from(multipart)).unwrap();
+    assert_eq!(send(router, request).await.status, StatusCode::FOUND);
+    let manager = owner.clone();
+    let bot = app.db.read(move |conn| Ok(Bot::managed_by(conn, &manager)?.remove(0))).await.unwrap();
+    let id = bot.user.id;
+    app.db.read(move |conn| {
+        assert!(crate::controllers::presenters::attachments::attached_blob(conn, "User", id, "avatar")?.is_some());
+        Ok(())
+    }).await.unwrap();
+    let owner_id = owner.id;
+    let room = app.db.write(move |tx| Room::create_for(tx, RoomType::Closed, Some("Private bot test"), owner_id, &[owner_id])).await.unwrap();
+    let path = format!("/rooms/{}/{}/messages", room.id, bot.code);
+    assert_eq!(send(router, bot_post(&path, "text/plain", "not a member")).await.status, StatusCode::NOT_FOUND);
+    let edit = send(router, get_with_cookie(&format!("/rooms/closeds/{}/edit", room.id), &cookie)).await;
+    assert_eq!(edit.status, StatusCode::OK);
+    assert!(edit.text().contains("Avatar Bot"));
+    let form = format!("room[name]=Private+bot+test&user_ids[]={owner_id}&user_ids[]={id}");
+    let update = send(router, bot_form("PATCH", &format!("/rooms/closeds/{}", room.id), &cookie, &form)).await;
+    assert_eq!(update.status, StatusCode::FOUND);
+    assert_eq!(send(router, bot_post(&path, "text/plain", "now a member")).await.status, StatusCode::CREATED);
+    // No avatar selected on an edit must preserve the existing avatar.
+    assert_eq!(send(router, bot_form("PATCH", &format!("/bots/{id}"), &cookie, "bot[name]=Still+Avatar+Bot")).await.status, StatusCode::FOUND);
+    app.db.read(move |conn| {
+        assert!(crate::controllers::presenters::attachments::attached_blob(conn, "User", id, "avatar")?.is_some());
+        Ok(())
+    }).await.unwrap();
+}
