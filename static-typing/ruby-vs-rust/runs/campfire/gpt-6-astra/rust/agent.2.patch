+#[tokio::test]
+async fn bot_webhook_payload_nonblocking_delivery_and_replies() {
+    use campfire_db::{Bot, Message, Room, RoomType};
+    use rails_compat::global_id::{GlobalId, attachable_sgid};
+    use std::{sync::Arc, time::Duration};
+    use tokio::sync::{Notify, mpsc};
+
