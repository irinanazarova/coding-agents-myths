+    let room_id = room.id;
+    let (received, mut requests) = mpsc::unbounded_channel();
+    let release = Arc::new(Notify::new());
+    let gate = release.clone();
+    let service = axum::Router::new().route("/{mode}", axum::routing::post(move |
+        axum::extract::Path(mode): axum::extract::Path<String>, headers: axum::http::HeaderMap, body: String,
+    | {
+        let received = received.clone();
+        let gate = gate.clone();
+        async move {
+            received.send((headers, serde_json::from_str::<serde_json::Value>(&body).unwrap())).unwrap();
+            gate.notified().await;
+            match mode.as_str() {
+                "plain" | "removed" | "revoked" => (StatusCode::OK, [("content-type", "text/plain; charset=utf-8")], "<b>literal</b>\nDone"),
+                "html" => (StatusCode::OK, [("content-type", "text/html; charset=utf-8")], "<div><strong>Done</strong><script>alert(1)</script></div>"),
+                "empty" => (StatusCode::NO_CONTENT, [("content-type", "text/plain")], ""),
+                "json" => (StatusCode::OK, [("content-type", "application/json")], "{\"ignored\":true}"),
+                "blank" => (StatusCode::OK, [("content-type", "text/plain")], "   "),
+                "redirect" => (StatusCode::FOUND, [("location", "/plain")], ""),
+                "large" => {
+                    static BODY: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+                    (StatusCode::OK, [("content-type", "text/plain")], BODY.get_or_init(|| "x".repeat(1024 * 1024 + 1)).as_str())
+                }
+                _ => (StatusCode::INTERNAL_SERVER_ERROR, [("content-type", "text/plain")], "ignored"),
+            }
+        }
+    }));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move { axum::serve(listener, service).await.unwrap() });
+    let form = format!("bot[name]=Callback+bot&bot[webhook_url]=http://{address}/plain");
+    assert_eq!(send(router, bot_form("POST", "/bots", &cookie, &form)).await.status, StatusCode::FOUND);
+    let manager = owner.clone();
+    let bot = app.db.read(move |conn| Ok(Bot::managed_by(conn, &manager)?.remove(0))).await.unwrap();
+    let bot_id = bot.user.id;
+    let autocomplete = send(router, get_with_cookie(&format!("/autocompletable/users?room_id={room_id}&filter=Callback"), &cookie)).await;
+    assert_eq!(autocomplete.status, StatusCode::OK);
+    assert!(autocomplete.text().contains("Callback bot"));
+    let mention = |id| format!(r#"<action-text-attachment sgid="{}" content-type="application/vnd.campfire.mention"></action-text-attachment>"#,
+        attachable_sgid(&app.secrets, &GlobalId::new("User", id)));
+    let bot_mention = mention(bot_id);
+    let html = format!("<div>{bot_mention} restart <strong>the build</strong> please {bot_mention} {} literal @Callback bot</div>", mention(owner_id));
+    let body = format!("message[body]={}", ruby_compat::cgi_escape(&html));
+    let mut expected_replies = 0;
+    for mode in ["plain", "html", "empty", "json", "blank", "error", "redirect", "large", "removed", "revoked"] {
+        let form = format!("bot[name]=Callback+bot&bot[webhook_url]=http://{address}/{mode}");
+        assert_eq!(send(router, bot_form("PATCH", &format!("/bots/{bot_id}"), &cookie, &form)).await.status, StatusCode::FOUND);
+        let mut request = bot_form("POST", &format!("/rooms/{room_id}/messages"), &cookie, &body);
+        request.headers_mut().insert(header::ACCEPT, "text/vnd.turbo-stream.html".parse().unwrap());
+        // The endpoint cannot respond until after this request returns.
+        let response = tokio::time::timeout(Duration::from_secs(5), send(router, request)).await.expect("posting waited for webhook");
+        assert_eq!(response.status, StatusCode::OK, "{}", response.text());
+        let (headers, payload) = tokio::time::timeout(Duration::from_secs(5), requests.recv()).await.unwrap().unwrap();
+        assert_eq!(headers["content-type"], "application/json");
+        assert_eq!(payload["event"], "mention");
+        assert_eq!(payload["author"], serde_json::json!({"id": owner_id, "name": owner.name}));
+        assert_eq!(payload["room"]["id"], room_id);
+        assert_eq!(payload["room"]["name"], room.name.clone().unwrap());
+        let reply_to = format!("/rooms/{room_id}/{}/messages", bot.code);
+        assert_eq!(payload["room"]["reply_to"], reply_to);
+        let text = payload["message"]["body"]["text"].as_str().unwrap();
+        assert!(text.starts_with("restart the build please"), "{text}");
+        assert!(text.contains("Callback author"), "other mentions must survive: {text}");
+        assert_eq!(text.matches("Callback bot").count(), 1, "literal name must survive: {text}");
+        assert!(payload["message"]["body"]["html"].as_str().unwrap().contains(&bot_mention));
+        let message_id = payload["message"]["id"].as_i64().unwrap();
+        assert_eq!(payload["message"]["link"], format!("/rooms/{room_id}/@{message_id}"));
+        let link = send(router, get_with_cookie(payload["message"]["link"].as_str().unwrap(), &cookie)).await;
+        assert_eq!(link.status, StatusCode::OK);
+        if mode == "removed" {
+            assert_eq!(send(router, bot_form("PATCH", &format!("/bots/{bot_id}"), &cookie,
+                "bot[name]=Callback+bot&bot[webhook_url]=" )).await.status, StatusCode::FOUND);
+        } else if mode == "revoked" {
+            app.db.write(move |tx| {
+                tx.conn().execute("DELETE FROM memberships WHERE user_id = ? AND room_id = ?", [bot_id, room_id])?;
+                Ok(())
+            }).await.unwrap();
+        }
+        release.notify_one();
+        if matches!(mode, "plain" | "html") {
+            expected_replies += 1;
+            tokio::time::timeout(Duration::from_secs(5), async {
+                loop {
+                    let replies = app.db.read(move |conn| Message::by_creator(conn, bot_id)).await.unwrap();
+                    if replies.len() == expected_replies {
+                        let reply_id = replies.last().unwrap().id;
+                        let plain = app.db.env().rich_text.clone();
+                        app.db.read(move |conn| {
+                            let reply = Message::find(conn, reply_id)?;
+                            assert_eq!(reply.room_id, room_id);
+                            let text = reply.plain_text_body(conn, &*plain)?;
+                            if mode == "plain" { assert_eq!(text, "<b>literal</b>\nDone"); }
+                            else { assert_eq!(text, "Done"); }
+                            Ok(())
+                        }).await.unwrap();
+                        break;
+                    }
+                    tokio::time::sleep(Duration::from_millis(10)).await;
+                }
+            }).await.unwrap();
+        }
+        if mode == "empty" {
+            assert_eq!(send(router, bot_post(&reply_to, "text/plain", "Later reply")).await.status, StatusCode::CREATED);
+            expected_replies += 1;
+        }
+    }
+    // A mention of a bot outside the room must not send any room content to its webhook.
+    let mut request = bot_form("POST", &format!("/rooms/{room_id}/messages"), &cookie, &body);
+    request.headers_mut().insert(header::ACCEPT, "text/vnd.turbo-stream.html".parse().unwrap());
+    assert_eq!(send(router, request).await.status, StatusCode::OK);
+    test.booted.jobs.shutdown(Duration::from_secs(5)).await;
+    let replies = app.db.read(move |conn| Message::by_creator(conn, bot_id)).await.unwrap();
+    assert_eq!(replies.len(), expected_replies, "unsupported responses must not post messages");
+    assert!(requests.try_recv().is_err(), "repeated mentions must only trigger one callback");
+    server.abort();
+}
