@@ -0,0 +1,185 @@
+//! Best-effort bot callbacks. No network I/O runs on the message poster's request.
+
+use std::time::Duration;
+
+use anyhow::{Context, bail};
+use campfire_db::{Bot, Message, NewMessage, Room, User};
+use campfire_richtext::uri::{self, Uri};
+use futures_util::{StreamExt, stream};
+use serde_json::json;
+
+use super::net::{Network, http};
+use crate::app::App;
+use crate::controllers::{messages, presenters::DbResolver};
+
+const TIMEOUT: Duration = Duration::from_secs(15);
+const MAX_REPLY_BYTES: usize = 1024 * 1024;
+
+/// Explicitly configured internal bot services are supported. Never follow redirects: the
+/// payload contains the bot's posting credential and must only go to its configured endpoint.
+pub fn endpoint(url: &str) -> anyhow::Result<(Uri, http::Endpoint)> {
+    let uri = uri::parse(url).map_err(|_| anyhow::anyhow!("invalid webhook URL"))?;
+    if !uri.is_http() || uri.userinfo.is_some() || uri.fragment.is_some() {
+        bail!("invalid webhook URL");
+    }
+    let host = uri.host.clone().filter(|s| !s.is_empty()).context("missing webhook host")?;
+    let https = uri.scheme.as_deref().is_some_and(|s| s.eq_ignore_ascii_case("https"));
+    let port = u16::try_from(uri.port.unwrap_or(if https { 443 } else { 80 })).context("invalid webhook port")?;
+    if port == 0 {
+        bail!("invalid webhook port");
+    }
+    Ok((uri, http::Endpoint { https, host, port, pinned_ip: None }))
+}
+
+struct Delivery {
+    bot: Bot,
+    room: Room,
+    payload: serde_json::Value,
+}
+
+pub fn mention_later(app: &App, message_id: i64, base_url: String) {
+    let app2 = app.clone();
+    app.jobs.perform_later("Bot::MentionJob", async move {
+        let app = app2;
+        let context = app.clone();
+        let deliveries = app
+            .db
+            .read_offloaded(move |conn| {
+                let message = Message::find(conn, message_id)?;
+                // Bots can answer mentions, but their answers must not start callback loops.
+                match Bot::find(conn, message.creator_id) {
+                    Ok(_) => return Ok(Vec::new()),
+                    Err(campfire_db::Error::RecordNotFound(_)) => {}
+                    Err(error) => return Err(error),
+                }
+                let author = User::find(conn, message.creator_id)?;
+                let room = Room::find(conn, message.room_id)?;
+                let html = message.body_html(conn)?.unwrap_or_default();
+                let resolver = DbResolver { conn, secrets: &context.secrets, now: context.clock.now() };
+                let ctx = resolver.render_context(None);
+                let mut deliveries = Vec::new();
+                for user in message.mentionees(conn, &*context.db.env().rich_text)? {
+                    let bot = match Bot::find(conn, user.id) {
+                        Ok(bot) if bot.webhook_url.is_some() => bot,
+                        Ok(_) | Err(campfire_db::Error::RecordNotFound(_)) => continue,
+                        Err(error) => return Err(error),
+                    };
+                    let text = campfire_richtext::to_plain_text_without_mention(&html, user.id, &ctx).map_err(campfire_db::Error::other)?;
+                    let payload = json!({
+                        "event": "mention",
+                        "author": { "id": author.id, "name": author.name },
+                        "room": { "id": room.id, "name": room.name,
+                            "reply_to": format!("/rooms/{}/{}/messages", room.id, bot.code) },
+                        "message": { "id": message.id, "body": { "text": text, "html": html },
+                            "link": campfire_routes::room_at_message(room.id, message.id) }
+                    });
+                    deliveries.push(Delivery { bot, room: room.clone(), payload });
+                }
+                Ok(deliveries)
+            })
+            .await?;
+        // A failing endpoint must not prevent another mentioned bot from receiving its callback.
+        stream::iter(deliveries)
+            .for_each_concurrent(4, |delivery| {
+                let app = app.clone();
+                let base_url = base_url.clone();
+                async move {
+                    let bot_id = delivery.bot.user.id;
+                    if let Err(error) = deliver(&app, delivery, base_url).await {
+                        tracing::warn!(bot_id, message_id, %error, "bot callback failed");
+                    }
+                }
+            })
+            .await;
+        Ok(())
+    });
+}
+
+async fn deliver(app: &App, delivery: Delivery, base_url: String) -> anyhow::Result<()> {
+    let url = delivery.bot.webhook_url.as_deref().context("missing webhook URL")?;
+    let (uri, endpoint) = endpoint(url)?;
+    let mut request = http::Request::net_http(
+        hyper::Method::POST,
+        http::request_uri(&uri),
+        Some(endpoint.host_header()),
+        vec![("Content-Type".into(), "application/json".into())],
+    );
+    request.body = serde_json::to_vec(&delivery.payload)?;
+    let reply = tokio::time::timeout(TIMEOUT, async {
+        let response = http::exchange(&Network::system(), &endpoint, request, &http::Timeouts { open: TIMEOUT, read: TIMEOUT }).await?;
+        if response.status == 204 {
+            return Ok(None);
+        }
+        if response.status != 200 {
+            bail!("webhook returned HTTP {}", response.status);
+        }
+        let content_type = response.content_type().unwrap_or_default().to_ascii_lowercase();
+        if !matches!(content_type.as_str(), "text/plain" | "text/html") {
+            return Ok(None);
+        }
+        let http::Body::Complete(bytes) = response.read_body(MAX_REPLY_BYTES).await? else {
+            bail!("webhook reply too large");
+        };
+        let body = String::from_utf8(bytes).context("webhook reply is not UTF-8")?;
+        if body.trim().is_empty() {
+            return Ok(None);
+        }
+        let body = if content_type == "text/plain" { ruby_compat::erb::html_escape(&body).replace('\n', "<br>") } else { body };
+        Ok::<_, anyhow::Error>(Some(body))
+    })
+    .await
+    .context("webhook timed out")??;
+    let Some(body) = reply else { return Ok(()) };
+    let body = messages::canonicalize_body(app, body, None).await.map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    let bot = delivery.bot;
+    let room = delivery.room;
+    let room_id = room.id;
+    let message = app
+        .db
+        .write(move |tx| {
+            // Recheck access after the HTTP call: deletion, webhook removal, or membership revocation
+            // while waiting must not grant the callback permission to post.
+            let current = match Bot::find(tx.conn(), bot.user.id) {
+                Ok(current) => current,
+                Err(campfire_db::Error::RecordNotFound(_)) => return Ok(None),
+                Err(error) => return Err(error),
+            };
+            if current.webhook_url != bot.webhook_url
+                || current.code != bot.code
+                || Room::find_for_user(tx.conn(), bot.user.id, room_id)?.is_none()
+            {
+                return Ok(None);
+            }
+            Message::create(tx, NewMessage { room_id, creator_id: bot.user.id, body: Some(body), ..Default::default() }).map(Some)
+        })
+        .await?;
+    if let Some(message) = message {
+        messages::broadcast_create_at(app, &room, &message, base_url)
+            .await
+            .map_err(|error| anyhow::anyhow!(error.to_string()))?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn webhook_urls_require_http_and_an_unambiguous_destination() {
+        for url in [
+            "", "/relative", "https:///", "ftp://host/file", "http://user:pass@host/", "http://host/#fragment", "http://host:0/", "http://host:65536/",
+        ] {
+            assert!(endpoint(url).is_err(), "{url}");
+        }
+        for (url, https, port) in [
+            ("http://localhost/", false, 80),
+            ("https://example.test/hook?q=1", true, 443),
+            ("http://[::1]:8080/", false, 8080),
+        ] {
+            let (_, endpoint) = endpoint(url).unwrap();
+            assert_eq!(endpoint.https, https);
+            assert_eq!(endpoint.port, port);
+        }
+    }
+}
