+
+/// Plain command text addressed to a user, removing only their verified mention attachments.
+pub fn to_plain_text_without_mention(body: &str, user_id: i64, ctx: &RenderContext) -> Result<String, Error> {
+    let mut content = Content::load(body, ctx)?;
+    for node in attachment_nodes(&content.dom, content.root) {
+        if let attachables::Attachable::User(user) = attachables::action_text_attachable_from_node(&content.dom, node, ctx)
+            && user.id == user_id
+        {
+            content.dom.detach(node);
+        }
+    }
+    Ok(content.to_plain_text(ctx)?.trim().to_string())
+}
