+#[test]
+fn bot_join_rollback_does_not_consume_the_first_join() {
+    use crate::{Bot, PasswordDigest, Room, RoomType};
+    let t = TestDb::new();
+    let bot = t.write(|tx| Bot::create(tx, id("david"), "Bot".into(), PasswordDigest::create("secret", 4)?));
+    let bot_id = bot.user.id;
+    let room = t.write(|tx| Room::create(tx, RoomType::Closed, Some("Private"), id("david")));
+    let room_id = room.id;
+    t.sink.take();
+    let result: Result<()> = t.try_write(move |tx| {
+        Room::find(tx.conn(), room_id)?.grant_to(tx, &[bot_id])?;
+        Err(crate::Error::RecordNotFound("rollback"))
+    });
+    assert!(result.is_err());
+    assert!(t.events().is_empty());
+    t.write(move |tx| Room::find(tx.conn(), room_id)?.grant_to(tx, &[bot_id]));
+    assert_eq!(t.events(), vec![Event::BotJoined { user_id: bot_id, room_id }]);
+}
+
+#[test]
+fn only_opted_in_bots_join_rooms_that_become_open() {
+    use crate::{Bot, PasswordDigest, Room, RoomType};
+    let t = TestDb::new();
+    let (selected, everyone) = t.write(|tx| {
+        let selected = Bot::create(tx, id("david"), "Selected".into(), PasswordDigest::create("secret", 4)?)?;
+        let mut everyone = Bot::create(tx, id("david"), "Everyone".into(), PasswordDigest::create("secret", 4)?)?;
+        everyone.set_add_to_all_open_rooms(tx, true)?;
+        Ok((selected.user.id, everyone.user.id))
+    });
+    let room = t.write(|tx| Room::create(tx, RoomType::Closed, Some("Changing"), id("david")));
+    let room_id = room.id;
+    assert!(t.read(|conn| Membership::find_by_room_and_user(conn, room_id, everyone)).is_none());
+    t.sink.take();
+    t.write(move |tx| Room::find(tx.conn(), room_id)?.update(tx, None, Some(RoomType::Open)));
+    assert_eq!(t.sink.take(), vec![Event::BotJoined { user_id: everyone, room_id }]);
+    assert!(t.read(|conn| Membership::find_by_room_and_user(conn, room_id, selected)).is_none());
+    assert!(t.read(|conn| Membership::find_by_room_and_user(conn, room_id, everyone)).is_some());
+    t.write(move |tx| Room::find(tx.conn(), room_id)?.grant_to(tx, &[selected]));
+    assert_eq!(t.sink.take(), vec![Event::BotJoined { user_id: selected, room_id }]);
+    t.write(move |tx| Room::find(tx.conn(), room_id)?.destroy(tx));
+    let count: i64 = t.read(|conn| Ok(conn.query_row("SELECT COUNT(*) FROM chat_bot_room_joins WHERE room_id = ?", [room_id], |r| r.get(0))?));
+    assert_eq!(count, 0);
+    t.write(move |tx| Bot::find(tx.conn(), everyone)?.destroy(tx));
+    let count: i64 = t.read(|conn| Ok(conn.query_row("SELECT COUNT(*) FROM chat_bot_auto_join WHERE user_id = ?", [everyone], |r| r.get(0))?));
+    assert_eq!(count, 0);
+}
