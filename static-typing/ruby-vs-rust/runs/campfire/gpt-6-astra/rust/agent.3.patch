+    let t = TestDb::new();
+    let bot = t.write(|tx| Bot::create(tx, id("david"), "Bot".into(), PasswordDigest::create("secret", 4)?));
+    let bot_id = bot.user.id;
+    let open_ids: Vec<i64> = t.read(|conn| crate::query_all(conn, "SELECT id FROM rooms WHERE type = 'Rooms::Open'", [], |r| r.get(0)));
+    assert!(!open_ids.is_empty());
+    t.sink.take();
+    t.write(move |tx| Bot::find(tx.conn(), bot_id)?.set_add_to_all_open_rooms(tx, true));
+    for room_id in &open_ids {
+        assert!(t.read(|conn| Membership::find_by_room_and_user(conn, *room_id, bot_id)).is_some());
+    }
+    assert_eq!(t.events().len(), open_ids.len());
+    assert!(t.events().iter().all(|e| matches!(e, Event::BotJoined { user_id, .. } if *user_id == bot_id)));
+    t.sink.take();
+    t.write(move |tx| Bot::find(tx.conn(), bot_id)?.set_add_to_all_open_rooms(tx, true));
+    assert!(t.events().is_empty());
+
+    let open = t.write(|tx| Room::create(tx, RoomType::Open, Some("Future"), id("david")));
+    let room_id = open.id;
+    assert_eq!(t.sink.take(), vec![Event::BotJoined { user_id: bot_id, room_id }]);
+    assert!(t.read(|conn| Membership::find_by_room_and_user(conn, room_id, bot_id)).is_some());
+    // Saves, repeated grants and removal/re-addition never repeat a greeting.
+    t.write(move |tx| {
+        let mut room = Room::find(tx.conn(), room_id)?;
+        room.update(tx, Some(Some("Renamed")), None)?;
+        room.grant_to(tx, &[bot_id, bot_id])?;
+        room.revoke_from(tx, &[bot_id])?;
+        room.grant_to(tx, &[bot_id])
+    });
+    assert!(!t.sink.take().iter().any(|e| matches!(e, Event::BotJoined { .. })));
+
+    t.write(move |tx| Bot::find(tx.conn(), bot_id)?.set_add_to_all_open_rooms(tx, false));
+    assert!(!t.read(|conn| Bot::find(conn, bot_id)).add_to_all_open_rooms);
+    assert!(t.read(|conn| Membership::find_by_room_and_user(conn, room_id, bot_id)).is_some());
+    let later = t.write(|tx| Room::create(tx, RoomType::Open, Some("Later"), id("david")));
+    assert!(t.read(|conn| Membership::find_by_room_and_user(conn, later.id, bot_id)).is_none());
