+#[tokio::test]
+async fn bot_created_with_auto_join_sends_one_callback_per_open_room() {
+    use campfire_db::{Bot, Room, RoomType};
+    use std::time::Duration;
+    use tokio::sync::mpsc;
+
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Automatic owner").await;
+    let (received, mut requests) = mpsc::unbounded_channel();
+    let service = axum::Router::new().route("/callback", axum::routing::post(move |body: String| {
+        let received = received.clone();
+        async move {
+            received.send(serde_json::from_str::<serde_json::Value>(&body).unwrap()).unwrap();
+            StatusCode::NO_CONTENT
+        }
+    }));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move { axum::serve(listener, service).await.unwrap() });
+    let form = format!("bot[name]=Automatic&bot[webhook_url]=http://{address}/callback&bot[add_to_all_open_rooms]=1");
+    assert_eq!(send(router, bot_form("POST", "/bots", &cookie, &form)).await.status, StatusCode::FOUND);
+    let bot = app.db.read(move |conn| Ok(Bot::managed_by(conn, &owner)?.remove(0))).await.unwrap();
+    assert!(bot.add_to_all_open_rooms);
+    let bot_id = bot.user.id;
+    let rooms = app.db.read(move |conn| Room::for_user_of_type(conn, bot_id, RoomType::Open)).await.unwrap();
+    assert!(!rooms.is_empty());
+    let mut received_ids = Vec::new();
+    for _ in &rooms {
+        let payload = tokio::time::timeout(Duration::from_secs(5), requests.recv()).await.unwrap().unwrap();
+        assert_eq!(payload["event"], "joined");
+        received_ids.push(payload["room"]["id"].as_i64().unwrap());
+    }
+    for room in rooms {
+        assert_eq!(received_ids.iter().filter(|id| **id == room.id).count(), 1);
+    }
+    test.booted.jobs.shutdown(Duration::from_secs(5)).await;
+    assert!(requests.try_recv().is_err());
+    server.abort();
+}
