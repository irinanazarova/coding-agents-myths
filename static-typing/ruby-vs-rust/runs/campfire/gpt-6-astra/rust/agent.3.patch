+#[tokio::test]
+async fn bots_can_be_selected_in_open_room_forms() {
+    use campfire_db::{Bot, Membership};
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Selective owner").await;
+    assert_eq!(send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Selective")).await.status, StatusCode::FOUND);
+    let bot_id = app.db.read(move |conn| Ok(Bot::managed_by(conn, &owner)?[0].user.id)).await.unwrap();
+    let form = format!("room[name]=Chosen&bot_ids[]=&bot_ids[]={bot_id}");
+    let created = send(router, bot_form("POST", "/rooms/opens", &cookie, &form)).await;
+    assert_eq!(created.status, StatusCode::FOUND);
+    let room_id: i64 = created.header("location").unwrap().rsplit('/').next().unwrap().parse().unwrap();
+    let is_member = || async {
+        app.db.read(move |conn| Ok(Membership::find_by_room_and_user(conn, room_id, bot_id)?.is_some())).await.unwrap()
+    };
+    assert!(is_member().await);
+    let path = format!("/rooms/opens/{room_id}");
+    // Older clients omitting bot_ids must not accidentally revoke memberships.
+    assert_eq!(send(router, bot_form("PATCH", &path, &cookie, "room[name]=Chosen")).await.status, StatusCode::FOUND);
+    assert!(is_member().await);
+    assert_eq!(send(router, bot_form("PATCH", &path, &cookie, "room[name]=Chosen&bot_ids[]=")).await.status, StatusCode::FOUND);
+    assert!(!is_member().await);
+    assert_eq!(send(router, bot_form("PATCH", &path, &cookie, &form)).await.status, StatusCode::FOUND);
+    assert!(is_member().await);
+    assert_eq!(send(router, bot_form("PATCH", &format!("/bots/{bot_id}"), &cookie,
+        "bot[name]=Selective&bot[add_to_all_open_rooms]=1")).await.status, StatusCode::FOUND);
+    assert_eq!(send(router, bot_form("PATCH", &path, &cookie, "room[name]=Chosen&bot_ids[]=")).await.status, StatusCode::FOUND);
+    assert!(is_member().await, "an automatic bot remains in every open room");
+}
