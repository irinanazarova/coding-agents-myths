+#[tokio::test]
+async fn bots_per_member_default_limit() {
+    use campfire_db::Bot;
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Limited owner").await;
+    for n in 0..5 {
+        let reply = send(router, bot_form("POST", "/bots", &cookie, &format!("bot[name]=Bot+{n}"))).await;
+        assert_eq!(reply.status, StatusCode::FOUND);
+    }
+    let list = send(router, get_with_cookie("/bots", &cookie)).await;
+    assert!(list.text().contains("reached the limit"));
+    assert!(!list.text().contains("Add a chat bot"));
+    assert_eq!(send(router, get_with_cookie("/bots/new", &cookie)).await.status, StatusCode::FORBIDDEN);
+    assert_eq!(send(router, bot_form("POST", "/bots", &cookie, "bot[name]=One+too+many")).await.status, StatusCode::UNPROCESSABLE_ENTITY);
+    let manager = owner.clone();
+    let bots = app.db.read(move |conn| Bot::managed_by(conn, &manager)).await.unwrap();
+    assert_eq!(bots.len(), 5);
+    let id = bots[0].user.id;
+    assert_eq!(send(router, bot_form("PATCH", &format!("/bots/{id}"), &cookie, "bot[name]=Renamed")).await.status, StatusCode::FOUND);
+    assert_eq!(send(router, bot_form("DELETE", &format!("/bots/{id}"), &cookie, "")).await.status, StatusCode::FOUND);
+    let list = send(router, get_with_cookie("/bots", &cookie)).await;
+    assert!(list.text().contains("Add a chat bot"));
+    assert!(!list.text().contains("reached the limit"));
+    assert_eq!(send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Replacement")).await.status, StatusCode::FOUND);
+    let (_, other_cookie) = bot_member(app, "Independent owner").await;
+    assert_eq!(send(router, bot_form("POST", "/bots", &other_cookie, "bot[name]=Independent")).await.status, StatusCode::FOUND);
+}
+
+#[tokio::test]
+async fn bots_per_member_setting_and_admin_exemption() {
+    use campfire_db::{Account, Bot, Role, User, UserChanges};
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Capped member").await;
+    let (admin, admin_cookie) = bot_member(app, "Bot administrator").await;
+    let admin_id = admin.id;
+    app.db.write(move |tx| User::find(tx.conn(), admin_id)?.update(tx, UserChanges { role: Some(Role::Administrator), ..Default::default() })).await.unwrap();
+    let account = app.db.read(Account::first).await.unwrap().unwrap();
+    let action = format!("/account.{}", account.id);
+    let edit = send(router, get_with_cookie("/account/edit", &admin_cookie)).await;
+    assert!(edit.text().contains("Bots per member"));
+    let html = edit.text();
+    let limit_position = html.find("id=\"account_settings_bots_per_member\"").unwrap();
+    let form_start = html[..limit_position].rfind("<form").unwrap();
+    assert!(html[form_start..limit_position].contains("Save changes"), "use the existing account save form");
+    assert!(edit.text().contains("name=\"account[settings][bots_per_member]\" value=\"5\""));
+    assert!(!send(router, get_with_cookie("/account/edit", &cookie)).await.text().contains("Bots per member"));
+    assert_eq!(send(router, bot_form("PATCH", &action, &cookie, "account[settings][bots_per_member]=100")).await.status, StatusCode::FORBIDDEN);
+    for invalid in ["-1", "1.5", "abc", "", "9223372036854775808"] {
+        let reply = send(router, bot_form("PATCH", &action, &admin_cookie, &format!("account[settings][bots_per_member]={invalid}"))).await;
+        assert_eq!(reply.status, StatusCode::UNPROCESSABLE_ENTITY, "invalid value {invalid}");
+    }
+    for n in 0..3 {
+        assert_eq!(send(router, bot_form("POST", "/bots", &cookie, &format!("bot[name]=Existing+{n}"))).await.status, StatusCode::FOUND);
+    }
+    for limit in [2, 0] {
+        assert_eq!(send(router, bot_form("PATCH", &action, &admin_cookie, &format!("account[settings][bots_per_member]={limit}"))).await.status, StatusCode::FOUND);
+        let edit = send(router, get_with_cookie("/account/edit", &admin_cookie)).await;
+        assert!(edit.text().contains(&format!("name=\"account[settings][bots_per_member]\" value=\"{limit}\"")));
+        assert_eq!(send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Blocked")).await.status, StatusCode::UNPROCESSABLE_ENTITY);
+        let manager = owner.clone();
+        assert_eq!(app.db.read(move |conn| Ok(Bot::managed_by(conn, &manager)?.len())).await.unwrap(), 3);
+    }
+    let (_, empty_cookie) = bot_member(app, "Zero bots member").await;
+    assert_eq!(send(router, bot_form("POST", "/bots", &empty_cookie, "bot[name]=Blocked+at+zero")).await.status, StatusCode::UNPROCESSABLE_ENTITY);
+    assert!(!send(router, get_with_cookie("/bots", &empty_cookie)).await.text().contains("Add a chat bot"));
+    // Administrators remain unlimited even at zero, including beyond the default cap.
+    for n in 0..6 {
+        assert_eq!(send(router, bot_form("POST", "/bots", &admin_cookie, &format!("bot[name]=Admin+{n}"))).await.status, StatusCode::FOUND);
+    }
+    assert!(send(router, get_with_cookie("/bots", &admin_cookie)).await.text().contains("Add a chat bot"));
+    assert_eq!(send(router, get_with_cookie("/bots/new", &admin_cookie)).await.status, StatusCode::OK);
+    // Increasing the limit restores creation without touching existing bots.
+    assert_eq!(send(router, bot_form("PATCH", &action, &admin_cookie, "account[settings][bots_per_member]=4")).await.status, StatusCode::FOUND);
+    assert!(send(router, get_with_cookie("/bots", &cookie)).await.text().contains("Add a chat bot"));
+    assert_eq!(send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Fourth")).await.status, StatusCode::FOUND);
+}
+
+#[tokio::test]
+async fn bots_per_member_concurrent_creates_cannot_exceed_limit() {
+    use campfire_db::{Account, Bot, PasswordDigest, User};
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Concurrent owner").await;
+    app.db.write(|tx| Account::first(tx.conn())?.unwrap().update(tx, None, None, Some(&[("bots_per_member", "1")]))).await.unwrap();
+    let (first, second) = tokio::join!(
+        send(router, bot_form("POST", "/bots", &cookie, "bot[name]=First")),
+        send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Second")),
+    );
+    let mut statuses = [first.status.as_u16(), second.status.as_u16()];
+    statuses.sort();
+    assert_eq!(statuses, [302, 422]);
+    // Even callers bypassing the controller are refused without creating an orphan user.
+    let before = app.db.read(User::count).await.unwrap();
+    let owner_id = owner.id;
+    let digest = PasswordDigest::hash("test password".into(), 4).await.unwrap();
+    let result = app.db.write(move |tx| Bot::create(tx, owner_id, "Bypass".into(), digest)).await;
+    assert!(matches!(result, Err(campfire_db::Error::RecordInvalid(_))));
+    assert_eq!(app.db.read(User::count).await.unwrap(), before);
+    let bots = app.db.read(move |conn| Bot::managed_by(conn, &owner)).await.unwrap();
+    assert_eq!(bots.len(), 1);
+}
