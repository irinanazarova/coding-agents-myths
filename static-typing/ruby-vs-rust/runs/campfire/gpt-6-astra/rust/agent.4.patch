+    pub fn can_create(conn: &Connection, creator: &User) -> Result<bool> {
+        if creator.role == Role::Administrator {
+            return Ok(true);
+        }
+        let limit = Account::first(conn)?.ok_or(crate::Error::RecordNotFound("Account"))?.settings().bots_per_member();
+        let count = sql::count(
+            conn,
+            "SELECT COUNT(*) FROM chat_bots b JOIN users u ON u.id = b.user_id WHERE b.creator_id = ? AND u.status = 0",
+            [creator.id],
+        )?;
+        Ok(count < limit)
+    }
+
     pub fn create(tx: &mut Tx<'_>, creator_id: i64, name: String, password_digest: PasswordDigest) -> Result<Self> {
+        // Count and insert in the same write transaction, including a fresh role/settings check.
+        if !Self::can_create(tx.conn(), &User::find(tx.conn(), creator_id)?)? {
+            let mut errors = Errors::default();
+            errors.add("bots", "have reached the limit");
+            return Err(crate::Error::RecordInvalid(errors));
+        }
         let user = User::create(tx, NewUser { name, password_digest: Some(password_digest), ..Default::default() })?;
         let code = sql::base58(32);
         tx.conn().execute("INSERT INTO chat_bots (user_id, creator_id, code) VALUES (?, ?, ?)", params![user.id, creator_id, code])?;
