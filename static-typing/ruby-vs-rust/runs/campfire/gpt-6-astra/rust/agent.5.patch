+#[tokio::test]
+async fn bot_webhook_failure_streaks_and_suspended_delivery() {
+    use campfire_db::{Bot, Event, Room, RoomType};
+    use std::sync::{Arc, atomic::{AtomicU16, AtomicUsize, Ordering}};
+    let test = boot_seeded().await;
+    let app = &test.booted.app;
+    let router = &test.booted.router;
+    let (owner, cookie) = bot_member(app, "Webhook safety owner").await;
+    let owner_id = owner.id;
+    send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Safety+bot")).await;
+    let bot = app.db.read(move |conn| Ok(Bot::managed_by(conn, &owner)?.remove(0))).await.unwrap();
+    let user_id = bot.user.id;
+    let room = app.db.read(move |conn| Ok(Room::for_user_of_type(conn, owner_id, RoomType::Open)?.remove(0))).await.unwrap();
+    let room_id = room.id;
+    // This test invokes delivery synchronously rather than enqueueing joined callbacks.
+    app.db.write(move |tx| {
+        tx.conn().execute("INSERT INTO memberships (room_id, user_id, created_at, updated_at) VALUES (?, ?, ?, ?)",
+            (room_id, user_id, tx.now(), tx.now()))?;
+        Ok(())
+    }).await.unwrap();
+    let status = Arc::new(AtomicU16::new(500));
+    let calls = Arc::new(AtomicUsize::new(0));
+    let service = axum::Router::new().route("/", axum::routing::post({
+        let status = status.clone();
+        let calls = calls.clone();
+        move || {
+            let status = status.clone();
+            let calls = calls.clone();
+            async move {
+                calls.fetch_add(1, Ordering::SeqCst);
+                let code = status.load(Ordering::SeqCst);
+                if code == 0 {
+                    tokio::time::sleep(std::time::Duration::from_secs(60)).await;
+                    return (StatusCode::OK, [("content-type", "text/plain")], "late");
+                }
+                let content_type = if code == 203 { "text/plain" } else { "application/json" };
+                (StatusCode::from_u16(code).unwrap(), [("content-type", content_type)], "{}")
+            }
+        }
+    }));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move { axum::serve(listener, service).await.unwrap() });
+    app.db.write(move |tx| Bot::find(tx.conn(), user_id)?.set_webhook(tx, Some(&format!("http://{address}/")))).await.unwrap();
+    let deliver = || crate::integrations::bot_webhooks::joined(app.clone(), Event::BotJoined { user_id, room_id });
+    for _ in 0..9 { assert!(deliver().await.is_err()); }
+    assert!(app.db.read(move |conn| Bot::find(conn, user_id)).await.unwrap().suspension_reason.is_none());
+    // Every 2xx is successful, even with no usable reply.
+    for code in [200, 201, 202, 204, 299] {
+        status.store(code, Ordering::SeqCst);
+        deliver().await.unwrap();
+        status.store(302, Ordering::SeqCst);
+        for _ in 0..9 { assert!(deliver().await.is_err()); }
+        assert!(app.db.read(move |conn| Bot::find(conn, user_id)).await.unwrap().suspension_reason.is_none());
+    }
+    assert!(deliver().await.is_err());
+    let suspended = app.db.read(move |conn| Bot::find(conn, user_id)).await.unwrap();
+    assert!(suspended.suspension_reason.unwrap().contains("Failing webhooks"));
+    let before = calls.load(Ordering::SeqCst);
+    deliver().await.unwrap();
+    assert_eq!(calls.load(Ordering::SeqCst), before);
+    let path = format!("/rooms/{room_id}/{}/messages", bot.code);
+    assert_eq!(send(router, bot_post(&path, "text/plain", "blocked")).await.status, StatusCode::FORBIDDEN);
+    // Only an explicit administrator action restores either kind of suspended bot.
+    app.db.write(move |tx| campfire_db::User::find(tx.conn(), owner_id)?.update(tx,
+        campfire_db::UserChanges { role: Some(campfire_db::Role::Administrator), ..Default::default() })).await.unwrap();
+    let reactivate = format!("/bots/{user_id}/reactivate");
+    assert_eq!(send(router, bot_form("POST", &reactivate, &cookie, "")).await.status, StatusCode::FOUND);
+    status.store(203, Ordering::SeqCst);
+    for _ in 0..5 {
+        assert_eq!(send(router, bot_post(&path, "text/plain", "API half")).await.status, StatusCode::CREATED);
+        deliver().await.unwrap();
+    }
+    // Five API posts plus five replies fill the same rolling window.
+    for _ in 0..6 { deliver().await.unwrap(); }
+    assert!(app.db.read(move |conn| Bot::find(conn, user_id)).await.unwrap().suspension_reason.unwrap().contains("Flooding"));
+    let count = app.db.read(move |conn| campfire_db::query_one(conn,
+        "SELECT COUNT(*) FROM messages WHERE creator_id = ?", [user_id], |row| row.get::<_, i64>(0))).await.unwrap();
+    assert_eq!(count, Some(10), "replies during cooldown must not be posted");
+    assert_eq!(send(router, bot_form("POST", &reactivate, &cookie, "")).await.status, StatusCode::FOUND);
+    status.store(0, Ordering::SeqCst);
+    assert!(deliver().await.is_err(), "timeout must be a failed delivery");
+    server.abort();
+    let _ = server.await;
+    for _ in 0..8 { assert!(deliver().await.is_err()); }
+    assert!(app.db.read(move |conn| Bot::find(conn, user_id)).await.unwrap().suspension_reason.is_none());
+    assert!(deliver().await.is_err());
+    assert!(app.db.read(move |conn| Bot::find(conn, user_id)).await.unwrap().suspension_reason.unwrap().contains("Failing webhooks"));
+}
