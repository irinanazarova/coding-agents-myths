+fn posting_rejection(c: &mut Ctx, status: BotPostStatus) -> Option<campfire_kit::Response> {
+    match status {
+        BotPostStatus::Allowed => None,
+        BotPostStatus::Suspended => Some(c.head(StatusCode::FORBIDDEN)),
+        BotPostStatus::Cooldown(seconds) => {
+            c.set_header("retry-after", &seconds.to_string());
+            Some(c.head(StatusCode::TOO_MANY_REQUESTS))
+        }
+    }
 }
 
