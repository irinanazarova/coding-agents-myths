+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::tests::{TestDb, id};
+
+    fn bot(db: &TestDb, label: &'static str) -> i64 {
+        let user_id = id(label);
+        db.write(move |tx| {
+            tx.conn().execute("INSERT INTO chat_bots (user_id, creator_id, code) VALUES (?, ?, ?)", params![user_id, id("david"), label])?;
+            Ok(user_id)
+        })
+    }
+
+    #[test]
+    fn rolling_window_cooldown_boundaries_and_independent_bots() {
+        let db = TestDb::new();
+        db.clock.travel_to("2026-01-01T00:00:00Z".parse().unwrap());
+        let first = bot(&db, "david");
+        let second = bot(&db, "jason");
+        for _ in 0..5 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+        }
+        db.travel(5);
+        for _ in 0..5 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+        }
+        db.travel(5);
+        // Exactly ten seconds old is outside the rolling window.
+        for _ in 0..5 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+        }
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Cooldown(30));
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, second)), BotPostStatus::Allowed);
+        db.clock.travel(jiff::SignedDuration::from_millis(29_001));
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Cooldown(1));
+        db.clock.travel(jiff::SignedDuration::from_millis(999));
+        for _ in 0..10 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+        }
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Cooldown(30));
+        for _ in 0..4 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Cooldown(30));
+        }
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Suspended);
+        db.travel(1000);
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Suspended);
+        assert!(db.read(|conn| Bot::find(conn, first)).suspension_reason.unwrap().contains("Flooding"));
+        db.write(move |tx| Bot::reactivate(tx, first, id("david")));
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+    }
+
+    #[test]
+    fn safety_state_survives_reopening_the_database() {
+        let test = TestDb::new();
+        test.clock.travel_to("2026-01-01T00:00:00Z".parse().unwrap());
+        let user_id = bot(&test, "david");
+        for _ in 0..10 {
+            assert_eq!(test.write(move |tx| Bot::accept_post(tx, user_id)), BotPostStatus::Allowed);
+        }
+        assert_eq!(test.write(move |tx| Bot::accept_post(tx, user_id)), BotPostStatus::Cooldown(30));
+        let path = test.db.path().to_owned();
+        let env = test.db.env().clone();
+        drop(test.db);
+        let db = crate::Database::open(crate::Config::new(&path), env.clone()).unwrap();
+        for _ in 0..4 {
+            assert_eq!(db.write_blocking(move |tx| Bot::accept_post(tx, user_id)).unwrap(), BotPostStatus::Cooldown(30));
+        }
+        assert_eq!(db.write_blocking(move |tx| Bot::accept_post(tx, user_id)).unwrap(), BotPostStatus::Suspended);
+        drop(db);
+        let db = crate::Database::open(crate::Config::new(&path), env).unwrap();
+        assert_eq!(db.write_blocking(move |tx| Bot::accept_post(tx, user_id)).unwrap(), BotPostStatus::Suspended);
+    }
+
+    #[test]
+    fn webhook_streaks_reset_and_old_results_cannot_resuspend() {
+        let db = TestDb::new();
+        let user_id = bot(&db, "david");
+        for _ in 0..9 {
+            db.write(move |tx| Bot::record_webhook_result(tx, user_id, 0, false));
+        }
+        assert!(db.read(|conn| Bot::find(conn, user_id)).suspension_reason.is_none());
+        db.write(move |tx| Bot::record_webhook_result(tx, user_id, 0, true));
+        for _ in 0..9 {
+            db.write(move |tx| Bot::record_webhook_result(tx, user_id, 0, false));
+        }
+        assert!(db.read(|conn| Bot::find(conn, user_id)).suspension_reason.is_none());
+        db.write(move |tx| Bot::record_webhook_result(tx, user_id, 0, false));
+        assert!(db.read(|conn| Bot::find(conn, user_id)).suspension_reason.unwrap().contains("Failing webhooks"));
+        db.write(move |tx| Bot::record_webhook_result(tx, user_id, 0, true));
+        assert!(db.read(|conn| Bot::find(conn, user_id)).suspension_reason.is_some());
+        db.write(move |tx| Bot::reactivate(tx, user_id, id("david")));
+        for _ in 0..10 {
+            db.write(move |tx| Bot::record_webhook_result(tx, user_id, 0, false));
+        }
+        assert!(db.read(|conn| Bot::find(conn, user_id)).suspension_reason.is_none());
+        for _ in 0..10 {
+            db.write(move |tx| Bot::record_webhook_result(tx, user_id, 1, false));
+        }
+        assert!(db.read(|conn| Bot::find(conn, user_id)).suspension_reason.is_some());
+    }
+}
