+{% extends "layouts/application.html" %}
+{% block head %}<meta name="turbo-cache-control" content="no-cache">{% endblock %}
+{% block nav %}{{ h::link_to(h::routes::edit_account().as_str(), h::attrs().class("btn"), "Account settings") }}{% endblock %}
+{% block content %}
+<section class="panel flex flex-column gap">
+  <h1>Chat bots</h1>
+  {% if can_create %}
+  {{ h::link_to(h::routes::new_bot().as_str(), h::attrs().class("btn btn--positive"), "Add a chat bot") }}
+  {% else %}
+  <p>You've reached the limit for chat bots.</p>
+  {% endif %}
+  <p>Bots can post messages to rooms they belong to. Keep bot codes secret.</p>
+  <ul class="flex flex-column gap unlist">
+  {% for bot in bots %}
+    <li class="pad fill-shade border-radius flex flex-column gap">
+      <div class="flex align-center gap">
+        {{ h::image_tag(ctx, bot.user.avatar_path.as_str(), h::attrs().class("avatar").size(48).aria_hidden()) }}
+        <h2>{{ bot.user.name }}</h2>
+      </div>
+      {% if let Some(reason) = bot.suspension_reason %}
+      <p><strong>Suspended</strong>: {{ reason }}</p>
+      {% if can_reactivate %}
+      {% filter button_to(h::routes::reactivate_bot(bot.user.id), h::attrs().method("post").class("btn").data("turbo-confirm", "Are you sure you want to reactivate this chat bot?")) %}Reactivate{% endfilter %}
+      {% endif %}
+      {% endif %}
+      <label for="bot_code_{{ bot.user.id }}">Bot code</label>
+      <input id="bot_code_{{ bot.user.id }}" class="input" type="text" value="{{ bot.code }}" readonly autocomplete="off" spellcheck="false" data-1p-ignore>
+      <a class="btn" href="{{ h::routes::edit_bot(bot.user.id) }}">Edit {{ bot.user.name }}</a>
+    </li>
+  {% endfor %}
+  </ul>
+</section>
+{% endblock %}
