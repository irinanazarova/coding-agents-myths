+        param.as_array().unwrap_or_default().iter().filter_map(|id| id.as_str()).filter_map(ruby_compat::integer_cast).collect()
+    })
+}
+
+fn revise_bots(tx: &mut campfire_db::Tx<'_>, room: &Room, selected: Option<Vec<i64>>) -> campfire_db::Result<()> {
+    let Some(selected) = selected else { return Ok(()) };
+    // Only bot memberships can be changed here. People always keep open-room access,
+    // and an opted-in bot cannot be removed from one open room in isolation.
+    let bot_ids: Vec<i64> = campfire_db::query_all(
+        tx.conn(),
+        "SELECT b.user_id FROM chat_bots b JOIN users u ON u.id = b.user_id WHERE u.status = 0",
+        [],
+        |r| r.get(0),
+    )?;
+    let (mut granted, mut revoked) = (Vec::new(), Vec::new());
+    for id in bot_ids {
+        if selected.contains(&id) || Bot::find(tx.conn(), id)?.add_to_all_open_rooms {
+            granted.push(id);
+        } else {
+            revoked.push(id);
+        }
+    }
+    room.revise(tx, &granted, &revoked)
+}
