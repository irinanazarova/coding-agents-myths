+#[tokio::test]
+async fn bot_joined_webhooks_and_auto_join_switch() {
+    use campfire_db::{Bot, Membership, Message, Room, RoomType};
+    use serde_json::json;
+    use std::time::Duration;
+    use tokio::sync::mpsc;
+
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Greeting owner").await;
+    let owner_id = owner.id;
+    let new = send(router, get_with_cookie("/bots/new", &cookie)).await;
+    assert!(new.text().contains("Add to all open rooms"));
+    let checkbox = new.text().split("type=\"checkbox\"").nth(1).unwrap().split('>').next().unwrap().to_string();
+    assert!(!checkbox.contains("checked"));
+
+    let (received, mut requests) = mpsc::unbounded_channel();
+    let service = axum::Router::new().route("/callback", axum::routing::post(move |body: String| {
+        let received = received.clone();
+        async move {
+            let payload = serde_json::from_str::<serde_json::Value>(&body).unwrap();
+            let html = payload["room"]["name"] == "Private greeting";
+            received.send(payload).unwrap();
+            if html {
+                (StatusCode::OK, [("content-type", "text/html")], "<div><strong>Hello</strong><script>bad()</script></div>")
+            } else {
+                (StatusCode::OK, [("content-type", "text/plain")], "Hello <everyone>")
+            }
+        }
+    }));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move { axum::serve(listener, service).await.unwrap() });
+    let form = format!("bot[name]=Greeter&bot[webhook_url]=http://{address}/callback");
+    assert_eq!(send(router, bot_form("POST", "/bots", &cookie, &form)).await.status, StatusCode::FOUND);
+    let bot = app.db.read(move |conn| Ok(Bot::managed_by(conn, &owner)?.remove(0))).await.unwrap();
+    let bot_id = bot.user.id;
+    assert!(!bot.add_to_all_open_rooms);
+    assert!(app.db.read(move |conn| Membership::for_user(conn, bot_id)).await.unwrap().is_empty());
+    let resource = format!("/bots/{bot_id}");
+    let invalid = send(router, bot_form("PATCH", &resource, &cookie, "bot[name]=&bot[add_to_all_open_rooms]=1")).await;
+    assert_eq!(invalid.status, StatusCode::UNPROCESSABLE_ENTITY);
+    assert!(invalid.text().split("type=\"checkbox\"").nth(1).unwrap().split('>').next().unwrap().contains("checked"));
+    assert!(!app.db.read(move |conn| Bot::find(conn, bot_id)).await.unwrap().add_to_all_open_rooms);
+
+    let enabled = "bot[name]=Greeter&bot[add_to_all_open_rooms]=0&bot[add_to_all_open_rooms]=1";
+    assert_eq!(send(router, bot_form("PATCH", &resource, &cookie, enabled)).await.status, StatusCode::FOUND);
+    let edit = send(router, get_with_cookie(&format!("{resource}/edit"), &cookie)).await;
+    assert!(edit.text().split("type=\"checkbox\"").nth(1).unwrap().split('>').next().unwrap().contains("checked"));
+    let mut expected_rooms = app.db.read(move |conn| Room::for_user_of_type(conn, bot_id, RoomType::Open)).await.unwrap();
+    assert!(!expected_rooms.is_empty());
+    // Saving the enabled setting twice must not send duplicate events.
+    assert_eq!(send(router, bot_form("PATCH", &resource, &cookie, enabled)).await.status, StatusCode::FOUND);
+    let future = app.db.write(move |tx| Room::create(tx, RoomType::Open, Some("Future greeting"), owner_id)).await.unwrap();
+    expected_rooms.push(future);
+    assert_eq!(send(router, bot_form("PATCH", &resource, &cookie, "bot[name]=Greeter&bot[add_to_all_open_rooms]=0")).await.status, StatusCode::FOUND);
+    let edit = send(router, get_with_cookie(&format!("{resource}/edit"), &cookie)).await;
+    assert!(!edit.text().split("type=\"checkbox\"").nth(1).unwrap().split('>').next().unwrap().contains("checked"));
+    let later = app.db.write(move |tx| Room::create(tx, RoomType::Open, Some("Not invited"), owner_id)).await.unwrap();
+    assert!(app.db.read(move |conn| Membership::find_by_room_and_user(conn, later.id, bot_id)).await.unwrap().is_none());
+
+    // Selective bots can also join open rooms through their editor.
+    let open_path = format!("/rooms/opens/{}", later.id);
+    let edit = send(router, get_with_cookie(&format!("{open_path}/edit"), &cookie)).await;
+    assert!(edit.text().contains("Give Greeter access to this room"));
+    let selected = format!("room[name]=Not+invited&bot_ids[]=&bot_ids[]={bot_id}");
+    assert_eq!(send(router, bot_form("PATCH", &open_path, &cookie, &selected)).await.status, StatusCode::FOUND);
+    expected_rooms.push(later);
+
+    // Add through the ordinary room editor, not a bot-specific membership endpoint.
+    let private = app.db.write(move |tx| Room::create_for(tx, RoomType::Closed, Some("Private greeting"), owner_id, &[owner_id])).await.unwrap();
+    let room_path = format!("/rooms/closeds/{}", private.id);
+    let room_form = format!("room[name]=Private+greeting&user_ids[]={owner_id}&user_ids[]={bot_id}");
+    for _ in 0..2 {
+        assert_eq!(send(router, bot_form("PATCH", &room_path, &cookie, &room_form)).await.status, StatusCode::FOUND);
+    }
+    expected_rooms.push(private);
+    app.db.write(move |tx| Room::create_for(tx, RoomType::Direct, None, owner_id, &[owner_id, bot_id])).await.unwrap();
+
+    let mut callbacks = Vec::new();
+    for _ in &expected_rooms {
+        callbacks.push(tokio::time::timeout(Duration::from_secs(5), requests.recv()).await.unwrap().unwrap());
+    }
+    for room in &expected_rooms {
+        let expected = json!({"event": "joined", "room": {"id": room.id, "name": room.name,
+            "reply_to": format!("/rooms/{}/{}/messages", room.id, bot.code)}});
+        assert_eq!(callbacks.iter().filter(|payload| **payload == expected).count(), 1);
+    }
+    test.booted.jobs.shutdown(Duration::from_secs(5)).await;
+    assert!(requests.try_recv().is_err(), "direct rooms and repeat grants must not send joined");
+    let rich_text = app.db.env().rich_text.clone();
+    app.db.read(move |conn| {
+        let messages = Message::by_creator(conn, bot_id)?;
+        assert_eq!(messages.len(), expected_rooms.len());
+        for room in expected_rooms {
+            assert!(Membership::find_by_room_and_user(conn, room.id, bot_id)?.is_some());
+            let message = messages.iter().find(|m| m.room_id == room.id).unwrap();
+            let text = message.plain_text_body(conn, &*rich_text)?;
+            assert_eq!(text, if room.name.as_deref() == Some("Private greeting") { "Hello" } else { "Hello <everyone>" });
+        }
+        Ok(())
+    }).await.unwrap();
+    server.abort();
+}
