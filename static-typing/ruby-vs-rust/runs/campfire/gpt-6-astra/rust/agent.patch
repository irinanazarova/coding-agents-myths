+//! Bot management pages. Credentials are only rendered in the private index.
+
+use askama::Template;
+
+use crate::ViewContext;
+use crate::helpers::{self as h, filters};
+use crate::layouts::Page;
+use crate::users::UserSummary;
+
+#[derive(Clone)]
+pub struct BotSummary {
+    pub user: UserSummary,
+    pub code: String,
+    pub suspension_reason: Option<String>,
+}
+
+#[derive(Template)]
+#[template(path = "bots/index.html", blocks = ["head", "content"])]
+pub struct Index<'a> {
+    pub ctx: &'a ViewContext<'a>,
+    pub bots: Vec<BotSummary>,
+    pub can_create: bool,
+    pub can_reactivate: bool,
+}
+
+impl Page for Index<'_> {
+    fn page_title(&self) -> Option<String> {
+        Some("Chat bots".into())
+    }
+}
+
+#[derive(Template)]
+#[template(path = "bots/form.html", blocks = ["head", "content"])]
+pub struct Form<'a> {
+    pub ctx: &'a ViewContext<'a>,
+    pub id: Option<i64>,
+    pub name: String,
+    pub avatar_url: Option<String>,
+    pub webhook_url: String,
+    pub add_to_all_open_rooms: bool,
+    pub error: Option<String>,
+}
+
+impl Form<'_> {
+    fn auto_join_value(&self) -> &'static str {
+        if self.add_to_all_open_rooms { "1" } else { "0" }
+    }
+
+    fn action(&self) -> String {
+        self.id.map(h::routes::bot).unwrap_or_else(h::routes::bots)
+    }
+    fn method(&self) -> &'static str {
+        if self.id.is_some() { "patch" } else { "post" }
+    }
+}
+
+impl Page for Form<'_> {
+    fn page_title(&self) -> Option<String> {
+        Some(if self.id.is_some() { "Edit chat bot" } else { "Add a chat bot" }.into())
+    }
+}
