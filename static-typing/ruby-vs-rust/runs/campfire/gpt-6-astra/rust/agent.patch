diff --git a/crates/db/src/models/bot.rs b/crates/db/src/models/bot.rs
new file mode 100644
index 0000000..04d6b92
--- /dev/null
+++ b/crates/db/src/models/bot.rs
@@ -0,0 +1,331 @@
+//! Bots are ordinary users with separately scoped ownership and API credentials.
+
+use rusqlite::{Connection, params};
+
+use crate::error::Result;
+use crate::sql::{self, query_all, query_one};
+use crate::{Account, Errors, NewUser, PasswordDigest, Role, Status, Tx, User};
+
+// Deliberately not Debug: the code is a bearer credential.
+#[derive(Clone)]
+pub struct Bot {
+    pub user: User,
+    pub creator_id: i64,
+    pub code: String,
+    pub webhook_url: Option<String>,
+    pub add_to_all_open_rooms: bool,
+    pub suspension_reason: Option<String>,
+    pub generation: i64,
+}
+
+impl Bot {
+    pub fn can_create(conn: &Connection, creator: &User) -> Result<bool> {
+        if creator.role == Role::Administrator {
+            return Ok(true);
+        }
+        let limit = Account::first(conn)?.ok_or(crate::Error::RecordNotFound("Account"))?.settings().bots_per_member();
+        let count = sql::count(
+            conn,
+            "SELECT COUNT(*) FROM chat_bots b JOIN users u ON u.id = b.user_id WHERE b.creator_id = ? AND u.status = 0",
+            [creator.id],
+        )?;
+        Ok(count < limit)
+    }
+
+    pub fn create(tx: &mut Tx<'_>, creator_id: i64, name: String, password_digest: PasswordDigest) -> Result<Self> {
+        // Count and insert in the same write transaction, including a fresh role/settings check.
+        if !Self::can_create(tx.conn(), &User::find(tx.conn(), creator_id)?)? {
+            let mut errors = Errors::default();
+            errors.add("bots", "have reached the limit");
+            return Err(crate::Error::RecordInvalid(errors));
+        }
+        let user = User::create(tx, NewUser { name, password_digest: Some(password_digest), ..Default::default() })?;
+        let code = sql::base58(32);
+        tx.conn().execute("INSERT INTO chat_bots (user_id, creator_id, code) VALUES (?, ?, ?)", params![user.id, creator_id, code])?;
+        Ok(Self { user, creator_id, code, webhook_url: None, add_to_all_open_rooms: false, suspension_reason: None, generation: 0 })
+    }
+
+    pub fn find(conn: &Connection, user_id: i64) -> Result<Self> {
+        let (creator_id, code) = query_one(conn, "SELECT creator_id, code FROM chat_bots WHERE user_id = ?", [user_id], |row| {
+            Ok((row.get(0)?, row.get(1)?))
+        })?
+        .ok_or(crate::Error::RecordNotFound("Bot"))?;
+        let user = User::find_active(conn, user_id)?;
+        let webhook_url = query_one(conn, "SELECT url FROM chat_bot_webhooks WHERE user_id = ?", [user_id], |row| row.get(0))?;
+        let add_to_all_open_rooms =
+            query_one(conn, "SELECT user_id FROM chat_bot_auto_join WHERE user_id = ?", [user_id], |row| row.get::<_, i64>(0))?
+                .is_some();
+        let (suspension_reason, generation) = query_one(
+            conn,
+            "SELECT suspension_reason, generation FROM chat_bot_safety WHERE user_id = ?",
+            [user_id],
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )?
+        .unwrap_or((None, 0));
+        Ok(Self { user, creator_id, code, webhook_url, add_to_all_open_rooms, suspension_reason, generation })
+    }
+
+    pub fn set_add_to_all_open_rooms(&mut self, tx: &mut Tx<'_>, enabled: bool) -> Result<()> {
+        if enabled {
+            tx.conn().execute("INSERT INTO chat_bot_auto_join (user_id) VALUES (?) ON CONFLICT DO NOTHING", [self.user.id])?;
+            let room_ids: Vec<i64> = query_all(tx.conn(), "SELECT id FROM rooms WHERE type = 'Rooms::Open'", [], |row| row.get(0))?;
+            for room_id in room_ids {
+                crate::Room::find(tx.conn(), room_id)?.grant_to(tx, &[self.user.id])?;
+            }
+        } else {
+            tx.conn().execute("DELETE FROM chat_bot_auto_join WHERE user_id = ?", [self.user.id])?;
+        }
+        self.add_to_all_open_rooms = enabled;
+        Ok(())
+    }
+
+    /// A first membership, not a room save or a re-addition. Keep this record even if
+    /// membership is revoked, so a bot only receives one greeting opportunity per room.
+    pub(crate) fn joined(tx: &mut Tx<'_>, user_id: i64, room_id: i64) -> Result<()> {
+        let inserted = tx.conn().execute(
+            "INSERT INTO chat_bot_room_joins (user_id, room_id)
+             SELECT b.user_id, r.id FROM chat_bots b, rooms r
+             WHERE b.user_id = ? AND r.id = ? AND r.type != 'Rooms::Direct'
+             ON CONFLICT DO NOTHING",
+            params![user_id, room_id],
+        )?;
+        if inserted != 0 {
+            tx.emit_after_commit(crate::Event::BotJoined { user_id, room_id });
+        }
+        Ok(())
+    }
+
+    pub fn set_webhook(&mut self, tx: &mut Tx<'_>, url: Option<&str>) -> Result<()> {
+        match url {
+            Some(url) => {
+                tx.conn().execute(
+                    "INSERT INTO chat_bot_webhooks (user_id, url) VALUES (?, ?) ON CONFLICT(user_id) DO UPDATE SET url = excluded.url",
+                    params![self.user.id, url],
+                )?;
+            }
+            None => {
+                tx.conn().execute("DELETE FROM chat_bot_webhooks WHERE user_id = ?", [self.user.id])?;
+            }
+        }
+        self.webhook_url = url.map(str::to_owned);
+        Ok(())
+    }
+
+    pub fn managed_by(conn: &Connection, manager: &User) -> Result<Vec<Self>> {
+        let ids: Vec<i64> = query_all(
+            conn,
+            "SELECT b.user_id FROM chat_bots b JOIN users u ON u.id = b.user_id WHERE u.status = 0 AND (? OR b.creator_id = ?) ORDER BY u.name, u.id",
+            params![manager.role == Role::Administrator, manager.id],
+            |row| row.get(0),
+        )?;
+        ids.into_iter().map(|id| Self::find(conn, id)).collect()
+    }
+
+    pub fn authenticate(conn: &Connection, code: &str) -> Result<Option<User>> {
+        let id: Option<i64> = query_one(conn, "SELECT user_id FROM chat_bots WHERE code = ?", [code], |row| row.get(0))?;
+        match id {
+            Some(id) => Ok(User::find_by_id(conn, id)?.filter(|user| user.status == Status::Active)),
+            None => Ok(None),
+        }
+    }
+
+    pub fn can_manage(&self, manager: &User) -> bool {
+        manager.role == Role::Administrator || manager.id == self.creator_id
+    }
+
+    pub fn destroy(mut self, tx: &mut Tx<'_>) -> Result<()> {
+        tx.conn().execute("DELETE FROM chat_bots WHERE user_id = ?", [self.user.id])?;
+        self.user.deactivate(tx)
+    }
+}
+
+/// Rejections are values, not transaction errors: their safety state must commit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum BotPostStatus {
+    Allowed,
+    Cooldown(i64),
+    Suspended,
+}
+
+impl Bot {
+    fn ensure_safety(tx: &Tx<'_>, user_id: i64) -> Result<()> {
+        tx.conn().execute("INSERT INTO chat_bot_safety (user_id) VALUES (?) ON CONFLICT DO NOTHING", [user_id])?;
+        Ok(())
+    }
+
+    /// Check before validating a request, so all attempts during cooldown count.
+    pub fn posting_status(tx: &mut Tx<'_>, user_id: i64) -> Result<BotPostStatus> {
+        Self::ensure_safety(tx, user_id)?;
+        let (reason, until, attempts): (Option<String>, i64, i64) = tx.conn().query_row(
+            "SELECT suspension_reason, cooldown_until, cooldown_attempts FROM chat_bot_safety WHERE user_id = ?",
+            [user_id],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+        )?;
+        if reason.is_some() {
+            return Ok(BotPostStatus::Suspended);
+        }
+        let now = tx.now().as_microsecond();
+        if until > now {
+            let reason = (attempts + 1 >= 5).then_some("Flooding: five posting attempts during cooldown.");
+            tx.conn().execute(
+                "UPDATE chat_bot_safety SET cooldown_attempts = cooldown_attempts + 1, suspension_reason = ? WHERE user_id = ?",
+                params![reason, user_id],
+            )?;
+            return Ok(if reason.is_some() {
+                BotPostStatus::Suspended
+            } else {
+                BotPostStatus::Cooldown((until - now + 999_999) / 1_000_000)
+            });
+        }
+        Ok(BotPostStatus::Allowed)
+    }
+
+    /// Reserve one accepted post, in the same transaction as message creation.
+    /// Both API messages and webhook replies use this per-bot rolling window.
+    pub fn accept_post(tx: &mut Tx<'_>, user_id: i64) -> Result<BotPostStatus> {
+        let status = Self::posting_status(tx, user_id)?;
+        if status != BotPostStatus::Allowed {
+            return Ok(status);
+        }
+        let now = tx.now().as_microsecond();
+        tx.conn().execute("DELETE FROM chat_bot_posts WHERE user_id = ? AND posted_at <= ?", params![user_id, now - 10_000_000])?;
+        let count = sql::count(tx.conn(), "SELECT COUNT(*) FROM chat_bot_posts WHERE user_id = ?", [user_id])?;
+        if count >= 10 {
+            tx.conn().execute(
+                "UPDATE chat_bot_safety SET cooldown_until = ?, cooldown_attempts = 0 WHERE user_id = ?",
+                params![now + 30_000_000, user_id],
+            )?;
+            return Ok(BotPostStatus::Cooldown(30));
+        }
+        tx.conn().execute("INSERT INTO chat_bot_posts (user_id, posted_at) VALUES (?, ?)", params![user_id, now])?;
+        Ok(BotPostStatus::Allowed)
+    }
+
+    pub fn record_webhook_result(tx: &mut Tx<'_>, user_id: i64, generation: i64, success: bool) -> Result<()> {
+        Self::ensure_safety(tx, user_id)?;
+        tx.conn().execute(
+            "UPDATE chat_bot_safety SET webhook_failures = CASE WHEN ? THEN 0 ELSE webhook_failures + 1 END,
+             suspension_reason = CASE WHEN NOT ? AND webhook_failures >= 9 THEN 'Failing webhooks: ten consecutive failed deliveries.' ELSE NULL END
+             WHERE user_id = ? AND generation = ? AND suspension_reason IS NULL",
+            params![success, success, user_id, generation],
+        )?;
+        Ok(())
+    }
+
+    pub fn reactivate(tx: &mut Tx<'_>, user_id: i64, administrator_id: i64) -> Result<()> {
+        if User::find_active(tx.conn(), administrator_id)?.role != Role::Administrator {
+            return Err(crate::Error::RecordNotFound("Administrator"));
+        }
+        Self::find(tx.conn(), user_id)?;
+        Self::ensure_safety(tx, user_id)?;
+        tx.conn().execute(
+            "UPDATE chat_bot_safety SET suspension_reason = NULL, cooldown_until = 0, cooldown_attempts = 0,
+             webhook_failures = 0, generation = generation + 1 WHERE user_id = ?",
+            [user_id],
+        )?;
+        tx.conn().execute("DELETE FROM chat_bot_posts WHERE user_id = ?", [user_id])?;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::tests::{TestDb, id};
+
+    fn bot(db: &TestDb, label: &'static str) -> i64 {
+        let user_id = id(label);
+        db.write(move |tx| {
+            tx.conn().execute("INSERT INTO chat_bots (user_id, creator_id, code) VALUES (?, ?, ?)", params![user_id, id("david"), label])?;
+            Ok(user_id)
+        })
+    }
+
+    #[test]
+    fn rolling_window_cooldown_boundaries_and_independent_bots() {
+        let db = TestDb::new();
+        db.clock.travel_to("2026-01-01T00:00:00Z".parse().unwrap());
+        let first = bot(&db, "david");
+        let second = bot(&db, "jason");
+        for _ in 0..5 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+        }
+        db.travel(5);
+        for _ in 0..5 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+        }
+        db.travel(5);
+        // Exactly ten seconds old is outside the rolling window.
+        for _ in 0..5 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+        }
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Cooldown(30));
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, second)), BotPostStatus::Allowed);
+        db.clock.travel(jiff::SignedDuration::from_millis(29_001));
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Cooldown(1));
+        db.clock.travel(jiff::SignedDuration::from_millis(999));
+        for _ in 0..10 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+        }
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Cooldown(30));
+        for _ in 0..4 {
+            assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Cooldown(30));
+        }
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Suspended);
+        db.travel(1000);
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Suspended);
+        assert!(db.read(|conn| Bot::find(conn, first)).suspension_reason.unwrap().contains("Flooding"));
+        db.write(move |tx| Bot::reactivate(tx, first, id("david")));
+        assert_eq!(db.write(move |tx| Bot::accept_post(tx, first)), BotPostStatus::Allowed);
+    }
+
+    #[test]
+    fn safety_state_survives_reopening_the_database() {
+        let test = TestDb::new();
+        test.clock.travel_to("2026-01-01T00:00:00Z".parse().unwrap());
+        let user_id = bot(&test, "david");
+        for _ in 0..10 {
