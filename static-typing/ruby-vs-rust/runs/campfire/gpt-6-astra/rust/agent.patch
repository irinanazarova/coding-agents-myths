+    let edit = send(router, get_with_cookie("/account/edit", &admin_cookie)).await;
+    assert!(edit.text().contains("Bots per member"));
+    let html = edit.text();
+    let limit_position = html.find("id=\"account_settings_bots_per_member\"").unwrap();
+    let form_start = html[..limit_position].rfind("<form").unwrap();
+    assert!(html[form_start..limit_position].contains("Save changes"), "use the existing account save form");
+    assert!(edit.text().contains("name=\"account[settings][bots_per_member]\" value=\"5\""));
+    assert!(!send(router, get_with_cookie("/account/edit", &cookie)).await.text().contains("Bots per member"));
+    assert_eq!(send(router, bot_form("PATCH", &action, &cookie, "account[settings][bots_per_member]=100")).await.status, StatusCode::FORBIDDEN);
+    for invalid in ["-1", "1.5", "abc", "", "9223372036854775808"] {
+        let reply = send(router, bot_form("PATCH", &action, &admin_cookie, &format!("account[settings][bots_per_member]={invalid}"))).await;
+        assert_eq!(reply.status, StatusCode::UNPROCESSABLE_ENTITY, "invalid value {invalid}");
+    }
+    for n in 0..3 {
+        assert_eq!(send(router, bot_form("POST", "/bots", &cookie, &format!("bot[name]=Existing+{n}"))).await.status, StatusCode::FOUND);
+    }
+    for limit in [2, 0] {
+        assert_eq!(send(router, bot_form("PATCH", &action, &admin_cookie, &format!("account[settings][bots_per_member]={limit}"))).await.status, StatusCode::FOUND);
+        let edit = send(router, get_with_cookie("/account/edit", &admin_cookie)).await;
+        assert!(edit.text().contains(&format!("name=\"account[settings][bots_per_member]\" value=\"{limit}\"")));
+        assert_eq!(send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Blocked")).await.status, StatusCode::UNPROCESSABLE_ENTITY);
+        let manager = owner.clone();
+        assert_eq!(app.db.read(move |conn| Ok(Bot::managed_by(conn, &manager)?.len())).await.unwrap(), 3);
+    }
+    let (_, empty_cookie) = bot_member(app, "Zero bots member").await;
+    assert_eq!(send(router, bot_form("POST", "/bots", &empty_cookie, "bot[name]=Blocked+at+zero")).await.status, StatusCode::UNPROCESSABLE_ENTITY);
+    assert!(!send(router, get_with_cookie("/bots", &empty_cookie)).await.text().contains("Add a chat bot"));
+    // Administrators remain unlimited even at zero, including beyond the default cap.
+    for n in 0..6 {
+        assert_eq!(send(router, bot_form("POST", "/bots", &admin_cookie, &format!("bot[name]=Admin+{n}"))).await.status, StatusCode::FOUND);
+    }
+    assert!(send(router, get_with_cookie("/bots", &admin_cookie)).await.text().contains("Add a chat bot"));
+    assert_eq!(send(router, get_with_cookie("/bots/new", &admin_cookie)).await.status, StatusCode::OK);
+    // Increasing the limit restores creation without touching existing bots.
+    assert_eq!(send(router, bot_form("PATCH", &action, &admin_cookie, "account[settings][bots_per_member]=4")).await.status, StatusCode::FOUND);
+    assert!(send(router, get_with_cookie("/bots", &cookie)).await.text().contains("Add a chat bot"));
+    assert_eq!(send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Fourth")).await.status, StatusCode::FOUND);
+}
