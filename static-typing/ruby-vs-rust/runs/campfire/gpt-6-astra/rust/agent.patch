+    assert!(edit.text().contains("http://localhost:9876/mention"));
+    for url in ["ftp://localhost/file", "not-a-url", "http://localhost:99999/"] {
+        let invalid = format!("bot[name]=Callback&bot[webhook_url]={url}");
