+        assert!(response.text().contains("Webhook URL must be an HTTP or HTTPS URL."));
+    }
+    assert_eq!(send(router, bot_form("PATCH", &path, &cookie, "bot[name]=Callback&bot[webhook_url]=")).await.status, StatusCode::FOUND);
+    let edit = send(router, get_with_cookie(&format!("{path}/edit"), &cookie)).await;
+    assert!(!edit.text().contains("http://localhost:9876/mention"));
