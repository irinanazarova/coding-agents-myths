+#[tokio::test]
+async fn bots_per_member_concurrent_creates_cannot_exceed_limit() {
+    use campfire_db::{Account, Bot, PasswordDigest, User};
+    let test = boot_seeded().await;
+    let router = &test.booted.router;
+    let app = &test.booted.app;
+    let (owner, cookie) = bot_member(app, "Concurrent owner").await;
+    app.db.write(|tx| Account::first(tx.conn())?.unwrap().update(tx, None, None, Some(&[("bots_per_member", "1")]))).await.unwrap();
+    let (first, second) = tokio::join!(
+        send(router, bot_form("POST", "/bots", &cookie, "bot[name]=First")),
+        send(router, bot_form("POST", "/bots", &cookie, "bot[name]=Second")),
+    );
+    let mut statuses = [first.status.as_u16(), second.status.as_u16()];
+    statuses.sort();
+    assert_eq!(statuses, [302, 422]);
+    // Even callers bypassing the controller are refused without creating an orphan user.
+    let before = app.db.read(User::count).await.unwrap();
+    let owner_id = owner.id;
+    let digest = PasswordDigest::hash("test password".into(), 4).await.unwrap();
+    let result = app.db.write(move |tx| Bot::create(tx, owner_id, "Bypass".into(), digest)).await;
+    assert!(matches!(result, Err(campfire_db::Error::RecordInvalid(_))));
+    assert_eq!(app.db.read(User::count).await.unwrap(), before);
+    let bots = app.db.read(move |conn| Bot::managed_by(conn, &owner)).await.unwrap();
+    assert_eq!(bots.len(), 1);
+}
