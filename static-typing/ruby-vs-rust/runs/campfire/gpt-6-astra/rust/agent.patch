+#[tokio::test]
+async fn bot_flood_suspension_and_admin_reactivation() {
+    use campfire_db::{Bot, Role, User, UserChanges};
+    let test = boot_seeded().await;
+    let app = &test.booted.app;
+    let router = &test.booted.router;
+    let (owner, cookie) = bot_member(app, "Flood owner").await;
+    let owner_id = owner.id;
+    assert_eq!(send(router, bot_form("POST", "/bots", &cookie,
+        "bot[name]=Flood+bot&bot[add_to_all_open_rooms]=1")).await.status, StatusCode::FOUND);
+    let bot = app.db.read(move |conn| Ok(Bot::managed_by(conn, &owner)?.remove(0))).await.unwrap();
+    let bot_id = bot.user.id;
+    let room = app.db.read(move |conn| Ok(campfire_db::Room::for_user_of_type(conn, bot_id, campfire_db::RoomType::Open)?.remove(0))).await.unwrap();
+    let path = format!("/rooms/{}/{}/messages", room.id, bot.code);
+    let responses = futures_util::future::join_all((0..10).map(|_| send(router, bot_post(&path, "text/plain", "hello")))).await;
+    for response in responses { assert_eq!(response.status, StatusCode::CREATED); }
+    for _ in 0..5 {
+        let reply = send(router, bot_post(&path, "text/plain", "too many")).await;
+        assert_eq!(reply.status, StatusCode::TOO_MANY_REQUESTS);
+        assert_eq!(reply.header("retry-after"), Some("30"));
+    }
+    assert_eq!(send(router, bot_post(&path, "text/plain", "fifth extra attempt")).await.status, StatusCode::FORBIDDEN);
+    let page = send(router, get_with_cookie("/bots", &cookie)).await;
+    assert!(page.text().contains("Suspended"));
+    assert!(page.text().contains("Flooding"));
+    assert!(!page.text().contains(">Reactivate<"));
+    app.db.read(move |conn| {
+        assert!(campfire_db::Membership::find_by_room_and_user(conn, room.id, bot_id)?.is_some());
+        let count = campfire_db::query_one(conn, "SELECT COUNT(*) FROM messages WHERE creator_id = ?", [bot_id], |row| row.get::<_, i64>(0))?;
+        assert_eq!(count, Some(10));
+        Ok(())
+    }).await.unwrap();
+    for n in 0..4 {
+        assert_eq!(send(router, bot_form("POST", "/bots", &cookie, &format!("bot[name]=Other+bot+{n}"))).await.status, StatusCode::FOUND);
+    }
+    assert_eq!(send(router, get_with_cookie("/bots/new", &cookie)).await.status, StatusCode::FORBIDDEN,
+        "the suspended bot must still consume one of the owner's five slots");
+    let reactivate = format!("/bots/{bot_id}/reactivate");
+    assert_eq!(send(router, bot_form("POST", &reactivate, &cookie, "")).await.status, StatusCode::FORBIDDEN);
+    app.db.write(move |tx| User::find(tx.conn(), owner_id)?.update(tx, UserChanges { role: Some(Role::Administrator), ..Default::default() })).await.unwrap();
+    let page = send(router, get_with_cookie("/bots", &cookie)).await;
+    assert!(page.text().contains(">Reactivate<"));
+    assert!(page.text().contains("data-turbo-confirm="));
+    assert_eq!(send(router, bot_form("POST", &reactivate, &cookie, "")).await.status, StatusCode::FOUND);
+    assert_eq!(send(router, bot_post(&path, "text/plain", "back")).await.status, StatusCode::CREATED);
+}
