+    let room_id = open.id;
+    assert_eq!(t.sink.take(), vec![Event::BotJoined { user_id: bot_id, room_id }]);
+    assert!(t.read(|conn| Membership::find_by_room_and_user(conn, room_id, bot_id)).is_some());
+    // Saves, repeated grants and removal/re-addition never repeat a greeting.
+    t.write(move |tx| {
+        let mut room = Room::find(tx.conn(), room_id)?;
+        room.update(tx, Some(Some("Renamed")), None)?;
+        room.grant_to(tx, &[bot_id, bot_id])?;
+        room.revoke_from(tx, &[bot_id])?;
+        room.grant_to(tx, &[bot_id])
