index 0000000..02a3e81
--- /dev/null
+++ b/crates/campfire/src/controllers/bots.rs
@@ -0,0 +1,238 @@
+//! Owner/admin-scoped bot management and code-authenticated message posting.
+
+use campfire_db::{Bot, BotPostStatus, Message, NewMessage, Role, Room, UserChanges};
+use campfire_kit::{Ctx, Error, Result, StatusCode, format, permit_keys};
+use campfire_views::bots;
+use ruby_compat::integer_cast;
+
+use super::presenters;
+use super::presenters::attachments::{self, Assignment, Record};
+use super::presenters::page::framed_page;
+use crate::app::AppCtx;
+use crate::concerns::{self, Before};
+
+async fn before(c: &mut Ctx) -> Result<()> {
+    c.set_header("cache-control", "private, no-store");
+    c.set_header("referrer-policy", "no-referrer");
+    concerns::before_actions(c, Before::default()).await
+}
+
+pub async fn index(c: &mut Ctx) -> Result {
+    before(c).await?;
+    c.respond_to(&[&format::HTML])?;
+    let manager = concerns::require_current_user(c)?.clone();
+    let can_reactivate = manager.role == Role::Administrator;
+    let secrets = c.app().secrets.clone();
+    let (bots, can_create) = c
+        .app()
+        .read(move |conn| {
+            let can_create = Bot::can_create(conn, &manager)?;
+            let bots = Bot::managed_by(conn, &manager)?
+                .into_iter()
+                .map(|bot| bots::BotSummary {
+                    user: presenters::user_summary(&secrets, &bot.user),
+                    code: bot.code,
+                    suspension_reason: bot.suspension_reason,
+                })
+                .collect::<Vec<_>>();
+            Ok((bots, can_create))
+        })
+        .await?;
+    framed_page!(c, StatusCode::OK, |ctx| bots::Index { ctx, bots: bots.clone(), can_create, can_reactivate }).await
+}
+
+pub async fn reactivate(c: &mut Ctx) -> Result {
+    before(c).await?;
+    let administrator = concerns::require_current_user(c)?;
+    if administrator.role != Role::Administrator {
+        return Ok(c.head(StatusCode::FORBIDDEN));
+    }
+    let administrator_id = administrator.id;
+    let bot = managed_bot(c).await?;
+    c.app().write(move |tx| Bot::reactivate(tx, bot.user.id, administrator_id)).await?;
+    c.redirect_to(&campfire_routes::bots())
+}
+
+fn posting_rejection(c: &mut Ctx, status: BotPostStatus) -> Option<campfire_kit::Response> {
+    match status {
+        BotPostStatus::Allowed => None,
+        BotPostStatus::Suspended => Some(c.head(StatusCode::FORBIDDEN)),
+        BotPostStatus::Cooldown(seconds) => {
+            c.set_header("retry-after", &seconds.to_string());
+            Some(c.head(StatusCode::TOO_MANY_REQUESTS))
+        }
+    }
+}
+
+pub async fn new(c: &mut Ctx) -> Result {
+    before(c).await?;
+    let creator = concerns::require_current_user(c)?.clone();
+    if !c.app().read(move |conn| Bot::can_create(conn, &creator)).await? {
+        return Ok(c.render_as(StatusCode::FORBIDDEN, "text/plain; charset=utf-8", "You've reached the limit for chat bots."));
+    }
+    render_form(c, None, String::new(), String::new(), false, None).await
+}
+
+pub async fn edit(c: &mut Ctx) -> Result {
+    before(c).await?;
+    let bot = managed_bot(c).await?;
+    let name = bot.user.name.clone();
+    let webhook_url = bot.webhook_url.clone().unwrap_or_default();
+    let add_to_all_open_rooms = bot.add_to_all_open_rooms;
+    render_form(c, Some(bot), name, webhook_url, add_to_all_open_rooms, None).await
+}
+
+async fn managed_bot(c: &Ctx) -> Result<Bot> {
+    let id = c.param_str("id").and_then(integer_cast).ok_or(Error::NotFound)?;
+    let bot = c.app().read(move |conn| Bot::find(conn, id)).await?;
+    if !bot.can_manage(concerns::require_current_user(c)?) {
+        return Err(Error::NotFound);
+    }
+    Ok(bot)
+}
+
+async fn render_form(
+    c: &mut Ctx,
+    bot: Option<Bot>,
+    name: String,
+    webhook_url: String,
+    add_to_all_open_rooms: bool,
+    error: Option<String>,
+) -> Result {
+    c.respond_to(&[&format::HTML])?;
+    let id = bot.as_ref().map(|bot| bot.user.id);
+    let avatar_url = bot.as_ref().map(|bot| presenters::avatar_path(&c.app().secrets, &bot.user));
+    let status = if error.is_some() { StatusCode::UNPROCESSABLE_ENTITY } else { StatusCode::OK };
+    framed_page!(c, status, |ctx| bots::Form {
+        ctx,
+        id,
+        name: name.clone(),
+        avatar_url: avatar_url.clone(),
+        webhook_url: webhook_url.clone(),
+        add_to_all_open_rooms,
+        error: error.clone(),
+    })
+    .await
+}
+
+pub async fn create(c: &mut Ctx) -> Result {
+    before(c).await?;
+    save(c, None).await
+}
+
+pub async fn update(c: &mut Ctx) -> Result {
+    before(c).await?;
+    let bot = managed_bot(c).await?;
+    save(c, Some(bot)).await
+}
+
+async fn save(c: &mut Ctx, bot: Option<Bot>) -> Result {
+    let params = c.params.require("bot")?.permit(&permit_keys(&["name", "avatar", "webhook_url", "add_to_all_open_rooms"]));
+    let name = params.get("name").and_then(|p| p.to_s()).unwrap_or_default();
+    let webhook_url = params
+        .get("webhook_url")
+        .and_then(|p| p.to_s())
+        .unwrap_or_else(|| bot.as_ref().and_then(|b| b.webhook_url.clone()).unwrap_or_default())
+        .trim()
+        .to_string();
+    let add_to_all_open_rooms = params
+        .get("add_to_all_open_rooms")
+        .and_then(|p| p.to_s())
+        .map(|value| value == "1")
+        .unwrap_or_else(|| bot.as_ref().is_some_and(|b| b.add_to_all_open_rooms));
+    let error = if name.trim().is_empty() {
+        Some("Name the bot can't be blank.")
+    } else if !webhook_url.is_empty() && crate::integrations::bot_webhooks::endpoint(&webhook_url).is_err() {
+        Some("Webhook URL must be an HTTP or HTTPS URL.")
+    } else {
+        None
+    };
+    if let Some(error) = error {
+        return render_form(c, bot, name, webhook_url, add_to_all_open_rooms, Some(error.into())).await;
+    }
+    let avatar = Assignment::from_params(&params, "avatar")?.stage(c.app()).await?;
+    let creator_id = concerns::require_current_user(c)?.id;
+    // Satisfy the Rails NOT NULL password column with an unknowable password, unrelated to the API code.
+    let password = if bot.is_none() { concerns::password_digest(c, Some(uuid::Uuid::new_v4().to_string())).await? } else { None };
+    let pending = c
+        .app()
+        .write(move |tx| {
+            let mut bot = match bot {
+                Some(mut bot) => {
+                    bot.user.update(tx, UserChanges { name: Some(name), ..Default::default() })?;
+                    bot
+                }
+                None => Bot::create(tx, creator_id, name, password.expect("new bot password"))?,
+            };
+            bot.set_webhook(tx, if webhook_url.is_empty() { None } else { Some(&webhook_url) })?;
+            bot.set_add_to_all_open_rooms(tx, add_to_all_open_rooms)?;
+            attachments::assign(tx, Record::user(bot.user.id), "avatar", avatar)
+        })
+        .await?;
+    attachments::analyze_later(c.app(), pending);
+    c.redirect_to(&campfire_routes::bots())
+}
+
+pub async fn destroy(c: &mut Ctx) -> Result {
+    before(c).await?;
+    let bot = managed_bot(c).await?;
+    c.app().write(move |tx| bot.destroy(tx)).await?;
+    c.redirect_to(&campfire_routes::bots())
+}
+
+/// Raw text is escaped before entering Action Text, not interpreted as form data or HTML.
+pub async fn post_message(c: &mut Ctx) -> Result {
+    c.set_header("cache-control", "no-store");
+    c.set_header("referrer-policy", "no-referrer");
+    concerns::before_actions(c, Before::default().allow_unauthenticated_access().skip_forgery_protection()).await?;
+    let code = c.param_str("bot_code").unwrap_or_default().to_string();
+    let credential = code.clone();
+    let user = c.app().read(move |conn| Bot::authenticate(conn, &credential)).await?;
+    let Some(user) = user else { return Ok(c.head(StatusCode::UNAUTHORIZED)) };
+    let user_id = user.id;
+    let credential = code.clone();
+    let status = c
+        .app()
+        .write(move |tx| {
+            if Bot::authenticate(tx.conn(), &credential)?.is_none() {
+                return Ok(None);
+            }
+            Bot::posting_status(tx, user_id).map(Some)
+        })
+        .await?;
+    let Some(status) = status else { return Ok(c.head(StatusCode::UNAUTHORIZED)) };
+    if let Some(response) = posting_rejection(c, status) {
+        return Ok(response);
+    }
+    let room_id = c.param_str("room_id").and_then(|id| id.parse::<i64>().ok()).ok_or(Error::NotFound)?;
+    let room = c.app().read(move |conn| Room::find_for_user(conn, user_id, room_id)).await?.ok_or(Error::NotFound)?;
+    let body = std::str::from_utf8(c.request.raw_post()).map_err(|_| Error::Status(StatusCode::UNPROCESSABLE_ENTITY))?;
+    if body.trim().is_empty() {
+        return Ok(c.head(StatusCode::UNPROCESSABLE_ENTITY));
+    }
+    let body = ruby_compat::erb::html_escape(body).replace('\n', "<br>");
+    let body = super::messages::canonicalize_body(c.app(), body, Some(c.request.host())).await?;
+    // Recheck the credential and membership inside the write, so revocation cannot race an insert.
+    let (message, status) = c
+        .app()
+        .write(move |tx| {
+            if Bot::authenticate(tx.conn(), &code)?.is_none() {
+                return Ok((None, BotPostStatus::Allowed));
+            }
+            Room::find_for_user(tx.conn(), user_id, room_id)?.ok_or(campfire_db::Error::RecordNotFound("Room"))?;
+            let status = Bot::accept_post(tx, user_id)?;
+            if status != BotPostStatus::Allowed {
+                return Ok((None, status));
+            }
+            Message::create(tx, NewMessage { room_id, creator_id: user_id, body: Some(body), ..Default::default() })
+                .map(|message| (Some(message), status))
+        })
+        .await?;
+    if let Some(response) = posting_rejection(c, status) {
+        return Ok(response);
+    }
+    let Some(message) = message else { return Ok(c.head(StatusCode::UNAUTHORIZED)) };
+    super::messages::broadcast_create(c, &room, &message).await?;
+    c.set_header("location", &format!("/messages/{}", message.id));
+    Ok(c.head(StatusCode::CREATED))
+}
