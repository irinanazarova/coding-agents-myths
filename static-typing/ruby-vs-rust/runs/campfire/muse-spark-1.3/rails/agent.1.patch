diff --git a/app/controllers/bot_messages_controller.rb b/app/controllers/bot_messages_controller.rb
new file mode 100644
index 0000000..7d19635
--- /dev/null
+++ b/app/controllers/bot_messages_controller.rb
@@ -0,0 +1,23 @@
+class BotMessagesController < ApplicationController
+  allow_unauthenticated_access only: :create
+  skip_forgery_protection only: :create
+
+  def create
+    room = Room.find_by(id: params[:room_id])
+    return head :not_found unless room
+
+    bot = User.bots.find_by(bot_token: params[:bot_token])
+    return head :unauthorized unless bot&.active?
+
+    body = request.raw_post.to_s.dup.force_encoding(Encoding::UTF_8).strip
+
+    if body.blank?
+      head :unprocessable_content
+    else
+      message = room.messages.create_with_attachment!(creator: bot, body: body)
+      message.broadcast_create
+      response.headers["Location"] = "/messages/#{message.id}"
+      head :created
+    end
+  end
+end
diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
