+<%= form_with model: bot, url: bot.persisted? ? bot_path(bot) : bots_path, method: bot.persisted? ? :patch : :post, class: "flex flex-column gap" do |form| %>
+  <% if bot.errors.any? %>
+    <div class="txt-negative">
+      <h2><%= pluralize(bot.errors.count, "error") %> prohibited this bot from being saved:</h2>
+      <ul>
+        <% bot.errors.full_messages.each do |message| %>
+          <li><%= message %></li>
+        <% end %>
+      </ul>
+    </div>
+  <% end %>
+
+  <div class="align-center center avatar__form gap" data-controller="upload-preview">
+    <label class="btn avatar input--file txt-xx-large">
+      <% if bot.persisted? %>
+        <%= image_tag fresh_user_avatar_path(bot), aria: { hidden: "true" }, size: 96, data: { upload_preview_target: "image" } %>
+      <% else %>
+        <%= image_tag "default-avatar.svg", aria: { hidden: "true" }, size: 96, data: { upload_preview_target: "image" } %>
+      <% end %>
+      <%= form.file_field :avatar, class: "input", accept: "image/*",
+            data: { upload_preview_target: "input", action: "upload-preview#previewImage" } %>
+      <span class="for-screen-reader">Bot avatar</span>
+    </label>
+  </div>
+
+  <div class="flex align-center gap">
+    <label class="flex align-center gap flex-item-grow input input--actor">
+      <span>Name the bot</span>
+      <%= form.text_field :name, class: "input txt-large", autocomplete: "off", placeholder: "Name the bot",
+            required: true, autofocus: true %>
+    </label>
+  </div>
+
+  <div class="center">
+    <%= form.button "Save changes", type: "submit", class: "btn btn--reversed txt-large center" %>
+  </div>
