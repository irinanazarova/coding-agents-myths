--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,54 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = bots_scope.ordered
+  end
+
+  def new
+    @bot = Current.user.created_bots.build
+  end
+
+  def create
+    @bot = Current.user.created_bots.build(bot_params)
+
+    if @bot.save
+      redirect_to bots_url, notice: "✓"
+    else
+      render :new, status: :unprocessable_content
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url, notice: "✓"
+    else
+      render :edit, status: :unprocessable_content
+    end
+  end
+
+  def destroy
+    @bot.destroy
+    redirect_to bots_url, notice: "✓"
+  end
+
+  private
+    def set_bot
+      @bot = bots_scope.find(params[:id])
+    end
+
+    def bots_scope
+      if Current.user.administrator?
+        User.bots
+      else
+        Current.user.created_bots
+      end
+    end
+
+    def bot_params
+      params.require(:user).permit(:name, :avatar)
+    end
+end
