@@ -0,0 +1,24 @@
+class BotJoinedPayload
+  def initialize(room:, bot:)
+    @room = room
+    @bot = bot
+  end
+
+  def to_h
+    {
+      event: "joined",
+      room: {
+        id: room.id,
+        name: room.name,
+        reply_to: reply_to
+      }
+    }
+  end
+
+  private
+    attr_reader :room, :bot
+
+    def reply_to
+      "/rooms/#{room.id}/#{bot.bot_token}/messages"
+    end
+end
