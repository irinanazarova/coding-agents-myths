+        <span>Bot code</span>
+        <span class="flex align-center gap input input--actor fill-white">
+          {{ h::image_tag(ctx, "key.svg", h::attrs().aria_hidden().size(20).class("colorize--black")) }}
+          <input type="text" class="input" value="{{ bot.bot_code }}" readonly aria-label="Bot code">
+        </span>
+      </label>
+      {% filter link_to(bot.edit_path().as_str(), h::attrs().class("btn center")) %}
+        {{ h::image_tag(ctx, "pencil.svg", h::attrs().aria_hidden().size(20)) }}
+        <span>Edit {{ bot.name }}</span>
+{% endfilter %}
+    </li>
+    {% endfor %}
+  </menu>
+</section>
+{% endblock %}
+{% block footer %}  <div class="txt-align-center center margin-block-double txt-subtle">Campfire&trade; version {{ h::version_badge(ctx) }}</div>
+{% endblock %}
