+{% extends "layouts/application.html" %}
+{%- block head %}{% endblock %}
+
+{% block nav %}  <div class="flex-item-justify-start">
+    {{ h::link_back_to(ctx, h::routes::bots()) }}
+  </div>
+{% endblock %}
+{% block content %}<section class="panel flex flex-column gap" style="view-transition-name: bot-new">
+  <h1 class="txt-x-large txt-align-center margin-none">Add a chat bot</h1>
+{% if let Some(error) = error %}  <p class="flash__inner" role="alert">{{ error }}</p>
+{% endif %}
+{% let form = h::form_with(self.form_action()).model("bot").method("post").data("controller", "form").multipart() %}  {% filter form_with(form) %}
+    <div class="flex flex-column gap">
+      <div class="align-center center avatar__form gap" data-controller="upload-preview">
+        <label class="btn avatar input--file txt-xx-large">
+          {{ h::image_tag(ctx, "default-avatar.svg", h::attrs().aria_hidden().size(48).data("upload_preview_target", "image")) }}
+          {{ form.file_field("avatar", h::attrs().class("input").accept("image/*").data("action", "upload-preview#previewImage")) }}
+          <span class="for-screen-reader">Upload avatar</span>
+        </label>
+      </div>
+
+      <div class="flex align-center gap">
+        <label class="flex align-center gap flex-item-grow input input--actor">
+          <span>Name the bot</span>
+          {{ form.text_field("name", self.name.as_deref(), h::attrs().class("input txt-large").autocomplete("off").placeholder("Name the bot").autofocus().required(true).aria("label", "Name the bot")) }}
+          {{ h::image_tag(ctx, "messages.svg", h::attrs().aria_hidden().size(24).class("colorize--black")) }}
+        </label>
+      </div>
+
+      {% filter button(h::attrs().class("btn btn--reversed center txt-large").type_("submit")) %}
+        {{ h::image_tag(ctx, "check.svg", h::attrs().aria_hidden().size(20)) }}
+        <span class="for-screen-reader">Save changes</span><span aria-hidden="true">Save changes</span>
+{% endfilter %}
+    </div>
+{% endfilter %}
+</section>
+{% endblock %}
+{% block footer %}  <div class="txt-align-center center margin-block-double txt-subtle">Campfire&trade; version {{ h::version_badge(ctx) }}</div>
+{% endblock %}
