+//! Views for `bots/*`.
+
+use askama::Template;
+
+use crate::ViewContext;
+use crate::helpers::{self as h, filters};
+use crate::layouts::Page;
+
+/// A bot as `/bots` lists it.
+#[derive(Clone, Debug)]
+pub struct BotView {
+    pub id: i64,
+    pub user_id: i64,
+    pub name: String,
+    pub avatar_url: String,
+    pub bot_code: String,
+}
+
+impl BotView {
+    pub fn edit_path(&self) -> String {
+        h::routes::edit_bot(self.id)
+    }
+}
+
+/// `bots/index.html.erb`.
+#[derive(Template)]
+#[template(path = "bots/index.html", blocks = ["head", "content"])]
+pub struct Index<'a> {
+    pub ctx: &'a ViewContext<'a>,
+    pub bots: Vec<BotView>,
+}
+
+impl Page for Index<'_> {
+    fn page_title(&self) -> Option<String> {
+        Some("Chat bots".into())
+    }
+}
+
+/// `bots/new.html.erb`.
+#[derive(Template)]
+#[template(path = "bots/new.html", blocks = ["head", "content"])]
+pub struct New<'a> {
+    pub ctx: &'a ViewContext<'a>,
+    pub name: Option<String>,
+    pub error: Option<String>,
+}
+
+impl<'a> New<'a> {
+    fn form_action(&self) -> String {
+        h::routes::bots()
+    }
+}
+
+impl Page for New<'_> {
+    fn page_title(&self) -> Option<String> {
+        Some("Add a chat bot".into())
+    }
+}
+
+/// `bots/edit.html.erb`.
+#[derive(Template)]
+#[template(path = "bots/edit.html", blocks = ["head", "content"])]
+pub struct Edit<'a> {
+    pub ctx: &'a ViewContext<'a>,
+    pub bot: BotView,
+    pub error: Option<String>,
+}
+
+impl<'a> Edit<'a> {
+    fn form_action(&self) -> String {
+        h::routes::bot(self.bot.id)
+    }
+}
+
+impl Page for Edit<'_> {
+    fn page_title(&self) -> Option<String> {
+        Some(format!("Edit {}", self.bot.name))
+    }
+}
