@@ -0,0 +1,400 @@
+//! `BotsController`: chat bots (`/bots*`) plus the bot posting API
+//! (`POST /rooms/:room_id/:bot_code/messages`).
+
+use campfire_db::{Bot, Message, NewMessage, Room, User};
+use campfire_kit::{Ctx, Param, Result, StatusCode, format, halt, permit_keys};
+use campfire_views::bots as views;
+use ruby_compat::integer_cast;
+
+use super::messages::{broadcast_create, canonicalize_body};
+use super::presenters::attachments::{self, Assignment, Record};
+use super::presenters::page::framed_page;
+use super::presenters::avatar_path;
+use crate::app::AppCtx;
+use crate::concerns::{self, Before, require_current_user};
+
+// --- Pages -----------------------------------------------------------------------------------
+
+/// `index`: bots `Current.user` created (all of them for administrators), all on one page.
+pub async fn index(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let current = require_current_user(c)?.clone();
+    c.respond_to(&[&format::HTML])?;
+    let bots = bot_views(c, &current).await?;
+    framed_page!(c, StatusCode::OK, |ctx| views::Index { ctx, bots: bots.clone() }).await
+}
+
+/// `new`.
+pub async fn new(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    c.respond_to(&[&format::HTML])?;
+    framed_page!(c, StatusCode::OK, |ctx| views::New { ctx, name: None, error: None }).await
+}
+
+/// `create`: `Bot.create` + avatar, then back to `/bots`.
+pub async fn create(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let creator_id = require_current_user(c)?.id;
+    let params = bot_params(c)?;
+    let name = params.name.unwrap_or_default();
+    let avatar = params.avatar.stage(c.app()).await?;
+    if name.trim().is_empty() {
+        c.respond_to(&[&format::HTML])?;
+        let name = Some(name);
+        let error = Some("Name can't be blank".to_string());
+        return framed_page!(c, StatusCode::UNPROCESSABLE_ENTITY, |ctx| views::New { ctx, name: name.clone(), error: error.clone() }).await;
+    }
+    let app = c.app().clone();
+    let pending = c
+        .app()
+        .write(move |tx| {
+            let bot = Bot::create(tx, creator_id, &name)?;
+            let pending = attachments::assign(tx, Record::user(bot.user_id), "avatar", avatar)?;
+            Ok(pending)
+        })
+        .await?;
+    attachments::analyze_later(&app, pending);
+    let location = c.url_for(&campfire_routes::bots());
+    c.redirect_to(&location)
+}
+
+/// `edit`.
+pub async fn edit(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let bot = find_visible_bot(c).await?;
+    c.respond_to(&[&format::HTML])?;
+    let view = bot_view(c, &bot).await?;
+    framed_page!(c, StatusCode::OK, |ctx| views::Edit { ctx, bot: view.clone(), error: None }).await
+}
+
+/// `update`: rename + avatar.
+pub async fn update(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let bot = find_visible_bot(c).await?;
+    let params = bot_params(c)?;
+    let name = params.name.unwrap_or_default();
+    let avatar = params.avatar.stage(c.app()).await?;
+    if name.trim().is_empty() {
+        c.respond_to(&[&format::HTML])?;
+        let view = bot_view(c, &bot).await?;
+        let error = Some("Name can't be blank".to_string());
+        return framed_page!(c, StatusCode::UNPROCESSABLE_ENTITY, |ctx| views::Edit { ctx, bot: view.clone(), error: error.clone() }).await;
+    }
+    let bot_id = bot.id;
+    let user_id = bot.user_id;
+    let app = c.app().clone();
+    let pending = c
+        .app()
+        .write(move |tx| {
+            let bot = Bot::find(tx.conn(), bot_id)?;
+            bot.rename(tx, &name)?;
+            let pending = attachments::assign(tx, Record::user(user_id), "avatar", avatar)?;
+            Ok(pending)
+        })
+        .await?;
+    attachments::analyze_later(&app, pending);
+    let location = c.url_for(&campfire_routes::bots());
+    c.redirect_to(&location)
+}
+
+/// `destroy`: delete the bot (with confirmation in the view), then back to `/bots`.
+pub async fn destroy(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let bot = find_visible_bot(c).await?;
+    c.app().write(move |tx| bot.destroy(tx)).await?;
+    let location = c.url_for(&campfire_routes::bots());
+    c.redirect_to(&location)
+}
+
+/// Unused REST member (`GET /bots/:id`): no show page; back to the list.
+pub async fn show(c: &mut Ctx) -> Result {
+    concerns::before_actions(c, Before::default()).await?;
+    let _ = find_visible_bot(c).await?;
+    let location = c.url_for(&campfire_routes::bots());
+    c.redirect_to(&location)
+}
+
+// --- Bot posting API --------------------------------------------------------------------------
+
+/// `POST /rooms/:room_id/:bot_code/messages`: the raw request body becomes the message
+/// body. No session, no forgery protection; the bot code authenticates.
+///
+/// - `201 Created` with `Location: /messages/:id`
+/// - `422` for an empty body (no attachment possible here)
+/// - `404` for a bad room id
+/// - `401` for an invalid bot code
+pub async fn create_message(c: &mut Ctx) -> Result {
+    // Version headers + banned-IP checks, but no session and no forgery check: bots
+    // post from shell scripts and CI jobs with only their code.
+    concerns::before_actions(c, Before::default().allow_unauthenticated_access().skip_forgery_protection()).await?;
+    let bot_code = c.param_str("bot_code").unwrap_or_default().to_string();
+    let bot = c.app().read(move |conn| Bot::find_by_code(conn, &bot_code)).await?;
+    let Some(bot) = bot else { return halt(c.head(StatusCode::UNAUTHORIZED)) };
+    // Room must exist (404 when it doesn't). Membership is not required: open rooms
+    // auto-include bots, and closed rooms add them like people.
+    let room_id = c.param_str("room_id").and_then(integer_cast).ok_or(campfire_kit::Error::NotFound)?;
+    let room = c.app().read(move |conn| Room::find_by_id(conn, room_id)).await?.ok_or(campfire_kit::Error::NotFound)?;
+
+    let raw = c.request.raw_post().to_vec();
+    let text = String::from_utf8_lossy(&raw).into_owned();
+    if text.trim().is_empty() {
+        return halt(c.head(StatusCode::UNPROCESSABLE_ENTITY));
+    }
+    let creator_id = bot.user_id;
+    let room_id = room.id;
+    let host = Some(c.request.host());
+    let app = c.app().clone();
+    let body = canonicalize_body(&app, text, host).await?;
+    let message = c
+        .app()
+        .write(move |tx| {
+            Message::create(
+                tx,
+                NewMessage { room_id, creator_id, client_message_id: None, body: Some(body), attachment_blob_id: None },
+            )
+        })
+        .await?;
+    broadcast_create(c, &room, &message).await?;
+    let location = campfire_routes::message(message.id);
+    let mut response = c.head(StatusCode::CREATED);
+    response.headers.insert(axum::http::header::LOCATION, location.parse().map_err(campfire_kit::Error::internal)?);
+    Ok(response)
+}
+
+// --- Helpers -----------------------------------------------------------------------------------
+
+struct BotParams {
+    name: Option<String>,
+    avatar: Assignment,
+}
+
+/// `params.require(:bot).permit(:name, :avatar)`.
+fn bot_params(c: &Ctx) -> Result<BotParams> {
+    let bot = c.params.require("bot")?;
+    let permitted = bot.permit(&permit_keys(&["name", "avatar"]));
+    let name = permitted.get("name").and_then(Param::to_s);
+    let avatar = Assignment::from_params(&permitted, "avatar")?;
+    Ok(BotParams { name, avatar })
+}
+
+/// `Bot.visible_to(Current.user).find(params[:id])`: 404 when missing or not visible.
+async fn find_visible_bot(c: &Ctx) -> Result<Bot> {
+    let current = require_current_user(c)?.clone();
+    let id = c.param_str("id").and_then(integer_cast).ok_or(campfire_kit::Error::NotFound)?;
+    c.app()
+        .read(move |conn| {
+            let bot = Bot::find_by_id(conn, id)?.ok_or(campfire_db::Error::RecordNotFound("Bot"))?;
+            if !current.is_administrator() && bot.creator_id != current.id {
+                return Err(campfire_db::Error::RecordNotFound("Bot"));
+            }
+            Ok(bot)
+        })
+        .await
+}
+
+async fn bot_view(c: &Ctx, bot: &Bot) -> Result<views::BotView> {
+    let bot = bot.clone();
+    let secrets = c.app().secrets.clone();
+    c.app()
+        .read(move |conn| {
+            let user = User::find(conn, bot.user_id)?;
+            Ok(views::BotView {
+                id: bot.id,
+                user_id: bot.user_id,
+                name: user.name.clone(),
+                avatar_url: avatar_path(&secrets, &user),
+                bot_code: bot.bot_code.clone(),
+            })
+        })
+        .await
+}
+
+async fn bot_views(c: &Ctx, current: &User) -> Result<Vec<views::BotView>> {
+    let current = current.clone();
+    let secrets = c.app().secrets.clone();
+    c.app()
+        .read(move |conn| {
+            let bots = Bot::visible_to(conn, &current)?;
+            bots.into_iter()
+                .map(|bot| {
+                    let user = User::find(conn, bot.user_id)?;
+                    Ok(views::BotView {
+                        id: bot.id,
+                        user_id: bot.user_id,
+                        name: user.name.clone(),
+                        avatar_url: avatar_path(&secrets, &user),
+                        bot_code: bot.bot_code.clone(),
+                    })
+                })
+                .collect::<campfire_db::Result<Vec<_>>>()
+        })
+        .await
+}
+
