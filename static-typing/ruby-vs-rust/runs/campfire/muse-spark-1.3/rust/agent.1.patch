diff --git a/crates/db/src/models/bot.rs b/crates/db/src/models/bot.rs
new file mode 100644
index 0000000..298fdcc
--- /dev/null
+++ b/crates/db/src/models/bot.rs
@@ -0,0 +1,180 @@
+//! `Bot`: a chat bot backed by a `users` row (name/avatar/memberships) plus a
+//! credential row here. The `bots` table is a Rust-only addition (see
+//! `schema::ADDITIONS`), so existing Rails databases gain it on boot.
+
+use rusqlite::{Connection, params};
+
+use crate::database::Tx;
+use crate::error::{Errors, OptionalExt, Result};
+use crate::models::{NewUser, Role, User};
+use crate::sql::{self, CachedStatements, columns, placeholders, query_all, query_one};
+use crate::time::Timestamp;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Bot {
+    pub id: i64,
+    pub user_id: i64,
+    pub creator_id: i64,
+    pub bot_code: String,
+    pub created_at: Timestamp,
+    pub updated_at: Timestamp,
+}
+
+columns! {
+    Bot, "bots", bot_columns {
+        id: "id",
+        user_id: "user_id",
+        creator_id: "creator_id",
+        bot_code: "bot_code",
+        created_at: "created_at",
+        updated_at: "updated_at",
+    }
+}
+
+impl Bot {
+    pub const SELECT: &str = concat!("SELECT ", bot_columns!(), r#" FROM "bots""#);
+
+    pub fn find(conn: &Connection, id: i64) -> Result<Self> {
+        Self::find_by_id(conn, id)?.or_not_found("Bot")
+    }
+
+    pub fn find_by_id(conn: &Connection, id: i64) -> Result<Option<Self>> {
+        query_one(conn, concat!("SELECT ", bot_columns!(), r#" FROM "bots" WHERE "bots"."id" = ? LIMIT 1"#), [id], Self::from_row)
+    }
+
+    pub fn find_by_user_id(conn: &Connection, user_id: i64) -> Result<Option<Self>> {
+        query_one(
+            conn,
+            concat!("SELECT ", bot_columns!(), r#" FROM "bots" WHERE "bots"."user_id" = ? LIMIT 1"#),
+            [user_id],
+            Self::from_row,
+        )
+    }
+
+    /// Authenticate a bot API request: the `bots` row for `bot_code`, if any.
+    pub fn find_by_code(conn: &Connection, bot_code: &str) -> Result<Option<Self>> {
+        query_one(
+            conn,
+            concat!("SELECT ", bot_columns!(), r#" FROM "bots" WHERE "bots"."bot_code" = ? LIMIT 1"#),
+            [bot_code],
+            Self::from_row,
+        )
+    }
+
+    pub fn all(conn: &Connection) -> Result<Vec<Self>> {
+        query_all(conn, concat!("SELECT ", bot_columns!(), r#" FROM "bots" ORDER BY "bots"."id" ASC"#), [], Self::from_row)
+    }
+
+    /// Bots `creator` made, oldest first.
+    pub fn for_creator(conn: &Connection, creator_id: i64) -> Result<Vec<Self>> {
+        query_all(
+            conn,
+            concat!("SELECT ", bot_columns!(), r#" FROM "bots" WHERE "bots"."creator_id" = ? ORDER BY "bots"."id" ASC"#),
+            [creator_id],
+            Self::from_row,
+        )
+    }
+
+    /// What `/bots` lists: every bot for administrators, else only `creator`'s own.
+    pub fn visible_to(conn: &Connection, user: &User) -> Result<Vec<Self>> {
+        if user.is_administrator() { Self::all(conn) } else { Self::for_creator(conn, user.id) }
+    }
+
+    pub fn count(conn: &Connection) -> Result<i64> {
+        sql::count(conn, r#"SELECT COUNT(*) FROM "bots""#, [])
+    }
+
+    pub fn user(&self, conn: &Connection) -> Result<User> {
+        User::find(conn, self.user_id)
+    }
+
+    pub fn creator(&self, conn: &Connection) -> Result<User> {
+        User::find(conn, self.creator_id)
+    }
+
+    /// Validate a bot name the way the form does: present (non-blank).
+    pub fn validate_name(name: &str) -> Result<()> {
+        if name.trim().is_empty() {
+            let mut errors = Errors::default();
+            errors.add("name", "can't be blank");
+            return errors.into_result();
+        }
+        Ok(())
+    }
+
+    /// Create the bot's `users` row (like any new user, it joins all open rooms
+    /// via `User::create`'s after-commit hook) plus its `bots` row.
+    pub fn create(tx: &mut Tx<'_>, creator_id: i64, name: &str) -> Result<Self> {
+        Self::validate_name(name)?;
+        // Bots sign in with their code, never with a password (`User::create` stores
+        // "" for the NOT NULL `password_digest`, which never authenticates).
+        let user = User::create(
+            tx,
+            NewUser { name: name.trim().to_string(), email_address: None, password_digest: None, role: Role::Member, bio: None },
+        )?;
+        let bot_code = generate_bot_code(tx.conn())?;
+        let now = tx.now();
+        let id: i64 = tx.conn().query_row_cached(
+            r#"INSERT INTO "bots" ("bot_code", "created_at", "creator_id", "updated_at", "user_id") VALUES (?, ?, ?, ?, ?) RETURNING "id""#,
+            params![bot_code, now, creator_id, now, user.id],
+            |r| r.get(0),
+        )?;
+        Self::find(tx.conn(), id)
+    }
+
+    /// Rename the bot (its `users` row's name).
+    pub fn rename(&self, tx: &mut Tx<'_>, name: &str) -> Result<()> {
+        Self::validate_name(name)?;
+        let mut user = User::find(tx.conn(), self.user_id)?;
+        user.update(tx, crate::models::user::UserChanges { name: Some(name.trim().to_string()), ..Default::default() })?;
+        tx.conn().execute_cached(r#"UPDATE "bots" SET "updated_at" = ? WHERE "bots"."id" = ?"#, params![tx.now(), self.id])?;
+        Ok(())
+    }
+
+    /// Delete the bot: its `bots` row, its memberships, its avatar attachment and
+    /// — when it never posted — its `users` row. Past messages keep rendering
+    /// because their creator row is kept while messages exist.
+    pub fn destroy(&self, tx: &mut Tx<'_>) -> Result<()> {
+        use crate::models::Message;
+        tx.conn().execute_cached(r#"DELETE FROM "bots" WHERE "bots"."id" = ?"#, [self.id])?;
+        tx.conn().execute_cached(r#"DELETE FROM "memberships" WHERE "memberships"."user_id" = ?"#, [self.user_id])?;
+        // Drop the avatar attachment (blob purged after commit, like `has_one_attached`).
+        if let Some(attachment) = crate::models::Attachment::find_for(tx.conn(), "User", self.user_id, "avatar")? {
+            let blob_id = attachment.blob_id;
+            tx.conn().execute_cached(r#"DELETE FROM "active_storage_attachments" WHERE "active_storage_attachments"."id" = ?"#, [attachment.id])?;
+            tx.emit_after_commit(crate::events::Event::PurgeBlob { blob_id });
+        }
+        if Message::by_creator(tx.conn(), self.user_id)?.is_empty() {
+            // No history to preserve: remove the users row too.
+            // Direct `DELETE` (no callbacks): bots have no sessions/push/searches.
+            tx.conn().execute_cached(r#"DELETE FROM "users" WHERE "users"."id" = ?"#, [self.user_id])?;
+        }
+        Ok(())
+    }
+
+    pub fn reload(&mut self, conn: &Connection) -> Result<()> {
+        *self = Self::find(conn, self.id)?;
+        Ok(())
+    }
+}
+
+/// A unique, unguessable credential for bot API requests.
+pub fn generate_bot_code(conn: &Connection) -> Result<String> {
+    for _ in 0..10 {
+        let code = sql::alphanumeric(32);
+        let exists: bool = sql::exists(conn, r#"SELECT 1 FROM "bots" WHERE "bots"."bot_code" = ? LIMIT 1"#, [&code])?;
+        if !exists {
+            return Ok(code);
+        }
+    }
+    Err(crate::error::Error::other("could not generate unique bot code"))
+}
+
+/// `User.where(id:)` for a list of bot user ids, in id order.
+pub fn bot_users(conn: &Connection, user_ids: &[i64]) -> Result<Vec<User>> {
+    if user_ids.is_empty() {
+        return Ok(Vec::new());
+    }
+    let sql = format!(r#"{} WHERE "users"."id" IN ({}) ORDER BY "users"."id" ASC"#, User::SELECT, placeholders(user_ids.len()));
+    User::find_by_sql(conn, &sql, rusqlite::params_from_iter(user_ids.iter().copied()))
+}
