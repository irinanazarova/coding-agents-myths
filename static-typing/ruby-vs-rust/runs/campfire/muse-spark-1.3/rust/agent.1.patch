+                let david = campfire_db::User::find(conn, david_id).unwrap();
+                let kevin = campfire_db::User::find(conn, kevin_id).unwrap();
+                Ok((campfire_db::Bot::visible_to(conn, &david).unwrap().len(), campfire_db::Bot::visible_to(conn, &kevin).unwrap().len()))
+            })
+            .await
+            .unwrap();
+        assert_eq!(david_bots, 1, "admin sees all");
+        assert_eq!(kevin_bots, 0, "member sees only own (none yet)");
+        // Kevin's own bot, created directly.
+        app.db().write(move |tx| Ok(campfire_db::Bot::create(tx, kevin_id, "Kevin Bot").unwrap().id)).await.unwrap();
+        let (david_bots, kevin_bots) = app
+            .db()
+            .read(move |conn| {
+                let david = campfire_db::User::find(conn, DAVID).unwrap();
+                let kevin = campfire_db::User::find(conn, KEVIN).unwrap();
+                Ok((campfire_db::Bot::visible_to(conn, &david).unwrap().len(), campfire_db::Bot::visible_to(conn, &kevin).unwrap().len()))
+            })
+            .await
+            .unwrap();
+        assert_eq!(david_bots, 2, "admin sees both");
+        assert_eq!(kevin_bots, 1, "member sees own");
+        // Kevin (member) cannot open David's bot for editing: start a Kevin session
+        // and sign its cookie like the cable tests do.
+        let token = app.db().write(move |tx| Ok(campfire_db::Session::start(tx, KEVIN, Some("test"), Some("8.8.8.8")).unwrap().token)).await.unwrap();
+        let signed = rails_compat::cookies::sign(&app.booted.app.secrets, "session_token", &token, None);
+        let cookie = format!("session_token={}", signed.replace('+', "%2B").replace('/', "%2F").replace('=', "%3D"));
+        let david_bot_id =
+            app.db().read(|conn| Ok(campfire_db::Bot::all(conn).unwrap().into_iter().find(|b| b.creator_id == DAVID).unwrap().id)).await.unwrap();
+        let mut kevin = app.anonymous();
+        let reply = kevin.send(Req::new(Method::GET, &format!("/bots/{david_bot_id}/edit")).header("cookie", &cookie)).await;
+        assert_eq!(reply.status, StatusCode::NOT_FOUND, "cannot edit others bot: {} {}", reply.status, reply.text());
+        // But David (admin) can open Kevin's bot.
+        let kevin_bot_id =
+            app.db().read(|conn| Ok(campfire_db::Bot::all(conn).unwrap().into_iter().find(|b| b.creator_id == KEVIN).unwrap().id)).await.unwrap();
+        let reply = david.get(&format!("/bots/{kevin_bot_id}/edit")).await;
+        assert_eq!(reply.status, StatusCode::OK, "{}", reply.text());
+    }
+}
