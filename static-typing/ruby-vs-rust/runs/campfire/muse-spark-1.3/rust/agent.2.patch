+    }
+
+    #[tokio::test]
+    async fn webhook_html_reply_and_slow_does_not_block() {
+        use axum::http::{Method, StatusCode};
+        use crate::controllers::presenters::test_support::{ALL_TALK, Req, TestApp};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let app = TestApp::boot().await;
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        tokio::spawn(async move {
+            let (mut sock, _) = listener.accept().await.unwrap();
+            let mut buf = Vec::new();
+            loop {
+                let mut chunk = [0u8; 4096];
+                let n = sock.read(&mut chunk).await.unwrap();
+                if n == 0 { break; }
+                buf.extend_from_slice(&chunk[..n]);
+                if buf.windows(4).any(|w| w == b"\r\n\r\n") { break; }
+            }
+            let header_end = buf.windows(4).position(|w| w == b"\r\n\r\n").unwrap() + 4;
+            let header = String::from_utf8_lossy(&buf[..header_end]).to_string();
+            let len: usize = header.lines().find_map(|l| { let (k,v)=l.split_once(':')?; if k.trim().eq_ignore_ascii_case("content-length") {v.trim().parse().ok()} else {None} }).unwrap_or(0);
+            let mut body = buf[header_end..].to_vec();
+            while body.len() < len { let mut c=[0u8;4096]; let n=sock.read(&mut c).await.unwrap(); if n==0{break;} body.extend_from_slice(&c[..n]); }
+            // Slow: wait 2s before answering, poster must not wait.
+            tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+            let reply = b"<b>html pong</b>";
+            let resp = format!("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", reply.len());
+            sock.write_all(resp.as_bytes()).await.unwrap();
+            sock.write_all(reply).await.unwrap();
+        });
+        let webhook = format!("http://{addr}/hook");
+        let mut david = app.david();
+        let reply = david.write(Req::new(Method::POST, "/bots").form(&[("bot[name]", "Slow"), ("bot[webhook_url]", &webhook)])).await;
+        assert_eq!(reply.status, StatusCode::FOUND);
+        let bot_user_id = app.db().read(move |conn| Ok(campfire_db::Bot::all(conn).unwrap().pop().unwrap().user_id)).await.unwrap();
+        let secrets = app.booted.app.secrets.clone();
+        let sgid = crate::controllers::presenters::accounts::attachable_sgid(&secrets, bot_user_id);
+        let body = format!("<p><action-text-attachment sgid=\"{sgid}\" content-type=\"application/vnd.campfire.mention\"></action-text-attachment> hi</p>");
+        let start = std::time::Instant::now();
+        let reply = david.write(Req::new(Method::POST, &format!("/rooms/{ALL_TALK}/messages")).header("accept", "text/vnd.turbo-stream.html, text/html, application/xhtml+xml").form(&[("message[body]", &body)])).await;
+        assert_eq!(reply.status, StatusCode::OK);
+        assert!(start.elapsed() < std::time::Duration::from_secs(1), "poster not slowed {:?}", start.elapsed());
+        // Wait for slow reply.
+        let db = app.db().clone();
+        let rich = app.booted.app.db.env().rich_text.clone();
+        let mut found = false;
+        for _ in 0..100 {
+            tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+            let msgs = db.read(move |conn| campfire_db::Message::for_room(conn, ALL_TALK)).await.unwrap();
+            for m in msgs.iter().filter(|m| m.creator_id == bot_user_id) {
+                let mid = m.id; let r2 = rich.clone();
+                let plain = db.read(move |conn| Ok(campfire_db::Message::find(conn, mid).unwrap().plain_text_body(conn, &*r2).unwrap())).await.unwrap();
+                if plain.contains("html pong") { found = true; break; }
+            }
+            if found { break; }
+        }
+        assert!(found, "html reply posted");
+    }
+
+    #[test]
+    fn strips_the_bots_own_mention() {
+        assert_eq!(stripped_text("@Helper restart the build please", "Helper"), "restart the build please");
+        assert_eq!(stripped_text("@Helper  restart", "Helper"), "restart");
+        assert_eq!(stripped_text("hey @Helper please restart", "Helper"), "hey please restart");
+        assert_eq!(stripped_text("@Helper", "Helper"), "");
+        assert_eq!(stripped_text("no mention here", "Helper"), "no mention here");
+        // Another bot's mention stays.
+        assert_eq!(stripped_text("@Helper hi @Other", "Helper"), "hi @Other");
+    }
+}
