+//! Bot webhooks: `POST` a JSON `mention` event to each mentioned bot's `webhook_url`,
+//! and post the bot's synchronous reply (if any) as its message.
+//!
+//! Delivery runs on the job runner (`Jobs::perform_later`, the `AdHoc` queue), so
+//! posting a message never waits for a bot's server. A slow or failing webhook is
+//! logged and dropped; nothing retries.
+
+use std::time::Duration;
+
+use campfire_db::{Bot, Message, NewMessage, Room, User};
+
+use crate::app::App;
+
+/// How long a webhook POST may take to connect / read, and overall.
+const OPEN_TIMEOUT: Duration = Duration::from_secs(10);
+const READ_TIMEOUT: Duration = Duration::from_secs(10);
+const DELIVERY_DEADLINE: Duration = Duration::from_secs(30);
+/// The most of a webhook's reply body that is read (a chat message is small).
+const MAX_REPLY_BYTES: usize = 1024 * 1024;
+
+struct Target {
+    bot: Bot,
+    bot_name: String,
+    webhook_url: String,
+}
+
+struct Snapshot {
+    room: Room,
+    author_id: i64,
+    author_name: String,
+    message_id: i64,
+    body_html: String,
+    plain_text: String,
+    targets: Vec<Target>,
+}
+
+/// Enqueue webhook deliveries for `message` in `room`. Returns immediately: the
+/// work runs on the job runner, so the poster's response never waits for bots.
+pub fn notify_after_message(app: &App, room: &Room, message: &Message, base_url: &str) {
+    let job_app = app.clone();
+    let room_id = room.id;
+    let message_id = message.id;
+    let base_url = base_url.to_string();
+    app.jobs.perform_later("BotWebhook", async move {
+        if let Err(error) = deliver_mentions(&job_app, room_id, message_id, &base_url).await {
+            tracing::warn!(%error, room_id, message_id, "bot webhook delivery failed");
+        }
+        Ok(())
+    });
+}
+
+/// Read the message, find mentioned bots with webhooks, `POST` each one, and
+/// post any synchronous reply as the bot's message.
+async fn deliver_mentions(app: &App, room_id: i64, message_id: i64, base_url: &str) -> anyhow::Result<()> {
+    let app2 = app.clone();
+    let snapshot: Option<Snapshot> = app
+        .db
+        .read(move |conn| {
+            let Some(room) = Room::find_by_id(conn, room_id)? else {
+                return Ok(None);
+            };
+            let Some(message) = Message::find_by_id(conn, message_id)? else {
+                return Ok(None);
+            };
+            // The message may have been destroyed before the job ran.
+            if message.room_id != room.id {
+                return Ok(None);
+            }
+            let rich_text = &*app2.db.env().rich_text;
+            let body_html = message.body_html(conn)?.unwrap_or_default();
+            let mentioned_ids = rich_text.mentioned_user_ids(conn, &body_html);
+            if mentioned_ids.is_empty() {
+                return Ok(None);
+            }
+            let bots = campfire_db::models::bot::bots_with_webhook_for_user_ids(conn, &mentioned_ids)?;
+            if bots.is_empty() {
+                return Ok(None);
+            }
+            let author = User::find(conn, message.creator_id)?;
+            let plain_text = message.plain_text_body(conn, rich_text)?;
+            let mut targets = Vec::new();
+            for bot in bots {
+                // A bot talking to itself must not loop.
+                if bot.user_id == author.id {
+                    continue;
+                }
+                let Some(url) = bot.webhook_url.clone().filter(|u| !u.trim().is_empty()) else {
+                    continue;
+                };
+                let bot_user = User::find(conn, bot.user_id)?;
+                targets.push(Target { bot, bot_name: bot_user.name.clone(), webhook_url: url });
+            }
+            if targets.is_empty() {
+                return Ok(None);
+            }
+            Ok(Some(Snapshot {
+                room,
+                author_id: author.id,
+                author_name: author.name.clone(),
+                message_id: message.id,
+                body_html,
+                plain_text,
+                targets,
+            }))
+        })
+        .await
+        .map_err(|e| anyhow::anyhow!("{e:?}"))?;
+
+    let Some(snapshot) = snapshot else { return Ok(()) };
+    for target in &snapshot.targets {
+        let payload = mention_payload(&snapshot, target);
+        match post_json(&target.webhook_url, &payload).await {
+            Ok(Some(reply)) => {
+                if let Err(error) = post_bot_reply(app, &snapshot.room, &target.bot, reply, base_url).await {
+                    tracing::warn!(%error, bot_id = target.bot.id, "bot reply failed");
+                }
+            }
+            Ok(None) => {}
+            Err(error) => {
+                tracing::warn!(%error, bot_id = target.bot.id, webhook = target.webhook_url.as_str(), "bot webhook failed");
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The `mention` event payload for one bot. Paths are relative; the bot knows
+/// its Campfire origin.
+fn mention_payload(snapshot: &Snapshot, target: &Target) -> serde_json::Value {
+    let text = stripped_text(&snapshot.plain_text, &target.bot_name);
+    let room_name = snapshot.room.name.clone().unwrap_or_default();
+    serde_json::json!({
+        "event": "mention",
+        "author": { "id": snapshot.author_id, "name": snapshot.author_name },
+        "room": {
+            "id": snapshot.room.id,
+            "name": room_name,
+            "reply_to": campfire_routes::room_bot_messages(snapshot.room.id, &target.bot.bot_code),
+        },
+        "message": {
+            "id": snapshot.message_id,
+            "body": { "text": text, "html": snapshot.body_html },
+            "link": campfire_routes::room_at_message(snapshot.room.id, snapshot.message_id),
+        },
+    })
+}
+
+/// `message.body.text`: the bot's own `@`-mention stripped, so the text reads
+/// as the command addressed to the bot.
+fn stripped_text(plain: &str, bot_name: &str) -> String {
+    let mention = format!("@{bot_name}");
+    let stripped = plain.replace(mention.as_str(), "");
+    // Trim the ends and collapse runs of spaces/tabs left behind; newlines stay.
+    let trimmed = stripped.trim();
+    let mut out = String::with_capacity(trimmed.len());
+    let mut spaces = 0;
+    for c in trimmed.chars() {
+        if c == ' ' || c == '\t' {
+            spaces += 1;
+            if spaces == 1 {
+                out.push(' ');
+            }
+        } else {
+            spaces = 0;
+            out.push(c);
+        }
+    }
+    out.trim().to_string()
+}
+
+struct BotReply {
+    content_type: Option<String>,
+    body: Vec<u8>,
+}
+
+/// `POST` the JSON payload to the webhook. Returns the synchronous reply when
+/// one should become the bot's message, or `None` for `204` / errors handled
+/// by the caller.
+async fn post_json(url: &str, payload: &serde_json::Value) -> anyhow::Result<Option<BotReply>> {
+    use crate::integrations::net::Network;
+    use crate::integrations::net::http::{self, Body, Endpoint, Timeouts};
+
+    let uri = campfire_richtext::uri::parse(url).map_err(|_| anyhow::anyhow!("bad webhook URL"))?;
+    if !uri.is_http() {
+        anyhow::bail!("webhook URL must be http(s)");
+    }
+    let host = uri.host.clone().filter(|h| !h.is_empty()).ok_or_else(|| anyhow::anyhow!("webhook URL has no host"))?;
+    let https = uri.scheme.as_deref().is_some_and(|s| s.eq_ignore_ascii_case("https"));
+    let default_port = if https { 443 } else { 80 };
+    let port = uri.port.and_then(|p| u16::try_from(p).ok()).unwrap_or(default_port);
+    let endpoint = Endpoint { https, host: host.clone(), port, pinned_ip: None };
+    let body = payload.to_string().into_bytes();
+
+    // `Host` without the default port, as `Net::HTTP` sends it.
+    let host_header = {
+        let bare = host.strip_prefix('[').and_then(|h| h.strip_suffix(']')).unwrap_or(&host);
+        if port == default_port { bare.to_string() } else { format!("{bare}:{port}") }
+    };
+    let headers = vec![
+        ("Content-Type".to_string(), "application/json".to_string()),
+        ("Content-Length".to_string(), body.len().to_string()),
+    ];
+    let mut request = http::Request::net_http(hyper::Method::POST, http::request_uri(&uri), Some(host_header), headers).transport(true, &endpoint);
+    request.body = body;
+    request.decode_content = false;
+
+    let net = Network::system();
+    let timeouts = Timeouts { open: OPEN_TIMEOUT, read: READ_TIMEOUT };
+    let response = tokio::time::timeout(DELIVERY_DEADLINE, http::exchange(&net, &endpoint, request, &timeouts))
+        .await
+        .map_err(|_| anyhow::anyhow!("webhook timed out"))?
+        .map_err(|e| anyhow::anyhow!("webhook request failed: {e}"))?;
+
+    let status = response.status;
+    if status == 204 {
+        return Ok(None);
+    }
+    if status != 200 {
+        tracing::warn!(status, webhook = url, "bot webhook answered with unexpected status");
+        return Ok(None);
+    }
+    let content_type = response.content_type();
+    let is_text = content_type.as_deref().is_some_and(|t| {
+        let lower = t.to_ascii_lowercase();
+        lower == "text/plain" || lower == "text/html"
+    });
+    if !is_text {
+        return Ok(None);
+    }
+    let reply_body = match response.read_body(MAX_REPLY_BYTES).await.map_err(|e| anyhow::anyhow!("reading bot reply: {e}"))? {
+        Body::Complete(body) => body,
+        Body::TooLarge => {
+            tracing::warn!(webhook = url, "bot reply too large");
+            return Ok(None);
+        }
+    };
+    if reply_body.iter().all(|b| b.is_ascii_whitespace()) || reply_body.is_empty() {
+        return Ok(None);
+    }
+    Ok(Some(BotReply { content_type, body: reply_body }))
+}
+
+/// Post the bot's synchronous reply (`200 text/plain|text/html`) as its message.
+async fn post_bot_reply(app: &App, room: &Room, bot: &Bot, reply: BotReply, base_url: &str) -> anyhow::Result<()> {
+    let text = String::from_utf8_lossy(&reply.body).into_owned();
+    if text.trim().is_empty() {
+        return Ok(());
+    }
+    let content_type = reply.content_type.as_deref().unwrap_or("").to_ascii_lowercase();
+    // `text/plain` arrives as plain text, `text/html` as HTML; both canonicalize
+    // the way the bot posting API does. Plain text is used as-is: the content
+    // pipeline escapes what needs escaping when it parses the fragment.
+    let _ = content_type;
+    let app2 = app.clone();
+    let canonical = crate::controllers::messages::canonicalize_body(&app2, text, None).await.map_err(|e| anyhow::anyhow!("{e:?}"))?;
+    if canonical.trim().is_empty() {
+        return Ok(());
+    }
+    let room = room.clone();
+    let bot = bot.clone();
+    let base_url = base_url.to_string();
+    let app3 = app.clone();
+    let creator_id = bot.user_id;
+    let room_id = room.id;
+    let message = app
+        .db
+        .write(move |tx| {
+            Message::create(
+                tx,
+                NewMessage { room_id, creator_id, client_message_id: None, body: Some(canonical), attachment_blob_id: None },
+            )
+        })
+        .await
+        .map_err(|e| anyhow::anyhow!("{e:?}"))?;
+    broadcast_bot_message(&app3, &room, &message, &base_url).await?;
+    // The reply itself may mention other bots (chaining); enqueue like any message.
+    // Self-mentions are skipped in `deliver_mentions`, so a bot cannot loop on itself.
+    notify_after_message(&app3, &room, &message, &base_url);
+    Ok(())
+}
+
+/// `broadcast_create` outside a request (the base URL was captured when enqueuing).
+async fn broadcast_bot_message(app: &App, room: &Room, message: &Message, base_url: &str) -> anyhow::Result<()> {
+    use campfire_views::messages as views;
+    use crate::controllers::presenters::{Presenter, page::render_detached_at};
+    use crate::controllers::presenters::page::Rendered;
+
+    let app2 = app.clone();
+    let room = room.clone();
+    let message = message.clone();
+    let base_url = base_url.to_string();
+    app.db
+        .read(move |conn| {
+            let presenter = Presenter::new(conn, &app2, None);
+            let view = presenter.message(&message)?;
+            let account = campfire_db::Account::first(conn)?;
+            let html = render_detached_at(&app2, account.as_ref(), &base_url, |ctx| views::message(ctx, &view));
+            let partials = Rendered { message: Some(html), ..Rendered::default() };
+            app2.broadcasts.message_create(conn, &room, &message, &partials)
+        })
+        .await
+        .map_err(|e| anyhow::anyhow!("{e:?}"))?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::stripped_text;
+
+    #[tokio::test]
+    async fn mention_triggers_webhook_and_sync_text_reply() {
+        use axum::http::{Method, StatusCode};
+        use crate::controllers::presenters::test_support::{ALL_TALK, DAVID, Req, TestApp};
+        use std::sync::{Arc, Mutex};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+        let app = TestApp::boot().await;
+        // Start a tiny HTTP server that records the webhook POST and answers 200 text/plain.
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let seen: Arc<Mutex<Option<(String, Vec<u8>, String)>>> = Arc::new(Mutex::new(None));
+        let seen2 = seen.clone();
+        tokio::spawn(async move {
+            let (mut sock, _) = listener.accept().await.unwrap();
+            let mut buf = Vec::new();
+            // Read headers.
+            loop {
+                let mut chunk = [0u8; 4096];
+                let n = sock.read(&mut chunk).await.unwrap();
+                if n == 0 { break; }
+                buf.extend_from_slice(&chunk[..n]);
+                if buf.windows(4).any(|w| w == b"\r\n\r\n") { break; }
+            }
+            let header_end = buf.windows(4).position(|w| w == b"\r\n\r\n").unwrap() + 4;
+            let header = String::from_utf8_lossy(&buf[..header_end]).to_string();
+            let content_len: usize = header.lines().find_map(|l| {
+                let (k, v) = l.split_once(':')?;
+                if k.trim().eq_ignore_ascii_case("content-length") { v.trim().parse().ok() } else { None }
+            }).unwrap_or(0);
+            let mut body = buf[header_end..].to_vec();
+            while body.len() < content_len {
+                let mut chunk = [0u8; 4096];
+                let n = sock.read(&mut chunk).await.unwrap();
+                if n == 0 { break; }
+                body.extend_from_slice(&chunk[..n]);
+            }
+            *seen2.lock().unwrap() = Some((header, body.clone(), String::new()));
+            let reply = b"pong from bot";
+            let resp = format!("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", reply.len());
+            sock.write_all(resp.as_bytes()).await.unwrap();
+            sock.write_all(reply).await.unwrap();
+        });
+
+        // Create bot with webhook.
+        let webhook = format!("http://{addr}/hook");
+        let mut david = app.david();
+        let reply = david.write(Req::new(Method::POST, "/bots").form(&[("bot[name]", "Helper"), ("bot[webhook_url]", &webhook)])).await;
+        assert_eq!(reply.status, StatusCode::FOUND, "create bot {}", reply.text());
+        let (bot_id, bot_user_id, bot_code) = app.db().read(move |conn| {
+            let b = campfire_db::Bot::all(conn).unwrap().pop().unwrap();
+            Ok((b.id, b.user_id, b.bot_code.clone()))
+        }).await.unwrap();
+        // Bot form shows webhook field.
+        let html = david.get("/bots/new").await.text();
+        assert!(html.contains("Webhook URL"), "new form {html}");
+        let html = david.get(&format!("/bots/{bot_id}/edit")).await.text();
+        assert!(html.contains("Webhook URL"), "edit form");
+        assert!(html.contains(&webhook), "edit shows url");
+        // Autocomplete includes bot, like people (all users, and open-room members).
+        {
+            let reply = david.get("/autocompletable/users?filter=Helper").await;
+            assert!(reply.text().contains("Helper"), "autocomplete lists bot");
+            use crate::controllers::presenters::test_support::HQ;
+            let reply = david.get(&format!("/autocompletable/users?room_id={HQ}&filter=Helper")).await;
+            assert!(reply.text().contains("Helper"), "open-room autocomplete lists bot");
+        }
+        let secrets = app.booted.app.secrets.clone();
+        let sgid = crate::controllers::presenters::accounts::attachable_sgid(&secrets, bot_user_id);
+        // Post a message mentioning the bot.
+        let body = format!("<p><action-text-attachment sgid=\"{sgid}\" content-type=\"application/vnd.campfire.mention\"></action-text-attachment> restart the build please</p>");
+        let start = std::time::Instant::now();
+        let reply = david.write(Req::new(Method::POST, &format!("/rooms/{ALL_TALK}/messages")).header("accept", "text/vnd.turbo-stream.html, text/html, application/xhtml+xml").form(&[("message[body]", &body)])).await;
+        assert_eq!(reply.status, StatusCode::OK, "post {}", reply.text());
+        // Wait for webhook + reply (background job).
+        let mut payload: Option<serde_json::Value> = None;
+        for _ in 0..100 {
+            tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+            if let Some((header, body, _)) = seen.lock().unwrap().clone() {
+                assert!(header.contains("application/json"), "ct {header}");
+                payload = Some(serde_json::from_slice(&body).unwrap());
+                break;
+            }
+            if start.elapsed() > std::time::Duration::from_secs(10) { break; }
+        }
+        let payload = payload.expect("webhook was called");
+        assert_eq!(payload["event"], "mention");
+        assert_eq!(payload["author"]["id"], DAVID);
+        assert_eq!(payload["author"]["name"], "David");
+        assert_eq!(payload["room"]["id"], ALL_TALK);
+        assert!(payload["room"]["name"].is_string());
+        let reply_to = payload["room"]["reply_to"].as_str().unwrap();
+        assert_eq!(reply_to, format!("/rooms/{ALL_TALK}/{bot_code}/messages"));
+        assert_eq!(payload["message"]["body"]["text"], "restart the build please");
+        assert!(payload["message"]["body"]["html"].as_str().unwrap().contains("restart the build please"));
+        let link = payload["message"]["link"].as_str().unwrap();
+        assert!(link.starts_with(&format!("/rooms/{ALL_TALK}/@")), "{link}");
+        // Synchronous reply posted as bot message.
+        let db = app.db().clone();
+        let env_rich = app.booted.app.db.env().rich_text.clone();
+        let mut found = None;
+        for _ in 0..100 {
+            tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+            let msgs = db.read(move |conn| campfire_db::Message::for_room(conn, ALL_TALK)).await.unwrap();
+            if let Some(m) = msgs.iter().find(|m| m.creator_id == bot_user_id) {
+                let mid = m.id;
+                let env_rich = env_rich.clone();
+                let plain = db.read(move |conn| {
+                    let msg = campfire_db::Message::find(conn, mid).unwrap();
+                    Ok(msg.plain_text_body(conn, &*env_rich).unwrap())
+                }).await.unwrap();
+                if plain.contains("pong from bot") { found = Some(plain); break; }
+            }
+        }
+        assert!(found.is_some(), "bot reply posted");
+    }
+
+    #[tokio::test]
+    async fn webhook_204_posts_nothing_and_empty_removes() {
+        use axum::http::{Method, StatusCode};
+        use crate::controllers::presenters::test_support::{ALL_TALK, Req, TestApp};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        use std::sync::{Arc, Mutex};
+        let app = TestApp::boot().await;
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let hits: Arc<Mutex<i32>> = Arc::new(Mutex::new(0));
+        let hits2 = hits.clone();
+        tokio::spawn(async move {
+            let (mut sock, _) = listener.accept().await.unwrap();
+            let mut buf = Vec::new();
+            loop {
+                let mut chunk = [0u8; 4096];
+                let n = sock.read(&mut chunk).await.unwrap();
+                if n == 0 { break; }
+                buf.extend_from_slice(&chunk[..n]);
+                if buf.windows(4).any(|w| w == b"\r\n\r\n") { break; }
+            }
+            let header_end = buf.windows(4).position(|w| w == b"\r\n\r\n").unwrap() + 4;
+            let header = String::from_utf8_lossy(&buf[..header_end]).to_string();
+            let len: usize = header.lines().find_map(|l| { let (k,v)=l.split_once(':')?; if k.trim().eq_ignore_ascii_case("content-length") {v.trim().parse().ok()} else {None} }).unwrap_or(0);
+            let mut body = buf[header_end..].to_vec();
+            while body.len() < len { let mut c=[0u8;4096]; let n=sock.read(&mut c).await.unwrap(); if n==0{break;} body.extend_from_slice(&c[..n]); }
+            *hits2.lock().unwrap() += 1;
+            sock.write_all(b"HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n").await.unwrap();
+        });
+        let webhook = format!("http://{addr}/hook");
+        let mut david = app.david();
+        let reply = david.write(Req::new(Method::POST, "/bots").form(&[("bot[name]", "NoReply"), ("bot[webhook_url]", &webhook)])).await;
+        assert_eq!(reply.status, StatusCode::FOUND);
+        let (bot_id, bot_user_id) = app.db().read(move |conn| { let b=campfire_db::Bot::all(conn).unwrap().pop().unwrap(); Ok((b.id,b.user_id)) }).await.unwrap();
+        let secrets = app.booted.app.secrets.clone();
+        let sgid = crate::controllers::presenters::accounts::attachable_sgid(&secrets, bot_user_id);
+        let body = format!("<p><action-text-attachment sgid=\"{sgid}\" content-type=\"application/vnd.campfire.mention\"></action-text-attachment> hi</p>");
+        let before = app.db().read(move |conn| Ok(campfire_db::Message::for_room(conn, ALL_TALK).unwrap().len())).await.unwrap();
+        let reply = david.write(Req::new(Method::POST, &format!("/rooms/{ALL_TALK}/messages")).header("accept", "text/vnd.turbo-stream.html, text/html, application/xhtml+xml").form(&[("message[body]", &body)])).await;
+        assert_eq!(reply.status, StatusCode::OK);
+        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+        assert_eq!(*hits.lock().unwrap(), 1, "webhook called");
+        let after = app.db().read(move |conn| Ok(campfire_db::Message::for_room(conn, ALL_TALK).unwrap())).await.unwrap();
+        // Only the mention itself was added; no bot reply.
