+/// Bots gained an optional `webhook_url` after the table was created: existing
+/// databases get the column on boot. Additive only, so Rails keeps working.
+fn ensure_bots_webhook_column(conn: &Connection) -> Result<()> {
+    let has_column: bool = conn
+        .prepare(r#"SELECT 1 FROM pragma_table_info('bots') WHERE name = 'webhook_url'"#)?
+        .exists([])?;
+    if !has_column {
+        conn.execute_batch(r#"ALTER TABLE "bots" ADD COLUMN "webhook_url" varchar"#)?;
+    }
+    Ok(())
+}
