+/// Enqueue a `joined` delivery for `bot` newly added to `room`. Returns
+/// immediately; the work runs on the job runner. Direct rooms never notify.
+pub fn notify_after_join(app: &App, room: &Room, bot: &Bot, base_url: &str) {
+    // Direct conversations never trigger `joined`.
+    if room.direct() {
+        return;
+    }
+    let job_app = app.clone();
+    let room_id = room.id;
+    let bot_id = bot.id;
+    let base_url = base_url.to_string();
+    app.jobs.perform_later("BotWebhook", async move {
+        if let Err(error) = deliver_join(&job_app, room_id, bot_id, &base_url).await {
+            tracing::warn!(%error, room_id, bot_id, "bot joined delivery failed");
+        }
+        Ok(())
+    });
+}
+
+/// Enqueue `joined` deliveries for several rooms the bot newly joined.
+pub fn notify_after_joins(app: &App, joins: &[(Room, Bot)], base_url: &str) {
+    for (room, bot) in joins {
+        notify_after_join(app, room, bot, base_url);
+    }
+}
+
+/// Read the room and bot, `POST` the `joined` event, and post any synchronous
+/// reply as the bot's message.
+async fn deliver_join(app: &App, room_id: i64, bot_id: i64, base_url: &str) -> anyhow::Result<()> {
+    let snapshot: Option<(Room, Bot, String)> = app
+        .db
+        .read(move |conn| {
+            let Some(room) = Room::find_by_id(conn, room_id)? else {
+                return Ok(None);
+            };
+            // Direct conversations never trigger `joined`.
+            if room.direct() {
+                return Ok(None);
+            }
+            let Some(bot) = Bot::find_by_id(conn, bot_id)? else {
+                return Ok(None);
+            };
+            let Some(url) = bot.webhook_url.clone().filter(|u| !u.trim().is_empty()) else {
+                return Ok(None);
+            };
+            Ok(Some((room, bot, url)))
+        })
+        .await
+        .map_err(|e| anyhow::anyhow!("{e:?}"))?;
+    let Some((room, bot, url)) = snapshot else { return Ok(()) };
+    let payload = joined_payload(&room, &bot);
+    match post_json(&url, &payload).await {
+        Ok(Some(reply)) => {
+            if let Err(error) = post_bot_reply(app, &room, &bot, reply, base_url).await {
+                tracing::warn!(%error, bot_id = bot.id, "bot joined reply failed");
+            }
+        }
+        Ok(None) => {}
+        Err(error) => {
+            tracing::warn!(%error, bot_id = bot.id, webhook = url.as_str(), "bot joined webhook failed");
+        }
+    }
+    Ok(())
+}
+
+/// The `joined` event payload for a bot newly added to a room. Paths are
+/// relative; the bot knows its Campfire origin.
+fn joined_payload(room: &Room, bot: &Bot) -> serde_json::Value {
+    let room_name = room.name.clone().unwrap_or_default();
+    serde_json::json!({
+        "event": "joined",
+        "room": {
+            "id": room.id,
+            "name": room_name,
+            "reply_to": campfire_routes::room_bot_messages(room.id, &bot.bot_code),
+        },
+    })
+}
