+    async fn start_recorder(reply: Option<(String, Vec<u8>)>) -> (String, std::sync::Arc<std::sync::Mutex<Vec<serde_json::Value>>>) {
+        use std::sync::{Arc, Mutex};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let seen: Arc<Mutex<Vec<serde_json::Value>>> = Arc::new(Mutex::new(Vec::new()));
+        let seen2 = seen.clone();
+        let reply = reply.clone();
+        tokio::spawn(async move {
+            loop {
+                let Ok((mut sock, _)) = listener.accept().await else { break };
+                let seen2 = seen2.clone();
+                let reply = reply.clone();
+                tokio::spawn(async move {
+                    let mut buf = Vec::new();
+                    loop {
+                        let mut chunk = [0u8; 4096];
+                        let Ok(n) = sock.read(&mut chunk).await else { break };
+                        if n == 0 { break; }
+                        buf.extend_from_slice(&chunk[..n]);
+                        if buf.windows(4).any(|w| w == b"\r\n\r\n") { break; }
+                    }
+                    let Some(pos) = buf.windows(4).position(|w| w == b"\r\n\r\n") else { return };
+                    let header_end = pos + 4;
+                    let header = String::from_utf8_lossy(&buf[..header_end]).to_string();
+                    let len: usize = header.lines().find_map(|l| { let (k, v) = l.split_once(':')?; if k.trim().eq_ignore_ascii_case("content-length") { v.trim().parse().ok() } else { None } }).unwrap_or(0);
+                    let mut body = buf[header_end..].to_vec();
+                    while body.len() < len {
+                        let mut c = [0u8; 4096];
+                        let Ok(n) = sock.read(&mut c).await else { break };
+                        if n == 0 { break; }
+                        body.extend_from_slice(&c[..n]);
+                    }
+                    if let Ok(v) = serde_json::from_slice::<serde_json::Value>(&body) {
+                        seen2.lock().unwrap().push(v);
+                    }
+                    match reply {
+                        Some((ct, bytes)) => {
+                            let resp = format!("HTTP/1.1 200 OK\r\nContent-Type: {ct}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", bytes.len());
+                            let _ = sock.write_all(resp.as_bytes()).await;
+                            let _ = sock.write_all(&bytes).await;
+                        }
+                        None => {
+                            let _ = sock.write_all(b"HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n").await;
+                        }
+                    }
+                });
+            }
+        });
+        (format!("http://{addr}/hook"), seen)
+    }
+
+    async fn wait_for(seen: &std::sync::Arc<std::sync::Mutex<Vec<serde_json::Value>>>, n: usize) -> Vec<serde_json::Value> {
+        for _ in 0..200 {
+            tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+            let v = seen.lock().unwrap().clone();
+            if v.len() >= n {
+                return v;
+            }
+        }
+        seen.lock().unwrap().clone()
+    }
