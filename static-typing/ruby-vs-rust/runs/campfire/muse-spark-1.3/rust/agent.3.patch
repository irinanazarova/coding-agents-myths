+fn ensure_bots_add_to_all_open_rooms_column(conn: &Connection) -> Result<()> {
+    let has_column: bool = conn
+        .prepare(r#"SELECT 1 FROM pragma_table_info('bots') WHERE name = 'add_to_all_open_rooms'"#)?
+        .exists([])?;
+    if !has_column {
+        conn.execute_batch(r#"ALTER TABLE "bots" ADD COLUMN "add_to_all_open_rooms" integer NOT NULL DEFAULT 0"#)?;
+    }
+    Ok(())
