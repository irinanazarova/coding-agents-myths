+import socket, base64, os, json, struct, subprocess, time, urllib.request
+
+class WS:
+    def __init__(self, url):
+        assert url.startswith("ws://")
+        hostport, path = url[5:].split("/", 1)
+        host, port = hostport.split(":")
+        self.s = socket.create_connection((host, int(port)))
+        key = base64.b64encode(os.urandom(16)).decode()
+        self.s.sendall((f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
+                        f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
+        buf = b""
+        while b"\r\n\r\n" not in buf: buf += self.s.recv(1)
+        assert b" 101 " in buf, buf
+    def send(self, text):
+        data = text.encode(); hdr = bytearray([0x81]); n = len(data)
+        if n < 126: hdr.append(0x80 | n)
+        elif n < 65536: hdr.append(0x80 | 126); hdr += struct.pack(">H", n)
+        else: hdr.append(0x80 | 127); hdr += struct.pack(">Q", n)
+        mask = os.urandom(4); hdr += mask
+        self.s.sendall(bytes(hdr) + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))
+    def _read(self, n):
+        b = b""
+        while len(b) < n:
+            c = self.s.recv(n - len(b))
+            if not c: raise EOFError
+            b += c
+        return b
+    def recv(self):
+        msg = b""
+        while True:
+            h = self._read(2); fin = h[0] & 0x80; n = h[1] & 0x7f
+            if n == 126: n = struct.unpack(">H", self._read(2))[0]
+            elif n == 127: n = struct.unpack(">Q", self._read(8))[0]
+            msg += self._read(n)
+            if fin: return msg.decode()
+
+class Browser:
+    def __init__(self, auth=None):
+        self.proc = subprocess.Popen(["chromium", "--headless=new", "--no-sandbox", "--disable-gpu",
+            "--remote-debugging-port=9333", "--user-data-dir=/tmp/e2e/profile", "about:blank"],
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        for _ in range(50):
+            try:
+                tabs = json.load(urllib.request.urlopen("http://127.0.0.1:9333/json")); break
+            except Exception: time.sleep(0.2)
+        page = [t for t in tabs if t["type"] == "page"][0]
+        self.ws = WS(page["webSocketDebuggerUrl"]); self.id = 0; self.events = []
+        self.dialog_accept = True; self.dialogs = []
+        self.call("Page.enable"); self.call("Runtime.enable"); self.call("Network.enable")
+        if auth:
+            self.call("Network.setExtraHTTPHeaders", headers={"Authorization": "Basic " + base64.b64encode(auth.encode()).decode()})
+    def call(self, method, **params):
+        self.id += 1; my = self.id
+        self.ws.send(json.dumps({"id": my, "method": method, "params": params}))
+        while True:
+            m = json.loads(self.ws.recv())
+            if m.get("method") == "Page.javascriptDialogOpening":
+                self.dialogs.append(m["params"]["message"])
+                self.id += 1
+                self.ws.send(json.dumps({"id": self.id, "method": "Page.handleJavaScriptDialog", "params": {"accept": self.dialog_accept}}))
+                continue
+            if m.get("id") == my:
+                if "error" in m: raise RuntimeError(m["error"])
+                return m["result"]
+            if "method" in m: self.events.append(m)
+    def js(self, expr):
+        r = self.call("Runtime.evaluate", expression=expr, returnByValue=True, awaitPromise=True)
+        if "exceptionDetails" in r: raise RuntimeError(r["exceptionDetails"])
+        return r["result"].get("value")
+    def wait_load(self, timeout=5):
+        time.sleep(0.15)
+        end = time.time() + timeout
+        while time.time() < end:
+            try:
+                if self.js("document.readyState") == "complete": return
+            except RuntimeError: pass
+            time.sleep(0.05)
+    def goto(self, url):
+        self.call("Page.navigate", url=url); self.wait_load()
+    def text(self): return self.js("document.body.innerText")
+    def url(self): return self.js("location.href")
+    def close(self): self.proc.kill()
