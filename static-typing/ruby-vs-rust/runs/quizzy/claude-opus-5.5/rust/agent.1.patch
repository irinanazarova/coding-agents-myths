+
+/// The question form, parsed from `body`, `active`, and `option_N_{text,correct,id}` fields.
+struct QuestionSubmission {
+    body: String,
+    active: bool,
+    rows: Vec<views::OptionRow>,
+    add_option: bool,
+}
+
+fn parse_question(fields: Vec<(String, String)>) -> QuestionSubmission {
+    let mut body = String::new();
+    let mut active = false;
+    let mut add_option = false;
+    let mut rows: BTreeMap<usize, views::OptionRow> = BTreeMap::new();
+    for (k, v) in fields {
+        match k.as_str() {
+            "body" => body = v,
+            "active" => active |= v == "1",
+            "add_option" => add_option = true,
+            _ => {
+                let Some(rest) = k.strip_prefix("option_") else { continue };
+                let Some((n, field)) = rest.split_once('_') else { continue };
+                let Ok(n) = n.parse::<usize>() else { continue };
+                let row = rows.entry(n).or_insert(views::OptionRow { id: None, text: String::new(), correct: false });
+                match field {
+                    "text" => row.text = v,
+                    "correct" => row.correct = v == "1",
+                    "id" => row.id = v.parse().ok(),
+                    _ => {}
+                }
+            }
+        }
+    }
+    QuestionSubmission { body, active, rows: rows.into_values().collect(), add_option }
+}
+
+fn validate_question(sub: &QuestionSubmission) -> (Vec<String>, Vec<db::OptionInput>) {
+    let mut errors = vec![];
+    if sub.body.trim().is_empty() {
+        errors.push("Question can't be blank".to_string());
+    }
+    let options: Vec<db::OptionInput> = sub
+        .rows
+        .iter()
+        .filter(|r| !r.text.trim().is_empty())
+        .map(|r| db::OptionInput { id: r.id, text: r.text.trim().to_string(), correct: r.correct })
+        .collect();
+    if options.len() < 2 {
+        errors.push("Add at least two options".to_string());
+    }
+    if !options.iter().any(|o| o.correct) {
+        errors.push("Mark at least one option as correct".to_string());
+    }
+    (errors, options)
+}
+
+async fn save_question(s: AppState, id: i64, qid: Option<i64>, fields: Vec<(String, String)>) -> AppResult {
+    let mut conn = s.conn();
+    let quiz = load_quiz(&conn, id)?;
+    if let Some(qid) = qid {
+        db::get_question(&conn, id, qid)?.ok_or(AppError::NotFound)?;
+    }
+    let mut sub = parse_question(fields);
+    if sub.add_option {
+        // No-JS fallback for the "Add option" button: re-render with one more row.
+        sub.rows.push(views::OptionRow { id: None, text: String::new(), correct: false });
+        return Ok(Html(views::question_form(&quiz, qid, &sub.body, &sub.rows, sub.active, &[])).into_response());
+    }
+    let (errors, options) = validate_question(&sub);
+    if !errors.is_empty() {
+        let rows = pad_rows(sub.rows);
+        return Ok(unprocessable(views::question_form(&quiz, qid, &sub.body, &rows, sub.active, &errors)));
+    }
+    let saved = db::save_question(&mut conn, id, qid, sub.body.trim(), sub.active, &options)?;
+    Ok(see_other(format!("/moderate/quizzes/{id}#question-{saved}")))
+}
+
+async fn question_create(
+    State(s): State<AppState>,
+    Path(id): Path<i64>,
+    Form(fields): Form<Vec<(String, String)>>,
+) -> AppResult {
+    save_question(s, id, None, fields).await
+}
+
+async fn question_update(
+    State(s): State<AppState>,
+    Path((id, qid)): Path<(i64, i64)>,
+    Form(fields): Form<Vec<(String, String)>>,
+) -> AppResult {
+    save_question(s, id, Some(qid), fields).await
+}
+
+#[derive(Deserialize)]
+struct MoveParams {
+    direction: String,
+}
+
+async fn question_move(
+    State(s): State<AppState>,
+    Path((id, qid)): Path<(i64, i64)>,
+    Form(p): Form<MoveParams>,
+) -> AppResult {
+    let mut conn = s.conn();
+    db::get_question(&conn, id, qid)?.ok_or(AppError::NotFound)?;
+    db::move_question(&mut conn, id, qid, p.direction == "up")?;
+    Ok(see_other(format!("/moderate/quizzes/{id}#question-{qid}")))
+}
+
+async fn question_active(
+    State(s): State<AppState>,
+    Path((id, qid)): Path<(i64, i64)>,
+    headers: HeaderMap,
+    Form(fields): Form<Vec<(String, String)>>,
+) -> AppResult {
+    let conn = s.conn();
+    db::get_question(&conn, id, qid)?.ok_or(AppError::NotFound)?;
+    let active = fields.iter().any(|(k, v)| k == "active" && v == "1");
+    db::set_active(&conn, id, qid, active)?;
+    if headers.contains_key("x-requested-with") {
+        return Ok(StatusCode::NO_CONTENT.into_response());
+    }
+    Ok(see_other(format!("/moderate/quizzes/{id}#question-{qid}")))
+}
+
+async fn question_delete(State(s): State<AppState>, Path((id, qid)): Path<(i64, i64)>) -> AppResult {
+    let conn = s.conn();
+    db::delete_question(&conn, id, qid)?;
+    Ok(see_other(format!("/moderate/quizzes/{id}")))
+}
+
+// ---------- Preview ----------
+
+/// Preview state lives in the URL only; nothing is stored.
+#[derive(Deserialize)]
+struct PreviewParams {
+    step: Option<usize>,
+    score: Option<usize>,
+    pick: Option<i64>,
+    done: Option<String>,
+}
+
+async fn preview(State(s): State<AppState>, Path(id): Path<i64>, Query(p): Query<PreviewParams>) -> AppResult {
+    let conn = s.conn();
+    let quiz = load_quiz(&conn, id)?;
+    let questions: Vec<db::Question> = db::questions_for(&conn, id)?.into_iter().filter(|q| q.active).collect();
+    let total = questions.len();
+    if total == 0 {
+        return Ok(Html(views::preview_empty(&quiz)).into_response());
+    }
+    let score = p.score.unwrap_or(0).min(total);
+    if p.done.is_some() {
+        return Ok(Html(views::preview_result(&quiz, score, total)).into_response());
+    }
+    let step = p.step.unwrap_or(0);
+    if step >= total {
+        return Ok(see_other(format!("/moderate/quizzes/{id}/preview?done=1&score={score}")));
+    }
+    let q = &questions[step];
+    let picked = p.pick.filter(|pk| q.options.iter().any(|o| o.id == *pk));
+    Ok(Html(views::preview_question(&quiz, q, step, total, score, picked)).into_response())
+}
