+//! HTTP Basic authentication for the moderator area.
+use axum::{
+    extract::{Request, State},
+    http::{HeaderValue, StatusCode, header},
+    middleware::Next,
+    response::{IntoResponse, Response},
+};
+use base64::Engine;
+
+use crate::AppState;
+
+fn constant_time_eq(a: &[u8], b: &[u8]) -> bool {
+    if a.len() != b.len() {
+        return false;
+    }
+    a.iter().zip(b).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+}
+
+pub fn check(header_value: Option<&HeaderValue>, user: &str, pass: &str) -> bool {
+    let Some(value) = header_value.and_then(|v| v.to_str().ok()) else { return false };
+    let Some((scheme, encoded)) = value.trim().split_once(' ') else { return false };
+    if !scheme.eq_ignore_ascii_case("basic") {
+        return false;
+    }
+    let Ok(decoded) = base64::engine::general_purpose::STANDARD.decode(encoded.trim()) else {
+        return false;
+    };
+    let Ok(decoded) = String::from_utf8(decoded) else { return false };
+    let Some((u, p)) = decoded.split_once(':') else { return false };
+    // Evaluate both comparisons to avoid leaking which one failed.
+    let ok_user = constant_time_eq(u.as_bytes(), user.as_bytes());
+    let ok_pass = constant_time_eq(p.as_bytes(), pass.as_bytes());
+    ok_user & ok_pass && !user.is_empty()
+}
+
+fn is_moderator_path(path: &str) -> bool {
+    let lower = path.to_ascii_lowercase();
+    lower == "/moderate" || lower.starts_with("/moderate/")
+}
+
+pub async fn require_moderator(State(state): State<AppState>, req: Request, next: Next) -> Response {
+    if !is_moderator_path(req.uri().path())
+        || check(
+        req.headers().get(header::AUTHORIZATION),
+        &state.moderator_username,
+        &state.moderator_password,
+    ) {
+        next.run(req).await
+    } else {
+        (
+            StatusCode::UNAUTHORIZED,
+            [
+                (header::WWW_AUTHENTICATE, "Basic realm=\"Quizzy moderator\", charset=\"UTF-8\""),
+                (header::CONTENT_TYPE, "text/plain; charset=utf-8"),
+            ],
+            "Authentication required\n",
+        )
+            .into_response()
+    }
+}
