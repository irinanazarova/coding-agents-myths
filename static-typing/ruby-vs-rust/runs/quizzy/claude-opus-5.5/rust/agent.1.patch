+js("byText('Delete', item('Third?')).click()"); b.wait_load()
+ok("Third?" not in b.text(), "deleted question")
+
+click("Settings")
+ok(js("byLabel('Title').value") == "Browser Quiz", "settings form")
+js("fill('Title','Renamed Quiz')"); click("Save quiz")
+ok("Renamed Quiz" in b.text(), "renamed")
+click("Settings"); click("Delete quiz")
+ok(b.url().endswith("/moderate") and "Renamed Quiz" not in b.text(), "quiz deleted")
