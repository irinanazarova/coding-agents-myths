@@ -0,0 +1,275 @@
+use rusqlite::{Connection, OptionalExtension, params};
+
+pub struct Quiz {
+    pub id: i64,
+    pub title: String,
+}
+
+#[allow(dead_code)]
+pub struct Question {
+    pub id: i64,
+    pub quiz_id: i64,
+    pub body: String,
+    pub active: bool,
+    pub options: Vec<AnswerOption>,
+}
+
+#[derive(Clone)]
+pub struct AnswerOption {
+    pub id: i64,
+    pub text: String,
+    pub correct: bool,
+}
+
+/// Option row as submitted by the question form (`id` is set for existing options).
+pub struct OptionInput {
+    pub id: Option<i64>,
+    pub text: String,
+    pub correct: bool,
+}
+
+pub fn open(path: &str) -> rusqlite::Result<Connection> {
+    let conn = Connection::open(path)?;
+    conn.execute_batch(
+        "PRAGMA journal_mode = WAL;
+         PRAGMA foreign_keys = ON;
+         PRAGMA busy_timeout = 5000;",
+    )?;
+    migrate(&conn)?;
+    Ok(conn)
+}
+
+/// Schema migrations, tracked with `PRAGMA user_version`. Append new steps; never edit old ones.
+fn migrate(conn: &Connection) -> rusqlite::Result<()> {
+    let migrations: &[&str] = &[
+        // 1: quizzes, questions, options
+        "CREATE TABLE quizzes (
+            id INTEGER PRIMARY KEY,
+            title TEXT NOT NULL,
+            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
+         );
+         CREATE TABLE questions (
+            id INTEGER PRIMARY KEY,
+            quiz_id INTEGER NOT NULL REFERENCES quizzes(id) ON DELETE CASCADE,
+            position INTEGER NOT NULL,
+            body TEXT NOT NULL,
+            active INTEGER NOT NULL DEFAULT 1
+         );
+         CREATE INDEX questions_quiz ON questions(quiz_id, position);
+         CREATE TABLE options (
+            id INTEGER PRIMARY KEY,
+            question_id INTEGER NOT NULL REFERENCES questions(id) ON DELETE CASCADE,
+            position INTEGER NOT NULL,
+            text TEXT NOT NULL,
+            correct INTEGER NOT NULL DEFAULT 0
+         );
+         CREATE INDEX options_question ON options(question_id, position);",
+    ];
+    let version: usize = conn.query_row("PRAGMA user_version", [], |r| r.get::<_, i64>(0))? as usize;
+    for (i, sql) in migrations.iter().enumerate().skip(version) {
+        conn.execute_batch(&format!(
+            "BEGIN; {sql}; PRAGMA user_version = {}; COMMIT;",
+            i + 1
+        ))?;
+    }
+    Ok(())
+}
+
+pub struct QuizSummary {
+    pub quiz: Quiz,
+    pub questions: i64,
+    pub active: i64,
+}
+
+pub fn list_quizzes(conn: &Connection) -> rusqlite::Result<Vec<QuizSummary>> {
+    let mut st = conn.prepare(
+        "SELECT q.id, q.title,
+                (SELECT COUNT(*) FROM questions WHERE quiz_id = q.id),
+                (SELECT COUNT(*) FROM questions WHERE quiz_id = q.id AND active = 1)
+         FROM quizzes q ORDER BY q.id DESC",
+    )?;
+    st.query_map([], |r| {
+        Ok(QuizSummary {
+            quiz: Quiz { id: r.get(0)?, title: r.get(1)? },
+            questions: r.get(2)?,
+            active: r.get(3)?,
+        })
+    })?
+    .collect()
+}
+
+pub fn get_quiz(conn: &Connection, id: i64) -> rusqlite::Result<Option<Quiz>> {
+    conn.query_row("SELECT id, title FROM quizzes WHERE id = ?", [id], |r| {
+        Ok(Quiz { id: r.get(0)?, title: r.get(1)? })
+    })
+    .optional()
+}
+
+pub fn create_quiz(conn: &Connection, title: &str) -> rusqlite::Result<i64> {
+    conn.execute("INSERT INTO quizzes (title) VALUES (?)", [title])?;
+    Ok(conn.last_insert_rowid())
+}
+
+pub fn update_quiz(conn: &Connection, id: i64, title: &str) -> rusqlite::Result<()> {
+    conn.execute("UPDATE quizzes SET title = ? WHERE id = ?", params![title, id])?;
+    Ok(())
+}
+
+pub fn delete_quiz(conn: &Connection, id: i64) -> rusqlite::Result<()> {
+    conn.execute("DELETE FROM quizzes WHERE id = ?", [id])?;
+    Ok(())
+}
+
+fn options_for(conn: &Connection, question_id: i64) -> rusqlite::Result<Vec<AnswerOption>> {
+    let mut st = conn.prepare(
+        "SELECT id, text, correct FROM options WHERE question_id = ? ORDER BY position, id",
+    )?;
+    st.query_map([question_id], |r| {
+        Ok(AnswerOption { id: r.get(0)?, text: r.get(1)?, correct: r.get(2)? })
+    })?
+    .collect()
+}
+
+pub fn questions_for(conn: &Connection, quiz_id: i64) -> rusqlite::Result<Vec<Question>> {
+    let mut st = conn.prepare(
+        "SELECT id, quiz_id, body, active FROM questions WHERE quiz_id = ? ORDER BY position, id",
+    )?;
+    let mut qs: Vec<Question> = st
+        .query_map([quiz_id], |r| {
+            Ok(Question {
+                id: r.get(0)?,
+                quiz_id: r.get(1)?,
+                body: r.get(2)?,
+                active: r.get(3)?,
+                options: vec![],
+            })
+        })?
+        .collect::<rusqlite::Result<_>>()?;
+    for q in &mut qs {
+        q.options = options_for(conn, q.id)?;
+    }
+    Ok(qs)
+}
+
+pub fn get_question(conn: &Connection, quiz_id: i64, id: i64) -> rusqlite::Result<Option<Question>> {
+    let q = conn
+        .query_row(
+            "SELECT id, quiz_id, body, active FROM questions WHERE id = ? AND quiz_id = ?",
+            [id, quiz_id],
+            |r| {
+                Ok(Question {
+                    id: r.get(0)?,
+                    quiz_id: r.get(1)?,
+                    body: r.get(2)?,
+                    active: r.get(3)?,
+                    options: vec![],
+                })
+            },
+        )
+        .optional()?;
+    match q {
+        Some(mut q) => {
+            q.options = options_for(conn, q.id)?;
+            Ok(Some(q))
+        }
+        None => Ok(None),
+    }
+}
+
+/// Creates (question_id = None) or updates a question with its options, in one transaction.
+/// Existing options keep their ids; options missing from `options` are deleted.
+pub fn save_question(
+    conn: &mut Connection,
+    quiz_id: i64,
+    question_id: Option<i64>,
+    body: &str,
+    active: bool,
+    options: &[OptionInput],
+) -> rusqlite::Result<i64> {
+    let tx = conn.transaction()?;
+    let qid = match question_id {
+        Some(id) => {
+            tx.execute(
+                "UPDATE questions SET body = ?, active = ? WHERE id = ? AND quiz_id = ?",
+                params![body, active, id, quiz_id],
+            )?;
+            id
+        }
+        None => {
+            let pos: i64 = tx.query_row(
+                "SELECT COALESCE(MAX(position), 0) + 1 FROM questions WHERE quiz_id = ?",
+                [quiz_id],
+                |r| r.get(0),
+            )?;
+            tx.execute(
+                "INSERT INTO questions (quiz_id, position, body, active) VALUES (?, ?, ?, ?)",
+                params![quiz_id, pos, body, active],
+            )?;
+            tx.last_insert_rowid()
+        }
+    };
+    let mut keep: Vec<i64> = vec![];
+    for (i, o) in options.iter().enumerate() {
+        let pos = i as i64 + 1;
+        let updated = match o.id {
+            Some(oid) => tx.execute(
+                "UPDATE options SET text = ?, correct = ?, position = ? WHERE id = ? AND question_id = ?",
+                params![o.text, o.correct, pos, oid, qid],
+            )? == 1,
+            None => false,
+        };
+        if updated {
+            keep.push(o.id.unwrap());
+        } else {
+            tx.execute(
+                "INSERT INTO options (question_id, position, text, correct) VALUES (?, ?, ?, ?)",
+                params![qid, pos, o.text, o.correct],
+            )?;
+            keep.push(tx.last_insert_rowid());
+        }
+    }
+    {
+        let existing: Vec<i64> = tx
+            .prepare("SELECT id FROM options WHERE question_id = ?")?
+            .query_map([qid], |r| r.get(0))?
+            .collect::<rusqlite::Result<_>>()?;
+        for id in existing.into_iter().filter(|id| !keep.contains(id)) {
+            tx.execute("DELETE FROM options WHERE id = ?", [id])?;
+        }
+    }
+    tx.commit()?;
+    Ok(qid)
+}
+
+pub fn set_active(conn: &Connection, quiz_id: i64, id: i64, active: bool) -> rusqlite::Result<()> {
+    conn.execute(
+        "UPDATE questions SET active = ? WHERE id = ? AND quiz_id = ?",
+        params![active, id, quiz_id],
+    )?;
+    Ok(())
+}
+
+pub fn delete_question(conn: &Connection, quiz_id: i64, id: i64) -> rusqlite::Result<()> {
+    conn.execute("DELETE FROM questions WHERE id = ? AND quiz_id = ?", [id, quiz_id])?;
+    Ok(())
+}
+
+/// Moves a question one step up (`up = true`) or down within its quiz.
+pub fn move_question(conn: &mut Connection, quiz_id: i64, id: i64, up: bool) -> rusqlite::Result<()> {
+    let tx = conn.transaction()?;
+    let ids: Vec<i64> = tx
+        .prepare("SELECT id FROM questions WHERE quiz_id = ? ORDER BY position, id")?
+        .query_map([quiz_id], |r| r.get(0))?
+        .collect::<rusqlite::Result<_>>()?;
+    let mut ids = ids;
+    if let Some(i) = ids.iter().position(|&x| x == id) {
+        let j = if up { i.checked_sub(1) } else { Some(i + 1).filter(|&j| j < ids.len()) };
+        if let Some(j) = j {
+            ids.swap(i, j);
+            for (p, qid) in ids.iter().enumerate() {
+                tx.execute("UPDATE questions SET position = ? WHERE id = ?", params![p as i64 + 1, qid])?;
+            }
+        }
+    }
+    tx.commit()
+}
