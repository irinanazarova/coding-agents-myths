+        if i in correct: js(f"check('Option {i} is correct', true)")
+    if not active: js("check('Active', false)")
+    click("Save question")
+
+click("Add question")
+ok(js("[1,2,3,4].every(i=>byLabel('Option '+i)) && !byLabel('Option 5')"), "four empty rows")
+ok(js("byLabel('Active').checked"), "active on by default")
+click("+ Add option")
+ok(js("!!byLabel('Option 5') && !!byLabel('Option 5 is correct')"), "add option adds Option 5")
+js("fill('Question','Bad one'); fill('Option 1','Only')"); js("check('Option 1 is correct', true)")
+click("Save question")
+ok("Add at least two options" in b.text() and js("byLabel('Option 1').value") == "Only" and js("byLabel('Option 1 is correct').checked"), "two-options rule keeps input")
+js("fill('Option 2','Second'); check('Option 1 is correct', false)"); click("Save question")
+ok("Mark at least one option as correct" in b.text() and js("byLabel('Option 2').value")=="Second", "correct rule")
+b.goto(quiz_url)
+ok("Bad one" not in b.text(), "nothing saved")
+
+add_q("First?", ["a1", "a2", "", "a4"], [2])
+add_q("Second?", ["b1", "b2", "b3", "b4", "b5"], [1, 5])
+add_q("Third?", ["c1", "c2"], [1])
+t = b.text()
+ok(t.index("First?") < t.index("Second?") < t.index("Third?"), "order")
+ok(js("item('Second?').querySelectorAll('.question-item__options li').length") == 5, "5 options incl added row")
+ok(js("item('First?').querySelectorAll('.question-item__options li').length") == 3, "empty row skipped")
+
+js("byText('Move up', item('Third?')).click()"); b.wait_load()
+t = b.text(); ok(t.index("Third?") < t.index("Second?"), "move up")
+js("byText('Move down', item('Third?')).click()"); b.wait_load()
+t = b.text(); ok(t.index("Second?") < t.index("Third?"), "move down")
+
+js("item('Second?').querySelector('input[type=checkbox]').click()"); time.sleep(0.5)
+b.goto(quiz_url)
+ok(not js("item('Second?').querySelector('input[type=checkbox]').checked"), "active toggle persisted")
+ok("1 of 3" in b.text() or "2 of 3" in b.text(), "count text: " + b.text().split("\n")[3])
+
+js("byText('Edit', item('First?')).click()"); b.wait_load()
+ok(js("byLabel('Option 2 is correct').checked") and js("byLabel('Option 3').value")=="a4", "edit loads values")
+js("fill('Question','First edited?')"); click("Save question")
+ok("First edited?" in b.text(), "edit saved")
+
+click("Preview")
+t = b.text(); ok("Question 1 of 2" in t and "First edited?" in t, "preview q1")
+js("Array.from(document.querySelectorAll('button.play-option')).find(e=>e.textContent.includes('a1')).click()"); b.wait_load()
+ok("Wrong!" in b.text(), "wrong")
+click("Next question")
+t = b.text(); ok("Question 2 of 2" in t and "Third?" in t and "Second?" not in t, "inactive skipped")
+js("Array.from(document.querySelectorAll('button.play-option')).find(e=>e.textContent.includes('c1')).click()"); b.wait_load()
+ok("Correct!" in b.text(), "correct")
+click("See score"); ok("Score: 1/2" in b.text(), "score " )
+click("Start over"); ok("Question 1 of 2" in b.text(), "start over")
+
+b.goto(quiz_url)
+b.dialog_accept = False
+js("byText('Delete', item('Third?')).click()"); b.wait_load()
+ok("Third?" in b.text() and len(b.dialogs) == 1, "delete cancelled")
