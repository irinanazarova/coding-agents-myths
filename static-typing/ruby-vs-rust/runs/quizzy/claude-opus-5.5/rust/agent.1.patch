+/// One preview question. `picked` is the option the moderator picked, if any.
+/// `score` is the score before this question.
+pub fn preview_question(
+    quiz: &Quiz,
+    question: &Question,
+    step: usize,
+    total: usize,
+    score: usize,
+    picked: Option<i64>,
+) -> String {
+    let base = format!("/moderate/quizzes/{}/preview", quiz.id);
+    let mut options = String::new();
+    for (i, o) in question.options.iter().enumerate() {
+        let mut classes = vec!["play-option"];
+        let mut mark = String::new();
+        if picked.is_some() {
+            if o.correct {
+                classes.push("is-correct");
+                mark = r#"<span class="play-option__mark">✓ Correct</span>"#.to_string();
+            }
+            if picked == Some(o.id) {
+                classes.push("is-picked");
+                if !o.correct {
+                    mark = r#"<span class="play-option__mark">Your answer</span>"#.to_string();
+                }
+            }
+        }
+        options.push_str(&format!(
+            r#"<button class="{cls}" type="submit" name="pick" value="{id}"{disabled}><span class="play-option__letter">{letter}</span><span class="play-option__title">{text}</span>{mark}</button>"#,
+            cls = classes.join(" "),
+            id = o.id,
+            disabled = if picked.is_some() { " disabled" } else { "" },
+            letter = letter(i),
+            text = esc(&o.text),
+        ));
+    }
+    let (status, actions) = match picked {
+        None => (
+            r#"<div class="play-status play-status--neutral">Pick an answer</div>"#.to_string(),
+            start_over(quiz, false),
+        ),
+        Some(p) => {
+            let right = question.options.iter().any(|o| o.id == p && o.correct);
+            let new_score = score + right as usize;
+            let status = if right {
+                r#"<div class="play-status play-status--right" role="status">Correct!</div>"#
+            } else {
+                r#"<div class="play-status play-status--wrong" role="status">Wrong!</div>"#
+            };
+            let next = if step + 1 < total {
+                format!(r#"<a class="btn btn--pink" href="{base}?step={}&amp;score={new_score}">Next question</a>"#, step + 1)
+            } else {
+                format!(r#"<a class="btn btn--pink" href="{base}?done=1&amp;score={new_score}">See score</a>"#)
+            };
+            (status.to_string(), format!("{next}{}", start_over(quiz, false)))
+        }
+    };
+    let locked = if picked.is_some() { " is-locked is-revealed" } else { "" };
+    play_layout(
+        quiz,
+        &format!(
+            r#"<div class="play-question__num">Question {n} of {total}</div>
+<div class="play-question__body">{body}</div>
+<form method="get" action="{base}" class="play-options{locked}">
+  <input type="hidden" name="step" value="{step}">
+  <input type="hidden" name="score" value="{score}">
+  {options}
+</form>
+{status}
+<div class="buttons preview-actions">{actions}</div>"#,
+            n = step + 1,
+            body = esc(&question.body),
+        ),
+    )
+}
+
+pub fn preview_result(quiz: &Quiz, score: usize, total: usize) -> String {
+    play_layout(
+        quiz,
+        &format!(
+            r#"<div class="result-card">
+  <div class="result-card__label">You finished the preview</div>
+  <div class="result-card__place">{pct}%</div>
+  <div class="result-card__score">Score: {score}/{total}</div>
+  <div class="buttons" style="justify-content:center">{again}<a class="btn btn--ghost" href="/moderate/quizzes/{id}">Back to quiz</a></div>
+</div>"#,
+            pct = if total == 0 { 0 } else { score * 100 / total },
+            again = start_over(quiz, true),
+            id = quiz.id,
+        ),
+    )
+}
