+#!/usr/bin/env bash
+# Builds Quizzy (offline, release mode), prepares storage/, and runs the app in the foreground.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+export PORT="${PORT:-3000}"
+mkdir -p storage
+
+if ! cargo build --release --offline --locked; then
+  echo "Offline build failed; retrying without --locked" >&2
+  cargo build --release --offline
+fi
+
+# The database schema is created/migrated by the app on boot (storage/quizzy.sqlite3).
+exec ./target/release/quizzy
