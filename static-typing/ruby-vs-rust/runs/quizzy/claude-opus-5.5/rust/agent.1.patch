+pub fn esc(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for c in s.chars() {
+        match c {
+            '&' => out.push_str("&amp;"),
+            '<' => out.push_str("&lt;"),
+            '>' => out.push_str("&gt;"),
+            '"' => out.push_str("&quot;"),
+            '\'' => out.push_str("&#39;"),
+            _ => out.push(c),
+        }
+    }
+    out
+}
+
+/// Escapes a string for use inside a single-quoted JS string in an HTML attribute.
+fn js_attr(s: &str) -> String {
+    let js: String = s
+        .chars()
+        .flat_map(|c| match c {
+            '\\' => "\\\\".chars().collect::<Vec<_>>(),
+            '\'' => "\\'".chars().collect(),
+            '\n' => "\\n".chars().collect(),
+            '\r' => vec![],
+            c => vec![c],
+        })
+        .collect();
+    esc(&js)
+}
