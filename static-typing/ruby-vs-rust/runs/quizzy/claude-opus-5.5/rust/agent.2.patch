@@ -0,0 +1,227 @@
+//! Quiz export/import (JSON). The format holds only the quiz contents:
+//! `{"title", "questions": [{"text", "active", "options": [{"text", "correct"}]}]}`.
+use serde::Serialize;
+use serde_json::{Map, Value};
+
+use crate::db::{Question, Quiz};
+
+pub const MAX_TITLE: usize = 200;
+pub const MAX_QUESTION: usize = 1000;
+pub const MAX_OPTION: usize = 500;
+
+#[derive(Serialize)]
+struct ExportQuiz<'a> {
+    title: &'a str,
+    questions: Vec<ExportQuestion<'a>>,
+}
+
+#[derive(Serialize)]
+struct ExportQuestion<'a> {
+    text: &'a str,
+    active: bool,
+    options: Vec<ExportOption<'a>>,
+}
+
+#[derive(Serialize)]
+struct ExportOption<'a> {
+    text: &'a str,
+    correct: bool,
+}
+
+/// Pretty-printed JSON with exactly the documented keys, in order.
+pub fn export_json(quiz: &Quiz, questions: &[Question]) -> String {
+    let doc = ExportQuiz {
+        title: &quiz.title,
+        questions: questions
+            .iter()
+            .map(|q| ExportQuestion {
+                text: &q.body,
+                active: q.active,
+                options: q.options.iter().map(|o| ExportOption { text: &o.text, correct: o.correct }).collect(),
+            })
+            .collect(),
+    };
+    serde_json::to_string_pretty(&doc).expect("serialize quiz")
+}
+
+pub struct ImportedOption {
+    pub text: String,
+    pub correct: bool,
+}
+
+pub struct ImportedQuestion {
+    pub text: String,
+    pub active: bool,
+    pub options: Vec<ImportedOption>,
+}
+
+pub struct ImportedQuiz {
+    pub title: String,
+    pub questions: Vec<ImportedQuestion>,
+}
+
+fn type_name(v: &Value) -> &'static str {
+    match v {
+        Value::Null => "null",
+        Value::Bool(_) => "a boolean",
+        Value::Number(_) => "a number",
+        Value::String(_) => "a string",
+        Value::Array(_) => "an array",
+        Value::Object(_) => "an object",
+    }
+}
+
+/// Optional boolean: missing or null gives `default`.
+fn opt_bool(obj: &Map<String, Value>, key: &str, default: bool, ctx: &str, errors: &mut Vec<String>) -> bool {
+    match obj.get(key) {
+        None | Some(Value::Null) => default,
+        Some(Value::Bool(b)) => *b,
+        Some(v) => {
+            errors.push(format!("{ctx}: \"{key}\" must be true or false, not {}", type_name(v)));
+            default
+        }
+    }
+}
+
+/// Required string (may be blank; blankness is checked by the caller).
+fn req_string(obj: &Map<String, Value>, key: &str, ctx: &str, errors: &mut Vec<String>) -> Option<String> {
+    match obj.get(key) {
+        Some(Value::String(s)) => Some(s.trim().to_string()),
+        None | Some(Value::Null) => {
+            errors.push(format!("{ctx}: \"{key}\" is missing"));
+            None
+        }
+        Some(v) => {
+            errors.push(format!("{ctx}: \"{key}\" must be a string, not {}", type_name(v)));
+            None
+        }
+    }
+}
+
+/// Parses and validates an import. Returns all errors found; nothing is stored here.
+pub fn parse_import(input: &str) -> Result<ImportedQuiz, Vec<String>> {
+    let input = input.trim_start_matches('\u{feff}').trim();
+    if input.is_empty() {
+        return Err(vec!["Paste the quiz JSON".into()]);
+    }
+    let value: Value = serde_json::from_str(input).map_err(|e| vec![format!("Invalid JSON: {e}")])?;
+    let Value::Object(root) = value else {
+        return Err(vec![format!("The quiz must be a JSON object, not {}", type_name(&value))]);
+    };
+    let mut errors = vec![];
+
+    let title = match root.get("title") {
+        Some(Value::String(s)) if !s.trim().is_empty() => {
+            let t = s.trim().to_string();
+            if t.chars().count() > MAX_TITLE {
+                errors.push(format!("Title is too long (maximum is {MAX_TITLE} characters)"));
+            }
+            t
+        }
+        Some(Value::String(_)) | None | Some(Value::Null) => {
+            errors.push("Title can't be blank".into());
+            String::new()
+        }
+        Some(v) => {
+            errors.push(format!("\"title\" must be a string, not {}", type_name(v)));
+            String::new()
+        }
+    };
+
+    let raw_questions: &[Value] = match root.get("questions") {
+        None | Some(Value::Null) => &[],
+        Some(Value::Array(a)) => a,
+        Some(v) => {
+            errors.push(format!("\"questions\" must be an array, not {}", type_name(v)));
+            &[]
+        }
+    };
+
+    let mut questions = vec![];
+    for (i, qv) in raw_questions.iter().enumerate() {
+        let ctx = format!("Question {}", i + 1);
+        let Value::Object(q) = qv else {
+            errors.push(format!("{ctx}: must be an object, not {}", type_name(qv)));
+            continue;
+        };
+        let text = req_string(q, "text", &ctx, &mut errors);
+        if let Some(t) = &text {
+            if t.is_empty() {
+                errors.push(format!("{ctx}: Question can't be blank"));
+            } else if t.chars().count() > MAX_QUESTION {
+                errors.push(format!("{ctx}: Question is too long (maximum is {MAX_QUESTION} characters)"));
+            }
+        }
+        let active = opt_bool(q, "active", true, &ctx, &mut errors);
+        let raw_options: &[Value] = match q.get("options") {
+            None | Some(Value::Null) => &[],
+            Some(Value::Array(a)) => a,
+            Some(v) => {
+                errors.push(format!("{ctx}: \"options\" must be an array, not {}", type_name(v)));
+                &[]
+            }
+        };
+        let mut options = vec![];
+        let mut options_ok = matches!(q.get("options"), None | Some(Value::Null) | Some(Value::Array(_)));
+        for (j, ov) in raw_options.iter().enumerate() {
+            let octx = format!("{ctx}, option {}", j + 1);
+            let Value::Object(o) = ov else {
+                errors.push(format!("{octx}: must be an object, not {}", type_name(ov)));
+                options_ok = false;
+                continue;
+            };
+            let correct = opt_bool(o, "correct", false, &octx, &mut errors);
+            match req_string(o, "text", &octx, &mut errors) {
+                Some(t) if t.is_empty() => {
+                    errors.push(format!("{octx}: Option can't be blank"));
+                    options_ok = false;
+                }
+                Some(t) => {
+                    if t.chars().count() > MAX_OPTION {
+                        errors.push(format!("{octx}: Option is too long (maximum is {MAX_OPTION} characters)"));
+                    }
+                    options.push(ImportedOption { text: t, correct });
+                }
+                None => options_ok = false,
+            }
+        }
+        if options_ok {
+            if options.len() < 2 {
+                errors.push(format!("{ctx}: Add at least two options"));
+            }
+            if !options.iter().any(|o| o.correct) {
+                errors.push(format!("{ctx}: Mark at least one option as correct"));
+            }
+        }
+        questions.push(ImportedQuestion { text: text.unwrap_or_default(), active, options });
+    }
+
+    if errors.is_empty() { Ok(ImportedQuiz { title, questions }) } else { Err(errors) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_defaults() {
+        let q = parse_import(r#"{"title":" T ","questions":[{"text":"Q","options":[{"text":"a"},{"text":"b","correct":true}]}]}"#).unwrap();
+        assert_eq!(q.title, "T");
+        assert!(q.questions[0].active);
+        assert!(!q.questions[0].options[0].correct);
+        assert!(q.questions[0].options[1].correct);
+    }
+
+    #[test]
+    fn rejects_bad() {
+        assert!(parse_import("{").is_err());
+        assert!(parse_import("[]").is_err());
+        assert!(parse_import(r#"{"title":""}"#).is_err());
+        assert!(parse_import(r#"{"title":"T","questions":[{"text":"Q","options":[{"text":"a","correct":true}]}]}"#).is_err());
+        assert!(parse_import(r#"{"title":"T","questions":[{"text":"Q","options":[{"text":"a"},{"text":"b"}]}]}"#).is_err());
+        assert!(parse_import(r#"{"title":"T","questions":[{"text":" ","options":[{"text":"a","correct":true},{"text":"b"}]}]}"#).is_err());
+        assert!(parse_import(r#"{"title":"T","questions":[{"text":"Q","active":"yes","options":[{"text":"a","correct":true},{"text":"b"}]}]}"#).is_err());
+        assert!(parse_import(r#"{"title":"T","questions":{}}"#).is_err());
+        assert!(parse_import(r#"{"title":"T"}"#).is_ok());
+    }
+}
