+/// Creates a new quiz with all its questions and options in one transaction (all or nothing).
+pub fn import_quiz(conn: &mut Connection, quiz: &crate::transfer::ImportedQuiz) -> rusqlite::Result<i64> {
+    let tx = conn.transaction()?;
+    tx.execute("INSERT INTO quizzes (title) VALUES (?)", [&quiz.title])?;
+    let quiz_id = tx.last_insert_rowid();
+    for (i, q) in quiz.questions.iter().enumerate() {
+        tx.execute(
+            "INSERT INTO questions (quiz_id, position, body, active) VALUES (?, ?, ?, ?)",
+            params![quiz_id, i as i64 + 1, q.text, q.active],
+        )?;
+        let qid = tx.last_insert_rowid();
+        for (j, o) in q.options.iter().enumerate() {
+            tx.execute(
+                "INSERT INTO options (question_id, position, text, correct) VALUES (?, ?, ?, ?)",
+                params![qid, j as i64 + 1, o.text, o.correct],
+            )?;
+        }
+    }
+    tx.commit()?;
+    Ok(quiz_id)
+}
