diff --git a/src/live.rs b/src/live.rs
new file mode 100644
index 0000000..e803c51
--- /dev/null
+++ b/src/live.rs
@@ -0,0 +1,167 @@
+//! In-memory live state: change notifications per game and player presence.
+//!
+//! Nothing here is persistent; the database is the source of truth. Every live view is re-rendered
+//! from the database when it's notified, so a missed notification or a reconnect never leaves a
+//! client in a wrong state.
+use std::{
+    collections::{HashMap, HashSet},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicU64, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use tokio::sync::watch;
+
+/// How long a player still counts as "in the game" after their live connection dropped without
+/// saying goodbye (flaky Wi-Fi, a phone switching networks). An explicit leave (page closed) counts at once.
+pub const GRACE: Duration = Duration::from_millis(2500);
+
+pub struct Hub {
+    games: Mutex<HashMap<i64, Arc<GameHub>>>,
+    next_conn: AtomicU64,
+    pub shutdown: watch::Sender<bool>,
+}
+
+pub struct GameHub {
+    pub game_id: i64,
+    /// Bumped when the game moves on (start, finish, next, end): every view re-renders.
+    pub phase: watch::Sender<u64>,
+    /// Bumped when counters change (joins, leaves, answers): only the big screen cares.
+    pub stats: watch::Sender<u64>,
+    presence: Mutex<HashMap<i64, Presence>>,
+}
+
+#[derive(Default)]
+struct Presence {
+    /// Open live connections by connection id (a reconnect may briefly overlap the old one).
+    conns: HashMap<u64, usize>,
+    /// Last moment we know the player was around without an open connection.
+    seen: Option<Instant>,
+}
+
+impl Presence {
+    fn present(&self, now: Instant) -> bool {
+        !self.conns.is_empty() || self.seen.is_some_and(|t| now.duration_since(t) < GRACE)
+    }
+}
+
+impl Hub {
+    pub fn new() -> Self {
+        Hub { games: Mutex::new(HashMap::new()), next_conn: AtomicU64::new(1), shutdown: watch::channel(false).0 }
+    }
+
+    pub fn game(&self, game_id: i64) -> Arc<GameHub> {
+        let mut games = self.games.lock().unwrap_or_else(|e| e.into_inner());
+        games
+            .entry(game_id)
+            .or_insert_with(|| {
+                Arc::new(GameHub {
+                    game_id,
+                    phase: watch::channel(0).0,
+                    stats: watch::channel(0).0,
+                    presence: Mutex::new(HashMap::new()),
+                })
+            })
+            .clone()
+    }
+
+    pub fn conn_id(&self) -> u64 {
+        self.next_conn.fetch_add(1, Ordering::Relaxed)
+    }
+}
+
+impl GameHub {
+    pub fn bump_phase(&self) {
+        self.phase.send_modify(|v| *v += 1);
+        self.stats.send_modify(|v| *v += 1);
+    }
+
+    pub fn bump_stats(&self) {
+        self.stats.send_modify(|v| *v += 1);
+    }
+
+    fn presence(&self) -> std::sync::MutexGuard<'_, HashMap<i64, Presence>> {
+        self.presence.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    /// Re-counts once the grace period of a dropped player is over.
+    fn recount_after_grace(self: &Arc<Self>) {
+        if let Ok(rt) = tokio::runtime::Handle::try_current() {
+            let me = self.clone();
+            rt.spawn(async move {
+                tokio::time::sleep(GRACE + Duration::from_millis(100)).await;
+                me.bump_stats();
+            });
+        }
+    }
+
+    /// The player loaded a page (they're around even before their live connection opens).
+    pub fn seen(self: &Arc<Self>, player_id: i64) {
+        let was = {
+            let mut p = self.presence();
+            let e = p.entry(player_id).or_default();
+            let was = e.present(Instant::now());
+            e.seen = Some(Instant::now());
+            was
+        };
+        if !was {
+            self.bump_stats();
+        }
+        self.recount_after_grace();
+    }
+
+    /// Registers a live connection; it's unregistered when the guard is dropped.
+    pub fn connect(self: &Arc<Self>, player_id: i64, conn_id: u64) -> PresenceGuard {
+        *self.presence().entry(player_id).or_default().conns.entry(conn_id).or_default() += 1;
+        self.bump_stats();
+        PresenceGuard { hub: self.clone(), player_id, conn_id }
+    }
+
+    /// The page told us it's going away (closed tab, navigation): no grace period.
+    pub fn leave(self: &Arc<Self>, player_id: i64, conn_id: u64) {
+        {
+            let mut p = self.presence();
+            if let Some(e) = p.get_mut(&player_id) {
+                e.conns.remove(&conn_id);
+                e.seen = None;
+            }
+        }
+        self.bump_stats();
+    }
+
+    pub fn present_players(&self) -> HashSet<i64> {
+        let now = Instant::now();
+        self.presence().iter().filter(|(_, p)| p.present(now)).map(|(id, _)| *id).collect()
+    }
+}
+
+pub struct PresenceGuard {
+    hub: Arc<GameHub>,
+    player_id: i64,
+    conn_id: u64,
+}
+
+impl Drop for PresenceGuard {
+    fn drop(&mut self) {
+        let dropped = {
+            let mut p = self.hub.presence();
+            match p.get_mut(&self.player_id) {
+                Some(e) if e.conns.contains_key(&self.conn_id) => {
+                    let n = e.conns.get_mut(&self.conn_id).unwrap();
+                    *n -= 1;
+                    if *n == 0 {
+                        e.conns.remove(&self.conn_id);
+                    }
+                    e.seen = Some(Instant::now());
+                    true
+                }
+                _ => false,
+            }
+        };
+        if dropped {
+            self.hub.recount_after_grace();
+        }
+    }
+}
