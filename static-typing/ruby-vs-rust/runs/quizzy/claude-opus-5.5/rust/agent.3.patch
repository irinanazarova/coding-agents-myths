+//! Live game pages: the moderator's big screen and the player's phone.
+//! Both pages are a shell plus fragments; the fragments are re-sent over SSE when the game moves on.
+use crate::db::{Game, GameSummary, Phase, Question, Quiz};
+use crate::views::{esc, letter};
+
+#[derive(Clone, Copy, PartialEq, Eq, Default, serde::Serialize)]
+pub struct Stats {
+    /// Players currently connected (lobby counter).
+    pub players: usize,
+    /// Players who answered the current question.
+    pub answered: usize,
+    /// Players currently in the game (connected, or answered the current question).
+    pub in_game: usize,
+}
+
+pub struct Screen<'a> {
+    pub quiz: &'a Quiz,
+    pub game: &'a Game,
+    pub question: Option<&'a Question>,
+    pub total: i64,
+    pub is_last: bool,
+    pub join_url: &'a str,
+    pub qr_svg: &'a str,
+    pub stats: Stats,
+    /// Answers per option id (closed questions only).
+    pub counts: &'a [(i64, i64)],
+}
+
+pub fn players_text(s: &Stats) -> String {
+    format!("Players: {}", s.players)
+}
+
+pub fn answers_text(s: &Stats) -> String {
+    format!("Answers: {} / {}", s.answered, s.in_game)
+}
+
+fn question_head(num: i64, total: i64, q: Option<&Question>, kind: &str) -> String {
+    format!(
+        r#"<div class="{kind}-question__num">Question {num} of {total}</div>
+<div class="{kind}-question__body">{body}</div>"#,
+        body = q.map(|q| esc(&q.body)).unwrap_or_else(|| "This question was removed.".into()),
+    )
+}
+
+pub fn screen_body(s: &Screen) -> String {
+    match s.game.phase {
+        Phase::Lobby => format!(
+            r#"<div class="lobby">
+  <div>
+    <h1 class="lobby__title">{title}</h1>
+    <div class="lobby__join">Join on your phone:</div>
+    <div class="lobby__url" data-join-url>{url}</div>
+    <div class="counter-pill" data-players aria-live="polite">{players}</div>
+  </div>
+  <div class="qr" role="img" aria-label="QR code with the join link">{qr}</div>
+</div>"#,
+            title = esc(&s.quiz.title),
+            url = esc(s.join_url),
+            players = players_text(&s.stats),
+            qr = s.qr_svg,
+        ),
+        Phase::Open => {
+            let options: String = s
+                .question
+                .map(|q| {
+                    q.options
+                        .iter()
+                        .enumerate()
+                        .map(|(i, o)| {
+                            format!(
+                                r#"<li class="stage-option"><span class="stage-option__letter">{l}</span><span class="stage-option__title">{t}</span></li>"#,
+                                l = letter(i),
+                                t = esc(&o.text)
+                            )
+                        })
+                        .collect()
+                })
+                .unwrap_or_default();
+            format!(
+                r#"{head}
+<ol class="stage-options">{options}</ol>
+<div class="answers-counter mt-2" data-answers aria-live="polite">{answers}</div>"#,
+                head = question_head(s.game.num, s.total, s.question, "stage"),
+                answers = answers_text(&s.stats),
+            )
+        }
+        Phase::Closed => {
+            let total_answers: i64 = s.counts.iter().map(|(_, n)| n).sum();
+            let options: String = s
+                .question
+                .map(|q| {
+                    q.options
+                        .iter()
+                        .enumerate()
+                        .map(|(i, o)| {
+                            let n = s.counts.iter().find(|(id, _)| *id == o.id).map(|(_, n)| *n).unwrap_or(0);
+                            let share = if total_answers > 0 { n * 100 / total_answers } else { 0 };
+                            let (cls, mark) = if o.correct {
+                                (" is-correct", r#"<span class="stage-option__mark">Correct</span>"#)
+                            } else {
+                                ("", "")
+                            };
+                            format!(
+                                r#"<li class="stage-option{cls}" style="--share:{share}%"><span class="stage-option__bar"></span><span class="stage-option__letter">{l}</span><span class="stage-option__title">{t}</span>{mark}<span class="stage-option__count" aria-label="{n} answers">{n}</span></li>"#,
+                                l = letter(i),
+                                t = esc(&o.text)
+                            )
+                        })
+                        .collect()
+                })
+                .unwrap_or_default();
+            format!(
+                r#"{head}
+<ol class="stage-options stage-options--results">{options}</ol>"#,
+                head = question_head(s.game.num, s.total, s.question, "stage"),
+            )
+        }
+        Phase::Over => format!(
+            r#"<div class="screen__kicker">{title}</div>
+<h1 class="lobby__title">The quiz is over</h1>
+<div class="lobby__join">Thanks for playing!</div>"#,
+            title = esc(&s.quiz.title),
+        ),
+    }
+}
+
+pub fn screen_controls(s: &Screen) -> String {
+    let base = format!("/moderate/games/{}", s.game.id);
+    let button = |action: &str, label: &str, extra: &str| {
+        format!(
+            r#"<form method="post" action="{base}/{action}" data-action{extra}><input type="hidden" name="seq" value="{seq}"><button class="btn btn--pink" type="submit">{label}</button></form>"#,
+            seq = s.game.seq
+        )
+    };
+    let actions = match s.game.phase {
+        Phase::Lobby => button("start", "Start", ""),
+        Phase::Open => button("finish", "Finish", ""),
+        Phase::Closed if s.is_last => button("end", "End quiz", ""),
+        Phase::Closed => button("next", "Next", ""),
+        Phase::Over => format!(r#"<a class="btn btn--light" href="/moderate/quizzes/{}">Back to quiz</a>"#, s.quiz.id),
+    };
+    let info = match s.game.phase {
+        Phase::Lobby => format!(r#"<a href="/moderate/quizzes/{}">← Quiz page</a>"#, s.quiz.id),
+        Phase::Over => String::new(),
+        _ => format!(r#"<span>Join: <strong>{}</strong></span>"#, esc(s.join_url)),
+    };
+    format!(
+        r#"<div class="screen-controls__info">{info}<span class="badge badge--{state}">Game {code}</span></div><div class="buttons">{actions}</div>"#,
+        state = if s.game.phase == Phase::Over { "finished" } else { "running" },
+        code = esc(&s.game.code),
+    )
+}
+
+pub fn screen_page(s: &Screen) -> String {
+    format!(
+        r#"{head}<body>
+<section class="cover cover--blue cover--calm">
+  <div class="screen">
+    <div class="screen__top"><span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span><span class="screen__status" data-conn hidden>Reconnecting…</span></div>
+    <div class="screen__body" id="screen-body" data-seq="{seq}">{body}</div>
+  </div>
+</section>
+<nav class="screen-controls" id="screen-controls">{controls}</nav>
+<script>
+(function () {{
+  var body = document.getElementById("screen-body");
+  var controls = document.getElementById("screen-controls");
+  var conn = document.querySelector("[data-conn]");
+  var seq = {seq};
+  function apply(d) {{
+    if (d.seq < seq) return;
+    seq = d.seq;
+    body.innerHTML = d.body;
+    controls.innerHTML = d.controls;
+    if (d.stats) stats(d.stats);
+  }}
+  function stats(s) {{
+    var p = body.querySelector("[data-players]");
+    if (p) p.textContent = "Players: " + s.players;
+    var a = body.querySelector("[data-answers]");
+    if (a) a.textContent = "Answers: " + s.answered + " / " + s.in_game;
+  }}
+  var es;
+  function connect() {{
+    es = new EventSource("{base}/events");
+    es.addEventListener("screen", function (e) {{ apply(JSON.parse(e.data)); }});
+    es.addEventListener("stats", function (e) {{ stats(JSON.parse(e.data)); }});
+    es.onopen = function () {{ conn.hidden = true; }};
+    es.onerror = function () {{
+      conn.hidden = false;
+      if (es.readyState === 2) setTimeout(connect, 2000);
+    }};
+  }}
+  connect();
+  controls.addEventListener("submit", function (e) {{
+    var form = e.target.closest("[data-action]");
+    if (!form) return;
+    e.preventDefault();
+    var btn = form.querySelector("button");
+    if (btn.disabled) return;
+    btn.disabled = true;
+    fetch(form.action, {{ method: "POST", body: new URLSearchParams(new FormData(form)), headers: {{ "X-Requested-With": "fetch" }} }})
+      .then(function (r) {{ if (!r.ok) throw new Error(r.status); return r.json(); }})
+      .then(apply)
+      .catch(function () {{ btn.disabled = false; alert("Couldn't reach the server. Please try again."); }});
+  }});
+}})();
+</script>
+</body></html>"#,
+        head = crate::views::head_tag(&format!("Game {} · {}", s.game.code, s.quiz.title)),
+        seq = s.game.seq,
+        base = format!("/moderate/games/{}", s.game.id),
+        body = screen_body(s),
+        controls = screen_controls(s),
+    )
+}
+
+// ---------- Player ----------
+
+pub struct PlayerView<'a> {
+    pub game: &'a Game,
+    pub name: &'a str,
+    pub question: Option<&'a Question>,
+    pub total: i64,
+    pub picked: Option<i64>,
+    pub score: (i64, i64),
+}
+
+pub fn player_fragment(v: &PlayerView) -> String {
+    let code = esc(&v.game.code);
+    match v.game.phase {
+        Phase::Lobby => format!(
+            r#"<div class="waiting">
+  <div class="waiting__gem" aria-hidden="true">?</div>
+  <h1 class="play-title">Hi, {name}!</h1>
+  <p class="play-lead">You're in. The quiz starts soon, keep this page open.</p>
+</div>"#,
+            name = esc(v.name)
+        ),
+        Phase::Open => {
+            let qid = v.question.map(|q| q.id).unwrap_or(0);
+            let options: String = v
+                .question
+                .map(|q| {
+                    q.options
+                        .iter()
+                        .enumerate()
+                        .map(|(i, o)| {
+                            let picked = v.picked == Some(o.id);
+                            format!(
+                                r#"<form method="post" action="/play/{code}/answer" data-answer><input type="hidden" name="question" value="{qid}"><input type="hidden" name="option" value="{oid}"><button class="play-option{cls}" type="submit"{pressed}><span class="play-option__letter">{l}</span><span class="play-option__title">{t}</span>{mark}</button></form>"#,
+                                oid = o.id,
+                                cls = if picked { " is-picked" } else { "" },
+                                pressed = if picked { r#" aria-pressed="true""# } else { r#" aria-pressed="false""# },
+                                l = letter(i),
+                                t = esc(&o.text),
+                                mark = if picked { r#"<span class="play-option__mark">Your answer</span>"# } else { "" },
+                            )
+                        })
+                        .collect()
+                })
+                .unwrap_or_default();
+            let status = if v.picked.is_some() {
+                "Answer sent. You can change it until the question closes."
+            } else {
+                "Tap an option to answer."
+            };
+            format!(
+                r#"{head}
+<div class="play-options">{options}</div>
+<div class="play-status play-status--neutral" data-status role="status">{status}</div>"#,
+                head = question_head(v.game.num, v.total, v.question, "play"),
+            )
+        }
+        Phase::Closed => {
+            let options: String = v
+                .question
+                .map(|q| {
+                    q.options
+                        .iter()
+                        .enumerate()
+                        .map(|(i, o)| {
+                            let picked = v.picked == Some(o.id);
+                            let mut cls = String::new();
+                            if picked {
+                                cls.push_str(" is-picked");
+                            }
+                            if o.correct {
+                                cls.push_str(" is-correct");
+                            }
+                            format!(
+                                r#"<div class="play-option{cls}"><span class="play-option__letter">{l}</span><span class="play-option__title">{t}</span>{mark}</div>"#,
+                                l = if o.correct { "✓".to_string() } else { letter(i) },
+                                t = esc(&o.text),
+                                mark = if picked { r#"<span class="play-option__mark">Your answer</span>"# } else { "" },
+                            )
+                        })
+                        .collect()
+                })
+                .unwrap_or_default();
+            let right = v.picked.is_some_and(|p| v.question.is_some_and(|q| q.options.iter().any(|o| o.id == p && o.correct)));
+            let status = match v.picked {
+                None => r#"<div class="play-status play-status--neutral" role="status">No answer</div>"#,
+                Some(_) if right => r#"<div class="play-status play-status--right" role="status">Correct!</div>"#,
+                Some(_) => r#"<div class="play-status play-status--wrong" role="status">Wrong!</div>"#,
+            };
+            format!(
+                r#"{head}
+<div class="play-options is-locked is-revealed">{options}</div>
+{status}
+<p class="play-lead mt-2">Wait for the next question.</p>"#,
+                head = question_head(v.game.num, v.total, v.question, "play"),
+            )
+        }
+        Phase::Over => format!(
+            r#"<div class="result-card">
+  <div class="result-card__label">Thanks for playing, {name}!</div>
+  <h1 class="play-title">The quiz is over</h1>
+  <div class="result-card__score">Score: {right}/{total}</div>
+</div>"#,
+            name = esc(v.name),
+            right = v.score.0,
+            total = v.score.1,
+        ),
+    }
+}
+
+fn player_shell(quiz: &Quiz, code: &str, inner: &str) -> String {
+    format!(
+        r#"{head}<body>
+<div class="play">
+  <div class="play__top"><span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span><span>{title}</span></div>
+  {inner}
+</div>
+</body></html>"#,
+        head = crate::views::head_tag(&format!("{} · {}", quiz.title, code)),
+        title = esc(&quiz.title),
+    )
+}
+
+pub fn player_page(quiz: &Quiz, game: &Game, fragment: &str, conn_id: u64) -> String {
+    let code = esc(&game.code);
+    player_shell(
+        quiz,
+        &game.code,
+        &format!(
+            r#"<div class="play__body play__body--top" id="play" data-seq="{seq}" aria-live="polite">{fragment}</div>
+<div class="play-net" data-conn hidden role="status">Reconnecting…</div>
+<script>
+(function () {{
+  var root = document.getElementById("play");
+  var net = document.querySelector("[data-conn]");
+  var base = "/play/{code}";
+  var cid = "{cid}";
+  var seq = {seq};
+  var tap = 0;
+  function apply(d) {{
+    if (d.seq < seq) return;
+    seq = d.seq;
+    root.innerHTML = d.html;
+  }}
+  var es, retry;
+  function connect() {{
+    if (es) es.close();
+    es = new EventSource(base + "/events?cid=" + cid);
+    es.addEventListener("view", function (e) {{ apply(JSON.parse(e.data)); }});
+    es.addEventListener("gone", function () {{ es.close(); location.reload(); }});
+    es.onopen = function () {{ net.hidden = true; }};
+    es.onerror = function () {{
+      net.hidden = false;
+      if (es.readyState === 2) {{ clearTimeout(retry); retry = setTimeout(connect, 2000); }}
+    }};
+  }}
+  connect();
+  document.addEventListener("visibilitychange", function () {{
+    if (document.visibilityState === "visible" && (!es || es.readyState === 2)) connect();
+  }});
+  window.addEventListener("pagehide", function () {{
+    if (es) es.close();
+    if (navigator.sendBeacon) navigator.sendBeacon(base + "/leave", new URLSearchParams({{ cid: cid }}));
+  }});
+  window.addEventListener("pageshow", function (e) {{ if (e.persisted) connect(); }});
+  function send(form, n, attempt) {{
+    var body = new URLSearchParams(new FormData(form));
+    body.append("seq", String(n));
+    fetch(form.action, {{ method: "POST", body: body, headers: {{ "X-Requested-With": "fetch" }} }})
+      .then(function (r) {{ if (r.status >= 500) throw new Error(r.status); return r.json(); }})
+      .then(function (d) {{ if (n === tap || d.seq > seq) apply(d); }})
+      .catch(function () {{
+        if (n !== tap) return;
+        if (attempt < 6) return setTimeout(function () {{ send(form, n, attempt + 1); }}, 500 * (attempt + 1));
+        var st = root.querySelector("[data-status]");
+        if (st) st.textContent = "Couldn't send your answer. Check your connection and tap again.";
+      }});
+  }}
+  root.addEventListener("submit", function (e) {{
+    var form = e.target.closest("[data-answer]");
+    if (!form) return;
+    e.preventDefault();
+    tap = Math.max(Date.now(), tap + 1);
+    root.querySelectorAll(".play-option").forEach(function (b) {{
+      var on = b.form === form;
+      b.classList.toggle("is-picked", on);
+      b.setAttribute("aria-pressed", on ? "true" : "false");
+      var m = b.querySelector(".play-option__mark");
+      if (on && !m) {{ m = document.createElement("span"); m.className = "play-option__mark"; m.textContent = "Your answer"; b.appendChild(m); }}
+      if (!on && m) m.remove();
+    }});
+    var st = root.querySelector("[data-status]");
+    if (st) st.textContent = "Sending…";
+    send(form, tap, 0);
+  }});
+}})();
+</script>"#,
+            seq = game.seq,
+            cid = conn_id,
+        ),
+    )
+}
+
+pub fn join_page(quiz: &Quiz, game: &Game, name: &str, error: Option<&str>) -> String {
+    let error = error.map(|e| format!(r#"<div class="errors" role="alert">{}</div>"#, esc(e))).unwrap_or_default();
+    player_shell(
+        quiz,
+        &game.code,
+        &format!(
+            r#"<div class="play__body">
+  <h1 class="play-title">Join the quiz</h1>
+  <p class="play-lead">Pick a name that others will see.</p>
+  <form class="join-form" method="post" action="/play/{code}/join">
+    {error}
+    <label class="visually-hidden" for="player_name">Your name</label>
+    <input class="input" type="text" id="player_name" name="name" value="{name}" placeholder="Your name" maxlength="40" required autocomplete="nickname" autofocus>
+    <button class="btn btn--pink" type="submit">Join</button>
+  </form>
+</div>"#,
+            code = esc(&game.code),
+            name = esc(name),
+        ),
+    )
+}
+
+pub fn over_page(quiz: &Quiz, game: &Game) -> String {
+    player_shell(
+        quiz,
+        &game.code,
+        r#"<div class="play__body"><div class="result-card"><h1 class="play-title">The quiz is over</h1><p class="play-lead">Thanks for your interest! This game has ended.</p></div></div>"#,
+    )
+}
+
+pub fn games_section(quiz: &Quiz, games: &[GameSummary]) -> String {
+    let rows: String = games
+        .iter()
+        .map(|g| {
+            let (badge, label) = match g.game.phase {
+                Phase::Lobby => ("running", "Waiting"),
+                Phase::Open | Phase::Closed => ("running", "Live"),
+                Phase::Over => ("finished", "Ended"),
+            };
+            format!(
+                r#"<tr><td><strong>{code}</strong></td><td>{created} UTC</td><td>{players}</td><td><span class="badge badge--{badge}">{label}</span></td><td><a class="btn btn--sm btn--ghost" href="/moderate/games/{id}">Big screen</a></td></tr>"#,
+                code = esc(&g.game.code),
+                created = esc(&g.game.created_at),
+                players = g.players,
+                id = g.game.id,
+            )
+        })
+        .collect();
+    let body = if games.is_empty() {
+        r#"<div class="empty">No games yet. Each game gets its own join link, players and answers.</div>"#.to_string()
+    } else {
+        format!(
+            r#"<div class="card"><table class="runs-table"><thead><tr><th>Game</th><th>Created</th><th>Players</th><th>Status</th><th></th></tr></thead><tbody>{rows}</tbody></table></div>"#
+        )
+    };
+    let _ = quiz;
