--- /dev/null
+++ b/src/game.rs
@@ -0,0 +1,544 @@
+//! Live game: moderator big screen, player phone pages, and their SSE streams.
+use std::{convert::Infallible, io::Read, sync::Arc, time::Duration};
+
+use axum::{
+    Form, Json,
+    extract::{Path, Query, State},
+    http::{HeaderMap, HeaderValue, StatusCode, header},
+    response::{
+        Html, IntoResponse, Redirect, Response,
+        sse::{Event, KeepAlive, Sse},
+    },
+};
+use futures_util::stream;
+use rusqlite::Connection;
+use serde::Deserialize;
+use serde_json::json;
+
+use crate::{
+    AppError, AppResult, AppState,
+    db::{self, Game, Phase, Question, Quiz},
+    game_views::{self, PlayerView, Screen, Stats},
+    live::{GameHub, PresenceGuard},
+};
+
+// ---------- Helpers ----------
+
+fn random_bytes<const N: usize>() -> [u8; N] {
+    let mut buf = [0u8; N];
+    std::fs::File::open("/dev/urandom").and_then(|mut f| f.read_exact(&mut buf)).expect("read /dev/urandom");
+    buf
+}
+
+fn random_token() -> String {
+    random_bytes::<24>().iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// Short, unambiguous join code (no 0/O, 1/I/L).
+fn random_code() -> String {
+    const ALPHABET: &[u8] = b"ABCDEFGHJKMNPQRSTUVWXYZ23456789";
+    random_bytes::<5>().iter().map(|b| ALPHABET[*b as usize % ALPHABET.len()] as char).collect()
+}
+
+pub fn join_url(headers: &HeaderMap, code: &str) -> String {
+    let host = headers
+        .get(header::HOST)
+        .and_then(|h| h.to_str().ok())
+        .filter(|h| !h.is_empty() && h.chars().all(|c| c.is_ascii_alphanumeric() || "-.:[]_".contains(c)))
+        .unwrap_or("localhost");
+    let scheme = match headers.get("x-forwarded-proto").and_then(|h| h.to_str().ok()) {
+        Some("https") => "https",
+        _ => "http",
+    };
+    format!("{scheme}://{host}/play/{code}")
+}
+
+fn qr_svg(url: &str) -> String {
+    match qrcode::QrCode::with_error_correction_level(url.as_bytes(), qrcode::EcLevel::M) {
+        Ok(code) => code
+            .render::<qrcode::render::svg::Color>()
+            .min_dimensions(256, 256)
+            .quiet_zone(true)
+            .dark_color(qrcode::render::svg::Color("#000033"))
+            .light_color(qrcode::render::svg::Color("#ffffff"))
+            .build()
+            // Drop the XML prolog; we inline the SVG in HTML.
+            .split_once("<svg")
+            .map(|(_, rest)| format!("<svg{rest}"))
+            .unwrap_or_default(),
+        Err(_) => String::new(),
+    }
+}
+
+fn is_fetch(headers: &HeaderMap) -> bool {
+    headers.contains_key("x-requested-with")
+}
+
+/// Everything needed to render a game, loaded in one go.
+struct Snapshot {
+    quiz: Quiz,
+    game: Game,
+    question: Option<Question>,
+    total: i64,
+    is_last: bool,
+}
+
+fn snapshot(conn: &Connection, game: Game) -> rusqlite::Result<Option<Snapshot>> {
+    let Some(quiz) = db::get_quiz(conn, game.quiz_id)? else { return Ok(None) };
+    let question = match (game.phase, game.question_id) {
+        (Phase::Open | Phase::Closed, Some(qid)) => db::get_question(conn, game.quiz_id, qid)?,
+        _ => None,
+    };
+    let remaining = if game.phase == Phase::Over { 0 } else { db::remaining_questions(conn, &game)?.len() as i64 };
+    let total = match game.phase {
+        Phase::Lobby => remaining,
+        _ => game.num + remaining,
+    };
+    Ok(Some(Snapshot { quiz, game, question, total, is_last: remaining == 0 }))
+}
+
+fn snapshot_by_id(conn: &Connection, game_id: i64) -> rusqlite::Result<Option<Snapshot>> {
+    match db::get_game(conn, game_id)? {
+        Some(g) => snapshot(conn, g),
+        None => Ok(None),
+    }
+}
+
+fn stats(conn: &Connection, hub: &GameHub, snap: &Snapshot) -> rusqlite::Result<Stats> {
+    let mut present = hub.present_players();
+    let players = present.len();
+    let mut answered = 0;
+    if let (Phase::Open, Some(qid)) = (snap.game.phase, snap.game.question_id) {
+        let ids = db::answered_players(conn, snap.game.id, qid)?;
+        answered = ids.len();
+        present.extend(ids);
+    }
+    Ok(Stats { players, answered, in_game: present.len() })
+}
+
+struct ScreenParts {
+    seq: i64,
+    body: String,
+    controls: String,
+    page: Option<String>,
+    stats: Stats,
+}
+
+fn render_screen(conn: &Connection, hub: &GameHub, snap: &Snapshot, url: &str, qr: &str, page: bool) -> rusqlite::Result<ScreenParts> {
+    let stats = stats(conn, hub, snap)?;
+    let counts = match (snap.game.phase, snap.game.question_id) {
+        (Phase::Closed, Some(qid)) => db::option_counts(conn, snap.game.id, qid)?,
+        _ => vec![],
+    };
+    let screen = Screen {
+        quiz: &snap.quiz,
+        game: &snap.game,
+        question: snap.question.as_ref(),
+        total: snap.total,
+        is_last: snap.is_last,
+        join_url: url,
+        qr_svg: qr,
+        stats,
+        counts: &counts,
+    };
+    Ok(ScreenParts {
+        seq: snap.game.seq,
+        body: game_views::screen_body(&screen),
+        controls: game_views::screen_controls(&screen),
+        page: page.then(|| game_views::screen_page(&screen)),
+        stats,
+    })
+}
+
+fn screen_json(p: &ScreenParts) -> serde_json::Value {
+    json!({ "seq": p.seq, "body": p.body, "controls": p.controls, "stats": p.stats })
+}
+
+// ---------- Moderator ----------
+
+pub async fn game_create(State(s): State<AppState>, Path(quiz_id): Path<i64>) -> AppResult {
+    let conn = s.conn();
+    db::get_quiz(&conn, quiz_id)?.ok_or(AppError::NotFound)?;
+    let id = db::create_game(&conn, quiz_id, random_code)?;
+    Ok(Redirect::to(&format!("/moderate/games/{id}")).into_response())
+}
+
+pub async fn screen(State(s): State<AppState>, Path(id): Path<i64>, headers: HeaderMap) -> AppResult {
+    let hub = s.hub.game(id);
+    let conn = s.conn();
+    let snap = snapshot_by_id(&conn, id)?.ok_or(AppError::NotFound)?;
+    let url = join_url(&headers, &snap.game.code);
+    let qr = if snap.game.phase == Phase::Lobby { qr_svg(&url) } else { String::new() };
+    let parts = render_screen(&conn, &hub, &snap, &url, &qr, true)?;
+    Ok(([(header::CACHE_CONTROL, "no-store")], Html(parts.page.unwrap_or_default())).into_response())
+}
+
+#[derive(Deserialize)]
+pub struct ActionParams {
+    seq: Option<i64>,
+}
+
+pub async fn screen_action(
+    State(s): State<AppState>,
+    Path((id, action)): Path<(i64, String)>,
+    headers: HeaderMap,
+    Form(p): Form<ActionParams>,
+) -> AppResult {
+    let action = match action.as_str() {
+        "start" => db::Action::Start,
+        "finish" => db::Action::Finish,
+        "next" => db::Action::Next,
+        "end" => db::Action::End,
+        _ => return Err(AppError::NotFound),
+    };
+    let hub = s.hub.game(id);
+    let mut conn = s.conn();
+    db::get_game(&conn, id)?.ok_or(AppError::NotFound)?;
+    if db::advance(&mut conn, id, action, p.seq)? {
+        hub.bump_phase();
+    }
+    if !is_fetch(&headers) {
+        return Ok(Redirect::to(&format!("/moderate/games/{id}")).into_response());
+    }
+    let snap = snapshot_by_id(&conn, id)?.ok_or(AppError::NotFound)?;
+    let url = join_url(&headers, &snap.game.code);
+    let qr = if snap.game.phase == Phase::Lobby { qr_svg(&url) } else { String::new() };
+    let parts = render_screen(&conn, &hub, &snap, &url, &qr, false)?;
+    Ok(Json(screen_json(&parts)).into_response())
+}
+
+fn sse_response<S>(stream: S) -> Response
+where
+    S: futures_util::Stream<Item = Result<Event, Infallible>> + Send + 'static,
+{
+    let mut res = Sse::new(stream).keep_alive(KeepAlive::new().interval(Duration::from_secs(2))).into_response();
+    let h = res.headers_mut();
+    h.insert(header::CACHE_CONTROL, HeaderValue::from_static("no-cache, no-store"));
+    h.insert("x-accel-buffering", HeaderValue::from_static("no"));
+    res
+}
+
+const RETRY: Duration = Duration::from_millis(1500);
+
+struct ScreenStream {
+    s: AppState,
+    hub: Arc<GameHub>,
+    game_id: i64,
+    url: String,
+    phase_rx: tokio::sync::watch::Receiver<u64>,
+    stats_rx: tokio::sync::watch::Receiver<u64>,
+    shutdown_rx: tokio::sync::watch::Receiver<bool>,
+    last: Option<(i64, Stats)>,
+    done: bool,
+}
+
+impl ScreenStream {
+    /// Ok(None): nothing new to send. Err: the game is gone.
+    fn poll_change(&mut self) -> Result<Option<Event>, ()> {
+        let conn = self.s.conn();
+        let snap = snapshot_by_id(&conn, self.game_id).ok().flatten().ok_or(())?;
+        let stats = stats(&conn, &self.hub, &snap).map_err(|_| ())?;
+        match self.last {
+            Some((seq, st)) if seq == snap.game.seq => {
+                if st == stats {
+                    return Ok(None);
+                }
+                self.last = Some((seq, stats));
+                Ok(Some(Event::default().event("stats").data(json!(stats).to_string())))
+            }
+            first => {
+                let qr = if snap.game.phase == Phase::Lobby { qr_svg(&self.url) } else { String::new() };
+                let parts = render_screen(&conn, &self.hub, &snap, &self.url, &qr, false).map_err(|_| ())?;
+                self.last = Some((snap.game.seq, parts.stats));
+                let ev = Event::default().event("screen").data(screen_json(&parts).to_string());
+                Ok(Some(if first.is_none() { ev.retry(RETRY) } else { ev }))
+            }
+        }
+    }
+}
+
+pub async fn screen_events(State(s): State<AppState>, Path(id): Path<i64>, headers: HeaderMap) -> AppResult {
+    let game = db::get_game(&s.conn(), id)?.ok_or(AppError::NotFound)?;
+    let hub = s.hub.game(id);
+    let st = ScreenStream {
+        url: join_url(&headers, &game.code),
+        phase_rx: hub.phase.subscribe(),
+        stats_rx: hub.stats.subscribe(),
+        shutdown_rx: s.hub.shutdown.subscribe(),
+        hub,
+        s: s.clone(),
+        game_id: id,
+        last: None,
+        done: false,
+    };
+    let stream = stream::unfold(st, |mut st| async move {
+        if st.done {
+            return None;
+        }
+        loop {
+            match st.poll_change() {
+                Err(()) => {
+                    st.done = true;
+                    return Some((Ok(Event::default().event("gone").data("1")), st));
+                }
+                Ok(Some(ev)) => return Some((Ok(ev), st)),
+                Ok(None) => {}
+            }
+            tokio::select! {
+                r = st.phase_rx.changed() => if r.is_err() { return None },
+                r = st.stats_rx.changed() => if r.is_err() { return None },
+                _ = st.shutdown_rx.changed() => return None,
+            }
+            // Coalesce bursts (many answers at once) into one update.
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    });
+    Ok(sse_response(stream))
+}
+
+// ---------- Player ----------
+
+fn cookie_name(code: &str) -> String {
+    format!("quizzy_player_{code}")
+}
+
+fn cookie_token(headers: &HeaderMap, code: &str) -> Option<String> {
+    let name = cookie_name(code);
+    headers
+        .get_all(header::COOKIE)
+        .iter()
+        .filter_map(|v| v.to_str().ok())
+        .flat_map(|v| v.split(';'))
+        .filter_map(|kv| kv.trim().split_once('='))
+        .find(|(k, _)| *k == name)
+        .map(|(_, v)| v.trim().to_string())
+        .filter(|v| !v.is_empty())
+}
+
+fn normalize_code(code: &str) -> String {
+    code.trim().to_ascii_uppercase()
+}
+
+fn find_game(conn: &Connection, code: &str) -> AppResult<Game> {
+    db::game_by_code(conn, &normalize_code(code))?.ok_or(AppError::NotFound)
+}
+
+fn current_player(conn: &Connection, headers: &HeaderMap, game: &Game) -> rusqlite::Result<Option<db::Player>> {
+    match cookie_token(headers, &game.code) {
+        Some(t) => db::player_by_token(conn, game.id, &t),
+        None => Ok(None),
+    }
+}
+
+fn player_fragment(conn: &Connection, snap: &Snapshot, player: &db::Player) -> rusqlite::Result<String> {
+    let picked = match (snap.game.phase, snap.game.question_id) {
+        (Phase::Open | Phase::Closed, Some(qid)) => db::answer_of(conn, snap.game.id, qid, player.id)?,
+        _ => None,
+    };
+    let score = if snap.game.phase == Phase::Over { db::player_score(conn, snap.game.id, player.id)? } else { (0, 0) };
+    Ok(game_views::player_fragment(&PlayerView {
+        game: &snap.game,
+        name: &player.name,
+        question: snap.question.as_ref(),
+        total: snap.total,
+        picked,
+        score,
+    }))
+}
+
+fn no_store(html: String) -> Response {
+    ([(header::CACHE_CONTROL, "no-store")], Html(html)).into_response()
+}
+
+pub async fn play(State(s): State<AppState>, Path(code): Path<String>, headers: HeaderMap) -> AppResult {
+    if code != normalize_code(&code) {
+        return Ok(Redirect::to(&format!("/play/{}", normalize_code(&code))).into_response());
+    }
+    let conn = s.conn();
+    let game = find_game(&conn, &code)?;
+    let player = current_player(&conn, &headers, &game)?;
+    let snap = snapshot(&conn, game.clone())?.ok_or(AppError::NotFound)?;
+    match player {
+        Some(player) => {
+            s.hub.game(game.id).seen(player.id);
+            let fragment = player_fragment(&conn, &snap, &player)?;
+            let html = game_views::player_page(&snap.quiz, &snap.game, &fragment, s.hub.conn_id());
+            Ok(no_store(html))
+        }
+        None if game.phase == Phase::Over => Ok(no_store(game_views::over_page(&snap.quiz, &game))),
+        None => Ok(no_store(game_views::join_page(&snap.quiz, &game, "", None))),
+    }
+}
+
+#[derive(Deserialize)]
+pub struct JoinParams {
+    #[serde(default)]
+    name: String,
+}
+
+pub async fn join(
+    State(s): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(p): Form<JoinParams>,
+) -> AppResult {
+    let conn = s.conn();
+    let game = find_game(&conn, &code)?;
+    let back = Redirect::to(&format!("/play/{}", game.code)).into_response();
+    if game.phase == Phase::Over || current_player(&conn, &headers, &game)?.is_some() {
+        return Ok(back);
+    }
+    let name: String = p.name.split_whitespace().collect::<Vec<_>>().join(" ");
+    let error = if name.is_empty() {
+        Some("Please enter your name")
+    } else if name.chars().count() > 40 {
+        Some("Your name is too long (40 characters at most)")
+    } else {
+        None
+    };
+    if let Some(error) = error {
+        let quiz = db::get_quiz(&conn, game.quiz_id)?.ok_or(AppError::NotFound)?;
+        return Ok((StatusCode::UNPROCESSABLE_ENTITY, Html(game_views::join_page(&quiz, &game, &p.name, Some(error))))
+            .into_response());
+    }
+    let token = random_token();
+    let player_id = db::create_player(&conn, game.id, &name, &token)?;
+    s.hub.game(game.id).seen(player_id);
+    let cookie = format!(
+        "{}={token}; Path=/play/{}; Max-Age=2592000; HttpOnly; SameSite=Lax",
+        cookie_name(&game.code),
+        game.code
+    );
+    let mut res = back;
+    res.headers_mut().append(header::SET_COOKIE, HeaderValue::from_str(&cookie).expect("cookie"));
+    Ok(res)
+}
+
+#[derive(Deserialize)]
+pub struct AnswerParams {
+    question: i64,
+    option: i64,
+    seq: Option<i64>,
+}
+
+pub async fn answer(
+    State(s): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(p): Form<AnswerParams>,
+) -> AppResult {
+    let conn = s.conn();
+    let game = find_game(&conn, &code)?;
+    let Some(player) = current_player(&conn, &headers, &game)? else {
+        if is_fetch(&headers) {
+            return Ok(StatusCode::FORBIDDEN.into_response());
+        }
+        return Ok(Redirect::to(&format!("/play/{}", game.code)).into_response());
+    };
+    // Without JS there's no client sequence: use the server clock (ms), like the JS does.
+    let seq = p.seq.unwrap_or_else(|| {
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis() as i64).unwrap_or(0)
+    });
+    if db::save_answer(&conn, game.id, p.question, player.id, p.option, seq)? {
+        s.hub.game(game.id).bump_stats();
+    }
+    if !is_fetch(&headers) {
+        return Ok(Redirect::to(&format!("/play/{}", game.code)).into_response());
+    }
+    let game = db::get_game(&conn, game.id)?.ok_or(AppError::NotFound)?;
+    let snap = snapshot(&conn, game)?.ok_or(AppError::NotFound)?;
+    let html = player_fragment(&conn, &snap, &player)?;
+    Ok(Json(json!({ "seq": snap.game.seq, "html": html })).into_response())
+}
+
+#[derive(Deserialize)]
+pub struct ConnParams {
+    cid: Option<u64>,
+}
+
+pub async fn leave(
+    State(s): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(p): Form<ConnParams>,
+) -> AppResult {
+    let conn = s.conn();
+    let game = find_game(&conn, &code)?;
+    if let (Some(player), Some(cid)) = (current_player(&conn, &headers, &game)?, p.cid) {
+        s.hub.game(game.id).leave(player.id, cid);
+    }
+    Ok(StatusCode::NO_CONTENT.into_response())
+}
+
+struct PlayerStream {
+    s: AppState,
+    game_id: i64,
+    player: db::Player,
+    phase_rx: tokio::sync::watch::Receiver<u64>,
+    shutdown_rx: tokio::sync::watch::Receiver<bool>,
+    last: Option<String>,
+    done: bool,
+    _guard: PresenceGuard,
+}
+
+impl PlayerStream {
+    fn poll_change(&mut self) -> Result<Option<Event>, ()> {
+        let conn = self.s.conn();
+        let snap = snapshot_by_id(&conn, self.game_id).ok().flatten().ok_or(())?;
+        let html = player_fragment(&conn, &snap, &self.player).map_err(|_| ())?;
+        if self.last.as_deref() == Some(html.as_str()) {
+            return Ok(None);
+        }
+        let first = self.last.is_none();
+        let ev = Event::default().event("view").data(json!({ "seq": snap.game.seq, "html": html }).to_string());
+        self.last = Some(html);
+        Ok(Some(if first { ev.retry(RETRY) } else { ev }))
+    }
+}
+
+pub async fn play_events(
+    State(s): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Query(p): Query<ConnParams>,
+) -> AppResult {
+    let (game, player) = {
+        let conn = s.conn();
+        let game = find_game(&conn, &code)?;
+        let player = current_player(&conn, &headers, &game)?;
+        (game, player)
+    };
+    let Some(player) = player else { return Ok(StatusCode::FORBIDDEN.into_response()) };
+    let hub = s.hub.game(game.id);
+    let cid = p.cid.unwrap_or_else(|| s.hub.conn_id());
+    let st = PlayerStream {
+        _guard: hub.connect(player.id, cid),
+        phase_rx: hub.phase.subscribe(),
+        shutdown_rx: s.hub.shutdown.subscribe(),
+        s: s.clone(),
+        game_id: game.id,
+        player,
+        last: None,
+        done: false,
+    };
+    let stream = stream::unfold(st, |mut st| async move {
+        if st.done {
+            return None;
+        }
+        loop {
+            match st.poll_change() {
+                Err(()) => {
+                    st.done = true;
+                    return Some((Ok(Event::default().event("gone").data("1")), st));
+                }
+                Ok(Some(ev)) => return Some((Ok(ev), st)),
+                Ok(None) => {}
+            }
+            tokio::select! {
+                r = st.phase_rx.changed() => if r.is_err() { return None },
+                _ = st.shutdown_rx.changed() => return None,
+            }
+        }
+    });
+    Ok(sse_response(stream))
+}
