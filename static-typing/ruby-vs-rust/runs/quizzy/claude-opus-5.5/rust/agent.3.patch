+"""Live game scenario: one moderator + several players, each in an isolated browser context.
+Run against a server on :3000 with mod:secret:  python3 docs/e2e/game_test.py"""
+import base64, json, os, subprocess, sys, time, urllib.request
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from cdp import WS
+
+B = "http://localhost:3000"
+PORT = 9334
+proc = subprocess.Popen(["chromium", "--headless=new", "--no-sandbox", "--disable-gpu",
+    f"--remote-debugging-port={PORT}", "--user-data-dir=/tmp/e2e/profile-game", "about:blank"],
+    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+for _ in range(50):
+    try:
+        ver = json.load(urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json/version")); break
+    except Exception: time.sleep(0.2)
+
+class Conn:
+    def __init__(self, url):
+        self.ws = WS(url); self.id = 0; self.dialogs = []
+    def call(self, method, **params):
+        self.id += 1; my = self.id
+        self.ws.send(json.dumps({"id": my, "method": method, "params": params}))
+        while True:
+            m = json.loads(self.ws.recv())
+            if m.get("method") == "Page.javascriptDialogOpening":
+                self.dialogs.append(m["params"]["message"]); self.id += 1
+                self.ws.send(json.dumps({"id": self.id, "method": "Page.handleJavaScriptDialog", "params": {"accept": True}}))
+                continue
+            if m.get("id") == my:
+                if "error" in m: raise RuntimeError(m["error"])
+                return m.get("result")
+
+browser = Conn(ver["webSocketDebuggerUrl"])
+
+class Page(Conn):
+    def __init__(self, auth=None):
+        ctx = browser.call("Target.createBrowserContext")["browserContextId"]
+        tid = browser.call("Target.createTarget", url="about:blank", browserContextId=ctx)["targetId"]
+        self.tid = tid
+        tabs = json.load(urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json"))
+        super().__init__([t for t in tabs if t["id"] == tid][0]["webSocketDebuggerUrl"])
+        self.call("Page.enable"); self.call("Runtime.enable"); self.call("Network.enable")
+        if auth:
+            self.call("Network.setExtraHTTPHeaders", headers={"Authorization": "Basic " + base64.b64encode(auth.encode()).decode()})
+    def js(self, expr):
+        r = self.call("Runtime.evaluate", expression=expr, returnByValue=True, awaitPromise=True)
+        if "exceptionDetails" in r: raise RuntimeError(r["exceptionDetails"])
+        return r["result"].get("value")
+    def wait_load(self):
+        time.sleep(0.2)
+        for _ in range(100):
+            try:
+                if self.js("document.readyState") == "complete": return
+            except RuntimeError: pass
+            time.sleep(0.05)
+    def goto(self, url): self.call("Page.navigate", url=url); self.wait_load()
+    def text(self): return self.js("document.body.innerText")
+    def html(self): return self.js("document.documentElement.outerHTML")
+    def click(self, label):
+        ok = self.js(f"""(function(){{var t={json.dumps(label)};
+          var e=Array.from(document.querySelectorAll('a,button')).find(e=>e.textContent.trim()===t||e.getAttribute('aria-label')===t);
+          if(!e) return false; e.click(); return true;}})()""")
+        if not ok: raise RuntimeError("no " + label)
+        self.wait_load()
+    def close(self): browser.call("Target.closeTarget", targetId=self.tid)
+
+fails = 0
+def ok(cond, msg):
+    global fails
+    if not cond: fails += 1
+    print(("PASS " if cond else "FAIL ") + msg)
+
+def eventually(fn, timeout=5):
+    end = time.time() + timeout
+    while time.time() < end:
+        try:
+            if fn(): return True
+        except Exception: pass
+        time.sleep(0.1)
+    return False
+
+# Set up a quiz through the import form.
+quiz = {"title": "Game Quiz", "questions": [
+    {"text": "2+2?", "options": [{"text": "three"}, {"text": "four", "correct": True}]},
+    {"text": "Skipped?", "active": False, "options": [{"text": "x", "correct": True}, {"text": "y"}]},
+    {"text": "Sky?", "options": [{"text": "blue", "correct": True}, {"text": "green"}]},
+    {"text": "Last?", "options": [{"text": "yes", "correct": True}, {"text": "no"}]},
+]}
+m = Page(auth="mod:secret")
+m.goto(B + "/moderate/quizzes/import")
+m.js(f"document.querySelector('textarea').value = {json.dumps(json.dumps(quiz))}")
+m.click("Import")
+quiz_url = m.js("location.href")
+m.click("Start a game")
+ok("/moderate/games/" in m.js("location.href"), "Start a game opens the big screen")
+t = m.text()
+ok("Game Quiz" in t and "Players: 0" in t, "lobby: title, Players: 0")
+join = m.js("document.querySelector('[data-join-url]').textContent")
+ok(join.startswith("http://localhost:3000/play/"), "join link " + join)
+ok(m.js("!!document.querySelector('.qr svg')"), "QR code")
+
+a = Page(); a.goto(join)
+ok("Your name" in a.html() and "Join" in a.text(), "join form")
+a.js("document.querySelector('input[name=name]').value='Alice'"); a.click("Join")
+ok(eventually(lambda: "Hi, Alice!" in a.text()), "Hi, Alice!")
+ok(eventually(lambda: "Players: 1" in m.text()), "moderator sees Players: 1 live")
+b = Page(); b.goto(join)
+b.js("document.querySelector('input[name=name]').value='Bob'"); b.click("Join")
+ok(eventually(lambda: "Players: 2" in m.text()), "Players: 2")
+a.goto(join)
+ok("Hi, Alice!" in a.text(), "remembered after reopening the link")
+ok(eventually(lambda: "Players: 2" in m.text()), "still Players: 2 after Alice reloads")
+
+c = Page(); c.goto(join)
+c.js("document.querySelector('input[name=name]').value='Carol'"); c.click("Join")
+ok(eventually(lambda: "Players: 3" in m.text()), "Players: 3")
+c.close()
+t0 = time.time()
+ok(eventually(lambda: "Players: 2" in m.text(), 8), "Carol closed tab -> Players: 2 (%.1fs)" % (time.time() - t0))
+
+m.click("Start")
+ok(eventually(lambda: "Question 1 of 3" in m.text() and "2+2?" in m.text()), "screen: Question 1 of 3")
+ok(eventually(lambda: "Answers: 0 / 2" in m.text()), "Answers: 0 / 2")
+ok(eventually(lambda: "2+2?" in a.text() and "four" in a.text()), "phone shows the question live")
+src = a.html()
+ok("is-correct" not in src and "Correct" not in src, "no correct info in player page source")
+raw = None
+a.js("Array.from(document.querySelectorAll('button.play-option')).find(b=>b.textContent.includes('three')).click()")
+ok(eventually(lambda: a.js("document.querySelector('.is-picked').textContent").find("Your answer") >= 0), "Your answer mark")
+ok(eventually(lambda: "Answers: 1 / 2" in m.text()), "Answers: 1 / 2 live")
+time.sleep(0.3)
+a.js("Array.from(document.querySelectorAll('button.play-option')).find(b=>b.textContent.includes('four')).click()")
+ok(eventually(lambda: "four" in a.js("document.querySelector('.is-picked').textContent")), "changed answer")
+time.sleep(0.5)
+ok("Answers: 1 / 2" in m.text(), "still one answer after change")
+m.click("Finish")
+ok(eventually(lambda: "Correct" in m.text()), "screen shows Correct after finish")
+ok(eventually(lambda: "Correct!" in a.text()), "Alice: Correct! (last pick counts)")
+ok(eventually(lambda: "No answer" in b.text()), "Bob: No answer")
+counts = m.js("Array.from(document.querySelectorAll('.stage-option')).map(li=>li.textContent)")
+ok(counts == ["Athree0", "Bfour" + "Correct1"], "counts " + repr(counts))
+m.click("Next")
+ok(eventually(lambda: "Question 2 of 3" in m.text() and "Sky?" in m.text()), "inactive skipped: Question 2 of 3 Sky?")
+ok(eventually(lambda: "Sky?" in b.text()), "Bob sees Sky?")
+b.js("Array.from(document.querySelectorAll('button.play-option')).find(b=>b.textContent.includes('green')).click()")
+ok(eventually(lambda: "Answers: 1 / 2" in m.text()), "answers 1/2")
+m.click("Finish")
+ok(eventually(lambda: "Wrong!" in b.text()), "Bob: Wrong!")
+ok(eventually(lambda: "No answer" in a.text()), "Alice: No answer")
+ok("End quiz" not in m.text() and "Next" in m.text(), "Next on non-last")
+# Late joiner mid-game.
+d = Page(); d.goto(join)
+d.js("document.querySelector('input[name=name]').value='Dave'"); d.click("Join")
+ok(eventually(lambda: "Sky?" in d.text()), "late joiner sees the current state")
+m.click("Next")
+ok(eventually(lambda: "Question 3 of 3" in m.text()), "Question 3 of 3")
+ok(eventually(lambda: "Answers: 0 / 3" in m.text()), "Answers: 0 / 3")
+m.click("Finish")
+ok(eventually(lambda: "End quiz" in m.text()), "End quiz on last")
+m.click("End quiz")
+ok(eventually(lambda: "The quiz is over" in m.text()), "screen: The quiz is over")
+ok(eventually(lambda: "The quiz is over" in a.text()), "Alice: The quiz is over")
+e = Page(); e.goto(join)
+ok("The quiz is over" in e.text() and "Your name" not in e.html(), "new visitor after end: over, no join")
+m.goto(quiz_url)
+ok("Big screen" in m.text(), "games listed on the quiz page")
+print("FAILURES:", fails)
+proc.kill()
