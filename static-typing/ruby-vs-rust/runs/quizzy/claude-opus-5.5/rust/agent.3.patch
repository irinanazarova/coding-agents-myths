+
+// ---------- Games ----------
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Phase {
+    /// Waiting for the moderator to start.
+    Lobby,
+    /// A question is open for answers.
+    Open,
+    /// The current question is closed; results are shown.
+    Closed,
+    /// The game has ended.
+    Over,
+}
+
+impl Phase {
+    fn parse(s: &str) -> Phase {
+        match s {
+            "open" => Phase::Open,
+            "closed" => Phase::Closed,
+            "over" => Phase::Over,
+            _ => Phase::Lobby,
+        }
+    }
+}
+
+#[derive(Clone)]
+pub struct Game {
+    pub id: i64,
+    pub quiz_id: i64,
+    pub code: String,
+    pub phase: Phase,
+    pub question_id: Option<i64>,
+    pub num: i64,
+    /// Bumped on every phase change; lets clients drop stale updates.
+    pub seq: i64,
+    pub created_at: String,
+}
+
+const GAME_COLS: &str = "id, quiz_id, code, state, question_id, question_num, seq, created_at";
+
+fn game_row(r: &rusqlite::Row) -> rusqlite::Result<Game> {
+    Ok(Game {
+        id: r.get(0)?,
+        quiz_id: r.get(1)?,
+        code: r.get(2)?,
+        phase: Phase::parse(&r.get::<_, String>(3)?),
+        question_id: r.get(4)?,
+        num: r.get(5)?,
+        seq: r.get(6)?,
+        created_at: r.get(7)?,
+    })
+}
+
+pub fn create_game(conn: &Connection, quiz_id: i64, mut new_code: impl FnMut() -> String) -> rusqlite::Result<i64> {
+    loop {
+        let code = new_code();
+        let taken: bool = conn.query_row("SELECT EXISTS(SELECT 1 FROM games WHERE code = ?)", [&code], |r| r.get(0))?;
+        if taken {
+            continue;
+        }
+        conn.execute("INSERT INTO games (quiz_id, code) VALUES (?, ?)", params![quiz_id, code])?;
+        return Ok(conn.last_insert_rowid());
+    }
+}
+
+pub fn get_game(conn: &Connection, id: i64) -> rusqlite::Result<Option<Game>> {
+    conn.query_row(&format!("SELECT {GAME_COLS} FROM games WHERE id = ?"), [id], game_row).optional()
+}
+
+pub fn game_by_code(conn: &Connection, code: &str) -> rusqlite::Result<Option<Game>> {
+    conn.query_row(&format!("SELECT {GAME_COLS} FROM games WHERE code = ?"), [code], game_row).optional()
+}
+
+pub struct GameSummary {
+    pub game: Game,
+    pub players: i64,
+}
+
+pub fn games_for_quiz(conn: &Connection, quiz_id: i64) -> rusqlite::Result<Vec<GameSummary>> {
+    let mut st = conn.prepare(&format!(
+        "SELECT {GAME_COLS}, (SELECT COUNT(*) FROM players p WHERE p.game_id = games.id)
+         FROM games WHERE quiz_id = ? ORDER BY id DESC"
+    ))?;
+    st.query_map([quiz_id], |r| Ok(GameSummary { game: game_row(r)?, players: r.get(8)? }))?.collect()
+}
+
+/// Active questions not played yet in this game (the current one excluded), in quiz order.
+pub fn remaining_questions(conn: &Connection, game: &Game) -> rusqlite::Result<Vec<i64>> {
+    let mut st = conn.prepare(
+        "SELECT q.id FROM questions q
+         WHERE q.quiz_id = ? AND q.active = 1
+           AND NOT EXISTS (SELECT 1 FROM game_questions gq WHERE gq.game_id = ? AND gq.question_id = q.id)
+           AND q.id IS NOT ?
+         ORDER BY q.position, q.id",
+    )?;
+    st.query_map(params![game.quiz_id, game.id, game.question_id], |r| r.get(0))?.collect()
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Action {
+    Start,
+    Finish,
+    Next,
+    End,
+}
+
+/// Applies a moderator action. `expected_seq` guards against double clicks and stale pages:
+/// the action is ignored unless the game is still at that step. Returns true if something changed.
+pub fn advance(conn: &mut Connection, game_id: i64, action: Action, expected_seq: Option<i64>) -> rusqlite::Result<bool> {
+    let tx = conn.transaction()?;
+    let Some(game) = tx.query_row(&format!("SELECT {GAME_COLS} FROM games WHERE id = ?"), [game_id], game_row).optional()? else {
+        return Ok(false);
+    };
+    if expected_seq.is_some_and(|s| s != game.seq) {
+        return Ok(false);
+    }
+    let close_current = |tx: &rusqlite::Transaction| -> rusqlite::Result<()> {
+        if let Some(qid) = game.question_id {
+            tx.execute(
+                "UPDATE game_questions SET closed_at = strftime('%Y-%m-%d %H:%M:%f', 'now')
+                 WHERE game_id = ? AND question_id = ? AND closed_at IS NULL",
+                [game.id, qid],
+            )?;
+        }
+        Ok(())
+    };
+    let end = |tx: &rusqlite::Transaction| -> rusqlite::Result<()> {
+        tx.execute(
+            "UPDATE games SET state = 'over', seq = seq + 1, ended_at = CURRENT_TIMESTAMP WHERE id = ?",
+            [game.id],
+        )?;
+        Ok(())
+    };
+    let open_next = |tx: &rusqlite::Transaction| -> rusqlite::Result<()> {
+        match remaining_questions(tx, &game)?.first() {
+            None => end(tx),
+            Some(&qid) => {
+                let num = game.num + 1;
+                tx.execute(
+                    "INSERT OR REPLACE INTO game_questions (game_id, question_id, num) VALUES (?, ?, ?)",
+                    params![game.id, qid, num],
+                )?;
+                tx.execute(
+                    "UPDATE games SET state = 'open', question_id = ?, question_num = ?, seq = seq + 1,
+                            started_at = COALESCE(started_at, CURRENT_TIMESTAMP)
+                     WHERE id = ?",
+                    params![qid, num, game.id],
+                )?;
+                Ok(())
+            }
+        }
+    };
+    let changed = match (action, game.phase) {
+        (Action::Start, Phase::Lobby) => {
+            open_next(&tx)?;
+            true
+        }
+        (Action::Finish, Phase::Open) => {
+            close_current(&tx)?;
+            tx.execute("UPDATE games SET state = 'closed', seq = seq + 1 WHERE id = ?", [game.id])?;
+            true
+        }
+        (Action::Next, Phase::Closed) => {
+            open_next(&tx)?;
+            true
+        }
+        (Action::End, Phase::Lobby | Phase::Open | Phase::Closed) => {
+            close_current(&tx)?;
+            end(&tx)?;
+            true
+        }
+        _ => false,
+    };
+    tx.commit()?;
+    Ok(changed)
+}
+
+#[derive(Clone)]
+pub struct Player {
+    pub id: i64,
+    pub name: String,
+}
+
+pub fn player_by_token(conn: &Connection, game_id: i64, token: &str) -> rusqlite::Result<Option<Player>> {
+    conn.query_row(
+        "SELECT id, name FROM players WHERE game_id = ? AND token = ?",
+        params![game_id, token],
+        |r| Ok(Player { id: r.get(0)?, name: r.get(1)? }),
+    )
+    .optional()
+}
+
+pub fn create_player(conn: &Connection, game_id: i64, name: &str, token: &str) -> rusqlite::Result<i64> {
+    conn.execute("INSERT INTO players (game_id, token, name) VALUES (?, ?, ?)", params![game_id, token, name])?;
+    Ok(conn.last_insert_rowid())
+}
+
+/// Stores a player's pick for the open question. Picks with a lower `seq` than the stored one
+/// (late retries of older taps) are ignored, so the last tap wins. Returns false if the question isn't open.
+pub fn save_answer(
+    conn: &Connection,
+    game_id: i64,
+    question_id: i64,
+    player_id: i64,
+    option_id: i64,
+    seq: i64,
+) -> rusqlite::Result<bool> {
+    let n = conn.execute(
+        "INSERT INTO answers (game_id, question_id, player_id, option_id, seq)
+         SELECT g.id, g.question_id, ?3, o.id, ?5
+         FROM games g JOIN options o ON o.question_id = g.question_id
+         WHERE g.id = ?1 AND g.state = 'open' AND g.question_id = ?2 AND o.id = ?4
+         ON CONFLICT (player_id, question_id) DO UPDATE
+           SET option_id = excluded.option_id, seq = excluded.seq,
+               answered_at = strftime('%Y-%m-%d %H:%M:%f', 'now')
+           WHERE excluded.seq >= answers.seq",
+        params![game_id, question_id, player_id, option_id, seq],
+    )?;
+    if n > 0 {
+        return Ok(true);
+    }
+    // Ignored as stale, but still accepted if the question is open.
+    conn.query_row(
+        "SELECT EXISTS(SELECT 1 FROM games WHERE id = ? AND state = 'open' AND question_id = ?)",
+        [game_id, question_id],
+        |r| r.get(0),
+    )
+}
+
+pub fn answer_of(conn: &Connection, game_id: i64, question_id: i64, player_id: i64) -> rusqlite::Result<Option<i64>> {
+    conn.query_row(
+        "SELECT option_id FROM answers WHERE game_id = ? AND question_id = ? AND player_id = ?",
+        [game_id, question_id, player_id],
+        |r| r.get(0),
+    )
+    .optional()
+}
+
+pub fn answered_players(conn: &Connection, game_id: i64, question_id: i64) -> rusqlite::Result<Vec<i64>> {
+    let mut st = conn.prepare_cached("SELECT player_id FROM answers WHERE game_id = ? AND question_id = ?")?;
+    st.query_map([game_id, question_id], |r| r.get(0))?.collect()
+}
+
+/// Number of answers per option id for a question of a game.
+pub fn option_counts(conn: &Connection, game_id: i64, question_id: i64) -> rusqlite::Result<Vec<(i64, i64)>> {
+    let mut st = conn.prepare(
+        "SELECT option_id, COUNT(*) FROM answers WHERE game_id = ? AND question_id = ? GROUP BY option_id",
+    )?;
+    st.query_map([game_id, question_id], |r| Ok((r.get(0)?, r.get(1)?)))?.collect()
+}
+
+/// (correct answers, questions played) for a player.
+pub fn player_score(conn: &Connection, game_id: i64, player_id: i64) -> rusqlite::Result<(i64, i64)> {
+    conn.query_row(
+        "SELECT
+           (SELECT COUNT(*) FROM answers a JOIN options o ON o.id = a.option_id
+             WHERE a.game_id = ?1 AND a.player_id = ?2 AND o.correct = 1),
+           (SELECT COUNT(*) FROM game_questions WHERE game_id = ?1)",
+        [game_id, player_id],
+        |r| Ok((r.get(0)?, r.get(1)?)),
+    )
+}
