new file mode 100644
index 0000000..02a7622
--- /dev/null
+++ b/src/prizes.rs
@@ -0,0 +1,74 @@
+//! Picking winners from a leaderboard (best first, see `db::leaderboard`).
+//! Players with 0 points never win; if fewer than N players have points, all of them win.
+use crate::db::Standing;
+
+/// "Top N": the first N players of the leaderboard (who have points).
+pub fn top(board: &[Standing], n: usize) -> Vec<i64> {
+    board.iter().filter(|s| s.points > 0).take(n).map(|s| s.player_id).collect()
+}
+
+/// "Draw": everyone with more points than the N-th place wins; the remaining prizes are drawn at
+/// random among the players with exactly the N-th place's points (speed doesn't matter).
+/// `rand(k)` must return a uniform number in `0..k`.
+pub fn draw(board: &[Standing], n: usize, mut rand: impl FnMut(usize) -> usize) -> Vec<i64> {
+    let scored: Vec<&Standing> = board.iter().filter(|s| s.points > 0).collect();
+    if n == 0 {
+        return vec![];
+    }
+    if scored.len() <= n {
+        return scored.iter().map(|s| s.player_id).collect();
+    }
+    let cut = scored[n - 1].points;
+    let mut winners: Vec<i64> = scored.iter().filter(|s| s.points > cut).map(|s| s.player_id).collect();
+    let mut pool: Vec<i64> = scored.iter().filter(|s| s.points == cut).map(|s| s.player_id).collect();
+    // Partial Fisher–Yates: pick the remaining prizes from the pool.
+    let left = n - winners.len();
+    for i in 0..left.min(pool.len()) {
+        let j = i + rand(pool.len() - i);
+        pool.swap(i, j);
+        winners.push(pool[i]);
+    }
+    winners
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn b(points: &[i64]) -> Vec<Standing> {
+        points
+            .iter()
+            .enumerate()
+            .map(|(i, &p)| Standing { player_id: i as i64 + 1, name: format!("P{}", i + 1), points: p, time_ms: i as i64, winner: false })
+            .collect()
+    }
+
+    #[test]
+    fn top_skips_zero_points() {
+        assert_eq!(top(&b(&[3, 2, 2, 1]), 3), vec![1, 2, 3]);
+        assert_eq!(top(&b(&[3, 0, 0]), 3), vec![1]);
+        assert_eq!(top(&b(&[0, 0]), 3), Vec::<i64>::new());
+    }
+
+    #[test]
+    fn draw_ties() {
+        // N = 2, the 2nd place has 2 points; 3 players tie at 2: player 1 wins, one of 2..4 too.
+        let board = b(&[3, 2, 2, 2, 1]);
+        let mut seen = std::collections::HashSet::new();
+        for k in 0..3 {
+            let w = draw(&board, 2, |len| k % len);
+            assert_eq!(w.len(), 2);
+            assert_eq!(w[0], 1);
+            assert!([2, 3, 4].contains(&w[1]));
+            seen.insert(w[1]);
+        }
+        assert_eq!(seen.len(), 3);
+        // Fewer players with points than N: all of them.
+        assert_eq!(draw(&b(&[2, 1, 0, 0]), 3, |_| 0), vec![1, 2]);
+        // No tie: same as top.
+        assert_eq!(draw(&b(&[3, 2, 1, 1]), 2, |_| 0), vec![1, 2]);
+        // Everyone ties.
+        let w = draw(&b(&[1, 1, 1, 1]), 2, |len| len - 1);
+        assert_eq!(w.len(), 2);
+    }
+}
