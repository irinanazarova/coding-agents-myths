+"""Prizes scenario: scoring, leaderboard, Top N / Draw / Reset winners, live on the phones.
+Run against a server on :3000 with mod:secret:  python3 docs/e2e/prizes_test.py"""
+import base64, json, os, subprocess, sys, time, urllib.request
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from cdp import WS
+
+B = "http://localhost:3000"
+PORT = 9335
+proc = subprocess.Popen(["chromium", "--headless=new", "--no-sandbox", "--disable-gpu",
+    f"--remote-debugging-port={PORT}", "--user-data-dir=/tmp/e2e/profile-prizes", "about:blank"],
+    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+for _ in range(50):
+    try:
+        ver = json.load(urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json/version")); break
+    except Exception: time.sleep(0.2)
+
+class Conn:
+    def __init__(self, url):
+        self.ws = WS(url); self.id = 0; self.dialogs = []
+    def call(self, method, **params):
+        self.id += 1; my = self.id
+        self.ws.send(json.dumps({"id": my, "method": method, "params": params}))
+        while True:
+            m = json.loads(self.ws.recv())
+            if m.get("method") == "Page.javascriptDialogOpening":
+                self.dialogs.append(m["params"]["message"]); self.id += 1
+                self.ws.send(json.dumps({"id": self.id, "method": "Page.handleJavaScriptDialog", "params": {"accept": True}}))
+                continue
+            if m.get("id") == my:
+                if "error" in m: raise RuntimeError(m["error"])
+                return m.get("result")
+
+browser = Conn(ver["webSocketDebuggerUrl"])
+
+class Page(Conn):
+    def __init__(self, auth=None):
+        ctx = browser.call("Target.createBrowserContext")["browserContextId"]
+        tid = browser.call("Target.createTarget", url="about:blank", browserContextId=ctx)["targetId"]
+        self.tid = tid
+        tabs = json.load(urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json"))
+        super().__init__([t for t in tabs if t["id"] == tid][0]["webSocketDebuggerUrl"])
+        self.call("Page.enable"); self.call("Runtime.enable"); self.call("Network.enable")
+        if auth:
+            self.call("Network.setExtraHTTPHeaders", headers={"Authorization": "Basic " + base64.b64encode(auth.encode()).decode()})
+    def js(self, expr):
+        r = self.call("Runtime.evaluate", expression=expr, returnByValue=True, awaitPromise=True)
+        if "exceptionDetails" in r: raise RuntimeError(r["exceptionDetails"])
+        return r["result"].get("value")
+    def wait_load(self):
+        time.sleep(0.2)
+        for _ in range(100):
+            try:
+                if self.js("document.readyState") == "complete": return
+            except RuntimeError: pass
+            time.sleep(0.05)
+    def goto(self, url): self.call("Page.navigate", url=url); self.wait_load()
+    def text(self): return self.js("document.body.innerText")
+    def html(self): return self.js("document.documentElement.outerHTML")
+    def click(self, label):
+        ok = self.js(f"""(function(){{var t={json.dumps(label)};
+          var e=Array.from(document.querySelectorAll('a,button')).find(e=>e.textContent.trim()===t||e.getAttribute('aria-label')===t);
+          if(!e) return false; e.click(); return true;}})()""")
+        if not ok: raise RuntimeError("no " + label)
+        self.wait_load()
+    def close(self): browser.call("Target.closeTarget", targetId=self.tid)
+
+fails = 0
+def ok(cond, msg):
+    global fails
+    if not cond: fails += 1
+    print(("PASS " if cond else "FAIL ") + msg)
+
+def eventually(fn, timeout=5):
+    end = time.time() + timeout
+    while time.time() < end:
+        try:
+            if fn(): return True
+        except Exception: pass
+        time.sleep(0.1)
+    return False
+
+
+quiz = {"title": "Prize Quiz", "questions": [
+    {"text": "Q one?", "options": [{"text": "wrong1"}, {"text": "right1", "correct": True}]},
+    {"text": "Q two?", "options": [{"text": "right2", "correct": True}, {"text": "wrong2"}]},
+]}
+m = Page(auth="mod:secret")
+m.goto(B + "/moderate/quizzes/import")
+m.js(f"document.querySelector('textarea').value = {json.dumps(json.dumps(quiz))}")
+m.click("Import")
+quiz_url = m.js("location.href")
+m.click("Settings")
+ok(m.js("document.querySelector('#quiz_winners').value") == "3", "Number of winners defaults to 3")
+ok(m.js("document.querySelector('label[for=quiz_winners]').textContent") == "Number of winners", "label")
+m.js("document.querySelector('#quiz_winners').value='0'; document.querySelector('#quiz_winners').closest('form').noValidate=true")
+m.click("Save quiz")
+ok("at least 1" in m.text(), "0 winners rejected")
+m.js("document.querySelector('#quiz_winners').value='2'")
+m.click("Save quiz")
+m.click("Settings")
+ok(m.js("document.querySelector('#quiz_winners').value") == "2", "Number of winners saved")
+m.goto(quiz_url)
+m.click("Start a game")
+join = m.js("document.querySelector('[data-join-url]').textContent")
+
+names = ["Ann", "Ben", "Cat", "Dan", "Eve"]
+P = {}
+for n in names:
+    p = Page(); p.goto(join)
+    p.js(f"document.querySelector('input[name=name]').value='{n}'"); p.click("Join")
+    P[n] = p
+ok(eventually(lambda: "Players: 5" in m.text()), "Players: 5")
+
+def pick(p, text):
+    p.js(f"""Array.from(document.querySelectorAll('.play-option')).find(b=>b.textContent.includes('{text}')).click()""")
+
+m.click("Start")
+t0 = time.time()
+ok(eventually(lambda: all("Q one?" in P[n].text() for n in names), 3), "all phones got question 1")
+print("  question reached all phones in %.2fs (incl. polling)" % (time.time() - t0))
+ok("point" not in P["Ann"].text(), "no points during the game")
+# Q1: Ann, Ben, Cat right (Ann fastest, Cat slowest); Dan wrong then right later; Eve wrong.
+pick(P["Ann"], "right1"); time.sleep(0.3)
+pick(P["Ben"], "right1"); time.sleep(0.3)
+pick(P["Dan"], "wrong1"); pick(P["Eve"], "wrong1"); time.sleep(0.3)
+pick(P["Cat"], "right1"); time.sleep(0.3)
+pick(P["Dan"], "right1")  # last pick counts: Dan is right, but slowest
+ok(eventually(lambda: "Answers: 5 / 5" in m.text()), "Answers: 5 / 5")
+m.click("Finish")
+ok(eventually(lambda: "Correct!" in P["Ann"].text()), "Ann correct")
+ok("point" not in P["Ann"].text(), "no points after a question")
+m.click("Next")
+ok(eventually(lambda: all("Q two?" in P[n].text() for n in names), 3), "all phones got question 2")
+# Q2: only Ann and Ben right -> Ann 2, Ben 2, Cat 1, Dan 1 (slower), Eve 0
+pick(P["Ann"], "right2"); time.sleep(0.2); pick(P["Ben"], "right2"); pick(P["Cat"], "wrong2"); pick(P["Dan"], "wrong2")
+ok(eventually(lambda: "Answers: 4 / 5" in m.text()), "Answers: 4 / 5")
+m.click("Finish")
+ok(eventually(lambda: "End quiz" in m.text()), "End quiz")
+m.click("End quiz")
+def board():
+    return m.js("Array.from(document.querySelectorAll('.leaderboard li')).map(li=>li.innerText.replace(/\\s+/g,' ').trim())")
+ok(eventually(lambda: len(board()) == 5), "leaderboard has 5 items")
+b = board(); print("  ", b)
+ok(b[0].startswith("1 Ann 2 points") and b[1].startswith("2 Ben 2 points") and b[2].startswith("3 Cat 1 point")
+   and b[3].startswith("4 Dan 1 point") and b[4].startswith("5 Eve 0 points"), "leaderboard order and texts")
+ok(eventually(lambda: "Place 1 of 5" in P["Ann"].text() and "2 points" in P["Ann"].text()), "Ann: Place 1 of 5, 2 points")
+ok(eventually(lambda: "Place 3 of 5" in P["Cat"].text() and "1 point" in P["Cat"].text()), "Cat: Place 3 of 5, 1 point")
+ok(eventually(lambda: "Place 5 of 5" in P["Eve"].text() and "0 points" in P["Eve"].text()), "Eve: Place 5 of 5, 0 points")
+ok("You won!" not in P["Ann"].text() and "Winner" not in " ".join(b), "no winners yet")
+
+def winners():
+    return [x.split()[1] for x in board() if "Winner" in x]
+m.click("Top 2")
+ok(eventually(lambda: winners() == ["Ann", "Ben"]), "Top 2 -> Ann, Ben")
+ok(eventually(lambda: "You won!" in P["Ann"].text() and "You won!" in P["Ben"].text()), "Ann and Ben: You won!")
+ok("You won!" not in P["Cat"].text(), "Cat didn't win")
+m.click("Reset winners")
+ok(eventually(lambda: winners() == []), "Reset winners")
+ok(eventually(lambda: "You won!" not in P["Ann"].text()), "Ann: no longer won")
+
+# N = 3: Draw -> Ann, Ben + one of Cat/Dan (tie on points, speed ignored).
+m.goto(quiz_url + "/edit"); m.js("document.querySelector('#quiz_winners').value='3'"); m.click("Save quiz")
+m.goto(B + m.js("document.querySelector('a[href^=\"/moderate/games/\"]').getAttribute('href')"))
+m.click("Top 3")
+ok(eventually(lambda: winners() == ["Ann", "Ben", "Cat"]), "Top 3 -> Ann, Ben, Cat (speed)")
+seen = set()
+for i in range(12):
+    m.click("Draw")
+    time.sleep(0.3)
+    w = winners()
+    ok(len(w) == 3 and w[:2] == ["Ann", "Ben"] and w[2] in ("Cat", "Dan"), f"draw {i}: {w}")
+    seen.add(w[2])
+ok(seen == {"Cat", "Dan"}, "draw picks both Cat and Dan over time")
+last = winners()[2]
+ok(eventually(lambda: "You won!" in P[last].text()), f"{last}: You won! (live)")
+other = "Dan" if last == "Cat" else "Cat"
+ok(eventually(lambda: "You won!" not in P[other].text()), f"{other}: no win")
+ok("You won!" not in P["Eve"].text(), "0 points never wins")
+
+# N = 10: everyone with points wins, Eve (0) doesn't.
+m.goto(quiz_url + "/edit"); m.js("document.querySelector('#quiz_winners').value='10'"); m.click("Save quiz")
+m.goto(B + m.js("document.querySelector('a[href^=\"/moderate/games/\"]').getAttribute('href')"))
+m.click("Draw")
+ok(eventually(lambda: winners() == ["Ann", "Ben", "Cat", "Dan"]), "Draw with N=10 -> all with points")
+m.click("Top 10")
+ok(eventually(lambda: winners() == ["Ann", "Ben", "Cat", "Dan"]), "Top 10 -> all with points")
+P["Dan"].goto(join)
+ok("You won!" in P["Dan"].text() and "Place 4 of 5" in P["Dan"].text(), "reload keeps the result")
+print("FAILURES:", fails)
+proc.kill()
