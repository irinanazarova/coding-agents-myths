+// ---------- Leaderboard and winners ----------
+
+#[derive(Clone, Debug)]
+pub struct Standing {
+    pub player_id: i64,
+    pub name: String,
+    /// One point per correct answer.
+    pub points: i64,
+    /// Total time (ms) of the correct answers: from the question's opening to the player's last pick.
+    pub time_ms: i64,
+    pub winner: bool,
+}
+
+/// All players of a game, best first: more points, then lower total time of correct answers,
+/// then join order (deterministic). The place of a player is their index + 1.
+pub fn leaderboard(conn: &Connection, game_id: i64) -> rusqlite::Result<Vec<Standing>> {
+    let mut st = conn.prepare_cached(
+        "SELECT p.id, p.name,
+                COUNT(o.id) AS points,
+                COALESCE(SUM(CASE WHEN o.id IS NULL THEN 0 ELSE
+                    MAX(0, CAST(ROUND((julianday(a.answered_at) - julianday(gq.opened_at)) * 86400000.0) AS INTEGER))
+                  END), 0) AS time_ms,
+                EXISTS(SELECT 1 FROM game_winners w WHERE w.game_id = p.game_id AND w.player_id = p.id)
+         FROM players p
+         LEFT JOIN answers a ON a.player_id = p.id AND a.game_id = p.game_id
+         LEFT JOIN game_questions gq ON gq.game_id = a.game_id AND gq.question_id = a.question_id
+         LEFT JOIN options o ON o.id = a.option_id AND o.correct = 1 AND gq.question_id IS NOT NULL
+         WHERE p.game_id = ?
+         GROUP BY p.id
+         ORDER BY points DESC, time_ms ASC, p.id ASC",
+    )?;
+    st.query_map([game_id], |r| {
+        Ok(Standing { player_id: r.get(0)?, name: r.get(1)?, points: r.get(2)?, time_ms: r.get(3)?, winner: r.get(4)? })
+    })?
+    .collect()
+}
+
+/// Replaces the winners of a game (only once it's over) and bumps `seq` so every view re-renders.
+pub fn set_winners(conn: &mut Connection, game_id: i64, player_ids: &[i64]) -> rusqlite::Result<bool> {
+    let tx = conn.transaction()?;
+    let over: bool =
+        tx.query_row("SELECT EXISTS(SELECT 1 FROM games WHERE id = ? AND state = 'over')", [game_id], |r| r.get(0))?;
+    if !over {
+        return Ok(false);
+    }
+    tx.execute("DELETE FROM game_winners WHERE game_id = ?", [game_id])?;
+    for pid in player_ids {
+        tx.execute(
+            "INSERT OR IGNORE INTO game_winners (game_id, player_id)
+             SELECT game_id, id FROM players WHERE game_id = ? AND id = ?",
+            [game_id, *pid],
+        )?;
+    }
+    tx.execute("UPDATE games SET seq = seq + 1 WHERE id = ?", [game_id])?;
+    tx.commit()?;
+    Ok(true)
 }
