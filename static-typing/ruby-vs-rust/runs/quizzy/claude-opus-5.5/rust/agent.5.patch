+/// SQL condition (over `gq`, a `game_questions` row): the question has a timer and its time is up.
+const EXPIRED: &str = "gq.time_limit > 0 AND julianday('now') >= julianday(gq.opened_at) + gq.time_limit / 86400.0";
+
+/// Milliseconds left on the timer of the open question, or None (no timer, or not open).
+pub fn time_left_ms(conn: &Connection, game: &Game) -> rusqlite::Result<Option<i64>> {
+    let (Phase::Open, Some(qid)) = (game.phase, game.question_id) else { return Ok(None) };
+    conn.query_row(
+        "SELECT CASE WHEN time_limit > 0 THEN MAX(0, CAST(ROUND(
+                    (julianday(opened_at) + time_limit / 86400.0 - julianday('now')) * 86400000.0) AS INTEGER))
+                END
+         FROM game_questions WHERE game_id = ? AND question_id = ?",
+        [game.id, qid],
+        |r| r.get(0),
+    )
+    .optional()
+    .map(Option::flatten)
+}
+
+/// Open games whose question timer ran out: (game id, seq).
+pub fn expired_games(conn: &Connection) -> rusqlite::Result<Vec<(i64, i64)>> {
+    let mut st = conn.prepare_cached(&format!(
+        "SELECT g.id, g.seq FROM games g
+         JOIN game_questions gq ON gq.game_id = g.id AND gq.question_id = g.question_id
+         WHERE g.state = 'open' AND {EXPIRED}"
+    ))?;
+    st.query_map([], |r| Ok((r.get(0)?, r.get(1)?)))?.collect()
+}
