+"""Live game scenario: one moderator + several players, each in an isolated browser context.
+Run against a server on :3000 with mod:secret:  python3 docs/e2e/game_test.py"""
+import base64, json, os, subprocess, sys, time, urllib.request
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from cdp import WS
+
+B = "http://localhost:3000"
+PORT = 9336
+proc = subprocess.Popen(["chromium", "--headless=new", "--no-sandbox", "--disable-gpu",
+    f"--remote-debugging-port={PORT}", "--user-data-dir=/tmp/e2e/profile-timer", "about:blank"],
+    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+for _ in range(50):
+    try:
+        ver = json.load(urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json/version")); break
+    except Exception: time.sleep(0.2)
+
+class Conn:
+    def __init__(self, url):
+        self.ws = WS(url); self.id = 0; self.dialogs = []
+    def call(self, method, **params):
+        self.id += 1; my = self.id
+        self.ws.send(json.dumps({"id": my, "method": method, "params": params}))
+        while True:
+            m = json.loads(self.ws.recv())
+            if m.get("method") == "Page.javascriptDialogOpening":
+                self.dialogs.append(m["params"]["message"]); self.id += 1
+                self.ws.send(json.dumps({"id": self.id, "method": "Page.handleJavaScriptDialog", "params": {"accept": True}}))
+                continue
+            if m.get("id") == my:
+                if "error" in m: raise RuntimeError(m["error"])
+                return m.get("result")
+
+browser = Conn(ver["webSocketDebuggerUrl"])
+
+class Page(Conn):
+    def __init__(self, auth=None):
+        ctx = browser.call("Target.createBrowserContext")["browserContextId"]
+        tid = browser.call("Target.createTarget", url="about:blank", browserContextId=ctx)["targetId"]
+        self.tid = tid
+        tabs = json.load(urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json"))
+        super().__init__([t for t in tabs if t["id"] == tid][0]["webSocketDebuggerUrl"])
+        self.call("Page.enable"); self.call("Runtime.enable"); self.call("Network.enable")
+        if auth:
+            self.call("Network.setExtraHTTPHeaders", headers={"Authorization": "Basic " + base64.b64encode(auth.encode()).decode()})
+    def js(self, expr):
+        r = self.call("Runtime.evaluate", expression=expr, returnByValue=True, awaitPromise=True)
+        if "exceptionDetails" in r: raise RuntimeError(r["exceptionDetails"])
+        return r["result"].get("value")
+    def wait_load(self):
+        time.sleep(0.2)
+        for _ in range(100):
+            try:
+                if self.js("document.readyState") == "complete": return
+            except RuntimeError: pass
+            time.sleep(0.05)
+    def goto(self, url): self.call("Page.navigate", url=url); self.wait_load()
+    def text(self): return self.js("document.body.innerText")
+    def html(self): return self.js("document.documentElement.outerHTML")
+    def click(self, label):
+        ok = self.js(f"""(function(){{var t={json.dumps(label)};
+          var e=Array.from(document.querySelectorAll('a,button')).find(e=>e.textContent.trim()===t||e.getAttribute('aria-label')===t);
+          if(!e) return false; e.click(); return true;}})()""")
+        if not ok: raise RuntimeError("no " + label)
+        self.wait_load()
+    def close(self): browser.call("Target.closeTarget", targetId=self.tid)
+
+fails = 0
+def ok(cond, msg):
+    global fails
+    if not cond: fails += 1
+    print(("PASS " if cond else "FAIL ") + msg)
+
+def eventually(fn, timeout=5):
+    end = time.time() + timeout
+    while time.time() < end:
+        try:
+            if fn(): return True
+        except Exception: pass
+        time.sleep(0.1)
+    return False
+
+
+def fill(page, label, value):
+    page.js(f"""(function(){{var l=Array.from(document.querySelectorAll('label')).find(l=>l.textContent.trim()==={json.dumps(label)});
+      var i=document.getElementById(l.htmlFor); i.value={json.dumps(value)};}})()""")
+
+def timer(page):
+    return page.js("(document.querySelector('[data-timer]')||{}).textContent || null")
+
+quiz = {"title": "Timer Quiz", "questions": [
+    {"text": "First?", "options": [{"text": "a", "correct": True}, {"text": "b"}]},
+    {"text": "Second?", "options": [{"text": "c", "correct": True}, {"text": "d"}]},
+    {"text": "Third?", "options": [{"text": "e", "correct": True}, {"text": "f"}]},
+]}
+m = Page(auth="mod:secret")
+m.goto(B + "/moderate/quizzes/new")
+ok("Timer minutes" in m.text() and "Timer seconds" in m.text(), "new quiz form has timer fields")
+ok(m.js("document.getElementById('quiz_timer_minutes').value") == "0" and m.js("document.getElementById('quiz_timer_seconds').value") == "0", "defaults 0 / 0")
+m.goto(B + "/moderate/quizzes/import")
+m.js(f"document.querySelector('textarea').value = {json.dumps(json.dumps(quiz))}")
+m.click("Import")
+quiz_url = m.js("location.href")
+m.goto(quiz_url + "/edit")
+ok(m.js("document.getElementById('quiz_timer_seconds').value") == "0", "imported quiz: no timer")
+fill(m, "Timer seconds", "abc")
+m.js("document.getElementById('quiz_timer_seconds').type='text'")
+fill(m, "Timer seconds", "abc")
+m.click("Save quiz")
+ok("Timer seconds must be" in m.text(), "invalid seconds -> error")
+fill(m, "Timer minutes", "0"); fill(m, "Timer seconds", "4")
+m.click("Save quiz")
+m.goto(quiz_url + "/edit")
+ok(m.js("document.getElementById('quiz_timer_seconds').value") == "4", "saved 4 seconds")
+m.goto(quiz_url + "/export")
+exp = json.loads(m.js("document.querySelector('pre').textContent"))
+ok(list(exp.keys()) == ["title", "questions"] and "timer" not in json.dumps(exp["questions"]), "export has no timer: %r" % list(exp.keys()))
+
+m.goto(quiz_url); m.click("Start a game")
+join = m.js("document.querySelector('[data-join-url]').textContent")
+ok(timer(m) is None, "no timer in the lobby")
+a = Page(); a.goto(join)
+a.js("document.querySelector('input[name=name]').value='Alice'"); a.click("Join")
+ok(eventually(lambda: "Hi, Alice!" in a.text()), "Alice joined")
+m.click("Start")
+ok(eventually(lambda: "First?" in m.text()), "Q1 open")
+ok(timer(m) == "0:04", "countdown starts at 0:04: %r" % timer(m))
+ok(eventually(lambda: "First?" in a.text()), "phone shows Q1")
+ok(":0" not in a.text() and "data-timer" not in a.html(), "player sees no timer")
+time.sleep(1.6)
+m.goto(m.js("location.href"))
+t = timer(m)
+ok(t in ("0:02", "0:03"), "reload doesn't restart: %r" % t)
+ok(eventually(lambda: timer(m) == "0:01", 3), "counts down to 0:01")
+ok(eventually(lambda: "Correct" in m.text() and "Next" in m.text(), 4), "auto-finished at 0:00")
+ok(eventually(lambda: "No answer" in a.text()), "phone: question closed")
+m.click("Next")
+ok(eventually(lambda: "Second?" in m.text()), "Q2 open")
+ok(timer(m) == "0:04", "timer restarts for Q2: %r" % timer(m))
+m.click("Finish")
+ok(eventually(lambda: "Correct" in m.text()), "Finish early works")
+time.sleep(4.5)
+ok("Next" in m.text() and "Second?" in m.text(), "nothing odd after the deadline of a finished question")
+
+# Server-side auto-finish without any open big screen.
+m.click("Next")
+ok(eventually(lambda: "Third?" in m.text()), "Q3 open")
+gid = m.js("location.pathname.split('/').pop()")
+m.goto("about:blank")
+time.sleep(4.8)
+m.goto(B + "/moderate/games/" + gid)
+ok("Correct" in m.text() and "End quiz" in m.text(), "finished by the server with no screen open")
+m.click("End quiz")
+
+# No timer: 0:00
+m.goto(quiz_url + "/edit"); fill(m, "Timer seconds", "0"); m.click("Save quiz")
+m.goto(quiz_url); m.click("Start a game"); m.click("Start")
+ok(eventually(lambda: "First?" in m.text()), "no-timer game open")
+ok(timer(m) is None, "no countdown without a timer")
+m.goto(quiz_url + "/edit"); fill(m, "Timer minutes", "1"); fill(m, "Timer seconds", "30"); m.click("Save quiz")
+m.goto(quiz_url); m.click("Start a game"); m.click("Start")
+ok(eventually(lambda: timer(m) == "1:30"), "1:30 shown")
+print("FAILURES:", fails)
+proc.terminate()
+sys.exit(1 if fails else 0)
