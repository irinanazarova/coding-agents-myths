+// ---------- Question timer ----------
+
+/// Finishes every open question whose timer ran out, as if the moderator clicked "Finish".
+/// The finish is `seq`-guarded, so a moderator click at the same moment can't finish twice.
+fn finish_expired(s: &AppState) -> rusqlite::Result<()> {
+    let mut conn = s.conn();
+    for (game_id, seq) in db::expired_games(&conn)? {
+        if db::advance(&mut conn, game_id, db::Action::Finish, Some(seq))? {
+            s.hub.game(game_id).bump_phase();
+        }
+    }
+    Ok(())
+}
+
+/// Background task: checks the question timers a few times per second. The database is the source
+/// of truth (deadline = `game_questions.opened_at` + `time_limit`), so a restart doesn't lose a timer.
+pub async fn run_timers(s: AppState) {
+    let mut tick = tokio::time::interval(Duration::from_millis(100));
+    tick.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Delay);
+    loop {
+        tick.tick().await;
+        if let Err(e) = finish_expired(&s) {
+            eprintln!("timer error: {e}");
+        }
+    }
+}
