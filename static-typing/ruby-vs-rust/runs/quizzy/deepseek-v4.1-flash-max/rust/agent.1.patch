+use std::collections::{BTreeSet, HashMap};
+
+use rusqlite::Connection;
+
+use crate::db::{self, Question};
+use crate::views::{self, OptionRow};
+use crate::{App, Reply};
+
+fn lock(app: &App) -> std::sync::MutexGuard<'_, Connection> {
+    app.conn
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+fn db_error() -> Reply {
+    Reply::plain(500, "Database error")
+}
+
+fn not_found() -> Reply {
+    Reply::html(404, views::page_not_found())
+}
+
+fn parse_question_form(params: &HashMap<String, String>) -> (String, bool, Vec<OptionRow>) {
+    let body = params.get("question").cloned().unwrap_or_default();
+    let active = params.contains_key("active");
+    let mut indexes: BTreeSet<usize> = BTreeSet::new();
+    for key in params.keys() {
+        if let Some(num) = key
+            .strip_prefix("option_")
+            .and_then(|s| s.parse::<usize>().ok())
+        {
+            indexes.insert(num);
+        }
+        if let Some(num) = key
+            .strip_prefix("correct_")
+            .and_then(|s| s.parse::<usize>().ok())
+        {
+            indexes.insert(num);
+        }
+    }
+    if indexes.is_empty() {
+        indexes.extend(1..=4);
+    }
+    let rows = indexes
+        .into_iter()
+        .map(|n| OptionRow {
+            text: params
+                .get(&format!("option_{n}"))
+                .cloned()
+                .unwrap_or_default(),
+            correct: params.contains_key(&format!("correct_{n}")),
+        })
+        .collect();
+    (body, active, rows)
+}
+
+fn validate_question(body: &str, rows: &[OptionRow]) -> Vec<String> {
+    let mut errors = Vec::new();
+    if body.trim().is_empty() {
+        errors.push("Question is required".to_string());
+    }
+    let non_empty: Vec<&OptionRow> = rows
+        .iter()
+        .filter(|row| !row.text.trim().is_empty())
+        .collect();
+    if non_empty.len() < 2 {
+        errors.push("Add at least two options".to_string());
+    }
+    if non_empty.iter().all(|row| !row.correct) {
+        errors.push("Mark at least one option as correct".to_string());
+    }
+    errors
+}
+
+fn clean_options(rows: &[OptionRow]) -> Vec<(String, bool)> {
+    rows.iter()
+        .filter(|row| !row.text.trim().is_empty())
+        .map(|row| (row.text.trim().to_string(), row.correct))
+        .collect()
+}
+
+fn append_answer(prior: &str, option: usize) -> String {
+    let cleaned: String = prior
+        .chars()
+        .filter(|ch| ch.is_ascii_digit() || *ch == ',')
+        .collect();
+    let trimmed = cleaned.trim_matches(',').to_string();
+    if trimmed.is_empty() {
+        option.to_string()
+    } else {
+        format!("{trimmed},{option}")
+    }
+}
+
+fn count_score(questions: &[Question], answers: &str) -> usize {
+    let chosen: Vec<Option<usize>> = answers
+        .split(',')
+        .map(|part| part.trim().parse::<usize>().ok())
+        .collect();
+    questions
+        .iter()
+        .enumerate()
+        .filter(|(index, question)| {
+            chosen
+                .get(*index)
+                .copied()
+                .flatten()
+                .and_then(|choice| question.options.get(choice))
+                .map(|option| option.is_correct)
+                .unwrap_or(false)
+        })
+        .count()
+}
+
+// ---------------------------------------------------------------- Quizzes
+
+pub fn index(app: &App) -> Reply {
+    let conn = lock(app);
+    let quizzes = match db::list_quizzes(&conn) {
+        Ok(value) => value,
+        Err(_) => return db_error(),
+    };
+    let rows: Vec<(db::Quiz, usize, usize)> = quizzes
+        .into_iter()
+        .map(|quiz| {
+            let counts = db::quiz_counts(&conn, quiz.id).unwrap_or((0, 0));
+            (quiz, counts.0, counts.1)
+        })
+        .collect();
+    Reply::html(200, views::moderate_index(&rows))
+}
+
+pub fn quiz_new() -> Reply {
+    Reply::html(
+        200,
+        views::quiz_form(
+            "New quiz",
+            "/moderate/quizzes",
+            "",
+            "/moderate",
+            "All quizzes",
+            None,
+            None,
+        ),
+    )
+}
+
+pub fn quiz_create(app: &App, params: &HashMap<String, String>) -> Reply {
+    let raw_title = params.get("title").cloned().unwrap_or_default();
+    if raw_title.trim().is_empty() {
+        return Reply::html(
+            200,
+            views::quiz_form(
+                "New quiz",
+                "/moderate/quizzes",
+                &raw_title,
+                "/moderate",
+                "All quizzes",
+                Some("Title is required"),
+                None,
+            ),
+        );
+    }
+    let conn = lock(app);
+    match db::create_quiz(&conn, raw_title.trim()) {
+        Ok(id) => Reply::redirect(&format!("/moderate/quizzes/{id}")),
+        Err(_) => db_error(),
+    }
+}
+
+pub fn quiz_show(app: &App, quiz_id: i64) -> Reply {
+    let conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    let questions = db::list_questions(&conn, quiz_id, false).unwrap_or_default();
+    let (total, active) = db::quiz_counts(&conn, quiz_id).unwrap_or((0, 0));
+    Reply::html(200, views::quiz_page(&quiz, &questions, active, total))
+}
+
+pub fn quiz_edit(app: &App, quiz_id: i64) -> Reply {
+    let conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    let delete_action = format!("/moderate/quizzes/{quiz_id}/delete");
+    Reply::html(
+        200,
+        views::quiz_form(
+            "Quiz settings",
+            &format!("/moderate/quizzes/{quiz_id}"),
+            &quiz.title,
+            &format!("/moderate/quizzes/{quiz_id}"),
+            "Back to quiz",
+            None,
+            Some(&delete_action),
+        ),
+    )
+}
+
+pub fn quiz_update(app: &App, quiz_id: i64, params: &HashMap<String, String>) -> Reply {
+    let raw_title = params.get("title").cloned().unwrap_or_default();
+    let conn = lock(app);
+    if db::get_quiz(&conn, quiz_id).ok().flatten().is_none() {
+        return not_found();
+    }
+    if raw_title.trim().is_empty() {
+        let delete_action = format!("/moderate/quizzes/{quiz_id}/delete");
+        return Reply::html(
+            200,
+            views::quiz_form(
+                "Quiz settings",
+                &format!("/moderate/quizzes/{quiz_id}"),
+                &raw_title,
+                &format!("/moderate/quizzes/{quiz_id}"),
+                "Back to quiz",
+                Some("Title is required"),
+                Some(&delete_action),
+            ),
+        );
+    }
+    match db::rename_quiz(&conn, quiz_id, raw_title.trim()) {
+        Ok(()) => Reply::redirect(&format!("/moderate/quizzes/{quiz_id}")),
+        Err(_) => db_error(),
+    }
+}
+
+pub fn quiz_delete(app: &App, quiz_id: i64) -> Reply {
+    let conn = lock(app);
+    match db::delete_quiz(&conn, quiz_id) {
+        Ok(()) => Reply::redirect("/moderate"),
+        Err(_) => db_error(),
+    }
+}
+
+// ------------------------------------------------------------- Questions
+
+pub fn question_new(app: &App, quiz_id: i64) -> Reply {
+    let conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    let rows: Vec<OptionRow> = (0..4)
+        .map(|_| OptionRow {
+            text: String::new(),
+            correct: false,
+        })
+        .collect();
+    Reply::html(
+        200,
+        views::question_form(
+            "New question",
+            &format!("/moderate/quizzes/{quiz_id}/questions"),
+            &format!("/moderate/quizzes/{quiz_id}"),
+            &quiz.title,
+            "",
+            &rows,
+            true,
+            &[],
+        ),
+    )
+}
+
+pub fn question_create(app: &App, quiz_id: i64, params: &HashMap<String, String>) -> Reply {
+    let (body, active, rows) = parse_question_form(params);
+    let errors = validate_question(&body, &rows);
+    let mut conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    if !errors.is_empty() {
+        return Reply::html(
+            200,
+            views::question_form(
+                "New question",
+                &format!("/moderate/quizzes/{quiz_id}/questions"),
+                &format!("/moderate/quizzes/{quiz_id}"),
+                &quiz.title,
+                &body,
+                &rows,
+                active,
+                &errors,
+            ),
+        );
+    }
+    let options = clean_options(&rows);
+    match db::insert_question(&mut conn, quiz_id, body.trim(), active, &options) {
+        Ok(_) => Reply::redirect(&format!("/moderate/quizzes/{quiz_id}")),
+        Err(_) => db_error(),
+    }
+}
+
+pub fn question_edit(app: &App, quiz_id: i64, question_id: i64) -> Reply {
+    let conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    let Some(question) = db::get_question(&conn, quiz_id, question_id).ok().flatten() else {
+        return not_found();
+    };
+    let rows: Vec<OptionRow> = if question.options.is_empty() {
+        (0..4)
+            .map(|_| OptionRow {
+                text: String::new(),
+                correct: false,
+            })
+            .collect()
+    } else {
+        question
+            .options
+            .iter()
+            .map(|option| OptionRow {
+                text: option.text.clone(),
+                correct: option.is_correct,
+            })
+            .collect()
+    };
+    Reply::html(
+        200,
+        views::question_form(
+            "Edit question",
+            &format!("/moderate/quizzes/{quiz_id}/questions/{question_id}"),
+            &format!("/moderate/quizzes/{quiz_id}"),
+            &quiz.title,
+            &question.text,
+            &rows,
+            question.active,
+            &[],
+        ),
+    )
+}
+
+pub fn question_update(
+    app: &App,
+    quiz_id: i64,
+    question_id: i64,
+    params: &HashMap<String, String>,
+) -> Reply {
+    let (body, active, rows) = parse_question_form(params);
+    let errors = validate_question(&body, &rows);
+    let mut conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    if db::get_question(&conn, quiz_id, question_id)
+        .ok()
+        .flatten()
+        .is_none()
+    {
+        return not_found();
+    }
+    if !errors.is_empty() {
+        return Reply::html(
+            200,
+            views::question_form(
+                "Edit question",
+                &format!("/moderate/quizzes/{quiz_id}/questions/{question_id}"),
+                &format!("/moderate/quizzes/{quiz_id}"),
+                &quiz.title,
+                &body,
+                &rows,
+                active,
+                &errors,
+            ),
+        );
+    }
+    let options = clean_options(&rows);
+    match db::update_question(
+        &mut conn,
+        quiz_id,
+        question_id,
+        body.trim(),
+        active,
+        &options,
+    ) {
+        Ok(()) => Reply::redirect(&format!("/moderate/quizzes/{quiz_id}")),
+        Err(_) => db_error(),
+    }
+}
+
+pub fn question_delete(app: &App, quiz_id: i64, question_id: i64) -> Reply {
+    let conn = lock(app);
+    match db::delete_question(&conn, quiz_id, question_id) {
+        Ok(()) => Reply::redirect(&format!("/moderate/quizzes/{quiz_id}")),
+        Err(_) => db_error(),
+    }
+}
+
+pub fn question_move(
+    app: &App,
+    quiz_id: i64,
+    question_id: i64,
+    params: &HashMap<String, String>,
+) -> Reply {
+    let up = params
+        .get("direction")
+        .map(|value| value == "up")
+        .unwrap_or(false);
+    let mut conn = lock(app);
+    if db::get_question(&conn, quiz_id, question_id)
+        .ok()
+        .flatten()
+        .is_none()
+    {
+        return not_found();
+    }
+    match db::move_question(&mut conn, quiz_id, question_id, up) {
+        Ok(()) => Reply::redirect(&format!(
+            "/moderate/quizzes/{quiz_id}#question-{question_id}"
+        )),
+        Err(_) => db_error(),
+    }
+}
+
+pub fn question_active(
+    app: &App,
+    quiz_id: i64,
+    question_id: i64,
+    params: &HashMap<String, String>,
+) -> Reply {
+    let active = params.contains_key("active");
+    let conn = lock(app);
+    if db::get_question(&conn, quiz_id, question_id)
+        .ok()
+        .flatten()
+        .is_none()
+    {
+        return not_found();
+    }
+    match db::set_question_active(&conn, quiz_id, question_id, active) {
+        Ok(()) => Reply::redirect(&format!(
+            "/moderate/quizzes/{quiz_id}#question-{question_id}"
+        )),
+        Err(_) => db_error(),
+    }
+}
+
+// --------------------------------------------------------------- Preview
+
+pub fn preview(app: &App, quiz_id: i64) -> Reply {
+    let conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    let questions = db::list_questions(&conn, quiz_id, true).unwrap_or_default();
+    if questions.is_empty() {
+        Reply::html(200, views::preview_empty(&quiz))
+    } else {
+        Reply::html(200, views::preview_question(&quiz, 0, &questions, ""))
+    }
+}
+
+pub fn preview_answer(app: &App, quiz_id: i64, params: &HashMap<String, String>) -> Reply {
+    let conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    let questions = db::list_questions(&conn, quiz_id, true).unwrap_or_default();
+    if questions.is_empty() {
+        return Reply::redirect(&format!("/moderate/quizzes/{quiz_id}/preview"));
+    }
+    let index: usize = params
+        .get("qi")
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(0);
+    let option: usize = match params.get("option").and_then(|value| value.parse().ok()) {
+        Some(value) => value,
+        None => return Reply::redirect(&format!("/moderate/quizzes/{quiz_id}/preview")),
+    };
+    if index >= questions.len() || option >= questions[index].options.len() {
+        return Reply::redirect(&format!("/moderate/quizzes/{quiz_id}/preview"));
+    }
+    let prior = params.get("answers").cloned().unwrap_or_default();
+    let answers = append_answer(&prior, option);
+    Reply::html(
+        200,
+        views::preview_feedback(&quiz, index, &questions, option, &answers),
+    )
+}
+
+pub fn preview_next(app: &App, quiz_id: i64, params: &HashMap<String, String>) -> Reply {
+    let conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    let questions = db::list_questions(&conn, quiz_id, true).unwrap_or_default();
+    if questions.is_empty() {
+        return Reply::redirect(&format!("/moderate/quizzes/{quiz_id}/preview"));
+    }
+    let index: usize = params
+        .get("qi")
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(0);
+    let answers = params.get("answers").cloned().unwrap_or_default();
+    let next = index + 1;
+    if next >= questions.len() {
+        let score = count_score(&questions, &answers);
+        Reply::html(200, views::preview_score(&quiz, score, questions.len()))
+    } else {
+        Reply::html(
+            200,
+            views::preview_question(&quiz, next, &questions, &answers),
+        )
+    }
+}
+
+pub fn preview_score(app: &App, quiz_id: i64, params: &HashMap<String, String>) -> Reply {
+    let conn = lock(app);
+    let Some(quiz) = db::get_quiz(&conn, quiz_id).ok().flatten() else {
+        return not_found();
+    };
+    let questions = db::list_questions(&conn, quiz_id, true).unwrap_or_default();
+    let answers = params.get("answers").cloned().unwrap_or_default();
+    let score = count_score(&questions, &answers);
+    Reply::html(200, views::preview_score(&quiz, score, questions.len()))
+}
diff --git a/src/main.rs b/src/main.rs
