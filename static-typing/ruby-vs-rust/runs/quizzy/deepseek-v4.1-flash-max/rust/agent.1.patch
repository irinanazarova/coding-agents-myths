+use rusqlite::{Connection, OptionalExtension, params};
+
+#[derive(Clone, Debug)]
+pub struct Quiz {
+    pub id: i64,
+    pub title: String,
+}
+
+#[derive(Clone, Debug)]
+pub struct OptionItem {
+    pub text: String,
+    pub is_correct: bool,
+}
+
+#[derive(Clone, Debug)]
+pub struct Question {
+    pub id: i64,
+    pub text: String,
+    pub active: bool,
+    pub options: Vec<OptionItem>,
+}
+
+pub fn init(path: &str) -> rusqlite::Result<Connection> {
+    if let Some(parent) = std::path::Path::new(path).parent() {
+        if !parent.as_os_str().is_empty() {
+            let _ = std::fs::create_dir_all(parent);
+        }
+    }
+    let conn = Connection::open(path)?;
+    conn.execute_batch(
+        "PRAGMA foreign_keys = ON;
+         PRAGMA busy_timeout = 5000;
+         CREATE TABLE IF NOT EXISTS quizzes (
+             id         INTEGER PRIMARY KEY AUTOINCREMENT,
+             title      TEXT    NOT NULL,
+             created_at TEXT    NOT NULL DEFAULT (datetime('now'))
+         );
+         CREATE TABLE IF NOT EXISTS questions (
+             id         INTEGER PRIMARY KEY AUTOINCREMENT,
+             quiz_id    INTEGER NOT NULL REFERENCES quizzes(id) ON DELETE CASCADE,
+             body       TEXT    NOT NULL,
+             is_active  INTEGER NOT NULL DEFAULT 1,
+             position   INTEGER NOT NULL,
+             created_at TEXT    NOT NULL DEFAULT (datetime('now'))
+         );
+         CREATE INDEX IF NOT EXISTS idx_questions_quiz ON questions(quiz_id, position);
+         CREATE TABLE IF NOT EXISTS options (
+             id          INTEGER PRIMARY KEY AUTOINCREMENT,
+             question_id INTEGER NOT NULL REFERENCES questions(id) ON DELETE CASCADE,
+             body        TEXT    NOT NULL,
+             is_correct  INTEGER NOT NULL DEFAULT 0,
+             position    INTEGER NOT NULL
+         );
+         CREATE INDEX IF NOT EXISTS idx_options_question ON options(question_id, position);",
+    )?;
+    let _ = conn.execute_batch("PRAGMA journal_mode = WAL;");
+    Ok(conn)
+}
+
+pub fn list_quizzes(conn: &Connection) -> rusqlite::Result<Vec<Quiz>> {
+    let mut stmt = conn.prepare("SELECT id, title FROM quizzes ORDER BY id DESC")?;
+    let rows = stmt.query_map([], |r| {
+        Ok(Quiz {
+            id: r.get(0)?,
+            title: r.get(1)?,
+        })
+    })?;
+    rows.collect()
+}
+
+pub fn get_quiz(conn: &Connection, id: i64) -> rusqlite::Result<Option<Quiz>> {
+    conn.query_row(
+        "SELECT id, title FROM quizzes WHERE id = ?1",
+        params![id],
+        |r| {
+            Ok(Quiz {
+                id: r.get(0)?,
+                title: r.get(1)?,
+            })
+        },
+    )
+    .optional()
+}
+
+pub fn create_quiz(conn: &Connection, title: &str) -> rusqlite::Result<i64> {
+    conn.execute("INSERT INTO quizzes (title) VALUES (?1)", params![title])?;
+    Ok(conn.last_insert_rowid())
+}
+
+pub fn rename_quiz(conn: &Connection, id: i64, title: &str) -> rusqlite::Result<()> {
+    conn.execute(
+        "UPDATE quizzes SET title = ?1 WHERE id = ?2",
+        params![title, id],
+    )?;
+    Ok(())
+}
+
+pub fn delete_quiz(conn: &Connection, id: i64) -> rusqlite::Result<()> {
+    conn.execute("DELETE FROM quizzes WHERE id = ?1", params![id])?;
+    Ok(())
+}
+
+/// Returns (total_questions, active_questions).
+pub fn quiz_counts(conn: &Connection, quiz_id: i64) -> rusqlite::Result<(usize, usize)> {
+    let total: i64 = conn.query_row(
+        "SELECT COUNT(*) FROM questions WHERE quiz_id = ?1",
+        params![quiz_id],
+        |r| r.get(0),
+    )?;
+    let active: i64 = conn.query_row(
+        "SELECT COUNT(*) FROM questions WHERE quiz_id = ?1 AND is_active = 1",
+        params![quiz_id],
+        |r| r.get(0),
+    )?;
+    Ok((total as usize, active as usize))
+}
+
+fn load_options(conn: &Connection, question_id: i64) -> rusqlite::Result<Vec<OptionItem>> {
+    let mut stmt = conn.prepare(
+        "SELECT body, is_correct FROM options WHERE question_id = ?1 ORDER BY position, id",
+    )?;
+    let rows = stmt.query_map(params![question_id], |r| {
+        Ok(OptionItem {
+            text: r.get(0)?,
+            is_correct: r.get::<_, i64>(1)? != 0,
+        })
+    })?;
+    rows.collect()
+}
+
+pub fn list_questions(
+    conn: &Connection,
+    quiz_id: i64,
+    only_active: bool,
+) -> rusqlite::Result<Vec<Question>> {
+    let sql = if only_active {
+        "SELECT id, body, is_active FROM questions WHERE quiz_id = ?1 AND is_active = 1 ORDER BY position, id"
+    } else {
+        "SELECT id, body, is_active FROM questions WHERE quiz_id = ?1 ORDER BY position, id"
+    };
+    let mut stmt = conn.prepare(sql)?;
+    let base: Vec<(i64, String, bool)> = stmt
+        .query_map(params![quiz_id], |r| {
+            Ok((
+                r.get::<_, i64>(0)?,
+                r.get::<_, String>(1)?,
+                r.get::<_, i64>(2)? != 0,
+            ))
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    let mut out = Vec::with_capacity(base.len());
+    for (id, text, active) in base {
+        out.push(Question {
+            id,
+            text,
+            active,
+            options: load_options(conn, id)?,
+        });
+    }
+    Ok(out)
+}
+
+pub fn get_question(
+    conn: &Connection,
+    quiz_id: i64,
+    question_id: i64,
+) -> rusqlite::Result<Option<Question>> {
+    let base: Option<(i64, String, bool)> = conn
+        .query_row(
+            "SELECT id, body, is_active FROM questions WHERE id = ?1 AND quiz_id = ?2",
+            params![question_id, quiz_id],
+            |r| {
+                Ok((
+                    r.get::<_, i64>(0)?,
+                    r.get::<_, String>(1)?,
+                    r.get::<_, i64>(2)? != 0,
+                ))
+            },
+        )
+        .optional()?;
+    match base {
+        Some((id, text, active)) => Ok(Some(Question {
+            id,
+            text,
+            active,
+            options: load_options(conn, id)?,
+        })),
+        None => Ok(None),
+    }
+}
+
+pub fn insert_question(
+    conn: &mut Connection,
+    quiz_id: i64,
+    body: &str,
+    active: bool,
+    options: &[(String, bool)],
+) -> rusqlite::Result<i64> {
+    let tx = conn.transaction()?;
+    let position: i64 = tx.query_row(
+        "SELECT COALESCE(MAX(position), -1) + 1 FROM questions WHERE quiz_id = ?1",
+        params![quiz_id],
+        |r| r.get(0),
+    )?;
+    tx.execute(
+        "INSERT INTO questions (quiz_id, body, is_active, position) VALUES (?1, ?2, ?3, ?4)",
+        params![quiz_id, body, if active { 1 } else { 0 }, position],
+    )?;
+    let question_id = tx.last_insert_rowid();
+    for (index, (text, correct)) in options.iter().enumerate() {
+        tx.execute(
+            "INSERT INTO options (question_id, body, is_correct, position) VALUES (?1, ?2, ?3, ?4)",
+            params![
+                question_id,
+                text,
+                if *correct { 1 } else { 0 },
+                index as i64
+            ],
+        )?;
+    }
+    tx.commit()?;
+    Ok(question_id)
+}
+
+pub fn update_question(
+    conn: &mut Connection,
+    quiz_id: i64,
+    question_id: i64,
+    body: &str,
+    active: bool,
+    options: &[(String, bool)],
+) -> rusqlite::Result<()> {
+    let tx = conn.transaction()?;
+    tx.execute(
+        "UPDATE questions SET body = ?1, is_active = ?2 WHERE id = ?3 AND quiz_id = ?4",
+        params![body, if active { 1 } else { 0 }, question_id, quiz_id],
+    )?;
+    tx.execute(
+        "DELETE FROM options WHERE question_id = ?1",
+        params![question_id],
+    )?;
+    for (index, (text, correct)) in options.iter().enumerate() {
+        tx.execute(
+            "INSERT INTO options (question_id, body, is_correct, position) VALUES (?1, ?2, ?3, ?4)",
+            params![
+                question_id,
+                text,
+                if *correct { 1 } else { 0 },
+                index as i64
+            ],
+        )?;
+    }
+    tx.commit()?;
+    Ok(())
+}
+
+pub fn delete_question(conn: &Connection, quiz_id: i64, question_id: i64) -> rusqlite::Result<()> {
+    conn.execute(
+        "DELETE FROM questions WHERE id = ?1 AND quiz_id = ?2",
+        params![question_id, quiz_id],
+    )?;
+    Ok(())
+}
+
+pub fn set_question_active(
+    conn: &Connection,
+    quiz_id: i64,
+    question_id: i64,
+    active: bool,
+) -> rusqlite::Result<()> {
+    conn.execute(
+        "UPDATE questions SET is_active = ?1 WHERE id = ?2 AND quiz_id = ?3",
+        params![if active { 1 } else { 0 }, question_id, quiz_id],
+    )?;
+    Ok(())
+}
+
+pub fn move_question(
+    conn: &mut Connection,
+    quiz_id: i64,
+    question_id: i64,
+    up: bool,
+) -> rusqlite::Result<()> {
+    let ids: Vec<i64> = {
+        let mut stmt =
+            conn.prepare("SELECT id FROM questions WHERE quiz_id = ?1 ORDER BY position, id")?;
+        let rows = stmt.query_map(params![quiz_id], |r| r.get::<_, i64>(0))?;
+        rows.collect::<rusqlite::Result<Vec<_>>>()?
+    };
+    let Some(pos) = ids.iter().position(|id| *id == question_id) else {
+        return Ok(());
+    };
+    let other = if up {
+        pos.checked_sub(1)
+    } else if pos + 1 < ids.len() {
+        Some(pos + 1)
+    } else {
+        None
+    };
+    if let Some(other_pos) = other {
+        let tx = conn.transaction()?;
+        tx.execute(
+            "UPDATE questions SET position = ?1 WHERE id = ?2",
+            params![other_pos as i64, ids[pos]],
+        )?;
+        tx.execute(
+            "UPDATE questions SET position = ?1 WHERE id = ?2",
+            params![pos as i64, ids[other_pos]],
+        )?;
+        tx.commit()?;
+    }
+    Ok(())
+}
