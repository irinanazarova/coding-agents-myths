@@ -0,0 +1,426 @@
+use crate::db::{Question, Quiz};
+
+pub struct OptionRow {
+    pub text: String,
+    pub correct: bool,
+}
+
+pub fn e(input: &str) -> String {
+    let mut out = String::with_capacity(input.len());
+    for ch in input.chars() {
+        match ch {
+            '&' => out.push_str("&amp;"),
+            '<' => out.push_str("&lt;"),
+            '>' => out.push_str("&gt;"),
+            '"' => out.push_str("&quot;"),
+            '\'' => out.push_str("&#39;"),
+            _ => out.push(ch),
+        }
+    }
+    out
+}
+
+fn layout(title: &str, body: &str) -> String {
+    format!(
+        "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>{title} · Quizzy</title>\n<link rel=\"stylesheet\" href=\"/static/quizzy.css\">\n</head>\n<body>\n{body}\n</body>\n</html>",
+        title = e(title),
+        body = body
+    )
+}
+
+fn admin_header() -> &'static str {
+    "<header class=\"admin-header\"><a class=\"logo admin-header__logo\" href=\"/moderate\"><span class=\"logo__mark\">?</span>Quizzy</a><span class=\"admin-header__tag\">Moderator</span></header>"
+}
+
+fn option_letter(index: usize) -> String {
+    if index < 26 {
+        ((b'A' + index as u8) as char).to_string()
+    } else {
+        (index + 1).to_string()
+    }
+}
+
+fn error_box(errors: &[String]) -> String {
+    if errors.is_empty() {
+        return String::new();
+    }
+    if errors.len() == 1 {
+        format!("<div class=\"errors\">{}</div>", e(&errors[0]))
+    } else {
+        let items: String = errors
+            .iter()
+            .map(|m| format!("<li>{}</li>", e(m)))
+            .collect();
+        format!("<div class=\"errors\"><ul>{items}</ul></div>")
+    }
+}
+
+pub fn page_not_found() -> String {
+    layout(
+        "Not found",
+        &format!(
+            "{header}<main class=\"admin-main\"><div class=\"page-head\"><h1>Not found</h1></div><div class=\"card\"><p>The page you are looking for does not exist.</p><a class=\"btn\" href=\"/moderate\">All quizzes</a></div></main>",
+            header = admin_header()
+        ),
+    )
+}
+
+// ---------------------------------------------------------------- Quiz list
+
+pub fn moderate_index(quizzes: &[(Quiz, usize, usize)]) -> String {
+    let mut cards = String::new();
+    for (quiz, total, active) in quizzes {
+        let noun = if *total == 1 { "question" } else { "questions" };
+        cards.push_str(&format!(
+            "<li class=\"card quiz-tile\"><a href=\"/moderate/quizzes/{id}\"><h3>{title}</h3></a><div class=\"meta\">{total} {noun} · {active} active</div></li>",
+            id = quiz.id,
+            title = e(&quiz.title),
+            total = total,
+            noun = noun,
+            active = active
+        ));
+    }
+    let list = if quizzes.is_empty() {
+        "<div class=\"empty\">No quizzes yet. Create your first quiz!</div>".to_string()
+    } else {
+        format!("<ul class=\"quiz-list\">{cards}</ul>")
+    };
+    layout(
+        "Quizzes",
+        &format!(
+            "{header}<main class=\"admin-main\"><div class=\"page-head\"><h1>Quizzes</h1><div class=\"buttons\"><a class=\"btn btn--pink\" role=\"button\" href=\"/moderate/quizzes/new\">New quiz</a></div></div>{list}</main>",
+            header = admin_header(),
+            list = list
+        ),
+    )
+}
+
+// ---------------------------------------------------------------- Quiz form
+
+pub fn quiz_form(
+    heading: &str,
+    action: &str,
+    title: &str,
+    back_href: &str,
+    back_label: &str,
+    error: Option<&str>,
+    delete_action: Option<&str>,
+) -> String {
+    let error_html = error
+        .map(|m| format!("<div class=\"errors\">{}</div>", e(m)))
+        .unwrap_or_default();
+    let delete_html = delete_action
+        .map(|target| {
+            format!(
+                "<form class=\"mt-2\" method=\"post\" action=\"{target}\" onsubmit=\"return confirm('Delete this quiz?')\"><button class=\"btn btn--danger\" type=\"submit\">Delete quiz</button></form>",
+                target = e(target)
+            )
+        })
+        .unwrap_or_default();
+    let card = format!(
+        "<div class=\"card\">{error_html}<form method=\"post\" action=\"{action}\"><div class=\"field\"><label for=\"quiz-title\">Title</label><input class=\"input\" id=\"quiz-title\" name=\"title\" type=\"text\" value=\"{title}\" required></div><div class=\"buttons\"><button class=\"btn btn--pink\" type=\"submit\">Save quiz</button><a class=\"btn btn--ghost\" href=\"{back_href}\">Cancel</a></div></form>{delete_html}</div>",
+        error_html = error_html,
+        action = e(action),
+        title = e(title),
+        back_href = e(back_href),
+        delete_html = delete_html
+    );
+    layout(
+        heading,
+        &format!(
+            "{header}<main class=\"admin-main\"><div class=\"breadcrumbs\"><a href=\"{back_href}\">← {back_label}</a></div><div class=\"page-head\"><h1>{heading}</h1></div>{card}</main>",
+            header = admin_header(),
+            back_href = e(back_href),
+            back_label = e(back_label),
+            heading = e(heading),
+            card = card
+        ),
+    )
+}
+
+// ---------------------------------------------------------------- Quiz page
+
+pub fn quiz_page(
+    quiz: &Quiz,
+    questions: &[Question],
+    active_count: usize,
+    total_count: usize,
+) -> String {
+    let mut items = String::new();
+    for (index, question) in questions.iter().enumerate() {
+        let number = index + 1;
+        let inactive_class = if question.active {
+            ""
+        } else {
+            " question-item--inactive"
+        };
+        let checked = if question.active { " checked" } else { "" };
+        let mut options = String::new();
+        for (option_index, option) in question.options.iter().enumerate() {
+            let class = if option.is_correct {
+                " class=\"is-correct\""
+            } else {
+                ""
+            };
+            options.push_str(&format!(
+                "<li{class}>{letter}. {text}</li>",
+                class = class,
+                letter = option_letter(option_index),
+                text = e(&option.text)
+            ));
+        }
+        items.push_str(&format!(
+            "<li class=\"card question-item{inactive_class}\" id=\"question-{qid}\"><div class=\"question-item__num\">{number}</div><div><div class=\"question-item__body\">{body}</div><ul class=\"question-item__options\">{options}</ul></div><div class=\"question-item__actions\"><div class=\"buttons\"><form class=\"inline-form\" method=\"post\" action=\"/moderate/quizzes/{quiz_id}/questions/{qid}/move\"><input type=\"hidden\" name=\"direction\" value=\"up\"><button class=\"btn btn--ghost btn--sm\" type=\"submit\">Move up</button></form><form class=\"inline-form\" method=\"post\" action=\"/moderate/quizzes/{quiz_id}/questions/{qid}/move\"><input type=\"hidden\" name=\"direction\" value=\"down\"><button class=\"btn btn--ghost btn--sm\" type=\"submit\">Move down</button></form></div><form class=\"inline-form\" method=\"post\" action=\"/moderate/quizzes/{quiz_id}/questions/{qid}/active\"><label class=\"checkbox\"><input type=\"checkbox\" name=\"active\" value=\"1\"{checked} onchange=\"this.form.submit()\"> Active</label></form><div class=\"buttons\"><a class=\"btn btn--sm\" href=\"/moderate/quizzes/{quiz_id}/questions/{qid}/edit\">Edit</a><form class=\"inline-form\" method=\"post\" action=\"/moderate/quizzes/{quiz_id}/questions/{qid}/delete\" onsubmit=\"return confirm('Delete this question?')\"><button class=\"btn btn--sm btn--danger\" type=\"submit\">Delete</button></form></div></div></li>",
+            inactive_class = inactive_class,
+            qid = question.id,
+            number = number,
+            body = e(&question.text),
+            options = options,
+            quiz_id = quiz.id,
+            checked = checked
+        ));
+    }
+    let questions_html = if questions.is_empty() {
+        "<div class=\"empty\">No questions yet. Add the first one!</div>".to_string()
+    } else {
+        format!("<ul class=\"question-list\">{items}</ul>")
+    };
+    let meta = format!(
+        "{active} of {total} questions active · <a href=\"/moderate/quizzes/{id}/edit\">Settings</a>",
+        active = active_count,
+        total = total_count,
+        id = quiz.id
+    );
+    layout(
+        &quiz.title,
+        &format!(
+            "{header}<main class=\"admin-main\"><div class=\"breadcrumbs\"><a href=\"/moderate\">← All quizzes</a></div><div class=\"page-head\"><div><h1>{title}</h1><div class=\"meta mt-2\">{meta}</div></div><div class=\"buttons\"><a class=\"btn btn--ghost\" href=\"/moderate/quizzes/{id}/preview\">Preview</a></div></div><section class=\"section mt-0\"><div class=\"section-head\"><h2>Questions</h2><a class=\"btn\" role=\"button\" href=\"/moderate/quizzes/{id}/questions/new\">Add question</a></div>{questions_html}</section></main>",
+            header = admin_header(),
+            title = e(&quiz.title),
+            meta = meta,
+            id = quiz.id,
+            questions_html = questions_html
+        ),
+    )
+}
+
+// ---------------------------------------------------------- Question form
+
+const QUESTION_FORM_SCRIPT: &str = r#"<script>
+(function () {
+  var container = document.getElementById('option-rows');
+  if (!container) return;
+  function renumber() {
+    var items = container.querySelectorAll('.option-row');
+    for (var i = 0; i < items.length; i++) {
+      var n = i + 1;
+      var row = items[i];
+      var label = row.querySelector('.option-label');
+      var input = row.querySelector('.option-input');
+      var check = row.querySelector('.option-correct');
+      var checkLabel = row.querySelector('.option-check-label');
+      var checkText = row.querySelector('.option-check-text');
+      var remove = row.querySelector('.option-remove');
+      if (label) { label.textContent = 'Option ' + n; label.setAttribute('for', 'option_' + n); }
+      if (input) { input.id = 'option_' + n; input.name = 'option_' + n; }
+      if (check) { check.id = 'correct_' + n; check.name = 'correct_' + n; }
+      if (checkLabel) checkLabel.setAttribute('for', 'correct_' + n);
+      if (checkText) checkText.textContent = 'Option ' + n + ' is correct';
+      if (remove) remove.setAttribute('aria-label', 'Remove option ' + n);
+    }
+  }
+  window.removeOption = function (button) {
+    var row = button.closest('.option-row');
+    if (row) row.parentNode.removeChild(row);
+    renumber();
+  };
+  document.getElementById('add-option').addEventListener('click', function () {
+    var n = container.querySelectorAll('.option-row').length + 1;
+    var row = document.createElement('div');
+    row.className = 'option-row';
+    row.innerHTML = '<div class="field option-field"><label class="option-label" for="option_' + n + '">Option ' + n + '</label><input class="input option-input" type="text" id="option_' + n + '" name="option_' + n + '" placeholder="Option text"></div>' +
+      '<label class="checkbox option-check-label" for="correct_' + n + '"><input class="option-correct" type="checkbox" id="correct_' + n + '" name="correct_' + n + '" value="1"> <span class="option-check-text">Option ' + n + ' is correct</span></label>' +
+      '<button class="btn btn--danger btn--icon option-remove" type="button" aria-label="Remove option ' + n + '" onclick="removeOption(this)">✕</button>';
+    container.appendChild(row);
+    var input = row.querySelector('.option-input');
+    if (input) input.focus();
+  });
+})();
+</script>"#;
+
+pub fn question_form(
+    heading: &str,
+    action: &str,
+    back_href: &str,
+    back_label: &str,
+    question_text: &str,
+    rows: &[OptionRow],
+    active: bool,
+    errors: &[String],
+) -> String {
+    let mut rows_html = String::new();
+    for (index, row) in rows.iter().enumerate() {
+        let n = index + 1;
+        let checked = if row.correct { " checked" } else { "" };
+        rows_html.push_str(&format!(
+            "<div class=\"option-row\"><div class=\"field option-field\"><label class=\"option-label\" for=\"option_{n}\">Option {n}</label><input class=\"input option-input\" type=\"text\" id=\"option_{n}\" name=\"option_{n}\" value=\"{value}\" placeholder=\"Option text\"></div><label class=\"checkbox option-check-label\" for=\"correct_{n}\"><input class=\"option-correct\" type=\"checkbox\" id=\"correct_{n}\" name=\"correct_{n}\" value=\"1\"{checked}> <span class=\"option-check-text\">Option {n} is correct</span></label><button class=\"btn btn--danger btn--icon option-remove\" type=\"button\" aria-label=\"Remove option {n}\" onclick=\"removeOption(this)\">✕</button></div>",
+            n = n,
+            value = e(&row.text),
+            checked = checked
+        ));
+    }
+    let active_checked = if active { " checked" } else { "" };
+    let card = format!(
+        "<div class=\"card\">{errors}<form method=\"post\" action=\"{action}\"><div class=\"field\"><label for=\"question\">Question</label><textarea class=\"input\" id=\"question\" name=\"question\" rows=\"3\" required>{question_text}</textarea></div><div class=\"field\"><span class=\"field-label\">Options</span><span class=\"field-hint\">Mark the correct options, at least one. Empty rows are skipped.</span></div><div class=\"option-rows\" id=\"option-rows\">{rows_html}</div><div class=\"buttons\" style=\"margin-bottom:28px\"><button class=\"btn btn--ghost btn--sm\" type=\"button\" id=\"add-option\">Add option</button></div><div class=\"field\"><label class=\"checkbox\" for=\"question-active\"><input type=\"checkbox\" id=\"question-active\" name=\"active\" value=\"1\"{active_checked}> Active</label><span class=\"field-hint\">Only active questions are played.</span></div><div class=\"buttons\"><button class=\"btn btn--pink\" type=\"submit\">Save question</button><a class=\"btn btn--ghost\" href=\"{back_href}\">Cancel</a></div></form></div>",
+        errors = error_box(errors),
+        action = e(action),
+        question_text = e(question_text),
+        rows_html = rows_html,
+        active_checked = active_checked,
+        back_href = e(back_href)
+    );
+    layout(
+        heading,
+        &format!(
+            "{header}<main class=\"admin-main\"><div class=\"breadcrumbs\"><a href=\"{back_href}\">← {back_label}</a></div><div class=\"page-head\"><h1>{heading}</h1></div>{card}</main>{script}",
+            header = admin_header(),
+            back_href = e(back_href),
+            back_label = e(back_label),
+            heading = e(heading),
+            card = card,
+            script = QUESTION_FORM_SCRIPT
+        ),
+    )
+}
+
+// ---------------------------------------------------------------- Preview
+
+fn preview_shell(quiz: &Quiz, inner: &str, back_label: &str) -> String {
+    layout(
+        &format!("Preview · {}", quiz.title),
+        &format!(
+            "{header}<main class=\"admin-main preview-shell\"><div class=\"breadcrumbs\"><a href=\"/moderate/quizzes/{id}\">← {back_label}</a></div><div class=\"page-head\"><h1>{title}</h1></div>{inner}</main>",
+            header = admin_header(),
+            id = quiz.id,
+            back_label = e(back_label),
+            title = e(&quiz.title),
+            inner = inner
+        ),
+    )
+}
+
+pub fn preview_empty(quiz: &Quiz) -> String {
+    preview_shell(
+        quiz,
+        "<div class=\"card\"><div class=\"empty\">No active questions to preview.</div></div>",
+        "Back to quiz",
+    )
+}
+
+pub fn preview_question(
+    quiz: &Quiz,
+    index: usize,
+    questions: &[Question],
+    prior_answers: &str,
+) -> String {
+    let total = questions.len();
+    let question = &questions[index];
+    let mut buttons = String::new();
+    for (option_index, option) in question.options.iter().enumerate() {
+        buttons.push_str(&format!(
+            "<button class=\"play-option\" type=\"submit\" name=\"option\" value=\"{option_index}\" aria-label=\"{text}\"><span class=\"play-option__letter\">{letter}</span><span class=\"play-option__title\">{text}</span></button>",
+            option_index = option_index,
+            letter = option_letter(option_index),
+            text = e(&option.text)
+        ));
+    }
+    let inner = format!(
+        "<div class=\"card\"><div class=\"play-question__num\">Question {number} of {total}</div><div class=\"play-question__body\">{body}</div><form method=\"post\" action=\"/moderate/quizzes/{quiz_id}/preview/answer\"><input type=\"hidden\" name=\"qi\" value=\"{index}\"><input type=\"hidden\" name=\"answers\" value=\"{prior}\"><div class=\"play-options\">{buttons}</div></form></div>",
+        number = index + 1,
+        total = total,
+        body = e(&question.text),
+        quiz_id = quiz.id,
+        index = index,
+        prior = e(prior_answers),
+        buttons = buttons
+    );
+    preview_shell(quiz, &inner, "Back to quiz")
+}
+
+pub fn preview_feedback(
+    quiz: &Quiz,
+    index: usize,
+    questions: &[Question],
+    chosen: usize,
+    answers: &str,
+) -> String {
+    let total = questions.len();
+    let question = &questions[index];
+    let is_correct = question
+        .options
+        .get(chosen)
+        .map(|option| option.is_correct)
+        .unwrap_or(false);
+    let mut options = String::new();
+    for (option_index, option) in question.options.iter().enumerate() {
+        let mut classes = String::from("play-option");
+        if option_index == chosen {
+            classes.push_str(" is-picked");
+        }
+        if option.is_correct {
+            classes.push_str(" is-correct");
+        }
+        let mark = if option.is_correct {
+            "<span class=\"play-option__mark\">✓</span>"
+        } else {
+            ""
+        };
+        options.push_str(&format!(
+            "<button class=\"{classes}\" type=\"button\" disabled aria-label=\"{text}\"><span class=\"play-option__letter\">{letter}</span><span class=\"play-option__title\">{text}</span>{mark}</button>",
+            classes = classes,
+            letter = option_letter(option_index),
+            text = e(&option.text),
+            mark = mark
+        ));
+    }
+    let (status_class, status_text) = if is_correct {
+        ("play-status--right", "Correct!")
+    } else {
+        ("play-status--wrong", "Wrong!")
+    };
+    let nav = if index + 1 < total {
+        format!(
+            "<form method=\"post\" action=\"/moderate/quizzes/{quiz_id}/preview/next\"><input type=\"hidden\" name=\"qi\" value=\"{index}\"><input type=\"hidden\" name=\"answers\" value=\"{answers}\"><button class=\"btn btn--pink\" type=\"submit\">Next question</button></form>",
+            quiz_id = quiz.id,
+            index = index,
+            answers = e(answers)
+        )
+    } else {
+        format!(
+            "<form method=\"post\" action=\"/moderate/quizzes/{quiz_id}/preview/score\"><input type=\"hidden\" name=\"answers\" value=\"{answers}\"><button class=\"btn btn--pink\" type=\"submit\">See score</button></form>",
+            quiz_id = quiz.id,
+            answers = e(answers)
+        )
+    };
+    let inner = format!(
+        "<div class=\"card\"><div class=\"play-question__num\">Question {number} of {total}</div><div class=\"play-question__body\">{body}</div><div class=\"play-options is-locked is-revealed\">{options}</div><div class=\"play-status {status_class}\">{status_text}</div><div class=\"mt-2\">{nav}</div></div>",
+        number = index + 1,
+        total = total,
+        body = e(&question.text),
+        options = options,
+        status_class = status_class,
+        status_text = status_text,
+        nav = nav
+    );
+    preview_shell(quiz, &inner, "Back to quiz")
+}
+
+pub fn preview_score(quiz: &Quiz, score: usize, total: usize) -> String {
+    let inner = format!(
+        "<div class=\"card result-card\"><h2>Preview results</h2><div class=\"result-card__label\">You answered</div><div class=\"result-card__score\">Score: {score}/{total}</div><form class=\"mt-2\" method=\"get\" action=\"/moderate/quizzes/{quiz_id}/preview\"><button class=\"btn btn--pink\" type=\"submit\">Start over</button></form></div>",
+        score = score,
+        total = total,
+        quiz_id = quiz.id
+    );
+    preview_shell(quiz, &inner, "Back to quiz")
+}
