-fn main() {}
+mod db;
+mod handlers;
+mod views;
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use base64::Engine;
+use rusqlite::Connection;
+use tiny_http::{Header, Request, Response, Server, StatusCode};
+
+const CSS: &str = include_str!("../static/quizzy.css");
+const FONT: &[u8] = include_bytes!("../static/Inter-latin.woff2");
+
+pub struct App {
+    pub conn: Mutex<Connection>,
+    pub username: String,
+    pub password: String,
+}
+
+pub struct Reply {
+    pub status: u16,
+    pub content_type: String,
+    pub headers: Vec<(String, String)>,
+    pub body: Vec<u8>,
+}
+
+impl Reply {
+    pub fn html(status: u16, body: String) -> Reply {
+        Reply {
+            status,
+            content_type: "text/html; charset=utf-8".to_string(),
+            headers: Vec::new(),
+            body: body.into_bytes(),
+        }
+    }
+
+    pub fn plain(status: u16, body: &str) -> Reply {
+        Reply {
+            status,
+            content_type: "text/plain; charset=utf-8".to_string(),
+            headers: Vec::new(),
+            body: body.as_bytes().to_vec(),
+        }
+    }
+
+    pub fn redirect(location: &str) -> Reply {
+        Reply {
+            status: 303,
+            content_type: "text/plain; charset=utf-8".to_string(),
+            headers: vec![("Location".to_string(), location.to_string())],
+            body: Vec::new(),
+        }
+    }
+
+    pub fn unauthorized() -> Reply {
+        Reply {
+            status: 401,
+            content_type: "text/plain; charset=utf-8".to_string(),
+            headers: vec![(
+                "WWW-Authenticate".to_string(),
+                "Basic realm=\"Quizzy\"".to_string(),
+            )],
+            body: b"Unauthorized".to_vec(),
+        }
+    }
+
+    pub fn bytes(status: u16, content_type: &str, body: &[u8]) -> Reply {
+        Reply {
+            status,
+            content_type: content_type.to_string(),
+            headers: Vec::new(),
+            body: body.to_vec(),
+        }
+    }
+}
+
+fn parse_id(value: &str) -> Option<i64> {
+    value.parse::<i64>().ok().filter(|id| *id > 0)
+}
+
+fn not_found() -> Reply {
+    Reply::html(404, views::page_not_found())
+}
+
+fn auth_ok(request: &Request, app: &App) -> bool {
+    let Some(header) = request
+        .headers()
+        .iter()
+        .find(|header| header.field.equiv("Authorization"))
+    else {
+        return false;
+    };
+    let value = header.value.as_str();
+    let Some(prefix) = value.get(..6) else {
+        return false;
+    };
+    if !prefix.eq_ignore_ascii_case("basic ") {
+        return false;
+    }
+    let encoded = value[6..].trim();
+    let Ok(bytes) = base64::engine::general_purpose::STANDARD.decode(encoded) else {
+        return false;
+    };
+    let Ok(credentials) = String::from_utf8(bytes) else {
+        return false;
+    };
+    let Some((username, password)) = credentials.split_once(':') else {
+        return false;
+    };
+    username == app.username && password == app.password
+}
+
+fn dispatch(request: &mut Request, app: &App) -> Reply {
+    let raw_path = request.url().split('?').next().unwrap_or("/").to_string();
+    let method = request.method().as_str().to_string();
+
+    let needs_auth = raw_path == "/moderate" || raw_path.starts_with("/moderate/");
+    if needs_auth && !auth_ok(request, app) {
+        return Reply::unauthorized();
+    }
+
+    let mut params: HashMap<String, String> = HashMap::new();
+    if method == "POST" {
+        let mut body = String::new();
+        if request.as_reader().read_to_string(&mut body).is_ok() {
+            params = serde_urlencoded::from_str(&body).unwrap_or_default();
+        }
+    }
+
+    let segments: Vec<&str> = raw_path
+        .split('/')
+        .filter(|part| !part.is_empty())
+        .collect();
+    let segments = segments.as_slice();
+    match (method.as_str(), segments) {
+        ("GET", ["up"]) => Reply::plain(200, "OK"),
+        ("GET", []) => Reply::redirect("/moderate"),
+        ("GET", ["static", "quizzy.css"]) => {
+            Reply::bytes(200, "text/css; charset=utf-8", CSS.as_bytes())
+        }
+        ("GET", ["static", "Inter-latin.woff2"]) => Reply::bytes(200, "font/woff2", FONT),
+        ("GET", ["moderate"]) => handlers::index(app),
+        ("GET", ["moderate", "quizzes", "new"]) => handlers::quiz_new(),
+        ("POST", ["moderate", "quizzes"]) => handlers::quiz_create(app, &params),
+        ("GET", ["moderate", "quizzes", quiz_id]) => match parse_id(quiz_id) {
+            Some(id) => handlers::quiz_show(app, id),
+            None => not_found(),
+        },
+        ("POST", ["moderate", "quizzes", quiz_id]) => match parse_id(quiz_id) {
+            Some(id) => handlers::quiz_update(app, id, &params),
+            None => not_found(),
+        },
+        ("GET", ["moderate", "quizzes", quiz_id, "edit"]) => match parse_id(quiz_id) {
+            Some(id) => handlers::quiz_edit(app, id),
+            None => not_found(),
+        },
+        ("POST", ["moderate", "quizzes", quiz_id, "delete"]) => match parse_id(quiz_id) {
+            Some(id) => handlers::quiz_delete(app, id),
+            None => not_found(),
+        },
+        ("GET", ["moderate", "quizzes", quiz_id, "questions", "new"]) => match parse_id(quiz_id) {
+            Some(id) => handlers::question_new(app, id),
+            None => not_found(),
+        },
+        ("POST", ["moderate", "quizzes", quiz_id, "questions"]) => match parse_id(quiz_id) {
+            Some(id) => handlers::question_create(app, id, &params),
+            None => not_found(),
+        },
+        (
+            "GET",
+            [
+                "moderate",
+                "quizzes",
+                quiz_id,
+                "questions",
+                question_id,
+                "edit",
+            ],
+        ) => match (parse_id(quiz_id), parse_id(question_id)) {
+            (Some(quiz), Some(question)) => handlers::question_edit(app, quiz, question),
+            _ => not_found(),
+        },
+        ("POST", ["moderate", "quizzes", quiz_id, "questions", question_id]) => {
+            match (parse_id(quiz_id), parse_id(question_id)) {
+                (Some(quiz), Some(question)) => {
+                    handlers::question_update(app, quiz, question, &params)
+                }
+                _ => not_found(),
+            }
+        }
+        (
+            "POST",
+            [
+                "moderate",
+                "quizzes",
+                quiz_id,
+                "questions",
+                question_id,
+                "delete",
+            ],
+        ) => match (parse_id(quiz_id), parse_id(question_id)) {
+            (Some(quiz), Some(question)) => handlers::question_delete(app, quiz, question),
+            _ => not_found(),
+        },
+        (
+            "POST",
+            [
+                "moderate",
+                "quizzes",
+                quiz_id,
+                "questions",
+                question_id,
+                "move",
+            ],
+        ) => match (parse_id(quiz_id), parse_id(question_id)) {
+            (Some(quiz), Some(question)) => handlers::question_move(app, quiz, question, &params),
+            _ => not_found(),
+        },
+        (
+            "POST",
+            [
+                "moderate",
+                "quizzes",
+                quiz_id,
+                "questions",
+                question_id,
+                "active",
+            ],
+        ) => match (parse_id(quiz_id), parse_id(question_id)) {
+            (Some(quiz), Some(question)) => handlers::question_active(app, quiz, question, &params),
+            _ => not_found(),
+        },
+        ("GET", ["moderate", "quizzes", quiz_id, "preview"]) => match parse_id(quiz_id) {
+            Some(id) => handlers::preview(app, id),
+            None => not_found(),
+        },
+        ("POST", ["moderate", "quizzes", quiz_id, "preview", "answer"]) => {
+            match parse_id(quiz_id) {
+                Some(id) => handlers::preview_answer(app, id, &params),
+                None => not_found(),
+            }
+        }
+        ("POST", ["moderate", "quizzes", quiz_id, "preview", "next"]) => match parse_id(quiz_id) {
+            Some(id) => handlers::preview_next(app, id, &params),
+            None => not_found(),
+        },
+        ("POST", ["moderate", "quizzes", quiz_id, "preview", "score"]) => match parse_id(quiz_id) {
+            Some(id) => handlers::preview_score(app, id, &params),
+            None => not_found(),
+        },
+        _ => not_found(),
+    }
+}
+
+fn send(request: Request, reply: Reply) {
+    let mut response = Response::from_data(reply.body).with_status_code(StatusCode(reply.status));
+    if let Ok(header) = Header::from_bytes("Content-Type", reply.content_type.as_bytes()) {
+        response = response.with_header(header);
+    }
+    for (name, value) in reply.headers {
+        if let Ok(header) = Header::from_bytes(name.as_bytes(), value.as_bytes()) {
+            response = response.with_header(header);
+        }
+    }
+    let _ = request.respond(response);
+}
+
+fn main() {
+    let port: u16 = std::env::var("PORT")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(3000);
+    let storage = std::env::var("QUIZZY_STORAGE_DIR").unwrap_or_else(|_| "storage".to_string());
+    let storage = storage.trim_end_matches('/').to_string();
+    let db_path = format!("{storage}/quizzy.sqlite3");
+
+    let conn = match db::init(&db_path) {
+        Ok(conn) => conn,
+        Err(error) => {
+            eprintln!("Quizzy could not open its database at {db_path}: {error}");
+            std::process::exit(1);
+        }
+    };
+
+    let username = match std::env::var("QUIZZY_MODERATOR_USERNAME") {
+        Ok(value) => value,
+        Err(_) => {
+            eprintln!("QUIZZY_MODERATOR_USERNAME is not set; falling back to 'moderator'");
+            "moderator".to_string()
+        }
+    };
+    let password = match std::env::var("QUIZZY_MODERATOR_PASSWORD") {
+        Ok(value) => value,
+        Err(_) => {
+            eprintln!("QUIZZY_MODERATOR_PASSWORD is not set; falling back to 'moderator'");
+            "moderator".to_string()
+        }
+    };
+
+    let app = Arc::new(App {
+        conn: Mutex::new(conn),
+        username,
+        password,
+    });
+
+    let address = format!("0.0.0.0:{port}");
+    let server = match Server::http(&address) {
+        Ok(server) => server,
+        Err(error) => {
+            eprintln!("Quizzy could not listen on {address}: {error}");
+            std::process::exit(1);
+        }
+    };
+    eprintln!("Quizzy listening on http://{address} (storage: {db_path})");
+
+    for request in server.incoming_requests() {
+        let app = Arc::clone(&app);
+        std::thread::spawn(move || {
+            let mut request = request;
+            let reply = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                dispatch(&mut request, &app)
+            }))
+            .unwrap_or_else(|_| Reply::plain(500, "Internal Server Error"));
+            send(request, reply);
+        });
+    }
+}
diff --git a/src/views.rs b/src/views.rs
new file mode 100644
