+    {'text': '</pre><script>alert("x")</script>', 'active': True, 'options': [{'text': 'A', 'correct': True}, {'text': 'B', 'correct': True}, {'text': 'C', 'correct': False}]}
+]}
+created = []
+def import_quiz(value):
+    status, body, headers = post('/moderate/quizzes/import', {'quiz_json': json.dumps(value, ensure_ascii=False)})
+    assert status == 303, (status, body)
+    path = headers['Location']; created.append(path)
