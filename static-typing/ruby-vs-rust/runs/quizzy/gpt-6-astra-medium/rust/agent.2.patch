+#!/usr/bin/env python3
+"""Import/export HTTP regression. Run against bin/serve; stdlib only."""
+import base64, copy, html, json, os, re, urllib.request, urllib.error, urllib.parse
+BASE = os.environ.get('TEST_URL', 'http://127.0.0.1:3000')
+AUTH = 'Basic ' + base64.b64encode((os.environ.get('QUIZZY_MODERATOR_USERNAME', 'moderator') + ':' + os.environ.get('QUIZZY_MODERATOR_PASSWORD', 'test-password')).encode()).decode()
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args): return None
+opener = urllib.request.build_opener(NoRedirect)
+def request(path, data=None, auth=AUTH):
+    req = urllib.request.Request(BASE + path, data=None if data is None else urllib.parse.urlencode(data).encode(), headers={'Authorization': auth} if auth else {})
+    try: r = opener.open(req)
+    except urllib.error.HTTPError as e: r = e
+    with r: return r.status, r.read().decode(), r.headers
+
+def get(path):
+    status, body, _ = request(path)
+    assert status == 200, (path, status, body)
+    return body
+
+def post(path, data): return request(path, {'csrf': token, **data})
+def exported(path):
+    body = get(path + '/export')
+    pre = re.findall(r'<pre\b[^>]*>(.*?)</pre>', body, re.S)
+    assert len(pre) == 1
+    return json.loads(html.unescape(pre[0]))
+def quiz_links(): return re.findall(r'class="quiz-tile" href="([^"]+)"', get('/moderate'))
+
+assert 'Import quiz' in get('/moderate'), 'Missing Import quiz button'
+body = get('/moderate/quizzes/import')
+assert 'Quiz JSON' in body and '>Import</button>' in body
+token = html.unescape(re.search(r'name="csrf" value="([^"]+)"', body)[1])
+assert request('/moderate/quizzes/import', auth=None)[0] == 401
+assert request('/moderate/quizzes/import', {'quiz_json': '{}'})[0] == 403
