+#!/usr/bin/env python3
+"""Chromium UI regression, with a tiny stdlib-only DevTools client (no network installs)."""
+import base64, json, os, socket, struct, subprocess, time, urllib.request, urllib.parse, shutil
+from pathlib import Path
+
+BASE = os.environ.get('TEST_URL', 'http://127.0.0.1:3000')
+AUTH = 'Basic ' + base64.b64encode((os.environ.get('QUIZZY_MODERATOR_USERNAME', 'moderator') + ':' + os.environ.get('QUIZZY_MODERATOR_PASSWORD', 'test-password')).encode()).decode()
+ROOT = Path(__file__).resolve().parent.parent
+PROFILE = ROOT / 'storage' / 'browser-test-profile'
+
+class CDP:
+    def __init__(self, url):
+        u = urllib.parse.urlparse(url)
+        self.sock = socket.create_connection((u.hostname, u.port), timeout=10)
+        self.buf = b''
+        self.next_id = 0
+        self.events = []
+        self.dialog_accept = False
+        self.dialogs = []
+        key = base64.b64encode(os.urandom(16)).decode()
+        self.sock.sendall(f'GET {u.path} HTTP/1.1\r\nHost: {u.hostname}:{u.port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n'.encode())
+        while b'\r\n\r\n' not in self.buf: self.buf += self.sock.recv(4096)
+        header, self.buf = self.buf.split(b'\r\n\r\n', 1)
+        assert header.split(b' ')[1] == b'101', header
+    def read(self, n):
+        while len(self.buf) < n:
+            data = self.sock.recv(65536)
+            if not data: raise RuntimeError('Browser closed connection')
+            self.buf += data
+        data, self.buf = self.buf[:n], self.buf[n:]
+        return data
+    def send(self, method, params=None):
+        self.next_id += 1
+        payload = json.dumps({'id': self.next_id, 'method': method, 'params': params or {}}).encode()
+        n = len(payload)
+        head = bytes([0x81, 0x80 | n]) if n < 126 else bytes([0x81, 0xfe]) + struct.pack('!H', n)
+        mask = os.urandom(4)
+        self.sock.sendall(head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))
+        return self.next_id
+    def receive(self):
+        payload = b''
+        while True:
+            h = self.read(2)
+            n = h[1] & 127
+            if n == 126: n = struct.unpack('!H', self.read(2))[0]
+            if n == 127: n = struct.unpack('!Q', self.read(8))[0]
+            data = self.read(n)
+            payload += data
+            if h[0] & 128: return json.loads(payload)
+    def call(self, method, params=None):
+        id = self.send(method, params)
+        while True:
+            result = self.receive()
+            if result.get('method') == 'Page.javascriptDialogOpening':
+                self.dialogs.append(result['params'])
+                self.send('Page.handleJavaScriptDialog', {'accept': self.dialog_accept})
+            if 'method' in result: self.events.append(result)
+            if result.get('id') == id:
+                assert 'error' not in result, result
+                return result.get('result', {})
+    def js(self, script):
+        result = self.call('Runtime.evaluate', {'expression': script, 'returnByValue': True, 'awaitPromise': True})
+        assert 'exceptionDetails' not in result, result
+        return result.get('result', {}).get('value')
+    def wait(self, expression):
+        deadline = time.time() + 8
+        while time.time() < deadline:
+            try:
+                if self.js(expression): return
+            except AssertionError as e:
+                if 'context' not in str(e).lower(): raise
+            time.sleep(.05)
+        raise AssertionError(f'Timed out: {expression}\n{self.js("document.body.innerText")}')
+    def click(self, label):
+        self.js(f'''(() => {{const el=[...document.querySelectorAll('a,button')].find(e => e.getAttribute('aria-label') === {json.dumps(label)} || e.textContent.trim() === {json.dumps(label)}); if(!el) throw Error('Missing control: '+{json.dumps(label)}); el.click();}})()''')
+    def fill(self, label, value):
+        self.js(f'''(() => {{ const label={json.dumps(label)}; const el=[...document.querySelectorAll('input,textarea')].find(e => e.getAttribute('aria-label') === label || [...e.labels || []].some(l => l.textContent.trim() === label)); if(!el) throw Error('Missing input '+label); el.value={json.dumps(value)}; el.dispatchEvent(new Event('input', {{bubbles:true}})); }})()''')
+    def check(self, label, checked=True):
+        self.js(f'''(() => {{const label={json.dumps(label)}; const el=[...document.querySelectorAll('input[type=checkbox]')].find(e => e.getAttribute('aria-label') === label || [...e.labels || []].some(l => l.textContent.trim() === label)); if(!el) throw Error('Missing checkbox '+label); if(el.checked !== {json.dumps(checked)}) el.click();}})()''')
+    def navigate(self, path):
+        self.call('Page.navigate', {'url': BASE + path})
+        self.wait(f'location.pathname === {json.dumps(path)} && document.readyState === "complete"')
+    def screenshot(self, filename):
+        self.js('document.fonts.ready')
+        image = self.call('Page.captureScreenshot', {'format': 'png'})['data']
+        (ROOT / 'storage' / filename).write_bytes(base64.b64decode(image))
