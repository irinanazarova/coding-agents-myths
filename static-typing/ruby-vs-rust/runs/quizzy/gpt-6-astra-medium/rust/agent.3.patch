diff --git a/assets/live.js b/assets/live.js
new file mode 100644
index 0000000..7d6ddfd
--- /dev/null
+++ b/assets/live.js
@@ -0,0 +1,119 @@
+'use strict';
+(() => {
+  const root = document.getElementById('live');
+  if (!root) return;
+  const mod = root.dataset.moderator === 'true';
+  const base = root.dataset.base;
+  const content = document.getElementById('live-content');
+  const status = document.getElementById('live-status');
+  let current, revision = -1, cursor = -1, signature = '', busy = false, queuedAnswer = null;
+  function element(tag, text, cls) {
+    const e = document.createElement(tag);
+    if (text !== undefined) e.textContent = text;
+    if (cls) e.className = cls;
+    return e;
+  }
+  async function submit(action, values) {
+    if (busy) {
+      if (action === 'answer') queuedAnswer = values;
+      return;
+    }
+    busy = true;
+    root.classList.add('is-saving');
+    try {
+      const res = await fetch(base + '/' + action, {method: 'POST', signal: AbortSignal.timeout(15000), body: new URLSearchParams({csrf: root.dataset.token, ...values})});
+      if (!res.ok) throw new Error(await res.text());
+      render(await res.json());
+      status.textContent = '';
+    } catch (err) { status.textContent = err.message || 'Connection lost. Please try again.'; }
+    finally {
+      busy = false; root.classList.remove('is-saving');
+      if (queuedAnswer) {
+        const pending = queuedAnswer; queuedAnswer = null;
+        if (current.phase === 'open' && current.position === pending.position) submit('answer', pending);
+      }
+    }
+  }
+  function control(label, command) {
+    const b = element('button', label, 'btn btn--pink live-control');
+    b.type = 'button';
+    b.onclick = () => submit('action', {command, version: current.version});
+    content.append(b);
+  }
+  function render(s) {
+    if (s.revision < revision) return;
+    revision = s.revision;
+    cursor = s.cursor;
+    current = s;
+    const key = JSON.stringify({...s, revision: 0, cursor: 0});
+    if (key === signature) return;
+    signature = key;
+    // Keep a partially typed name intact across long-poll heartbeats.
+    const draft = content.querySelector('input[name=name]')?.value || '';
+    content.replaceChildren();
+    document.getElementById('join-info').hidden = !mod || s.phase !== 'waiting';
+    if (s.phase === 'ended') {
+      content.append(element('h2', 'The quiz is over'), element('p', 'Thanks for playing!', 'meta'));
+      return;
+    }
+    if (!mod && !s.name) {
+      const form = element('form', undefined, 'card join-form');
+      const label = element('label', 'Your name'); label.htmlFor = 'player-name';
+      const input = element('input', undefined, 'input');
+      input.id = 'player-name'; input.name = 'name'; input.required = true; input.maxLength = 80; input.autocomplete = 'given-name'; input.value = draft;
+      const button = element('button', 'Join', 'btn btn--pink'); button.type = 'submit';
+      form.append(label, input, button);
+      form.onsubmit = e => { e.preventDefault(); submit('join', {name: input.value}); };
+      content.append(form); return;
+    }
+    if (!mod) content.append(element('p', `Hi, ${s.name}!`, 'greeting'));
+    if (s.phase === 'waiting') {
+      if (mod) { content.append(element('p', `Players: ${s.players}`, 'live-counter')); control('Start', 'start'); }
+      else content.append(element('h2', 'You’re in!'), element('p', 'Waiting for the quiz to start…', 'meta'));
+      return;
+    }
+    content.append(element('p', `Question ${s.position + 1} of ${s.total}`, 'eyebrow'), element('h2', s.question, 'live-question'));
+    if (mod && s.phase === 'open') content.append(element('p', `Answers: ${s.answers} / ${s.players}`, 'live-counter'));
+    const list = element('ul', undefined, 'live-options');
+    s.options.forEach((o, i) => {
+      const li = element('li');
+      const option = element(!mod ? 'button' : 'div', undefined, 'live-option');
+      option.append(element('span', String.fromCharCode(65+i), 'option-letter'), element('span', o.text, 'option-text'));
+      if (!mod) {
+        option.type = 'button'; option.disabled = s.phase !== 'open';
+        option.onclick = () => submit('answer', {position: s.position, choice: i});
+        if (s.pick === i) { option.classList.add('selected'); option.append(element('strong', 'Your answer', 'option-badge')); }
+      }
+      if (s.phase === 'closed') {
+        if (mod) option.append(element('strong', `${o.count} ${o.count === 1 ? 'answer' : 'answers'}`, 'option-badge'));
+        if (o.correct) { option.classList.add('correct'); option.append(element('strong', 'Correct', 'option-badge')); }
+      }
+      li.append(option); list.append(li);
+    });
+    content.append(list);
+    if (mod) {
+      if (s.phase === 'open') control('Finish', 'finish');
+      else if (s.position + 1 === s.total) control('End quiz', 'end');
+      else control('Next', 'next');
+    } else if (s.phase === 'closed') content.append(element('h3', s.result, 'live-result'));
+    else content.append(element('p', s.pick === null ? 'Choose an answer.' : 'Answer saved. You can change it until the question closes.', 'meta'));
+  }
+  async function follow() {
+    let delay = 700;
+    while (true) {
+      try {
+        const res = await fetch(`${base}/state?since=${cursor}`, {cache: 'no-store', signal: AbortSignal.timeout(25000)});
+        if (!res.ok) throw new Error('Connection interrupted');
+        render(await res.json());
+        if (current.phase === 'ended') return;
+        if (!busy) status.textContent = '';
+        delay = 700;
+      } catch (_) {
+        status.textContent = 'Reconnecting… Your saved answer is safe.';
+        await new Promise(resolve => setTimeout(resolve, delay + Math.random()*300));
+        delay = Math.min(delay*2, 10000);
+      }
+    }
+  }
+  follow();
+})();
