+#!/usr/bin/env python3
+"""Real Chromium clients in separate cookie contexts; no browser packages needed."""
+from cdp import *
+from live import Client
+PROFILE = ROOT / 'storage' / 'live-browser-profile'
+PROFILE.mkdir(parents=True,exist_ok=True)
+log=open(ROOT/'storage'/'live-chromium.log','w')
+chrome=subprocess.Popen(['chromium','--headless','--no-sandbox','--disable-gpu','--disable-dev-shm-usage','--no-first-run','--remote-debugging-port=9223','--remote-allow-origins=*','--user-data-dir='+str(PROFILE),'about:blank'],stdout=log,stderr=log)
+mod=Client(True);mod.page('/moderate');quiz=mod.post('/moderate/quizzes',{'title':'Conference live quiz'})
+for text,active in [('Which planet is largest?',True),('Invisible question',False),('Choose a prime',True)]:
+    mod.post(quiz+'/questions',{'question':text,'option_1':'Jupiter' if 'planet' in text else 'Seven','correct_1':'1','option_2':'Saturn' if 'planet' in text else 'Eight',**({'active':'1'} if active else {})})
+try:
+    for _ in range(100):
+        try: info=json.load(urllib.request.urlopen('http://localhost:9223/json/version'));break
+        except Exception:time.sleep(.05)
+    controller=CDP(info['webSocketDebuggerUrl'])
+    def tab(moderator=False):
+        context=controller.call('Target.createBrowserContext')['browserContextId']
+        target=controller.call('Target.createTarget',{'url':'about:blank','browserContextId':context})['targetId']
+        tabs=json.load(urllib.request.urlopen('http://localhost:9223/json/list'))
+        b=CDP(next(t['webSocketDebuggerUrl'] for t in tabs if t['id']==target))
+        for name in ['Page','Runtime','Network']:b.call(name+'.enable')
+        if moderator:b.call('Network.setExtraHTTPHeaders',{'headers':{'Authorization':AUTH}})
+        b.call('Emulation.setDeviceMetricsOverride',{'width':1280 if moderator else 390,'height':900 if moderator else 844,'deviceScaleFactor':1,'mobile':not moderator})
+        return b
+    stage=tab(True);alice=tab();bob=tab()
+    def text(b,s):b.wait('document.body.innerText.includes('+json.dumps(s)+')')
+    stage.navigate(quiz);stage.click('Start a game');stage.wait('location.pathname.startsWith("/moderate/games/")')
+    game=stage.js('location.pathname');play='/play/'+game.split('/')[-1]
+    text(stage,'Players: 0')
+    assert stage.js('document.querySelector(".join-link").textContent')==BASE+play
+    stage.wait('document.querySelector(".join-qr").naturalWidth>0')
+    for b,name in [(alice,'Alice'),(bob,'Bob')]:
+        b.navigate(play);b.fill('Your name',name);b.click('Join');text(b,'Hi, '+name+'!')
+    text(stage,'Players: 2');stage.screenshot('live-waiting.png')
+    alice.navigate(play);text(alice,'Hi, Alice!')
+    stage.click('Start');text(stage,'Question 1 of 2');text(alice,'Which planet is largest?');text(bob,'Which planet is largest?')
+    assert 'Correct' not in alice.js('document.body.innerText')
+    def pick(b,index):b.js('document.querySelectorAll("button.live-option")['+str(index)+'].click()')
+    pick(alice,0);text(alice,'Your answer');text(stage,'Answers: 1 / 2')
+    pick(alice,1);alice.wait('document.querySelectorAll(".live-option")[1].textContent.includes("Your answer")')
+    stage.screenshot('live-question.png');alice.screenshot('live-phone.png')
+    assert not alice.js('document.documentElement.scrollWidth>innerWidth')
+    stage.click('Finish');text(alice,'Wrong!');text(bob,'No answer');text(stage,'Correct')
+    assert stage.js('document.querySelectorAll(".live-option")[1].textContent.includes("1 answer")')
+    stage.screenshot('live-results.png')
+    stage.click('Next');text(alice,'Choose a prime');text(stage,'Question 2 of 2')
+    # Simulate a conference Wi-Fi interruption while the game advances.
+    bob.call('Network.emulateNetworkConditions',{'offline':True,'latency':0,'downloadThroughput':0,'uploadThroughput':0})
+    alice.js('document.querySelectorAll("button.live-option")[1].click(); document.querySelectorAll("button.live-option")[0].click()')
+    alice.wait('document.querySelectorAll(".live-option")[0].textContent.includes("Your answer")')
+    stage.click('Finish');text(alice,'Correct!')
+    bob.call('Network.emulateNetworkConditions',{'offline':False,'latency':0,'downloadThroughput':-1,'uploadThroughput':-1})
+    text(bob,'No answer')
+    stage.click('End quiz')
+    for b in (stage,alice,bob):text(b,'The quiz is over')
+    stranger=tab();stranger.navigate(play);text(stranger,'The quiz is over')
+    assert not stranger.js('!!document.querySelector("input[name=name]")')
+    for b in (stage,alice,bob,stranger):
+        assert not [e for e in b.events if e.get('method')=='Runtime.exceptionThrown']
+    print('PASS: live Chromium stage, separate phones, counters, answer changes, reconnect, results, end, QR image and mobile layout')
+finally:
+    mod.post(quiz+'/delete',{})
+    chrome.terminate();chrome.wait(timeout=10);log.close();shutil.rmtree(PROFILE,ignore_errors=True)
