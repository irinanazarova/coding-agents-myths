+/// Server timestamps in microseconds; persisted so a restart preserves answer timing.
+fn now_micros() -> i64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .expect("system clock")
+        .as_micros() as i64
+}
