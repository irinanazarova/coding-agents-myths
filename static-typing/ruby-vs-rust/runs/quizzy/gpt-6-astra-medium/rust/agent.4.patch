+#[derive(Debug, serde::Serialize)]
+struct Standing {
+    #[serde(skip)]
+    token: String,
+    name: String,
+    points: usize,
+    #[serde(skip)]
+    elapsed: i64,
+    place: usize,
+    winner: bool,
+}
+
+fn leaderboard(db: &Connection, code: &str, g: &Game) -> rusqlite::Result<Vec<Standing>> {
+    let mut rows = db.prepare("SELECT token,name,EXISTS(SELECT 1 FROM winners w WHERE w.game=p.game AND w.player=p.token) FROM players p WHERE game=? ORDER BY rowid")?
+        .query_map([code], |r| Ok(Standing { token: r.get(0)?, name: r.get(1)?, winner: r.get(2)?, points: 0, elapsed: 0, place: 0 }))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    let indices: std::collections::HashMap<_, _> = rows
+        .iter()
+        .enumerate()
+        .map(|(i, p)| (p.token.clone(), i))
+        .collect();
+    let mut answers =
+        db.prepare("SELECT player,question,choice,elapsed FROM answers WHERE game=?")?;
+    let mut answers = answers.query([code])?;
+    while let Some(answer) = answers.next()? {
+        let question: usize = answer.get(1)?;
+        let choice: usize = answer.get(2)?;
+        if g.questions
+            .get(question)
+            .and_then(|q| q.options.get(choice))
+            .is_some_and(|o| o.correct)
+        {
+            let token: String = answer.get(0)?;
+            if let Some(&i) = indices.get(&token) {
+                rows[i].points += 1;
+                rows[i].elapsed += answer.get::<_, i64>(3)?;
+            }
+        }
+    }
+    // Stable sort: exact point/time ties retain join order, including zero-point players.
+    rows.sort_by_key(|r| (std::cmp::Reverse(r.points), r.elapsed));
+    for (i, row) in rows.iter_mut().enumerate() {
+        row.place = i + 1;
+    }
+    Ok(rows)
+}
+
+/// Called inside the same transaction as the game revision update.
+fn select_winners(db: &Connection, code: &str, g: &Game, command: &str) -> rusqlite::Result<()> {
+    let eligible: Vec<_> = leaderboard(db, code, g)?
+        .into_iter()
+        .filter(|r| r.points > 0)
+        .collect();
+    let n = (g.number_of_winners as usize).min(eligible.len());
+    let mut selected = Vec::new();
+    if command == "top" {
+        selected.extend(eligible.iter().take(n).map(|r| r.token.clone()));
+    } else if command == "draw" && n > 0 {
+        let cutoff = eligible[n - 1].points;
+        selected.extend(
+            eligible
+                .iter()
+                .filter(|r| r.points > cutoff)
+                .map(|r| r.token.clone()),
+        );
+        let tied: std::collections::HashSet<_> = eligible
+            .iter()
+            .filter(|r| r.points == cutoff)
+            .map(|r| r.token.as_str())
+            .collect();
+        // SQLite supplies a fresh random permutation on every draw. Speed is not used.
+        let random_order = db
+            .prepare("SELECT token FROM players WHERE game=? ORDER BY random()")?
+            .query_map([code], |r| r.get::<_, String>(0))?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        let remaining = n - selected.len();
+        selected.extend(
+            random_order
+                .into_iter()
+                .filter(|t| tied.contains(t.as_str()))
+                .take(remaining),
+        );
+    }
+    db.execute("DELETE FROM winners WHERE game=?", [code])?;
+    for token in selected {
+        db.execute(
+            "INSERT INTO winners(game,player) VALUES (?,?)",
+            params![code, token],
+        )?;
+    }
+    Ok(())
+}
