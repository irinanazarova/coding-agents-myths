+/// The same closed phase/version transition as Finish, serialized with all writes.
+/// Taking `now` explicitly also allows deterministic boundary tests.
+fn expire_due(db: &Connection, now: i64) -> rusqlite::Result<usize> {
+    db.execute(
+        "UPDATE games SET phase='closed',version=version+1
+         WHERE phase='open' AND timer_seconds>0 AND opened_at<=? - timer_seconds*1000000",
+        [now],
+    )
+}
+pub fn expire(app: &App, db: &Connection) -> rusqlite::Result<()> {
+    if expire_due(db, now_micros())? > 0 {
+        app.changes.send_modify(|v| *v += 1);
+        app.phases.send_replace(*app.changes.borrow());
+    }
+    Ok(())
+}
+
+/// No browser or active long poll is required for expiration. Also run on startup
+/// and before each game request so late answers cannot slip between worker ticks.
+pub fn start_timer_worker(app: App) {
+    tokio::spawn(async move {
+        let mut tick = tokio::time::interval(Duration::from_millis(100));
+        tick.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+        loop {
+            tick.tick().await;
+            let app = app.clone();
+            let result = tokio::task::spawn_blocking(move || {
+                let db = app.db.lock().expect("database lock");
+                expire(&app, &db)
+            })
+            .await;
+            if !matches!(result, Ok(Ok(()))) {
+                eprintln!("Timer expiration failed: {result:?}");
+            }
+        }
+    });
+}
