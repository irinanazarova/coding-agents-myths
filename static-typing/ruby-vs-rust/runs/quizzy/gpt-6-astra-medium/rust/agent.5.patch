+/// Local quiz settings, deliberately separate from portable QuizContents.
+/// Keep raw values when redisplaying an invalid form.
+pub struct TimerFields {
+    pub minutes: String,
+    pub seconds: String,
+}
+impl TimerFields {
+    pub fn from_duration(seconds: i64) -> Self {
+        Self {
+            minutes: (seconds / 60).to_string(),
+            seconds: (seconds % 60).to_string(),
+        }
+    }
+    pub fn from_form(form: &Form, default: i64) -> Self {
+        let fallback = Self::from_duration(default);
+        Self {
+            minutes: form
+                .get("timer_minutes")
+                .cloned()
+                .unwrap_or(fallback.minutes),
+            seconds: form
+                .get("timer_seconds")
+                .cloned()
+                .unwrap_or(fallback.seconds),
+        }
+    }
+    pub fn duration(&self) -> Option<i64> {
+        // Checked arithmetic bounds both storage and microsecond deadline calculations.
+        let minutes = self.minutes.parse::<u32>().ok()?;
+        let seconds = self.seconds.parse::<u32>().ok()?;
+        Some(minutes.checked_mul(60)?.checked_add(seconds)? as i64)
+    }
+}
