+#!/usr/bin/env python3
+"""Import/export HTTP regression. Run against bin/serve; stdlib only."""
+import base64, copy, html, json, os, re, urllib.request, urllib.error, urllib.parse
+BASE = os.environ.get('TEST_URL', 'http://127.0.0.1:3000')
+AUTH = 'Basic ' + base64.b64encode((os.environ.get('QUIZZY_MODERATOR_USERNAME', 'moderator') + ':' + os.environ.get('QUIZZY_MODERATOR_PASSWORD', 'test-password')).encode()).decode()
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args): return None
+opener = urllib.request.build_opener(NoRedirect)
+def request(path, data=None, auth=AUTH):
+    req = urllib.request.Request(BASE + path, data=None if data is None else urllib.parse.urlencode(data).encode(), headers={'Authorization': auth} if auth else {})
+    try: r = opener.open(req)
+    except urllib.error.HTTPError as e: r = e
+    with r: return r.status, r.read().decode(), r.headers
+
+def get(path):
+    status, body, _ = request(path)
+    assert status == 200, (path, status, body)
+    return body
+
+def post(path, data): return request(path, {'csrf': token, **data})
+def exported(path):
+    body = get(path + '/export')
+    pre = re.findall(r'<pre\b[^>]*>(.*?)</pre>', body, re.S)
+    assert len(pre) == 1
+    return json.loads(html.unescape(pre[0]))
+def quiz_links(): return re.findall(r'class="quiz-tile" href="([^"]+)"', get('/moderate'))
+
+assert 'Import quiz' in get('/moderate'), 'Missing Import quiz button'
+body = get('/moderate/quizzes/import')
+assert 'Quiz JSON' in body and '>Import</button>' in body
+token = html.unescape(re.search(r'name="csrf" value="([^"]+)"', body)[1])
+assert request('/moderate/quizzes/import', auth=None)[0] == 401
+assert request('/moderate/quizzes/import', {'quiz_json': '{}'})[0] == 403
+fixture = {'title': 'Conference <2026> & 日本語', 'questions': [
+    {'text': 'Which status?', 'active': False, 'options': [{'text': '418', 'correct': False}, {'text': '429', 'correct': True}]},
+    {'text': '</pre><script>alert("x")</script>', 'active': True, 'options': [{'text': 'A', 'correct': True}, {'text': 'B', 'correct': True}, {'text': 'C', 'correct': False}]}
+]}
+created = []
+def import_quiz(value):
+    status, body, headers = post('/moderate/quizzes/import', {'quiz_json': json.dumps(value, ensure_ascii=False)})
+    assert status == 303, (status, body)
+    path = headers['Location']; created.append(path)
+    assert 'Export' in get(path)
+    return path
+try:
+    first = import_quiz(fixture)
+    assert exported(first) == fixture  # Includes exact key sets, both booleans, order, and inactive questions.
+    assert request(first + '/export', auth=None)[0] == 401
+    second = import_quiz(exported(first))
+    assert first != second and exported(second) == fixture
+    defaults = {'title': 'Defaults', 'questions': [{'text': 'Q', 'options': [{'text': 'Yes', 'correct': True}, {'text': 'No'}]}]}
+    expected = copy.deepcopy(defaults); expected['questions'][0]['active'] = True; expected['questions'][0]['options'][1]['correct'] = False
+    assert exported(import_quiz(defaults)) == expected
+    assert exported(import_quiz({'title': 'Empty', 'questions': []})) == {'title': 'Empty', 'questions': []}
+    blanks = {'title': ' Trim ', 'questions': [{'text': ' Q ', 'options': [{'text': ' ', 'correct': True}, {'text': ' Yes ', 'correct': True}, {'text': ' No '}]}]}
+    assert exported(import_quiz(blanks)) == {'title': 'Trim', 'questions': [{'text': 'Q', 'active': True, 'options': [{'text': 'Yes', 'correct': True}, {'text': 'No', 'correct': False}]}]}
+    invalid = ['{broken', 'null', '[]', '{}', '{"title":42,"questions":[]}', '{"title":" ","questions":[]}', '{"title":"Missing questions"}', '{"title":"Q","questions":{}}']
+    for field, value in [('text', ' '), ('text', None), ('active', 'true'), ('active', None), ('options', []), ('options', [{'text': 'only', 'correct': True}]), ('options', [{'text': 'A'}, {'text': 'B'}]), ('options', [{'text': 'A', 'correct': 'false'}, {'text': 'B', 'correct': True}]), ('options', [{'text': 42, 'correct': True}, {'text': 'B'}])]:
+        bad = copy.deepcopy(fixture); bad['questions'][1][field] = value
+        invalid.append(json.dumps(bad))
+    before = quiz_links()
+    for raw in invalid:
+        status, body, _ = post('/moderate/quizzes/import', {'quiz_json': raw})
+        assert status == 422 and 'role="alert"' in body, (raw, status, body)
+        retained = re.search(r'<textarea\b[^>]*>(.*?)</textarea>', body, re.S)[1]
+        assert html.unescape(retained) == raw
+        assert quiz_links() == before, 'Invalid import created a quiz'
+    assert exported(first) == fixture, 'Imports changed source quiz'
+finally:
+    for path in created:
+        assert post(path + '/delete', {})[0] == 303
+print('PASS: exact ordered export, safe HTML, round trip, duplicate titles, defaults, validation, atomic rejection, auth and CSRF')
