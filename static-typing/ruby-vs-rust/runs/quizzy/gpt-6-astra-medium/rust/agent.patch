+#!/usr/bin/env python3
+"""Check SQLite durability across process termination and restart, in isolated storage."""
+import base64, json, os, re, socket, subprocess, tempfile, time, urllib.request
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+(ROOT / 'storage').mkdir(exist_ok=True)
+with socket.socket() as s:
+    s.bind(('127.0.0.1', 0))
+    port = s.getsockname()[1]
+base = f'http://127.0.0.1:{port}'
+auth = 'Basic ' + base64.b64encode(b'persistence:test').decode()
+env = {**os.environ, 'PORT': str(port), 'SECRET_KEY_BASE': 'test-only', 'QUIZZY_MODERATOR_USERNAME': 'persistence', 'QUIZZY_MODERATOR_PASSWORD': 'test'}
+
+def get(path):
+    with urllib.request.urlopen(urllib.request.Request(base + path, headers={'Authorization': auth})) as r:
+        return r.read().decode()
+
+def post(path, data):
+    from urllib.parse import urlencode
+    req = urllib.request.Request(base + path, data=urlencode(data).encode(), headers={'Authorization': auth})
+    with urllib.request.urlopen(req) as r: return r.url.removeprefix(base)
+
+with tempfile.TemporaryDirectory(prefix='restart-test-', dir=ROOT / 'storage') as directory:
+    def start():
+        proc = subprocess.Popen([str(ROOT / 'target/release/quizzy')], env=env, cwd=directory, stdout=subprocess.DEVNULL)
+        for _ in range(100):
+            try:
+                if get('/up') == 'OK': return proc
+            except OSError: pass
+            assert proc.poll() is None, 'Server failed to start'
+            time.sleep(.05)
+        proc.terminate()
+        raise AssertionError('Server did not become ready')
+    proc = start()
+    try:
+        token = re.search(r'name="csrf" value="([^"]+)"', get('/moderate/quizzes/new'))[1]
+        quiz = post('/moderate/quizzes', {'csrf': token, 'title': 'Survives restart'})
+        for text, active in [('Question one', True), ('Question two', False)]:
+            post(quiz + '/questions', {'csrf': token, 'question': text, 'option_1': 'Yes', 'option_2': 'No', 'correct_1': '1', **({'active': '1'} if active else {})})
+        ids = re.findall(r'<li id="question-(\d+)"', get(quiz))
+        post(quiz + '/questions/' + ids[1] + '/move-up', {'csrf': token})
+        before = get(quiz)
+        # Abrupt termination exercises recovery of committed WAL transactions.
+        proc.kill()
+        proc.wait(timeout=5)
+        proc = start()
+        assert get(quiz) == before
+        assert re.findall(r'<li id="question-(\d+)"', get(quiz)) == ids[::-1]
+        data = json.loads(re.search(r'id="preview-data">(.*?)</script>', get(quiz + '/preview'), re.S)[1])
+        assert len(data) == 1 and data[0]['text'] == 'Question one'
+        assert data[0]['options'] == [{'text': 'Yes', 'correct': True}, {'text': 'No', 'correct': False}]
+        print('PASS: quizzes, options, correctness, question order, and Active survive abrupt process restart')
+    finally:
+        proc.terminate()
+        proc.wait(timeout=5)
