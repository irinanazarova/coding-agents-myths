+    let active = questions.iter().filter(|q| q.active).count();
+    let mut body = format!(
+        r#"<main class="admin-main">{}<div class="page-head"><div><h1>{}</h1><div class="meta mt-2"><span id="active-count">{active}</span> of {} questions active · <a href="{url}/settings">Settings</a></div></div><div class="buttons"><form method="post" action="{url}/games"><input type="hidden" name="csrf" value="{token}"><button class="btn btn--pink">Start a game</button></form><a class="btn btn--ghost" href="{url}/export">Export</a><a class="btn btn--ghost" href="{url}/preview">Preview</a></div></div><section class="section mt-0"><div class="section-head"><h2>Questions</h2><a class="btn" href="{url}/questions/new">Add question</a></div><div id="save-status" role="status"></div>"#,
+        crumb("/moderate", "All quizzes"),
+        escape(&quiz.title),
+        questions.len()
+    );
+    if questions.is_empty() {
+        body.push_str(r#"<div class="empty"><h3>A blank slate</h3><p>Add your first question to get the conversation started.</p></div>"#);
+    }
+    body.push_str("<ol class=\"question-list\">");
+    let mut number = 0;
+    for (i, q) in questions.iter().enumerate() {
+        let qurl = format!("{url}/questions/{}", q.id);
+        let num = if q.active {
+            number += 1;
+            number.to_string()
+        } else {
+            "—".into()
+        };
+        write!(body, r#"<li id="question-{}" class="card question-item{}"><div class="question-item__num">{num}</div><div><div class="question-item__body">{}</div><ul class="question-item__options">"#, q.id, if q.active { "" } else { " question-item--inactive" }, escape(&q.text)).unwrap();
+        for (j, o) in q.options.iter().enumerate() {
+            write!(
+                body,
+                r#"<li{}>{}. {}{}</li>"#,
+                if o.correct {
+                    " class=\"is-correct\""
+                } else {
+                    ""
+                },
+                letter(j),
+                escape(&o.text),
+                if o.correct {
+                    "<span class=\"visually-hidden\"> (correct)</span>"
+                } else {
+                    ""
+                }
+            )
+            .unwrap();
+        }
+        body.push_str("</ul></div><div class=\"question-item__actions\"><div class=\"buttons\">");
+        for (action, label, icon, disabled) in [
+            ("move-up", "Move up", "↑", i == 0),
+            ("move-down", "Move down", "↓", i + 1 == questions.len()),
+        ] {
+            write!(body, r#"<form method="post" action="{qurl}/{action}">{}<button class="btn btn--ghost btn--icon" type="submit" aria-label="{label}" title="{label}"{}>{icon}</button></form>"#, csrf(token), if disabled { " disabled" } else { "" }).unwrap();
+        }
+        write!(body, r#"</div><form method="post" action="{qurl}/active" class="active-form">{}<label class="checkbox"><input type="checkbox" name="active" value="1" data-save-active{}> Active</label><noscript><button class="btn btn--sm">Save active</button></noscript></form><div class="buttons"><a class="btn btn--sm" href="{qurl}/edit">Edit</a><form method="post" action="{qurl}/delete" data-confirm="Delete this question?"><input type="hidden" name="csrf" value="{}"><button class="btn btn--sm btn--danger" type="submit">Delete</button></form></div></div></li>"#, csrf(token), if q.active { " checked" } else { "" }, escape(token)).unwrap();
+    }
+    body.push_str("</ol></section></main>");
+    page(&quiz.title, &body, token)
+}
+
+pub fn question_form(
+    quiz: &Quiz,
+    id: Option<i64>,
+    draft: &Draft,
+    messages: &[&str],
+    token: &str,
+) -> String {
+    let back = format!("/moderate/quizzes/{}", quiz.id);
+    let action = id
+        .map(|id| format!("{back}/questions/{id}"))
+        .unwrap_or(format!("{back}/questions"));
+    let heading = if id.is_some() {
+        "Edit question"
+    } else {
+        "New question"
+    };
+    let mut body = format!(
+        r#"<main class="admin-main">{}<div class="page-head"><h1>{heading}</h1></div><form class="card" method="post" action="{action}">{}<div class="field"><label for="question">Question</label><textarea class="input" id="question" name="question" rows="3" required>{}</textarea></div><div class="field"><span class="field-label">Options</span><span class="field-hint" id="options-hint">Mark the correct options, at least one. Empty rows are skipped.</span></div><div class="option-rows" id="option-rows">"#,
+        crumb(&back, &quiz.title),
+        csrf(token),
+        escape(&draft.text)
+    );
+    for (i, o) in draft.options.iter().enumerate() {
+        let n = i + 1;
+        write!(body, r#"<div class="option-row"><input class="input" type="text" name="option_{n}" aria-label="Option {n}" placeholder="Option {n}" value="{}" aria-describedby="options-hint"><label class="checkbox"><input type="checkbox" name="correct_{n}" value="1" aria-label="Option {n} is correct"{}> Correct</label><button type="button" class="btn btn--danger btn--icon" data-clear-option aria-label="Clear option {n}" title="Clear option {n}">✕</button></div>"#, escape(&o.text), if o.correct { " checked" } else { "" }).unwrap();
+    }
+    write!(body, r#"</div><div class="buttons option-tools"><button type="button" class="btn btn--ghost btn--sm" id="add-option">Add option</button></div><div class="field"><label class="checkbox"><input type="checkbox" name="active" value="1"{}> Active</label><span class="field-hint">Only active questions are played.</span></div>{}<div class="buttons"><button class="btn btn--pink" type="submit">Save question</button><a class="btn btn--ghost" href="{back}">Cancel</a></div></form></main>"#, if draft.active { " checked" } else { "" }, errors(messages)).unwrap();
+    page(heading, &body, token)
+}
+
+pub fn preview(quiz: &Quiz, questions: &[Question], token: &str) -> String {
+    let questions: Vec<_> = questions.iter().filter(|q| q.active).collect();
+    // JSON is data, never markup. Escape characters that could close the script element.
+    let data = serde_json::to_string(&questions)
+        .unwrap()
+        .replace('<', "\\u003c")
+        .replace('>', "\\u003e")
+        .replace('&', "\\u0026");
+    let body = format!(
+        r#"<div class="preview-banner"><span>Preview · Answers are not saved</span><a href="/moderate/quizzes/{}">Back to quiz</a></div><main class="play"><div class="play__top">{LOGO}<span>{}</span></div><div class="play__body play__body--top" id="preview" aria-live="polite"></div><div class="buttons mt-2"><button type="button" class="btn btn--ghost" id="start-over">Start over</button></div><noscript>Enable JavaScript to try the quiz preview.</noscript></main><script type="application/json" id="preview-data">{data}</script>"#,
+        quiz.id,
+        escape(&quiz.title)
+    );
+    page("Preview", &body, token)
+}
+
+pub fn letter(index: usize) -> String {
+    if index < 26 {
+        ((b'A' + index as u8) as char).to_string()
+    } else {
+        (index + 1).to_string()
+    }
+}
+
+pub fn import_form(json: &str, messages: &[&str], token: &str) -> String {
+    let body = format!(
+        r#"<main class="admin-main">{}<div class="page-head"><h1>Import quiz</h1></div><form class="card" method="post" action="/moderate/quizzes/import">{}<p class="meta">Paste an exported quiz. Importing always creates a new quiz.</p>{}<div class="field"><label for="quiz-json">Quiz JSON</label><textarea class="input quiz-json" id="quiz-json" name="quiz_json" rows="18" spellcheck="false" required>{}</textarea></div><div class="buttons"><button class="btn btn--pink" type="submit">Import</button><a class="btn btn--ghost" href="/moderate">Cancel</a></div></form></main>"#,
+        crumb("/moderate", "All quizzes"),
+        csrf(token),
+        errors(messages),
+        escape(json)
+    );
+    page("Import quiz", &body, token)
+}
+
+pub fn export_page(quiz: &Quiz, json: &str, token: &str) -> String {
+    let body = format!(
+        r#"<main class="admin-main">{}<div class="page-head"><h1>Export</h1></div><p class="meta">Copy this JSON to import your quiz into Quizzy. It contains the title, prize settings and questions, including inactive questions.</p><pre class="card quiz-json" tabindex="0" aria-label="Quiz JSON">{}</pre></main>"#,
+        crumb(&format!("/moderate/quizzes/{}", quiz.id), &quiz.title),
+        escape(json)
+    );
+    page("Export", &body, token)
+}
