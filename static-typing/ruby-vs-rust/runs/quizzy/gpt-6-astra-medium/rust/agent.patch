+#!/usr/bin/env python3
+"""Isolated timer regression; requires the locally built release binary, no network."""
+import concurrent.futures
+import json
+import os
+import re
+import socket
+import sqlite3
+import subprocess
+import tempfile
+import time
+from pathlib import Path
+import live
+
+ROOT = Path(__file__).resolve().parent.parent
+
+def run():
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1', 0))
+        port = sock.getsockname()[1]
+    live.BASE = f'http://127.0.0.1:{port}'
+    env = {**os.environ, 'PORT': str(port), 'SECRET_KEY_BASE': 'timer-test',
+           'QUIZZY_MODERATOR_USERNAME': os.environ.get('QUIZZY_MODERATOR_USERNAME', 'moderator'),
+           'QUIZZY_MODERATOR_PASSWORD': os.environ.get('QUIZZY_MODERATOR_PASSWORD', 'test-password')}
+    with tempfile.TemporaryDirectory(prefix='timer-', dir=ROOT/'storage') as directory:
+        def start():
+            proc = subprocess.Popen([ROOT/'target/release/quizzy'], cwd=directory, env=env, stdout=subprocess.DEVNULL)
+            for _ in range(100):
+                try:
+                    if live.Client().req('/up')[0] == 200:
+                        return proc
+                except OSError:
+                    pass
+                assert proc.poll() is None
+                time.sleep(.05)
+            proc.kill()
+            raise AssertionError('Startup failed')
+        proc = start()
+        try:
+            mod = live.Client(True)
+            mod.page('/moderate')
+            quiz = mod.post('/moderate/quizzes', {'title': 'Timed talk'})
+            settings = mod.page(quiz+'/settings')
+            for name, label in [('timer_minutes', 'Timer minutes'), ('timer_seconds', 'Timer seconds')]:
+                assert label in settings, f'Missing {label} field'
+                assert re.search(fr'name="{name}"[^>]*value="0"', settings), settings
+            for text in ['First', 'Second']:
+                mod.post(quiz+'/questions', {'question': text, 'active': '1', 'option_1': 'Yes', 'correct_1': '1', 'option_2': 'No'})
+            def settings(minutes, seconds, title='Timed talk'):
+                return mod.req(quiz, {'title': title, 'timer_minutes': minutes, 'timer_seconds': seconds})
+            assert settings(0, 3)[0] == 303
+            assert 'value="3"' in mod.page(quiz+'/settings')
+            for minutes, seconds in [(-1, 0), (0, -1), ('1.5', 0), (0, ''), (99999999999999999999999, 0)]:
+                status, body, _ = settings(minutes, seconds)
+                assert status == 422
+                assert f'name="timer_minutes" type="number" min="0" step="1" value="{minutes}"' in body
+            assert 'name="timer_seconds" type="number" min="0" step="1" value="3"' in mod.page(quiz+'/settings')
+            status, body, _ = settings(2, 17, title='')
+            assert status == 422 and 'value="17"' in body and 'value="2"' in body
+            assert 'timer_' not in mod.page(quiz+'/export')
+            def new_game():
+                game = mod.post(quiz+'/games', {})
+                return game, '/play/'+game.split('/')[-1]
+            game, play = new_game()
+            alice = live.Client()
+            alice.page(play)
+            alice.post(play+'/join', {'name': 'Alice'})
+            assert 'deadline_at' not in mod.state(game)
+            opened = mod.post(game+'/action', {'command': 'start', 'version': 0})
+            deadline = opened['deadline_at']
+            assert 2900 <= deadline-opened['server_now'] <= 3000
+            assert 'deadline_at' not in alice.state(play)
+            alice.post(play+'/answer', {'position': 0, 'choice': 0})
+            time.sleep(.7)
+            mod.page(game)  # A reload never opens the question again.
+            fresh = mod.state(game)
+            assert fresh['deadline_at'] == deadline
+            assert fresh['server_now'] > opened['server_now']+500
+            cursor = alice.state(play)['cursor']
+            with concurrent.futures.ThreadPoolExecutor() as pool:
+                waiting = pool.submit(alice.req, play+'/state?since='+str(cursor))
+                closed = json.loads(waiting.result(timeout=4)[1])
+            assert closed['phase'] == 'closed' and closed['result'] == 'Correct!'
+            assert mod.state(game)['version'] == 2
+            assert alice.req(play+'/answer', {'position': 0, 'choice': 1})[0] == 409
+            assert mod.req(game+'/action', {'command': 'finish', 'version': 1})[0] == 409
+            second = mod.post(game+'/action', {'command': 'next', 'version': 2})
+            assert second['deadline_at'] > deadline
+            early = mod.post(game+'/action', {'command': 'finish', 'version': 3})
+            assert early['phase'] == 'closed'
+            time.sleep(3.2)
+            assert mod.state(game)['version'] == 4, 'No duplicate expiration after early Finish'
+            # Expiration must run without any HTTP clients polling.
+            game, play = new_game()
+            mod.post(game+'/action', {'command': 'start', 'version': 0})
+            time.sleep(3.3)
+            with sqlite3.connect(Path(directory)/'storage/quizzy.sqlite3') as db:
+                assert db.execute('SELECT phase,version FROM games WHERE code=?', (game.split('/')[-1],)).fetchone() == ('closed', 2)
+            # An expired deadline is honored immediately after an abrupt restart.
+            game, play = new_game()
+            mod.post(game+'/action', {'command': 'start', 'version': 0})
+            proc.kill(); proc.wait(timeout=5)
+            time.sleep(3.2)
+            proc = start()
+            assert mod.state(game)['phase'] == 'closed'
+            # Restarting while still open keeps the same persisted deadline.
+            assert settings(0, 5)[0] == 303
+            game, play = new_game()
+            original = mod.post(game+'/action', {'command': 'start', 'version': 0})
+            time.sleep(.6)
+            proc.kill(); proc.wait(timeout=5)
+            proc = start()
+            fresh = mod.state(game)
+            assert fresh['phase'] == 'open' and fresh['deadline_at'] == original['deadline_at']
+            assert fresh['server_now'] > original['server_now']+500
+            mod.post(game+'/action', {'command': 'finish', 'version': 1})
+            # Existing games keep their settings; minutes are combined with seconds.
+            assert settings(1, 30)[0] == 303
+            game, play = new_game()
+            assert settings(0, 0)[0] == 303
+            opened = mod.post(game+'/action', {'command': 'start', 'version': 0})
+            assert 89900 <= opened['deadline_at']-opened['server_now'] <= 90000
+            mod.post(game+'/action', {'command': 'finish', 'version': 1})
+            game, play = new_game()
+            opened = mod.post(game+'/action', {'command': 'start', 'version': 0})
+            assert 'deadline_at' not in opened
+            time.sleep(3.2)
+            assert mod.state(game)['phase'] == 'open'
+            print('PASS: timer settings, validation, deadline persistence, automatic/manual Finish, privacy, zero timer, export and restart')
+        finally:
+            proc.terminate(); proc.wait(timeout=5)
+
+if __name__ == '__main__':
+    run()
