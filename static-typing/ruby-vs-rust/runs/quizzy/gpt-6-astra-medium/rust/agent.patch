+                .unwrap()
+                .iter()
+                .all(|r| !r.winner)
+        );
+        for phase in ["waiting", "open", "closed"] {
+            g.phase = phase.into();
+            let phone = state(&db, &code, "fast", false, &g, 1).unwrap();
+            assert!(phone.get("points").is_none());
+            assert!(phone.get("place").is_none());
+            assert!(phone.get("winner").is_none());
+        }
+        g.phase = "ended".into();
+        let screen = state(&db, &code, "", true, &g, 1).unwrap();
+        assert!(screen["leaderboard"][0].get("token").is_none());
+        assert!(screen["leaderboard"][0].get("elapsed").is_none());
+    }
+
+    #[test]
+    fn snapshots_presence_and_private_payloads() {
+        let mut db = Connection::open_in_memory().unwrap();
+        model::initialize(&db).unwrap();
+        initialize(&db).unwrap();
+        let contents = model::QuizContents::parse(r#"{"title":"Test","questions":[
+            {"text":"Multiple correct","options":[{"text":"A","correct":true},{"text":"B","correct":true},{"text":"C"}]},
+            {"text":"Inactive","active":false,"options":[{"text":"A","correct":true},{"text":"B"}]}
+        ]}"#).unwrap();
+        let id = contents.insert(&mut db).unwrap();
+        let quiz = model::quiz(&db, id).unwrap().unwrap();
+        create(&mut db, &quiz).unwrap();
+        let code: String = db
+            .query_row("SELECT code FROM games", [], |r| r.get(0))
+            .unwrap();
+        // Editing/deleting source content must not alter an already-created game.
+        db.execute("DELETE FROM quizzes", []).unwrap();
+        let mut game = load(&db, &code).unwrap().unwrap();
+        assert_eq!(game.questions.len(), 1);
+        db.execute(
+            "INSERT INTO players VALUES (?, 'alice', 'Alice', unixepoch())",
+            [&code],
+        )
+        .unwrap();
+        db.execute(
+            "INSERT INTO players VALUES (?, 'bob', 'Bob', unixepoch()-40)",
+            [&code],
+        )
+        .unwrap();
+        db.execute(
+            "INSERT INTO answers(game,player,question,choice) VALUES (?, 'alice', 0, 1)",
+            [&code],
+        )
+        .unwrap();
+        db.execute(
+            "INSERT INTO answers(game,player,question,choice) VALUES (?, 'bob', 0, 2)",
+            [&code],
+        )
+        .unwrap();
+        game.phase = "open".into();
+        let public = state(&db, &code, "alice", false, &game, 1).unwrap();
+        assert!(public["options"][0].get("correct").is_none());
+        assert!(public.get("result").is_none());
+        assert!(
+            state(&db, &code, "stranger", false, &game, 1)
+                .unwrap()
+                .get("question")
+                .is_none()
+        );
+        let screen = state(&db, &code, "", true, &game, 1).unwrap();
+        assert_eq!(screen["players"], 1);
+        assert_eq!(screen["answers"], 1);
+        assert!(touch(&db, &code, "bob").unwrap());
+        assert!(!touch(&db, &code, "bob").unwrap());
+        let screen = state(&db, &code, "", true, &game, 1).unwrap();
+        assert_eq!(screen["players"], 2);
+        assert_eq!(screen["answers"], 2);
+        game.phase = "closed".into();
+        assert_eq!(
+            state(&db, &code, "alice", false, &game, 1).unwrap()["result"],
+            "Correct!"
+        );
+        assert_eq!(
+            state(&db, &code, "bob", false, &game, 1).unwrap()["result"],
+            "Wrong!"
+        );
+        let screen = state(&db, &code, "", true, &game, 1).unwrap();
+        assert_eq!(screen["options"][0]["correct"], true);
+        assert_eq!(screen["options"][1]["correct"], true);
+        assert_eq!(screen["options"][1]["count"], 1);
+        assert_eq!(screen["options"][2]["count"], 1);
+    }
+}
