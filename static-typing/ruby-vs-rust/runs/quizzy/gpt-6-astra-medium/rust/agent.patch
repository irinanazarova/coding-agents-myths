+#!/usr/bin/env python3
+"""HTTP regression test against bin/serve. Standard library only; removes its fixtures."""
+import os, urllib.request, urllib.error, urllib.parse, base64, re, json, html
+BASE = os.environ.get('TEST_URL', 'http://127.0.0.1:3000')
+USER = os.environ.get('QUIZZY_MODERATOR_USERNAME', 'moderator')
+PASSWORD = os.environ.get('QUIZZY_MODERATOR_PASSWORD', 'test-password')
+AUTH = 'Basic ' + base64.b64encode(f'{USER}:{PASSWORD}'.encode()).decode()
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args): return None
+opener = urllib.request.build_opener(NoRedirect)
+def request(path, auth=AUTH, data=None, headers=None):
+    h = {'Authorization': auth} if auth else {}
+    h.update(headers or {})
+    req = urllib.request.Request(BASE + path, headers=h, data=urllib.parse.urlencode(data).encode() if data is not None else None)
+    try: r = opener.open(req)
+    except urllib.error.HTTPError as e: r = e
+    with r: return r.status, r.read().decode(), r.headers
+
+def get(path):
+    status, body, _ = request(path)
+    assert status == 200, (path, status, body)
+    return body
+
+def post(path, data):
+    return request(path, data={'csrf': token, **data})
+
+def redirect(path, data):
+    status, body, headers = post(path, data)
+    assert status == 303, (path, status, body)
+    return headers['Location']
+
+def question_ids(body):
+    return re.findall(r'<li id="question-(\d+)"', body)
+
+def preview(path):
+    return json.loads(re.search(r'id="preview-data">(.*?)</script>', get(path), re.S)[1])
+
+assert request('/up', auth=None)[0] == 200
+for path in ['/moderate', '/moderate/', '/moderate/quizzes/new', '/moderate/quizzes/1/preview', '/moderate/not-a-route']:
+    assert request(path, auth=None)[0] == 401
+    assert request(path, auth='Basic d3Jvbmc6d3Jvbmc=')[0] == 401
+    assert request(path, auth=None, data={})[0] == 401
+assert request('/moderate/not-a-route')[0] == 404
+assert request('/moderate', headers={'Host': 'conference.example'})[0] == 200
+body = get('/moderate/quizzes/new')
+token = html.unescape(re.search(r'name="csrf" value="([^"]+)"', body)[1])
+assert request('/moderate/quizzes', data={'title': 'CSRF attempt'})[0] == 403
+assert post('/moderate/quizzes', {'title': '   '})[0] == 422
+quiz = redirect('/moderate/quizzes', {'title': 'Smoke <quiz> & test'})
+try:
+    assert 'Smoke &lt;quiz&gt; &amp; test' in get(quiz)
+    assert preview(quiz + '/preview') == []
+    form = get(quiz + '/questions/new')
+    assert len(re.findall(r'aria-label="Option \d+"', form)) == 4
+    assert 'name="active" value="1" checked' in form
+    draft = {'question': 'Question <one>', 'option_1': 'A', 'correct_1': '1', 'option_2': '', 'option_3': '', 'option_4': '', 'active': '1'}
+    status, body, _ = post(quiz + '/questions', draft)
+    assert status == 422 and 'Add at least two options' in body
+    assert 'Question &lt;one&gt;' in body and 'value="A"' in body and 'name="correct_1" value="1"' in body
+    assert question_ids(get(quiz)) == []
+    draft.update(option_2='B', correct_1='')
+    del draft['correct_1']
+    draft['correct_3'] = '1'  # An empty correct row does not count.
+    status, body, _ = post(quiz + '/questions', draft)
+    assert status == 422 and 'Mark at least one option as correct' in body
+    assert question_ids(get(quiz)) == []
+    draft.update(correct_1='1', correct_2='1', option_5='E')
+    redirect(quiz + '/questions', draft)
+    first = question_ids(get(quiz))[0]
+    data = preview(quiz + '/preview')
+    assert len(data) == 1 and len(data[0]['options']) == 3
+    assert [o['correct'] for o in data[0]['options']] == [True, True, False]
+    redirect(quiz + '/questions', {'question': 'Inactive question', 'option_1': 'yes', 'correct_1': '1', 'option_2': 'no'})
+    second = question_ids(get(quiz))[1]
+    assert len(preview(quiz + '/preview')) == 1
+    second_url = quiz + '/questions/' + second
+    assert post(second_url + '/active', {'active': '1', 'ajax': '1'})[0] == 204
+    assert len(preview(quiz + '/preview')) == 2
+    redirect(second_url + '/move-up', {})
+    assert question_ids(get(quiz)) == [second, first]
+    redirect(second_url + '/move-up', {})
+    assert question_ids(get(quiz)) == [second, first]
+    redirect(second_url + '/move-down', {})
+    assert question_ids(get(quiz)) == [first, second]
+    status, body, _ = post(second_url, {'question': 'Do not save', 'option_1': 'only'})
+    assert status == 422 and 'Do not save' in body
+    assert 'Inactive question' in get(quiz) and 'Do not save' not in get(quiz)
+    redirect(second_url, {'question': 'Edited question', 'option_1': 'new yes', 'correct_1': '1', 'option_2': 'new no'})
+    assert 'Edited question' in get(quiz)
+    assert 'name="active" value="1" checked' not in get(second_url + '/edit')
+    assert len(preview(quiz + '/preview')) == 1
+    redirect(quiz, {'title': 'Renamed quiz'})
+    assert 'Renamed quiz' in get(quiz + '/settings')
+    redirect(second_url + '/delete', {})
+    assert question_ids(get(quiz)) == [first]
+    assert request(second_url + '/edit')[0] == 404
+    hostile = '</script><script>alert(1)</script> & \"quoted\"'
+    redirect(quiz + '/questions/' + first, {'question': hostile, 'option_1': hostile, 'correct_1': '1', 'option_2': 'Safe', 'active': '1'})
+    assert hostile not in get(quiz)
+    assert hostile not in get(quiz + '/preview')
+    assert preview(quiz + '/preview')[0]['text'] == hostile
+    assert preview(quiz + '/preview')[0]['options'][0]['text'] == hostile
+finally:
+    redirect(quiz + '/delete', {})
+assert request(quiz)[0] == 404
+print('PASS: readiness, authentication, host handling, CSRF, quiz CRUD, validation, options, question CRUD, order, Active, preview filtering, cascaded deletion')
