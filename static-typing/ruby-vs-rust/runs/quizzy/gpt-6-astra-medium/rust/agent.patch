+pub fn escape(s: &str) -> String {
+    s.replace('&', "&amp;")
+        .replace('<', "&lt;")
+        .replace('>', "&gt;")
+        .replace('"', "&quot;")
+        .replace('\'', "&#39;")
+}
+
+const LOGO: &str = "<span class=\"logo\"><span class=\"logo__mark\">?</span>Quizzy</span>";
+
+pub fn page(title: &str, body: &str, token: &str) -> String {
+    format!(
+        r#"<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{}"><title>{} · Quizzy</title><link rel="stylesheet" href="/assets/quizzy.css"><link rel="stylesheet" href="/assets/app.css"><script src="/assets/app.js" defer></script></head><body><header class="admin-header"><a class="admin-header__logo" href="/moderate" aria-label="Quizzy — All quizzes">{LOGO}</a><span class="admin-header__tag">Moderator</span></header>{body}</body></html>"#,
+        escape(token),
+        escape(title)
+    )
+}
+
+fn csrf(token: &str) -> String {
+    format!(
+        r#"<input type="hidden" name="csrf" value="{}">"#,
+        escape(token)
+    )
+}
+
+fn errors(messages: &[&str]) -> String {
+    if messages.is_empty() {
+        return String::new();
+    }
+    format!(
+        r#"<div class="errors" role="alert"><ul>{}</ul></div>"#,
+        messages
+            .iter()
+            .map(|m| format!("<li>{}</li>", escape(m)))
+            .collect::<String>()
+    )
+}
+
+fn crumb(url: &str, title: &str) -> String {
+    format!(
+        r#"<div class="breadcrumbs"><a href="{url}">← {}</a></div>"#,
+        escape(title)
+    )
+}
