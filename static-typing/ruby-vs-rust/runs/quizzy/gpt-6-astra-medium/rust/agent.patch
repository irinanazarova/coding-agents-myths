--- a/src/main.rs
+++ b/src/main.rs
@@ -1 +1,440 @@
-fn main() {}
+mod game;
+mod model;
+mod views;
+
+use axum::{
+    Router,
+    body::to_bytes,
+    extract::{Request, State},
+    http::{StatusCode, header},
+    response::{Html, IntoResponse, Redirect, Response},
+};
+use base64::{Engine, engine::general_purpose::STANDARD};
+use hmac::{Hmac, Mac};
+use model::{Draft, Form, TimerFields};
+use rusqlite::{Connection, params};
+use sha2::Sha256;
+use std::sync::{Arc, Mutex};
+use subtle::ConstantTimeEq;
+
+type App = Arc<AppState>;
+struct AppState {
+    db: Mutex<Connection>,
+    auth: Vec<u8>,
+    csrf: String,
+    changes: tokio::sync::watch::Sender<u64>,
+    phases: tokio::sync::watch::Sender<u64>,
+}
+
+#[tokio::main]
+async fn main() {
+    let required = |key| {
+        std::env::var(key)
+            .ok()
+            .filter(|s| !s.is_empty())
+            .unwrap_or_else(|| panic!("{key} must be set and nonempty"))
+    };
+    let username = required("QUIZZY_MODERATOR_USERNAME");
+    let password = required("QUIZZY_MODERATOR_PASSWORD");
+    let secret = required("SECRET_KEY_BASE");
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret.as_bytes()).expect("valid HMAC key");
+    mac.update(b"quizzy-moderator-csrf-v1:");
+    mac.update(username.as_bytes());
+    let csrf = STANDARD.encode(mac.finalize().into_bytes());
+    std::fs::create_dir_all("storage").expect("create storage directory");
+    let db = Connection::open("storage/quizzy.sqlite3").expect("open SQLite database");
+    model::initialize(&db).expect("initialize database");
+    game::initialize(&db).expect("initialize games");
+    let revision = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_micros() as u64;
+    let app = Arc::new(AppState {
+        db: Mutex::new(db),
+        auth: format!("{username}:{password}").into_bytes(),
+        csrf,
+        changes: tokio::sync::watch::channel(revision).0,
+        phases: tokio::sync::watch::channel(revision).0,
+    });
+    game::expire(&app, &app.db.lock().expect("database lock")).expect("expire overdue games");
+    game::start_timer_worker(app.clone());
+    let router = Router::new().fallback(handle).with_state(app);
+    let port = std::env::var("PORT")
+        .unwrap_or("3000".into())
+        .parse::<u16>()
+        .expect("PORT must be a valid port");
+    let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::UNSPECIFIED, port))
+        .await
+        .expect("bind HTTP listener");
+    println!("Quizzy ready on http://0.0.0.0:{port}");
+    axum::serve(listener, router)
+        .with_graceful_shutdown(async {
+            let mut term =
+                tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
+                    .expect("SIGTERM handler");
+            tokio::select! { _ = tokio::signal::ctrl_c() => {}, _ = term.recv() => {} }
+        })
+        .await
+        .expect("serve HTTP");
+}
+
+async fn handle(State(app): State<App>, req: Request) -> Response {
+    let mut response = handle_inner(app, req).await;
+    let headers = response.headers_mut();
+    headers.insert(header::CACHE_CONTROL, "no-store".parse().unwrap());
+    headers.insert(header::X_CONTENT_TYPE_OPTIONS, "nosniff".parse().unwrap());
+    headers.insert(header::CONTENT_SECURITY_POLICY, "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'".parse().unwrap());
+    response
+}
+
+async fn handle_inner(app: App, req: Request) -> Response {
+    let path = req.uri().path().trim_end_matches('/').to_string();
+    let method = req.method().as_str().to_string();
+    let is_read = method == "GET" || method == "HEAD";
+    if path == "/up" && is_read {
+        return (StatusCode::OK, "OK").into_response();
+    }
+    if path.is_empty() && is_read {
+        return Redirect::to("/moderate").into_response();
+    }
+    if path.starts_with("/assets/") && is_read {
+        let asset: Option<(&str, &'static [u8])> = match path.as_str() {
+            "/assets/quizzy.css" => Some((
+                "text/css; charset=utf-8",
+                include_bytes!("../assets/quizzy.css"),
+            )),
+            "/assets/app.css" => Some((
+                "text/css; charset=utf-8",
+                include_bytes!("../assets/app.css"),
+            )),
+            "/assets/live.js" => Some((
+                "text/javascript; charset=utf-8",
+                include_bytes!("../assets/live.js"),
+            )),
+            "/assets/app.js" => Some((
+                "text/javascript; charset=utf-8",
+                include_bytes!("../assets/app.js"),
+            )),
+            "/assets/Inter-latin.woff2" => {
+                Some(("font/woff2", include_bytes!("../assets/Inter-latin.woff2")))
+            }
+            _ => None,
+        };
+        return asset
+            .map(|(mime, data)| ([(header::CONTENT_TYPE, mime)], data).into_response())
+            .unwrap_or_else(not_found);
+    }
+    if path.starts_with("/play/") {
+        return game::handle(app, req, false).await;
+    }
+    if path != "/moderate" && !path.starts_with("/moderate/") {
+        return not_found();
+    }
+    let credentials = req
+        .headers()
+        .get(header::AUTHORIZATION)
+        .and_then(|v| v.to_str().ok())
+        .and_then(|v| {
+            let (scheme, value) = v.split_once(' ')?;
+            if !scheme.eq_ignore_ascii_case("basic") {
+                return None;
+            }
+            STANDARD.decode(value).ok()
+        });
+    if !credentials.is_some_and(|c| bool::from(c.as_slice().ct_eq(app.auth.as_slice()))) {
+        return (
+            StatusCode::UNAUTHORIZED,
+            [(
+                header::WWW_AUTHENTICATE,
+                "Basic realm=\"Quizzy Moderator\", charset=\"UTF-8\"",
+            )],
+            "Moderator authentication required",
+        )
+            .into_response();
+    }
+    if path.starts_with("/moderate/games/") {
+        return game::handle(app, req, true).await;
+    }
+    if !is_read && method != "POST" {
+        return StatusCode::METHOD_NOT_ALLOWED.into_response();
+    }
+    let form = if method == "POST" {
+        let body = match to_bytes(req.into_body(), 2 * 1024 * 1024).await {
+            Ok(b) => b,
+            Err(_) => return (StatusCode::PAYLOAD_TOO_LARGE, "Form is too large").into_response(),
+        };
+        let form: Form = match serde_urlencoded::from_bytes(&body) {
+            Ok(form) => form,
+            Err(_) => return (StatusCode::BAD_REQUEST, "Invalid form").into_response(),
+        };
+        if !form
+            .get("csrf")
+            .is_some_and(|value| bool::from(value.as_bytes().ct_eq(app.csrf.as_bytes())))
+        {
+            return (
+                StatusCode::FORBIDDEN,
+                "Invalid form token. Reload the page and try again.",
+            )
+                .into_response();
+        }
+        form
+    } else {
+        Form::new()
+    };
+    // SQLite operations run on a blocking worker, never on an async runtime worker.
+    match tokio::task::spawn_blocking(move || {
+        let mut db = app.db.lock().expect("database lock");
+        let result = dispatch(
+            &mut db,
+            &path,
+            if is_read { "GET" } else { "POST" },
+            &form,
+            &app.csrf,
+        );
+        if !is_read {
+            app.changes.send_modify(|v| *v += 1);
+        }
+        result
+    })
+    .await
+    {
+        Ok(Ok(response)) => response,
+        error => {
+            eprintln!("Request failed: {error:?}");
+            (
+                StatusCode::INTERNAL_SERVER_ERROR,
+                "Something went wrong. Please try again.",
+            )
+                .into_response()
+        }
+    }
+}
+
+fn not_found() -> Response {
+    (StatusCode::NOT_FOUND, "Page not found").into_response()
+}
+fn html(body: String) -> Response {
+    Html(body).into_response()
+}
+fn invalid(body: String) -> Response {
+    (StatusCode::UNPROCESSABLE_ENTITY, Html(body)).into_response()
+}
+
+fn dispatch(
+    db: &mut Connection,
+    path: &str,
+    method: &str,
+    form: &Form,
+    token: &str,
+) -> rusqlite::Result<Response> {
+    let parts: Vec<_> = path.trim_start_matches('/').split('/').collect();
+    if parts == ["moderate"] && method == "GET" {
+        return Ok(html(views::quiz_list(&model::quizzes(db)?, token)));
+    }
+    if parts == ["moderate", "quizzes", "import"] {
+        if method == "GET" {
+            return Ok(html(views::import_form("", &[], token)));
+        }
+        if method == "POST" {
+            let json = form.get("quiz_json").map(String::as_str).unwrap_or("");
+            let contents = match model::QuizContents::parse(json) {
+                Ok(contents) => contents,
+                Err(error) => return Ok(invalid(views::import_form(json, &[&error], token))),
+            };
+            let id = contents.insert(db)?;
+            return Ok(Redirect::to(&format!("/moderate/quizzes/{id}")).into_response());
+        }
+    }
+    if parts == ["moderate", "quizzes", "new"] && method == "GET" {
+        return Ok(html(views::quiz_form(
+            None,
+            "",
+            "3",
+            &TimerFields::from_duration(0),
+            &[],
+            token,
+        )));
+    }
+    if parts == ["moderate", "quizzes"] && method == "POST" {
+        let title = form.get("title").map(String::as_str).unwrap_or("");
+        let winners = model::winners_from_form(form, 3);
+        let timer = TimerFields::from_form(form, 0);
+        let duration = timer.duration();
+        if title.trim().is_empty() || winners.is_none() || duration.is_none() {
+            return Ok(invalid(views::quiz_form(
+                None,
+                title,
+                form.get("number_of_winners")
+                    .map(String::as_str)
+                    .unwrap_or("3"),
+                &timer,
+                &[if duration.is_none() {
+                    "Timer minutes and Timer seconds must be nonnegative whole numbers with a total at most 4294967295 seconds"
+                } else if winners.is_none() {
+                    "Number of winners must be at least 1"
+                } else {
+                    "Title is required"
+                }],
+                token,
+            )));
+        }
+        db.execute(
+            "INSERT INTO quizzes(title,number_of_winners,timer_seconds) VALUES (?,?,?)",
+            params![title.trim(), winners.unwrap(), duration.unwrap()],
+        )?;
+        return Ok(
+            Redirect::to(&format!("/moderate/quizzes/{}", db.last_insert_rowid())).into_response(),
+        );
+    }
+    if parts.len() < 3 || parts[1] != "quizzes" {
+        return Ok(not_found());
+    }
+    let Some(id) = parts[2].parse::<i64>().ok() else {
+        return Ok(not_found());
+    };
+    let Some(quiz) = model::quiz(db, id)? else {
+        return Ok(not_found());
+    };
+    let url = format!("/moderate/quizzes/{id}");
+    let tail = &parts[3..];
+    match (method, tail) {
+        ("GET", []) => Ok(html(views::quiz_page(
+            &quiz,
+            &model::questions(db, id)?,
+            token,
+        ))),
+        ("POST", ["games"]) => game::create(db, &quiz),
+        ("GET", ["export"]) => {
+            let contents = model::QuizContents::from_quiz(&quiz, model::questions(db, id)?);
+            let json = serde_json::to_string_pretty(&contents).expect("serialize quiz contents");
+            Ok(html(views::export_page(&quiz, &json, token)))
+        }
+        ("GET", ["settings"]) => Ok(html(views::quiz_form(
+            Some(&quiz),
+            &quiz.title,
+            &quiz.number_of_winners.to_string(),
+            &TimerFields::from_duration(quiz.timer_seconds),
+            &[],
+            token,
+        ))),
+        ("POST", []) => {
+            let title = form.get("title").map(String::as_str).unwrap_or("");
+            let winners = model::winners_from_form(form, quiz.number_of_winners);
+            let timer = TimerFields::from_form(form, quiz.timer_seconds);
+            let duration = timer.duration();
+            if title.trim().is_empty() || winners.is_none() || duration.is_none() {
+                return Ok(invalid(views::quiz_form(
+                    Some(&quiz),
+                    title,
+                    form.get("number_of_winners")
+                        .map(String::as_str)
+                        .unwrap_or("3"),
+                    &timer,
+                    &[if duration.is_none() {
+                        "Timer minutes and Timer seconds must be nonnegative whole numbers with a total at most 4294967295 seconds"
+                    } else if winners.is_none() {
+                        "Number of winners must be at least 1"
+                    } else {
+                        "Title is required"
+                    }],
+                    token,
+                )));
+            }
+            db.execute(
+                "UPDATE quizzes SET title=?,number_of_winners=?,timer_seconds=? WHERE id=?",
+                params![title.trim(), winners.unwrap(), duration.unwrap(), id],
+            )?;
+            Ok(Redirect::to(&url).into_response())
+        }
+        ("POST", ["delete"]) => {
+            db.execute("DELETE FROM quizzes WHERE id=?", [id])?;
+            Ok(Redirect::to("/moderate").into_response())
+        }
+        ("GET", ["preview"]) => Ok(html(views::preview(
+            &quiz,
+            &model::questions(db, id)?,
+            token,
+        ))),
+        ("GET", ["questions", "new"]) => Ok(html(views::question_form(
+            &quiz,
+            None,
+            &Draft::new(),
+            &[],
+            token,
+        ))),
+        ("POST", ["questions"]) => {
+            let draft = Draft::from_form(form);
+            let errors = draft.errors();
+            if !errors.is_empty() {
+                return Ok(invalid(views::question_form(
+                    &quiz, None, &draft, &errors, token,
+                )));
+            }
+            model::save_question(db, id, None, &draft)?;
+            Ok(Redirect::to(&url).into_response())
+        }
+        _ if tail.len() >= 2 && tail[0] == "questions" => {
+            let Some(qid) = tail[1].parse::<i64>().ok() else {
+                return Ok(not_found());
+            };
+            let Some(q) = model::questions(db, id)?.into_iter().find(|q| q.id == qid) else {
+                return Ok(not_found());
+            };
+            match (method, &tail[2..]) {
+                ("GET", ["edit"]) => {
+                    let draft = Draft {
+                        text: q.text,
+                        active: q.active,
+                        options: q.options,
+                    };
+                    Ok(html(views::question_form(
+                        &quiz,
+                        Some(qid),
+                        &draft,
+                        &[],
+                        token,
+                    )))
+                }
+                ("POST", []) => {
+                    let draft = Draft::from_form(form);
+                    let errors = draft.errors();
+                    if !errors.is_empty() {
+                        return Ok(invalid(views::question_form(
+                            &quiz,
+                            Some(qid),
+                            &draft,
+                            &errors,
+                            token,
+                        )));
+                    }
+                    model::save_question(db, id, Some(qid), &draft)?;
+                    Ok(Redirect::to(&url).into_response())
+                }
+                ("POST", ["delete"]) => {
+                    db.execute(
+                        "DELETE FROM questions WHERE id=? AND quiz_id=?",
+                        params![qid, id],
+                    )?;
+                    Ok(Redirect::to(&url).into_response())
+                }
+                ("POST", ["active"]) => {
+                    db.execute(
+                        "UPDATE questions SET active=? WHERE id=? AND quiz_id=?",
+                        params![form.contains_key("active"), qid, id],
+                    )?;
+                    if form.contains_key("ajax") {
+                        Ok(StatusCode::NO_CONTENT.into_response())
+                    } else {
+                        Ok(Redirect::to(&url).into_response())
+                    }
+                }
+                ("POST", [action @ ("move-up" | "move-down")]) => {
+                    model::move_question(db, id, qid, *action == "move-up")?;
+                    Ok(Redirect::to(&format!("{url}#question-{qid}")).into_response())
+                }
+                _ => Ok(not_found()),
+            }
+        }
+        _ => Ok(not_found()),
+    }
+}
diff --git a/src/model.rs b/src/model.rs
new file mode 100644
index 0000000..ae689ab
--- /dev/null
+++ b/src/model.rs
@@ -0,0 +1,580 @@
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+use std::collections::HashMap;
+
+pub type Form = HashMap<String, String>;
+
+#[derive(Debug, Serialize)]
+pub struct Quiz {
+    pub timer_seconds: i64,
+    pub number_of_winners: i64,
+    pub id: i64,
+    pub title: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Choice {
+    pub text: String,
+    #[serde(default)]
+    pub correct: bool,
+}
+
+#[derive(Debug, Serialize)]
+pub struct Question {
+    pub id: i64,
+    pub text: String,
+    pub active: bool,
+    pub options: Vec<Choice>,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+pub struct Draft {
+    pub text: String,
+    #[serde(default = "default_active")]
+    pub active: bool,
+    pub options: Vec<Choice>,
+}
+
+fn default_active() -> bool {
+    true
+}
+
+/// Portable content only: deliberately excludes IDs, positions, and runtime data.
+#[derive(Debug, Serialize, Deserialize)]
+pub struct QuizContents {
+    #[serde(
+        default = "default_winners",
+        skip_serializing_if = "is_default_winners"
+    )]
+    pub number_of_winners: i64,
+    pub title: String,
+    pub questions: Vec<Draft>,
+}
+
+pub fn default_winners() -> i64 {
+    3
+}
+fn is_default_winners(n: &i64) -> bool {
+    *n == 3
+}
+
+pub fn winners_from_form(form: &Form, default: i64) -> Option<i64> {
+    match form.get("number_of_winners") {
+        None => Some(default),
+        Some(n) => n.parse::<i64>().ok().filter(|n| *n >= 1),
+    }
+}
+
+/// Local quiz settings, deliberately separate from portable QuizContents.
+/// Keep raw values when redisplaying an invalid form.
+pub struct TimerFields {
+    pub minutes: String,
+    pub seconds: String,
+}
+impl TimerFields {
+    pub fn from_duration(seconds: i64) -> Self {
+        Self {
+            minutes: (seconds / 60).to_string(),
+            seconds: (seconds % 60).to_string(),
+        }
+    }
+    pub fn from_form(form: &Form, default: i64) -> Self {
+        let fallback = Self::from_duration(default);
+        Self {
+            minutes: form
+                .get("timer_minutes")
+                .cloned()
+                .unwrap_or(fallback.minutes),
+            seconds: form
+                .get("timer_seconds")
+                .cloned()
+                .unwrap_or(fallback.seconds),
+        }
+    }
+    pub fn duration(&self) -> Option<i64> {
+        // Checked arithmetic bounds both storage and microsecond deadline calculations.
+        let minutes = self.minutes.parse::<u32>().ok()?;
+        let seconds = self.seconds.parse::<u32>().ok()?;
+        Some(minutes.checked_mul(60)?.checked_add(seconds)? as i64)
+    }
+}
+
+impl QuizContents {
+    pub fn parse(json: &str) -> Result<Self, String> {
+        let contents: Self =
+            serde_json::from_str(json).map_err(|error| format!("Invalid Quiz JSON: {error}"))?;
+        if contents.number_of_winners < 1 {
+            return Err("Number of winners must be at least 1".into());
+        }
+        if contents.title.trim().is_empty() {
+            return Err("Title is required".into());
+        }
+        for (index, question) in contents.questions.iter().enumerate() {
+            let errors = question.errors();
+            if !errors.is_empty() {
+                return Err(format!("Question {}: {}", index + 1, errors.join(". ")));
+            }
+        }
+        Ok(contents)
+    }
+
+    pub fn from_quiz(quiz: &Quiz, questions: Vec<Question>) -> Self {
+        Self {
+            title: quiz.title.clone(),
+            number_of_winners: quiz.number_of_winners,
+            questions: questions
+                .into_iter()
+                .map(|q| Draft {
+                    text: q.text,
+                    active: q.active,
+                    options: q.options,
+                })
+                .collect(),
+        }
+    }
+
+    /// Call only on validated content from `parse`. One transaction covers the entire import.
+    pub fn insert(&self, db: &mut Connection) -> rusqlite::Result<i64> {
+        let tx = db.transaction()?;
+        tx.execute(
+            "INSERT INTO quizzes(title,number_of_winners) VALUES (?,?)",
+            params![self.title.trim(), self.number_of_winners],
+        )?;
+        let id = tx.last_insert_rowid();
+        for question in &self.questions {
+            write_question(&tx, id, None, question)?;
+        }
+        tx.commit()?;
+        Ok(id)
+    }
+}
+
+impl Draft {
+    pub fn new() -> Self {
+        Self {
+            text: String::new(),
+            active: true,
+            options: vec![
+                Choice {
+                    text: String::new(),
+                    correct: false
+                };
+                4
+            ],
+        }
+    }
+
+    pub fn from_form(form: &Form) -> Self {
+        let mut rows: Vec<_> = form
+            .keys()
+            .filter_map(|k| k.strip_prefix("option_")?.parse::<usize>().ok())
+            .collect();
+        rows.sort_unstable();
+        let options = rows
+            .into_iter()
+            .map(|i| Choice {
+                text: form
+                    .get(&format!("option_{i}"))
+                    .cloned()
+                    .unwrap_or_default(),
+                correct: form.contains_key(&format!("correct_{i}")),
+            })
+            .collect();
+        Self {
+            text: form.get("question").cloned().unwrap_or_default(),
+            active: form.contains_key("active"),
+            options,
+        }
+    }
+
+    pub fn errors(&self) -> Vec<&'static str> {
+        let mut errors = vec![];
+        if self.text.trim().is_empty() {
+            errors.push("Question is required");
+        }
+        let options: Vec<_> = self
+            .options
+            .iter()
+            .filter(|o| !o.text.trim().is_empty())
+            .collect();
+        if options.len() < 2 {
+            errors.push("Add at least two options");
+        }
+        if !options.iter().any(|o| o.correct) {
+            errors.push("Mark at least one option as correct");
+        }
+        errors
+    }
+}
+
+pub fn initialize(db: &Connection) -> rusqlite::Result<()> {
+    db.busy_timeout(std::time::Duration::from_secs(5))?;
+    db.execute_batch(
+        "PRAGMA foreign_keys = ON;
+        PRAGMA journal_mode = WAL;
+        CREATE TABLE IF NOT EXISTS quizzes (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            title TEXT NOT NULL CHECK(length(trim(title)) > 0)
+        );
+        CREATE TABLE IF NOT EXISTS questions (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            quiz_id INTEGER NOT NULL REFERENCES quizzes(id) ON DELETE CASCADE,
+            text TEXT NOT NULL,
+            active INTEGER NOT NULL DEFAULT 1,
+            position INTEGER NOT NULL
+        );
+        CREATE INDEX IF NOT EXISTS questions_order ON questions(quiz_id, position);
+        CREATE TABLE IF NOT EXISTS options (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            question_id INTEGER NOT NULL REFERENCES questions(id) ON DELETE CASCADE,
+            text TEXT NOT NULL,
+            correct INTEGER NOT NULL,
+            position INTEGER NOT NULL
+        );
+        CREATE INDEX IF NOT EXISTS options_order ON options(question_id, position);",
+    )?;
+    add_column(
+        db,
+        "quizzes",
+        "number_of_winners",
+        "INTEGER NOT NULL DEFAULT 3 CHECK(number_of_winners >= 1)",
+    )?;
+    add_column(
+        db,
+        "quizzes",
+        "timer_seconds",
+        "INTEGER NOT NULL DEFAULT 0 CHECK(timer_seconds BETWEEN 0 AND 4294967295)",
+    )
+}
+
+/// Idempotent additive migrations preserve existing quiz and live-game data.
+pub fn add_column(
+    db: &Connection,
+    table: &str,
+    column: &str,
+    definition: &str,
+) -> rusqlite::Result<()> {
+    let exists = db
+        .prepare(&format!("PRAGMA table_info({table})"))?
+        .query_map([], |r| r.get::<_, String>(1))?
+        .collect::<rusqlite::Result<Vec<_>>>()?
+        .iter()
+        .any(|c| c == column);
+    if !exists {
+        db.execute_batch(&format!(
+            "ALTER TABLE {table} ADD COLUMN {column} {definition}"
+        ))?;
+    }
+    Ok(())
+}
+
+pub fn quizzes(db: &Connection) -> rusqlite::Result<Vec<(Quiz, i64)>> {
+    db.prepare("SELECT q.id, q.title, count(questions.id), q.number_of_winners, q.timer_seconds FROM quizzes q LEFT JOIN questions ON questions.quiz_id=q.id GROUP BY q.id ORDER BY q.id DESC")?
+        .query_map([], |r| Ok((Quiz { id: r.get(0)?, title: r.get(1)?, number_of_winners: r.get(3)?, timer_seconds: r.get(4)? }, r.get(2)?)))?.collect()
+}
+
+pub fn quiz(db: &Connection, id: i64) -> rusqlite::Result<Option<Quiz>> {
+    db.query_row(
+        "SELECT id,title,number_of_winners,timer_seconds FROM quizzes WHERE id=?",
+        [id],
+        |r| {
+            Ok(Quiz {
+                id: r.get(0)?,
+                title: r.get(1)?,
+                number_of_winners: r.get(2)?,
+                timer_seconds: r.get(3)?,
+            })
+        },
+    )
+    .optional()
+}
+
+pub fn questions(db: &Connection, quiz_id: i64) -> rusqlite::Result<Vec<Question>> {
+    let mut result = db
+        .prepare("SELECT id,text,active FROM questions WHERE quiz_id=? ORDER BY position,id")?
+        .query_map([quiz_id], |r| {
+            Ok(Question {
+                id: r.get(0)?,
+                text: r.get(1)?,
+                active: r.get(2)?,
+                options: vec![],
+            })
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    for q in &mut result {
+        q.options = db
+            .prepare("SELECT text,correct FROM options WHERE question_id=? ORDER BY position,id")?
+            .query_map([q.id], |r| {
+                Ok(Choice {
+                    text: r.get(0)?,
+                    correct: r.get(1)?,
+                })
+            })?
+            .collect::<rusqlite::Result<_>>()?;
+    }
+    Ok(result)
+}
+
+/// The caller validates the draft first; all writes, including replacement options, are atomic.
+pub fn save_question(
+    db: &mut Connection,
+    quiz_id: i64,
+    question_id: Option<i64>,
+    draft: &Draft,
+) -> rusqlite::Result<()> {
+    let tx = db.transaction()?;
+    write_question(&tx, quiz_id, question_id, draft)?;
+    tx.commit()
+}
+
+/// Shared by form saves and imports; the caller owns the transaction.
+fn write_question(
+    tx: &Connection,
+    quiz_id: i64,
+    question_id: Option<i64>,
+    draft: &Draft,
+) -> rusqlite::Result<()> {
+    let id = if let Some(id) = question_id {
+        tx.execute(
+            "UPDATE questions SET text=?,active=? WHERE id=? AND quiz_id=?",
+            params![draft.text.trim(), draft.active, id, quiz_id],
+        )?;
+        tx.execute("DELETE FROM options WHERE question_id=?", [id])?;
+        id
+    } else {
+        tx.execute("INSERT INTO questions(quiz_id,text,active,position) VALUES(?,?,?,(SELECT coalesce(max(position),0)+1 FROM questions WHERE quiz_id=?))", params![quiz_id, draft.text.trim(), draft.active, quiz_id])?;
+        tx.last_insert_rowid()
+    };
+    for (i, option) in draft
+        .options
+        .iter()
+        .filter(|o| !o.text.trim().is_empty())
+        .enumerate()
+    {
+        tx.execute(
+            "INSERT INTO options(question_id,text,correct,position) VALUES(?,?,?,?)",
+            params![id, option.text.trim(), option.correct, i as i64],
+        )?;
+    }
+    Ok(())
+}
+
+pub fn move_question(
+    db: &mut Connection,
+    quiz_id: i64,
+    question_id: i64,
+    up: bool,
+) -> rusqlite::Result<()> {
+    let tx = db.transaction()?;
+    let ids: Vec<i64> = tx
+        .prepare("SELECT id FROM questions WHERE quiz_id=? ORDER BY position,id")?
+        .query_map([quiz_id], |r| r.get(0))?
+        .collect::<rusqlite::Result<_>>()?;
+    if let Some(index) = ids.iter().position(|id| *id == question_id) {
+        let neighbor = if up {
+            index.checked_sub(1)
+        } else {
+            index.checked_add(1).filter(|i| *i < ids.len())
+        };
+        if let Some(neighbor) = neighbor {
+            let mut ids = ids;
+            ids.swap(index, neighbor);
+            for (position, id) in ids.iter().enumerate() {
+                tx.execute(
+                    "UPDATE questions SET position=? WHERE id=?",
+                    params![position as i64, id],
+                )?;
+            }
+        }
+    }
+    tx.commit()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const CONTENTS: &str = r#"{
+        "title": "Conference",
+        "questions": [
+            {"text":"First", "options":[{"text":"A","correct":true},{"text":"B"}]},
+            {"text":"Second", "active":false, "options":[{"text":"C"},{"text":"D","correct":true}]}
+        ]
+    }"#;
+
+    #[test]
+    fn timer_validation_and_nonportable_settings() {
+        for (minutes, seconds, expected) in [
+            ("0", "0", Some(0)),
+            ("1", "30", Some(90)),
+            ("0", "90", Some(90)),
+            ("-1", "0", None),
+            ("0", "-1", None),
+            ("1.5", "0", None),
+            ("0", "", None),
+            ("4294967295", "0", None),
+            ("0", "4294967295", Some(4294967295)),
+        ] {
+            let form = TimerFields {
+                minutes: minutes.into(),
+                seconds: seconds.into(),
+            };
+            assert_eq!(form.duration(), expected);
+        }
+        let mut db = Connection::open_in_memory().unwrap();
+        db.execute_batch(
+            "CREATE TABLE quizzes (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL);
+            INSERT INTO quizzes(title) VALUES ('Legacy');",
+        )
+        .unwrap();
+        initialize(&db).unwrap();
+        initialize(&db).unwrap();
+        assert_eq!(quiz(&db, 1).unwrap().unwrap().timer_seconds, 0);
+        db.execute("UPDATE quizzes SET timer_seconds=90 WHERE id=1", [])
+            .unwrap();
+        let q = quiz(&db, 1).unwrap().unwrap();
+        let json = serde_json::to_value(QuizContents::from_quiz(&q, vec![])).unwrap();
+        assert!(json.get("timer_seconds").is_none());
+        assert!(json.get("timer_minutes").is_none());
+        assert_eq!(json.as_object().unwrap().len(), 2);
+        // Unknown timer keys in imported content cannot set local configuration.
+        let imported = QuizContents::parse(
+            r#"{"title":"Imported","questions":[],"timer_seconds":90,"timer_minutes":1}"#,
+        )
+        .unwrap();
+        let id = imported.insert(&mut db).unwrap();
+        assert_eq!(quiz(&db, id).unwrap().unwrap().timer_seconds, 0);
+        assert_eq!(
+            TimerFields::from_form(&Form::new(), 90).duration(),
+            Some(90)
+        );
+    }
+
+    #[test]
+    fn portable_round_trip_and_new_ids() {
+        let contents = QuizContents::parse(CONTENTS).unwrap();
+        assert!(contents.questions[0].active);
+        assert!(!contents.questions[0].options[1].correct);
+        let mut db = Connection::open_in_memory().unwrap();
+        initialize(&db).unwrap();
+        let first = contents.insert(&mut db).unwrap();
+        let second = contents.insert(&mut db).unwrap();
+        assert_ne!(first, second);
+        assert_eq!(quizzes(&db).unwrap().len(), 2);
+        let exported = QuizContents::from_quiz(
+            &quiz(&db, first).unwrap().unwrap(),
+            questions(&db, first).unwrap(),
+        );
+        assert_eq!(
+            serde_json::to_value(&exported).unwrap(),
+            serde_json::to_value(&contents).unwrap()
+        );
+        let keys = serde_json::to_value(&exported).unwrap();
+        assert_eq!(keys.as_object().unwrap().len(), 2);
+        assert_eq!(keys["questions"][0].as_object().unwrap().len(), 3);
+        assert_eq!(
+            keys["questions"][0]["options"][0]
+                .as_object()
+                .unwrap()
+                .len(),
+            2
+        );
+    }
+
+    #[test]
+    fn import_rolls_back_even_after_database_failure() {
+        let mut db = Connection::open_in_memory().unwrap();
+        initialize(&db).unwrap();
+        // Fail in the second question, after the quiz, first question, and options were written.
+        db.execute_batch(
+            "CREATE TRIGGER reject_second BEFORE INSERT ON questions
+            WHEN NEW.text = 'Second' BEGIN SELECT RAISE(ABORT, 'test failure'); END;",
+        )
+        .unwrap();
+        assert!(
+            QuizContents::parse(CONTENTS)
+                .unwrap()
+                .insert(&mut db)
+                .is_err()
+        );
+        for table in ["quizzes", "questions", "options"] {
+            let count: i64 = db
+                .query_row(&format!("SELECT count(*) FROM {table}"), [], |r| r.get(0))
+                .unwrap();
+            assert_eq!(count, 0, "partial import in {table}");
+        }
+    }
+
+    #[test]
+    fn import_uses_question_form_rules() {
+        let mut json: serde_json::Value = serde_json::from_str(CONTENTS).unwrap();
+        json["questions"][1]["options"][1]["correct"] = false.into();
+        assert_eq!(
+            QuizContents::parse(&json.to_string()).unwrap_err(),
+            "Question 2: Mark at least one option as correct"
+        );
+        json["questions"][1]["text"] = " ".into();
+        assert!(
+            QuizContents::parse(&json.to_string())
+                .unwrap_err()
+                .contains("Question is required")
+        );
+        json["questions"][1]["options"] = serde_json::json!([{"text":"only", "correct":true}]);
+        assert!(
+            QuizContents::parse(&json.to_string())
+                .unwrap_err()
+                .contains("Add at least two options")
+        );
+    }
+
+    #[test]
+    fn ignores_empty_correct_rows() {
+        let mut d = Draft::new();
+        d.text = "Question".into();
+        d.options[0] = Choice {
+            text: "one".into(),
+            correct: false,
+        };
+        d.options[1] = Choice {
+            text: "two".into(),
+            correct: false,
+        };
+        d.options[2] = Choice {
+            text: "  ".into(),
+            correct: true,
+        };
+        assert_eq!(d.errors(), vec!["Mark at least one option as correct"]);
+        d.options[0].correct = true;
+        assert!(d.errors().is_empty());
+    }
+    #[test]
+    fn order_and_cascades() {
+        let mut db = Connection::open_in_memory().unwrap();
+        initialize(&db).unwrap();
+        db.execute("INSERT INTO quizzes(title) VALUES ('Test')", [])
+            .unwrap();
+        let mut d = Draft::new();
+        d.text = "first".into();
+        d.options[0] = Choice {
+            text: "yes".into(),
+            correct: true,
+        };
+        d.options[1] = Choice {
+            text: "no".into(),
+            correct: false,
+        };
+        save_question(&mut db, 1, None, &d).unwrap();
+        d.text = "second".into();
+        save_question(&mut db, 1, None, &d).unwrap();
+        move_question(&mut db, 1, 2, true).unwrap();
+        assert_eq!(questions(&db, 1).unwrap()[0].text, "second");
+        move_question(&mut db, 1, 2, true).unwrap();
+        assert_eq!(questions(&db, 1).unwrap()[0].text, "second");
+        db.execute("DELETE FROM quizzes WHERE id=1", []).unwrap();
+        assert!(questions(&db, 1).unwrap().is_empty());
+        assert_eq!(
+            db.query_row("SELECT count(*) FROM options", [], |r| r.get::<_, i64>(0))
+                .unwrap(),
+            0
+        );
+    }
+}
