+#!/usr/bin/env python3
+"""Real browser coverage of timer labels, M:SS rendering, reload and automatic Finish."""
+from cdp import *
+from live import Client
+
+PROFILE = ROOT / 'storage' / 'timer-browser-profile'
+PROFILE.mkdir(parents=True, exist_ok=True)
+log = open(ROOT/'storage'/'timer-chromium.log', 'w')
+chrome = subprocess.Popen(['chromium', '--headless', '--no-sandbox', '--disable-gpu', '--disable-dev-shm-usage', '--no-first-run', '--remote-debugging-port=9224', '--remote-allow-origins=*', '--user-data-dir='+str(PROFILE), 'about:blank'], stdout=log, stderr=log)
+mod = Client(True)
+mod.page('/moderate')
+quiz = mod.post('/moderate/quizzes', {'title': 'Timer browser regression'})
+for question in ['First timed question', 'Second timed question']:
+    mod.post(quiz+'/questions', {'question': question, 'active': '1', 'option_1': 'Yes', 'correct_1': '1', 'option_2': 'No'})
+try:
+    for _ in range(100):
+        try:
+            info = json.load(urllib.request.urlopen('http://localhost:9224/json/version'))
+            break
+        except Exception:
+            time.sleep(.05)
+    controller = CDP(info['webSocketDebuggerUrl'])
+    def tab(moderator=False):
+        context = controller.call('Target.createBrowserContext')['browserContextId']
+        target = controller.call('Target.createTarget', {'url': 'about:blank', 'browserContextId': context})['targetId']
+        tabs = json.load(urllib.request.urlopen('http://localhost:9224/json/list'))
+        browser = CDP(next(t['webSocketDebuggerUrl'] for t in tabs if t['id'] == target))
+        for name in ['Page', 'Runtime', 'Network']:
+            browser.call(name+'.enable')
+        if moderator:
+            browser.call('Network.setExtraHTTPHeaders', {'headers': {'Authorization': AUTH}})
+        return browser
+    stage, phone = tab(True), tab()
+    def text(browser, s):
+        browser.wait('document.body.innerText.includes('+json.dumps(s)+')')
+    def timer():
+        return stage.js('document.querySelector("#question-timer")?.textContent')
+    def save(minutes, seconds):
+        stage.navigate(quiz+'/settings')
+        stage.fill('Timer minutes', minutes)
+        stage.fill('Timer seconds', seconds)
+        stage.click('Save quiz')
+        stage.wait('location.pathname === '+json.dumps(quiz))
+    def game():
+        stage.click('Start a game')
+        stage.wait('location.pathname.startsWith("/moderate/games/")')
+        text(stage, 'Players: 0')
+        return stage.js('location.pathname')
+    stage.navigate(quiz+'/settings')
+    assert stage.js('[...document.querySelectorAll("input[name^=timer_]")].map(e=>[e.type,e.value])') == [['number','0'],['number','0']]
+    save('1', '30')
+    stage.navigate(quiz+'/settings')
+    assert stage.js('document.querySelector("input[name=timer_minutes]").value') == '1'
+    assert stage.js('document.querySelector("input[name=timer_seconds]").value') == '30'
+    stage.click('Cancel'); stage.wait('location.pathname === '+json.dumps(quiz))
+    game()
+    assert timer() is None
+    stage.click('Start')
+    stage.wait('document.querySelector("#question-timer")?.textContent === "1:30"')
+    stage.click('Finish'); text(stage, 'Next')
+    assert timer() is None
+    save('0', '6')
+    path = game()
+    play = '/play/'+path.split('/')[-1]
+    phone.navigate(play); phone.fill('Your name', 'Timed player'); phone.click('Join')
+    text(phone, 'Waiting for the quiz to start')
+    stage.click('Start')
+    text(phone, 'First timed question')
+    stage.wait('document.querySelector("#question-timer")?.textContent === "0:05"')
+    assert not phone.js('!!document.querySelector("[role=timer],#question-timer")')
+    phone.js('document.querySelector("button.live-option").click()')
+    text(phone, 'Answer saved')
+    stage.navigate(path)
+    stage.wait('!!document.querySelector("#question-timer")')
+    assert timer() in ['0:05', '0:04', '0:03'], timer()
+    stage.screenshot('timer-countdown.png')
+    text(stage, 'Next'); text(phone, 'Correct!')
+    assert timer() is None
+    stage.click('Next')
+    stage.wait('document.querySelector("#question-timer")?.textContent === "0:06"')
+    text(phone, 'Second timed question')
+    stage.click('Finish'); text(stage, 'End quiz'); text(phone, 'No answer')
+    assert timer() is None
+    save('0', '0')
+    game(); stage.click('Start'); text(stage, 'Finish')
+    assert timer() is None
+    time.sleep(1.2)
+    text(stage, 'Finish')
+    for browser in [stage, phone]:
+        assert not [event for event in browser.events if event.get('method') == 'Runtime.exceptionThrown']
+    print('PASS: numeric labeled settings, 1:30 and 0:05 countdowns, reload continuity, automatic results, Next reset, early Finish and no player/zero timer')
+finally:
+    mod.post(quiz+'/delete', {})
+    chrome.terminate(); chrome.wait(timeout=10); log.close()
+    shutil.rmtree(PROFILE, ignore_errors=True)
