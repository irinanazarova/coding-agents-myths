new file mode 100644
index 0000000..70cbf21
--- /dev/null
+++ b/tests/import_export.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Content transfer regression checks against bin/serve; standard library only."""
+import copy
+import html.parser
+import json
+import re
+import time
+from smoke import csrf, post, request
+
+IMPORT = '/moderate/quizzes/import'
+
+
+class TransferDocument(html.parser.HTMLParser):
+    def __init__(self, html):
+        super().__init__(convert_charrefs=True)
+        self.pres = []
+        self.textarea = ''
+        self.inside_pre = False
+        self.inside_textarea = False
+        self.feed(html)
+
+    def handle_starttag(self, tag, attrs):
+        if tag == 'pre':
+            self.pres.append('')
+            self.inside_pre = True
+        if tag == 'textarea':
+            self.inside_textarea = True
+
+    def handle_endtag(self, tag):
+        if tag == 'pre':
+            self.inside_pre = False
+        if tag == 'textarea':
+            self.inside_textarea = False
+
+    def handle_data(self, text):
+        if self.inside_pre:
+            self.pres[-1] += text
+        if self.inside_textarea:
+            self.textarea += text
+
+
+def exported(quiz):
+    status, headers, body = request(quiz + '/export')
+    assert status == 200, (status, body)
+    assert 'no-store' in headers['Cache-Control']
+    pres = TransferDocument(body).pres
+    assert len(pres) == 1, pres
+    data = json.loads(pres[0])
+    assert set(data) == {'title', 'questions'}
+    for question in data['questions']:
+        assert set(question) == {'text', 'active', 'options'}
+        assert type(question['active']) is bool
+        for option in question['options']:
+            assert set(option) == {'text', 'correct'}
+            assert type(option['correct']) is bool
+    return data
+
+
+def run():
+    assert 'Import quiz' in request('/moderate')[2], 'Missing Import quiz control'
+    token = csrf(IMPORT)
+    assert 'Quiz JSON' in request(IMPORT)[2]
+    for path in [IMPORT, '/moderate/quizzes/1/export']:
+        assert request(path, auth=None)[0] == 401
+    assert request(IMPORT, {'quiz_json': '{}'}, auth=None)[0] == 401
+    assert request(IMPORT, {'quiz_json': '{}'})[0] == 403
+    assert request('/moderate/quizzes/9223372036854775807/export')[0] == 404
+    created = []
+
+    def imported(data):
+        status, headers, body = post(IMPORT, {'quiz_json': json.dumps(data)}, token)
+        assert status == 303, (status, body)
+        quiz = headers['Location']
+        assert quiz.startswith('/moderate/quizzes/')
+        created.append(quiz)
+        assert request(quiz)[0] == 200
+        return quiz
+
+    try:
+        # Create and reorder through the regular forms, then transfer all content,
+        # including inactive questions, Unicode, markup, and multiple correct choices.
+        title = 'Transfer <quiz> & café 🎤 ' + str(time.time_ns())
+        status, headers, _ = post('/moderate/quizzes', {'title': title}, token)
+        assert status == 303
+        source = headers['Location']
+        created.append(source)
+        assert exported(source) == {'title': title, 'questions': []}
+        assert 'Export' in request(source)[2]
+        for text, active in [('First </pre><script>alert(1)</script>', True), ('Second question', False)]:
+            fields = {'question': text, 'option_1': '418', 'option_2': '429', 'correct_2': 'on', 'option_3': '另一个 & <option>', 'correct_3': 'on'}
+            if active:
+                fields['active'] = 'on'
+            assert post(source + '/questions', fields, token)[0] == 303
+        ids = re.findall(r'id="question-(\d+)"', request(source)[2])
+        assert post(source + '/questions/' + ids[1] + '/move', {'direction': 'up'}, token)[0] == 303
+        original = exported(source)
+        assert [q['active'] for q in original['questions']] == [False, True]
+        assert original['questions'][0]['text'] == 'Second question'
+        assert [o['text'] for o in original['questions'][0]['options']] == ['418', '429', '另一个 & <option>']
+        assert '<script>alert(1)</script>' not in request(source + '/export')[2]
+        first = imported(original)
+        second = imported(original)
+        assert len({source, first, second}) == 3
+        assert exported(first) == exported(second) == original
+        assert request('/moderate')[2].count('Transfer &lt;quiz&gt;') == 3
+        assert post(first, {'title': 'Independent copy'}, token)[0] == 303
+        assert exported(source) == exported(second) == original
+
+        defaults = {'title': '  Defaults  ', 'questions': [{'text': '  Default flags  ', 'options': [{'text': '  No  '}, {'text': ' Yes ', 'correct': True}, {'text': '  ', 'correct': True}]}]}
+        normalized = exported(imported(defaults))
+        assert normalized == {'title': 'Defaults', 'questions': [{'text': 'Default flags', 'active': True, 'options': [{'text': 'No', 'correct': False}, {'text': 'Yes', 'correct': True}]}]}
+        assert exported(imported({'title': 'Empty', 'questions': []})) == {'title': 'Empty', 'questions': []}
+
+        valid = {'text': 'Valid first question', 'options': [{'text': 'A', 'correct': True}, {'text': 'B'}]}
+        invalid_questions = [
+            ({**valid, 'text': ' \n\t '}, 'Question is required'),
+            ({**valid, 'options': [{'text': 'A', 'correct': True}]}, 'Add at least two options'),
+            ({**valid, 'options': [{'text': 'A'}, {'text': 'B'}]}, 'Mark at least one option as correct'),
+            ({**valid, 'options': [{'text': 'A'}, {'text': 'B'}, {'text': ' ', 'correct': True}]}, 'Mark at least one option as correct'),
+        ]
+        invalid = [('{', 'Invalid quiz JSON'), ('null', 'Invalid quiz JSON'), ('[]', 'Invalid quiz JSON'), ('{}', 'Invalid quiz JSON'), ('["Title",[]]', 'Invalid quiz JSON'),
+                   (json.dumps({'title': ' ', 'questions': []}), 'Title is required')]
+        for question, message in invalid_questions:
+            invalid.append((json.dumps({'title': 'Must not be imported', 'questions': [valid, question]}), message))
+        for field, value in [('text', 42), ('text', None), ('active', None), ('active', 'true'), ('options', {})]:
+            invalid.append((json.dumps({'title': 'Invalid type', 'questions': [valid, {**valid, field: value}]}), 'Invalid quiz JSON'))
+        for value in [None, 'false', 0]:
+            question = copy.deepcopy(valid)
+            question['options'][1]['correct'] = value
+            invalid.append((json.dumps({'title': 'Invalid correct', 'questions': [question]}), 'Invalid quiz JSON'))
+        invalid += [
+            ('{"title":"T","questions":[["Q",true,[{"text":"A","correct":true},{"text":"B"}]]]}', 'Invalid quiz JSON'),
+            ('{"title":"T","questions":[{"text":"Q","options":[["A",true],["B",false]]}]}', 'Invalid quiz JSON'),
+            ('{"title":123,"questions":[]}', 'Invalid quiz JSON'),
+            ('{"title":"Missing questions"}', 'Invalid quiz JSON'),
+            ('{"title":"Null questions","questions":null}', 'Invalid quiz JSON'),
+            ('{"title":"Missing options","questions":[{"text":"Q"}]}', 'Invalid quiz JSON'),
+            ('{"title":"Missing option text","questions":[{"text":"Q","options":[{"correct":true}]}]}', 'Invalid quiz JSON'),
+            ('</textarea><script>alert(1)</script>', 'Invalid quiz JSON'),
+        ]
+        before = request('/moderate')[2]
+        for raw, message in invalid:
+            status, _, body = post(IMPORT, {'quiz_json': raw}, token)
+            assert status == 422, (raw, status)
+            assert 'role="alert"' in body and message in body, (raw, body)
+            assert TransferDocument(body).textarea.lstrip('\n') == raw
+            assert '<script>alert(1)</script>' not in body
+            assert request('/moderate')[2] == before, 'Rejected import changed the quiz list'
+            assert exported(source) == original
+        print('PASS: transfer UI, auth, CSRF, exact schema, ordering, defaults, copies, escaping, validation, atomic rejection')
+    finally:
+        for quiz in reversed(created):
+            post(quiz + '/delete', {}, token)
+
+
+if __name__ == '__main__':
+    run()
