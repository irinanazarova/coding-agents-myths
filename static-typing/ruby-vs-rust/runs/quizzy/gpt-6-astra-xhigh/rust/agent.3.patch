new file mode 100644
index 0000000..34c258b
--- /dev/null
+++ b/assets/live.js
@@ -0,0 +1,224 @@
+'use strict';
+(() => {
+  const shell = document.getElementById('live-game');
+  if (!shell) return;
+  const root = document.getElementById('live-content');
+  const status = document.getElementById('connection-status');
+  const error = document.getElementById('live-error');
+  const details = document.getElementById('join-details');
+  const moderator = shell.dataset.moderator === 'true';
+  const base = shell.dataset.base;
+  let state = JSON.parse(document.getElementById('live-data').textContent);
+  let source, heartbeatTimer, reconnectTimer, watchdog;
+  let lastEvent = Date.now(), lastHeartbeat = 0;
+  let pending = null, sending = false, controlling = false, lastRender = '';
+
+  function node(tag, className, text) {
+    const e = document.createElement(tag);
+    e.className = className;
+    if (text !== undefined) e.textContent = text;
+    return e;
+  }
+  function button(label, action) {
+    const b = node('button', 'btn btn--pink btn--lg', label);
+    b.type = 'button';
+    b.disabled = controlling;
+    b.addEventListener('click', action);
+    return b;
+  }
+  function render() {
+    if (details) details.hidden = state.phase !== 'waiting';
+    // Keep a half-typed name intact when the moderator advances the game.
+    if (!moderator && state.name === null && state.phase !== 'ended') return;
+    const signature = JSON.stringify([state, pending, sending, controlling]);
+    if (signature === lastRender) return;
+    lastRender = signature;
+    const focused = document.activeElement?.dataset.option;
+    root.replaceChildren();
+    if (state.phase === 'ended') {
+      root.append(node('div', 'end-mark', '✓'), node('h1', '', 'The quiz is over'), node('p', 'live-subtitle', 'Thanks for playing!'));
+      stop();
+      status.textContent = 'Finished';
+      return;
+    }
+    if (state.name) root.append(node('p', 'live-greeting', `Hi, ${state.name}!`));
+    if (state.phase === 'waiting') {
+      root.append(node('p', 'eyebrow', moderator ? 'Ready when you are' : 'You’re in'), node('h1', '', state.title));
+      if (moderator) {
+        root.append(node('p', 'live-counter', `Players: ${state.players}`), button('Start', () => control('start')));
+        if (!state.total) root.append(node('p', 'meta', 'No active questions. Starting will end this game.'));
+      } else {
+        root.append(node('p', 'live-subtitle', 'Waiting for the quiz to start…'), node('p', 'meta', 'Keep this page open. Questions will appear here automatically.'));
+      }
+      return;
+    }
+    root.append(node('p', 'eyebrow live-progress', `Question ${state.index + 1} of ${state.total}`));
+    if (!state.question) return;
+    root.append(node('h1', 'live-question', state.question.text));
+    if (moderator && state.phase === 'open') root.append(node('p', 'live-counter', `Answers: ${state.answers} / ${state.players}`));
+    if (state.result) root.append(node('p', `live-result ${state.result === 'Correct!' ? 'is-right' : ''}`, state.result));
+    const options = node('ul', 'list-reset live-options');
+    options.setAttribute('aria-label', 'Options');
+    const selected = pending && pending.index === state.index ? pending.option : state.selected;
+    state.question.options.forEach((choice, i) => {
+      const row = node('li', '');
+      const option = node(moderator ? 'div' : 'button', 'live-option');
+      if (!moderator) {
+        option.type = 'button';
+        option.dataset.option = String(i);
+        option.setAttribute('aria-label', choice.text);
+        option.setAttribute('aria-pressed', String(selected === i));
+        option.disabled = state.phase !== 'open';
+        option.addEventListener('click', () => {
+          pending = {index: state.index, option: i};
+          error.textContent = '';
+          render();
+          flushAnswer();
+        });
+      }
+      option.append(node('span', 'live-option-text', choice.text));
+      const marks = node('span', 'live-marks');
+      if (selected === i && !moderator) {
+        option.classList.add('is-selected');
+        marks.append(node('span', 'answer-mark', 'Your answer'));
+      }
+      if (state.phase === 'closed') {
+        marks.append(node('span', 'option-count', `Answers: ${choice.count}`));
+        if (choice.correct) {
+          option.classList.add('is-right');
+          marks.append(node('span', 'correct-mark', 'Correct'));
+        }
+      }
+      option.append(marks);
+      row.append(option);
+      options.append(row);
+    });
+    root.append(options);
+    if (moderator) {
+      if (state.phase === 'open') root.append(button('Finish', () => control('finish')));
+      else if (state.index + 1 < state.total) root.append(button('Next', () => control('next')));
+      else root.append(button('End quiz', () => control('end')));
+    } else {
+      root.append(node('p', 'meta answer-status', state.phase === 'closed' ? 'Waiting for the moderator…' :
+        pending || sending ? 'Saving your answer…' : state.selected === null ? 'Tap an option to answer.' : 'Answer saved. You can change it until the question closes.'));
+    }
+    if (focused !== undefined) root.querySelector(`[data-option="${focused}"]`)?.focus({preventScroll: true});
+  }
+  function apply(next) {
+    // A slow request must not overwrite a newer SSE snapshot.
+    if (next.revision < state.revision) return;
+    if (next.phase !== 'open' || next.index !== state.index) pending = null;
+    if (next.version !== state.version) error.textContent = '';
+    state = next;
+    render();
+  }
+  async function send(path, fields) {
+    return fetch(base + path, {
+      method: 'POST', credentials: 'same-origin', cache: 'no-store',
+      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+      body: new URLSearchParams({...fields, csrf: state.csrf}),
+      signal: AbortSignal.timeout(8000)
+    });
+  }
+  async function refresh() {
+    try {
+      const response = await fetch(base + '/state', {cache: 'no-store', signal: AbortSignal.timeout(8000)});
+      if (response.ok) apply(await response.json());
+    } catch (_) { /* EventSource will reconnect with a fresh full snapshot. */ }
+  }
+  async function control(action) {
+    if (controlling) return;
+    controlling = true;
+    error.textContent = '';
+    render();
+    try {
+      const response = await send('/action', {action, version: state.version});
+      if (response.ok) apply(await response.json());
+      else { error.textContent = 'The game has moved on. Please try the current control.'; await refresh(); }
+    } catch (_) {
+      error.textContent = 'Connection interrupted. Reconnecting… Check the current screen before trying again.';
+      await refresh();
+    } finally { controlling = false; render(); }
+  }
+  async function flushAnswer() {
+    if (sending || !pending || state.phase !== 'open') return;
+    // Serialize requests and keep just the newest tap. A delayed earlier tap
+    // cannot arrive after the final choice and silently replace it.
+    const pick = pending;
+    sending = true;
+    render();
+    let retry = false;
+    try {
+      const response = await send('/answer', {question: pick.index, option: pick.option});
+      if (response.ok) {
+        apply(await response.json());
+        if (pending === pick) pending = null;
+        error.textContent = '';
+      } else if (response.status === 409) {
+        pending = null;
+        error.textContent = 'This question has closed. Only saved answers count.';
+        await refresh();
+      } else {
+        pending = null;
+        error.textContent = 'Your answer was not saved. Please reconnect and try again.';
+      }
+    } catch (_) {
+      retry = state.phase === 'open' && state.index === pick.index;
+      if (retry) error.textContent = 'Answer not confirmed. Retrying when connected…';
+    } finally {
+      sending = false;
+      render();
+      if (pending && state.phase === 'open') setTimeout(flushAnswer, retry ? 1500 + Math.random() * 1000 : 0);
+    }
+  }
+  async function heartbeat() {
+    if (moderator || !state.name || state.phase === 'ended') return;
+    if (Date.now() - lastHeartbeat < 14000) return;
+    lastHeartbeat = Date.now();
+    try { await send('/heartbeat', {}); } catch (_) { /* lease expires during a prolonged outage */ }
+  }
+  function connect() {
+    if (state.phase === 'ended' || source) return;
+    lastEvent = Date.now();
+    source = new EventSource(base + '/events');
+    source.addEventListener('state', event => {
+      lastEvent = Date.now();
+      status.textContent = 'Live';
+      heartbeat();
+      apply(JSON.parse(event.data));
+    });
+    source.addEventListener('ping', () => { lastEvent = Date.now(); heartbeat(); });
+    source.addEventListener('open', () => { status.textContent = 'Live'; heartbeat(); });
+    source.addEventListener('error', () => { status.textContent = 'Reconnecting…'; });
+    source.addEventListener('unavailable', () => { stop(); status.textContent = 'Game unavailable'; });
+    // HTTP/1.1 EventSource reconnects automatically; periodic client heartbeats
+    // distinguish a connected reader from a dead Wi-Fi/TCP session.
+    clearInterval(heartbeatTimer);
+    heartbeatTimer = setInterval(heartbeat, 15000);
+    clearInterval(watchdog);
+    watchdog = setInterval(() => {
+      if (Date.now() - lastEvent > 35000) {
+        stop();
+        status.textContent = 'Reconnecting…';
+        reconnectTimer = setTimeout(connect, Math.random() * 1000);
+      }
+    }, 5000);
+  }
+  function stop() {
+    source?.close(); source = null;
+    clearInterval(heartbeatTimer);
+    clearInterval(watchdog);
+    clearTimeout(reconnectTimer);
+  }
+  window.addEventListener('pagehide', stop);
+  window.addEventListener('pageshow', connect);
+  window.addEventListener('online', () => {
+    stop();
+    reconnectTimer = setTimeout(() => { connect(); flushAnswer(); }, Math.random() * 800);
+  });
+  document.addEventListener('visibilitychange', () => {
+    if (!document.hidden) { heartbeat(); refresh(); connect(); }
+  });
+  render();
+  connect();
+})();
