+// Build an explicit public projection: never serialize Game/Question directly.
+fn snapshot(app: &App, code: &str, headers: &HeaderMap, moderator: bool) -> AppResult<Value> {
+    let db = app.db.lock().unwrap();
+    let g = game(&db, code)?;
+    let p = if moderator {
+        None
+    } else {
+        player(&db, &g, headers)?
+    };
+    let mut state = json!({"title":g.title, "phase":g.phase, "version":g.version, "revision":g.revision,
+        "index":g.index, "total":g.questions.len(), "name":p.as_ref().map(|p| &p.name),
+        "csrf":if moderator { Some(app.csrf.clone()) } else { p.as_ref().map(|p| player_csrf(app,p)) },
+        "selected":null});
+    let active = if moderator {
+        app.live.active(g.id)
+    } else {
+        vec![]
+    };
+    if moderator {
+        state["players"] = json!(active.len());
+        state["quiz_id"] = json!(g.quiz_id);
+    }
+    if matches!(g.phase.as_str(), "open" | "closed") && (moderator || p.is_some()) {
+        let q = g.questions.get(g.index).ok_or(AppError::BadRequest)?;
+        let mut stmt = db.prepare(
+            "SELECT player_id, option_index FROM answers WHERE game_id=? AND question_index=?",
+        )?;
+        let answers = stmt
+            .query_map(params![g.id, g.index], |r| {
+                Ok((r.get::<_, i64>(0)?, r.get::<_, usize>(1)?))
+            })?
+            .collect::<Result<Vec<_>, _>>()?;
+        let selected = p
+            .as_ref()
+            .and_then(|p| answers.iter().find(|a| a.0 == p.id).map(|a| a.1));
+        state["selected"] = json!(selected);
+        let options: Vec<_> = q
+            .options
+            .iter()
+            .enumerate()
+            .map(|(i, o)| {
+                let mut choice = json!({"text":o.text});
+                if g.phase == "closed" {
+                    choice["correct"] = json!(o.correct);
+                    choice["count"] = json!(answers.iter().filter(|a| a.1 == i).count());
+                }
+                choice
+            })
+            .collect();
+        state["question"] = json!({"text":q.text, "options":options});
+        if moderator {
+            state["answers"] = json!(answers.len());
+        }
+        if !moderator && g.phase == "closed" {
+            state["result"] = json!(match selected {
+                None => "No answer",
+                Some(i) if q.options[i].correct => "Correct!",
+                _ => "Wrong!",
+            });
+        }
+    }
+    Ok(state)
+}
