+pub fn initialize_db(db: &Connection) -> rusqlite::Result<()> {
+    db.execute_batch("
+        CREATE TABLE IF NOT EXISTS games (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            quiz_id INTEGER NOT NULL REFERENCES quizzes(id) ON DELETE CASCADE,
+            code TEXT NOT NULL UNIQUE,
+            title TEXT NOT NULL,
+            questions TEXT NOT NULL,
+            phase TEXT NOT NULL DEFAULT 'waiting' CHECK(phase IN ('waiting','open','closed','ended')),
+            current_question INTEGER NOT NULL DEFAULT 0,
+            version INTEGER NOT NULL DEFAULT 0,
+            revision INTEGER NOT NULL DEFAULT 0
+        );
+        CREATE INDEX IF NOT EXISTS games_quiz ON games(quiz_id);
+        CREATE TABLE IF NOT EXISTS players (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            name TEXT NOT NULL,
+            token TEXT NOT NULL UNIQUE,
+            UNIQUE(game_id, id)
+        );
+        CREATE TABLE IF NOT EXISTS answers (
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            player_id INTEGER NOT NULL,
+            question_index INTEGER NOT NULL,
+            option_index INTEGER NOT NULL,
+            PRIMARY KEY(game_id, question_index, player_id),
+            FOREIGN KEY(game_id, player_id) REFERENCES players(game_id, id) ON DELETE CASCADE
+        );
+    ")
+}
