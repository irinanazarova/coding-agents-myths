+async fn create(
+    State(app): State<AppState>,
+    Path(id): Path<i64>,
+    Form(fields): Form<Fields>,
+) -> AppResult<Redirect> {
+    verify_csrf(&app, &fields)?;
+    let mut db = app.db.lock().unwrap();
+    let tx = db.transaction()?;
+    let quiz = get_quiz(&tx, id)?;
+    let questions: Vec<_> = get_questions(&tx, id)?
+        .into_iter()
+        .filter(|q| q.active)
+        .collect();
+    let code = loop {
+        let candidate = random_hex(4);
+        if !tx.query_row(
+            "SELECT EXISTS(SELECT 1 FROM games WHERE code=?)",
+            [&candidate],
+            |r| r.get::<_, bool>(0),
+        )? {
+            break candidate;
+        }
+    };
+    tx.execute(
+        "INSERT INTO games(quiz_id, code, title, questions) VALUES(?,?,?,?)",
+        params![
+            id,
+            code,
+            quiz.title,
+            serde_json::to_string(&questions).unwrap()
+        ],
+    )?;
+    tx.commit()?;
+    Ok(Redirect::to(&format!("/moderate/games/{code}")))
+}
