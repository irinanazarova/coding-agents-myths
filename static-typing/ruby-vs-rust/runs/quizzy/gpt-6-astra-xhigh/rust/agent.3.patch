+async fn join(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> AppResult<Response> {
+    // Joining is public, but a foreign website must not silently assign a name.
+    if let Some(origin) = headers.get(header::ORIGIN) {
+        let expected = join_url(&headers, &code)?.replace(&format!("/play/{code}"), "");
+        if origin.to_str().ok() != Some(expected.as_str()) {
+            return Err(AppError::Forbidden);
+        }
+    }
+    let db = app.db.lock().unwrap();
+    let g = game(&db, &code)?;
+    if g.phase == "ended" {
+        return Err(AppError::Conflict);
+    }
+    if player(&db, &g, &headers)?.is_some() {
+        return Ok(Redirect::to(&format!("/play/{code}")).into_response());
+    }
+    let name = fields.get("name").map(|s| s.trim()).unwrap_or("");
+    if name.is_empty() || name.chars().count() > 80 {
+        drop(db);
+        return Ok((
+            StatusCode::UNPROCESSABLE_ENTITY,
+            page(
+                &app,
+                &code,
+                &headers,
+                false,
+                "Enter your name (1–80 characters).",
+            )?,
+        )
+            .into_response());
+    }
+    let token = random_hex(32);
+    db.execute(
+        "INSERT INTO players(game_id, name, token) VALUES(?,?,?)",
+        params![g.id, name, token],
+    )?;
+    let cookie = format!(
+        "quizzy_player_{code}={token}; Path=/play/{code}; HttpOnly; SameSite=Lax; Max-Age=31536000"
+    );
+    let mut response = Redirect::to(&format!("/play/{code}")).into_response();
+    response
+        .headers_mut()
+        .insert(header::SET_COOKIE, cookie.parse().unwrap());
+    Ok(response)
+}
+async fn answer(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> AppResult<Json<Value>> {
+    {
+        let mut connection = app.db.lock().unwrap();
+        let db = connection.transaction()?;
+        let g = game(&db, &code)?;
+        let p = player(&db, &g, &headers)?.ok_or(AppError::Forbidden)?;
+        verify_player(&app, &p, &fields)?;
+        let index = fields
+            .get("question")
+            .and_then(|s| s.parse::<usize>().ok())
+            .ok_or(AppError::BadRequest)?;
+        let choice = fields
+            .get("option")
+            .and_then(|s| s.parse::<usize>().ok())
+            .ok_or(AppError::BadRequest)?;
+        if g.phase != "open" || index != g.index {
+            return Err(AppError::Conflict);
+        }
+        if choice >= g.questions[g.index].options.len() {
+            return Err(AppError::BadRequest);
+        }
+        // The database mutex serializes answer writes and closing a question.
+        db.execute("INSERT INTO answers(game_id, player_id, question_index, option_index) VALUES(?,?,?,?) ON CONFLICT(game_id,question_index,player_id) DO UPDATE SET option_index=excluded.option_index", params![g.id, p.id, index, choice])?;
+        db.execute("UPDATE games SET revision=revision+1 WHERE id=?", [g.id])?;
+        db.commit()?;
+        app.live.heartbeat(g.id, p.id);
+        app.live.notify(g.id);
+    }
+    Ok(Json(snapshot(&app, &code, &headers, false)?))
+}
+async fn heartbeat(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> AppResult<StatusCode> {
+    let db = app.db.lock().unwrap();
+    let g = game(&db, &code)?;
+    let p = player(&db, &g, &headers)?.ok_or(AppError::Forbidden)?;
+    verify_player(&app, &p, &fields)?;
+    app.live.heartbeat(g.id, p.id);
+    Ok(StatusCode::NO_CONTENT)
+}
+async fn action(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> AppResult<Json<Value>> {
+    verify_csrf(&app, &fields)?;
+    {
+        let db = app.db.lock().unwrap();
+        let g = game(&db, &code)?;
+        if fields.get("version").and_then(|s| s.parse::<i64>().ok()) != Some(g.version) {
+            return Err(AppError::Conflict);
+        }
+        let action = fields.get("action").map(String::as_str).unwrap_or("");
+        let (phase, index) = match (g.phase.as_str(), action) {
+            ("waiting", "start") if g.questions.is_empty() => ("ended", 0),
+            ("waiting", "start") => ("open", 0),
+            ("open", "finish") => ("closed", g.index),
+            ("closed", "next") if g.index + 1 < g.questions.len() => ("open", g.index + 1),
+            ("closed", "end") if g.index + 1 >= g.questions.len() => ("ended", g.index),
+            _ => return Err(AppError::Conflict),
+        };
+        db.execute(
+            "UPDATE games SET phase=?, current_question=?, version=version+1, revision=revision+1 WHERE id=?",
+            params![phase, index, g.id],
+        )?;
+        app.live.notify(g.id);
+    }
+    Ok(Json(snapshot(&app, &code, &headers, true)?))
+}
