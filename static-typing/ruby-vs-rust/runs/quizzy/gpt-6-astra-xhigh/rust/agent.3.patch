+struct Game {
+    id: i64,
+    quiz_id: i64,
+    code: String,
+    title: String,
+    questions: Vec<Question>,
+    phase: String,
+    index: usize,
+    version: i64,
+    revision: i64,
+}
+struct Player {
+    id: i64,
+    name: String,
+    token: String,
+}
+fn game(db: &Connection, code: &str) -> AppResult<Game> {
+    db.query_row("SELECT id, quiz_id, code, title, questions, phase, current_question, version, revision FROM games WHERE code=?", [code], |r| {
+        let raw: String = r.get(4)?;
+        let questions = serde_json::from_str(&raw).map_err(|e| rusqlite::Error::FromSqlConversionFailure(4, rusqlite::types::Type::Text, Box::new(e)))?;
+        Ok(Game { id: r.get(0)?, quiz_id: r.get(1)?, code: r.get(2)?, title: r.get(3)?, questions, phase: r.get(5)?, index: r.get(6)?, version: r.get(7)?, revision: r.get(8)? })
+    }).optional()?.ok_or(AppError::NotFound)
+}
+fn player(db: &Connection, game: &Game, headers: &HeaderMap) -> AppResult<Option<Player>> {
+    let name = format!("quizzy_player_{}", game.code);
+    let token = headers
+        .get(header::COOKIE)
+        .and_then(|h| h.to_str().ok())
+        .and_then(|cookies| {
+            cookies.split(';').find_map(|part| {
+                let (key, value) = part.trim().split_once('=')?;
+                (key == name).then_some(value)
+            })
+        });
+    let Some(token) = token else { return Ok(None) };
+    Ok(db
+        .query_row(
+            "SELECT id, name, token FROM players WHERE game_id=? AND token=?",
+            params![game.id, token],
+            |r| {
+                Ok(Player {
+                    id: r.get(0)?,
+                    name: r.get(1)?,
+                    token: r.get(2)?,
+                })
+            },
+        )
+        .optional()?)
+}
+fn random_hex(bytes: usize) -> String {
+    let mut raw = vec![0u8; bytes];
+    getrandom::getrandom(&mut raw).expect("OS random source");
+    raw.iter().map(|b| format!("{b:02X}")).collect()
+}
+fn player_csrf(app: &App, player: &Player) -> String {
+    let mut mac = Hmac::<Sha256>::new_from_slice(app.csrf.as_bytes()).expect("HMAC key");
+    mac.update(b"Quizzy player action\0");
+    mac.update(player.token.as_bytes());
+    STANDARD.encode(mac.finalize().into_bytes())
+}
+fn verify_player(app: &App, player: &Player, fields: &Fields) -> AppResult<()> {
+    if fields
+        .get("csrf")
+        .is_some_and(|s| constant_eq(s.as_bytes(), player_csrf(app, player).as_bytes()))
+    {
+        Ok(())
+    } else {
+        Err(AppError::Forbidden)
+    }
+}
+fn join_url(headers: &HeaderMap, code: &str) -> AppResult<String> {
+    let host = headers
+        .get(header::HOST)
+        .and_then(|h| h.to_str().ok())
+        .ok_or(AppError::BadRequest)?;
+    host.parse::<axum::http::uri::Authority>()
+        .map_err(|_| AppError::BadRequest)?;
+    Ok(format!("http://{host}/play/{code}"))
+}
