+#!/usr/bin/env python3
+"""Offline launcher/restart with a live SSE connection and durable identity/answers."""
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import socket
+import subprocess
+import time
+import urllib.request
+import smoke
+import live_game
+
+ROOT = Path(__file__).resolve().parents[1]
+with socket.socket() as sock:
+    sock.bind(('127.0.0.1', 0))
+    port = sock.getsockname()[1]
+smoke.BASE = live_game.BASE = f'http://127.0.0.1:{port}'
+env = dict(os.environ, PORT=str(port), SECRET_KEY_BASE='live-persistence-secret',
+           QUIZZY_MODERATOR_USERNAME=smoke.USER, QUIZZY_MODERATOR_PASSWORD=smoke.PASSWORD)
+process = quiz = token = stream = None
+log = (ROOT / 'storage/live-persistence.log').open('w')
+
+
+def start():
+    global process
+    process = subprocess.Popen(['bin/serve'], cwd=ROOT, env=env, stdout=log, stderr=log)
+    for _ in range(300):
+        if process.poll() is not None: raise RuntimeError('bin/serve exited')
+        try:
+            if smoke.request('/up', auth=None)[0] == 200: return
+        except Exception: pass
+        time.sleep(.1)
+    raise RuntimeError('Server not ready')
+
+
+def stop():
+    if process and process.poll() is None:
+        process.send_signal(signal.SIGINT)
+        process.wait(timeout=8)
+
+try:
+    start()
+    token = smoke.csrf('/moderate/quizzes/new')
+    quiz = smoke.post('/moderate/quizzes', {'title': 'Persisted live quiz'}, token)[1]['Location']
+    fields = {'question': 'Persisted question', 'option_1': 'Yes', 'correct_1': 'on', 'option_2': 'No', 'active': 'on'}
+    smoke.post(quiz + '/questions', fields, token)
+    game = smoke.post(quiz + '/games', {}, token)[1]['Location']
+    link = '/play/' + game.split('/')[-1]
+    player = live_game.Player()
+    player.request(link + '/join', {'name': 'Alice'})
+    a = player.state(link)
+    assert smoke.post(game + '/action', {'action': 'start', 'version': a['version']}, token)[0] == 200
+    a = player.state(link)
+    assert player.request(link + '/answer', {'csrf': a['csrf'], 'question': 0, 'option': 0})[0] == 200
+    before = player.state(link)
+    # Changes to the template cannot alter an existing game's question/title.
+    question_id = re.search(r'id="question-(\d+)"', smoke.request(quiz)[2])[1]
+    smoke.post(quiz + '/questions/' + question_id, dict(fields, question='Edited template'), token)
+    smoke.post(quiz, {'title': 'Edited template title'}, token)
+    assert player.state(link) == before
+    stream = player.http.open(smoke.BASE + link + '/events', timeout=8)
+    assert stream.headers['Content-Type'].startswith('text/event-stream')
+    assert b'event: state' in stream.readline()
+    stop()  # Must not hang waiting forever for the open EventSource.
+    stream.close()
+    stream = None
+    start()
+    assert player.state(link) == before
+    assert smoke.post(game + '/action', {'action': 'finish', 'version': before['version']}, token)[0] == 200
+    a = player.state(link)
+    assert a['result'] == 'Correct!' and a['question']['options'][0]['count'] == 1
+    stop()
+    start()
+    assert player.state(link) == a
+    smoke.post(game + '/action', {'action': 'end', 'version': a['version']}, token)
+    stop()
+    start()
+    assert 'The quiz is over' in player.request(link)[1]
+    print('PASS: offline startup, live SSE shutdown, immutable snapshot, durable player/cookie/answer/open/closed/ended states across restarts')
+finally:
+    if stream: stream.close()
+    if quiz and process and process.poll() is None: smoke.post(quiz + '/delete', {}, token)
+    stop()
+    log.close()
