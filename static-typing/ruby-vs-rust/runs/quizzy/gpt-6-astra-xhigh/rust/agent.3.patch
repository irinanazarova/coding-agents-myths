+fn events(app: AppState, code: String, headers: HeaderMap, moderator: bool) -> AppResult<Response> {
+    let (id, pid) = {
+        let db = app.db.lock().unwrap();
+        let g = game(&db, &code)?;
+        let pid = if moderator || g.phase == "ended" {
+            None
+        } else {
+            player(&db, &g, &headers)?.map(|p| p.id)
+        };
+        (g.id, pid)
+    };
+    // Subscribe before reading state so changes during connection setup aren't lost.
+    let mut changed = app.live.subscribe(id);
+    if let Some(pid) = pid {
+        app.live.connected(id, pid);
+    }
+    let guard = PresenceGuard {
+        app: app.clone(),
+        game: id,
+        player: pid,
+    };
+    let stream = async_stream::stream! {
+        let _guard = guard;
+        let mut previous = String::new();
+        let mut sent = Instant::now();
+        loop {
+            if app.live.stopping.load(std::sync::atomic::Ordering::Relaxed) { break; }
+            changed.borrow_and_update();
+            let state = match snapshot(&app, &code, &headers, moderator) {
+                Ok(state) => state,
+                Err(_) => { yield Ok::<Event, Infallible>(Event::default().event("unavailable").data("Game unavailable")); break; }
+            };
+            let done = state["phase"] == "ended";
+            let data = serde_json::to_string(&state).unwrap();
+            let mut visible = state;
+            visible.as_object_mut().unwrap().remove("revision");
+            let fingerprint = serde_json::to_string(&visible).unwrap();
+            if fingerprint != previous {
+                yield Ok::<Event, Infallible>(Event::default().event("state").retry(Duration::from_secs(2)).data(data));
+                previous = fingerprint;
+                sent = Instant::now();
+            } else if sent.elapsed() >= Duration::from_secs(10) {
+                yield Ok::<Event, Infallible>(Event::default().event("ping").data("1"));
+                sent = Instant::now();
+            }
+            if done { break; }
+            tokio::select! {
+                _ = changed.changed() => {},
+                _ = tokio::time::sleep(Duration::from_secs(10)) => {},
+            }
+            // One slow phone never queues the whole room's answer traffic. Watch
+            // retains only the latest change; short bursts become one snapshot.
+            tokio::time::sleep(Duration::from_millis(75)).await;
+        }
+    };
+    let mut response = Sse::new(stream)
+        .keep_alive(KeepAlive::new().interval(Duration::from_secs(12)))
+        .into_response();
+    response
+        .headers_mut()
+        .insert("x-accel-buffering", HeaderValue::from_static("no"));
+    response
+        .headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    Ok(response)
+}
+
+pub fn history(db: &Connection, quiz_id: i64) -> AppResult<String> {
+    use std::fmt::Write;
+    let mut stmt = db.prepare("SELECT code, phase FROM games WHERE quiz_id=? ORDER BY id DESC")?;
+    let mut html = String::new();
+    for row in stmt.query_map([quiz_id], |r| {
+        Ok((r.get::<_, String>(0)?, r.get::<_, String>(1)?))
+    })? {
+        let (code, phase) = row?;
+        let _ = write!(
+            html,
+            r#"<li class="card game-row"><a href="/moderate/games/{code}">Game {code}</a><span class="badge">{phase}</span></li>"#
+        );
+    }
+    if html.is_empty() {
+        Ok(html)
+    } else {
+        Ok(format!(
+            r#"<section class="section"><h2>Games</h2><ul class="list-reset game-history" aria-label="Games">{html}</ul></section>"#
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn fixture() -> AppState {
+        let db = Connection::open_in_memory().unwrap();
+        crate::initialize_db(&db).unwrap();
+        initialize_db(&db).unwrap();
+        initialize_db(&db).unwrap();
+        db.execute("INSERT INTO quizzes(title) VALUES ('Original quiz')", [])
+            .unwrap();
+        let questions = json!([
+            {"id":1,"text":"Current","active":true,"options":[{"text":"Yes","correct":true},{"text":"No","correct":false}]},
+            {"id":2,"text":"Future secret","active":true,"options":[{"text":"Later","correct":true},{"text":"Other","correct":false}]}
+        ]);
+        db.execute("INSERT INTO games(quiz_id,code,title,questions,phase) VALUES(1,'ABCD','Snapshot title',?,'open')", [questions.to_string()]).unwrap();
+        db.execute(
+            "INSERT INTO players(game_id,name,token) VALUES(1,'Alice','private-token')",
+            [],
+        )
+        .unwrap();
+        Arc::new(App {
+            db: Mutex::new(db),
+            credentials: "u:p".into(),
+            csrf: "moderator-secret".into(),
+            live: Hub::default(),
+        })
+    }
+    fn headers() -> HeaderMap {
+        HeaderMap::from_iter([(
+            header::COOKIE,
+            HeaderValue::from_static("quizzy_player_ABCD=private-token"),
+        )])
+    }
+    #[test]
+    fn public_projection_and_results_never_leak_future_answers() {
+        let app = fixture();
+        let state = snapshot(&app, "ABCD", &headers(), false).unwrap();
+        assert_eq!(state["name"], "Alice");
+        assert!(state["question"]["options"][0].get("correct").is_none());
+        assert!(state["question"]["options"][0].get("count").is_none());
+        assert!(!state.to_string().contains("Future secret"));
+        assert!(!state.to_string().contains("private-token"));
+        assert!(!state.to_string().contains("moderator-secret"));
+        assert!(
+            snapshot(&app, "ABCD", &HeaderMap::new(), false)
+                .unwrap()
+                .get("question")
+                .is_none()
+        );
+        app.db
+            .lock()
+            .unwrap()
+            .execute("UPDATE games SET phase='closed'", [])
+            .unwrap();
+        let state = snapshot(&app, "ABCD", &headers(), false).unwrap();
+        assert_eq!(state["result"], "No answer");
+        assert_eq!(state["question"]["options"][0]["correct"], true);
+        assert!(!state.to_string().contains("Future secret"));
+    }
+    #[test]
+    fn presence_deduplicates_tabs_expires_and_drops_without_erasing_answers() {
+        let app = fixture();
+        app.live.connected(1, 1);
+        app.live.connected(1, 1);
+        assert_eq!(app.live.active(1), [1]);
+        app.live.disconnected(1, 1);
+        assert_eq!(app.live.active(1), [1]);
+        app.live
+            .rooms
+            .lock()
+            .unwrap()
+            .get_mut(&1)
+            .unwrap()
+            .players
+            .get_mut(&1)
+            .unwrap()
+            .seen = Instant::now() - Duration::from_secs(46);
+        assert!(app.live.active(1).is_empty());
+        app.live.heartbeat(1, 1);
+        assert_eq!(app.live.active(1), [1]);
+        let guard = PresenceGuard {
+            app: app.clone(),
+            game: 1,
+            player: Some(1),
+        };
+        drop(guard);
+        assert!(app.live.active(1).is_empty());
+    }
+    #[test]
+    fn game_records_cascade_and_use_immutable_quiz_snapshot() {
+        let app = fixture();
+        let db = app.db.lock().unwrap();
+        db.execute("UPDATE quizzes SET title='Edited quiz'", [])
+            .unwrap();
+        assert_eq!(game(&db, "ABCD").unwrap().title, "Snapshot title");
+        db.execute("INSERT INTO answers VALUES(1,1,0,0)", [])
+            .unwrap();
+        db.execute("DELETE FROM quizzes", []).unwrap();
+        for table in ["games", "players", "answers"] {
+            assert_eq!(
+                db.query_row(&format!("SELECT COUNT(*) FROM {table}"), [], |r| r
+                    .get::<_, i64>(0))
+                    .unwrap(),
+                0
+            );
+        }
+    }
+}
