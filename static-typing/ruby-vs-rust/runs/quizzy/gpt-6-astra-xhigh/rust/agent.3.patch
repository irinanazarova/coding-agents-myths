+#[derive(Default)]
+pub struct Hub {
+    rooms: Mutex<HashMap<i64, Room>>,
+    stopping: std::sync::atomic::AtomicBool,
+}
+struct Room {
+    changed: watch::Sender<u64>,
+    players: HashMap<i64, Presence>,
+}
+struct Presence {
+    connections: usize,
+    seen: Instant,
+}
+impl Default for Room {
+    fn default() -> Self {
+        Self {
+            changed: watch::channel(0).0,
+            players: HashMap::new(),
+        }
+    }
+}
+impl Hub {
+    pub fn shutdown(&self) {
+        self.stopping
+            .store(true, std::sync::atomic::Ordering::Relaxed);
+        for room in self.rooms.lock().unwrap().values() {
+            room.changed.send_modify(|v| *v = v.wrapping_add(1));
+        }
+    }
+    fn subscribe(&self, game: i64) -> watch::Receiver<u64> {
+        self.rooms
+            .lock()
+            .unwrap()
+            .entry(game)
+            .or_default()
+            .changed
+            .subscribe()
+    }
+    fn notify(&self, game: i64) {
+        if let Some(room) = self.rooms.lock().unwrap().get_mut(&game) {
+            room.changed
+                .send_modify(|version| *version = version.wrapping_add(1));
+        }
+    }
+    fn connected(&self, game: i64, player: i64) {
+        let mut rooms = self.rooms.lock().unwrap();
+        let room = rooms.entry(game).or_default();
+        let presence = room.players.entry(player).or_insert(Presence {
+            connections: 0,
+            seen: Instant::now(),
+        });
+        presence.connections += 1;
+        presence.seen = Instant::now();
+        room.changed.send_modify(|v| *v = v.wrapping_add(1));
+    }
+    fn disconnected(&self, game: i64, player: i64) {
+        let mut rooms = self.rooms.lock().unwrap();
+        if let Some(room) = rooms.get_mut(&game) {
+            if let Some(presence) = room.players.get_mut(&player) {
+                presence.connections = presence.connections.saturating_sub(1);
+                if presence.connections == 0 {
+                    room.players.remove(&player);
+                }
+            }
+            room.changed.send_modify(|v| *v = v.wrapping_add(1));
+        }
+    }
+    fn heartbeat(&self, game: i64, player: i64) {
+        let mut rooms = self.rooms.lock().unwrap();
+        if let Some(room) = rooms.get_mut(&game)
+            && let Some(presence) = room.players.get_mut(&player)
+        {
+            let expired = presence.seen.elapsed() > Duration::from_secs(45);
+            presence.seen = Instant::now();
+            if expired {
+                room.changed.send_modify(|v| *v = v.wrapping_add(1));
+            }
+        }
+    }
+    fn active(&self, game: i64) -> Vec<i64> {
+        self.rooms
+            .lock()
+            .unwrap()
+            .get(&game)
+            .map(|room| {
+                room.players
+                    .iter()
+                    .filter(|(_, p)| {
+                        p.connections > 0 && p.seen.elapsed() <= Duration::from_secs(45)
+                    })
+                    .map(|(id, _)| *id)
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+}
+struct PresenceGuard {
+    app: AppState,
+    game: i64,
+    player: Option<i64>,
+}
+impl Drop for PresenceGuard {
+    fn drop(&mut self) {
+        if let Some(player) = self.player {
+            self.app.live.disconnected(self.game, player);
+        }
+    }
+}
