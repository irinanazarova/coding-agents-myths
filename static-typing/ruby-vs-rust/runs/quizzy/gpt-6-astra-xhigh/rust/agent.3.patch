+fn page(
+    app: &App,
+    code: &str,
+    headers: &HeaderMap,
+    moderator: bool,
+    error: &str,
+) -> AppResult<Html<String>> {
+    use views::escape as e;
+    let state = snapshot(app, code, headers, moderator)?;
+    let title = state["title"].as_str().unwrap();
+    let base = if moderator {
+        format!("/moderate/games/{code}")
+    } else {
+        format!("/play/{code}")
+    };
+    let initial = if state["phase"] == "ended" {
+        "<h1>The quiz is over</h1>".to_owned()
+    } else if !moderator && state["name"].is_null() {
+        format!(
+            r#"<h1>{}</h1><p class="meta">Join the room. Be part of the talk.</p>
+<form method="post" action="{base}/join" class="join-form"><div class="field"><label for="name">Your name</label><input class="input" id="name" name="name" aria-label="Your name" maxlength="80" autocomplete="nickname" required></div><p class="live-error" role="alert">{}</p><button class="btn btn--pink" type="submit">Join</button></form>"#,
+            e(title),
+            e(error)
+        )
+    } else if let Some(name) = state["name"].as_str() {
+        format!(
+            "<h1>Hi, {}!</h1><p>Waiting for the quiz to start…</p>",
+            e(name)
+        )
+    } else {
+        format!("<h1>{}</h1>", e(title))
+    };
+    let welcome = if moderator {
+        let url = e(&join_url(headers, code)?);
+        format!(
+            r#"<section id="join-details" class="join-details"><div><p class="eyebrow">Scan. Join. Play.</p><p class="join-link" id="join-link">{url}</p><p class="meta">Open this link on your phone to join.</p></div><img class="join-qr" src="{base}/qr" alt="QR code for {url}" width="240" height="240"></section>"#
+        )
+    } else {
+        String::new()
+    };
+    let encoded = serde_json::to_string(&state)
+        .unwrap()
+        .replace('<', "\\u003c")
+        .replace('>', "\\u003e")
+        .replace('&', "\\u0026");
+    let back = if moderator {
+        format!(
+            r#"<a href="/moderate/quizzes/{}" class="live-back">← Back to quiz</a>"#,
+            state["quiz_id"]
+        )
+    } else {
+        String::new()
+    };
+    let body = format!(
+        r#"<div class="live-shell {}" id="live-game" data-code="{}" data-base="{base}" data-moderator="{moderator}">{back}<div class="live-top"><span class="logo"><span class="logo__mark">?</span>Quizzy</span><span id="connection-status" class="meta" role="status">Connecting…</span></div><main id="live-content" aria-live="polite">{initial}</main>{welcome}<p id="live-error" class="live-error" role="alert"></p><noscript>JavaScript is needed for live play.</noscript></div><script id="live-data" type="application/json">{encoded}</script><script src="/assets/live.js" defer></script>"#,
+        if moderator {
+            "live-screen"
+        } else {
+            "live-phone"
+        },
+        e(code)
+    );
+    Ok(Html(views::document(title, &body)))
+}
