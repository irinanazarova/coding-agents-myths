@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+"""Live-game HTTP regression; run against bin/serve. Browser coverage is separate."""
+import http.cookiejar
+import json
+import re
+import urllib.request
+import urllib.error
+from smoke import BASE, csrf, post, request
+
+class Player:
+    def __init__(self):
+        self.cookies = http.cookiejar.CookieJar()
+        self.http = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(self.cookies))
+
+    def request(self, path, data=None):
+        from urllib.parse import urlencode
+        req = urllib.request.Request(BASE + path, data=None if data is None else urlencode(data).encode())
+        try:
+            response = self.http.open(req, timeout=8)
+        except urllib.error.HTTPError as error:
+            response = error
+        return response.status, response.read().decode()
+
+    def state(self, link):
+        return json.loads(self.request(link + '/state')[1])
+
+
+def run():
+    token = csrf('/moderate/quizzes/new')
+    payload = {'title': 'Live regression', 'questions': [
+        {'text': 'First active', 'active': True, 'options': [{'text': 'Alpha', 'correct': True}, {'text': 'Beta'}]},
+        {'text': 'Hidden inactive', 'active': False, 'options': [{'text': 'Secret', 'correct': True}, {'text': 'Other'}]},
+        {'text': 'Last active', 'active': True, 'options': [{'text': 'One', 'correct': True}, {'text': 'Two', 'correct': True}, {'text': 'Three'}]},
+    ]}
+    status, headers, _ = post('/moderate/quizzes/import', {'quiz_json': json.dumps(payload)}, token)
+    assert status == 303
+    quiz = headers['Location']
+    try:
+        status, headers, _ = post(quiz + '/games', {}, token)
+        assert status == 303, 'Start a game must create a game'
+        game = headers['Location']
+        body = request(game)[2]
+        code = re.search(r'data-code="([A-Z0-9]+)"', body)[1]
+        link = '/play/' + code
+        alice, bob = Player(), Player()
+        assert 'Your name' in alice.request(link)[1]
+        assert alice.request(link + '/join', {'name': 'Alice'})[0] == 200
+        assert bob.request(link + '/join', {'name': 'Bob'})[0] == 200
+        a = alice.state(link)
+        assert a['name'] == 'Alice' and a['phase'] == 'waiting'
+        assert alice.request(link)[0] == 200
+        assert post(game + '/action', {'action': 'start', 'version': a['version']}, token)[0] == 200
+        a = alice.state(link)
+        assert a['phase'] == 'open' and a['total'] == 2
+        assert 'correct' not in json.dumps(a).lower()
+        source = alice.request(link)[1]
+        assert 'Hidden inactive' not in source
+        assert '"correct"' not in source
+        assert 'Last active' not in source
+        assert alice.request(link + '/answer', {'csrf': a['csrf'], 'question': 0, 'option': 1})[0] == 200
+        assert alice.request(link + '/answer', {'csrf': a['csrf'], 'question': 0, 'option': 0})[0] == 200
+        assert alice.state(link)['selected'] == 0
+        assert alice.request(link + '/answer', {'csrf': a['csrf'], 'question': 0, 'option': 55})[0] == 400
+        assert alice.request(link + '/answer', {'question': 0, 'option': 0})[0] == 403
+        assert post(game + '/action', {'action': 'finish', 'version': a['version']}, token)[0] == 200
+        a = alice.state(link)
+        assert a['result'] == 'Correct!' and bob.state(link)['result'] == 'No answer'
+        assert a['question']['options'][0]['count'] == 1
+        assert a['question']['options'][1]['count'] == 0
+        assert alice.request(link + '/answer', {'csrf': a['csrf'], 'question': 0, 'option': 1})[0] == 409
+        assert post(game + '/action', {'action': 'next', 'version': a['version']}, token)[0] == 200
+        assert post(game + '/action', {'action': 'next', 'version': a['version']}, token)[0] == 409
+        a = alice.state(link)
+        assert a['index'] == 1 and a['selected'] is None
+        assert alice.request(link + '/answer', {'csrf': a['csrf'], 'question': 0, 'option': 0})[0] == 409
+        assert alice.request(link + '/answer', {'csrf': a['csrf'], 'question': 1, 'option': 2})[0] == 200
+        late = Player()
+        assert late.request(link + '/join', {'name': 'Late'})[0] == 200
+        assert late.state(link)['phase'] == 'open'
+        assert post(game + '/action', {'action': 'finish', 'version': a['version']}, token)[0] == 200
+        a = alice.state(link)
+        assert a['result'] == 'Wrong!'
+        assert sum(o['correct'] for o in a['question']['options']) == 2
+        assert post(game + '/action', {'action': 'end', 'version': a['version']}, token)[0] == 200
+        assert alice.state(link)['phase'] == 'ended'
+        assert 'The quiz is over' in Player().request(link)[1]
+        assert Player().request(link + '/join', {'name': 'Too late'})[0] == 409
+        status, headers, _ = post(quiz + '/games', {}, token)
+        assert status == 303 and headers['Location'] != game
+        assert request(game, auth=None)[0] == 401
+        assert request(game + '/state', auth=None)[0] == 401
+        assert request(game + '/events', auth=None)[0] == 401
+        # The empty active-question set ends cleanly instead of indexing into it.
+        empty = post('/moderate/quizzes', {'title': 'Empty live regression'}, token)[1]['Location']
+        try:
+            empty_game = post(empty + '/games', {}, token)[1]['Location']
+            status, _, body = post(empty_game + '/action', {'action': 'start', 'version': 0}, token)
+            assert status == 200 and json.loads(body)['phase'] == 'ended'
+        finally:
+            post(empty + '/delete', {}, token)
+    finally:
+        post(quiz + '/delete', {}, token)
+    print('PASS: game lifecycle, independent games, inactive filtering, identity, answer changes, privacy, feedback, late joins, stale actions, auth/CSRF')
+
+if __name__ == '__main__':
+    run()
