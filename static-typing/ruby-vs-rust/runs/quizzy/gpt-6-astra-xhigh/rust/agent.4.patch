@@ -0,0 +1,153 @@
+//! Scores are derived from the immutable game questions and each player's final pick.
+use crate::*;
+
+#[derive(Debug, Serialize)]
+pub(crate) struct Standing {
+    #[serde(skip)]
+    pub id: i64,
+    pub name: String,
+    pub points: usize,
+    #[serde(skip)]
+    pub elapsed_us: i64,
+    pub place: usize,
+    pub winner: bool,
+}
+
+pub(crate) fn leaderboard(
+    db: &Connection,
+    game_id: i64,
+    questions: &[Question],
+) -> AppResult<Vec<Standing>> {
+    let mut stmt =
+        db.prepare("SELECT id, name, winner FROM players WHERE game_id=? ORDER BY id")?;
+    let mut rows = stmt
+        .query_map([game_id], |r| {
+            Ok(Standing {
+                id: r.get(0)?,
+                name: r.get(1)?,
+                winner: r.get(2)?,
+                points: 0,
+                elapsed_us: 0,
+                place: 0,
+            })
+        })?
+        .collect::<Result<Vec<_>, _>>()?;
+    let positions: HashMap<_, _> = rows.iter().enumerate().map(|(i, r)| (r.id, i)).collect();
+    let mut stmt = db.prepare(
+        "SELECT player_id, question_index, option_index, elapsed_us FROM answers WHERE game_id=?",
+    )?;
+    let answers = stmt.query_map([game_id], |r| {
+        Ok((
+            r.get::<_, i64>(0)?,
+            r.get::<_, usize>(1)?,
+            r.get::<_, usize>(2)?,
+            r.get::<_, i64>(3)?,
+        ))
+    })?;
+    for answer in answers {
+        let (player, question, option, elapsed) = answer?;
+        if questions
+            .get(question)
+            .and_then(|q| q.options.get(option))
+            .is_some_and(|o| o.correct)
+            && let Some(&position) = positions.get(&player)
+        {
+            rows[position].points += 1;
+            rows[position].elapsed_us = rows[position].elapsed_us.saturating_add(elapsed);
+        }
+    }
+    // Exact time ties have stable, unique places, independent of presence/name.
+    rows.sort_by_key(|r| (std::cmp::Reverse(r.points), r.elapsed_us, r.id));
+    for (i, row) in rows.iter_mut().enumerate() {
+        row.place = i + 1;
+    }
+    Ok(rows)
+}
+
+// Uniform bounded randomness, without modulo bias. The OS source is local.
+fn random_below(bound: usize) -> usize {
+    let bound = bound as u64;
+    let threshold = bound.wrapping_neg() % bound;
+    loop {
+        let mut bytes = [0; 8];
+        getrandom::getrandom(&mut bytes).expect("OS random source");
+        let value = u64::from_le_bytes(bytes);
+        if value >= threshold {
+            return (value % bound) as usize;
+        }
+    }
+}
+
+pub(crate) fn select(rows: &[Standing], number: i64, draw: bool) -> Vec<i64> {
+    let eligible: Vec<_> = rows.iter().filter(|r| r.points > 0).collect();
+    let count = number.max(0).min(eligible.len() as i64) as usize;
+    if count == 0 {
+        return vec![];
+    }
+    if !draw {
+        return eligible[..count].iter().map(|r| r.id).collect();
+    }
+    let cutoff = eligible[count - 1].points;
+    let mut winners: Vec<_> = eligible
+        .iter()
+        .filter(|r| r.points > cutoff)
+        .map(|r| r.id)
+        .collect();
+    let mut tied: Vec<_> = eligible
+        .iter()
+        .filter(|r| r.points == cutoff)
+        .map(|r| r.id)
+        .collect();
+    for i in (1..tied.len()).rev() {
+        let j = random_below(i + 1);
+        tied.swap(i, j);
+    }
+    winners.extend(tied.into_iter().take(count - winners.len()));
+    winners
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn rows(points: &[usize]) -> Vec<Standing> {
+        points
+            .iter()
+            .enumerate()
+            .map(|(i, &points)| Standing {
+                id: i as i64,
+                name: format!("Player {i}"),
+                points,
+                elapsed_us: i as i64,
+                place: i + 1,
+                winner: false,
+            })
+            .collect()
+    }
+    #[test]
+    fn top_and_draw_never_award_zero_points_or_duplicate_prizes() {
+        for draw in [false, true] {
+            assert!(select(&[], 3, draw).is_empty());
+            assert!(select(&rows(&[0, 0]), 3, draw).is_empty());
+            let mut selected = select(&rows(&[2, 1, 1, 0]), 10, draw);
+            selected.sort();
+            assert_eq!(selected, [0, 1, 2]);
+            assert_eq!(select(&rows(&[3, 2, 1]), 1, draw), [0]);
+        }
+        assert_eq!(select(&rows(&[2, 1, 1, 0]), 2, false), [0, 1]);
+    }
+    #[test]
+    fn draws_use_points_not_speed_and_replace_previous_selection() {
+        let mut seen = std::collections::HashSet::new();
+        let mut rows = rows(&[4, 3, 3, 3, 2, 0]);
+        rows[1].winner = true; // Previous winners have no advantage.
+        for _ in 0..128 {
+            let mut winners = select(&rows, 3, true);
+            winners.sort();
+            assert_eq!(winners.len(), 3);
+            assert_eq!(winners[0], 0);
+            assert!(winners[1] >= 1 && winners[2] <= 3 && winners[1] != winners[2]);
+            seen.insert(winners);
+        }
+        assert_eq!(seen.len(), 3);
+    }
+}
