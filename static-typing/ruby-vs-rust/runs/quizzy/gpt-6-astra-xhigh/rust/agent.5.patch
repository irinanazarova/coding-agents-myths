+#!/usr/bin/env python3
+"""Real Chromium countdown and settings, with an isolated player context."""
+import json
+import shutil
+import subprocess
+import time
+import urllib.request
+from browser import DevTools, ARTIFACTS
+from smoke import AUTH, csrf, post, request
+
+
+def run():
+    profile = ARTIFACTS / 'timer-profile'
+    shutil.rmtree(profile, ignore_errors=True)
+    with (ARTIFACTS / 'timer-chromium.log').open('w') as log:
+        process = subprocess.Popen(['chromium', '--headless=new', '--no-sandbox', '--disable-dev-shm-usage',
+            '--disable-background-networking', '--disable-component-update', '--disable-sync',
+            '--disable-background-timer-throttling', '--disable-renderer-backgrounding',
+            '--no-first-run', '--no-default-browser-check', '--remote-debugging-port=9226',
+            f'--user-data-dir={profile}', 'about:blank'], stdout=log, stderr=log)
+    root = quiz = None
+    clients = []
+    token = csrf('/moderate/quizzes/new')
+    try:
+        for _ in range(100):
+            try:
+                info = json.load(urllib.request.urlopen('http://127.0.0.1:9226/json/version', timeout=1))
+                break
+            except OSError: time.sleep(.1)
+        else: raise AssertionError('Chromium not ready')
+        root = DevTools(info['webSocketDebuggerUrl'])
+
+        def tab(moderator=False):
+            context = root.call('Target.createBrowserContext')['browserContextId']
+            target = root.call('Target.createTarget', {'url': 'about:blank', 'browserContextId': context})['targetId']
+            tabs = json.load(urllib.request.urlopen('http://127.0.0.1:9226/json/list'))
+            c = DevTools(next(t['webSocketDebuggerUrl'] for t in tabs if t['id'] == target))
+            clients.append(c)
+            for method in ['Page.enable', 'Runtime.enable', 'Network.enable', 'Log.enable']: c.call(method)
+            if moderator: c.call('Network.setExtraHTTPHeaders', {'headers': {'Authorization': AUTH}})
+            c.call('Emulation.setDeviceMetricsOverride', {'width': 1440 if moderator else 390, 'height': 1000 if moderator else 844, 'deviceScaleFactor': 1, 'mobile': not moderator})
+            return c
+
+        def text(c, value):
+            c.wait(f'document.body.innerText.includes({json.dumps(value)})')
+
+        def fill(c, label, value):
+            c.evaluate(f'(() => {{const input = [...document.querySelectorAll("label")].find(l=>l.textContent==={json.dumps(label)}).control; input.value={json.dumps(str(value))}; input.dispatchEvent(new Event("input",{{bubbles:true}}));}})()')
+
+        def settings(minutes, seconds):
+            mod.navigate(quiz)
+            mod.click('Settings')
+            fill(mod, 'Timer minutes', minutes)
+            fill(mod, 'Timer seconds', seconds)
+            mod.click('Save quiz')
+
+        def create_game():
+            mod.click('Start a game')
+            text(mod, 'Start')
+            assert mod.evaluate('document.querySelector("[role=timer]") === null')
+            return mod.evaluate('location.pathname'), mod.evaluate('document.getElementById("join-link").textContent')
+
+        payload = {'title': 'Conference timer', 'questions': [
+            {'text': 'First timed question', 'options': [{'text': 'Yes', 'correct': True}, {'text': 'No'}]},
+            {'text': 'Last timed question', 'options': [{'text': 'Yes', 'correct': True}, {'text': 'No'}]},
+        ]}
+        quiz = post('/moderate/quizzes/import', {'quiz_json': json.dumps(payload)}, token)[1]['Location']
+        mod, phone = tab(True), tab()
+        mod.navigate(quiz)
+        mod.click('Settings')
+        for name in ['timer_minutes', 'timer_seconds']:
+            assert mod.evaluate(f'document.querySelector("[name={name}]").value') == '0'
+            assert mod.evaluate(f'document.querySelector("[name={name}]").type') == 'number'
+        fill(mod, 'Timer minutes', 1)
+        fill(mod, 'Timer seconds', 30)
+        mod.screenshot('timer-settings.png')
+        mod.click('Save quiz')
+        mod.click('Settings')
+        assert mod.evaluate('document.querySelector("[name=timer_minutes]").value') == '1'
+        assert mod.evaluate('document.querySelector("[name=timer_seconds]").value') == '30'
+        mod.click('Save quiz')
+        create_game()
+        mod.click('Start')
+        mod.wait('document.querySelector("[role=timer]")?.textContent === "1:30"')
+        mod.screenshot('timer-stage.png')
+        mod.click('Finish')
+        text(mod, 'Next')
+        assert mod.evaluate('document.querySelector("[role=timer]") === null')
+        mod.click('Next')
+        mod.wait('document.querySelector("[role=timer]")?.textContent === "1:30"')
+        mod.click('Finish')
+        text(mod, 'End quiz')
+        mod.click('End quiz')
+        text(mod, 'The quiz is over')
+        settings(0, 6)
+        game, link = create_game()
+        phone.navigate(link)
+        phone.fill('Your name', 'Alice')
+        phone.click('Join')
+        text(phone, 'Waiting for the quiz to start')
+        mod.click('Start')
+        mod.wait('document.querySelector("[role=timer]")?.textContent === "0:06"')
+        text(phone, 'First timed question')
+        phone.click('Yes')
+        text(phone, 'Answer saved.')
+        phone_origin = phone.evaluate('performance.timeOrigin')
+        assert phone.evaluate('document.querySelector("[role=timer]") === null')
+        assert not phone.evaluate('document.body.innerText.includes("0:0")')
+        assert 'timer' not in phone.evaluate('JSON.parse(document.getElementById("live-data").textContent)')
+        deadline = json.loads(request(game + '/state')[2])['timer']['deadline_ms']
+        mod.wait('["0:04", "0:03"].includes(document.querySelector("[role=timer]")?.textContent)')
+        mod.navigate(game)
+        mod.wait('document.querySelector("[role=timer]")')
+        assert mod.evaluate('Number(document.querySelector("[role=timer]").textContent.split(":")[1])') <= 4
+        assert json.loads(request(game + '/state')[2])['timer']['deadline_ms'] == deadline
+        text(mod, 'Next')
+        text(phone, 'Correct!')
+        assert phone.evaluate('performance.timeOrigin') == phone_origin, 'Automatic feedback must not reload the phone'
+        assert phone.evaluate('[...document.querySelectorAll(".live-option")].every(e=>e.disabled)')
+        assert mod.evaluate('document.querySelector("[role=timer]") === null')
+        mod.click('Next')
+        text(phone, 'Last timed question')
+        mod.wait('document.querySelector("[role=timer]")?.textContent === "0:06"')
+        mod.navigate(quiz)  # The moderator leaves. Expiry must still push to players.
+        text(phone, 'No answer')
+        mod.navigate(game)
+        text(mod, 'End quiz')
+        assert mod.evaluate('document.querySelector("[role=timer]") === null')
+        mod.click('End quiz')
+        text(phone, 'The quiz is over')
+        settings(0, 0)
+        create_game()
+        mod.click('Start')
+        text(mod, 'Finish')
+        time.sleep(1.2)
+        assert mod.evaluate('document.querySelector("[role=timer]") === null')
+        text(mod, 'Finish')
+        mod.click('Finish')
+        text(mod, 'Next')
+        for c in clients:
+            assert c.evaluate('document.documentElement.scrollWidth <= innerWidth')
+            assert not [e for e in c.events if e.get('method') == 'Runtime.exceptionThrown']
+        print('PASS: Chromium exact settings labels, M:SS formatting, countdown/reload, manual/automatic Finish, fresh Next, stage disconnect, live player feedback/privacy, zero timer')
+    except Exception:
+        for i, c in enumerate(clients):
+            try:
+                print('PAGE', i, c.evaluate('document.body.innerText'))
+                c.screenshot(f'timer-failure-{i}.png')
+            except Exception: pass
+        raise
+    finally:
+        if quiz: post(quiz + '/delete', {}, token)
+        for c in clients: c.socket.close()
+        if root: root.socket.close()
+        process.terminate()
+        process.wait(timeout=10)
+
+
+if __name__ == '__main__': run()
