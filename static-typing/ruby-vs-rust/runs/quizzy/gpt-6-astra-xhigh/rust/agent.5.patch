+// All callers hold the database mutex. Manual Finish, the deadline worker,
+// and request-time expiry use the same idempotent transition.
+fn finish_question(db: &Connection, id: i64) -> AppResult<bool> {
+    Ok(db.execute("UPDATE games SET phase='closed', version=version+1, revision=revision+1 WHERE id=? AND phase='open'", [id])? > 0)
+}
+
+fn current_game(app: &App, db: &Connection, code: &str, now: i64) -> AppResult<Game> {
+    let mut g = game(db, code)?;
+    if g.deadline_us().is_some_and(|deadline| now >= deadline) && finish_question(db, g.id)? {
+        g.phase = "closed".into();
+        g.version += 1;
+        g.revision += 1;
+        app.live.notify(g.id);
+    }
+    Ok(g)
+}
+
+pub fn finish_expired(app: &App) -> AppResult<()> {
+    let db = app.db.lock().unwrap();
+    let mut stmt = db.prepare("SELECT id FROM games WHERE phase='open' AND timer_seconds>0 AND opened_at_us <= ? - timer_seconds * 1000000")?;
+    let ids = stmt
+        .query_map([now_us()], |r| r.get::<_, i64>(0))?
+        .collect::<Result<Vec<_>, _>>()?;
+    for id in ids {
+        if finish_question(&db, id)? {
+            app.live.notify(id);
+        }
+    }
+    Ok(())
+}
+
+pub async fn run_timers(app: AppState) {
+    let mut tick = tokio::time::interval(Duration::from_millis(100));
+    tick.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    loop {
+        tick.tick().await;
+        if app.live.stopping.load(std::sync::atomic::Ordering::Relaxed) {
+            break;
+        }
+        if let Err(error) = finish_expired(&app) {
+            eprintln!("Could not finish expired questions: {error:?}");
+        }
+    }
+}
