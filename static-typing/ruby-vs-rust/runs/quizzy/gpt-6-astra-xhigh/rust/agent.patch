+.live-option { width: 100%; height: 100%; text-align: left; background: white; border: 2px solid var(--c-blue); border-radius: 18px; color: var(--c-blue); padding: 20px 24px; font: inherit; font-size: 21px; display: flex; gap: 16px; flex-wrap: wrap; justify-content: space-between; align-items: center; }
+button.live-option { cursor: pointer; touch-action: manipulation; }
+button.live-option:not(:disabled):hover { box-shadow: 0 0 0 2px var(--c-blue); }
+button.live-option:disabled { cursor: default; opacity: 1; }
+.live-screen .live-option { font-size: clamp(22px, 2.2vw, 34px); min-height: 110px; }
+.live-option-text { overflow-wrap: anywhere; min-width: 0; }
+.live-option.is-selected { background: var(--c-blue); color: white; }
+.live-option.is-right { border-color: #00874f; box-shadow: inset 0 0 0 1px #00874f; }
+.live-marks { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; font-size: 15px; }
+.answer-mark, .correct-mark { border-radius: 100px; padding: 5px 10px; font-weight: 700; }
+.answer-mark { background: var(--c-sun); color: var(--c-night); }
+.correct-mark { background: #00874f; color: white; }
+.option-count { white-space: nowrap; font-variant-numeric: tabular-nums; }
+.live-result { font-size: 32px; font-weight: 800; margin-top: 22px; }
+.live-result.is-right { color: #007343; }
+.live-error { color: #a40042; min-height: 1.5em; margin-top: 16px; }
+.end-mark { display: grid; place-items: center; width: 90px; height: 90px; font-size: 60px; color: var(--c-night); background: var(--c-sun); border-radius: 28px; margin-bottom: 30px; }
+.game-history { display: grid; gap: 12px; margin-top: 20px; }
+.game-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0; }
+@media (max-width: 650px) {
+  .live-shell { padding: 20px 20px 36px; }
+  .live-top { margin-bottom: 32px; }
+  .join-details { flex-direction: column; padding: 20px; align-items: flex-start; }
+  .join-qr { align-self: center; max-width: 100%; height: auto; }
+  .live-screen .live-options { grid-template-columns: minmax(0, 1fr); }
+  .live-option { padding: 18px; font-size: 20px; }
+}
+.live-progress { text-transform: none; letter-spacing: 0; }
+
+/* Prizes stay live after the final question. Each player has a distinct row. */
+.leaderboard-title { margin-top: 36px; }
+.prize-controls { margin: 22px 0 16px; }
+.leaderboard { display: grid; gap: 12px; margin-top: 28px; }
+.leaderboard-row { display: grid; grid-template-columns: 52px minmax(0, 1fr) auto 94px; align-items: center; gap: 18px; padding: 20px 24px; background: white; border: 2px solid transparent; border-radius: 18px; font-size: clamp(18px, 2.2vw, 28px); }
+.leaderboard-row.is-winner { border-color: #00874f; }
+.leaderboard-place { font-weight: 800; font-variant-numeric: tabular-nums; }
+.leaderboard-name { font-weight: 700; overflow-wrap: anywhere; min-width: 0; }
+.leaderboard-points { font-variant-numeric: tabular-nums; white-space: nowrap; }
+.winner-mark { justify-self: end; font-size: 16px; font-weight: 800; color: #005b36; background: #d8f7e7; padding: 6px 12px; border-radius: 100px; }
+.live-place { font-size: clamp(30px, 6vw, 44px); font-weight: 800; margin: 18px 0 8px; }
+.live-points { font-size: 28px; margin-bottom: 24px; }
+.phone-winner { font-size: 36px; font-weight: 800; padding: 22px; border-radius: 18px; background: var(--c-sun); color: var(--c-night); }
+@media (max-width: 650px) {
+  .leaderboard-row { grid-template-columns: 26px minmax(0, 1fr) auto; padding: 16px 12px; gap: 10px; }
+  .winner-mark { grid-column: 2 / -1; }
+}
+
+/* Per-question timing is a local quiz setting, visible only on the stage. */
+.timer-settings { border: 0; padding: 0; margin: 24px 0 28px; min-width: 0; }
+.timer-settings legend { font-weight: 700; margin-bottom: 14px; }
+.timer-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 440px; }
+.timer-fields .field { margin-bottom: 8px; }
+.live-question-status { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 28px; }
+.live-timer { font-size: clamp(42px, 6vw, 80px); font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; margin: 16px 0; padding: 12px 24px; border-radius: 18px; background: var(--c-sun); color: var(--c-night); }
+.live-timer.is-urgent { background: var(--c-pink); color: var(--c-night); }
