+fn save_question(
+    app: &App,
+    quiz_id: i64,
+    question_id: Option<i64>,
+    fields: Fields,
+) -> AppResult<Response> {
+    verify_csrf(app, &fields)?;
+    let input = QuestionInput::from_fields(&fields);
+    let mut db = app.db.lock().unwrap();
+    let quiz = get_quiz(&db, quiz_id)?;
+    if let Some(id) = question_id {
+        get_question(&db, quiz_id, id)?;
+    }
+    let errors = input.errors();
+    if !errors.is_empty() {
+        return Ok((
+            StatusCode::UNPROCESSABLE_ENTITY,
+            Html(views::question_form(
+                app,
+                &quiz,
+                question_id,
+                &input,
+                &errors,
+            )),
+        )
+            .into_response());
+    }
+    let tx = db.transaction()?;
+    if let Some(id) = question_id {
+        tx.execute(
+            "UPDATE questions SET text=?, active=? WHERE id=? AND quiz_id=?",
+            params![input.text.trim(), input.active, id, quiz_id],
+        )?;
+        tx.execute("DELETE FROM options WHERE question_id=?", [id])?;
+        insert_options(&tx, id, &input)?;
+    } else {
+        insert_question(&tx, quiz_id, &input)?;
+    }
+    tx.commit()?;
+    Ok(Redirect::to(&quiz_url(quiz_id)).into_response())
+}
+// Call inside the caller's transaction, for both question forms and quiz imports.
+fn insert_question(db: &Connection, quiz_id: i64, input: &QuestionInput) -> rusqlite::Result<()> {
+    db.execute("INSERT INTO questions(quiz_id,text,active,position) VALUES (?1,?2,?3,(SELECT COALESCE(MAX(position),0)+1 FROM questions WHERE quiz_id=?1))", params![quiz_id, input.text.trim(), input.active])?;
+    insert_options(db, db.last_insert_rowid(), input)
+}
+fn insert_options(
+    db: &Connection,
+    question_id: i64,
+    input: &QuestionInput,
+) -> rusqlite::Result<()> {
+    for (i, choice) in input.saved_options().iter().enumerate() {
+        db.execute(
+            "INSERT INTO options(question_id,text,correct,position) VALUES (?,?,?,?)",
+            params![question_id, choice.text, choice.correct, i as i64],
+        )?;
+    }
+    Ok(())
+}
