+pub fn preview(quiz: &Quiz, questions: &[Question]) -> String {
+    // JSON in a non-executable script tag still needs '<' escaped to prevent </script> injection.
+    let data = serde_json::to_string(questions)
+        .expect("Serialize preview")
+        .replace('<', "\\u003c")
+        .replace('>', "\\u003e")
+        .replace('&', "\\u0026");
+    document(
+        &format!("Preview · {}", quiz.title),
+        &format!(
+            r#"<div class="preview-banner"><span>Preview · {}</span><a href="{}">← Back to quiz</a></div>
+<div class="play preview-play"><header class="play__top"><a class="logo admin-header__logo play__logo" href="/moderate"><span class="logo__mark">?</span>Quizzy</a><span class="meta">Player preview</span></header>
+<main class="play__body play__body--top" id="preview"><noscript><div class="errors">Enable JavaScript to try the preview.</div></noscript></main></div>
+<script type="application/json" id="preview-data">{data}</script>"#,
+            escape(&quiz.title),
+            quiz_url(quiz.id)
+        ),
+    )
+}
