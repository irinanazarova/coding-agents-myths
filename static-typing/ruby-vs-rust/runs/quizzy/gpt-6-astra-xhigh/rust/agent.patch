+#!/usr/bin/env python3
+"""Timer settings, deadlines, privacy, and export regression (standard library only)."""
+import html
+import json
+import re
+import time
+from smoke import Document, csrf, post, request
+from live_game import Player
+
+
+def run():
+    token = csrf('/moderate/quizzes/new')
+    fields = Document(request('/moderate/quizzes/new')[2]).inputs
+    for name in ['timer_minutes', 'timer_seconds']:
+        assert name in fields, f'Missing {name} setting'
+        assert fields[name]['type'] == 'number' and fields[name]['value'] == '0'
+    payload = {'title': 'Timer regression', 'questions': [
+        {'text': text, 'options': [{'text': 'Yes', 'correct': True}, {'text': 'No'}]}
+        for text in ['Timed first', 'Timed second', 'Timed last']
+    ]}
+    quiz = post('/moderate/quizzes/import', {'quiz_json': json.dumps(payload)}, token)[1]['Location']
+    imported = None
+    try:
+        def settings(minutes, seconds, expected=303):
+            status, _, body = post(quiz, {'title': payload['title'], 'timer_minutes': minutes, 'timer_seconds': seconds}, token)
+            assert status == expected, (status, body)
+            return body
+
+        def saved(minutes, seconds):
+            fields = Document(request(quiz + '/edit')[2]).inputs
+            assert fields['timer_minutes']['value'] == str(minutes)
+            assert fields['timer_seconds']['value'] == str(seconds)
+
+        saved(0, 0)
+        settings(1, 30)
+        saved(1, 30)
+        for minutes, seconds in [(-1, 0), (0, -1), ('1.5', 0), (0, 'oops'), ('', 0), (str(2**64), 0)]:
+            body = settings(minutes, seconds, 422)
+            assert 'Timer' in body
+            saved(1, 30)
+        exported = json.loads(html.unescape(re.search(r'<pre[^>]*>(.*?)</pre>', request(quiz + '/export')[2], re.S)[1]))
+        assert not any('timer' in key for key in exported)
+        imported = post('/moderate/quizzes/import', {'quiz_json': json.dumps(exported)}, token)[1]['Location']
+        fields = Document(request(imported + '/edit')[2]).inputs
+        assert fields['timer_minutes']['value'] == fields['timer_seconds']['value'] == '0'
+        settings(0, 3)
+        game = post(quiz + '/games', {}, token)[1]['Location']
+        link = '/play/' + game.rsplit('/', 1)[-1]
+        alice, absent = Player(), Player()
+        alice.request(link + '/join', {'name': 'Alice'})
+        absent.request(link + '/join', {'name': 'No answer'})
+
+        def state():
+            return json.loads(request(game + '/state')[2])
+
+        def control(action):
+            status, _, body = post(game + '/action', {'action': action, 'version': state()['version']}, token)
+            assert status == 200, body
+            return json.loads(body)
+
+        assert 'timer' not in state()
+        # Template edits must not change the duration of an existing game.
+        settings(0, 0)
+        opened = control('start')
+        assert opened['phase'] == 'open'
+        timer = opened['timer']
+        assert 2500 < timer['deadline_ms'] - timer['server_now_ms'] <= 3000
+        p = alice.state(link)
+        assert 'timer' not in p and 'deadline' not in json.dumps(p)
+        assert alice.request(link + '/answer', {'csrf': p['csrf'], 'question': 0, 'option': 0})[0] == 200
+        time.sleep(1.1)
+        request(game)  # Reloading the big screen must not reset the opening time.
+        later = state()
+        assert later['timer']['deadline_ms'] == timer['deadline_ms']
+        assert later['timer']['server_now_ms'] > timer['server_now_ms'] + 1000
+        time.sleep(2.2)
+        finished = state()
+        assert finished['phase'] == 'closed' and finished['index'] == 0
+        assert finished['version'] == opened['version'] + 1 and 'timer' not in finished
+        assert alice.state(link)['result'] == 'Correct!'
+        assert absent.state(link)['result'] == 'No answer'
+        assert alice.request(link + '/answer', {'csrf': p['csrf'], 'question': 0, 'option': 1})[0] == 409
+        second = control('next')
+        assert second['index'] == 1 and second['timer']['deadline_ms'] > timer['deadline_ms']
+        manual = control('finish')
+        assert manual['phase'] == 'closed' and 'timer' not in manual
+        time.sleep(3.2)
+        assert state()['version'] == manual['version'], 'Old deadline must not finish twice'
+        control('next')
+        time.sleep(3.2)
+        assert state()['phase'] == 'closed' and state()['index'] == 2
+        assert control('end')['phase'] == 'ended'
+        # A zero timer really is disabled, not an immediate Finish.
+        game = post(quiz + '/games', {}, token)[1]['Location']
+        assert 'timer' not in control('start')
+        time.sleep(3.2)
+        assert state()['phase'] == 'open'
+        assert control('finish')['phase'] == 'closed'
+        print('PASS: timer defaults/validation/persistence, export exclusion, frozen duration, deadline/reload, automatic/manual Finish, next/last questions, player privacy, zero timer')
+    finally:
+        if imported: post(imported + '/delete', {}, token)
+        post(quiz + '/delete', {}, token)
+
+
+if __name__ == '__main__':
+    run()
