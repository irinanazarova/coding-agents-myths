@@ -0,0 +1,149 @@
+'use strict';
+
+// Use real forms and the browser's native confirmation dialog.
+document.addEventListener('submit', (event) => {
+  const message = event.target.dataset.confirm;
+  if (message && !window.confirm(message)) event.preventDefault();
+});
+document.querySelectorAll('.active-form input[type="checkbox"]').forEach((checkbox) => {
+  checkbox.addEventListener('change', () => checkbox.form.requestSubmit());
+});
+
+const rows = document.getElementById('option-rows');
+if (rows) {
+  function renumber() {
+    [...rows.children].forEach((row, index) => {
+      const n = index + 1;
+      const text = row.querySelector('input[type="text"]');
+      text.name = `option_${n}`;
+      text.placeholder = `Option ${n}`;
+      text.setAttribute('aria-label', `Option ${n}`);
+      const checkbox = row.querySelector('input[type="checkbox"]');
+      checkbox.name = `correct_${n}`;
+      checkbox.setAttribute('aria-label', `Option ${n} is correct`);
+      const remove = row.querySelector('button');
+      remove.setAttribute('aria-label', `Remove option ${n}`);
+      remove.title = `Remove option ${n}`;
+    });
+  }
+  document.getElementById('add-option').addEventListener('click', () => {
+    const row = document.createElement('div');
+    row.className = 'option-row';
+    row.innerHTML = '<input class="input" type="text"><label class="checkbox"><input type="checkbox"> Correct</label><button class="btn btn--danger btn--icon remove-option" type="button">✕</button>';
+    rows.append(row);
+    renumber();
+    row.querySelector('input').focus();
+  });
+  rows.addEventListener('click', (event) => {
+    const remove = event.target.closest('.remove-option');
+    if (!remove) return;
+    const row = remove.closest('.option-row');
+    const next = row.nextElementSibling || row.previousElementSibling;
+    row.remove();
+    renumber();
+    (next ? next.querySelector('input') : document.getElementById('add-option')).focus();
+  });
+}
+
+const previewData = document.getElementById('preview-data');
+if (previewData) {
+  const questions = JSON.parse(previewData.textContent);
+  const root = document.getElementById('preview');
+  let index = 0;
+  let score = 0;
+  let answered = false;
+
+  function node(tag, className, text) {
+    const element = document.createElement(tag);
+    if (className) element.className = className;
+    if (text !== undefined) element.textContent = text;
+    return element;
+  }
+  function button(text, className, action) {
+    const element = node('button', className, text);
+    element.type = 'button';
+    element.addEventListener('click', action);
+    return element;
+  }
+  function restart() { index = 0; score = 0; render(); }
+  function focusHeading(heading) {
+    heading.tabIndex = -1;
+    heading.focus({ preventScroll: true });
+    window.scrollTo(0, 0);
+  }
+  function letter(index) {
+    let result = '';
+    for (let n = index + 1; n > 0; n = Math.floor((n - 1) / 26)) result = String.fromCharCode(65 + (n - 1) % 26) + result;
+    return result;
+  }
+  function showScore() {
+    root.replaceChildren();
+    const card = node('div', 'result-card');
+    const mark = node('div', 'logo__mark', '✓');
+    mark.setAttribute('aria-hidden', 'true');
+    const heading = node('h1', '', 'Quiz complete!');
+    card.append(mark, heading, node('div', 'result-card__score', `Score: ${score}/${questions.length}`), node('p', 'meta', 'That’s a wrap. Ready for another round?'));
+    const actions = node('div', 'buttons');
+    actions.append(button('Start over', 'btn btn--pink', restart));
+    card.append(actions, node('p', 'meta preview-note', 'This is a preview. Your answers are not saved.'));
+    root.append(card);
+    focusHeading(heading);
+  }
+  function render() {
+    root.replaceChildren();
+    answered = false;
+    if (!questions.length) {
+      const heading = node('h1', 'play-question__body', 'No active questions');
+      root.append(heading, node('p', '', 'Add a question or make one active to try this quiz.'), button('Start over', 'btn btn--ghost', restart));
+      focusHeading(heading);
+      return;
+    }
+    const question = questions[index];
+    const heading = node('h1', 'play-question__body', question.text);
+    root.append(node('div', 'play-question__num', `Question ${index + 1} of ${questions.length}`), heading);
+    const choices = node('div', 'play-options');
+    const feedback = node('div', 'play-status');
+    feedback.setAttribute('role', 'status');
+    feedback.hidden = true;
+    const nextActions = node('div', 'buttons preview-actions');
+    const optionButtons = question.options.map((option, choiceIndex) => {
+      const choice = button('', 'play-option', () => {
+        if (answered) return;
+        answered = true;
+        if (option.correct) score++;
+        choices.classList.add('is-locked', 'is-revealed');
+        optionButtons.forEach((b, i) => {
+          b.disabled = true;
+          if (i === choiceIndex) b.classList.add('is-picked');
+          if (question.options[i].correct) {
+            b.classList.add('is-correct');
+            b.append(node('span', 'play-option__mark', '✓ Correct'));
+          } else if (i === choiceIndex) {
+            b.append(node('span', 'play-option__mark', '✕'));
+          }
+        });
+        feedback.hidden = false;
+        feedback.textContent = option.correct ? 'Correct!' : 'Wrong!';
+        feedback.classList.add(option.correct ? 'play-status--right' : 'play-status--wrong');
+        const last = index === questions.length - 1;
+        const next = button(last ? 'See score' : 'Next question', 'btn btn--pink', () => {
+          if (last) showScore();
+          else { index++; render(); }
+        });
+        nextActions.append(next);
+        next.focus({ preventScroll: true });
+      });
+      const label = node('span', 'play-option__letter', letter(choiceIndex));
+      label.setAttribute('aria-hidden', 'true');
+      choice.append(label, node('span', 'play-option__title', option.text));
+      return choice;
+    });
+    choices.append(...optionButtons);
+    root.append(choices, feedback, nextActions);
+    const restartActions = node('div', 'buttons preview-restart');
+    restartActions.append(button('Start over', 'btn btn--ghost btn--sm', restart));
+    root.append(restartActions, node('p', 'meta preview-note', 'This is a preview. Your answers are not saved.'));
+    focusHeading(heading);
+  }
+  render();
+}
