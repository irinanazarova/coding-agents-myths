+async fn protect(State(app): State<AppState>, request: Request, next: Next) -> Response {
+    let path = request.uri().path();
+    if path != "/moderate" && !path.starts_with("/moderate/") {
+        return next.run(request).await;
+    }
+    let credentials = request
+        .headers()
+        .get(header::AUTHORIZATION)
+        .and_then(|h| h.to_str().ok())
+        .and_then(|value| {
+            let (scheme, encoded) = value.split_once(' ')?;
+            if !scheme.eq_ignore_ascii_case("Basic") {
+                return None;
+            }
+            STANDARD.decode(encoded.trim()).ok()
+        });
+    if !credentials.is_some_and(|supplied| constant_eq(&supplied, app.credentials.as_bytes())) {
+        return (
+            StatusCode::UNAUTHORIZED,
+            [
+                (
+                    header::WWW_AUTHENTICATE,
+                    "Basic realm=\"Quizzy moderator\", charset=\"UTF-8\"",
+                ),
+                (header::CACHE_CONTROL, "no-store"),
+            ],
+            "Moderator authentication required",
+        )
+            .into_response();
+    }
+    let mut response = next.run(request).await;
+    response
+        .headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    response
+}
