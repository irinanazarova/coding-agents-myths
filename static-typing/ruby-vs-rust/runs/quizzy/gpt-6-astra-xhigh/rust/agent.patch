+// Cap only absurdly large durations (68 years), keeping arithmetic safe in
+// SQLite's microsecond clock and the browser's millisecond clock.
+fn timer_duration(minutes: &str, seconds: &str) -> Result<i64, &'static str> {
+    let minutes = minutes
+        .parse::<i64>()
+        .ok()
+        .filter(|n| *n >= 0)
+        .ok_or("Timer minutes must be a whole number of at least 0")?;
+    let seconds = seconds
+        .parse::<i64>()
+        .ok()
+        .filter(|n| *n >= 0)
+        .ok_or("Timer seconds must be a whole number of at least 0")?;
+    minutes
+        .checked_mul(60)
+        .and_then(|n| n.checked_add(seconds))
+        .filter(|n| *n <= i32::MAX as i64)
+        .ok_or("Timer is too long")
+}
+
+fn quiz_errors(title: &str, winners: &str, minutes: &str, seconds: &str) -> Vec<&'static str> {
+    let mut errors = Vec::new();
+    if title.trim().is_empty() {
+        errors.push("Title is required");
+    }
+    if !winners.parse::<i64>().is_ok_and(|n| n >= 1) {
+        errors.push("Number of winners must be a whole number of at least 1");
+    }
+    if let Err(message) = timer_duration(minutes, seconds) {
+        errors.push(message);
+    }
+    errors
+}
