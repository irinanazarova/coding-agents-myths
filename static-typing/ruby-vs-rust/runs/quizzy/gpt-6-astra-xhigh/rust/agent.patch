+async fn move_question(
+    State(app): State<AppState>,
+    Path((quiz_id, question_id)): Path<(i64, i64)>,
+    Form(fields): Form<Fields>,
+) -> AppResult<Redirect> {
+    verify_csrf(&app, &fields)?;
+    let direction = fields
+        .get("direction")
+        .map(String::as_str)
+        .ok_or(AppError::BadRequest)?;
+    if direction != "up" && direction != "down" {
+        return Err(AppError::BadRequest);
+    }
+    let mut db = app.db.lock().unwrap();
+    let tx = db.transaction()?;
+    let mut ids = tx
+        .prepare("SELECT id FROM questions WHERE quiz_id=? ORDER BY position, id")?
+        .query_map([quiz_id], |row| row.get::<_, i64>(0))?
+        .collect::<Result<Vec<_>, _>>()?;
+    let index = ids
+        .iter()
+        .position(|id| *id == question_id)
+        .ok_or(AppError::NotFound)?;
+    let other = if direction == "up" {
+        index.saturating_sub(1)
+    } else {
+        (index + 1).min(ids.len() - 1)
+    };
+    ids.swap(index, other);
+    for (position, id) in ids.iter().enumerate() {
+        tx.execute(
+            "UPDATE questions SET position=? WHERE id=?",
+            params![position as i64, id],
+        )?;
+    }
+    tx.commit()?;
+    Ok(Redirect::to(&format!(
+        "{}#question-{question_id}",
+        quiz_url(quiz_id)
+    )))
+}
