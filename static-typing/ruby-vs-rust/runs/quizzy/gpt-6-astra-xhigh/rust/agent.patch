@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""HTTP regression checks. Run against bin/serve; uses only the Python standard library."""
+import base64
+import html.parser
+import os
+import re
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+
+BASE = os.environ.get('QUIZZY_TEST_URL', 'http://127.0.0.1:3000')
+USER = os.environ.get('QUIZZY_MODERATOR_USERNAME', 'moderator')
+PASSWORD = os.environ.get('QUIZZY_MODERATOR_PASSWORD', 'test-password')
+AUTH = 'Basic ' + base64.b64encode(f'{USER}:{PASSWORD}'.encode()).decode()
+
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args, **kwargs):
+        return None
+
+OPENER = urllib.request.build_opener(NoRedirect)
+def request(path, data=None, auth=AUTH, host=None):
+    headers = {}
+    if auth is not None:
+        headers['Authorization'] = auth
+    if host:
+        headers['Host'] = host
+    req = urllib.request.Request(BASE + path, data=urllib.parse.urlencode(data).encode() if data is not None else None, headers=headers)
+    try:
+        response = OPENER.open(req, timeout=10)
+    except urllib.error.HTTPError as error:
+        response = error
+    return response.status, response.headers, response.read().decode()
+
+class Document(html.parser.HTMLParser):
+    def __init__(self, text):
+        super().__init__()
+        self.inputs = {}
+        self.feed(text)
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == 'input' and 'name' in attrs:
+            self.inputs[attrs['name']] = attrs
+
+def csrf(path):
+    status, _, body = request(path)
+    assert status == 200, (path, status)
+    return Document(body).inputs['csrf']['value']
+
+def post(path, data, token):
+    return request(path, dict(data, csrf=token))
+
+def run():
+    assert request('/up', auth=None)[0] == 200
+    for path in ['/moderate', '/moderate/', '/moderate/quizzes/new', '/moderate/quizzes/1', '/moderate/quizzes/1/preview', '/moderate/not-found']:
+        for auth in [None, 'Basic d3Jvbmc6d3Jvbmc=', 'Basic not-base64!', 'Bearer ignored']:
+            status, headers, _ = request(path, auth=auth)
+            assert status == 401, (path, auth, status)
+            assert headers.get('WWW-Authenticate').startswith('Basic ')
+    assert request('/moderate/quizzes', {}, auth=None)[0] == 401
+    assert request('/moderate', host='conference.example:3000')[0] == 200
+    token = csrf('/moderate/quizzes/new')
+    assert request('/moderate/quizzes', {'title': 'Forbidden'})[0] == 403
+    assert post('/moderate/quizzes', {'title': '   '}, token)[0] == 422
+    title = 'Smoke <quiz> "safe" ' + str(time.time_ns())
+    status, headers, _ = post('/moderate/quizzes', {'title': title}, token)
+    assert status == 303
+    quiz = headers['Location']
+    other = None
+    try:
+        status, headers, body = request(quiz)
+        assert status == 200 and '&lt;quiz&gt;' in body and 'no-store' in headers['Cache-Control']
+        blank = Document(request(quiz + '/questions/new')[2]).inputs
+        assert len([n for n in blank if n.startswith('option_')]) == 4
+        assert 'checked' in blank['active']
+        invalid = {'question': 'Typed <question>', 'option_1': 'One', 'correct_1': 'on', 'option_2': '', 'option_3': '  ', 'correct_3': 'on', 'option_4': '', 'option_5': ''}
+        status, _, body = post(quiz + '/questions', invalid, token)
+        assert status == 422 and 'Add at least two options' in body
+        values = Document(body).inputs
+        assert values['option_1']['value'] == 'One' and values['option_3']['value'] == '  '
+        assert 'checked' in values['correct_3'] and 'option_5' in values and 'checked' not in values['active']
+        assert 'Typed &lt;question&gt;' in body
+        assert 'Typed &lt;question&gt;' not in request(quiz)[2]
+        invalid.update(option_2='Two', correct_1='on')
+        del invalid['correct_1']
+        status, _, body = post(quiz + '/questions', invalid, token)
+        assert status == 422 and 'Mark at least one option as correct' in body
+        assert 'Typed &lt;question&gt;' not in request(quiz)[2]
+
+        def add(text, active=True):
+            fields = {'question': text, 'option_1': 'Alpha', 'correct_1': 'on', 'option_2': '', 'correct_2': 'on', 'option_3': 'Beta', 'option_4': 'Gamma', 'correct_4': 'on'}
+            if active: fields['active'] = 'on'
+            assert post(quiz + '/questions', fields, token)[0] == 303
+        add('First question')
+        add('Second question')
+        add('Inactive question', False)
+        body = request(quiz)[2]
+        ids = re.findall(r'<li class="card question-item[^\"]*" id="question-(\d+)"', body)
+        assert len(ids) == 3 and '2 of 3 questions active' in body
+        first, second, inactive = [quiz + '/questions/' + i for i in ids]
+        edit = Document(request(first + '/edit')[2]).inputs
+        assert [edit[f'option_{i}']['value'] for i in (1, 2, 3)] == ['Alpha', 'Beta', 'Gamma']
+        assert 'checked' in edit['correct_1'] and 'checked' in edit['correct_3']
+        assert 'option_4' not in edit
+        # A rejected edit leaves the saved version untouched.
+        assert post(first, {'question': 'Should not save', 'option_1': 'Only one', 'correct_1': 'on'}, token)[0] == 422
+        assert 'First question' in request(quiz)[2] and 'Should not save' not in request(quiz)[2]
+        assert post(second + '/move', {'direction': 'up'}, token)[0] == 303
+        body = request(quiz)[2]
+        assert body.index('Second question') < body.index('First question')
+        assert post(second + '/move', {'direction': 'up'}, token)[0] == 303  # boundary is harmless
+        assert post(second + '/move', {'direction': 'down'}, token)[0] == 303
+        assert post(first + '/active', {}, token)[0] == 303
+        assert '1 of 3 questions active' in request(quiz)[2]
+        preview = request(quiz + '/preview')[2]
+        assert 'Second question' in preview and 'First question' not in preview and 'Inactive question' not in preview
+        assert post(first + '/active', {'active': 'on'}, token)[0] == 303
+        assert post(first, {'question': '</script><script>alert(1)</script>', 'option_1': 'Yes', 'correct_1': 'on', 'option_2': 'No', 'active': 'on'}, token)[0] == 303
+        assert '<script>alert(1)</script>' not in request(quiz + '/preview')[2]
+        assert '\\u003c/script\\u003e' in request(quiz + '/preview')[2]
+        assert post(quiz, {'title': 'Renamed smoke quiz'}, token)[0] == 303
+        assert 'Renamed smoke quiz' in request(quiz)[2]
+        # Question IDs must be scoped to their parent quiz.
+        _, headers, _ = post('/moderate/quizzes', {'title': 'Other smoke quiz'}, token)
+        other = headers['Location']
+        assert request(other + '/questions/' + ids[0] + '/edit')[0] == 404
+        assert post(other + '/questions/' + ids[0] + '/delete', {}, token)[0] == 404
+        assert post(inactive + '/delete', {}, token)[0] == 303
+        assert request(inactive + '/edit')[0] == 404
+        assert post(second + '/delete', {}, token)[0] == 303
+        assert post(first + '/active', {}, token)[0] == 303
+        assert 'id="preview-data">[]</script>' in request(quiz + '/preview')[2]
+    finally:
+        if other: post(other + '/delete', {}, token)
+        post(quiz + '/delete', {}, token)
+    assert request(quiz)[0] == 404
+    print('PASS: HTTP auth, CSRF, forms, validation, escaping, ordering, activation, preview, isolation, deletion')
+
+if __name__ == '__main__':
+    run()
