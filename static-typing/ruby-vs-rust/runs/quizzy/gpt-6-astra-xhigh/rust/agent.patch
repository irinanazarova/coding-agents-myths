+/* JSON remains selectable and readable without overflowing narrow screens. */
+.quiz-json { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 14px; line-height: 1.6; }
+pre.quiz-json { margin: 24px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; tab-size: 2; }
+
+/* Live room: large, high-contrast stage content and thumb-sized phone choices. */
+[hidden] { display: none !important; }
