+#[tokio::main]
+async fn main() {
+    let username =
+        env::var("QUIZZY_MODERATOR_USERNAME").expect("QUIZZY_MODERATOR_USERNAME must be set");
+    let password =
+        env::var("QUIZZY_MODERATOR_PASSWORD").expect("QUIZZY_MODERATOR_PASSWORD must be set");
+    let secret = env::var("SECRET_KEY_BASE").expect("SECRET_KEY_BASE must be set");
+    assert!(
+        !username.is_empty() && !password.is_empty() && !secret.is_empty(),
+        "Credentials and SECRET_KEY_BASE must not be empty"
+    );
+    assert!(
+        !username.contains(':'),
+        "Basic auth username cannot contain a colon"
+    );
+    let credentials = format!("{username}:{password}");
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret.as_bytes()).expect("HMAC key");
+    mac.update(b"Quizzy moderator form token\0");
+    mac.update(credentials.as_bytes());
+    let csrf = STANDARD.encode(mac.finalize().into_bytes());
+    std::fs::create_dir_all("storage").expect("Create storage directory");
+    let db = Connection::open("storage/quizzy.sqlite3").expect("Open database");
+    initialize_db(&db).expect("Initialize database");
+    live::initialize_db(&db).expect("Initialize games");
+    let app = Arc::new(App {
+        db: Mutex::new(db),
+        credentials,
+        csrf,
+        live: live::Hub::default(),
+    });
+    // Reconcile persisted deadlines before /up becomes available, even when
+    // the app was stopped while a timed question was open.
+    live::finish_expired(&app).expect("Finish expired questions");
+    tokio::spawn(live::run_timers(app.clone()));
+    let moderator = Router::new()
+        .route("/", get(list_quizzes))
+        .route("/quizzes/new", get(new_quiz))
+        .route("/quizzes/import", get(import_form).post(import_quiz))
+        .route("/quizzes", post(create_quiz))
+        .route("/quizzes/{id}", get(show_quiz).post(update_quiz))
+        .route("/quizzes/{id}/edit", get(edit_quiz))
+        .route("/quizzes/{id}/delete", post(delete_quiz))
+        .merge(live::moderator_routes())
+        .route("/quizzes/{id}/preview", get(preview))
+        .route("/quizzes/{id}/export", get(export_quiz))
+        .route("/quizzes/{id}/questions/new", get(new_question))
+        .route("/quizzes/{id}/questions", post(create_question))
+        .route(
+            "/quizzes/{quiz_id}/questions/{question_id}",
+            post(update_question),
+        )
+        .route(
+            "/quizzes/{quiz_id}/questions/{question_id}/edit",
+            get(edit_question),
+        )
+        .route(
+            "/quizzes/{quiz_id}/questions/{question_id}/delete",
+            post(delete_question),
+        )
+        .route(
+            "/quizzes/{quiz_id}/questions/{question_id}/active",
+            post(toggle_question),
+        )
+        .route(
+            "/quizzes/{quiz_id}/questions/{question_id}/move",
+            post(move_question),
+        )
+        .fallback(not_found);
+    let shutdown_app = app.clone();
+    let router = Router::new()
+        .route("/", get(|| async { Redirect::to("/moderate") }))
+        .route("/up", get(|| async { "OK" }))
+        .route("/assets/{name}", get(asset))
+        .merge(live::player_routes())
+        .nest("/moderate", moderator)
+        .route("/moderate/", get(list_quizzes))
+        .fallback(not_found)
+        .layer(middleware::from_fn_with_state(app.clone(), protect))
+        .layer(middleware::from_fn(security_headers))
+        .with_state(app);
+    let port: u16 = env::var("PORT")
+        .unwrap_or_else(|_| "3000".into())
+        .parse()
+        .expect("PORT must be a valid port");
+    let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::UNSPECIFIED, port))
+        .await
+        .expect("Bind HTTP listener");
+    println!("Quizzy ready on http://0.0.0.0:{port}");
+    axum::serve(listener, router)
+        .with_graceful_shutdown(async move {
+            let mut terminate =
+                tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
+                    .expect("SIGTERM handler");
+            tokio::select! {
+                _ = tokio::signal::ctrl_c() => {},
+                _ = terminate.recv() => {},
+            }
+            shutdown_app.live.shutdown();
+        })
+        .await
+        .expect("HTTP server");
+}
