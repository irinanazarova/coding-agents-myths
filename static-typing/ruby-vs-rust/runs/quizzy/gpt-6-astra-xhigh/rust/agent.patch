+            .unwrap();
+        initialize_db(&db).unwrap();
+        assert_eq!(get_quiz(&db, 1).unwrap().number_of_winners, 7);
+        assert!(
+            db.execute("UPDATE quizzes SET number_of_winners=0", [])
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn timer_validation_handles_zero_components_and_overflow() {
+        assert_eq!(timer_duration("0", "0"), Ok(0));
+        assert_eq!(timer_duration("1", "30"), Ok(90));
+        assert_eq!(timer_duration("2", "0"), Ok(120));
+        assert_eq!(timer_duration("0", "90"), Ok(90));
+        for (minutes, seconds) in [
+            ("-1", "0"),
+            ("0", "-1"),
+            ("", "0"),
+            ("1.5", "0"),
+            ("0", "no"),
+            ("9223372036854775807", "1"),
+            ("0", "9223372036854775807"),
+        ] {
+            assert!(timer_duration(minutes, seconds).is_err());
+        }
+    }
+
+    #[test]
+    fn timer_migration_defaults_to_zero_and_preserves_saved_settings() {
+        let db = Connection::open_in_memory().unwrap();
+        db.execute_batch("CREATE TABLE quizzes(id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL); INSERT INTO quizzes(title) VALUES ('Existing');").unwrap();
+        initialize_db(&db).unwrap();
+        assert_eq!(get_quiz(&db, 1).unwrap().timer_seconds, 0);
+        db.execute("UPDATE quizzes SET timer_seconds=90", [])
+            .unwrap();
+        initialize_db(&db).unwrap();
+        assert_eq!(get_quiz(&db, 1).unwrap().timer_seconds, 90);
+        assert!(
+            db.execute("UPDATE quizzes SET timer_seconds=-1", [])
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn schema_and_cascades() {
+        let db = Connection::open_in_memory().unwrap();
+        initialize_db(&db).unwrap();
+        initialize_db(&db).unwrap();
+        db.execute("INSERT INTO quizzes(title) VALUES ('Test')", [])
+            .unwrap();
+        db.execute(
+            "INSERT INTO questions(quiz_id,text,position) VALUES (1,'Question',0)",
+            [],
+        )
+        .unwrap();
+        db.execute(
+            "INSERT INTO options(question_id,text,correct,position) VALUES (1,'Yes',1,0)",
+            [],
+        )
+        .unwrap();
+        db.execute("DELETE FROM quizzes WHERE id=1", []).unwrap();
+        assert_eq!(
+            db.query_row("SELECT COUNT(*) FROM questions", [], |row| row
+                .get::<_, i64>(0))
+                .unwrap(),
+            0
+        );
+        assert_eq!(
+            db.query_row("SELECT COUNT(*) FROM options", [], |row| row
+                .get::<_, i64>(0))
+                .unwrap(),
+            0
+        );
+    }
+}
