+#!/usr/bin/env python3
+"""Chromium copy/paste transfer checks; reuses the local DevTools test client."""
+import json
+import shutil
+import socket
+import subprocess
+import time
+import urllib.request
+from browser import ARTIFACTS, DevTools
+from smoke import AUTH, csrf, post, request
+
+
+def run():
+    profile = ARTIFACTS / 'transfer-profile'
+    shutil.rmtree(profile, ignore_errors=True)
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1', 0))
+        port = sock.getsockname()[1]
+    with (ARTIFACTS / 'transfer-chromium.log').open('w') as log:
+        browser = subprocess.Popen([
+            'chromium', '--headless=new', '--no-sandbox', '--disable-dev-shm-usage',
+            '--disable-background-networking', '--disable-component-update', '--disable-sync',
+            '--no-first-run', '--no-default-browser-check', f'--remote-debugging-port={port}',
+            f'--user-data-dir={profile}', 'about:blank',
+        ], stdout=log, stderr=log)
+    client = None
+    created = []
+    token = csrf('/moderate/quizzes/import')
+    try:
+        for _ in range(100):
+            try:
+                tabs = json.load(urllib.request.urlopen(f'http://127.0.0.1:{port}/json/list', timeout=1))
+                break
+            except Exception:
+                time.sleep(.1)
+        else:
+            raise RuntimeError('Chromium did not start')
+        client = DevTools(next(tab['webSocketDebuggerUrl'] for tab in tabs if tab['type'] == 'page'))
+        for domain in ['Page', 'Runtime', 'Network']:
+            client.call(domain + '.enable')
+        client.call('Network.setExtraHTTPHeaders', {'headers': {'Authorization': AUTH}})
+        client.call('Emulation.setDeviceMetricsOverride', {'width': 1440, 'height': 1080, 'deviceScaleFactor': 1, 'mobile': False})
+
+        def paste(text):
+            client.evaluate('''(() => {
+                const label = [...document.querySelectorAll('label')].find(e => e.textContent === 'Quiz JSON');
+                if (!label || label.control.tagName !== 'TEXTAREA') throw Error('Missing Quiz JSON textarea');
+                label.control.value = '';
+                label.control.focus();
+            })()''')
+            client.call('Input.insertText', {'text': text})
+
+        client.navigate('/moderate')
+        client.click('Import quiz')
+        client.wait('document.querySelector("textarea")')
+        invalid = '\n</textarea><script>window.injected = true</script>\n'
+        paste(invalid)
+        client.click('Import')
+        client.wait('document.querySelector("[role=alert]")')
+        assert client.evaluate('document.querySelector("textarea").value') == invalid
+        assert client.evaluate('window.injected === undefined')
+        assert 'Invalid quiz JSON' in client.evaluate('document.querySelector("[role=alert]").textContent')
+
+        payload = {
+            'title': 'Browser transfer <café> & 🎤',
+            'questions': [
+                {'text': 'First </pre><script>window.injected = true</script>', 'options': [{'text': '418'}, {'text': '429', 'correct': True}]},
+                {'text': 'Inactive second', 'active': False, 'options': [{'text': 'A', 'correct': True}, {'text': 'B', 'correct': True}]},
+            ],
+        }
+        paste(json.dumps(payload, ensure_ascii=False))
+        client.click('Import')
+        client.wait('document.querySelectorAll(".question-item").length === 2')
+        original = client.evaluate('location.pathname')
+        created.append(original)
+        assert client.evaluate('document.querySelector("h1").textContent') == payload['title']
+        assert client.evaluate('[...document.querySelectorAll(".question-item input[name=active]")].map(e=>e.checked)') == [True, False]
+        assert client.evaluate('[...document.querySelectorAll(".question-item")].every(e=>e.tagName === "LI" && e.querySelector("a") && e.querySelector("button"))')
+        client.click('Export')
+        client.wait('document.querySelector("pre")')
+        assert client.evaluate('document.querySelectorAll("pre").length') == 1
+        copied = client.evaluate('''(() => {
+            const range = document.createRange(); range.selectNodeContents(document.querySelector('pre'));
+            const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range);
+            return selection.toString();
+        })()''')
+        expected = json.loads(json.dumps(payload))
+        expected['questions'][0]['active'] = True
+        expected['questions'][0]['options'][0]['correct'] = False
+        assert json.loads(copied) == expected
+        assert client.evaluate('window.injected === undefined && !document.querySelector("pre script")')
+        client.screenshot('export-desktop.png')
+
+        client.navigate('/moderate')
+        client.click('Import quiz')
+        paste(copied)
+        client.click('Import')
+        client.wait('document.querySelectorAll(".question-item").length === 2')
+        clone = client.evaluate('location.pathname')
+        created.append(clone)
+        assert clone != original
+        client.click('Export')
+        client.wait('document.querySelector("pre")')
+        assert json.loads(client.evaluate('document.querySelector("pre").textContent')) == expected
+        client.call('Emulation.setDeviceMetricsOverride', {'width': 390, 'height': 844, 'deviceScaleFactor': 1, 'mobile': True})
+        assert client.evaluate('document.documentElement.scrollWidth <= innerWidth')
+        client.screenshot('export-mobile.png')
+        client.navigate('/moderate')
+        client.click('Import quiz')
+        paste(copied)
+        assert client.evaluate('document.documentElement.scrollWidth <= innerWidth')
+        client.screenshot('import-mobile.png')
+
+        # A valid first question followed by an invalid one must not create a quiz.
+        before = request('/moderate')[2]
+        bad_payload = json.loads(copied)
+        bad_payload['questions'][1]['options'] = [{'text': 'Only option', 'correct': True}]
+        paste(json.dumps(bad_payload))
+        client.click('Import')
+        client.wait('document.querySelector("[role=alert]")')
+        assert 'Question 2: Add at least two options' in client.evaluate('document.querySelector("[role=alert]").textContent')
+        assert request('/moderate')[2] == before
+        assert json.loads(client.evaluate('document.querySelector("textarea").value')) == bad_payload
+        assert not [event for event in client.events if event['method'] == 'Runtime.exceptionThrown']
+        print('PASS: Chromium Import quiz / Quiz JSON / Import / Export, copy/paste round trip, defaults, inactive questions, errors, escaping, mobile layout')
+    finally:
+        for quiz in reversed(created):
