+fn initialize_db(db: &Connection) -> rusqlite::Result<()> {
+    db.busy_timeout(Duration::from_secs(5))?;
+    db.execute_batch(
+        "
+        PRAGMA foreign_keys = ON;
+        PRAGMA journal_mode = WAL;
+        CREATE TABLE IF NOT EXISTS quizzes (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            title TEXT NOT NULL CHECK(length(trim(title)) > 0)
+        );
+        CREATE TABLE IF NOT EXISTS questions (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            quiz_id INTEGER NOT NULL REFERENCES quizzes(id) ON DELETE CASCADE,
+            text TEXT NOT NULL,
+            active INTEGER NOT NULL DEFAULT 1 CHECK(active IN (0, 1)),
+            position INTEGER NOT NULL
+        );
+        CREATE INDEX IF NOT EXISTS questions_quiz_order ON questions(quiz_id, position, id);
+        CREATE TABLE IF NOT EXISTS options (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            question_id INTEGER NOT NULL REFERENCES questions(id) ON DELETE CASCADE,
+            text TEXT NOT NULL,
+            correct INTEGER NOT NULL CHECK(correct IN (0, 1)),
+            position INTEGER NOT NULL
+        );
+        CREATE INDEX IF NOT EXISTS options_question_order ON options(question_id, position, id);
+    ",
+    )?;
+    add_column(
+        db,
+        "quizzes",
+        "number_of_winners",
+        "INTEGER NOT NULL DEFAULT 3 CHECK(number_of_winners >= 1)",
+    )?;
+    add_column(
+        db,
+        "quizzes",
+        "timer_seconds",
+        "INTEGER NOT NULL DEFAULT 0 CHECK(timer_seconds >= 0)",
+    )?;
+    Ok(())
+}
