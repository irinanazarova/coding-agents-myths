+    let mut questions = stmt
+        .query_map([quiz_id], |row| {
+            Ok(Question {
+                id: row.get(0)?,
+                text: row.get(1)?,
+                active: row.get(2)?,
+                options: vec![],
+            })
+        })?
+        .collect::<Result<Vec<_>, _>>()?;
+    let mut stmt =
+        db.prepare("SELECT text, correct FROM options WHERE question_id=? ORDER BY position, id")?;
+    for question in &mut questions {
+        question.options = stmt
+            .query_map([question.id], |row| {
+                Ok(Choice {
+                    text: row.get(0)?,
+                    correct: row.get(1)?,
