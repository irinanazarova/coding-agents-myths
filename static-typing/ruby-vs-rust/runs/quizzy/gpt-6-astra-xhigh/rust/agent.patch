+    fn from_fields(fields: &Fields) -> Self {
+        let mut numbered: Vec<(usize, Choice)> = fields
+            .iter()
+            .filter_map(|(key, text)| {
+                let n = key.strip_prefix("option_")?.parse::<usize>().ok()?;
+                Some((
+                    n,
+                    Choice {
+                        text: text.clone(),
+                        correct: fields.contains_key(&format!("correct_{n}")),
+                    },
+                ))
+            })
+            .collect();
+        numbered.sort_by_key(|(n, _)| *n);
+        Self {
+            text: fields.get("question").cloned().unwrap_or_default(),
+            active: fields.contains_key("active"),
+            options: numbered.into_iter().map(|(_, choice)| choice).collect(),
+        }
+    }
