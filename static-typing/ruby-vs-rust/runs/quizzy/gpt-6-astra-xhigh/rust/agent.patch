+#!/usr/bin/env python3
+"""Real Chromium, isolated moderator and phone contexts; no third-party tools."""
+import json
+import shutil
+import subprocess
+import time
+import urllib.request
+from browser import DevTools, ARTIFACTS
+from smoke import AUTH, BASE, csrf, post, request
+
+
+def run():
+    profile = ARTIFACTS / 'prizes-profile'
+    shutil.rmtree(profile, ignore_errors=True)
+    with open(ARTIFACTS / 'prizes-chromium.log', 'w') as log:
+        process = subprocess.Popen(['chromium', '--headless=new', '--no-sandbox', '--disable-dev-shm-usage',
+            '--disable-background-networking', '--disable-component-update', '--disable-sync',
+            '--disable-background-timer-throttling', '--disable-renderer-backgrounding',
+            '--no-first-run', '--no-default-browser-check', '--remote-debugging-port=9224',
+            f'--user-data-dir={profile}', 'about:blank'], stdout=log, stderr=log)
+    root = None
+    quiz = None
+    clients = []
+    token = csrf('/moderate/quizzes/new')
+    try:
+        for _ in range(100):
+            try:
+                info = json.load(urllib.request.urlopen('http://127.0.0.1:9224/json/version', timeout=1))
+                break
+            except Exception: time.sleep(.1)
+        root = DevTools(info['webSocketDebuggerUrl'])
+
+        def new_tab(moderator=False, context=None):
+            if context is None:
+                context = root.call('Target.createBrowserContext')['browserContextId']
+            target = root.call('Target.createTarget', {'url': 'about:blank', 'browserContextId': context})['targetId']
+            tabs = json.load(urllib.request.urlopen('http://127.0.0.1:9224/json/list'))
+            c = DevTools(next(t['webSocketDebuggerUrl'] for t in tabs if t['id'] == target))
+            clients.append(c)
+            for method in ['Page.enable', 'Runtime.enable', 'Network.enable', 'Log.enable']: c.call(method)
+            if moderator: c.call('Network.setExtraHTTPHeaders', {'headers': {'Authorization': AUTH}})
+            c.call('Emulation.setDeviceMetricsOverride', {'width': 1440 if moderator else 390, 'height': 950 if moderator else 844, 'deviceScaleFactor': 1, 'mobile': not moderator})
+            return c, context
+
+        def text(c, value):
+            c.wait(f'document.body.innerText.includes({json.dumps(value)})')
+
+        def click(c, label):
+            c.click(label)
+
+        def screenshot(c, name):
+            c.call('Page.bringToFront')
+            c.screenshot(name)
+
+        def away(c):
+            c.call('Page.navigate', {'url': 'about:blank'})
+            c.wait('location.href === "about:blank"')
+
+        payload = {'title': 'Prizes on stage', 'questions': [
+            {'text': f'Prize question {i}', 'options': [{'text': 'Yes', 'correct': True}, {'text': 'No'}]}
+            for i in range(1, 4)
+        ]}
+        quiz = post('/moderate/quizzes/import', {'quiz_json': json.dumps(payload)}, token)[1]['Location']
+        mod, _ = new_tab(True)
+        mod.navigate(quiz)
+        click(mod, 'Settings')
+        assert mod.evaluate('document.getElementById("number-of-winners").value') == '3'
+        assert mod.evaluate('document.getElementById("number-of-winners").labels[0].textContent') == 'Number of winners'
+        mod.evaluate('document.getElementById("number-of-winners").value = "0"')
+        assert not mod.evaluate('document.querySelector("form").checkValidity()')
+        mod.evaluate('document.getElementById("number-of-winners").value = "2"')
+        click(mod, 'Save quiz')
+        click(mod, 'Start a game')
+        game = mod.evaluate('location.pathname')
+        link = mod.evaluate('document.getElementById("join-link").textContent')
+        mirror, _ = new_tab(True)
+        mirror.navigate(game)
+        people = {}
+        for name in ['Leader', 'Fast', 'Slow', 'Zero']:
+            phone, _ = new_tab()
+            phone.navigate(link)
+            phone.fill('Your name', name)
+            click(phone, 'Join')
+            text(phone, 'Hi, ' + name + '!')
+            people[name] = phone
+        text(mod, 'Players: 4')
+        screens = [mod, mirror, *people.values()]
+        origins = [c.evaluate('performance.timeOrigin') for c in screens]
+        for c in screens:
+            c.evaluate('''(() => {
+                window.questionSeen = {};
+                new MutationObserver(() => {
+                    const q = document.querySelector('.live-question')?.textContent;
+                    if (q && !window.questionSeen[q]) window.questionSeen[q] = Date.now();
+                }).observe(document.getElementById('live-content'), {childList:true, subtree:true});
+            })()''')
+        def control(c, label):
+            click(c, label)
+            c.wait('!!document.querySelector("#live-content button") && [...document.querySelectorAll("#live-content button")].every(b => !b.disabled)')
+        def pick(name, label):
+            click(people[name], label)
+            text(people[name], 'Answer saved.')
+        for i in range(1, 4):
+            control(mod, 'Start' if i == 1 else 'Next')
+            for c in screens: text(c, f'Prize question {i}')
+            times = [c.evaluate(f'window.questionSeen["Prize question {i}"]') for c in screens]
+            assert max(times) - min(times) < 300, times
+            print(f'Question {i}: stage/phone delivery spread {max(times) - min(times)} ms')
+            if i == 1:
+                pick('Slow', 'Yes')
+                pick('Fast', 'Yes')
+                time.sleep(.08)
+                pick('Slow', 'No')
+                pick('Slow', 'Yes')
+                pick('Leader', 'Yes')
+                pick('Zero', 'No')
+            elif i == 2:
+                pick('Leader', 'Yes')
+            for c in people.values():
+                assert not c.evaluate('/[0-9]+ points?/.test(document.body.innerText)')
+            control(mod, 'Finish')
+            for c in people.values():
+                text(c, 'Waiting for the moderator')
+                assert not c.evaluate('/[0-9]+ points?/.test(document.body.innerText)')
+        control(mod, 'End quiz')
+        for c in screens: text(c, 'The quiz is over')
+        def rows(c=mod):
+            return c.evaluate('[...document.querySelectorAll(".leaderboard > li")].map(r => ({place:r.querySelector(".leaderboard-place").textContent, name:r.querySelector(".leaderboard-name").textContent, points:r.querySelector(".leaderboard-points").textContent, winner:!!r.querySelector(".winner-mark")}))')
+        assert [(r['place'], r['name'], r['points']) for r in rows()] == [
+            ('1', 'Leader', '2 points'), ('2', 'Fast', '1 point'), ('3', 'Slow', '1 point'), ('4', 'Zero', '0 points')]
+        for i, (name, phone) in enumerate(people.items(), 1):
+            text(phone, f'Place {i} of 4')
+            text(phone, rows()[i-1]['points'])
+        def winners_match():
+            current = rows()
+            for c in [mod, mirror]:
+                c.wait(f'JSON.stringify([...document.querySelectorAll(".leaderboard > li")].map(r => !!r.querySelector(".winner-mark"))) === {json.dumps(json.dumps([r["winner"] for r in current], separators=(",", ":")))}')
+            for r in current:
+                people[r['name']].wait(f'document.body.innerText.includes("You won!") === {str(r["winner"]).lower()}')
+            return tuple(r['name'] for r in current if r['winner'])
+        control(mod, 'Top 2')
+        assert winners_match() == ('Leader', 'Fast')
+        draws = set()
+        for _ in range(30):
+            control(mod, 'Draw')
+            chosen = winners_match()
+            assert chosen in [('Leader', 'Fast'), ('Leader', 'Slow')]
+            draws.add(chosen)
+            if len(draws) == 2: break
+        assert len(draws) == 2
+        screenshot(mod, 'prizes-leaderboard.png')
+        screenshot(people['Leader'], 'prizes-phone.png')
+        # A second moderator tab controls a live reset on every other screen.
+        control(mirror, 'Reset winners')
+        mod.wait('document.querySelectorAll(".winner-mark").length === 0')
+        assert winners_match() == ()
+        control(mod, 'Top 2')
+        assert winners_match() == ('Leader', 'Fast')
+        for c, origin in zip(screens, origins):
+            assert c.evaluate('performance.timeOrigin') == origin, 'Live updates must not reload'
+            assert c.evaluate('document.documentElement.scrollWidth <= innerWidth'), 'Horizontal overflow'
+            assert not [e for e in c.events if e.get('method') == 'Runtime.exceptionThrown']
+        # Ended pages must subscribe as well as pages that watched the game end.
+        people['Fast'].navigate(link)
+        text(people['Fast'], 'You won!')
+        control(mod, 'Reset winners')
+        assert winners_match() == ()
+        mod.call('Emulation.setDeviceMetricsOverride', {'width': 390, 'height': 844, 'deviceScaleFactor': 1, 'mobile': True})
+        assert mod.evaluate('document.documentElement.scrollWidth <= innerWidth')
+        screenshot(mod, 'prizes-leaderboard-mobile.png')
+        print('PASS: Chromium prize settings, immediate delivery, last-pick speed, leaderboard/place/points, live top/draw/reset, ended reconnect, no reloads, mobile layouts')
+    except Exception:
+        for i, c in enumerate(clients):
+            try: print('PAGE', i, c.evaluate('document.body.innerText'))
+            except Exception: pass
+        raise
+    finally:
+        if quiz: post(quiz + '/delete', {}, token)
+        for c in clients: c.socket.close()
+        if root: root.socket.close()
+        process.terminate()
+        process.wait(timeout=10)
+
+if __name__ == '__main__': run()
