+'use strict';
+(() => {
+  const shell = document.getElementById('live-game');
+  if (!shell) return;
+  const root = document.getElementById('live-content');
+  const status = document.getElementById('connection-status');
+  const error = document.getElementById('live-error');
+  const details = document.getElementById('join-details');
+  const moderator = shell.dataset.moderator === 'true';
+  const base = shell.dataset.base;
+  let state = JSON.parse(document.getElementById('live-data').textContent);
+  let source, heartbeatTimer, reconnectTimer, watchdog, countdownTimer;
+  let countdownEnd = null, countdownKey = null;
+  let lastEvent = Date.now(), lastHeartbeat = 0;
+  let pending = null, sending = false, controlling = false, lastRender = '';
+
+  function node(tag, className, text) {
+    const e = document.createElement(tag);
+    e.className = className;
+    if (text !== undefined) e.textContent = text;
+    return e;
+  }
+  function button(label, action) {
+    const b = node('button', 'btn btn--pink btn--lg', label);
+    b.type = 'button';
+    b.disabled = controlling;
+    b.addEventListener('click', action);
+    return b;
+  }
+  function syncCountdown() {
+    // Only the moderator receives a clock sample. A page load/reconnect uses
+    // the persisted server deadline, never a new full-duration countdown.
+    if (!moderator || !state.timer) {
+      countdownEnd = countdownKey = null;
+      return;
+    }
+    const key = `${state.index}:${state.timer.deadline_ms}`;
+    const end = performance.now() + Math.max(0, state.timer.deadline_ms - state.timer.server_now_ms);
+    // Delayed HTTP/SSE samples from this same question may shorten the clock,
+    // but cannot add time to a countdown already running in this page.
+    countdownEnd = countdownKey === key ? Math.min(countdownEnd, end) : end;
+    countdownKey = key;
+  }
+  function updateCountdown() {
+    const timer = document.getElementById('question-timer');
+    if (!timer || countdownEnd === null) return;
+    const seconds = Math.max(0, Math.ceil((countdownEnd - performance.now()) / 1000));
+    const text = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
+    if (timer.textContent !== text) timer.textContent = text;
+    timer.classList.toggle('is-urgent', seconds <= 5);
+    // Do not send Finish from the browser: the server closes the question
+    // independently, including when the screen sleeps or loses its connection.
+  }
+  function points(value) { return `${value} ${value === 1 ? "point" : "points"}`; }
+  function render() {
+    if (details) details.hidden = state.phase !== 'waiting';
+    // Keep a half-typed name intact when the moderator advances the game.
+    if (!moderator && state.name === null && state.phase !== 'ended') return;
+    const signature = JSON.stringify([state, pending, sending, controlling]);
+    if (signature === lastRender) return;
+    lastRender = signature;
+    const focused = document.activeElement?.dataset.option;
+    root.replaceChildren();
+    if (state.phase === 'ended') {
+      root.append(node('div', 'end-mark', '✓'), node('h1', '', 'The quiz is over'), node('p', 'live-subtitle', 'Thanks for playing!'));
+      if (moderator) {
+        root.append(node('h2', 'leaderboard-title', 'Leaderboard'));
+        const controls = node('div', 'buttons prize-controls');
+        controls.append(button(`Top ${state.number_of_winners}`, () => control('top')),
+          button('Draw', () => control('draw')), button('Reset winners', () => control('reset')));
+        root.append(controls, node('p', 'meta', 'Top players win by points, then speed. Draw shares the remaining prizes randomly among players tied on points. Zero points never wins.'));
+        const board = node('ol', 'list-reset leaderboard');
+        board.setAttribute('aria-label', 'Leaderboard');
+        state.leaderboard.forEach(player => {
+          const row = node('li', `leaderboard-row${player.winner ? ' is-winner' : ''}`);
+          row.append(node('span', 'leaderboard-place', String(player.place)),
+            node('span', 'leaderboard-name', player.name),
+            node('span', 'leaderboard-points', points(player.points)));
+          if (player.winner) row.append(node('span', 'winner-mark', 'Winner'));
+          board.append(row);
+        });
+        root.append(board);
+        if (!state.leaderboard.length) root.append(node('p', 'live-subtitle', 'No players joined this game.'));
+      } else if (state.name) {
+        root.append(node('p', 'live-greeting', state.name),
+          node('p', 'live-place', `Place ${state.place} of ${state.total_players}`),
+          node('p', 'live-points', points(state.points)));
+        if (state.winner) root.append(node('p', 'phone-winner', 'You won!'));
+        else root.append(node('p', 'meta', 'Stay here for the prize announcement.'));
+      }
+      // Prize decisions (and resets) continue to arrive after the last question.
+      return;
+    }
+    if (state.name) root.append(node('p', 'live-greeting', `Hi, ${state.name}!`));
+    if (state.phase === 'waiting') {
+      root.append(node('p', 'eyebrow', moderator ? 'Ready when you are' : 'You’re in'), node('h1', '', state.title));
+      if (moderator) {
+        root.append(node('p', 'live-counter', `Players: ${state.players}`), button('Start', () => control('start')));
+        if (!state.total) root.append(node('p', 'meta', 'No active questions. Starting will end this game.'));
+      } else {
+        root.append(node('p', 'live-subtitle', 'Waiting for the quiz to start…'), node('p', 'meta', 'Keep this page open. Questions will appear here automatically.'));
+      }
+      return;
+    }
+    root.append(node('p', 'eyebrow live-progress', `Question ${state.index + 1} of ${state.total}`));
+    if (!state.question) return;
+    root.append(node('h1', 'live-question', state.question.text));
+    if (moderator && state.phase === 'open') {
+      const counters = node('div', 'live-question-status');
+      counters.append(node('p', 'live-counter', `Answers: ${state.answers} / ${state.players}`));
+      if (state.timer) {
+        const timer = node('p', 'live-timer');
+        timer.id = 'question-timer';
+        timer.setAttribute('role', 'timer');
+        timer.setAttribute('aria-label', 'Time remaining');
+        timer.setAttribute('aria-live', 'off');
+        counters.append(timer);
+      }
+      root.append(counters);
+      updateCountdown();
+    }
+    if (state.result) root.append(node('p', `live-result ${state.result === 'Correct!' ? 'is-right' : ''}`, state.result));
+    const options = node('ul', 'list-reset live-options');
+    options.setAttribute('aria-label', 'Options');
+    const selected = pending && pending.index === state.index ? pending.option : state.selected;
+    state.question.options.forEach((choice, i) => {
+      const row = node('li', '');
+      const option = node(moderator ? 'div' : 'button', 'live-option');
+      if (!moderator) {
