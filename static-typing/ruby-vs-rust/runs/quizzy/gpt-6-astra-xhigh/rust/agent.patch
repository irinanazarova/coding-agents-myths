+#!/usr/bin/env python3
+"""Real Chromium, isolated moderator and phone contexts; no third-party tools."""
+import json
+import shutil
+import subprocess
+import time
+import urllib.request
+from browser import DevTools, ARTIFACTS
+from smoke import AUTH, BASE, csrf, post, request
+
+
+def run():
+    profile = ARTIFACTS / 'live-profile'
+    shutil.rmtree(profile, ignore_errors=True)
+    with open(ARTIFACTS / 'live-chromium.log', 'w') as log:
+        process = subprocess.Popen(['chromium', '--headless=new', '--no-sandbox', '--disable-dev-shm-usage',
+            '--disable-background-networking', '--disable-component-update', '--disable-sync',
+            '--disable-background-timer-throttling', '--disable-renderer-backgrounding',
+            '--no-first-run', '--no-default-browser-check', '--remote-debugging-port=9223',
+            f'--user-data-dir={profile}', 'about:blank'], stdout=log, stderr=log)
+    root = None
+    quiz = None
+    clients = []
+    token = csrf('/moderate/quizzes/new')
+    try:
+        for _ in range(100):
+            try:
+                info = json.load(urllib.request.urlopen('http://127.0.0.1:9223/json/version', timeout=1))
+                break
+            except Exception: time.sleep(.1)
+        root = DevTools(info['webSocketDebuggerUrl'])
+
+        def new_tab(moderator=False, context=None):
+            if context is None:
+                context = root.call('Target.createBrowserContext')['browserContextId']
+            target = root.call('Target.createTarget', {'url': 'about:blank', 'browserContextId': context})['targetId']
+            tabs = json.load(urllib.request.urlopen('http://127.0.0.1:9223/json/list'))
+            c = DevTools(next(t['webSocketDebuggerUrl'] for t in tabs if t['id'] == target))
+            clients.append(c)
+            for method in ['Page.enable', 'Runtime.enable', 'Network.enable', 'Log.enable']: c.call(method)
+            if moderator: c.call('Network.setExtraHTTPHeaders', {'headers': {'Authorization': AUTH}})
+            c.call('Emulation.setDeviceMetricsOverride', {'width': 1440 if moderator else 390, 'height': 950 if moderator else 844, 'deviceScaleFactor': 1, 'mobile': not moderator})
+            return c, context
+
+        def text(c, value):
+            c.wait(f'document.body.innerText.includes({json.dumps(value)})')
+
+        def click(c, label):
+            c.click(label)
+
+        def screenshot(c, name):
+            c.call('Page.bringToFront')
+            c.screenshot(name)
+
+        def away(c):
+            c.call('Page.navigate', {'url': 'about:blank'})
+            c.wait('location.href === "about:blank"')
+
+        payload = {'title': 'Conference live game', 'questions': [
+            {'text': 'Choose a color', 'options': [{'text': 'Blue', 'correct': True}, {'text': 'Pink'}, {'text': 'Green', 'correct': True}]},
+            {'text': 'Do not show this inactive question', 'active': False, 'options': [{'text': 'Skip', 'correct': True}, {'text': 'Other'}]},
+            {'text': 'Pick a number', 'options': [{'text': 'One'}, {'text': 'Two', 'correct': True}]},
+            {'text': 'Last question', 'options': [{'text': 'Yes', 'correct': True}, {'text': 'No'}]},
+        ]}
+        status, headers, _ = post('/moderate/quizzes/import', {'quiz_json': json.dumps(payload)}, token)
+        assert status == 303
+        quiz = headers['Location']
+        mod, _ = new_tab(True)
+        mod.navigate(quiz)
+        click(mod, 'Start a game')
+        text(mod, 'Players: 0')
+        game = mod.evaluate('location.pathname')
+        link = mod.evaluate('document.getElementById("join-link").textContent')
+        assert link.startswith(BASE + '/play/')
+        mod.wait('document.querySelector(".join-qr").naturalWidth > 0')
+        screenshot(mod, 'live-lobby.png')
+        alice, alice_context = new_tab()
+        bob, _ = new_tab()
+        alice.navigate(link)
+        bob.navigate(link)
+        alice.fill('Your name', 'Alice')
+        click(alice, 'Join')
+        text(alice, 'Hi, Alice!')
+        bob.fill('Your name', 'Bob')
+        click(bob, 'Join')
+        text(bob, 'Hi, Bob!')
+        text(mod, 'Players: 2')
+        waiting, _ = new_tab()
+        waiting.navigate(link)
+        waiting.fill('Your name', 'Not joined yet')
+        # Reopening in another tab is the same identity, not a third player.
+        alice2, _ = new_tab(context=alice_context)
+        alice2.navigate(link)
+        text(alice2, 'Hi, Alice!')
+        text(mod, 'Players: 2')
+        away(alice2)
+        text(mod, 'Players: 2')
+        origins = [c.evaluate('performance.timeOrigin') for c in [mod, alice, bob]]
+        click(mod, 'Start')
+        for c in [mod, alice, bob]:
+            text(c, 'Choose a color')
+            text(c, 'Question 1 of 3')
+        text(mod, 'Answers: 0 / 2')
+        assert waiting.evaluate('document.getElementById("name").value') == 'Not joined yet'
+        # No correctness data in either initial HTML or public JSON while open.
+        initial = alice.evaluate('document.getElementById("live-data").textContent')
+        live = alice.evaluate('fetch(location.pathname + "/state").then(r=>r.json())')
+        assert 'correct' not in initial.lower() and 'correct' not in json.dumps(live).lower()
+        assert 'Do not show' not in json.dumps(live)
+        click(alice, 'Pink')
+        text(alice, 'Your answer')
+        text(alice, 'Answer saved.')
+        text(mod, 'Answers: 1 / 2')
+        click(alice, 'Blue')
+        text(alice, 'Answer saved.')
+        text(mod, 'Answers: 1 / 2')
+        assert alice.evaluate('document.querySelector("button[aria-label=Blue]").innerText.includes("Your answer")')
+        # Rapid changes keep just the final pick without duplicating counts.
+        alice.evaluate('["Pink","Blue","Pink","Green"].forEach(t=>document.querySelector(`button[aria-label="${t}"]`).click())')
+        text(alice, 'Answer saved.')
+        alice.wait('document.querySelector("button[aria-label=Green]").innerText.includes("Your answer")')
+        screenshot(mod, 'live-open.png')
+        screenshot(alice, 'live-phone-answer.png')
+        click(mod, 'Finish')
+        text(alice, 'Correct!')
+        text(bob, 'No answer')
+        text(mod, 'Correct')
+        mod.wait('[...document.querySelectorAll(".live-option")].find(e=>e.textContent.includes("Green")).textContent.includes("Answers: 1")')
+        mod.wait('[...document.querySelectorAll(".live-option")].find(e=>e.textContent.includes("Blue")).textContent.includes("Answers: 0")')
+        assert len(alice.evaluate('[...document.querySelectorAll(".correct-mark")].map(e=>e.textContent)')) == 2
+        assert all(c.evaluate('performance.timeOrigin') == t for c, t in zip([mod, alice, bob], origins))
+        screenshot(mod, 'live-results.png')
+        click(mod, 'Next')
+        for c in [mod, alice, bob]: text(c, 'Pick a number')
+        text(mod, 'Answers: 0 / 2')
+        click(alice, 'One')
+        text(alice, 'Answer saved.')
+        click(bob, 'Two')
+        text(bob, 'Answer saved.')
+        text(mod, 'Answers: 2 / 2')
+        # A departing phone is removed; returning keeps its identity and answer.
+        away(bob)
+        text(mod, 'Answers: 2 / 1')
+        bob.navigate(link)
+        text(bob, 'Hi, Bob!')
+        text(bob, 'Your answer')
+        text(mod, 'Answers: 2 / 2')
+        # Late join on the active question and one unanswered player.
+        late, _ = new_tab()
+        late.navigate(link)
+        late.fill('Your name', 'Late')
+        click(late, 'Join')
+        text(late, 'Pick a number')
+        text(mod, 'Answers: 2 / 3')
+        click(mod, 'Finish')
+        text(alice, 'Wrong!')
+        text(bob, 'Correct!')
+        text(late, 'No answer')
+        click(mod, 'Next')
+        text(mod, 'Question 3 of 3')
+        text(alice, 'Last question')
+        # Real network interruption: answer queued offline, then saved online.
+        alice.call('Network.emulateNetworkConditions', {'offline': True, 'latency': 0, 'downloadThroughput': 0, 'uploadThroughput': 0})
+        click(alice, 'Yes')
+        text(alice, 'Answer not confirmed.')
+        alice.call('Network.emulateNetworkConditions', {'offline': False, 'latency': 0, 'downloadThroughput': -1, 'uploadThroughput': -1})
+        text(alice, 'Answer saved.')
+        text(mod, 'Answers: 1 / 3')
+        click(mod, 'Finish')
+        text(mod, 'End quiz')
+        click(mod, 'End quiz')
+        for c in [mod, alice, bob, late, waiting]: text(c, 'The quiz is over')
+        fresh, _ = new_tab()
+        fresh.navigate(link)
+        text(fresh, 'The quiz is over')
+        assert fresh.evaluate('document.querySelector("input[name=name]") === null')
+        # A new game is independent and remembers no old player or answer.
+        mod.navigate(quiz)
+        assert mod.evaluate('document.querySelectorAll(".game-history li").length') == 1
+        click(mod, 'Start a game')
+        text(mod, 'Players: 0')
+        newlink = mod.evaluate('document.getElementById("join-link").textContent')
+        assert newlink != link
+        alice.navigate(newlink)
+        text(alice, 'Your name')
+        assert not alice.evaluate('document.body.innerText.includes("Hi, Alice!")')
+        for c in [mod, alice, bob, late, fresh]:
+            assert c.evaluate('document.documentElement.scrollWidth <= innerWidth'), 'Horizontal overflow'
+            errors = [e for e in c.events if e.get('method') == 'Runtime.exceptionThrown']
+            assert not errors, errors
+        print('PASS: Chromium live phones/stage, no reloads, private answers, QR, presence, multi-tab identity, late joins, changed answers, offline retry, results, isolated games, mobile layout')
+    except Exception:
+        for i, c in enumerate(clients):
+            try:
+                print('PAGE', i, c.evaluate('document.body.innerText'))
+                screenshot(c, f'live-failure-{i}.png')
+            except Exception: pass
+        raise
+    finally:
+        if quiz: post(quiz + '/delete', {}, token)
+        for c in clients: c.socket.close()
+        if root: root.socket.close()
+        process.terminate()
+        process.wait(timeout=10)
+
+if __name__ == '__main__': run()
