@@ -0,0 +1,115 @@
+#!/usr/bin/env python3
+"""Scoring/prize HTTP regression, against a running bin/serve."""
+import json
+import re
+import time
+from smoke import csrf, post, request
+from live_game import Player
+
+
+def run():
+    token = csrf('/moderate/quizzes/new')
+    assert 'Number of winners' in request('/moderate/quizzes/new')[2], 'Missing prize setting'
+    for invalid in ['', '0', '-1', '1.5', 'abc', '9999999999999999999999999']:
+        status, _, body = post('/moderate/quizzes', {'title': 'Invalid prizes', 'number_of_winners': invalid}, token)
+        assert status == 422 and 'Number of winners must be a whole number of at least 1' in body
+    payload = {'title': 'Prizes regression', 'questions': [
+        {'text': f'Question {i}', 'options': [{'text': 'Yes', 'correct': True}, {'text': 'No'}]}
+        for i in range(3)
+    ]}
+    status, headers, _ = post('/moderate/quizzes/import', {'quiz_json': json.dumps(payload)}, token)
+    assert status == 303
+    quiz = headers['Location']
+    try:
+        assert post(quiz, {'title': payload['title'], 'number_of_winners': '2'}, token)[0] == 303
+        edit = request(quiz + '/edit')[2]
+        assert re.search(r'name="number_of_winners"[^>]*value="2"', edit)
+        assert post(quiz, {'title': 'Should not save', 'number_of_winners': '0'}, token)[0] == 422
+        assert 'Should not save' not in request(quiz)[2]
+        assert '&quot;number_of_winners&quot;: 2' in request(quiz + '/export')[2]
+        game = post(quiz + '/games', {}, token)[1]['Location']
+        # Settings affect future games, not an already-created game.
+        assert post(quiz, {'title': payload['title'], 'number_of_winners': '9'}, token)[0] == 303
+        link = '/play/' + game.rsplit('/', 1)[1]
+        people = {name: Player() for name in ['Leader', 'Fast', 'Slow', 'Zero', 'Absent']}
+        for name, p in people.items():
+            assert p.request(link + '/join', {'name': name})[0] == 200
+        def state(): return json.loads(request(game + '/state')[2])
+        def control(action):
+            status, _, body = post(game + '/action', {'action': action, 'version': state()['version']}, token)
+            assert status == 200, body
+            return json.loads(body)
+        def pick(name, option):
+            p = people[name]
+            s = p.state(link)
+            assert 'points' not in s and 'leaderboard' not in s
+            assert p.request(link + '/answer', {'csrf': s['csrf'], 'question': s['index'], 'option': option})[0] == 200
+        control('start')
+        assert post(game + '/action', {'action': 'top', 'version': state()['version']}, token)[0] == 409
+        # Slow's first pick must NOT be used: their last pick comes after Fast.
+        pick('Slow', 0)
+        time.sleep(.05)
+        pick('Fast', 0)
+        time.sleep(.05)
+        pick('Slow', 1)
+        pick('Slow', 0)
+        pick('Leader', 0)
+        pick('Zero', 1)
+        control('finish')
+        for _ in range(2):
+            control('next')
+            pick('Leader', 0)
+            control('finish')
+        s = control('end')
+        assert s['number_of_winners'] == 2
+        board = s['leaderboard']
+        assert [(r['name'], r['points']) for r in board] == [('Leader', 3), ('Fast', 1), ('Slow', 1), ('Zero', 0), ('Absent', 0)], board
+        for place, (name, p) in enumerate(people.items(), 1):
+            phone = p.state(link)
+            assert phone['place'] == place and phone['total_players'] == 5
+            assert phone['points'] == board[place - 1]['points'] and not phone['winner']
+        assert [r['name'] for r in control('top')['leaderboard'] if r['winner']] == ['Leader', 'Fast']
+        draws = set()
+        for _ in range(40):
+            winners = tuple(r['name'] for r in control('draw')['leaderboard'] if r['winner'])
+            assert winners in [('Leader', 'Fast'), ('Leader', 'Slow')], winners
+            draws.add(winners)
+        assert len(draws) == 2, 'Draw must ignore speed and reroll'
+        assert not any(r['winner'] for r in control('reset')['leaderboard'])
+        assert all(not p.state(link)['winner'] for p in people.values())
+        assert request(game + '/state', auth=None)[0] == 401
+        assert post(game + '/action', {'action': 'top', 'version': state()['version']}, 'bad')[0] == 403
+        # More prizes than eligible players: everyone with points, never zeroes.
+        game = post(quiz + '/games', {}, token)[1]['Location']
+        link = '/play/' + game.rsplit('/', 1)[1]
+        people = {name: Player() for name in ['Only point', 'Zero']}
+        for name, p in people.items(): p.request(link + '/join', {'name': name})
+        control('start')
+        pick('Only point', 0)
+        control('finish')
+        for _ in range(2):
+            control('next')
+            control('finish')
+        control('end')
+        for action in ['top', 'draw', 'draw', 'top']:
+            s = control(action)
+            assert s['number_of_winners'] == 9
+            assert [r['name'] for r in s['leaderboard'] if r['winner']] == ['Only point']
+        # Empty leaderboard, and then a game with only unanswered zero-point players.
+        for join_zero in [False, True]:
+            game = post(quiz + '/games', {}, token)[1]['Location']
+            link = '/play/' + game.rsplit('/', 1)[1]
+            if join_zero: Player().request(link + '/join', {'name': 'No points'})
+            control('start')
+            control('finish')
+            for _ in range(2):
+                control('next')
+                control('finish')
+            control('end')
+            for action in ['top', 'draw', 'reset']:
+                assert not any(r['winner'] for r in control(action)['leaderboard'])
+        print('PASS: invalid/valid settings, snapshot settings, sparse/empty/all-zero games, points, last-pick speed, all-player places, Top N, repeated tie draws, reset, auth')
+    finally:
+        post(quiz + '/delete', {}, token)
+
+if __name__ == '__main__': run()
