+#!/usr/bin/env python3
+"""Isolated process restarts and idle expiry; all temporary data stays in storage/."""
+import json
+import os
+from pathlib import Path
+import socket
+import sqlite3
+import subprocess
+import tempfile
+import time
+import smoke
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def run():
+    subprocess.run(['cargo', 'build', '--release', '--offline', '--locked'], cwd=ROOT, check=True)
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1', 0))
+        port = sock.getsockname()[1]
+    smoke.BASE = f'http://127.0.0.1:{port}'
+    env = dict(os.environ, PORT=str(port), SECRET_KEY_BASE='timer-persistence-secret',
+               QUIZZY_MODERATOR_USERNAME=smoke.USER, QUIZZY_MODERATOR_PASSWORD=smoke.PASSWORD)
+    with tempfile.TemporaryDirectory(prefix='timer-restart-', dir=ROOT / 'storage') as directory:
+        process = None
+        with (Path(directory) / 'server.log').open('w') as log:
+            def start():
+                nonlocal process
+                process = subprocess.Popen([ROOT / 'target/release/quizzy'], cwd=directory, env=env, stdout=log, stderr=log)
+                for _ in range(100):
+                    assert process.poll() is None
+                    try:
+                        if smoke.request('/up', auth=None)[0] == 200: return
+                    except OSError: pass
+                    time.sleep(.05)
+                raise AssertionError('Server not ready')
+
+            def stop():
+                if process and process.poll() is None:
+                    process.terminate()
+                    process.wait(timeout=5)
+
+            def stored(game):
+                with sqlite3.connect(Path(directory) / 'storage/quizzy.sqlite3') as db:
+                    return db.execute('SELECT phase, version, opened_at_us, timer_seconds FROM games WHERE code=?', (game.rsplit('/', 1)[-1],)).fetchone()
+
+            try:
+                start()
+                token = smoke.csrf('/moderate/quizzes/new')
+                quiz = smoke.post('/moderate/quizzes', {'title': 'Restart timer', 'timer_minutes': 0, 'timer_seconds': 4}, token)[1]['Location']
+                smoke.post(quiz + '/questions', {'question': 'Durable deadline', 'active': 'on', 'option_1': 'Yes', 'correct_1': 'on', 'option_2': 'No'}, token)
+                game = smoke.post(quiz + '/games', {}, token)[1]['Location']
+                opened = json.loads(smoke.post(game + '/action', {'action': 'start', 'version': 0}, token)[2])
+                original = stored(game)
+                time.sleep(.3)
+                stop()
+                start()
+                assert stored(game) == original, 'Restart reset or closed a not-yet-due clock'
+                state = json.loads(smoke.request(game + '/state')[2])
+                assert state['phase'] == 'open'
+                assert state['timer']['deadline_ms'] == opened['timer']['deadline_ms']
+                assert state['timer']['server_now_ms'] > opened['timer']['server_now_ms']
+                stop()
+                time.sleep(4.1)
+                start()
+                # No game endpoint has been read: startup alone reconciles overdue clocks.
+                assert stored(game) == ('closed', 2, original[2], 4)
+                fields = smoke.Document(smoke.request(quiz + '/edit')[2]).inputs
+                assert fields['timer_seconds']['value'] == '4'
+                game = smoke.post(quiz + '/games', {}, token)[1]['Location']
+                smoke.post(game + '/action', {'action': 'start', 'version': 0}, token)
+                original = stored(game)
+                time.sleep(4.3)  # No browser, polling, or /state calls drive this transition.
+                assert stored(game) == ('closed', 2, original[2], 4)
+                print('PASS: persisted settings/deadlines across restarts, startup expiry before readiness, idle server-side expiry without clients')
+            finally:
+                stop()
+
+
+if __name__ == '__main__': run()
