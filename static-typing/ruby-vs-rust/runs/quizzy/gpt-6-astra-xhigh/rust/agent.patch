+.join-details { display: flex; align-items: center; justify-content: space-between; gap: 32px; background: var(--c-white); padding: 28px; border-radius: 24px; margin-top: 32px; }
+.join-link { font-size: clamp(20px, 2.7vw, 36px); font-weight: 700; overflow-wrap: anywhere; margin: 14px 0; }
