+import json
+import os
+from pathlib import Path
+import re
+import signal
+import socket
+import subprocess
+import time
+import smoke
+from import_export import exported
+
+ROOT = Path(__file__).resolve().parents[1]
+ROOT.joinpath('storage').mkdir(exist_ok=True)
+with socket.socket() as sock:
+    sock.bind(('127.0.0.1', 0))
+    port = sock.getsockname()[1]
+smoke.BASE = f'http://127.0.0.1:{port}'
+env = dict(os.environ, PORT=str(port), SECRET_KEY_BASE='persistence-regression-secret', QUIZZY_MODERATOR_USERNAME=smoke.USER, QUIZZY_MODERATOR_PASSWORD=smoke.PASSWORD)
+log = ROOT.joinpath('storage/persistence-test.log').open('w')
+process = None
+quiz = None
+imported = None
+token = None
+
+def start():
+    global process
+    process = subprocess.Popen(['bin/serve'], cwd=ROOT, env=env, stdout=log, stderr=log)
+    for _ in range(300):
+        if process.poll() is not None: raise RuntimeError('bin/serve exited; check storage/persistence-test.log')
+        try:
+            if smoke.request('/up', auth=None)[0] == 200: return
+        except Exception: pass
+        time.sleep(.1)
+    raise RuntimeError('Server did not become ready')
+
+def stop():
+    if process and process.poll() is None:
+        process.send_signal(signal.SIGINT)
+        process.wait(timeout=10)
+
+try:
+    start()
+    token = smoke.csrf('/moderate/quizzes/new')
+    _, headers, _ = smoke.post('/moderate/quizzes', {'title': 'Persisted quiz'}, token)
+    quiz = headers['Location']
+    for n in range(1, 4):
+        fields = {'question': f'Persisted question {n}', 'option_1': 'Yes', 'correct_1': 'on', 'option_2': '', 'option_3': 'No'}
+        if n != 2: fields['active'] = 'on'
+        assert smoke.post(quiz + '/questions', fields, token)[0] == 303
+    ids = re.findall(r'id="question-(\d+)"', smoke.request(quiz)[2])
+    last = quiz + '/questions/' + ids[-1]
+    for _ in range(2): assert smoke.post(last + '/move', {'direction': 'up'}, token)[0] == 303
+    assert smoke.post(quiz + '/questions/' + ids[0] + '/delete', {}, token)[0] == 303
+    assert smoke.post(quiz, {'title': 'Persisted renamed quiz'}, token)[0] == 303
+    before = smoke.request(quiz)[2]
+    contents = exported(quiz)
+    status, headers, _ = smoke.post('/moderate/quizzes/import', {'quiz_json': json.dumps(contents)}, token)
+    assert status == 303
+    imported = headers['Location']
+    assert imported != quiz and exported(imported) == contents
+    stop()
+    start()
+    after = smoke.request(quiz)[2]
+    assert after == before, 'Quiz data or order changed after restart'
+    assert exported(imported) == contents, 'Imported contents changed after restart'
+    assert exported(quiz) == contents
+    assert '1 of 2 questions active' in after
+    assert after.index('Persisted question 3') < after.index('Persisted question 2')
+    preview = smoke.request(quiz + '/preview')[2]
+    payload = re.search(r'<script type="application/json" id="preview-data">(.*?)</script>', preview, re.S).group(1)
+    questions = json.loads(payload)
+    assert len(questions) == 1 and questions[0]['text'] == 'Persisted question 3'
+    assert questions[0]['options'] == [{'text': 'Yes', 'correct': True}, {'text': 'No', 'correct': False}]
+    assert smoke.post(imported + '/delete', {}, token)[0] == 303
+    deleted_import = imported
+    imported = None
+    assert smoke.post(quiz + '/delete', {}, token)[0] == 303
+    deleted = quiz
+    quiz = None
+    stop()
+    start()
+    assert smoke.request(deleted)[0] == 404
+    assert smoke.request(deleted_import)[0] == 404
+    print('PASS: bin/serve offline startup and persistence of title, options, correct answers, order, inactive state, imported contents, and deletion across restarts')
+finally:
+    if imported and process and process.poll() is None and token:
+        smoke.post(imported + '/delete', {}, token)
+    if quiz and process and process.poll() is None and token:
+        smoke.post(quiz + '/delete', {}, token)
+    stop()
+    log.close()
