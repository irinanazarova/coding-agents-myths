+    lastHeartbeat = Date.now();
+    try { await send('/heartbeat', {}); } catch (_) { /* lease expires during a prolonged outage */ }
+  }
+  function connect() {
+    if (source) return;
+    if (moderator) {
+      clearInterval(countdownTimer);
+      countdownTimer = setInterval(updateCountdown, 100);
+      updateCountdown();
+    }
+    lastEvent = Date.now();
+    source = new EventSource(base + '/events');
+    source.addEventListener('state', event => {
+      lastEvent = Date.now();
+      status.textContent = 'Live';
+      heartbeat();
+      apply(JSON.parse(event.data));
+    });
+    source.addEventListener('ping', () => { lastEvent = Date.now(); heartbeat(); });
+    source.addEventListener('open', () => { status.textContent = 'Live'; heartbeat(); });
+    source.addEventListener('error', () => { status.textContent = 'Reconnecting…'; });
+    source.addEventListener('unavailable', () => { stop(); status.textContent = 'Game unavailable'; });
