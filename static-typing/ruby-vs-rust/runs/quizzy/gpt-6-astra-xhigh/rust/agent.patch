+//! Durable games; only public, current-question projections leave this module.
+use crate::*;
+use axum::{
+    Json,
+    http::HeaderMap,
+    response::sse::{Event, KeepAlive, Sse},
+};
+use qrcode::{QrCode, render::svg};
+use serde_json::{Value, json};
+use std::{convert::Infallible, time::Instant};
+use tokio::sync::watch;
+
+pub fn initialize_db(db: &Connection) -> rusqlite::Result<()> {
+    db.execute_batch("
+        CREATE TABLE IF NOT EXISTS games (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            quiz_id INTEGER NOT NULL REFERENCES quizzes(id) ON DELETE CASCADE,
+            code TEXT NOT NULL UNIQUE,
+            title TEXT NOT NULL,
+            questions TEXT NOT NULL,
+            phase TEXT NOT NULL DEFAULT 'waiting' CHECK(phase IN ('waiting','open','closed','ended')),
+            current_question INTEGER NOT NULL DEFAULT 0,
+            version INTEGER NOT NULL DEFAULT 0,
+            revision INTEGER NOT NULL DEFAULT 0
+        );
+        CREATE INDEX IF NOT EXISTS games_quiz ON games(quiz_id);
+        CREATE TABLE IF NOT EXISTS players (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            name TEXT NOT NULL,
+            token TEXT NOT NULL UNIQUE,
+            UNIQUE(game_id, id)
+        );
+        CREATE TABLE IF NOT EXISTS answers (
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            player_id INTEGER NOT NULL,
+            question_index INTEGER NOT NULL,
+            option_index INTEGER NOT NULL,
+            PRIMARY KEY(game_id, question_index, player_id),
+            FOREIGN KEY(game_id, player_id) REFERENCES players(game_id, id) ON DELETE CASCADE
+        );
+    ")?;
+    add_column(
+        db,
+        "games",
+        "number_of_winners",
+        "INTEGER NOT NULL DEFAULT 3 CHECK(number_of_winners >= 1)",
+    )?;
+    add_column(db, "games", "opened_at_us", "INTEGER NOT NULL DEFAULT 0")?;
+    add_column(
+        db,
+        "games",
+        "timer_seconds",
+        "INTEGER NOT NULL DEFAULT 0 CHECK(timer_seconds >= 0)",
+    )?;
+    db.execute_batch("CREATE INDEX IF NOT EXISTS games_timed_open ON games(opened_at_us) WHERE phase='open' AND timer_seconds>0;")?;
+    add_column(
+        db,
+        "answers",
+        "elapsed_us",
+        "INTEGER NOT NULL DEFAULT 0 CHECK(elapsed_us >= 0)",
+    )?;
+    add_column(db, "answers", "pick_token", "TEXT NOT NULL DEFAULT ''")?;
+    add_column(
+        db,
+        "players",
+        "winner",
+        "INTEGER NOT NULL DEFAULT 0 CHECK(winner IN (0, 1))",
+    )?;
+    // Pre-upgrade open questions have no known opening timestamp. Start their
+    // clock once, without resetting any subsequently persisted clock on restart.
+    db.execute(
+        "UPDATE games SET opened_at_us=? WHERE phase='open' AND opened_at_us=0",
+        [now_us()],
+    )?;
+    Ok(())
+}
+
+fn now_us() -> i64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_micros()
+        .min(i64::MAX as u128) as i64
+}
+
+#[derive(Default)]
+pub struct Hub {
+    rooms: Mutex<HashMap<i64, Room>>,
+    stopping: std::sync::atomic::AtomicBool,
+}
+struct Room {
+    changed: watch::Sender<u64>,
+    players: HashMap<i64, Presence>,
+}
+struct Presence {
+    connections: usize,
+    seen: Instant,
+}
+impl Default for Room {
+    fn default() -> Self {
+        Self {
+            changed: watch::channel(0).0,
+            players: HashMap::new(),
+        }
+    }
+}
+impl Hub {
+    pub fn shutdown(&self) {
+        self.stopping
+            .store(true, std::sync::atomic::Ordering::Relaxed);
+        for room in self.rooms.lock().unwrap().values() {
+            room.changed.send_modify(|v| *v = v.wrapping_add(1));
+        }
+    }
+    fn subscribe(&self, game: i64) -> watch::Receiver<u64> {
+        self.rooms
+            .lock()
+            .unwrap()
+            .entry(game)
+            .or_default()
+            .changed
+            .subscribe()
+    }
+    fn notify(&self, game: i64) {
+        if let Some(room) = self.rooms.lock().unwrap().get_mut(&game) {
+            room.changed
+                .send_modify(|version| *version = version.wrapping_add(1));
+        }
+    }
+    fn connected(&self, game: i64, player: i64) {
+        let mut rooms = self.rooms.lock().unwrap();
+        let room = rooms.entry(game).or_default();
+        let presence = room.players.entry(player).or_insert(Presence {
+            connections: 0,
+            seen: Instant::now(),
+        });
+        presence.connections += 1;
+        presence.seen = Instant::now();
+        room.changed.send_modify(|v| *v = v.wrapping_add(1));
+    }
+    fn disconnected(&self, game: i64, player: i64) {
+        let mut rooms = self.rooms.lock().unwrap();
+        if let Some(room) = rooms.get_mut(&game) {
+            if let Some(presence) = room.players.get_mut(&player) {
+                presence.connections = presence.connections.saturating_sub(1);
+                if presence.connections == 0 {
+                    room.players.remove(&player);
+                }
+            }
+            room.changed.send_modify(|v| *v = v.wrapping_add(1));
+        }
+    }
+    fn heartbeat(&self, game: i64, player: i64) {
+        let mut rooms = self.rooms.lock().unwrap();
+        if let Some(room) = rooms.get_mut(&game)
+            && let Some(presence) = room.players.get_mut(&player)
+        {
+            let expired = presence.seen.elapsed() > Duration::from_secs(45);
+            presence.seen = Instant::now();
+            if expired {
+                room.changed.send_modify(|v| *v = v.wrapping_add(1));
+            }
+        }
+    }
+    fn active(&self, game: i64) -> Vec<i64> {
+        self.rooms
+            .lock()
+            .unwrap()
+            .get(&game)
+            .map(|room| {
+                room.players
+                    .iter()
+                    .filter(|(_, p)| {
+                        p.connections > 0 && p.seen.elapsed() <= Duration::from_secs(45)
+                    })
+                    .map(|(id, _)| *id)
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+}
+struct PresenceGuard {
+    app: AppState,
+    game: i64,
+    player: Option<i64>,
+}
+impl Drop for PresenceGuard {
+    fn drop(&mut self) {
+        if let Some(player) = self.player {
+            self.app.live.disconnected(self.game, player);
+        }
+    }
+}
+
+struct Game {
+    id: i64,
+    quiz_id: i64,
+    code: String,
+    title: String,
+    questions: Vec<Question>,
+    phase: String,
+    index: usize,
+    version: i64,
+    revision: i64,
+    number_of_winners: i64,
+    opened_at_us: i64,
+    timer_seconds: i64,
+}
+impl Game {
+    fn deadline_us(&self) -> Option<i64> {
+        (self.phase == "open" && self.timer_seconds > 0).then(|| {
+            self.opened_at_us
+                .saturating_add(self.timer_seconds.saturating_mul(1_000_000))
+        })
+    }
+}
+struct Player {
+    id: i64,
+    name: String,
+    token: String,
+}
+fn game(db: &Connection, code: &str) -> AppResult<Game> {
+    db.query_row("SELECT id, quiz_id, code, title, questions, phase, current_question, version, revision, number_of_winners, opened_at_us, timer_seconds FROM games WHERE code=?", [code], |r| {
+        let raw: String = r.get(4)?;
+        let questions = serde_json::from_str(&raw).map_err(|e| rusqlite::Error::FromSqlConversionFailure(4, rusqlite::types::Type::Text, Box::new(e)))?;
+        Ok(Game { id: r.get(0)?, quiz_id: r.get(1)?, code: r.get(2)?, title: r.get(3)?, questions, phase: r.get(5)?, index: r.get(6)?, version: r.get(7)?, revision: r.get(8)?, number_of_winners: r.get(9)?, opened_at_us: r.get(10)?, timer_seconds: r.get(11)? })
+    }).optional()?.ok_or(AppError::NotFound)
+}
+// All callers hold the database mutex. Manual Finish, the deadline worker,
+// and request-time expiry use the same idempotent transition.
+fn finish_question(db: &Connection, id: i64) -> AppResult<bool> {
+    Ok(db.execute("UPDATE games SET phase='closed', version=version+1, revision=revision+1 WHERE id=? AND phase='open'", [id])? > 0)
+}
+
+fn current_game(app: &App, db: &Connection, code: &str, now: i64) -> AppResult<Game> {
+    let mut g = game(db, code)?;
+    if g.deadline_us().is_some_and(|deadline| now >= deadline) && finish_question(db, g.id)? {
+        g.phase = "closed".into();
+        g.version += 1;
+        g.revision += 1;
+        app.live.notify(g.id);
+    }
+    Ok(g)
+}
+
+pub fn finish_expired(app: &App) -> AppResult<()> {
+    let db = app.db.lock().unwrap();
+    let mut stmt = db.prepare("SELECT id FROM games WHERE phase='open' AND timer_seconds>0 AND opened_at_us <= ? - timer_seconds * 1000000")?;
+    let ids = stmt
+        .query_map([now_us()], |r| r.get::<_, i64>(0))?
+        .collect::<Result<Vec<_>, _>>()?;
+    for id in ids {
+        if finish_question(&db, id)? {
+            app.live.notify(id);
+        }
+    }
+    Ok(())
+}
+
+pub async fn run_timers(app: AppState) {
+    let mut tick = tokio::time::interval(Duration::from_millis(100));
+    tick.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    loop {
+        tick.tick().await;
+        if app.live.stopping.load(std::sync::atomic::Ordering::Relaxed) {
+            break;
+        }
+        if let Err(error) = finish_expired(&app) {
+            eprintln!("Could not finish expired questions: {error:?}");
+        }
+    }
+}
+
+fn player(db: &Connection, game: &Game, headers: &HeaderMap) -> AppResult<Option<Player>> {
+    let name = format!("quizzy_player_{}", game.code);
+    let token = headers
+        .get(header::COOKIE)
+        .and_then(|h| h.to_str().ok())
+        .and_then(|cookies| {
+            cookies.split(';').find_map(|part| {
+                let (key, value) = part.trim().split_once('=')?;
+                (key == name).then_some(value)
+            })
+        });
+    let Some(token) = token else { return Ok(None) };
+    Ok(db
+        .query_row(
+            "SELECT id, name, token FROM players WHERE game_id=? AND token=?",
+            params![game.id, token],
+            |r| {
+                Ok(Player {
+                    id: r.get(0)?,
+                    name: r.get(1)?,
+                    token: r.get(2)?,
+                })
+            },
+        )
+        .optional()?)
+}
+fn random_hex(bytes: usize) -> String {
+    let mut raw = vec![0u8; bytes];
+    getrandom::getrandom(&mut raw).expect("OS random source");
+    raw.iter().map(|b| format!("{b:02X}")).collect()
+}
+fn player_csrf(app: &App, player: &Player) -> String {
+    let mut mac = Hmac::<Sha256>::new_from_slice(app.csrf.as_bytes()).expect("HMAC key");
+    mac.update(b"Quizzy player action\0");
+    mac.update(player.token.as_bytes());
+    STANDARD.encode(mac.finalize().into_bytes())
+}
+fn verify_player(app: &App, player: &Player, fields: &Fields) -> AppResult<()> {
+    if fields
+        .get("csrf")
+        .is_some_and(|s| constant_eq(s.as_bytes(), player_csrf(app, player).as_bytes()))
+    {
+        Ok(())
+    } else {
+        Err(AppError::Forbidden)
+    }
+}
+fn join_url(headers: &HeaderMap, code: &str) -> AppResult<String> {
+    let host = headers
+        .get(header::HOST)
+        .and_then(|h| h.to_str().ok())
+        .ok_or(AppError::BadRequest)?;
+    host.parse::<axum::http::uri::Authority>()
+        .map_err(|_| AppError::BadRequest)?;
+    Ok(format!("http://{host}/play/{code}"))
+}
+
+pub fn moderator_routes() -> Router<AppState> {
+    Router::new()
+        .route("/quizzes/{id}/games", post(create))
+        .route("/games/{code}", get(moderator_page))
+        .route("/games/{code}/state", get(moderator_state))
+        .route("/games/{code}/events", get(moderator_events))
+        .route("/games/{code}/action", post(action))
+        .route("/games/{code}/qr", get(qr))
+}
+pub fn player_routes() -> Router<AppState> {
+    Router::new()
+        .route("/play/{code}", get(player_page))
+        .route("/play/{code}/join", post(join))
+        .route("/play/{code}/state", get(player_state))
+        .route("/play/{code}/events", get(player_events))
+        .route("/play/{code}/answer", post(answer))
+        .route("/play/{code}/heartbeat", post(heartbeat))
+}
+async fn create(
+    State(app): State<AppState>,
+    Path(id): Path<i64>,
+    Form(fields): Form<Fields>,
+) -> AppResult<Redirect> {
+    verify_csrf(&app, &fields)?;
+    let mut db = app.db.lock().unwrap();
+    let tx = db.transaction()?;
+    let quiz = get_quiz(&tx, id)?;
+    let questions: Vec<_> = get_questions(&tx, id)?
+        .into_iter()
+        .filter(|q| q.active)
+        .collect();
+    let code = loop {
+        let candidate = random_hex(4);
+        if !tx.query_row(
+            "SELECT EXISTS(SELECT 1 FROM games WHERE code=?)",
+            [&candidate],
+            |r| r.get::<_, bool>(0),
+        )? {
+            break candidate;
+        }
+    };
+    tx.execute(
+        "INSERT INTO games(quiz_id, code, title, questions, number_of_winners, timer_seconds) VALUES(?,?,?,?,?,?)",
+        params![
+            id,
+            code,
+            quiz.title,
+            serde_json::to_string(&questions).unwrap(),
+            quiz.number_of_winners,
+            quiz.timer_seconds
+        ],
+    )?;
+    tx.commit()?;
+    Ok(Redirect::to(&format!("/moderate/games/{code}")))
+}
+
+// Build an explicit public projection: never serialize Game/Question directly.
+fn snapshot(app: &App, code: &str, headers: &HeaderMap, moderator: bool) -> AppResult<Value> {
+    let db = app.db.lock().unwrap();
+    let now = now_us();
+    let g = current_game(app, &db, code, now)?;
+    let p = if moderator {
+        None
+    } else {
+        player(&db, &g, headers)?
+    };
+    let mut state = json!({"title":g.title, "phase":g.phase, "version":g.version, "revision":g.revision,
+        "index":g.index, "total":g.questions.len(), "name":p.as_ref().map(|p| &p.name),
+        "csrf":if moderator { Some(app.csrf.clone()) } else { p.as_ref().map(|p| player_csrf(app,p)) },
+        "selected":null});
+    let active = if moderator {
+        app.live.active(g.id)
+    } else {
+        vec![]
+    };
+    if moderator {
+        state["players"] = json!(active.len());
+        state["quiz_id"] = json!(g.quiz_id);
+        if let Some(deadline) = g.deadline_us() {
+            state["timer"] = json!({"deadline_ms": deadline / 1000, "server_now_ms": now / 1000});
+        }
+    }
+    if g.phase == "ended" {
+        let board = prizes::leaderboard(&db, g.id, &g.questions)?;
+        if moderator {
+            state["number_of_winners"] = json!(g.number_of_winners);
+            state["leaderboard"] = json!(board);
+        } else if let Some(p) = &p {
+            let row = board
+                .iter()
+                .find(|r| r.id == p.id)
+                .ok_or(AppError::NotFound)?;
+            state["place"] = json!(row.place);
+            state["total_players"] = json!(board.len());
+            state["points"] = json!(row.points);
+            state["winner"] = json!(row.winner);
+        }
+    }
+    if matches!(g.phase.as_str(), "open" | "closed") && (moderator || p.is_some()) {
+        let q = g.questions.get(g.index).ok_or(AppError::BadRequest)?;
+        let mut stmt = db.prepare(
+            "SELECT player_id, option_index FROM answers WHERE game_id=? AND question_index=?",
+        )?;
+        let answers = stmt
+            .query_map(params![g.id, g.index], |r| {
+                Ok((r.get::<_, i64>(0)?, r.get::<_, usize>(1)?))
+            })?
+            .collect::<Result<Vec<_>, _>>()?;
+        let selected = p
+            .as_ref()
+            .and_then(|p| answers.iter().find(|a| a.0 == p.id).map(|a| a.1));
+        state["selected"] = json!(selected);
+        let options: Vec<_> = q
+            .options
+            .iter()
+            .enumerate()
+            .map(|(i, o)| {
+                let mut choice = json!({"text":o.text});
+                if g.phase == "closed" {
+                    choice["correct"] = json!(o.correct);
+                    choice["count"] = json!(answers.iter().filter(|a| a.1 == i).count());
+                }
+                choice
+            })
+            .collect();
+        state["question"] = json!({"text":q.text, "options":options});
+        if moderator {
+            state["answers"] = json!(answers.len());
+        }
+        if !moderator && g.phase == "closed" {
+            state["result"] = json!(match selected {
+                None => "No answer",
+                Some(i) if q.options[i].correct => "Correct!",
+                _ => "Wrong!",
+            });
+        }
+    }
+    Ok(state)
+}
