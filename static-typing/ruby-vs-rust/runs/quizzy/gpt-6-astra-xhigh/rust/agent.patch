index 0000000..3b5df3f
--- /dev/null
+++ b/src/prizes.rs
@@ -0,0 +1,153 @@
+//! Scores are derived from the immutable game questions and each player's final pick.
+use crate::*;
+
+#[derive(Debug, Serialize)]
+pub(crate) struct Standing {
+    #[serde(skip)]
+    pub id: i64,
+    pub name: String,
+    pub points: usize,
+    #[serde(skip)]
+    pub elapsed_us: i64,
+    pub place: usize,
+    pub winner: bool,
+}
+
+pub(crate) fn leaderboard(
+    db: &Connection,
+    game_id: i64,
+    questions: &[Question],
+) -> AppResult<Vec<Standing>> {
+    let mut stmt =
+        db.prepare("SELECT id, name, winner FROM players WHERE game_id=? ORDER BY id")?;
+    let mut rows = stmt
+        .query_map([game_id], |r| {
+            Ok(Standing {
+                id: r.get(0)?,
+                name: r.get(1)?,
+                winner: r.get(2)?,
+                points: 0,
+                elapsed_us: 0,
+                place: 0,
+            })
+        })?
+        .collect::<Result<Vec<_>, _>>()?;
+    let positions: HashMap<_, _> = rows.iter().enumerate().map(|(i, r)| (r.id, i)).collect();
+    let mut stmt = db.prepare(
+        "SELECT player_id, question_index, option_index, elapsed_us FROM answers WHERE game_id=?",
+    )?;
+    let answers = stmt.query_map([game_id], |r| {
+        Ok((
+            r.get::<_, i64>(0)?,
+            r.get::<_, usize>(1)?,
+            r.get::<_, usize>(2)?,
+            r.get::<_, i64>(3)?,
+        ))
+    })?;
+    for answer in answers {
+        let (player, question, option, elapsed) = answer?;
+        if questions
+            .get(question)
+            .and_then(|q| q.options.get(option))
+            .is_some_and(|o| o.correct)
+            && let Some(&position) = positions.get(&player)
+        {
+            rows[position].points += 1;
+            rows[position].elapsed_us = rows[position].elapsed_us.saturating_add(elapsed);
+        }
+    }
+    // Exact time ties have stable, unique places, independent of presence/name.
+    rows.sort_by_key(|r| (std::cmp::Reverse(r.points), r.elapsed_us, r.id));
+    for (i, row) in rows.iter_mut().enumerate() {
+        row.place = i + 1;
+    }
+    Ok(rows)
+}
+
+// Uniform bounded randomness, without modulo bias. The OS source is local.
+fn random_below(bound: usize) -> usize {
+    let bound = bound as u64;
+    let threshold = bound.wrapping_neg() % bound;
+    loop {
+        let mut bytes = [0; 8];
+        getrandom::getrandom(&mut bytes).expect("OS random source");
+        let value = u64::from_le_bytes(bytes);
+        if value >= threshold {
+            return (value % bound) as usize;
+        }
+    }
+}
+
+pub(crate) fn select(rows: &[Standing], number: i64, draw: bool) -> Vec<i64> {
+    let eligible: Vec<_> = rows.iter().filter(|r| r.points > 0).collect();
+    let count = number.max(0).min(eligible.len() as i64) as usize;
+    if count == 0 {
+        return vec![];
+    }
+    if !draw {
+        return eligible[..count].iter().map(|r| r.id).collect();
+    }
+    let cutoff = eligible[count - 1].points;
+    let mut winners: Vec<_> = eligible
+        .iter()
+        .filter(|r| r.points > cutoff)
+        .map(|r| r.id)
+        .collect();
+    let mut tied: Vec<_> = eligible
+        .iter()
+        .filter(|r| r.points == cutoff)
+        .map(|r| r.id)
+        .collect();
+    for i in (1..tied.len()).rev() {
+        let j = random_below(i + 1);
+        tied.swap(i, j);
+    }
+    winners.extend(tied.into_iter().take(count - winners.len()));
+    winners
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn rows(points: &[usize]) -> Vec<Standing> {
+        points
+            .iter()
+            .enumerate()
+            .map(|(i, &points)| Standing {
+                id: i as i64,
+                name: format!("Player {i}"),
+                points,
+                elapsed_us: i as i64,
+                place: i + 1,
+                winner: false,
+            })
+            .collect()
+    }
+    #[test]
+    fn top_and_draw_never_award_zero_points_or_duplicate_prizes() {
+        for draw in [false, true] {
+            assert!(select(&[], 3, draw).is_empty());
+            assert!(select(&rows(&[0, 0]), 3, draw).is_empty());
+            let mut selected = select(&rows(&[2, 1, 1, 0]), 10, draw);
+            selected.sort();
+            assert_eq!(selected, [0, 1, 2]);
+            assert_eq!(select(&rows(&[3, 2, 1]), 1, draw), [0]);
+        }
+        assert_eq!(select(&rows(&[2, 1, 1, 0]), 2, false), [0, 1]);
+    }
+    #[test]
+    fn draws_use_points_not_speed_and_replace_previous_selection() {
+        let mut seen = std::collections::HashSet::new();
+        let mut rows = rows(&[4, 3, 3, 3, 2, 0]);
+        rows[1].winner = true; // Previous winners have no advantage.
+        for _ in 0..128 {
+            let mut winners = select(&rows, 3, true);
+            winners.sort();
+            assert_eq!(winners.len(), 3);
+            assert_eq!(winners[0], 0);
+            assert!(winners[1] >= 1 && winners[2] <= 3 && winners[1] != winners[2]);
+            seen.insert(winners);
+        }
+        assert_eq!(seen.len(), 3);
+    }
+}
diff --git a/src/transfer.rs b/src/transfer.rs
new file mode 100644
index 0000000..f4e16aa
--- /dev/null
+++ b/src/transfer.rs
@@ -0,0 +1,343 @@
+//! Portable quiz contents, deliberately separate from database IDs and runtime data.
+use crate::{AppResult, QuestionInput, get_questions, get_quiz, insert_question};
+use rusqlite::Connection;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Serialize, Deserialize)]
+pub(crate) struct QuizContents {
+    pub title: String,
+    #[serde(
+        default = "default_winners",
+        skip_serializing_if = "is_default_winners"
+    )]
+    pub number_of_winners: i64,
+    pub questions: Vec<QuestionInput>,
+}
+
+fn default_winners() -> i64 {
+    3
+}
+fn is_default_winners(n: &i64) -> bool {
+    *n == 3
+}
+
+impl QuizContents {
+    pub fn parse(json: &str) -> Result<Self, Vec<String>> {
+        // Serde's derived structs also accept positional arrays. The portable
+        // JSON format requires objects at every level, not tuple-shaped data.
+        let value: serde_json::Value = serde_json::from_str(json)
+            .map_err(|error| vec![format!("Invalid quiz JSON: {error}")])?;
+        if !value.is_object() {
+            return Err(vec!["Invalid quiz JSON: expected a quiz object".into()]);
+        }
+        if let Some(questions) = value.get("questions").and_then(serde_json::Value::as_array) {
+            for (index, question) in questions.iter().enumerate() {
+                if !question.is_object() {
+                    return Err(vec![format!(
+                        "Invalid quiz JSON: question {} must be an object",
+                        index + 1
+                    )]);
+                }
+                if let Some(options) = question
+                    .get("options")
+                    .and_then(serde_json::Value::as_array)
+                    && options.iter().any(|option| !option.is_object())
+                {
+                    return Err(vec![format!(
+                        "Invalid quiz JSON: options in question {} must be objects",
+                        index + 1
+                    )]);
+                }
+            }
+        }
+        // Deserialize the original JSON to retain line/column diagnostics and
+        // reject duplicate known fields as well as missing fields/wrong types.
+        let contents: Self = serde_json::from_str(json)
+            .map_err(|error| vec![format!("Invalid quiz JSON: {error}")])?;
+        let mut errors = Vec::new();
+        if contents.title.trim().is_empty() {
+            errors.push("Title is required".to_owned());
+        }
+        if contents.number_of_winners < 1 {
+            errors.push("Number of winners must be a whole number of at least 1".into());
+        }
+        for (index, question) in contents.questions.iter().enumerate() {
+            for error in question.errors() {
+                errors.push(format!("Question {}: {error}", index + 1));
+            }
+        }
+        if errors.is_empty() {
+            Ok(contents)
+        } else {
+            Err(errors)
+        }
+    }
+
+    pub fn load(db: &Connection, id: i64) -> AppResult<Self> {
+        let quiz = get_quiz(db, id)?;
+        Ok(Self {
+            title: quiz.title,
+            number_of_winners: quiz.number_of_winners,
+            questions: get_questions(db, id)?
+                .into_iter()
+                .map(QuestionInput::from)
+                .collect(),
+        })
+    }
+
+    // Only called after validation; every insert belongs to the same transaction.
+    // No lookup by title: even identical contents must create an independent quiz.
+    pub fn insert(&self, db: &mut Connection) -> rusqlite::Result<i64> {
+        let tx = db.transaction()?;
+        tx.execute(
+            "INSERT INTO quizzes(title, number_of_winners) VALUES (?,?)",
+            rusqlite::params![self.title.trim(), self.number_of_winners],
+        )?;
+        let id = tx.last_insert_rowid();
+        for question in &self.questions {
+            insert_question(&tx, id, question)?;
+        }
+        tx.commit()?;
+        Ok(id)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::initialize_db;
+    use serde_json::{Value, json};
+
+    fn fixture() -> Value {
+        json!({
+            "title": "Conference 🎤",
+            "questions": [
+                {"text": "First?", "options": [{"text": "A"}, {"text": "B", "correct": true}]},
+                {"text": "Second?", "active": false, "options": [{"text": "C", "correct": true}, {"text": "D", "correct": true}]}
+            ]
+        })
+    }
+
+    #[test]
+    fn timer_is_local_only_and_does_not_change_the_portable_format() {
+        let mut db = Connection::open_in_memory().unwrap();
+        initialize_db(&db).unwrap();
+        let contents = QuizContents::parse(&fixture().to_string()).unwrap();
+        let id = contents.insert(&mut db).unwrap();
+        let before = serde_json::to_value(QuizContents::load(&db, id).unwrap()).unwrap();
+        db.execute("UPDATE quizzes SET timer_seconds=90 WHERE id=?", [id])
+            .unwrap();
+        let after = serde_json::to_value(QuizContents::load(&db, id).unwrap()).unwrap();
+        assert_eq!(before, after);
+        let copy = QuizContents::parse(&after.to_string())
+            .unwrap()
+            .insert(&mut db)
+            .unwrap();
+        assert_eq!(get_quiz(&db, copy).unwrap().timer_seconds, 0);
+        // Unknown local settings in hand-written JSON are not imported either.
+        let mut with_local_fields = after;
+        with_local_fields["timer_minutes"] = json!(2);
+        with_local_fields["timer_seconds"] = json!(30);
+        let copy = QuizContents::parse(&with_local_fields.to_string())
+            .unwrap()
+            .insert(&mut db)
+            .unwrap();
+        assert_eq!(get_quiz(&db, copy).unwrap().timer_seconds, 0);
+    }
+
+    #[test]
+    fn prize_setting_is_optional_validated_and_round_trips() {
+        let mut value = fixture();
+        assert_eq!(
+            QuizContents::parse(&value.to_string())
+                .unwrap()
+                .number_of_winners,
+            3
+        );
+        for invalid in [json!(0), json!(-1), json!(1.5), json!("2"), json!(null)] {
+            value["number_of_winners"] = invalid;
+            assert!(QuizContents::parse(&value.to_string()).is_err());
+        }
+        value["number_of_winners"] = json!(7);
+        let contents = QuizContents::parse(&value.to_string()).unwrap();
+        let mut db = database();
+        let id = contents.insert(&mut db).unwrap();
+        let exported = serde_json::to_value(QuizContents::load(&db, id).unwrap()).unwrap();
+        assert_eq!(exported["number_of_winners"], 7);
+    }
+
+    fn database() -> Connection {
+        let db = Connection::open_in_memory().unwrap();
+        initialize_db(&db).unwrap();
+        db
+    }
+
+    fn counts(db: &Connection) -> Vec<i64> {
+        ["quizzes", "questions", "options"]
+            .iter()
+            .map(|table| {
+                db.query_row(&format!("SELECT COUNT(*) FROM {table}"), [], |row| {
+                    row.get(0)
+                })
+                .unwrap()
+            })
+            .collect()
+    }
+
+    #[test]
+    fn round_trip_is_contents_only_in_display_order_with_new_ids() {
+        let mut db = database();
+        let mut input = fixture();
+        input["id"] = json!(99999);
+        input["participants"] = json!([{"name": "Not portable"}]);
+        input["questions"][0]["id"] = json!(88888);
+        input["questions"][0]["position"] = json!(99);
+        input["questions"][0]["options"][0]["id"] = json!(77777);
+        let contents = QuizContents::parse(&input.to_string()).unwrap();
+        assert!(contents.questions[0].active);
+        assert!(!contents.questions[0].options[0].correct);
+        let first = contents.insert(&mut db).unwrap();
+        let second = contents.insert(&mut db).unwrap();
+        assert_ne!(first, second);
+        let first_questions = get_questions(&db, first).unwrap();
+        let second_questions = get_questions(&db, second).unwrap();
+        assert_ne!(first_questions[0].id, second_questions[0].id);
+        assert_eq!(counts(&db), [2, 4, 8]);
+        let mut expected = fixture();
+        expected["questions"][0]["active"] = json!(true);
+        expected["questions"][0]["options"][0]["correct"] = json!(false);
+        assert_eq!(
+            serde_json::to_value(QuizContents::load(&db, first).unwrap()).unwrap(),
+            expected
+        );
+        db.execute(
+            "UPDATE questions SET position=-1 WHERE id=?",
+            [first_questions[1].id],
+        )
+        .unwrap();
+        let mut reordered = expected.clone();
+        reordered["questions"].as_array_mut().unwrap().swap(0, 1);
+        assert_eq!(
+            serde_json::to_value(QuizContents::load(&db, first).unwrap()).unwrap(),
+            reordered
+        );
+        assert_eq!(
+            serde_json::to_value(QuizContents::load(&db, second).unwrap()).unwrap(),
+            expected
+        );
+        let third = QuizContents::parse(&reordered.to_string())
+            .unwrap()
+            .insert(&mut db)
+            .unwrap();
+        assert_eq!(
+            serde_json::to_value(QuizContents::load(&db, third).unwrap()).unwrap(),
+            reordered
+        );
+    }
+
+    #[test]
+    fn question_form_validation_and_normalization_are_shared() {
+        let mut value = fixture();
+        value["title"] = json!("  Trimmed title \n");
+        value["questions"][0]["text"] = json!("  Trimmed question  ");
+        value["questions"][0]["options"] = json!([
+            {"text": "  Alpha "}, {"text": " \n\t", "correct": true}, {"text": " Beta ", "correct": true}
+        ]);
+        let parsed = QuizContents::parse(&value.to_string()).unwrap();
+        let mut db = database();
+        let id = parsed.insert(&mut db).unwrap();
+        let saved = QuizContents::load(&db, id).unwrap();
+        assert_eq!(saved.title, "Trimmed title");
+        assert_eq!(saved.questions[0].text, "Trimmed question");
+        assert_eq!(saved.questions[0].options.len(), 2);
+        assert_eq!(saved.questions[0].options[0].text, "Alpha");
+        assert_eq!(saved.questions[0].options[1].text, "Beta");
+        value["questions"][0]["options"][2]["correct"] = json!(false);
+        assert_eq!(
+            QuizContents::parse(&value.to_string()).unwrap_err(),
+            ["Question 1: Mark at least one option as correct"]
+        );
+        value["questions"][1]["text"] = json!("  ");
+        value["questions"][1]["options"] = json!([]);
+        let errors = QuizContents::parse(&value.to_string()).unwrap_err();
+        assert!(errors.contains(&"Question 2: Question is required".into()));
+        assert!(errors.contains(&"Question 2: Add at least two options".into()));
+    }
+
+    #[test]
+    fn malformed_shapes_and_wrong_types_are_rejected() {
+        for value in [
+            json!(null),
+            json!([]),
+            json!({}),
+            json!(["Title", []]),
+            json!({"title": "Title"}),
+            json!({"title": false, "questions": []}),
+            json!({"title": "Title", "questions": null}),
+            json!({"title": "Title", "questions": [["Q", true, [{"text": "A", "correct": true}, {"text": "B"}]]]}),
+            json!({"title": "Title", "questions": [{"text": "Q", "options": [["A", true], ["B", false]]}]}),
+        ] {
+            assert!(
+                QuizContents::parse(&value.to_string()).is_err(),
+                "Accepted {value}"
+            );
+        }
+        for value in [
+            json!(null),
+            json!(0),
+            json!(1),
+            json!("true"),
+            json!("false"),
+            json!([]),
+            json!({}),
+        ] {
+            let mut data = fixture();
+            data["questions"][0]["active"] = value.clone();
+            assert!(QuizContents::parse(&data.to_string()).is_err());
+            data = fixture();
+            data["questions"][0]["options"][0]["correct"] = value;
+            assert!(QuizContents::parse(&data.to_string()).is_err());
+        }
+        for raw in [
+            "",
+            "{",
+            "{} trailing",
+            "{\"title\":\"T\",\"questions\":[],}",
+            "{\"title\":\"T\",\"title\":\"Duplicate\",\"questions\":[]}",
+        ] {
+            assert!(QuizContents::parse(raw).is_err());
+        }
+    }
+
+    #[test]
+    fn database_failure_rolls_back_quiz_questions_and_options() {
+        let mut db = database();
+        let contents = QuizContents::parse(&fixture().to_string()).unwrap();
+        let original = contents.insert(&mut db).unwrap();
+        let before = counts(&db);
+        let exported = serde_json::to_value(QuizContents::load(&db, original).unwrap()).unwrap();
+        // Fail on the last option, after the new quiz and earlier questions/options exist.
+        db.execute_batch("CREATE TRIGGER simulate_failure BEFORE INSERT ON options WHEN NEW.text='D' BEGIN SELECT RAISE(ABORT, 'Simulated failure'); END;").unwrap();
+        assert!(contents.insert(&mut db).is_err());
+        assert_eq!(counts(&db), before);
+        assert_eq!(
+            serde_json::to_value(QuizContents::load(&db, original).unwrap()).unwrap(),
+            exported
+        );
+    }
+
+    #[test]
+    fn empty_quiz_is_valid_but_blank_title_is_not() {
+        let contents = QuizContents::parse(r#"{"title":"Empty","questions":[]}"#).unwrap();
+        let mut db = database();
+        let id = contents.insert(&mut db).unwrap();
+        assert_eq!(
+            serde_json::to_value(QuizContents::load(&db, id).unwrap()).unwrap(),
+            json!({"title":"Empty","questions":[]})
+        );
+        assert_eq!(
+            QuizContents::parse(r#"{"title":" \t\n","questions":[]}"#).unwrap_err(),
+            ["Title is required"]
+        );
+    }
+}
diff --git a/src/views.rs b/src/views.rs
new file mode 100644
index 0000000..937681a
--- /dev/null
+++ b/src/views.rs
@@ -0,0 +1,356 @@
+use crate::{App, Question, QuestionInput, Quiz, question_url, quiz_url};
+use std::fmt::Write;
+
+pub fn escape(value: &str) -> String {
+    value
+        .replace('&', "&amp;")
+        .replace('<', "&lt;")
+        .replace('>', "&gt;")
+        .replace('"', "&quot;")
+        .replace('\'', "&#39;")
+}
+pub(crate) fn document(title: &str, body: &str) -> String {
+    format!(
+        r#"<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>{} · Quizzy</title><link rel="icon" href="data:,">
+<link rel="stylesheet" href="/assets/quizzy.css"><link rel="stylesheet" href="/assets/app.css">
+<script src="/assets/app.js" defer></script></head><body>{body}</body></html>"#,
+        escape(title)
+    )
+}
+pub(crate) fn layout(title: &str, body: &str) -> String {
+    document(
+        title,
+        &format!(
+            r##"<a class="skip-link" href="#main">Skip to content</a>
+<header class="admin-header"><a href="/moderate" class="logo admin-header__logo"><span class="logo__mark">?</span>Quizzy</a><span class="admin-header__tag">Moderator</span></header>
