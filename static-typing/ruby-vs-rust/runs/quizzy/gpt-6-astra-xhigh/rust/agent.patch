+/* Small additions to the supplied Quizzy design, whose tokens stay unchanged. */
+.list-reset { list-style: none; padding: 0; margin: 0; }
+.field-label { font-size: 15px; font-weight: 600; }
+.field .active-label { font-size: 18px; font-weight: 500; }
+.add-option { margin-bottom: 28px; }
+.question-item__content { min-width: 0; }
