+fn errors(messages: &[&str]) -> String {
+    if messages.is_empty() {
+        return String::new();
+    }
+    let mut html = String::from(r#"<div class="errors" role="alert"><ul>"#);
+    for message in messages {
+        let _ = write!(html, "<li>{}</li>", escape(message));
