+    )
+}
+fn letter(index: usize) -> String {
+    // A…Z, AA…AZ… so extra rows never run out of labels.
+    let mut n = index + 1;
+    let mut chars = Vec::new();
+    while n > 0 {
+        n -= 1;
+        chars.push((b'A' + (n % 26) as u8) as char);
+        n /= 26;
+    }
+    chars.into_iter().rev().collect()
+}
