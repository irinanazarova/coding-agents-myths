+.question-item__options li { max-width: 100%; }
+.quiz-list .card { margin-bottom: 0; }
+.quiz-tile h3 a { text-decoration: none; }
+.quiz-tile h3 a:hover { text-decoration: underline; }
+.danger-zone h2 { font-size: 28px; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
+:focus-visible { outline: 3px solid var(--c-pink); outline-offset: 4px; }
+.skip-link { position: absolute; top: -100px; left: 16px; z-index: 5; padding: 12px 20px; background: white; border-radius: 100px; }
+.skip-link:focus { top: 12px; }
+.preview-play { min-height: calc(100dvh - 42px); }
+.preview-play .play__body { width: 100%; }
+.preview-actions { margin-top: 24px; }
+.preview-restart { margin-top: 24px; }
+.preview-note { margin-top: 20px; font-size: 14px; }
+.result-card { padding: 40px 0; }
+.result-card .logo__mark { margin: 0 auto 24px; width: 88px; height: 88px; font-size: 52px; font-weight: 900; }
+.result-card h1 { font-size: 46px; }
+.result-card__score { margin: 24px 0; }
+.result-card .buttons { justify-content: center; }
+.play-option:disabled { cursor: default; }
