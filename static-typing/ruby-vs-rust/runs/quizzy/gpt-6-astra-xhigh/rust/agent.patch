+#!/usr/bin/env python3
+"""Chromium end-to-end checks using the DevTools protocol (no downloaded test tools).
+Start bin/serve first, then run python3 tests/browser.py.
+Screenshots and the temporary browser profile are kept under storage/.
+"""
+import base64
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import struct
+import subprocess
+import time
+import urllib.request
+from urllib.parse import urlparse
+from smoke import AUTH, BASE, csrf, post, request
+
+ROOT = Path(__file__).resolve().parents[1]
+ARTIFACTS = ROOT / 'storage' / 'browser-tests'
+ARTIFACTS.mkdir(parents=True, exist_ok=True)
+
+class DevTools:
+    def __init__(self, url):
+        parsed = urlparse(url)
+        self.socket = socket.create_connection((parsed.hostname, parsed.port), 10)
+        self.socket.settimeout(10)
+        key = base64.b64encode(os.urandom(16)).decode()
+        self.socket.sendall(f'GET {parsed.path} HTTP/1.1\r\nHost: {parsed.netloc}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n'.encode())
+        response = b''
+        while not response.endswith(b'\r\n\r\n'):
+            response += self.socket.recv(1)
+        assert response.startswith(b'HTTP/1.1 101 '), response
+        self.seq = 0
+        self.results = {}
+        self.events = []
+        self.dialogs = []
+        self.accept_dialog = False
+
+    def send(self, method, params=None):
+        self.seq += 1
+        data = json.dumps({'id': self.seq, 'method': method, 'params': params or {}}).encode()
+        mask = os.urandom(4)
+        n = len(data)
+        header = bytes([0x81, 0x80 | n]) if n < 126 else bytes([0x81, 0x80 | 126]) + struct.pack('!H', n) if n < 65536 else bytes([0x81, 0x80 | 127]) + struct.pack('!Q', n)
+        self.socket.sendall(header + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))
+        return self.seq
+
+    def read(self, size):
+        data = b''
+        while len(data) < size:
+            piece = self.socket.recv(size - len(data))
+            if not piece: raise EOFError('Chromium disconnected')
+            data += piece
+        return data
+
+    def receive(self):
+        chunks = []
+        while True:
+            first, second = self.read(2)
+            n = second & 127
+            if n == 126: n = struct.unpack('!H', self.read(2))[0]
+            elif n == 127: n = struct.unpack('!Q', self.read(8))[0]
+            mask = self.read(4) if second & 128 else None
+            payload = self.read(n)
+            if mask: payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
+            if first & 15 == 8: raise EOFError('Websocket closed')
+            chunks.append(payload)
+            if first & 128: break
+        return json.loads(b''.join(chunks))
+
+    def call(self, method, params=None):
+        seq = self.send(method, params)
+        while seq not in self.results:
+            msg = self.receive()
+            if 'id' in msg:
+                self.results[msg['id']] = msg
+            else:
+                self.events.append(msg)
+                if msg.get('method') == 'Page.javascriptDialogOpening':
+                    self.dialogs.append(msg['params'])
+                    self.send('Page.handleJavaScriptDialog', {'accept': self.accept_dialog})
+        msg = self.results.pop(seq)
+        if 'error' in msg: raise RuntimeError(msg['error'])
+        return msg.get('result', {})
+
+    def evaluate(self, expression):
+        result = self.call('Runtime.evaluate', {'expression': expression, 'returnByValue': True, 'awaitPromise': True})
+        if 'exceptionDetails' in result: raise RuntimeError(result['exceptionDetails'])
+        return result.get('result', {}).get('value')
+
+    def wait(self, expression, timeout=10):
+        deadline = time.time() + timeout
+        last = None
+        while time.time() < deadline:
+            try:
+                last = self.evaluate(f"Boolean({expression})")
+                if last: return last
+            except RuntimeError:
+                pass
+            time.sleep(.05)
+        raise AssertionError(f'Timed out: {expression}; last={last}')
+
+    def navigate(self, path):
+        url = path if path.startswith(('http', 'file:')) else BASE + path
+        self.call('Page.navigate', {'url': url})
+        self.wait(f'location.href === {json.dumps(url)} && document.readyState === "complete"')
+
+    def click_expression(self, expression):
+        before = self.evaluate('performance.timeOrigin')
+        navigates = self.evaluate(f'(() => {{ const e = {expression}; if (!e) return false; return e.tagName === "A" || (e.form && e.form.checkValidity() && (e.type === "submit" || e.form.classList.contains("active-form")) && (!e.form.dataset.confirm || {json.dumps(self.accept_dialog)})); }})()')
+        position = self.evaluate(f'(() => {{ const e = {expression}; if (!e) throw Error("Missing element"); e.scrollIntoView({{block:"center"}}); const r = e.getBoundingClientRect(); return {{x:r.x+r.width/2,y:r.y+r.height/2}}; }})()')
+        self.call('Input.dispatchMouseEvent', dict(position, type='mousePressed', button='left', clickCount=1))
+        self.call('Input.dispatchMouseEvent', dict(position, type='mouseReleased', button='left', clickCount=1))
+        if navigates:
+            self.wait(f'performance.timeOrigin !== {before} && document.readyState === "complete"')
+
+    def click(self, label, scope='document'):
+        self.click_expression(f'[...{scope}.querySelectorAll("a,button")].find(e => (e.getAttribute("aria-label") || (() => {{const copy=e.cloneNode(true); copy.querySelectorAll("[aria-hidden=true]").forEach(n=>n.remove()); return copy.textContent;}})()).replace(/\\s+/g," ").trim() === {json.dumps(label)})')
+
+    def fill(self, label, text):
+        self.evaluate(f'(() => {{const e = document.querySelector("[aria-label=" + CSS.escape({json.dumps(label)}) + "]") || document.getElementById({json.dumps(label.lower())}); if(!e) throw Error("Missing field"); e.value={json.dumps(text)}; e.dispatchEvent(new Event("input",{{bubbles:true}}));}})()')
+
+    def checkbox(self, label, checked):
+        self.evaluate(f'(() => {{const e = [...document.querySelectorAll("input[type=checkbox]")].find(e => (e.getAttribute("aria-label") || e.closest("label").textContent.trim()) === {json.dumps(label)}); if(!e) throw Error("Missing checkbox"); if(e.checked !== {json.dumps(checked)}) e.click(); }})()')
+
+    def screenshot(self, name):
+        self.evaluate('document.fonts.ready.then(() => true)')
+        data = self.call('Page.captureScreenshot', {'captureBeyondViewport': True})['data']
+        (ARTIFACTS / name).write_bytes(base64.b64decode(data))
+
+
+def run():
+    profile = ARTIFACTS / 'profile'
+    shutil.rmtree(profile, ignore_errors=True)
+    with open(ARTIFACTS / 'chromium.log', 'w') as log:
+        browser = subprocess.Popen(['chromium', '--headless=new', '--no-sandbox', '--disable-dev-shm-usage', '--disable-background-networking', '--disable-component-update', '--disable-sync', '--no-first-run', '--no-default-browser-check', '--remote-debugging-port=9222', f'--user-data-dir={profile}', 'about:blank'], stdout=log, stderr=log)
+    client = None
+    quiz = None
+    token = csrf('/moderate/quizzes/new')
+    try:
+        for _ in range(100):
+            try:
+                tabs = json.load(urllib.request.urlopen('http://127.0.0.1:9222/json/list', timeout=1))
