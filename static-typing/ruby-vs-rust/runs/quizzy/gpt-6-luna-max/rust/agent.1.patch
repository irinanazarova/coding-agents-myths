+async fn move_question(
+    State(state): State<AppState>,
+    Path((quiz_id, question_id)): Path<(i64, i64)>,
+    Form(form): Form<MoveForm>,
+) -> Response {
+    if !csrf_valid(&state, &form.csrf) {
+        return csrf_error();
+    }
+    if form.direction != "up" && form.direction != "down" {
+        return bad_request();
+    }
+    let result = (|| -> rusqlite::Result<bool> {
+        let mut connection = open_database(&state.db_path)?;
+        let transaction = connection.transaction()?;
+        let mut statement = transaction
+            .prepare("SELECT id FROM questions WHERE quiz_id = ?1 ORDER BY position, id")?;
+        let mut ids = statement
+            .query_map([quiz_id], |row| row.get::<_, i64>(0))?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        drop(statement);
+        let Some(index) = ids.iter().position(|&id| id == question_id) else {
+            return Ok(false);
+        };
+        let neighbor = if form.direction == "up" {
+            index.checked_sub(1)
+        } else if index + 1 < ids.len() {
+            Some(index + 1)
+        } else {
+            None
+        };
+        if let Some(neighbor) = neighbor {
+            ids.swap(index, neighbor);
+            for (position, id) in ids.iter().enumerate() {
+                transaction.execute(
+                    "UPDATE questions SET position = ?1 WHERE id = ?2 AND quiz_id = ?3",
+                    params![position as i64, id, quiz_id],
+                )?;
+            }
+        }
+        transaction.commit()?;
+        Ok(true)
+    })();
+    match result {
+        Ok(true) => Redirect::to(&format!("/moderate/quizzes/{quiz_id}")).into_response(),
+        Ok(false) => not_found(),
+        Err(error) => internal_error(error),
+    }
+}
