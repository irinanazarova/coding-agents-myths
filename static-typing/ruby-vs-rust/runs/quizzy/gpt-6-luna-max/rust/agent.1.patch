@@ -1 +1,1368 @@
-fn main() {}
+use axum::Router;
+use axum::body::{Body, Bytes};
+use axum::extract::{Form, Path, Request, State};
+use axum::http::header::{self, AUTHORIZATION, WWW_AUTHENTICATE};
+use axum::http::{HeaderValue, StatusCode};
+use axum::middleware::{self, Next};
+use axum::response::{Html, IntoResponse, Redirect, Response};
+use axum::routing::{get, post};
+use base64::Engine;
+use base64::engine::general_purpose::STANDARD as BASE64;
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::env;
+use std::fmt::Display;
+use std::fs;
+use std::path::{Path as FsPath, PathBuf};
+use std::time::Duration;
+use tokio::net::TcpListener;
+
+const DESIGN_CSS: &str = include_str!("../docs/mockups/quizzy.css");
+const APP_CSS: &str = include_str!("../assets/app.css");
+const FONT: &[u8] = include_bytes!("../docs/mockups/Inter-latin.woff2");
+
+#[derive(Clone)]
+struct AppState {
+    db_path: PathBuf,
+    username: String,
+    password: String,
+    csrf_token: String,
+}
+
+#[derive(Debug, Clone)]
+struct QuizSummary {
+    id: i64,
+    title: String,
+    total: i64,
+    active: i64,
+}
+
+#[derive(Debug, Clone)]
+struct Quiz {
+    id: i64,
+    title: String,
+    questions: Vec<Question>,
+}
+
+#[derive(Debug, Clone)]
+struct Question {
+    id: i64,
+    body: String,
+    active: bool,
+    options: Vec<OptionItem>,
+}
+
+#[derive(Debug, Clone)]
+struct OptionItem {
+    body: String,
+    correct: bool,
+}
+
+#[derive(Serialize)]
+struct PreviewQuestion {
+    body: String,
+    options: Vec<PreviewOption>,
+}
+
+#[derive(Serialize)]
+struct PreviewOption {
+    body: String,
+    correct: bool,
+}
+
+#[derive(Deserialize)]
+struct QuizForm {
+    #[serde(default)]
+    csrf: String,
+    #[serde(default)]
+    title: String,
+}
+
+#[derive(Deserialize)]
+struct CsrfForm {
+    #[serde(default)]
+    csrf: String,
+}
+
+#[derive(Deserialize)]
+struct QuestionForm {
+    #[serde(default)]
+    csrf: String,
+    #[serde(default)]
+    question: String,
+    #[serde(default)]
+    option_text: Vec<String>,
+    #[serde(default)]
+    correct_index: Vec<usize>,
+    #[serde(default)]
+    active: Option<bool>,
+}
+
+#[derive(Deserialize)]
+struct ActiveForm {
+    #[serde(default)]
+    csrf: String,
+    #[serde(default)]
+    active: Option<bool>,
+}
+
+#[derive(Deserialize)]
+struct MoveForm {
+    #[serde(default)]
+    csrf: String,
+    direction: String,
+}
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let username = required_env("QUIZZY_MODERATOR_USERNAME")?;
+    let password = required_env("QUIZZY_MODERATOR_PASSWORD")?;
+    let secret = required_env("SECRET_KEY_BASE")?;
+    let port = env::var("PORT")
+        .unwrap_or_else(|_| "3000".to_owned())
+        .parse::<u16>()?;
+
+    let storage = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("storage");
+    fs::create_dir_all(&storage)?;
+    let db_path = storage.join("quizzy.sqlite3");
+    initialize_database(&db_path)?;
+
+    // The key is never sent to the browser. Only this keyed, fixed-purpose form token is.
+    let mut digest = Sha256::new();
+    digest.update(secret.as_bytes());
+    digest.update(b"\0quizzy moderator form token v1");
+    let csrf_token = format!("{:x}", digest.finalize());
+
+    let state = AppState {
+        db_path,
+        username,
+        password,
+        csrf_token,
+    };
+
+    // The outer middleware also protects unknown /moderate paths, not only registered pages.
+    let app = Router::new()
+        .route("/up", get(up))
+        .route("/assets/quizzy.css", get(quizzy_css))
+        .route("/assets/app.css", get(app_css))
+        .route("/assets/Inter-latin.woff2", get(font))
+        .route("/moderate", get(list_quizzes))
+        .route("/moderate/", get(list_quizzes))
+        .route("/moderate/quizzes/new", get(new_quiz))
+        .route("/moderate/quizzes", post(create_quiz))
+        .route(
+            "/moderate/quizzes/{quiz_id}",
+            get(show_quiz).post(update_quiz),
+        )
+        .route("/moderate/quizzes/{quiz_id}/settings", get(edit_quiz))
+        .route("/moderate/quizzes/{quiz_id}/delete", post(delete_quiz))
+        .route("/moderate/quizzes/{quiz_id}/preview", get(preview_quiz))
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/new",
+            get(new_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions",
+            post(create_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{question_id}/edit",
+            get(edit_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{question_id}",
+            post(update_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{question_id}/delete",
+            post(delete_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{question_id}/active",
+            post(update_question_active),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{question_id}/move",
+            post(move_question),
+        )
+        .layer(middleware::from_fn_with_state(
+            state.clone(),
+            require_moderator,
+        ))
+        .with_state(state);
+
+    let address = format!("0.0.0.0:{port}");
+    let listener = TcpListener::bind(&address).await?;
+    println!("Quizzy is ready on http://{address}");
+    axum::serve(listener, app).await?;
+    Ok(())
+}
+
+fn required_env(name: &str) -> Result<String, std::io::Error> {
+    env::var(name).map_err(|_| {
+        std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            format!("{name} must be set"),
+        )
+    })
+}
+
+async fn up() -> &'static str {
+    "ok"
+}
+
+async fn quizzy_css() -> impl IntoResponse {
+    (
+        [(header::CONTENT_TYPE, "text/css; charset=utf-8")],
+        DESIGN_CSS,
+    )
+}
+
+async fn app_css() -> impl IntoResponse {
+    ([(header::CONTENT_TYPE, "text/css; charset=utf-8")], APP_CSS)
+}
+
+async fn font() -> Response {
+    Response::builder()
+        .header(header::CONTENT_TYPE, "font/woff2")
+        .header(header::CACHE_CONTROL, "public, max-age=31536000, immutable")
+        .body(Body::from(FONT))
+        .expect("valid font response")
+}
+
+async fn require_moderator(
+    State(state): State<AppState>,
+    request: Request,
+    next: Next,
+) -> Response {
+    let path = request.uri().path();
+    if path != "/moderate" && !path.starts_with("/moderate/") {
+        return next.run(request).await;
+    }
+    let authorized = request
+        .headers()
+        .get(AUTHORIZATION)
+        .and_then(|value| value.to_str().ok())
+        .and_then(parse_basic_credentials)
+        .is_some_and(|(username, password)| {
+            constant_time_equal(username.as_bytes(), state.username.as_bytes())
+                && constant_time_equal(password.as_bytes(), state.password.as_bytes())
+        });
+
+    if authorized {
+        next.run(request).await
+    } else {
+        let mut response = (
+            StatusCode::UNAUTHORIZED,
+            "Moderator authentication required",
+        )
+            .into_response();
+        response.headers_mut().insert(
+            WWW_AUTHENTICATE,
+            HeaderValue::from_static("Basic realm=\"Quizzy Moderator\", charset=\"UTF-8\""),
+        );
+        response
+    }
+}
+
+fn parse_basic_credentials(header: &str) -> Option<(String, String)> {
+    let mut parts = header.split_whitespace();
+    if !parts.next()?.eq_ignore_ascii_case("Basic") {
+        return None;
+    }
+    let encoded = parts.next()?;
+    if parts.next().is_some() {
+        return None;
+    }
+    let decoded = BASE64.decode(encoded).ok()?;
+    let credentials = String::from_utf8(decoded).ok()?;
+    let (username, password) = credentials.split_once(':')?;
+    Some((username.to_owned(), password.to_owned()))
+}
+
+fn constant_time_equal(left: &[u8], right: &[u8]) -> bool {
+    if left.len() != right.len() {
+        return false;
+    }
+    left.iter()
+        .zip(right)
+        .fold(0_u8, |difference, (a, b)| difference | (a ^ b))
+        == 0
+}
+
+fn open_database(path: &FsPath) -> rusqlite::Result<Connection> {
+    let connection = Connection::open(path)?;
+    connection.busy_timeout(Duration::from_secs(5))?;
+    connection.pragma_update(None, "foreign_keys", "ON")?;
+    Ok(connection)
+}
+
+fn initialize_database(path: &FsPath) -> rusqlite::Result<()> {
+    let connection = open_database(path)?;
+    connection.execute_batch(
+        "PRAGMA journal_mode = WAL;
+         CREATE TABLE IF NOT EXISTS quizzes (
+             id INTEGER PRIMARY KEY AUTOINCREMENT,
+             title TEXT NOT NULL,
+             created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
+         );
+         CREATE TABLE IF NOT EXISTS questions (
+             id INTEGER PRIMARY KEY AUTOINCREMENT,
+             quiz_id INTEGER NOT NULL REFERENCES quizzes(id) ON DELETE CASCADE,
+             body TEXT NOT NULL,
+             active INTEGER NOT NULL DEFAULT 1,
+             position INTEGER NOT NULL
+         );
+         CREATE INDEX IF NOT EXISTS questions_quiz_position
+             ON questions(quiz_id, position, id);
+         CREATE TABLE IF NOT EXISTS options (
+             id INTEGER PRIMARY KEY AUTOINCREMENT,
+             question_id INTEGER NOT NULL REFERENCES questions(id) ON DELETE CASCADE,
+             body TEXT NOT NULL,
+             is_correct INTEGER NOT NULL DEFAULT 0,
+             position INTEGER NOT NULL
+         );
+         CREATE INDEX IF NOT EXISTS options_question_position
+             ON options(question_id, position, id);",
+    )?;
+    Ok(())
+}
+
+fn load_quiz_summaries(path: &FsPath) -> rusqlite::Result<Vec<QuizSummary>> {
+    let connection = open_database(path)?;
+    let mut statement = connection.prepare(
+        "SELECT q.id, q.title, COUNT(question.id),
+                COALESCE(SUM(CASE WHEN question.active = 1 THEN 1 ELSE 0 END), 0)
+         FROM quizzes q LEFT JOIN questions question ON question.quiz_id = q.id
+         GROUP BY q.id, q.title ORDER BY q.created_at DESC, q.id DESC",
+    )?;
+    statement
+        .query_map([], |row| {
+            Ok(QuizSummary {
+                id: row.get(0)?,
+                title: row.get(1)?,
+                total: row.get(2)?,
+                active: row.get(3)?,
+            })
+        })?
+        .collect()
+}
+
+fn load_quiz(path: &FsPath, quiz_id: i64) -> rusqlite::Result<Option<Quiz>> {
+    let connection = open_database(path)?;
+    let quiz = connection
+        .query_row(
+            "SELECT id, title FROM quizzes WHERE id = ?1",
+            [quiz_id],
+            |row| {
+                Ok(Quiz {
+                    id: row.get(0)?,
+                    title: row.get(1)?,
+                    questions: Vec::new(),
+                })
+            },
+        )
+        .optional()?;
+    let Some(mut quiz) = quiz else {
+        return Ok(None);
+    };
+
+    let mut statement = connection.prepare(
+        "SELECT id, body, active, position FROM questions
+         WHERE quiz_id = ?1 ORDER BY position, id",
+    )?;
+    let questions = statement
+        .query_map([quiz_id], |row| {
+            Ok(Question {
+                id: row.get(0)?,
+                body: row.get(1)?,
+                active: row.get::<_, i64>(2)? != 0,
+                options: Vec::new(),
+            })
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    drop(statement);
+
+    for mut question in questions {
+        let mut option_statement = connection.prepare(
+            "SELECT body, is_correct FROM options
+             WHERE question_id = ?1 ORDER BY position, id",
+        )?;
+        question.options = option_statement
+            .query_map([question.id], |row| {
+                Ok(OptionItem {
+                    body: row.get(0)?,
+                    correct: row.get::<_, i64>(1)? != 0,
+                })
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        quiz.questions.push(question);
+    }
+    Ok(Some(quiz))
+}
+
+async fn list_quizzes(State(state): State<AppState>) -> Response {
+    match load_quiz_summaries(&state.db_path) {
+        Ok(quizzes) => Html(render_quiz_list(&state, &quizzes)).into_response(),
+        Err(error) => internal_error(error),
+    }
+}
+
+async fn new_quiz(State(state): State<AppState>) -> Response {
+    Html(render_quiz_form(&state, None, "", &[])).into_response()
+}
+
+async fn create_quiz(State(state): State<AppState>, Form(form): Form<QuizForm>) -> Response {
+    if !csrf_valid(&state, &form.csrf) {
+        return csrf_error();
+    }
+    let title = form.title.trim();
+    if title.is_empty() {
+        return Html(render_quiz_form(
+            &state,
+            None,
+            &form.title,
+            &["Title is required".to_owned()],
+        ))
+        .into_response();
+    }
+
+    let result = (|| -> rusqlite::Result<i64> {
+        let connection = open_database(&state.db_path)?;
+        connection.execute("INSERT INTO quizzes(title) VALUES (?1)", [title])?;
+        Ok(connection.last_insert_rowid())
+    })();
+    match result {
+        Ok(id) => Redirect::to(&format!("/moderate/quizzes/{id}")).into_response(),
+        Err(error) => internal_error(error),
+    }
+}
+
+async fn show_quiz(State(state): State<AppState>, Path(quiz_id): Path<i64>) -> Response {
+    match load_quiz(&state.db_path, quiz_id) {
+        Ok(Some(quiz)) => Html(render_quiz_page(&state, &quiz)).into_response(),
+        Ok(None) => not_found(),
+        Err(error) => internal_error(error),
+    }
+}
+
+async fn edit_quiz(State(state): State<AppState>, Path(quiz_id): Path<i64>) -> Response {
+    match load_quiz(&state.db_path, quiz_id) {
+        Ok(Some(quiz)) => {
+            Html(render_quiz_form(&state, Some(quiz.id), &quiz.title, &[])).into_response()
+        }
+        Ok(None) => not_found(),
+        Err(error) => internal_error(error),
+    }
+}
+
+async fn update_quiz(
+    State(state): State<AppState>,
+    Path(quiz_id): Path<i64>,
+    Form(form): Form<QuizForm>,
+) -> Response {
+    if !csrf_valid(&state, &form.csrf) {
+        return csrf_error();
+    }
+    let Ok(Some(_)) = load_quiz(&state.db_path, quiz_id) else {
+        return not_found();
+    };
+    let title = form.title.trim();
+    if title.is_empty() {
+        return Html(render_quiz_form(
+            &state,
+            Some(quiz_id),
+            &form.title,
+            &["Title is required".to_owned()],
+        ))
+        .into_response();
+    }
+    match open_database(&state.db_path).and_then(|connection| {
+        connection.execute(
