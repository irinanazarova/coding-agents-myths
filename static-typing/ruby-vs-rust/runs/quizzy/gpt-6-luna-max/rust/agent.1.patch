+++ b/assets/app.css
@@ -0,0 +1,54 @@
+/* Small application-specific additions on top of the supplied Quizzy design. */
+.quiz-list {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+}
+.quiz-list__item { margin: 0; }
+.quiz-list__item > a { display: block; text-decoration: none; }
+.quiz-list__item h3 { overflow-wrap: anywhere; }
+.question-list {
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  padding: 0;
+  margin: 0;
+}
+.question-list > li.card { margin: 0; }
+.question-item__actions form { margin: 0; }
+.active-toggle { display: flex; justify-content: flex-end; }
+.option-row { grid-template-columns: minmax(0, 1fr) minmax(220px, auto); }
+.option-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
+.option-field label { font-weight: 600; font-size: 15px; }
+.option-row .checkbox { font-size: 15px; }
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+.quiz-settings-actions { margin-top: 28px; }
+.preview-banner { position: relative; z-index: 1; }
+.play__body--top { justify-content: flex-start; }
+.play-question__num { margin-bottom: 12px; }
+.preview-feedback { min-height: 1px; }
+.preview-advance { margin-top: 20px; }
+.preview-score { text-align: center; }
+.preview-score h1 { overflow-wrap: anywhere; }
+button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible {
+  outline: 3px solid var(--c-pink);
+  outline-offset: 3px;
+}
+@media (max-width: 760px) {
+  .question-item { grid-template-columns: auto 1fr; gap: 12px; }
+  .question-item__actions { grid-column: 1 / -1; align-items: flex-start; }
+  .question-item__actions .buttons { justify-content: flex-start; }
+  .option-row { grid-template-columns: 1fr; gap: 8px; }
+  .option-row .checkbox { margin: 4px 0 8px; }
+}
