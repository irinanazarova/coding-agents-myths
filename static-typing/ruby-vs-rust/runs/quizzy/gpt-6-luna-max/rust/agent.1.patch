+fn render_question_item(
+    state: &AppState,
+    quiz: &Quiz,
+    question: &Question,
+    index: usize,
+    active_number: usize,
+) -> String {
+    let body = escape_html(&question.body);
+    let inactive_class = if question.active {
+        ""
+    } else {
+        " question-item--inactive"
+    };
+    let displayed_number = if question.active {
+        active_number.to_string()
+    } else {
+        "—".to_owned()
+    };
+    let mut item = format!(
+        "<li class=\"card question-item{inactive_class}\" id=\"question-{}\"><div class=\"question-item__num\">{displayed_number}</div><div><div class=\"question-item__body\">{body}</div><ul class=\"question-item__options\">",
+        question.id
+    );
+    for (option_index, option) in question.options.iter().enumerate() {
+        let correct = if option.correct {
+            " class=\"is-correct\""
+        } else {
+            ""
+        };
+        item.push_str(&format!(
+            "<li{correct}>{}. {}</li>",
+            option_letter(option_index),
+            escape_html(&option.body)
+        ));
+    }
+    item.push_str("</ul></div><div class=\"question-item__actions\"><div class=\"buttons\">");
+    let move_path = format!(
+        "/moderate/quizzes/{}/questions/{}/move",
