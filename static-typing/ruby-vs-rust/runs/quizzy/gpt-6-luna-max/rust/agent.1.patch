+) -> String {
+    let is_editing = existing.is_some();
+    let heading = if is_editing {
+        "Edit question"
+    } else {
+        "New question"
+    };
+    let body_value = submitted
+        .map(|form| form.question.as_str())
+        .or_else(|| existing.map(|question| question.body.as_str()))
+        .unwrap_or("");
+    let active = submitted
+        .map(|form| form.active.unwrap_or(false))
+        .or_else(|| existing.map(|question| question.active))
+        .unwrap_or(true);
+    let option_values: Vec<(String, bool)> = if let Some(form) = submitted {
+        let correct: std::collections::HashSet<usize> =
+            form.correct_index.iter().copied().collect();
+        form.option_text
+            .iter()
+            .enumerate()
+            .map(|(i, value)| (value.clone(), correct.contains(&i)))
+            .collect()
+    } else if let Some(question) = existing {
+        question
+            .options
+            .iter()
+            .map(|option| (option.body.clone(), option.correct))
+            .collect()
+    } else {
+        vec![
+            (String::new(), false),
+            (String::new(), false),
+            (String::new(), false),
+            (String::new(), false),
+        ]
+    };
+    let option_values = if option_values.is_empty() && !is_editing && submitted.is_none() {
+        vec![
+            (String::new(), false),
+            (String::new(), false),
+            (String::new(), false),
+            (String::new(), false),
+        ]
+    } else {
+        option_values
+    };
+    let action = existing
+        .map(|question| format!("/moderate/quizzes/{}/questions/{}", quiz.id, question.id))
+        .unwrap_or_else(|| format!("/moderate/quizzes/{}/questions", quiz.id));
+    let mut content = format!(
+        "<div class=\"breadcrumbs\"><a href=\"/moderate/quizzes/{}\">← {}</a></div><div class=\"page-head\"><h1>{heading}</h1></div><div class=\"card\"><form method=\"post\" action=\"{action}\"><input type=\"hidden\" name=\"csrf\" value=\"{}\"><div class=\"field\"><label for=\"question\">Question</label><textarea class=\"input\" id=\"question\" name=\"question\" rows=\"3\" required>{}</textarea></div><div class=\"field\"><span class=\"field-label\">Options</span><span class=\"field-hint\">Mark the correct options, at least one. Empty rows are skipped.</span></div><div class=\"option-rows\" id=\"option-rows\" data-next-index=\"{}\">",
+        quiz.id,
