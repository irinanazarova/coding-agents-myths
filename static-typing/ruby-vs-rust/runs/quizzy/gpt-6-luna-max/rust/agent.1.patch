+    );
+    for (index, (value, correct)) in option_values.iter().enumerate() {
+        content.push_str(&option_row(index, value, *correct));
+    }
+    content.push_str("</div><div class=\"buttons\" style=\"margin-bottom: 28px\"><button class=\"btn btn--ghost btn--sm\" id=\"add-option\" type=\"button\"><span aria-hidden=\"true\">+</span> Add option</button></div><div class=\"field\"><label class=\"checkbox\"><input type=\"checkbox\" name=\"active\" value=\"true\"");
+    if active {
+        content.push_str(" checked");
+    }
+    content.push_str("><span>Active</span></label><span class=\"field-hint\">Only active questions are played.</span></div>");
+    content.push_str(&render_errors(errors));
+    content.push_str("<div class=\"buttons\"><button class=\"btn btn--pink\" type=\"submit\">Save question</button><a class=\"btn btn--ghost\" href=\"/moderate/quizzes/");
+    content.push_str(&quiz.id.to_string());
+    content.push_str("\">Cancel</a></div></form></div>");
+    content.push_str(option_form_script());
+    page(heading, &content)
+}
+
+fn option_row(index: usize, value: &str, correct: bool) -> String {
+    let number = index + 1;
+    format!(
+        "<div class=\"option-row\"><div class=\"option-field\"><label for=\"option-text-{index}\">Option {number}</label><input class=\"input\" id=\"option-text-{index}\" type=\"text\" name=\"option_text\" value=\"{}\" placeholder=\"Option text\" autocomplete=\"off\"></div><label class=\"checkbox\" for=\"option-correct-{index}\"><input type=\"checkbox\" id=\"option-correct-{index}\" name=\"correct_index\" value=\"{index}\"{}><span>Option {number} is correct</span></label></div>",
+        escape_html(value),
+        if correct { " checked" } else { "" }
+    )
+}
+
+fn option_form_script() -> &'static str {
+    r#"<script>
+(() => {
+  const rows = document.getElementById('option-rows');
+  const addButton = document.getElementById('add-option');
+  if (!rows || !addButton) return;
+  addButton.addEventListener('click', () => {
+    const index = Number(rows.dataset.nextIndex || rows.children.length);
+    const number = index + 1;
+    const row = document.createElement('div');
+    row.className = 'option-row';
+    const field = document.createElement('div');
+    field.className = 'option-field';
+    const label = document.createElement('label');
+    label.htmlFor = `option-text-${index}`;
+    label.textContent = `Option ${number}`;
+    const text = document.createElement('input');
+    text.className = 'input';
+    text.id = `option-text-${index}`;
+    text.name = 'option_text';
+    text.type = 'text';
+    text.placeholder = 'Option text';
+    text.autocomplete = 'off';
+    field.append(label, text);
+    const correctLabel = document.createElement('label');
+    correctLabel.className = 'checkbox';
+    correctLabel.htmlFor = `option-correct-${index}`;
+    const correct = document.createElement('input');
+    correct.type = 'checkbox';
+    correct.id = `option-correct-${index}`;
+    correct.name = 'correct_index';
+    correct.value = String(index);
+    const correctText = document.createElement('span');
+    correctText.textContent = `Option ${number} is correct`;
+    correctLabel.append(correct, correctText);
+    row.append(field, correctLabel);
+    rows.append(row);
+    rows.dataset.nextIndex = String(index + 1);
+    text.focus();
+  });
+})();
+</script>"#
+}
+
+fn render_errors(errors: &[String]) -> String {
+    if errors.is_empty() {
+        return String::new();
+    }
+    let mut html = String::from("<div class=\"errors\" role=\"alert\"><ul>");
+    for error in errors {
+        html.push_str(&format!("<li>{}</li>", escape_html(error)));
+    }
+    html.push_str("</ul></div>");
+    html
+}
+
+fn render_preview(quiz: &Quiz) -> String {
+    let questions: Vec<PreviewQuestion> = quiz
+        .questions
+        .iter()
+        .filter(|question| question.active)
+        .map(|question| PreviewQuestion {
+            body: question.body.clone(),
+            options: question
+                .options
+                .iter()
+                .map(|option| PreviewOption {
+                    body: option.body.clone(),
+                    correct: option.correct,
+                })
+                .collect(),
+        })
+        .collect();
+    let json = serde_json::to_string(&questions)
+        .unwrap_or_else(|_| "[]".to_owned())
+        .replace('&', "\\u0026")
+        .replace('<', "\\u003c")
+        .replace('>', "\\u003e")
+        .replace('\u{2028}', "\\u2028")
+        .replace('\u{2029}', "\\u2029");
+    let title = escape_html(&quiz.title);
+    format!(
+        "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Quizzy · Preview · {title}</title><link rel=\"stylesheet\" href=\"/assets/quizzy.css\"><link rel=\"stylesheet\" href=\"/assets/app.css\"></head><body><div class=\"preview-banner\"><a href=\"/moderate/quizzes/{quiz_id}\">← Back to quiz</a><span>Preview mode</span></div><main class=\"play\"><div class=\"play__top\"><span class=\"logo play__logo\"><span class=\"logo__mark\">?</span>Quizzy</span><span>{title}</span></div><div class=\"play__body play__body--top\" id=\"preview-content\" aria-live=\"polite\"></div><noscript>Preview requires JavaScript to run.</noscript></main><script type=\"application/json\" id=\"preview-data\">{json}</script>{script}</body></html>",
+        quiz_id = quiz.id,
+        script = preview_script()
+    )
+}
+
+fn preview_script() -> &'static str {
+    r#"<script>
+(() => {
+  const questions = JSON.parse(document.getElementById('preview-data').textContent);
+  const content = document.getElementById('preview-content');
+  let current = 0;
+  let score = 0;
+  let answered = false;
+
+  function addAdvanceButton(label, action) {
+    const row = document.createElement('div');
+    row.className = 'buttons preview-advance';
+    const button = document.createElement('button');
+    button.className = 'btn btn--pink';
+    button.type = 'button';
+    button.textContent = label;
+    button.addEventListener('click', action);
+    row.append(button);
+    content.append(row);
+  }
+
+  function showScore() {
+    content.replaceChildren();
+    const card = document.createElement('div');
+    card.className = 'preview-score';
+    const heading = document.createElement('h1');
+    heading.textContent = `Score: ${score}/${questions.length}`;
+    const restart = document.createElement('button');
+    restart.className = 'btn btn--pink';
+    restart.type = 'button';
+    restart.textContent = 'Start over';
+    restart.addEventListener('click', () => {
+      current = 0;
+      score = 0;
+      answered = false;
+      renderQuestion();
+    });
+    card.append(heading, restart);
+    content.append(card);
+  }
+
+  function renderQuestion() {
+    content.replaceChildren();
+    if (questions.length === 0) {
+      const heading = document.createElement('h1');
+      heading.textContent = 'No active questions';
+      const restart = document.createElement('button');
+      restart.className = 'btn btn--pink';
+      restart.type = 'button';
+      restart.textContent = 'Start over';
+      restart.addEventListener('click', renderQuestion);
+      content.append(heading, restart);
+      return;
+    }
+    answered = false;
+    const question = questions[current];
+    const progress = document.createElement('div');
+    progress.className = 'play-question__num';
+    progress.textContent = `Question ${current + 1} of ${questions.length}`;
+    const body = document.createElement('div');
+    body.className = 'play-question__body';
+    body.textContent = question.body;
+    const choices = document.createElement('div');
+    choices.className = 'play-options';
+    question.options.forEach((option, index) => {
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.className = 'play-option';
+      const letter = document.createElement('span');
+      letter.className = 'play-option__letter';
+      letter.textContent = String.fromCharCode(65 + (index % 26));
+      const title = document.createElement('span');
+      title.className = 'play-option__title';
+      title.textContent = option.body;
+      button.append(letter, title);
+      button.addEventListener('click', () => {
+        if (answered) return;
+        answered = true;
+        button.classList.add('is-picked');
+        choices.classList.add('is-locked', 'is-revealed');
+        choices.querySelectorAll('.play-option').forEach((choice, i) => {
+          choice.disabled = true;
+          if (question.options[i].correct) {
+            choice.classList.add('is-correct');
+            const mark = document.createElement('span');
+            mark.className = 'play-option__mark';
+            mark.textContent = 'Correct answer';
+            choice.append(mark);
+          }
+        });
+        const isCorrect = option.correct;
+        if (isCorrect) score += 1;
+        const status = document.createElement('div');
+        status.className = `play-status ${isCorrect ? 'play-status--right' : 'play-status--wrong'}`;
+        status.textContent = isCorrect ? 'Correct!' : 'Wrong!';
+        content.append(status);
+        const label = current + 1 === questions.length ? 'See score' : 'Next question';
+        addAdvanceButton(label, () => {
+          if (current + 1 === questions.length) {
+            showScore();
+          } else {
+            current += 1;
+            renderQuestion();
+          }
+        });
+      });
+      choices.append(button);
+    });
+    content.append(progress, body, choices);
+  }
+
+  renderQuestion();
+})();
+</script>"#
+}
+
+fn option_letter(index: usize) -> String {
+    let mut number = index + 1;
+    let mut letters = Vec::new();
+    while number > 0 {
+        let remainder = (number - 1) % 26;
+        letters.push((b'A' + remainder as u8) as char);
+        number = (number - 1) / 26;
+    }
+    letters.iter().rev().collect()
+}
+
+fn page(title: &str, content: &str) -> String {
+    format!(
+        "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Quizzy · {}</title><link rel=\"stylesheet\" href=\"/assets/quizzy.css\"><link rel=\"stylesheet\" href=\"/assets/app.css\"></head><body><header class=\"admin-header\"><a class=\"logo admin-header__logo\" href=\"/moderate\"><span class=\"logo__mark\">?</span>Quizzy</a><span class=\"admin-header__tag\">Moderator</span></header><main class=\"admin-main\">{content}</main></body></html>",
+        escape_html(title)
+    )
+}
+
+fn escape_html(value: &str) -> String {
+    let mut escaped = String::with_capacity(value.len());
+    for character in value.chars() {
+        match character {
+            '&' => escaped.push_str("&amp;"),
+            '<' => escaped.push_str("&lt;"),
+            '>' => escaped.push_str("&gt;"),
+            '"' => escaped.push_str("&quot;"),
+            '\'' => escaped.push_str("&#39;"),
+            _ => escaped.push(character),
+        }
+    }
+    escaped
+}
+
+fn not_found() -> Response {
+    (StatusCode::NOT_FOUND, Html(page("Not found", "<h1>Not found</h1><p>The requested item could not be found.</p><a class=\"btn btn--ghost\" href=\"/moderate\">Back to quizzes</a>"))).into_response()
+}
+
+fn bad_request() -> Response {
+    (
+        StatusCode::BAD_REQUEST,
+        Html(page("Bad request", "<h1>Bad request</h1>")),
+    )
+        .into_response()
+}
+
+fn csrf_error() -> Response {
+    (
+        StatusCode::FORBIDDEN,
+        Html(page(
+            "Form expired",
+            "<h1>Form expired</h1><p>Please reload the page and try again.</p>",
+        )),
+    )
+        .into_response()
+}
+
+fn internal_error(error: impl Display) -> Response {
+    eprintln!("Quizzy request failed: {error}");
+    (
+        StatusCode::INTERNAL_SERVER_ERROR,
+        Html(page(
+            "Something went wrong",
+            "<h1>Something went wrong</h1><p>Please try again in a moment.</p>",
+        )),
+    )
+        .into_response()
+}
