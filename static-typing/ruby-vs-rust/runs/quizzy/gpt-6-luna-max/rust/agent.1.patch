+    ));
+    item.push_str(&move_button(
+        &move_path,
+        &state.csrf_token,
+        "down",
+        "↓",
+        "Move down",
+        index + 1 == quiz.questions.len(),
+    ));
+    item.push_str("</div>");
+    item.push_str(&format!(
+        "<form class=\"active-toggle\" method=\"post\" action=\"/moderate/quizzes/{}/questions/{}/active\"><input type=\"hidden\" name=\"csrf\" value=\"{}\"><label class=\"checkbox\"><input type=\"checkbox\" name=\"active\" value=\"true\" onchange=\"this.form.submit()\"{}>Active</label></form>",
