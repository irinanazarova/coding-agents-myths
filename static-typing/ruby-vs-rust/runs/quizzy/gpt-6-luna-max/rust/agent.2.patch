+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::BTreeSet;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    fn temporary_database_path() -> PathBuf {
+        let nonce = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .expect("clock is after the Unix epoch")
+            .as_nanos();
+        env::temp_dir().join(format!(
+            "quizzy-test-{}-{nonce}.sqlite3",
+            std::process::id()
+        ))
+    }
+
+    fn remove_test_database(path: &FsPath) {
+        let _ = fs::remove_file(path);
+        let _ = fs::remove_file(format!("{}-wal", path.display()));
+        let _ = fs::remove_file(format!("{}-shm", path.display()));
+    }
+
+    #[test]
+    fn import_defaults_validation_order_and_export_shape() {
+        let json = r#"{
+            "title": "  Frontend Fest 2026  ",
+            "questions": [
+                {
+                    "text": " Which status code? ",
+                    "options": [
+                        {"text": " 418 "},
+                        {"text": "   ", "correct": true},
+                        {"text": "429", "correct": true}
+                    ]
+                },
+                {
+                    "text": "Protocol?",
+                    "active": false,
+                    "options": [
+                        {"text": "WebSocket", "correct": true},
+                        {"text": "SMTP"}
+                    ]
+                }
+            ]
+        }"#;
+        let transfer: QuizTransfer = serde_json::from_str(json).unwrap();
+        let validated = validate_transfer(transfer).unwrap();
+        assert_eq!(validated.0.title, "Frontend Fest 2026");
+        assert_eq!(validated.0.questions.len(), 2);
+        assert_eq!(validated.0.questions[0].text, "Which status code?");
+        assert!(validated.0.questions[0].active);
+        assert_eq!(validated.0.questions[0].options.len(), 2);
+        assert_eq!(validated.0.questions[0].options[0].text, "418");
+        assert!(!validated.0.questions[0].options[0].correct);
+        assert_eq!(validated.0.questions[0].options[1].text, "429");
+        assert!(validated.0.questions[0].options[1].correct);
+        assert!(!validated.0.questions[1].active);
+        assert!(!validated.0.questions[1].options[1].correct);
+
+        let path = temporary_database_path();
+        initialize_database(&path).unwrap();
+        let quiz_id = insert_transferred_quiz(&path, &validated).unwrap();
+        let quiz = load_quiz(&path, quiz_id).unwrap().unwrap();
+        let exported = serde_json::to_value(transfer_from_quiz(&quiz)).unwrap();
+
+        let keys = |value: &serde_json::Value| -> BTreeSet<String> {
+            value.as_object().unwrap().keys().cloned().collect()
+        };
+        assert_eq!(
+            keys(&exported),
+            BTreeSet::from(["title".into(), "questions".into()])
+        );
+        let questions = exported["questions"].as_array().unwrap();
+        assert_eq!(questions.len(), 2);
+        assert_eq!(
+            keys(&questions[0]),
+            BTreeSet::from(["text".into(), "active".into(), "options".into()])
+        );
+        assert_eq!(questions[0]["text"], "Which status code?");
+        assert_eq!(questions[0]["active"], true);
+        assert_eq!(questions[0]["options"][0]["text"], "418");
+        assert_eq!(
+            keys(&questions[0]["options"][0]),
+            BTreeSet::from(["text".into(), "correct".into()])
+        );
+        assert_eq!(questions[0]["options"][1]["text"], "429");
+        assert_eq!(questions[1]["text"], "Protocol?");
+        assert_eq!(questions[1]["active"], false);
+        remove_test_database(&path);
+    }
+
+    #[test]
+    fn invalid_questions_reject_the_whole_quiz() {
+        let transfer = serde_json::from_str::<QuizTransfer>(
+            r#"{
+                "title": "No partial import",
+                "questions": [
+                    {"text":"Valid","options":[{"text":"A","correct":true},{"text":"B"}]},
+                    {"text":"  ","options":[{"text":"Only option"}]}
+                ]
+            }"#,
+        )
+        .unwrap();
+        let errors = validate_transfer(transfer).unwrap_err();
+        assert!(
+            errors
+                .iter()
+                .any(|error| error.contains("Question 2: Question is required"))
+        );
+        assert!(
+            errors
+                .iter()
+                .any(|error| error.contains("Question 2: Add at least two options"))
+        );
+        assert!(
+            errors
+                .iter()
+                .any(|error| error.contains("Question 2: Mark at least one option as correct"))
+        );
+    }
+
+    #[test]
+    fn transfer_json_rejects_unknown_fields() {
+        let result =
+            serde_json::from_str::<QuizTransfer>(r#"{"title":"Quiz","questions":[],"id":123}"#);
+        assert!(result.is_err());
+    }
+
+    #[test]
+    fn failed_database_import_rolls_back_the_quiz_and_questions() {
+        let path = temporary_database_path();
+        initialize_database(&path).unwrap();
+        open_database(&path)
+            .unwrap()
+            .execute_batch(
+                "CREATE TRIGGER reject_imported_options BEFORE INSERT ON options
+                 BEGIN SELECT RAISE(ABORT, 'test failure'); END;",
+            )
+            .unwrap();
+        let transfer = serde_json::from_str::<QuizTransfer>(
+            r#"{"title":"Atomic quiz","questions":[{"text":"Q","options":[{"text":"A","correct":true},{"text":"B"}]}]}"#,
+        )
+        .unwrap();
+        let validated = validate_transfer(transfer).unwrap();
+        assert!(insert_transferred_quiz(&path, &validated).is_err());
+        let quiz_count: i64 = open_database(&path)
+            .unwrap()
+            .query_row("SELECT COUNT(*) FROM quizzes", [], |row| row.get(0))
+            .unwrap();
+        assert_eq!(quiz_count, 0);
+        remove_test_database(&path);
+    }
+}
