+async fn import_quiz(State(state): State<AppState>, Form(form): Form<ImportQuizForm>) -> Response {
+    if !csrf_valid(&state, &form.csrf) {
+        return csrf_error();
+    }
+
+    let transfer = match serde_json::from_str::<QuizTransfer>(&form.quiz_json) {
+        Ok(transfer) => transfer,
+        Err(error) => {
+            return Html(render_import_quiz_form(
+                &state,
+                &form.quiz_json,
+                &[format!("Invalid quiz JSON: {error}")],
+            ))
+            .into_response();
+        }
+    };
+    let transfer = match validate_transfer(transfer) {
+        Ok(transfer) => transfer,
+        Err(errors) => {
+            return Html(render_import_quiz_form(&state, &form.quiz_json, &errors)).into_response();
+        }
+    };
+
+    match insert_transferred_quiz(&state.db_path, &transfer) {
+        Ok(quiz_id) => Redirect::to(&format!("/moderate/quizzes/{quiz_id}")).into_response(),
+        Err(error) => internal_error(error),
+    }
+}
+
+fn validate_transfer(mut transfer: QuizTransfer) -> Result<ValidatedQuiz, Vec<String>> {
+    let mut errors = Vec::new();
+    transfer.title = transfer.title.trim().to_owned();
+    if transfer.title.is_empty() {
+        errors.push("Title is required".to_owned());
+    }
+
+    for (question_index, question) in transfer.questions.iter_mut().enumerate() {
+        let label = format!("Question {}: ", question_index + 1);
+        question.text = question.text.trim().to_owned();
+        if question.text.is_empty() {
+            errors.push(format!("{label}Question is required"));
+        }
+        for option in &mut question.options {
+            option.text = option.text.trim().to_owned();
+        }
+        // Like the question form, blank option rows are ignored without
+        // disturbing the order of the remaining choices.
+        question.options.retain(|option| !option.text.is_empty());
+        if question.options.len() < 2 {
+            errors.push(format!("{label}Add at least two options"));
+        }
+        if !question.options.iter().any(|option| option.correct) {
+            errors.push(format!("{label}Mark at least one option as correct"));
+        }
+    }
+
+    if errors.is_empty() {
+        Ok(ValidatedQuiz(transfer))
+    } else {
+        Err(errors)
+    }
+}
+
+fn insert_transferred_quiz(path: &FsPath, transfer: &ValidatedQuiz) -> rusqlite::Result<i64> {
+    let transfer = &transfer.0;
+    let mut connection = open_database(path)?;
+    let transaction = connection.transaction()?;
+    transaction.execute("INSERT INTO quizzes(title) VALUES (?1)", [&transfer.title])?;
+    let quiz_id = transaction.last_insert_rowid();
+
+    for (question_position, question) in transfer.questions.iter().enumerate() {
+        transaction.execute(
+            "INSERT INTO questions(quiz_id, body, active, position) VALUES (?1, ?2, ?3, ?4)",
+            params![
+                quiz_id,
+                question.text,
+                question.active,
+                question_position as i64
+            ],
+        )?;
+        let question_id = transaction.last_insert_rowid();
+        for (option_position, option) in question.options.iter().enumerate() {
+            transaction.execute(
+                "INSERT INTO options(question_id, body, is_correct, position)
+                 VALUES (?1, ?2, ?3, ?4)",
+                params![
+                    question_id,
+                    option.text,
+                    option.correct,
+                    option_position as i64
+                ],
+            )?;
+        }
+    }
+
+    transaction.commit()?;
+    Ok(quiz_id)
+}
+
+fn default_active() -> bool {
+    true
+}
