+fn transfer_from_quiz(quiz: &Quiz) -> QuizTransfer {
+    QuizTransfer {
+        title: quiz.title.clone(),
+        questions: quiz
+            .questions
+            .iter()
+            .map(|question| TransferQuestion {
+                text: question.body.clone(),
+                active: question.active,
+                options: question
+                    .options
+                    .iter()
+                    .map(|option| TransferOption {
+                        text: option.body.clone(),
+                        correct: option.correct,
+                    })
+                    .collect(),
+            })
+            .collect(),
+    }
+}
