+fn render_player_state_html(state: &PlayerGameState) -> String {
+    if state.status == "over" {
+        return "<h1>The quiz is over</h1>".to_owned();
+    }
+    let mut content = format!("<h1>Hi, {}!</h1>", escape_html(&state.player_name));
+    match state.status.as_str() {
+        "waiting" => {
+            content.push_str("<p class=\"player-waiting\">Waiting for the quiz to start</p>")
+        }
+        "open" => {
+            if let Some(question) = &state.question {
+                content.push_str(&format!(
+                    "<p class=\"game-kicker\">Question {} of {}</p><h2>{}</h2><div class=\"player-options\">",
+                    state.question_number.unwrap_or(0),
+                    state.question_count,
+                    escape_html(&question.text)
+                ));
+                for option in &question.options {
+                    let selected = state.selected_option == Some(option.id);
+                    content.push_str(&format!(
+                        "<button class=\"btn player-option{}\" type=\"button\" data-option-id=\"{}\" aria-pressed=\"{}\">{}{}</button>",
+                        if selected { " is-selected" } else { "" },
+                        option.id,
+                        selected,
+                        escape_html(&option.text),
+                        if selected { " <span>Your answer</span>" } else { "" },
+                    ));
+                }
+                content.push_str("</div>");
+            }
+        }
+        "closed" => content.push_str(&format!(
+            "<p class=\"player-feedback\">{}</p>",
+            escape_html(state.feedback.as_deref().unwrap_or("No answer"))
+        )),
+        _ => content.push_str("<p>Waiting for the quiz to start</p>"),
+    }
+    content
+}
+
+const PLAYER_SCRIPT: &str = r#"
+(() => {
+  const root = document.getElementById('player-state');
+  const base = `/play/${GAME_CODE}`;
+  let latest = null;
+  let pendingSelection = null;
+  let pendingQuestion = null;
+  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({
+    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
+  }[character]));
+  function render(state) {
+    latest = state;
+    if (state.status === 'over') {
+      root.innerHTML = '<h1>The quiz is over</h1>';
+      return;
+    }
+    let html = `<h1>Hi, ${escapeHtml(state.player_name)}!</h1>`;
+    if (state.status === 'waiting') {
+      html += '<p class="player-waiting">Waiting for the quiz to start</p>';
+    } else if (state.status === 'open' && state.question) {
+      html += `<p class="game-kicker">Question ${state.question_number} of ${state.question_count}</p><h2>${escapeHtml(state.question.text)}</h2><div class="player-options">`;
+      const selectedId = pendingSelection !== null && pendingQuestion === state.question.id
+        ? pendingSelection : state.selected_option;
+      for (const option of state.question.options) {
+        const selected = selectedId === option.id;
+        html += `<button class="btn player-option${selected ? ' is-selected' : ''}" type="button" data-option-id="${option.id}" aria-pressed="${selected}">${escapeHtml(option.text)}${selected ? ' <span>Your answer</span>' : ''}</button>`;
+      }
+      html += '</div>';
+    } else if (state.status === 'closed') {
+      pendingSelection = null;
+      pendingQuestion = null;
+      html += `<p class="player-feedback">${escapeHtml(state.feedback || 'No answer')}</p>`;
+    }
+    root.innerHTML = html;
+  }
+  async function refresh() {
+    try {
+      const response = await fetch(`${base}/state`, {cache: 'no-store'});
+      if (response.ok) render(await response.json());
+    } catch (_) { /* keep the last screen during a temporary conference Wi-Fi gap */ }
+  }
+  async function choose(optionId, questionId) {
+    pendingSelection = optionId;
+    pendingQuestion = questionId;
+    render(latest);
+    const fields = new URLSearchParams({option_id: String(optionId)});
+    try {
+      const response = await fetch(`${base}/answer`, {
+        method: 'POST',
+        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+        body: fields.toString(),
+        cache: 'no-store'
+      });
+      if (!response.ok) {
+        pendingSelection = null;
+        pendingQuestion = null;
+      }
+      await refresh();
+    } catch (_) {
+      /* the selection remains visible and can be submitted again by tapping */
+    }
+  }
+  root.addEventListener('click', (event) => {
+    const button = event.target.closest('button[data-option-id]');
+    if (button && latest && latest.question) {
+      choose(Number(button.dataset.optionId), latest.question.id);
+    }
+  });
+  refresh();
+  window.setInterval(refresh, 1200);
+})();
