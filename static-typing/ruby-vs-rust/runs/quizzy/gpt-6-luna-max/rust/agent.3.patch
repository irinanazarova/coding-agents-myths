+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    fn temporary_database_path() -> std::path::PathBuf {
+        let nonce = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .expect("clock is after Unix epoch")
+            .as_nanos();
+        std::env::temp_dir().join(format!("quizzy-live-{nonce}.sqlite3"))
+    }
+
+    fn remove_database(path: &FsPath) {
+        let _ = fs::remove_file(path);
+        let _ = fs::remove_file(path.with_extension("sqlite3-wal"));
+        let _ = fs::remove_file(path.with_extension("sqlite3-shm"));
+    }
+
+    #[test]
+    fn game_snapshots_active_questions_and_only_reveals_results_after_finish() {
+        let path = temporary_database_path();
+        super::super::initialize_database(&path).unwrap();
+        let connection = open_database(&path).unwrap();
+        connection
+            .execute("INSERT INTO quizzes(title) VALUES ('Snapshot test')", [])
+            .unwrap();
+        let quiz_id = connection.last_insert_rowid();
+        connection
+            .execute(
+                "INSERT INTO questions(quiz_id, body, active, position) VALUES
+                 (?1, 'Active one', 1, 0), (?1, 'Inactive', 0, 1), (?1, 'Active two', 1, 2)",
+                [quiz_id],
+            )
+            .unwrap();
+        let questions = connection
+            .prepare("SELECT id FROM questions WHERE quiz_id = ?1 ORDER BY position")
+            .unwrap()
+            .query_map([quiz_id], |row| row.get::<_, i64>(0))
+            .unwrap()
+            .collect::<rusqlite::Result<Vec<_>>>()
+            .unwrap();
+        connection
+            .execute(
+                "INSERT INTO options(question_id, body, is_correct, position) VALUES
+                 (?1, 'Wrong', 0, 0), (?1, 'Right', 1, 1),
+                 (?2, 'Inactive A', 0, 0), (?2, 'Inactive B', 1, 1),
+                 (?3, 'Other wrong', 0, 0), (?3, 'Other right', 1, 1)",
+                params![questions[0], questions[1], questions[2]],
+            )
+            .unwrap();
+        drop(connection);
+
+        let game_id = create_game(&path, quiz_id).unwrap().unwrap();
+        let connection = open_database(&path).unwrap();
+        let code: String = connection
+            .query_row("SELECT code FROM games WHERE id = ?1", [game_id], |row| {
+                row.get(0)
+            })
+            .unwrap();
+        let player_id = connection
+            .execute(
+                "INSERT INTO players(game_id, name, token) VALUES (?1, 'Alex', 'unit-test-token')",
+                [game_id],
+            )
+            .unwrap();
+        assert_eq!(player_id, 1);
+        let copied_questions: Vec<String> = connection
+            .prepare("SELECT body FROM game_questions WHERE game_id = ?1 ORDER BY position")
+            .unwrap()
+            .query_map([game_id], |row| row.get(0))
+            .unwrap()
+            .collect::<rusqlite::Result<Vec<_>>>()
+            .unwrap();
+        assert_eq!(copied_questions, ["Active one", "Active two"]);
+        drop(connection);
+
+        let mut headers = HeaderMap::new();
+        headers.insert(header::HOST, HeaderValue::from_static("localhost:3000"));
+        let waiting = moderator_state(&path, game_id, &headers).unwrap().unwrap();
+        assert_eq!(waiting.status, "waiting");
+        assert_eq!(waiting.players, 1);
+        assert!(waiting.join_url.ends_with(&format!("/play/{code}")));
+        assert!(action_succeeded(&path, game_id, "start").unwrap());
+
+        let open = moderator_state(&path, game_id, &headers).unwrap().unwrap();
+        assert_eq!(open.question_number, Some(1));
+        assert_eq!(open.question_count, 2);
+        assert_eq!(open.question_text.as_deref(), Some("Active one"));
+        let open_json = serde_json::to_string(&open).unwrap();
+        assert!(!open_json.contains("correct"));
+        assert!(!open_json.contains("answers\":\""));
+
+        let player = load_player_state(&path, &code, "unit-test-token")
+            .unwrap()
+            .unwrap();
+        assert_eq!(player.question.as_ref().unwrap().text, "Active one");
+        let player_json = serde_json::to_string(&player).unwrap();
+        assert!(!player_json.contains("correct"));
+        assert!(!player_json.contains("is_correct"));
+
+        let connection = open_database(&path).unwrap();
+        let game_question_id: i64 = connection
+            .query_row(
+                "SELECT id FROM game_questions WHERE game_id = ?1 AND position = 0",
+                [game_id],
+                |row| row.get(0),
+            )
+            .unwrap();
+        let correct_option: i64 = connection
+            .query_row(
+                "SELECT id FROM game_options WHERE game_question_id = ?1 AND is_correct = 1",
+                [game_question_id],
+                |row| row.get(0),
+            )
+            .unwrap();
+        let answer_result = connection.execute(
+            "INSERT INTO answers(player_id, game_question_id, option_id) VALUES (1, ?1, ?2)",
+            params![game_question_id, correct_option],
+        );
+        answer_result.unwrap();
+        drop(connection);
+
+        assert!(action_succeeded(&path, game_id, "finish").unwrap());
+        let closed = moderator_state(&path, game_id, &headers).unwrap().unwrap();
+        assert_eq!(closed.status, "closed");
+        assert!(
+            closed
+                .options
+                .iter()
+                .any(|option| option.correct == Some(true))
+        );
+        assert_eq!(
+            load_player_state(&path, &code, "unit-test-token")
+                .unwrap()
+                .unwrap()
+                .feedback
+                .as_deref(),
+            Some("Correct!")
+        );
+        assert!(action_succeeded(&path, game_id, "next").unwrap());
+        let next = moderator_state(&path, game_id, &headers).unwrap().unwrap();
+        assert_eq!(next.question_number, Some(2));
+        assert_eq!(next.question_text.as_deref(), Some("Active two"));
+        assert!(action_succeeded(&path, game_id, "finish").unwrap());
+        assert!(action_succeeded(&path, game_id, "next").unwrap());
+        assert_eq!(
+            moderator_state(&path, game_id, &headers)
+                .unwrap()
+                .unwrap()
+                .status,
+            "over"
+        );
+        assert_eq!(
+            load_player_state(&path, &code, "unit-test-token")
+                .unwrap()
+                .unwrap()
+                .status,
+            "over"
+        );
+        remove_database(&path);
+    }
+
+    #[test]
+    fn starting_a_quiz_without_active_questions_creates_no_game() {
+        let path = temporary_database_path();
+        super::super::initialize_database(&path).unwrap();
+        let connection = open_database(&path).unwrap();
+        connection
+            .execute("INSERT INTO quizzes(title) VALUES ('Inactive quiz')", [])
+            .unwrap();
+        let quiz_id = connection.last_insert_rowid();
+        connection
+            .execute(
+                "INSERT INTO questions(quiz_id, body, active, position) VALUES (?1, 'Off', 0, 0)",
+                [quiz_id],
+            )
+            .unwrap();
+        drop(connection);
+
+        assert!(create_game(&path, quiz_id).unwrap().is_none());
+        let count: i64 = open_database(&path)
+            .unwrap()
+            .query_row("SELECT COUNT(*) FROM games", [], |row| row.get(0))
+            .unwrap();
+        assert_eq!(count, 0);
+        remove_database(&path);
+    }
+}
