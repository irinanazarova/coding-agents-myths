+pub(super) async fn join_game(
+    State(state): State<AppState>,
+    Path(raw_code): Path<String>,
+    headers: HeaderMap,
+    Form(form): Form<JoinForm>,
+) -> Response {
+    let Some(code) = canonical_code(&raw_code) else {
+        return missing_player_game();
+    };
+    let (game_id, title, status) = {
+        let connection = match open_database(&state.db_path) {
+            Ok(connection) => connection,
+            Err(error) => return internal_error(error),
+        };
+        match connection
+            .query_row(
+                "SELECT id, quiz_title, status FROM games WHERE code = ?1",
+                [&code],
+                |row| {
+                    Ok((
+                        row.get::<_, i64>(0)?,
+                        row.get::<_, String>(1)?,
+                        row.get::<_, String>(2)?,
+                    ))
+                },
+            )
+            .optional()
+        {
+            Ok(Some(game)) => game,
+            Ok(None) => return missing_player_game(),
+            Err(error) => return internal_error(error),
+        }
+    };
+    if status == "over" {
+        return html_response(player_document(
+            &title,
+            "<section class=\"player-card\"><h1>The quiz is over</h1></section>",
+        ));
+    }
+
+    if let Some(token) = player_cookie_token(&headers, &code) {
+        match find_player(&state.db_path, game_id, &token) {
+            Ok(Some(_)) => return Redirect::to(&format!("/play/{code}")).into_response(),
+            Ok(None) => {}
+            Err(error) => return internal_error(error),
+        }
+    }
+
+    let name = form.name.trim();
+    if name.is_empty() || name.chars().count() > 80 {
+        let message = if name.is_empty() {
+            "Enter your name."
+        } else {
+            "Your name must be 80 characters or fewer."
+        };
+        return html_response(render_join_page(&code, &title, name, Some(message)));
+    }
+    let token = match new_player_token() {
+        Ok(token) => token,
+        Err(error) => return internal_error(error),
+    };
+    let connection = match open_database(&state.db_path) {
+        Ok(connection) => connection,
+        Err(error) => return internal_error(error),
+    };
+    let inserted = match connection.execute(
+        "INSERT INTO players(game_id, name, token)
+         SELECT id, ?2, ?3 FROM games WHERE id = ?1 AND status != 'over'",
+        params![game_id, name, token],
+    ) {
+        Ok(inserted) => inserted,
+        Err(error) => return internal_error(error),
+    };
+    if inserted == 0 {
+        return html_response(player_document(
+            &title,
+            "<section class=\"player-card\"><h1>The quiz is over</h1></section>",
+        ));
+    }
+    let mut response = Redirect::to(&format!("/play/{code}")).into_response();
+    set_player_cookie(&mut response, &code, &token);
+    no_cache(response)
+}
