+use super::{AppState, Quiz, csrf_error, escape_html, internal_error, open_database, page};
+use axum::Json;
+use axum::extract::{Form, Path, State};
+use axum::http::{HeaderMap, HeaderValue, StatusCode, header};
+use axum::response::{Html, IntoResponse, Redirect, Response};
+use qrcode::{Color as QrColor, QrCode};
+use rusqlite::{OptionalExtension, params};
+use serde::{Deserialize, Serialize};
+use std::fs::File;
+use std::io::Read;
+use std::path::Path as FsPath;
+
+const CODE_ALPHABET: &[u8] = b"ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
+const COOKIE_PREFIX: &str = "quizzy_player_";
+
+#[derive(Deserialize)]
+pub(super) struct CsrfForm {
+    #[serde(default)]
+    csrf: String,
+}
+
+#[derive(Deserialize)]
+pub(super) struct JoinForm {
+    #[serde(default)]
+    name: String,
+}
+
+#[derive(Deserialize)]
+pub(super) struct GameActionForm {
+    #[serde(default)]
+    csrf: String,
+    #[serde(default)]
+    action: String,
+}
+
+#[derive(Deserialize)]
+pub(super) struct AnswerForm {
+    option_id: i64,
+}
+
+#[derive(Serialize, Clone)]
+struct GameOptionState {
+    id: i64,
+    text: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    answers: Option<i64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    correct: Option<bool>,
+}
+
+#[derive(Serialize, Clone)]
+struct ModeratorGameState {
+    status: String,
+    title: String,
+    code: String,
+    join_url: String,
+    players: i64,
+    current_position: Option<i64>,
+    question_number: Option<i64>,
+    question_count: i64,
+    question_text: Option<String>,
+    answered: i64,
+    options: Vec<GameOptionState>,
+}
+
+#[derive(Serialize)]
+struct PlayerOption {
+    id: i64,
+    text: String,
+}
+
+#[derive(Serialize)]
+struct PlayerQuestion {
+    id: i64,
+    text: String,
+    options: Vec<PlayerOption>,
+}
+
+#[derive(Serialize)]
+struct PlayerGameState {
+    status: String,
+    player_name: String,
+    question_number: Option<i64>,
+    question_count: i64,
+    question: Option<PlayerQuestion>,
+    selected_option: Option<i64>,
+    feedback: Option<String>,
+}
+
+#[derive(Serialize)]
+struct AnswerAck {
+    ok: bool,
+}
+
+fn canonical_code(raw: &str) -> Option<String> {
+    if raw.len() != 5
+        || !raw
+            .bytes()
+            .all(|byte| CODE_ALPHABET.contains(&byte.to_ascii_uppercase()))
+    {
+        return None;
+    }
+    Some(raw.to_ascii_uppercase())
+}
+
+fn secure_random_bytes(length: usize) -> std::io::Result<Vec<u8>> {
+    let mut bytes = vec![0; length];
+    File::open("/dev/urandom")?.read_exact(&mut bytes)?;
+    Ok(bytes)
+}
+
+fn new_game_code() -> std::io::Result<String> {
+    let random = secure_random_bytes(5)?;
+    Ok(random
+        .iter()
+        .map(|byte| CODE_ALPHABET[usize::from(*byte) % CODE_ALPHABET.len()] as char)
+        .collect())
+}
+
+fn new_player_token() -> std::io::Result<String> {
+    let random = secure_random_bytes(32)?;
+    Ok(random.iter().map(|byte| format!("{byte:02x}")).collect())
+}
+
+fn host_for_link(headers: &HeaderMap) -> String {
+    headers
+        .get(header::HOST)
+        .and_then(|value| value.to_str().ok())
+        .filter(|host| {
+            !host.is_empty()
+                && host.len() <= 250
+                && host.bytes().all(|byte| {
+                    byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b':' | b'-' | b'[' | b']')
+                })
+        })
+        .unwrap_or("localhost")
+        .to_owned()
+}
+
+fn join_link(headers: &HeaderMap, code: &str) -> String {
+    format!("http://{}/play/{code}", host_for_link(headers))
+}
+
+fn player_cookie_token(headers: &HeaderMap, code: &str) -> Option<String> {
+    let cookie_name = format!("{COOKIE_PREFIX}{code}");
+    headers
+        .get(header::COOKIE)?
+        .to_str()
+        .ok()?
+        .split(';')
+        .filter_map(|part| part.trim().split_once('='))
+        .find_map(|(name, value)| {
+            if name == cookie_name && !value.is_empty() {
+                Some(value.to_owned())
+            } else {
+                None
+            }
+        })
+}
+
+fn set_player_cookie(response: &mut Response, code: &str, token: &str) {
+    let value = format!(
+        "{COOKIE_PREFIX}{code}={token}; Path=/play/{code}; HttpOnly; SameSite=Lax; Max-Age=31536000"
+    );
+    if let Ok(value) = HeaderValue::from_str(&value) {
+        response.headers_mut().append(header::SET_COOKIE, value);
+    }
+}
+
+fn no_cache(mut response: Response) -> Response {
+    response.headers_mut().insert(
+        header::CACHE_CONTROL,
+        HeaderValue::from_static("no-store, no-cache, must-revalidate"),
+    );
+    response
+}
+
+fn html_response(html: String) -> Response {
+    no_cache(Html(html).into_response())
+}
+
+fn json_response<T: Serialize>(value: T) -> Response {
+    no_cache(Json(value).into_response())
+}
+
+fn player_document(title: &str, content: &str) -> String {
+    format!(
+        "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Quizzy · {}</title><link rel=\"stylesheet\" href=\"/assets/quizzy.css\"><link rel=\"stylesheet\" href=\"/assets/app.css\"></head><body class=\"player-body\"><main class=\"player-page\">{content}</main></body></html>",
+        escape_html(title)
+    )
+}
+
+fn missing_player_game() -> Response {
+    html_response(player_document(
+        "Game not found",
+        "<section class=\"player-card\"><h1>Game not found</h1><p>Check the join link and try again.</p></section>",
+    ))
+}
+
+fn quiz_snapshot(path: &FsPath, quiz_id: i64) -> rusqlite::Result<Option<Quiz>> {
+    super::load_quiz(path, quiz_id)
+}
+
+fn create_game(path: &FsPath, quiz_id: i64) -> rusqlite::Result<Option<i64>> {
+    let Some(quiz) = quiz_snapshot(path, quiz_id)? else {
+        return Ok(None);
+    };
+    let active_questions = quiz
+        .questions
+        .iter()
+        .filter(|question| question.active)
+        .collect::<Vec<_>>();
+    if active_questions.is_empty() {
+        return Ok(None);
+    }
+
+    let mut connection = open_database(path)?;
+    for _ in 0..16 {
+        let code = new_game_code().map_err(|_| rusqlite::Error::InvalidQuery)?;
+        let code_exists: bool = connection.query_row(
+            "SELECT EXISTS(SELECT 1 FROM games WHERE code = ?1)",
+            [&code],
+            |row| row.get(0),
+        )?;
+        if code_exists {
+            continue;
+        }
+
+        let transaction = connection.transaction()?;
+        transaction.execute(
+            "INSERT INTO games(quiz_id, quiz_title, code, status, current_position)
+             VALUES (?1, ?2, ?3, 'waiting', -1)",
+            params![quiz.id, quiz.title, code],
+        )?;
+        let game_id = transaction.last_insert_rowid();
+
+        for (position, question) in active_questions.iter().enumerate() {
+            transaction.execute(
+                "INSERT INTO game_questions(game_id, source_question_id, body, position)
+                 VALUES (?1, ?2, ?3, ?4)",
+                params![game_id, question.id, question.body, position as i64],
+            )?;
+            let game_question_id = transaction.last_insert_rowid();
+            for (option_position, option) in question.options.iter().enumerate() {
+                transaction.execute(
+                    "INSERT INTO game_options(game_question_id, body, is_correct, position)
+                     VALUES (?1, ?2, ?3, ?4)",
+                    params![
+                        game_question_id,
+                        option.body,
+                        i64::from(option.correct),
+                        option_position as i64
+                    ],
+                )?;
+            }
+        }
+
+        transaction.commit()?;
+        return Ok(Some(game_id));
+    }
+    Err(rusqlite::Error::InvalidQuery)
+}
+
+pub(super) async fn start_game(
+    State(state): State<AppState>,
+    Path(quiz_id): Path<i64>,
+    Form(form): Form<CsrfForm>,
+) -> Response {
+    if !super::csrf_valid(&state, &form.csrf) {
+        return csrf_error();
+    }
+    match create_game(&state.db_path, quiz_id) {
+        Ok(Some(game_id)) => Redirect::to(&format!("/moderate/games/{game_id}")).into_response(),
+        Ok(None) => {
+            let content = format!(
+                "<div class=\"breadcrumbs\"><a href=\"/moderate/quizzes/{quiz_id}\">← Back to quiz</a></div><h1>Start a game</h1><p>Add at least one active question before starting a game.</p>"
+            );
+            html_response(page("Start a game", &content))
+        }
+        Err(error) => internal_error(error),
+    }
+}
+
+#[derive(Clone)]
+struct GameInfo {
+    id: i64,
+    title: String,
+    code: String,
+    status: String,
+    current_position: i64,
+}
+
+fn game_info(
+    connection: &rusqlite::Connection,
+    game_id: i64,
+) -> rusqlite::Result<Option<GameInfo>> {
+    connection
+        .query_row(
+            "SELECT id, quiz_title, code, status, current_position FROM games WHERE id = ?1",
+            [game_id],
+            |row| {
+                Ok(GameInfo {
+                    id: row.get(0)?,
+                    title: row.get(1)?,
+                    code: row.get(2)?,
+                    status: row.get(3)?,
+                    current_position: row.get(4)?,
+                })
+            },
+        )
+        .optional()
+}
+
+fn moderator_state(
+    path: &FsPath,
+    game_id: i64,
+    headers: &HeaderMap,
+) -> rusqlite::Result<Option<ModeratorGameState>> {
+    let connection = open_database(path)?;
+    let Some(game) = game_info(&connection, game_id)? else {
+        return Ok(None);
+    };
+    let join_url = join_link(headers, &game.code);
+    let players: i64 = connection.query_row(
+        "SELECT COUNT(*) FROM players WHERE game_id = ?1",
+        [game.id],
+        |row| row.get(0),
+    )?;
+    let question_count: i64 = connection.query_row(
+        "SELECT COUNT(*) FROM game_questions WHERE game_id = ?1",
+        [game.id],
+        |row| row.get(0),
+    )?;
+    let mut state = ModeratorGameState {
+        status: game.status.clone(),
+        title: game.title,
+        code: game.code,
+        join_url,
+        players,
+        current_position: None,
+        question_number: None,
+        question_count,
+        question_text: None,
+        answered: 0,
+        options: Vec::new(),
+    };
+    if game.current_position < 0 {
+        return Ok(Some(state));
+    }
+
+    state.current_position = Some(game.current_position);
+    state.question_number = Some(game.current_position + 1);
+    let question: Option<(i64, String)> = connection
+        .query_row(
+            "SELECT id, body FROM game_questions WHERE game_id = ?1 AND position = ?2",
+            params![game.id, game.current_position],
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .optional()?;
+    let Some((question_id, body)) = question else {
+        return Ok(Some(state));
+    };
+    state.question_text = Some(body);
+
+    if game.status == "open" {
+        state.answered = connection.query_row(
+            "SELECT COUNT(*) FROM answers WHERE game_question_id = ?1",
+            [question_id],
+            |row| row.get(0),
+        )?;
+        let mut statement = connection.prepare(
+            "SELECT id, body FROM game_options WHERE game_question_id = ?1 ORDER BY position, id",
+        )?;
+        state.options = statement
+            .query_map([question_id], |row| {
+                Ok(GameOptionState {
+                    id: row.get(0)?,
+                    text: row.get(1)?,
+                    answers: None,
+                    correct: None,
+                })
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+    } else if game.status == "closed" {
+        let mut statement = connection.prepare(
+            "SELECT option.id, option.body, option.is_correct, COUNT(answer.id)
+             FROM game_options option
+             LEFT JOIN answers answer
+               ON answer.option_id = option.id AND answer.game_question_id = option.game_question_id
+             WHERE option.game_question_id = ?1
+             GROUP BY option.id, option.body, option.is_correct
+             ORDER BY option.position, option.id",
+        )?;
+        state.options = statement
+            .query_map([question_id], |row| {
+                Ok(GameOptionState {
+                    id: row.get(0)?,
+                    text: row.get(1)?,
+                    correct: Some(row.get::<_, i64>(2)? != 0),
+                    answers: Some(row.get(3)?),
+                })
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+    }
+    Ok(Some(state))
+}
+
+pub(super) async fn show_game(
+    State(state): State<AppState>,
+    Path(game_id): Path<i64>,
+    headers: HeaderMap,
+) -> Response {
+    let Some(game) = (match moderator_state(&state.db_path, game_id, &headers) {
+        Ok(game) => game,
+        Err(error) => return internal_error(error),
+    }) else {
+        return super::not_found();
+    };
+    html_response(render_moderator_game_page(&state, game_id, &game))
+}
+
+pub(super) async fn moderator_game_state(
+    State(state): State<AppState>,
+    Path(game_id): Path<i64>,
+    headers: HeaderMap,
+) -> Response {
+    match moderator_state(&state.db_path, game_id, &headers) {
+        Ok(Some(game)) => json_response(game),
+        Ok(None) => (
+            StatusCode::NOT_FOUND,
+            Json(serde_json::json!({"error":"not found"})),
+        )
+            .into_response(),
+        Err(error) => internal_error(error),
+    }
+}
+
+fn action_succeeded(path: &FsPath, game_id: i64, action: &str) -> rusqlite::Result<bool> {
+    let mut connection = open_database(path)?;
+    match action {
+        "start" => Ok(connection.execute(
+            "UPDATE games SET status = 'open', current_position = 0
+                 WHERE id = ?1 AND status = 'waiting'
+                   AND EXISTS(SELECT 1 FROM game_questions WHERE game_id = ?1)",
+            [game_id],
+        )? == 1),
+        "finish" => Ok(connection.execute(
+            "UPDATE games SET status = 'closed' WHERE id = ?1 AND status = 'open'",
+            [game_id],
+        )? == 1),
+        "next" => {
+            let transaction = connection.transaction()?;
+            let row: Option<(String, i64, i64)> = transaction
+                .query_row(
+                    "SELECT status, current_position,
+                            (SELECT COUNT(*) FROM game_questions WHERE game_id = games.id)
+                     FROM games WHERE id = ?1",
+                    [game_id],
+                    |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+                )
+                .optional()?;
+            let Some((status, position, total)) = row else {
+                return Ok(false);
+            };
+            if status != "closed" || total == 0 {
+                return Ok(false);
+            }
+            if position + 1 < total {
+                transaction.execute(
+                    "UPDATE games SET status = 'open', current_position = ?2
+                     WHERE id = ?1 AND status = 'closed' AND current_position = ?3",
+                    params![game_id, position + 1, position],
+                )?;
+            } else {
+                transaction.execute(
+                    "UPDATE games SET status = 'over'
+                     WHERE id = ?1 AND status = 'closed' AND current_position = ?2",
+                    params![game_id, position],
+                )?;
+            }
+            let changed = transaction.changes() == 1;
+            transaction.commit()?;
+            Ok(changed)
+        }
+        _ => Ok(false),
+    }
+}
+
+pub(super) async fn moderator_game_action(
+    State(state): State<AppState>,
+    Path(game_id): Path<i64>,
+    Form(form): Form<GameActionForm>,
+) -> Response {
+    if !super::csrf_valid(&state, &form.csrf) {
+        return csrf_error();
+    }
+    match action_succeeded(&state.db_path, game_id, &form.action) {
+        Ok(true) => StatusCode::NO_CONTENT.into_response(),
+        Ok(false) => StatusCode::CONFLICT.into_response(),
+        Err(error) => internal_error(error),
+    }
+}
