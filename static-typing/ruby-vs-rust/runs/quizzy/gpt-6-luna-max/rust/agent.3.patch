+const MODERATOR_SCRIPT: &str = r#"
+(() => {
+  const screen = document.getElementById('game-screen');
+  const gameId = screen.dataset.gameId;
+  const base = new URL(`/moderate/games/${gameId}`, location.origin).href;
+  const byId = (id) => document.getElementById(id);
+  const show = (id, visible) => { byId(id).hidden = !visible; };
+  function replaceOptions(id, options, results) {
+    const list = byId(id);
+    list.replaceChildren();
+    for (const option of options || []) {
+      const item = document.createElement('li');
+      item.append(document.createTextNode(option.text));
+      if (results) {
+        const count = document.createElement('span');
+        count.className = 'option-result-count';
+        count.textContent = `Answers: ${option.answers || 0}`;
+        item.append(document.createTextNode(' '), count);
+        if (option.correct) {
+          const correct = document.createElement('strong');
+          correct.className = 'correct-label';
+          correct.textContent = 'Correct';
+          item.append(document.createTextNode(' '), correct);
+        }
+      }
+      list.append(item);
+    }
+  }
+  function render(state) {
+    byId('screen-title').textContent = state.title;
+    byId('join-link').textContent = state.join_url;
+    byId('player-count').textContent = `Players: ${state.players}`;
+    const hasQuestion = state.question_number !== null;
+    const progress = hasQuestion ? `Question ${state.question_number} of ${state.question_count}` : '';
+    byId('question-progress').textContent = progress;
+    byId('closed-progress').textContent = progress;
+    byId('open-question').textContent = state.question_text || '';
+    byId('closed-question').textContent = state.question_text || '';
+    byId('answer-count').textContent = `Answers: ${state.answered} / ${state.players}`;
+    replaceOptions('open-options', state.options, false);
+    replaceOptions('closed-options', state.options, true);
+    show('waiting-stage', state.status === 'waiting');
+    show('open-stage', state.status === 'open');
+    show('closed-stage', state.status === 'closed');
+    show('over-stage', state.status === 'over');
+    const next = byId('next-button');
+    const action = next.closest('form').querySelector('input[name="action"]');
+    if (action) action.value = 'next';
+    next.textContent = state.question_number >= state.question_count ? 'End quiz' : 'Next';
+  }
+  async function refresh() {
+    try {
+      const response = await fetch(`${base}/state`, {cache: 'no-store'});
+      if (response.ok) render(await response.json());
+    } catch (_) { /* a short Wi-Fi interruption is recovered on the next poll */ }
+  }
+  document.querySelectorAll('form.game-action').forEach((form) => {
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const button = form.querySelector('button');
+      if (button) button.disabled = true;
+      const fields = new URLSearchParams();
+      for (const [key, value] of new FormData(form)) fields.append(key, value);
+      try {
+        const actionUrl = new URL(form.getAttribute('action'), location.origin).href;
+        const response = await fetch(actionUrl, {
+          method: 'POST',
+          headers: {'Content-Type': 'application/x-www-form-urlencoded'},
+          body: fields.toString(),
+          cache: 'no-store'
+        });
+        if (response.ok) await refresh();
+      } catch (_) { /* the moderator may retry after connectivity returns */ }
+      if (button) button.disabled = false;
+    });
+  });
+  refresh();
+  window.setInterval(refresh, 1200);
+})();
+"#;
+
+fn qr_svg(value: &str) -> String {
+    let Ok(code) = QrCode::new(value.as_bytes()) else {
+        return String::new();
+    };
+    let width = code.width();
+    let quiet = 4usize;
+    let dimension = width + quiet * 2;
+    let mut svg = format!(
+        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{dimension}\" height=\"{dimension}\" viewBox=\"0 0 {dimension} {dimension}\" role=\"img\" aria-label=\"QR code for join link\" shape-rendering=\"crispEdges\"><rect width=\"{dimension}\" height=\"{dimension}\" fill=\"white\"/>"
+    );
+    for y in 0..width {
+        for x in 0..width {
+            if code[(x, y)] == QrColor::Dark {
+                svg.push_str(&format!(
+                    "<rect x=\"{}\" y=\"{}\" width=\"1\" height=\"1\" fill=\"#0d0640\"/>",
+                    x + quiet,
+                    y + quiet
+                ));
+            }
+        }
+    }
+    svg.push_str("</svg>");
+    svg
+}
