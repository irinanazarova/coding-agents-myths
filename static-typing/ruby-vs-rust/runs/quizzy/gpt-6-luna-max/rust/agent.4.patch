+        for position in 0..3_i64 {
+            connection
+                .execute(
+                    "INSERT INTO questions(quiz_id, body, active, position)
+                     VALUES (?1, ?2, 1, ?3)",
+                    params![quiz_id, format!("Question {}", position + 1), position],
+                )
+                .unwrap();
+            let question_id = connection.last_insert_rowid();
+            connection
+                .execute(
+                    "INSERT INTO options(question_id, body, is_correct, position)
+                     VALUES (?1, 'Correct', 1, 0), (?1, 'Wrong', 0, 1)",
+                    [question_id],
+                )
+                .unwrap();
+        }
+        drop(connection);
+
+        let game_id = create_game(&path, quiz_id).unwrap().unwrap();
+        let connection = open_database(&path).unwrap();
+        let names = ["Anchor", "Swift", "Middle", "Slow", "Changer", "Zero"];
+        let mut player_ids = HashMap::new();
+        for name in names {
+            connection
+                .execute(
+                    "INSERT INTO players(game_id, name, token) VALUES (?1, ?2, ?3)",
+                    params![game_id, name, format!("token-{name}")],
+                )
+                .unwrap();
+            player_ids.insert(name.to_owned(), connection.last_insert_rowid());
+        }
+        let question_ids = (0..3_i64)
+            .map(|position| {
+                connection
+                    .query_row(
+                        "SELECT id FROM game_questions WHERE game_id = ?1 AND position = ?2",
+                        params![game_id, position],
+                        |row| row.get::<_, i64>(0),
+                    )
+                    .unwrap()
+            })
+            .collect::<Vec<_>>();
+        let options = question_ids
+            .iter()
+            .map(|question_id| {
+                connection
+                    .query_row(
+                        "SELECT
+                           (SELECT id FROM game_options WHERE game_question_id = ?1 AND is_correct = 1),
+                           (SELECT id FROM game_options WHERE game_question_id = ?1 AND is_correct = 0)",
+                        [question_id],
+                        |row| Ok((row.get::<_, i64>(0)?, row.get::<_, i64>(1)?)),
+                    )
+                    .unwrap()
+            })
+            .collect::<Vec<_>>();
+        drop(connection);
+
+        assert!(action_succeeded(&path, game_id, "start").unwrap());
+        assert!(action_succeeded(&path, game_id, "finish").unwrap());
+        assert!(action_succeeded(&path, game_id, "next").unwrap());
+        assert!(action_succeeded(&path, game_id, "finish").unwrap());
+        assert!(action_succeeded(&path, game_id, "next").unwrap());
+        assert!(action_succeeded(&path, game_id, "finish").unwrap());
+        assert!(action_succeeded(&path, game_id, "next").unwrap());
+
+        let opened_at = [1_000_i64, 2_000, 3_000];
+        let connection = open_database(&path).unwrap();
+        for (position, opened) in opened_at.iter().enumerate() {
+            connection
+                .execute(
+                    "UPDATE game_questions SET opened_at_ms = ?1
+                     WHERE game_id = ?2 AND position = ?3",
+                    params![opened, game_id, position as i64],
+                )
+                .unwrap();
+        }
+        let record = |name: &str, position: usize, correct: bool, elapsed: i64| {
+            let option_id = if correct {
+                options[position].0
+            } else {
+                options[position].1
+            };
+            connection.execute(
+                "INSERT INTO answers(player_id, game_question_id, option_id, answered_at_ms)
+                 VALUES (?1, ?2, ?3, ?4)
+                 ON CONFLICT(player_id, game_question_id) DO UPDATE SET
+                     option_id = excluded.option_id,
+                     answered_at_ms = excluded.answered_at_ms",
+                params![
+                    player_ids[name],
+                    question_ids[position],
+                    option_id,
+                    opened_at[position] + elapsed
+                ],
+            )
+        };
+        for (position, elapsed) in [(0, 30), (1, 30), (2, 30)] {
+            record("Anchor", position, true, elapsed).unwrap();
+        }
+        record("Swift", 0, true, 10).unwrap();
+        record("Swift", 1, true, 10).unwrap();
+        record("Swift", 2, false, 5).unwrap();
+        record("Middle", 0, true, 20).unwrap();
+        record("Middle", 1, true, 20).unwrap();
+        record("Middle", 2, false, 5).unwrap();
+        record("Slow", 0, true, 100).unwrap();
+        record("Slow", 1, true, 100).unwrap();
+        record("Slow", 2, false, 5).unwrap();
