+fn set_winners(path: &FsPath, game_id: i64, action: &str) -> rusqlite::Result<bool> {
+    let mut connection = open_database(path)?;
+    let transaction = connection.transaction()?;
+    let game: Option<(String, i64)> = transaction
+        .query_row(
+            "SELECT status, number_of_winners FROM games WHERE id = ?1",
+            [game_id],
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .optional()?;
+    let Some((status, number_of_winners)) = game else {
+        return Ok(false);
+    };
+    if status != "over" {
+        return Ok(false);
+    }
+
+    let ranked = ranked_players(&transaction, game_id)?;
+    let positive = ranked
+        .iter()
+        .filter(|player| player.points > 0)
+        .collect::<Vec<_>>();
+    let winner_ids = match action {
+        "reset_winners" => Vec::new(),
+        "top" => {
+            let count = positive
+                .len()
+                .min(usize::try_from(number_of_winners).unwrap_or(usize::MAX));
+            positive
+                .iter()
+                .take(count)
+                .map(|player| player.id)
+                .collect()
+        }
+        "draw" => {
+            let count = positive
+                .len()
+                .min(usize::try_from(number_of_winners).unwrap_or(usize::MAX));
+            if positive.len() <= count {
+                positive.iter().map(|player| player.id).collect()
+            } else {
+                // All scores above the Nth score win. Speed orders the leaderboard,
+                // but players tied on the cutoff score share a random prize draw.
+                let cutoff = positive[count - 1].points;
+                let mut winners = positive
+                    .iter()
+                    .filter(|player| player.points > cutoff)
+                    .map(|player| player.id)
+                    .collect::<Vec<_>>();
+                let prizes_left = count - winners.len();
+                let mut tied = positive
+                    .iter()
+                    .filter(|player| player.points == cutoff)
+                    .map(|player| player.id)
+                    .collect::<Vec<_>>();
+                shuffle_player_ids(&mut tied)?;
+                winners.extend(tied.into_iter().take(prizes_left));
+                winners
+            }
+        }
+        _ => return Ok(false),
+    };
+
+    transaction.execute(
+        "UPDATE players SET is_winner = 0 WHERE game_id = ?1",
+        [game_id],
+    )?;
+    for player_id in winner_ids {
+        transaction.execute(
+            "UPDATE players SET is_winner = 1 WHERE id = ?1 AND game_id = ?2",
+            params![player_id, game_id],
+        )?;
+    }
+    transaction.commit()?;
+    Ok(true)
+}
