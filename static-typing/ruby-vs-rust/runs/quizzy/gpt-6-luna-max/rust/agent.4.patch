+fn random_below(upper: usize) -> std::io::Result<usize> {
+    let modulus =
+        u64::try_from(upper).map_err(|_| std::io::Error::other("random range is too large"))?;
+    if modulus == 0 {
+        return Err(std::io::Error::other("random range must not be zero"));
+    }
+    let threshold = modulus.wrapping_neg() % modulus;
+    loop {
+        let bytes = secure_random_bytes(8)?;
+        let value = u64::from_ne_bytes(bytes.try_into().expect("eight random bytes"));
+        if value >= threshold {
+            return usize::try_from(value % modulus)
+                .map_err(|_| std::io::Error::other("random index is out of range"));
+        }
+    }
+}
+
+fn shuffle_player_ids(ids: &mut [i64]) -> rusqlite::Result<()> {
+    for index in (1..ids.len()).rev() {
+        let swap_with = random_below(index + 1).map_err(|_| rusqlite::Error::InvalidQuery)?;
+        ids.swap(index, swap_with);
+    }
+    Ok(())
+}
