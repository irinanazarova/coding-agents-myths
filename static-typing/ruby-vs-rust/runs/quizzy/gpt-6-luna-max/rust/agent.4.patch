+    fn database_initialization_migrates_existing_quiz_and_game_tables() {
+        let path = temporary_database_path();
+        let connection = Connection::open(&path).unwrap();
+        connection
+            .execute_batch(
+                "CREATE TABLE quizzes (
+                    id INTEGER PRIMARY KEY AUTOINCREMENT,
+                    title TEXT NOT NULL,
+                    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
+                 );
+                 INSERT INTO quizzes(title) VALUES ('Legacy');
+                 CREATE TABLE games (
+                    id INTEGER PRIMARY KEY AUTOINCREMENT,
+                    quiz_id INTEGER,
+                    quiz_title TEXT NOT NULL,
+                    code TEXT NOT NULL UNIQUE,
+                    status TEXT NOT NULL,
+                    current_position INTEGER NOT NULL DEFAULT -1,
+                    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
+                 );
+                 CREATE TABLE game_questions (
+                    id INTEGER PRIMARY KEY AUTOINCREMENT,
+                    game_id INTEGER NOT NULL,
+                    source_question_id INTEGER,
+                    body TEXT NOT NULL,
+                    position INTEGER NOT NULL
+                 );
+                 CREATE TABLE players (
+                    id INTEGER PRIMARY KEY AUTOINCREMENT,
+                    game_id INTEGER NOT NULL,
+                    name TEXT NOT NULL,
+                    token TEXT NOT NULL UNIQUE,
+                    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
+                 );
+                 CREATE TABLE answers (
+                    id INTEGER PRIMARY KEY AUTOINCREMENT,
+                    player_id INTEGER NOT NULL,
+                    game_question_id INTEGER NOT NULL,
+                    option_id INTEGER NOT NULL,
+                    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
+                 );",
+            )
+            .unwrap();
+        drop(connection);
+
+        initialize_database(&path).unwrap();
+        let connection = open_database(&path).unwrap();
+        let legacy_default: i64 = connection
+            .query_row(
+                "SELECT number_of_winners FROM quizzes WHERE title = 'Legacy'",
+                [],
+                |row| row.get(0),
+            )
+            .unwrap();
+        assert_eq!(legacy_default, 3);
+        for (table, column) in [
+            ("games", "number_of_winners"),
+            ("game_questions", "opened_at_ms"),
+            ("players", "is_winner"),
+            ("answers", "answered_at_ms"),
+        ] {
+            let mut statement = connection
+                .prepare(&format!("PRAGMA table_info({table})"))
+                .unwrap();
+            let columns = statement
+                .query_map([], |row| row.get::<_, String>(1))
+                .unwrap()
+                .collect::<rusqlite::Result<Vec<_>>>()
+                .unwrap();
+            assert!(
+                columns.iter().any(|name| name == column),
+                "{table}.{column}"
+            );
+        }
+        remove_test_database(&path);
+    }
