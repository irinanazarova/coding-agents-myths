+fn timer_duration_ms(minutes: i64, seconds: i64) -> Option<i64> {
+    if minutes < 0 || !(0..60).contains(&seconds) {
+        return None;
+    }
+    minutes
+        .checked_mul(60_000)?
+        .checked_add(seconds.checked_mul(1_000)?)
+}
+
+fn timer_settings_error(minutes: i64, seconds: i64) -> Option<&'static str> {
+    if minutes < 0 {
+        return Some("Timer minutes must be 0 or greater");
+    }
+    if !(0..60).contains(&seconds) {
+        return Some("Timer seconds must be between 0 and 59");
+    }
+    if timer_duration_ms(minutes, seconds).is_none() {
+        return Some("Timer duration is too large");
+    }
+    None
+}
