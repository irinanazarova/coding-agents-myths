@@ -0,0 +1,196 @@
+#!/usr/bin/env python3
+"""End-to-end timer regression smoke test; run against a local Quizzy server."""
+import base64
+import http.cookiejar
+import json
+import os
+import re
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+import uuid
+
+BASE = os.environ.get("QUIZZY_URL", "http://127.0.0.1:3000").rstrip("/")
+USERNAME = os.environ.get("QUIZZY_MODERATOR_USERNAME", "moderator")
+PASSWORD = os.environ.get("QUIZZY_MODERATOR_PASSWORD", "password")
+
+password_manager = urllib.request.HTTPPasswordMgrWithDefaultRealm()
+password_manager.add_password(None, BASE, USERNAME, PASSWORD)
+moderator = urllib.request.build_opener(urllib.request.HTTPBasicAuthHandler(password_manager))
+players = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
+
+
+def request(opener, path, data=None):
+    body = None if data is None else urllib.parse.urlencode(data, doseq=True).encode()
+    req = urllib.request.Request(f"{BASE}{path}", data=body)
+    if body is not None:
+        req.add_header("Content-Type", "application/x-www-form-urlencoded")
+    with opener.open(req, timeout=10) as response:
+        return response.geturl(), response.read().decode("utf-8", errors="replace")
+
+
+def post(opener, path, fields):
+    return request(opener, path, fields)
+
+
+def csrf(html):
+    match = re.search(r'name="csrf"\s+value="([^"]+)"', html)
+    assert match, "could not find a CSRF token in moderator form"
+    return match.group(1)
+
+
+def state_for(game_id):
+    _, payload = request(moderator, f"/moderate/games/{game_id}/state")
+    return json.loads(payload)
+
+
+def start_game(quiz_id):
+    _, quiz_page = request(moderator, f"/moderate/quizzes/{quiz_id}")
+    game_url, game_page = post(
+        moderator,
+        f"/moderate/quizzes/{quiz_id}/games",
+        {"csrf": csrf(quiz_page)},
+    )
+    match = re.search(r"/moderate/games/(\d+)$", urllib.parse.urlparse(game_url).path)
+    assert match, f"starting the game did not redirect to a game: {game_url}"
+    game_id = int(match.group(1))
+    action_csrf = csrf(game_page)
+    post(moderator, f"/moderate/games/{game_id}/action", {"csrf": action_csrf, "action": "start"})
+    return game_id, action_csrf
+
+
+def main():
+    _, new_quiz_form = request(moderator, "/moderate/quizzes/new")
+    assert re.search(r'<label for="timer-minutes">Timer minutes</label>', new_quiz_form), \
+        'quiz settings are missing the "Timer minutes" field'
+    assert re.search(r'<label for="timer-seconds">Timer seconds</label>', new_quiz_form), \
+        'quiz settings are missing the "Timer seconds" field'
+    assert re.search(r'name="timer_minutes"[^>]*value="0"', new_quiz_form), \
+        "new quizzes should default to a zero-minute timer"
+    assert re.search(r'name="timer_seconds"[^>]*value="0"', new_quiz_form), \
+        "new quizzes should default to a zero-second timer"
+
+    title = f"Timer smoke {uuid.uuid4().hex[:8]}"
+    quiz_url, quiz_page = post(
+        moderator,
+        "/moderate/quizzes",
+        {
+            "csrf": csrf(new_quiz_form),
+            "title": title,
+            "number_of_winners": "3",
+            "timer_minutes": "0",
+            "timer_seconds": "5",
+        },
+    )
+    quiz_match = re.search(r"/moderate/quizzes/(\d+)$", urllib.parse.urlparse(quiz_url).path)
+    assert quiz_match, f"quiz creation did not redirect to a quiz: {quiz_url}"
+    quiz_id = int(quiz_match.group(1))
+
+    _, settings = request(moderator, f"/moderate/quizzes/{quiz_id}/settings")
+    assert re.search(r'name="timer_seconds"[^>]*value="5"', settings), \
+        "timer setting was not persisted"
+    _, export = request(moderator, f"/moderate/quizzes/{quiz_id}/export")
+    assert "timer_minutes" not in export and "timer_seconds" not in export, \
+        "timer settings must not be part of the quiz export format"
+
+    _, question_form = request(moderator, f"/moderate/quizzes/{quiz_id}/questions/new")
+    post(
+        moderator,
+        f"/moderate/quizzes/{quiz_id}/questions",
+        {
+            "csrf": csrf(question_form),
+            "question": "What time is it?",
+            "option_text": ["Five seconds", "One minute"],
+            "correct_index": "0",
+            "active": "true",
+        },
+    )
+
+    game_id, action_csrf = start_game(quiz_id)
+    initial = state_for(game_id)
+    assert initial["status"] == "open", f"expected an open question, got {initial['status']}"
+    assert 0 < initial.get("timer_remaining_ms", 0) <= 5000, \
+        f"timer is missing or did not start at question-open: {initial}"
+    _, open_page = request(moderator, f"/moderate/games/{game_id}")
+    assert re.search(r'id="question-timer"[^>]*>0:0[1-5]</', open_page), \
+        "moderator's open-question screen is missing the M:SS countdown"
+
+    # Reloads must consult the original opening timestamp instead of restarting the timer.
+    before_reload = state_for(game_id)["timer_remaining_ms"]
+    time.sleep(0.7)
+    _, reloaded_page = request(moderator, f"/moderate/games/{game_id}")
+    after_reload = state_for(game_id)["timer_remaining_ms"]
+    assert after_reload < before_reload, "reloading the moderator screen restarted the timer"
+    assert re.search(r'id="question-timer"[^>]*>0:0[1-5]</', reloaded_page)
+
+    code = initial["code"]
+    _, join_page = request(players, f"/play/{code}")
+    assert 'name="name"' in join_page, "player join form was not served"
+    _, player_page = post(players, f"/play/{code}/join", {"name": "Timer tester"})
+    assert 'id="question-timer"' not in player_page and "Time remaining" not in player_page, \
+        "players must not see the question timer"
+    _, player_state = request(players, f"/play/{code}/state")
+    assert "timer_remaining_ms" not in player_state, "player state must not expose timer data"
+
+    # The moderator can finish before time expires.
+    post(moderator, f"/moderate/games/{game_id}/action", {"csrf": action_csrf, "action": "finish"})
+    assert state_for(game_id)["status"] == "closed", "manual Finish did not close the question"
+
+    # A separate run is allowed to expire without requests from the moderator page.
+    timed_game_id, _ = start_game(quiz_id)
+    time.sleep(5.6)
+    assert state_for(timed_game_id)["status"] == "closed", \
+        "an expired question was not automatically finished by the server"
+
+    def save_timer(minutes, seconds):
+        _, current_settings = request(moderator, f"/moderate/quizzes/{quiz_id}/settings")
+        post(
+            moderator,
+            f"/moderate/quizzes/{quiz_id}",
+            {
+                "csrf": csrf(current_settings),
+                "title": title,
+                "number_of_winners": "3",
+                "timer_minutes": str(minutes),
+                "timer_seconds": str(seconds),
+            },
+        )
+
+    # The minute component renders as M:SS, and an active game's timer is a snapshot.
+    save_timer(1, 30)
+    long_game_id, long_game_csrf = start_game(quiz_id)
+    long_state = state_for(long_game_id)
+    assert 0 < long_state["timer_remaining_ms"] <= 90_000
+    _, long_game_page = request(moderator, f"/moderate/games/{long_game_id}")
+    assert re.search(r'id="question-timer"[^>]*>1:3[0-9]</', long_game_page), \
+        "a 90-second timer should use the M:SS format"
+    save_timer(0, 0)
+    assert state_for(long_game_id)["timer_remaining_ms"] > 0, \
+        "editing quiz settings changed a timer already snapshotted into a game"
+    post(
+        moderator,
+        f"/moderate/games/{long_game_id}/action",
+        {"csrf": long_game_csrf, "action": "finish"},
+    )
+
+    # 0:00 disables timing; the question remains open until the moderator finishes it.
+    untimed_game_id, untimed_csrf = start_game(quiz_id)
+    untimed = state_for(untimed_game_id)
+    assert untimed["status"] == "open" and untimed["timer_remaining_ms"] is None
+    _, untimed_page = request(moderator, f"/moderate/games/{untimed_game_id}")
+    assert re.search(r'id="question-timer"[^>]*hidden></p>', untimed_page), \
+        "a zero-minute, zero-second timer should be hidden"
+    time.sleep(1.2)
+    assert state_for(untimed_game_id)["status"] == "open", \
+        "a question with no timer was automatically finished"
+    post(
+        moderator,
+        f"/moderate/games/{untimed_game_id}/action",
+        {"csrf": untimed_csrf, "action": "finish"},
+    )
+    print("timer smoke test passed")
+
+
+if __name__ == "__main__":
+    main()
