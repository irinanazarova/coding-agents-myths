+async fn save_question(
+    state: &AppState,
+    quiz_id: i64,
+    question_id: Option<i64>,
+    form: QuestionForm,
+) -> Response {
+    if !csrf_valid(state, &form.csrf) {
+        return csrf_error();
+    }
+    let quiz = match load_quiz(&state.db_path, quiz_id) {
+        Ok(Some(quiz)) => quiz,
+        Ok(None) => return not_found(),
+        Err(error) => return internal_error(error),
+    };
+    let existing = if let Some(id) = question_id {
+        let Some(question) = quiz.questions.iter().find(|q| q.id == id) else {
+            return not_found();
+        };
+        Some(question)
+    } else {
+        None
+    };
+
+    let correct_indices: std::collections::HashSet<usize> =
+        form.correct_index.iter().copied().collect();
+    let options: Vec<OptionItem> = form
+        .option_text
+        .iter()
+        .enumerate()
+        .filter_map(|(index, text)| {
+            let body = text.trim();
+            (!body.is_empty()).then(|| OptionItem {
+                body: body.to_owned(),
+                correct: correct_indices.contains(&index),
+            })
+        })
+        .collect();
+
+    let mut errors = Vec::new();
+    if form.question.trim().is_empty() {
+        errors.push("Question is required".to_owned());
+    }
+    if options.len() < 2 {
+        errors.push("Add at least two options".to_owned());
+    }
+    if !options.iter().any(|option| option.correct) {
+        errors.push("Mark at least one option as correct".to_owned());
+    }
+    if !errors.is_empty() {
+        return Html(render_question_form(
+            state,
+            &quiz,
+            existing,
+            Some(&form),
+            &errors,
+        ))
+        .into_response();
+    }
+
+    let result =
+        (|| -> rusqlite::Result<()> {
+            let mut connection = open_database(&state.db_path)?;
+            let transaction = connection.transaction()?;
+            let saved_id =
+                if let Some(id) = question_id {
+                    transaction.execute(
+                "UPDATE questions SET body = ?1, active = ?2 WHERE id = ?3 AND quiz_id = ?4",
+                params![form.question.trim(), form.active.unwrap_or(false), id, quiz_id],
+            )?;
+                    transaction.execute("DELETE FROM options WHERE question_id = ?1", [id])?;
+                    id
+                } else {
+                    let position: i64 = transaction.query_row(
+                        "SELECT COALESCE(MAX(position), -1) + 1 FROM questions WHERE quiz_id = ?1",
+                        [quiz_id],
+                        |row| row.get(0),
+                    )?;
+                    transaction.execute(
+                "INSERT INTO questions(quiz_id, body, active, position) VALUES (?1, ?2, ?3, ?4)",
+                params![quiz_id, form.question.trim(), form.active.unwrap_or(false), position],
+            )?;
+                    transaction.last_insert_rowid()
+                };
+            for (position, option) in options.iter().enumerate() {
+                transaction.execute(
+                    "INSERT INTO options(question_id, body, is_correct, position)
+                 VALUES (?1, ?2, ?3, ?4)",
+                    params![saved_id, option.body, option.correct, position as i64],
+                )?;
+            }
+            transaction.commit()
+        })();
+
+    match result {
+        Ok(()) => Redirect::to(&format!("/moderate/quizzes/{quiz_id}")).into_response(),
+        Err(error) => internal_error(error),
+    }
+}
