+#[derive(Clone)]
+struct GameInfo {
+    id: i64,
+    title: String,
+    code: String,
+    status: String,
+    current_position: i64,
+    number_of_winners: i64,
+    timer_duration_ms: i64,
+}
+
+fn game_info(
+    connection: &rusqlite::Connection,
+    game_id: i64,
+) -> rusqlite::Result<Option<GameInfo>> {
+    connection
+        .query_row(
+            "SELECT id, quiz_title, code, status, current_position,
+                    number_of_winners, timer_duration_ms
+             FROM games WHERE id = ?1",
+            [game_id],
+            |row| {
+                Ok(GameInfo {
+                    id: row.get(0)?,
+                    title: row.get(1)?,
+                    code: row.get(2)?,
+                    status: row.get(3)?,
+                    current_position: row.get(4)?,
+                    number_of_winners: row.get(5)?,
+                    timer_duration_ms: row.get(6)?,
+                })
+            },
+        )
+        .optional()
+}
+
+fn ranked_players(
+    connection: &rusqlite::Connection,
+    game_id: i64,
+) -> rusqlite::Result<Vec<RankedPlayer>> {
+    let mut statement = connection.prepare(
+        "SELECT player.id, player.name,
+                COALESCE(SUM(CASE WHEN option.is_correct = 1 THEN 1 ELSE 0 END), 0) AS points,
+                COALESCE(SUM(CASE WHEN option.is_correct = 1
+                    THEN MAX(0, answer.answered_at_ms - COALESCE(question.opened_at_ms, answer.answered_at_ms))
+                    ELSE 0 END), 0) AS total_time_ms,
+                player.is_winner
+         FROM players player
+         LEFT JOIN answers answer ON answer.player_id = player.id
+         LEFT JOIN game_questions question ON question.id = answer.game_question_id
+         LEFT JOIN game_options option
+           ON option.id = answer.option_id AND option.game_question_id = answer.game_question_id
+         WHERE player.game_id = ?1
+         GROUP BY player.id, player.name, player.is_winner
+         ORDER BY points DESC, total_time_ms ASC, player.id ASC",
+    )?;
+    statement
+        .query_map([game_id], |row| {
+            Ok(RankedPlayer {
+                id: row.get(0)?,
+                name: row.get(1)?,
+                points: row.get(2)?,
+                is_winner: row.get::<_, i64>(4)? != 0,
+            })
+        })?
+        .collect()
+}
+
+fn leaderboard_entries(
+    connection: &rusqlite::Connection,
+    game_id: i64,
+) -> rusqlite::Result<Vec<LeaderboardEntry>> {
+    Ok(ranked_players(connection, game_id)?
+        .into_iter()
+        .enumerate()
+        .map(|(index, player)| LeaderboardEntry {
+            place: index as i64 + 1,
+            name: player.name,
+            points: player.points,
+            is_winner: player.is_winner,
+        })
+        .collect())
+}
+
+fn moderator_state(
+    path: &FsPath,
+    game_id: i64,
+    headers: &HeaderMap,
+) -> rusqlite::Result<Option<ModeratorGameState>> {
+    let connection = open_database(path)?;
+    expire_due_game(&connection, game_id, now_ms())?;
+    let Some(game) = game_info(&connection, game_id)? else {
+        return Ok(None);
+    };
+    let join_url = join_link(headers, &game.code);
+    let players: i64 = connection.query_row(
+        "SELECT COUNT(*) FROM players WHERE game_id = ?1",
+        [game.id],
+        |row| row.get(0),
+    )?;
+    let question_count: i64 = connection.query_row(
+        "SELECT COUNT(*) FROM game_questions WHERE game_id = ?1",
+        [game.id],
+        |row| row.get(0),
+    )?;
+    let leaderboard = if game.status == "over" {
+        leaderboard_entries(&connection, game.id)?
+    } else {
+        Vec::new()
+    };
+    let mut state = ModeratorGameState {
+        status: game.status.clone(),
+        title: game.title,
+        code: game.code,
+        join_url,
+        players,
+        number_of_winners: game.number_of_winners,
+        current_position: None,
+        question_number: None,
+        question_count,
+        question_text: None,
+        answered: 0,
+        timer_remaining_ms: None,
+        options: Vec::new(),
+        leaderboard,
+    };
+    if game.current_position < 0 {
+        return Ok(Some(state));
+    }
+
+    state.current_position = Some(game.current_position);
+    state.question_number = Some(game.current_position + 1);
+    let question: Option<(i64, String, Option<i64>)> = connection
+        .query_row(
+            "SELECT id, body, opened_at_ms FROM game_questions
+             WHERE game_id = ?1 AND position = ?2",
+            params![game.id, game.current_position],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+        )
+        .optional()?;
+    let Some((question_id, body, opened_at_ms)) = question else {
+        return Ok(Some(state));
+    };
+    state.question_text = Some(body);
+    if game.status == "open" && game.timer_duration_ms > 0 {
+        if let Some(opened_at_ms) = opened_at_ms {
+            let elapsed_ms = now_ms().saturating_sub(opened_at_ms).max(0);
+            state.timer_remaining_ms =
+                Some(game.timer_duration_ms.saturating_sub(elapsed_ms).max(0));
+        }
+    }
+
+    if game.status == "open" {
+        state.answered = connection.query_row(
+            "SELECT COUNT(*) FROM answers WHERE game_question_id = ?1",
+            [question_id],
+            |row| row.get(0),
+        )?;
+        let mut statement = connection.prepare(
+            "SELECT id, body FROM game_options WHERE game_question_id = ?1 ORDER BY position, id",
+        )?;
+        state.options = statement
+            .query_map([question_id], |row| {
+                Ok(GameOptionState {
+                    id: row.get(0)?,
+                    text: row.get(1)?,
+                    answers: None,
+                    correct: None,
+                })
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+    } else if game.status == "closed" {
+        let mut statement = connection.prepare(
+            "SELECT option.id, option.body, option.is_correct, COUNT(answer.id)
+             FROM game_options option
+             LEFT JOIN answers answer
+               ON answer.option_id = option.id AND answer.game_question_id = option.game_question_id
+             WHERE option.game_question_id = ?1
+             GROUP BY option.id, option.body, option.is_correct
+             ORDER BY option.position, option.id",
+        )?;
+        state.options = statement
+            .query_map([question_id], |row| {
+                Ok(GameOptionState {
+                    id: row.get(0)?,
+                    text: row.get(1)?,
+                    correct: Some(row.get::<_, i64>(2)? != 0),
+                    answers: Some(row.get(3)?),
+                })
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+    }
+    Ok(Some(state))
+}
