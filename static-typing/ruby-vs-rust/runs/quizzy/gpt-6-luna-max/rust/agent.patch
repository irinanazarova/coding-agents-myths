+        html.push_str(&escape_html(&option.text));
+        if with_results {
+            html.push_str(&format!(
+                " <span class=\"option-result-count\">Answers: {}</span>",
+                option.answers.unwrap_or(0)
+            ));
+            if option.correct == Some(true) {
+                html.push_str(" <strong class=\"correct-label\">Correct</strong>");
+            }
+        }
+        html.push_str("</li>");
+    }
+    html
+}
