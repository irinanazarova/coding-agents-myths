+fn parse_question_form(body: &[u8]) -> QuestionForm {
+    let mut form = QuestionForm {
+        csrf: String::new(),
+        question: String::new(),
+        option_text: Vec::new(),
+        correct_index: Vec::new(),
+        active: None,
+    };
+    for (key, value) in form_urlencoded::parse(body) {
+        match key.as_ref() {
+            "csrf" => form.csrf = value.into_owned(),
+            "question" => form.question = value.into_owned(),
+            "option_text" | "option_text[]" => form.option_text.push(value.into_owned()),
+            "correct_index" | "correct_index[]" => {
+                if let Ok(index) = value.parse::<usize>() {
+                    form.correct_index.push(index);
+                }
+            }
+            "active" => {
+                form.active = Some(matches!(value.as_ref(), "true" | "on" | "1"));
+            }
+            _ => {}
+        }
+    }
+    form
+}
