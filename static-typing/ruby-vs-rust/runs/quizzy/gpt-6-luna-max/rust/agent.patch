+pub(super) async fn submit_answer(
+    State(state): State<AppState>,
+    Path(raw_code): Path<String>,
+    headers: HeaderMap,
+    Form(form): Form<AnswerForm>,
+) -> Response {
+    let Some(code) = canonical_code(&raw_code) else {
+        return StatusCode::NOT_FOUND.into_response();
+    };
+    let Some(token) = player_cookie_token(&headers, &code) else {
+        return StatusCode::UNAUTHORIZED.into_response();
+    };
+    let mut connection = match open_database(&state.db_path) {
+        Ok(connection) => connection,
+        Err(error) => return internal_error(error),
+    };
+    let transaction = match connection.transaction() {
+        Ok(transaction) => transaction,
+        Err(error) => return internal_error(error),
+    };
+    let game_id: Option<i64> = match transaction
+        .query_row("SELECT id FROM games WHERE code = ?1", [&code], |row| {
+            row.get(0)
+        })
+        .optional()
+    {
+        Ok(game_id) => game_id,
+        Err(error) => return internal_error(error),
+    };
+    if let Some(game_id) = game_id
+        && let Err(error) = expire_due_game(&transaction, game_id, now_ms())
+    {
+        return internal_error(error);
+    }
+    let player: Option<(i64, i64, i64)> = match transaction
+        .query_row(
+            "SELECT player.id, game.id, game.current_position
+             FROM players player JOIN games game ON game.id = player.game_id
+             WHERE game.code = ?1 AND player.token = ?2 AND game.status = 'open'",
+            params![code, token],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+        )
+        .optional()
+    {
+        Ok(player) => player,
+        Err(error) => return internal_error(error),
+    };
+    let Some((player_id, game_id, position)) = player else {
+        if let Err(error) = transaction.commit() {
+            return internal_error(error);
+        }
+        return StatusCode::CONFLICT.into_response();
+    };
+    let question_id: Option<i64> = match transaction
+        .query_row(
+            "SELECT id FROM game_questions WHERE game_id = ?1 AND position = ?2",
+            params![game_id, position],
+            |row| row.get(0),
+        )
+        .optional()
+    {
+        Ok(question) => question,
+        Err(error) => return internal_error(error),
+    };
+    let Some(question_id) = question_id else {
+        return StatusCode::CONFLICT.into_response();
+    };
+    let valid_option: bool = match transaction.query_row(
+        "SELECT EXISTS(SELECT 1 FROM game_options WHERE id = ?1 AND game_question_id = ?2)",
+        params![form.option_id, question_id],
+        |row| row.get(0),
+    ) {
+        Ok(valid) => valid,
+        Err(error) => return internal_error(error),
+    };
+    if !valid_option {
+        return StatusCode::BAD_REQUEST.into_response();
+    }
+    let answered_at_ms = now_ms();
+    match expire_due_game(&transaction, game_id, answered_at_ms) {
+        Ok(true) => {
+            if let Err(error) = transaction.commit() {
+                return internal_error(error);
+            }
+            return StatusCode::CONFLICT.into_response();
+        }
+        Ok(false) => {}
+        Err(error) => return internal_error(error),
+    }
+    let game_is_open: bool = match transaction.query_row(
+        "SELECT EXISTS(SELECT 1 FROM games WHERE id = ?1 AND status = 'open')",
+        [game_id],
+        |row| row.get(0),
+    ) {
+        Ok(is_open) => is_open,
+        Err(error) => return internal_error(error),
+    };
+    if !game_is_open {
+        if let Err(error) = transaction.commit() {
+            return internal_error(error);
+        }
+        return StatusCode::CONFLICT.into_response();
+    }
+    if let Err(error) = transaction.execute(
+        "INSERT INTO answers(player_id, game_question_id, option_id, answered_at_ms)
+         VALUES (?1, ?2, ?3, ?4)
+         ON CONFLICT(player_id, game_question_id) DO UPDATE SET
+             option_id = excluded.option_id,
+             updated_at = CURRENT_TIMESTAMP,
+             answered_at_ms = excluded.answered_at_ms",
+        params![player_id, question_id, form.option_id, answered_at_ms],
+    ) {
+        return internal_error(error);
+    }
+    if let Err(error) = transaction.commit() {
+        return internal_error(error);
+    }
+    json_response(AnswerAck { ok: true })
+}
