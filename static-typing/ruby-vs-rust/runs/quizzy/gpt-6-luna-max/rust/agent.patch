+        assert!(action_succeeded(&path, game_id, "next").unwrap());
+
+        let opened_at = [1_000_i64, 2_000, 3_000];
+        let connection = open_database(&path).unwrap();
+        for (position, opened) in opened_at.iter().enumerate() {
+            connection
+                .execute(
+                    "UPDATE game_questions SET opened_at_ms = ?1
+                     WHERE game_id = ?2 AND position = ?3",
+                    params![opened, game_id, position as i64],
+                )
+                .unwrap();
+        }
+        let record = |name: &str, position: usize, correct: bool, elapsed: i64| {
+            let option_id = if correct {
+                options[position].0
+            } else {
+                options[position].1
+            };
+            connection.execute(
+                "INSERT INTO answers(player_id, game_question_id, option_id, answered_at_ms)
+                 VALUES (?1, ?2, ?3, ?4)
+                 ON CONFLICT(player_id, game_question_id) DO UPDATE SET
+                     option_id = excluded.option_id,
+                     answered_at_ms = excluded.answered_at_ms",
+                params![
+                    player_ids[name],
+                    question_ids[position],
+                    option_id,
+                    opened_at[position] + elapsed
+                ],
+            )
+        };
+        for (position, elapsed) in [(0, 30), (1, 30), (2, 30)] {
+            record("Anchor", position, true, elapsed).unwrap();
+        }
+        record("Swift", 0, true, 10).unwrap();
+        record("Swift", 1, true, 10).unwrap();
+        record("Swift", 2, false, 5).unwrap();
+        record("Middle", 0, true, 20).unwrap();
+        record("Middle", 1, true, 20).unwrap();
+        record("Middle", 2, false, 5).unwrap();
+        record("Slow", 0, true, 100).unwrap();
+        record("Slow", 1, true, 100).unwrap();
+        record("Slow", 2, false, 5).unwrap();
+        // Re-picking replaces the first answer. Only the final, wrong choice counts.
+        record("Changer", 0, true, 1).unwrap();
+        record("Changer", 0, false, 50).unwrap();
+        record("Changer", 1, true, 30).unwrap();
+        record("Changer", 2, false, 5).unwrap();
+        for position in 0..3 {
+            record("Zero", position, false, 1).unwrap();
+        }
+        drop(connection);
+
+        let connection = open_database(&path).unwrap();
+        let ranked = ranked_players(&connection, game_id).unwrap();
+        let ranked_names = ranked
+            .iter()
+            .map(|player| player.name.as_str())
+            .collect::<Vec<_>>();
+        assert_eq!(
+            ranked_names,
+            ["Anchor", "Swift", "Middle", "Slow", "Changer", "Zero"]
+        );
+        assert_eq!(
+            ranked
+                .iter()
+                .map(|player| player.points)
+                .collect::<Vec<_>>(),
+            [3, 2, 2, 2, 1, 0]
+        );
+        drop(connection);
+
+        assert!(action_succeeded(&path, game_id, "top").unwrap());
+        let connection = open_database(&path).unwrap();
+        let winners = connection
+            .prepare("SELECT name FROM players WHERE game_id = ?1 AND is_winner = 1 ORDER BY name")
+            .unwrap()
+            .query_map([game_id], |row| row.get::<_, String>(0))
+            .unwrap()
+            .collect::<rusqlite::Result<Vec<_>>>()
+            .unwrap();
+        assert_eq!(winners, ["Anchor", "Swift"]);
+        drop(connection);
+
+        // Drawing awards every strictly higher scorer, then ignores speed for the cutoff tie.
+        for _ in 0..4 {
+            assert!(action_succeeded(&path, game_id, "draw").unwrap());
+            let connection = open_database(&path).unwrap();
+            let winners = connection
+                .prepare("SELECT name FROM players WHERE game_id = ?1 AND is_winner = 1")
+                .unwrap()
+                .query_map([game_id], |row| row.get::<_, String>(0))
+                .unwrap()
+                .collect::<rusqlite::Result<Vec<_>>>()
+                .unwrap();
+            assert_eq!(winners.len(), 2);
+            assert!(winners.iter().any(|name| name == "Anchor"));
+            assert!(
+                winners
+                    .iter()
+                    .all(|name| ["Anchor", "Swift", "Middle", "Slow"].contains(&name.as_str()))
+            );
+            drop(connection);
+        }
+
+        assert!(action_succeeded(&path, game_id, "reset_winners").unwrap());
+        let connection = open_database(&path).unwrap();
+        let winner_count: i64 = connection
+            .query_row(
+                "SELECT COUNT(*) FROM players WHERE game_id = ?1 AND is_winner = 1",
+                [game_id],
+                |row| row.get(0),
+            )
+            .unwrap();
+        assert_eq!(winner_count, 0);
+        connection
+            .execute(
+                "UPDATE games SET number_of_winners = 8 WHERE id = ?1",
+                [game_id],
+            )
+            .unwrap();
+        drop(connection);
+
+        // There are only five positive scorers, so an eight-prize draw selects all five,
+        // and the zero-point player is never made a winner.
+        assert!(action_succeeded(&path, game_id, "draw").unwrap());
+        let connection = open_database(&path).unwrap();
+        let winner_names = connection
+            .prepare("SELECT name FROM players WHERE game_id = ?1 AND is_winner = 1 ORDER BY name")
+            .unwrap()
+            .query_map([game_id], |row| row.get::<_, String>(0))
+            .unwrap()
+            .collect::<rusqlite::Result<Vec<_>>>()
+            .unwrap();
+        assert_eq!(
+            winner_names,
+            ["Anchor", "Changer", "Middle", "Slow", "Swift"]
+        );
+        drop(connection);
+
+        // The game is found by its join code; fetch it rather than trusting an arbitrary code.
+        let connection = open_database(&path).unwrap();
+        let code: String = connection
+            .query_row("SELECT code FROM games WHERE id = ?1", [game_id], |row| {
+                row.get(0)
+            })
+            .unwrap();
+        drop(connection);
+        let winner_state = load_player_state(&path, &code, "token-Anchor")
+            .unwrap()
+            .unwrap();
+        assert_eq!(winner_state.place, Some(1));
+        assert_eq!(winner_state.player_count, Some(6));
+        assert_eq!(winner_state.points, Some(3));
+        assert_eq!(winner_state.is_winner, Some(true));
+        let phone_html = render_player_state_html(&winner_state);
+        assert!(phone_html.contains("Place 1 of 6"));
+        assert!(phone_html.contains("3 points"));
+        assert!(phone_html.contains("You won!"));
+        remove_database(&path);
+    }
+
+    #[test]
+    fn starting_a_quiz_without_active_questions_creates_no_game() {
+        let path = temporary_database_path();
+        super::super::initialize_database(&path).unwrap();
+        let connection = open_database(&path).unwrap();
+        connection
+            .execute("INSERT INTO quizzes(title) VALUES ('Inactive quiz')", [])
+            .unwrap();
+        let quiz_id = connection.last_insert_rowid();
+        connection
+            .execute(
+                "INSERT INTO questions(quiz_id, body, active, position) VALUES (?1, 'Off', 0, 0)",
+                [quiz_id],
+            )
+            .unwrap();
+        drop(connection);
+
+        assert!(create_game(&path, quiz_id).unwrap().is_none());
+        let count: i64 = open_database(&path)
+            .unwrap()
+            .query_row("SELECT COUNT(*) FROM games", [], |row| row.get(0))
+            .unwrap();
+        assert_eq!(count, 0);
+        remove_database(&path);
+    }
+}
