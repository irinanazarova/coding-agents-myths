+    let mut draw_form = game_action_form(&state.csrf_token, "draw", "Draw", Some("draw-button"));
+    draw_form = draw_form.replace("{GAME_ID}", &game_id.to_string());
+    let mut reset_form = game_action_form(
+        &state.csrf_token,
+        "reset_winners",
+        "Reset winners",
+        Some("reset-winners-button"),
+    );
+    reset_form = reset_form.replace("{GAME_ID}", &game_id.to_string());
+    let body = format!(
+        "<div class=\"game-screen\" id=\"game-screen\" data-game-id=\"{game_id}\">
+          <section id=\"waiting-stage\" class=\"game-stage\"{}>
+            <h1 id=\"screen-title\">{}</h1>
+            <p class=\"game-kicker\">Join at</p><p id=\"join-link\" class=\"join-link\">{join_link}</p>
