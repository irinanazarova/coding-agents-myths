+fn random_below(upper: usize) -> std::io::Result<usize> {
+    let modulus =
+        u64::try_from(upper).map_err(|_| std::io::Error::other("random range is too large"))?;
+    if modulus == 0 {
+        return Err(std::io::Error::other("random range must not be zero"));
+    }
+    let threshold = modulus.wrapping_neg() % modulus;
+    loop {
+        let bytes = secure_random_bytes(8)?;
+        let value = u64::from_ne_bytes(bytes.try_into().expect("eight random bytes"));
+        if value >= threshold {
+            return usize::try_from(value % modulus)
+                .map_err(|_| std::io::Error::other("random index is out of range"));
+        }
+    }
+}
+
+fn shuffle_player_ids(ids: &mut [i64]) -> rusqlite::Result<()> {
+    for index in (1..ids.len()).rev() {
+        let swap_with = random_below(index + 1).map_err(|_| rusqlite::Error::InvalidQuery)?;
+        ids.swap(index, swap_with);
+    }
+    Ok(())
+}
+
+fn set_winners(path: &FsPath, game_id: i64, action: &str) -> rusqlite::Result<bool> {
+    let mut connection = open_database(path)?;
+    let transaction = connection.transaction()?;
+    let game: Option<(String, i64)> = transaction
+        .query_row(
+            "SELECT status, number_of_winners FROM games WHERE id = ?1",
+            [game_id],
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .optional()?;
+    let Some((status, number_of_winners)) = game else {
+        return Ok(false);
+    };
+    if status != "over" {
+        return Ok(false);
+    }
+
+    let ranked = ranked_players(&transaction, game_id)?;
+    let positive = ranked
+        .iter()
+        .filter(|player| player.points > 0)
+        .collect::<Vec<_>>();
+    let winner_ids = match action {
+        "reset_winners" => Vec::new(),
+        "top" => {
+            let count = positive
+                .len()
+                .min(usize::try_from(number_of_winners).unwrap_or(usize::MAX));
+            positive
+                .iter()
+                .take(count)
+                .map(|player| player.id)
+                .collect()
+        }
+        "draw" => {
+            let count = positive
+                .len()
+                .min(usize::try_from(number_of_winners).unwrap_or(usize::MAX));
+            if positive.len() <= count {
+                positive.iter().map(|player| player.id).collect()
+            } else {
+                // All scores above the Nth score win. Speed orders the leaderboard,
+                // but players tied on the cutoff score share a random prize draw.
+                let cutoff = positive[count - 1].points;
+                let mut winners = positive
+                    .iter()
+                    .filter(|player| player.points > cutoff)
+                    .map(|player| player.id)
+                    .collect::<Vec<_>>();
+                let prizes_left = count - winners.len();
+                let mut tied = positive
+                    .iter()
+                    .filter(|player| player.points == cutoff)
+                    .map(|player| player.id)
+                    .collect::<Vec<_>>();
+                shuffle_player_ids(&mut tied)?;
+                winners.extend(tied.into_iter().take(prizes_left));
+                winners
+            }
+        }
+        _ => return Ok(false),
+    };
+
+    transaction.execute(
+        "UPDATE players SET is_winner = 0 WHERE game_id = ?1",
+        [game_id],
+    )?;
+    for player_id in winner_ids {
+        transaction.execute(
+            "UPDATE players SET is_winner = 1 WHERE id = ?1 AND game_id = ?2",
+            params![player_id, game_id],
+        )?;
+    }
+    transaction.commit()?;
+    Ok(true)
+}
+
+fn action_succeeded(path: &FsPath, game_id: i64, action: &str) -> rusqlite::Result<bool> {
+    if matches!(action, "top" | "draw" | "reset_winners") {
+        return set_winners(path, game_id, action);
+    }
+
+    let mut connection = open_database(path)?;
+    match action {
+        "start" => {
+            let transaction = connection.transaction()?;
+            let changed = transaction.execute(
+                "UPDATE games SET status = 'open', current_position = 0
+                 WHERE id = ?1 AND status = 'waiting'
+                   AND EXISTS(SELECT 1 FROM game_questions WHERE game_id = ?1 AND position = 0)",
+                [game_id],
+            )?;
+            if changed != 1 {
+                return Ok(false);
+            }
+            let opened = transaction.execute(
+                "UPDATE game_questions SET opened_at_ms = ?2
+                 WHERE game_id = ?1 AND position = 0
+                   AND EXISTS(SELECT 1 FROM games WHERE id = ?1 AND status = 'open')",
+                params![game_id, now_ms()],
+            )?;
+            if opened != 1 {
+                return Ok(false);
+            }
+            transaction.commit()?;
+            Ok(true)
+        }
+        "finish" => Ok(connection.execute(
+            "UPDATE games SET status = 'closed' WHERE id = ?1 AND status = 'open'",
+            [game_id],
+        )? == 1),
+        "next" => {
+            let transaction = connection.transaction()?;
+            let row: Option<(String, i64, i64)> = transaction
+                .query_row(
+                    "SELECT status, current_position,
+                            (SELECT COUNT(*) FROM game_questions WHERE game_id = games.id)
+                     FROM games WHERE id = ?1",
+                    [game_id],
+                    |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+                )
+                .optional()?;
+            let Some((status, position, total)) = row else {
+                return Ok(false);
+            };
+            if status != "closed" || total == 0 {
+                return Ok(false);
+            }
+            if position + 1 < total {
+                let opened = transaction.execute(
+                    "UPDATE game_questions SET opened_at_ms = ?3
+                     WHERE game_id = ?1 AND position = ?2",
+                    params![game_id, position + 1, now_ms()],
+                )?;
+                if opened != 1 {
+                    return Ok(false);
+                }
+                let changed = transaction.execute(
+                    "UPDATE games SET status = 'open', current_position = ?2
+                     WHERE id = ?1 AND status = 'closed' AND current_position = ?3",
+                    params![game_id, position + 1, position],
+                )?;
+                if changed != 1 {
+                    return Ok(false);
+                }
+            } else {
+                let changed = transaction.execute(
+                    "UPDATE games SET status = 'over'
+                     WHERE id = ?1 AND status = 'closed' AND current_position = ?2",
+                    params![game_id, position],
+                )?;
+                if changed != 1 {
+                    return Ok(false);
+                }
+            }
+            transaction.commit()?;
+            Ok(true)
+        }
+        _ => Ok(false),
+    }
+}
+
+pub(super) async fn moderator_game_action(
+    State(state): State<AppState>,
+    Path(game_id): Path<i64>,
+    Form(form): Form<GameActionForm>,
