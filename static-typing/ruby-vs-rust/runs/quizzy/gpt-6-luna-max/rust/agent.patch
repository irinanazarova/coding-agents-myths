+pub(super) async fn start_game(
+    State(state): State<AppState>,
+    Path(quiz_id): Path<i64>,
+    Form(form): Form<CsrfForm>,
+) -> Response {
+    if !super::csrf_valid(&state, &form.csrf) {
+        return csrf_error();
+    }
+    match create_game(&state.db_path, quiz_id) {
+        Ok(Some(game_id)) => Redirect::to(&format!("/moderate/games/{game_id}")).into_response(),
+        Ok(None) => {
