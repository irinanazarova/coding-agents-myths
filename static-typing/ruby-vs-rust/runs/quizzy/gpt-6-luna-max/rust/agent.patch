+    )?;
+    ensure_column(
+        &connection,
+        "quizzes",
+        "timer_minutes",
+        "INTEGER NOT NULL DEFAULT 0 CHECK(timer_minutes >= 0)",
+    )?;
+    ensure_column(
+        &connection,
+        "quizzes",
+        "timer_seconds",
+        "INTEGER NOT NULL DEFAULT 0 CHECK(timer_seconds >= 0 AND timer_seconds < 60)",
+    )?;
+    ensure_column(
+        &connection,
+        "games",
+        "number_of_winners",
+        "INTEGER NOT NULL DEFAULT 3 CHECK(number_of_winners >= 1)",
+    )?;
+    ensure_column(
+        &connection,
+        "games",
+        "timer_duration_ms",
+        "INTEGER NOT NULL DEFAULT 0 CHECK(timer_duration_ms >= 0)",
+    )?;
+    ensure_column(&connection, "game_questions", "opened_at_ms", "INTEGER")?;
+    ensure_column(
+        &connection,
+        "players",
+        "is_winner",
+        "INTEGER NOT NULL DEFAULT 0 CHECK(is_winner IN (0, 1))",
+    )?;
+    ensure_column(
+        &connection,
+        "answers",
+        "answered_at_ms",
+        "INTEGER NOT NULL DEFAULT 0",
+    )?;
+    connection.execute_batch(
+        "CREATE INDEX IF NOT EXISTS games_open_timer
+         ON games(status, timer_duration_ms)
+         WHERE status = 'open' AND timer_duration_ms > 0;",
+    )?;
+    Ok(())
+}
+
+fn ensure_column(
+    connection: &Connection,
+    table: &str,
+    column: &str,
+    definition: &str,
+) -> rusqlite::Result<()> {
+    let mut statement = connection.prepare(&format!("PRAGMA table_info({table})"))?;
+    let mut rows = statement.query([])?;
+    while let Some(row) = rows.next()? {
+        let name: String = row.get(1)?;
+        if name == column {
+            return Ok(());
+        }
+    }
+    connection.execute_batch(&format!(
+        "ALTER TABLE {table} ADD COLUMN {column} {definition}"
+    ))?;
+    Ok(())
+}
+
+fn load_quiz_summaries(path: &FsPath) -> rusqlite::Result<Vec<QuizSummary>> {
+    let connection = open_database(path)?;
+    let mut statement = connection.prepare(
+        "SELECT q.id, q.title, COUNT(question.id),
+                COALESCE(SUM(CASE WHEN question.active = 1 THEN 1 ELSE 0 END), 0)
+         FROM quizzes q LEFT JOIN questions question ON question.quiz_id = q.id
+         GROUP BY q.id, q.title ORDER BY q.created_at DESC, q.id DESC",
+    )?;
+    statement
+        .query_map([], |row| {
+            Ok(QuizSummary {
+                id: row.get(0)?,
+                title: row.get(1)?,
+                total: row.get(2)?,
+                active: row.get(3)?,
+            })
+        })?
+        .collect()
+}
+
+fn load_quiz(path: &FsPath, quiz_id: i64) -> rusqlite::Result<Option<Quiz>> {
+    let connection = open_database(path)?;
+    let quiz = connection
+        .query_row(
+            "SELECT id, title, number_of_winners, timer_minutes, timer_seconds
+             FROM quizzes WHERE id = ?1",
+            [quiz_id],
+            |row| {
+                Ok(Quiz {
+                    id: row.get(0)?,
+                    title: row.get(1)?,
+                    number_of_winners: row.get(2)?,
+                    timer_minutes: row.get(3)?,
+                    timer_seconds: row.get(4)?,
+                    questions: Vec::new(),
+                })
+            },
+        )
+        .optional()?;
+    let Some(mut quiz) = quiz else {
+        return Ok(None);
+    };
+
+    let mut statement = connection.prepare(
+        "SELECT id, body, active, position FROM questions
+         WHERE quiz_id = ?1 ORDER BY position, id",
+    )?;
+    let questions = statement
+        .query_map([quiz_id], |row| {
+            Ok(Question {
+                id: row.get(0)?,
+                body: row.get(1)?,
+                active: row.get::<_, i64>(2)? != 0,
+                options: Vec::new(),
+            })
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    drop(statement);
+
+    for mut question in questions {
+        let mut option_statement = connection.prepare(
+            "SELECT body, is_correct FROM options
+             WHERE question_id = ?1 ORDER BY position, id",
+        )?;
+        question.options = option_statement
+            .query_map([question.id], |row| {
+                Ok(OptionItem {
+                    body: row.get(0)?,
+                    correct: row.get::<_, i64>(1)? != 0,
+                })
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        quiz.questions.push(question);
+    }
+    Ok(Some(quiz))
+}
