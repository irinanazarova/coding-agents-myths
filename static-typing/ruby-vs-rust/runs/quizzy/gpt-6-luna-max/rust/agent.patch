+fn game_action_form(csrf: &str, action: &str, label: &str, button_id: Option<&str>) -> String {
+    let id = button_id
+        .map(|value| format!(" id=\"{value}\""))
+        .unwrap_or_default();
+    format!(
+        "<form class=\"game-action\" method=\"post\" action=\"/moderate/games/{{GAME_ID}}/action\"><input type=\"hidden\" name=\"csrf\" value=\"{}\"><input class=\"game-action-name\" type=\"hidden\" name=\"action\" value=\"{action}\"><button class=\"btn btn--pink btn--lg\" type=\"submit\"{id}>{label}</button></form>",
+        escape_html(csrf)
+    )
+}
