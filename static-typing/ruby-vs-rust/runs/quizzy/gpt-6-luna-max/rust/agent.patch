+fn find_player(
+    path: &FsPath,
+    game_id: i64,
+    token: &str,
+) -> rusqlite::Result<Option<(i64, String)>> {
+    let connection = open_database(path)?;
+    connection
+        .query_row(
+            "SELECT id, name FROM players WHERE game_id = ?1 AND token = ?2",
+            params![game_id, token],
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .optional()
+}
+
+fn load_player_state(
+    path: &FsPath,
+    code: &str,
+    token: &str,
+) -> rusqlite::Result<Option<PlayerGameState>> {
+    let connection = open_database(path)?;
+    let game: Option<(i64, String, i64, String)> = connection
+        .query_row(
+            "SELECT id, status, current_position, quiz_title FROM games WHERE code = ?1",
+            [code],
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+        )
+        .optional()?;
+    let Some((game_id, status, current_position, _title)) = game else {
+        return Ok(None);
+    };
+    let player: Option<(i64, String)> = connection
+        .query_row(
+            "SELECT id, name FROM players WHERE game_id = ?1 AND token = ?2",
+            params![game_id, token],
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .optional()?;
+    let Some((player_id, player_name)) = player else {
+        return Ok(None);
+    };
+    let question_count: i64 = connection.query_row(
+        "SELECT COUNT(*) FROM game_questions WHERE game_id = ?1",
+        [game_id],
+        |row| row.get(0),
+    )?;
+    let mut state = PlayerGameState {
+        status: status.clone(),
+        player_name,
+        question_number: None,
+        question_count,
+        question: None,
+        selected_option: None,
+        feedback: None,
+        place: None,
+        player_count: None,
+        points: None,
+        is_winner: None,
+    };
+    if status == "over" {
+        let ranked = ranked_players(&connection, game_id)?;
+        state.player_count = Some(ranked.len() as i64);
+        if let Some((index, player)) = ranked
+            .iter()
+            .enumerate()
+            .find(|(_, player)| player.id == player_id)
+        {
+            state.place = Some(index as i64 + 1);
+            state.points = Some(player.points);
+            state.is_winner = Some(player.is_winner);
+        }
+        return Ok(Some(state));
+    }
+    if current_position < 0 {
+        return Ok(Some(state));
+    }
+    state.question_number = Some(current_position + 1);
+    let question: Option<(i64, String)> = connection
+        .query_row(
+            "SELECT id, body FROM game_questions WHERE game_id = ?1 AND position = ?2",
+            params![game_id, current_position],
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .optional()?;
+    let Some((question_id, body)) = question else {
+        return Ok(Some(state));
+    };
+    if status == "open" {
+        let selected: Option<i64> = connection
+            .query_row(
+                "SELECT option_id FROM answers WHERE player_id = ?1 AND game_question_id = ?2",
+                params![player_id, question_id],
+                |row| row.get(0),
+            )
+            .optional()?;
+        let mut statement = connection.prepare(
+            "SELECT id, body FROM game_options WHERE game_question_id = ?1 ORDER BY position, id",
+        )?;
+        let options = statement
+            .query_map([question_id], |row| {
+                Ok(PlayerOption {
+                    id: row.get(0)?,
+                    text: row.get(1)?,
+                })
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        state.selected_option = selected;
+        state.question = Some(PlayerQuestion {
+            id: question_id,
+            text: body,
+            options,
+        });
+    } else if status == "closed" {
+        let correct: Option<bool> = connection
+            .query_row(
+                "SELECT option.is_correct
+                 FROM answers answer
+                 JOIN game_options option
+                   ON option.id = answer.option_id AND option.game_question_id = answer.game_question_id
+                 WHERE answer.player_id = ?1 AND answer.game_question_id = ?2",
+                params![player_id, question_id],
+                |row| row.get::<_, i64>(0).map(|correct| correct != 0),
+            )
+            .optional()?;
+        state.feedback = Some(match correct {
+            None => "No answer".to_owned(),
+            Some(true) => "Correct!".to_owned(),
+            Some(false) => "Wrong!".to_owned(),
+        });
+    }
+    Ok(Some(state))
+}
+
+pub(super) async fn player_game_state(
+    State(state): State<AppState>,
+    Path(raw_code): Path<String>,
+    headers: HeaderMap,
+) -> Response {
+    let Some(code) = canonical_code(&raw_code) else {
+        return (
+            StatusCode::NOT_FOUND,
+            Json(serde_json::json!({"error":"not found"})),
+        )
+            .into_response();
+    };
+    let Some(token) = player_cookie_token(&headers, &code) else {
+        return (
+            StatusCode::UNAUTHORIZED,
+            Json(serde_json::json!({"error":"join first"})),
+        )
+            .into_response();
+    };
+    match load_player_state(&state.db_path, &code, &token) {
+        Ok(Some(game_state)) => json_response(game_state),
+        Ok(None) => (
+            StatusCode::UNAUTHORIZED,
+            Json(serde_json::json!({"error":"join first"})),
+        )
+            .into_response(),
+        Err(error) => internal_error(error),
+    }
+}
