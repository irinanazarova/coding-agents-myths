+            <p id=\"question-progress\" class=\"game-kicker\">Question {question_number} of {}</p>
+            <p id=\"question-timer\" class=\"game-timer\" role=\"timer\" aria-label=\"Time remaining\" aria-live=\"off\"{timer_hidden}>{timer_text}</p>
+            <h1 id=\"open-question\">{question_text}</h1>
+            <ol id=\"open-options\" class=\"game-option-list\">{open_options}</ol>
+            <p id=\"answer-count\" class=\"game-counter\">Answers: {} / {}</p>
+            {finish_form}
+          </section>
+          <section id=\"closed-stage\" class=\"game-stage\"{}>
+            <p id=\"closed-progress\" class=\"game-kicker\">Question {question_number} of {}</p>
+            <h1 id=\"closed-question\">{question_text}</h1>
+            <ol id=\"closed-options\" class=\"game-option-list game-option-list--results\">{closed_options}</ol>
+            {next_form}
