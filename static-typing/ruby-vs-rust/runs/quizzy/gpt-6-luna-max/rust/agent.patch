+    let qr_svg = qr_svg(&game.join_url);
+    let open_options = render_option_list(&game.options, false);
+    let closed_options = render_option_list(&game.options, true);
+    let leaderboard = render_leaderboard(&game.leaderboard);
+    let next_label = if game.question_number.unwrap_or(0) >= game.question_count {
+        "End quiz"
+    } else {
+        "Next"
+    };
+    let timer_text = game.timer_remaining_ms.map(timer_label).unwrap_or_default();
+    let timer_hidden = if game.timer_remaining_ms.is_some() {
+        ""
+    } else {
+        " hidden"
+    };
+    let mut start_form = game_action_form(&state.csrf_token, "start", "Start", None);
