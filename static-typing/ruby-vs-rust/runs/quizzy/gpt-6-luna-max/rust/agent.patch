+fn timer_label(remaining_ms: i64) -> String {
+    let remaining_ms = remaining_ms.max(0);
+    let seconds = remaining_ms / 1_000 + if remaining_ms % 1_000 == 0 { 0 } else { 1 };
+    format!("{}:{:02}", seconds / 60, seconds % 60)
+}
