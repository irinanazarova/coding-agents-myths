+    }
+}
+
+fn compact_question_positions(
+    transaction: &rusqlite::Transaction<'_>,
+    quiz_id: i64,
+) -> rusqlite::Result<()> {
+    let mut statement =
+        transaction.prepare("SELECT id FROM questions WHERE quiz_id = ?1 ORDER BY position, id")?;
+    let ids = statement
+        .query_map([quiz_id], |row| row.get::<_, i64>(0))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    drop(statement);
+    for (position, id) in ids.iter().enumerate() {
+        transaction.execute(
+            "UPDATE questions SET position = ?1 WHERE id = ?2",
+            params![position as i64, id],
+        )?;
+    }
+    Ok(())
+}
