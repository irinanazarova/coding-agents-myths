+++ b/src/contents.rs
@@ -0,0 +1,284 @@
+//! Portable quiz contents, deliberately separate from database rows/IDs.
+use crate::{
+    db::{self, OptionRow, Question},
+    questions::{normalize_question, validate_question},
+};
+use rusqlite::{Connection, params};
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Deserialize, Serialize)]
+pub struct QuizContents {
+    title: String,
+    questions: Vec<QuestionContents>,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+struct QuestionContents {
+    text: String,
+    #[serde(default = "default_active")]
+    active: bool,
+    options: Vec<OptionContents>,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+struct OptionContents {
+    text: String,
+    #[serde(default)]
+    correct: bool,
+}
+
+fn default_active() -> bool {
+    true
+}
+
+impl QuizContents {
+    pub fn from_quiz(title: String, questions: Vec<Question>) -> Self {
+        Self {
+            title,
+            questions: questions
+                .into_iter()
+                .map(|q| QuestionContents {
+                    text: q.text,
+                    active: q.active,
+                    options: q
+                        .options
+                        .into_iter()
+                        .map(|o| OptionContents {
+                            text: o.text,
+                            correct: o.correct,
+                        })
+                        .collect(),
+                })
+                .collect(),
+        }
+    }
+}
+
+// Serde's derived struct deserializer also accepts positional arrays. JSON
+// contents must use objects at each level, not that alternate representation.
+fn check_object_shapes(json: &str) -> Result<(), Vec<String>> {
+    let value: serde_json::Value =
+        serde_json::from_str(json).map_err(|error| vec![format!("Invalid Quiz JSON: {error}")])?;
+    if !value.is_object() {
+        return Err(vec!["Invalid Quiz JSON: Quiz must be an object".into()]);
+    }
+    if let Some(questions) = value.get("questions").and_then(serde_json::Value::as_array) {
+        for (index, question) in questions.iter().enumerate() {
+            if !question.is_object() {
+                return Err(vec![format!(
+                    "Invalid Quiz JSON: Question {} must be an object",
+                    index + 1
+                )]);
+            }
+            if let Some(options) = question
+                .get("options")
+                .and_then(serde_json::Value::as_array)
+            {
+                for (option_index, option) in options.iter().enumerate() {
+                    if !option.is_object() {
+                        return Err(vec![format!(
+                            "Invalid Quiz JSON: Question {}, option {} must be an object",
+                            index + 1,
+                            option_index + 1
+                        )]);
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Parse and validate *all* contents before any database writes.
+/// Missing fields/types are JSON errors, except the two optional boolean flags.
+pub fn parse(json: &str) -> Result<(String, Vec<Question>), Vec<String>> {
+    check_object_shapes(json)?;
+    let contents: QuizContents =
+        serde_json::from_str(json).map_err(|error| vec![format!("Invalid Quiz JSON: {error}")])?;
+    let mut messages = Vec::new();
+    if contents.title.trim().is_empty() {
+        messages.push("Title is required".to_owned());
+    }
+    let mut questions: Vec<_> = contents
+        .questions
+        .into_iter()
+        .map(|q| Question {
+            id: 0,
+            text: q.text,
+            active: q.active,
+            options: q
+                .options
+                .into_iter()
+                .map(|o| OptionRow {
+                    text: o.text,
+                    correct: o.correct,
+                })
+                .collect(),
+        })
+        .collect();
+    for (index, question) in questions.iter_mut().enumerate() {
+        for message in validate_question(question) {
+            messages.push(format!("Question {}: {message}", index + 1));
+        }
+        normalize_question(question);
+    }
+    if messages.is_empty() {
+        Ok((contents.title.trim().into(), questions))
+    } else {
+        Err(messages)
+    }
+}
+
+/// Always create a new quiz; roll back every row if any database write fails.
+pub fn insert(db: &mut Connection, title: &str, questions: &[Question]) -> rusqlite::Result<i64> {
+    let tx = db.transaction()?;
+    tx.execute("INSERT INTO quizzes(title) VALUES (?)", [title])?;
+    let id = tx.last_insert_rowid();
+    for (position, q) in questions.iter().enumerate() {
+        tx.execute(
+            "INSERT INTO questions(quiz_id, text, active, position) VALUES (?, ?, ?, ?)",
+            params![id, q.text, q.active, position as i64],
+        )?;
+        db::write_options(&tx, tx.last_insert_rowid(), &q.options)?;
+    }
+    tx.commit()?;
+    Ok(id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::{Value, json};
+
+    fn sample() -> Value {
+        json!({"title": "Quiz", "questions": [
+            {"text": "First", "options": [{"text":"A"}, {"text":"B", "correct":true}]},
+            {"text": "Second", "active":false, "options": [{"text":"C", "correct":true}, {"text":"D"}]}
+        ]})
+    }
+
+    #[test]
+    fn round_trip_has_only_contents_and_explicit_flags() {
+        let (title, questions) = parse(&sample().to_string()).unwrap();
+        let mut db = Connection::open_in_memory().unwrap();
+        db::initialize(&db).unwrap();
+        let id = insert(&mut db, &title, &questions).unwrap();
+        let duplicate = insert(&mut db, &title, &questions).unwrap();
+        assert_ne!(id, duplicate);
+        let exported = serde_json::to_value(QuizContents::from_quiz(
+            db::title(&db, id).unwrap().unwrap(),
+            db::questions(&db, id).unwrap(),
+        ))
+        .unwrap();
+        let mut expected = sample();
+        expected["questions"][0]["active"] = json!(true);
+        expected["questions"][0]["options"][0]["correct"] = json!(false);
+        expected["questions"][1]["options"][1]["correct"] = json!(false);
+        assert_eq!(exported, expected);
+    }
+
+    #[test]
+    fn empty_quiz_is_valid() {
+        let (title, questions) = parse(r#"{"title":" Empty ","questions":[]}"#).unwrap();
+        assert_eq!(title, "Empty");
+        assert!(questions.is_empty());
+    }
+
+    #[test]
+    fn form_normalization_and_multiple_correct_answers() {
+        let input = json!({"title":" Quiz ","questions":[{"text":" Q ","options":[
+            {"text":" ","correct":true}, {"text":" A ","correct":true}, {"text":" B ","correct":true}
+        ]}]});
+        let (title, questions) = parse(&input.to_string()).unwrap();
+        assert_eq!(title, "Quiz");
+        assert_eq!(questions[0].text, "Q");
+        assert_eq!(questions[0].options.len(), 2);
+        assert_eq!(questions[0].options[0].text, "A");
+        assert_eq!(questions[0].options[1].text, "B");
+        assert!(questions[0].options.iter().all(|o| o.correct));
+    }
+
+    #[test]
+    fn errors_identify_question_and_ignore_empty_correct_rows() {
+        let mut input = sample();
+        input["questions"][1]["text"] = json!(" ");
+        input["questions"][1]["options"] = json!([
+            {"text":"A"}, {"text":"B"}, {"text":"  ","correct":true}
+        ]);
+        let errors = parse(&input.to_string()).unwrap_err();
+        assert_eq!(
+            errors,
+            [
+                "Question 2: Question is required",
+                "Question 2: Mark at least one option as correct"
+            ]
+        );
+    }
+
+    #[test]
+    fn rejects_malformed_missing_and_wrongly_typed_fields() {
+        for input in [
+            "",
+            "{",
+            "null",
+            "[]",
+            "{}",
+            r#"{"title":"Q"}"#,
+            r#"{"title":"Q","questions":null}"#,
+            r#"{"title":1,"questions":[]}"#,
+        ] {
+            assert!(parse(input).is_err(), "{input}");
+        }
+        for value in [json!(null), json!("true"), json!(1)] {
+            let mut input = sample();
+            input["questions"][0]["active"] = value.clone();
+            assert!(parse(&input.to_string()).is_err());
+            input = sample();
+            input["questions"][0]["options"][0]["correct"] = value;
+            assert!(parse(&input.to_string()).is_err());
+        }
+        let mut input = sample();
+        input["title"] = json!(" \n ");
+        assert_eq!(
+            parse(&input.to_string()).unwrap_err(),
+            ["Title is required"]
+        );
+        input = sample();
+        input["questions"][1]["options"] = json!([{"text":"Only", "correct":true}]);
+        assert!(
+            parse(&input.to_string())
+                .unwrap_err()
+                .contains(&"Question 2: Add at least two options".into())
+        );
+    }
+
+    #[test]
+    fn objects_cannot_be_replaced_by_positional_arrays() {
+        for input in [
+            json!(["Quiz", []]),
+            json!({"title":"Quiz", "questions":[["Q", true, [{"text":"A", "correct":true}, {"text":"B"}]]]}),
+            json!({"title":"Quiz", "questions":[{"text":"Q", "options":[["A", true], ["B", false]]}]}),
+        ] {
+            assert!(parse(&input.to_string()).is_err(), "{input}");
+        }
+    }
+
+    #[test]
+    fn database_failure_rolls_back_quiz_questions_and_options() {
+        let mut db = Connection::open_in_memory().unwrap();
+        db::initialize(&db).unwrap();
+        db.execute_batch(
+            "CREATE TRIGGER fail_second BEFORE INSERT ON questions WHEN NEW.text = 'Second'
+            BEGIN SELECT RAISE(ABORT, 'test failure'); END;",
+        )
+        .unwrap();
+        let (title, questions) = parse(&sample().to_string()).unwrap();
+        assert!(insert(&mut db, &title, &questions).is_err());
+        for table in ["quizzes", "questions", "options"] {
+            let count: i64 = db
+                .query_row(&format!("SELECT COUNT(*) FROM {table}"), [], |r| r.get(0))
+                .unwrap();
+            assert_eq!(count, 0, "{table} must roll back");
+        }
+    }
+}
