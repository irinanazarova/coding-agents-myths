diff --git a/tests/transfer.py b/tests/transfer.py
new file mode 100644
index 0000000..c882644
--- /dev/null
+++ b/tests/transfer.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""Quiz export/import regression test against a running app (standard library only)."""
+import copy
+import html
+import json
+import re
+from html.parser import HTMLParser
+from smoke import csrf, request
+
+IMPORT = '/moderate/quizzes/import'
+
+class PreParser(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.blocks = []
+        self.inside = False
+    def handle_starttag(self, tag, attrs):
+        if tag == 'pre':
+            self.blocks.append('')
+            self.inside = True
+    def handle_endtag(self, tag):
+        if tag == 'pre': self.inside = False
+    def handle_data(self, data):
+        if self.inside: self.blocks[-1] += data
+
+def exported(path):
+    code, _, body = request(path + '/export')
+    assert code == 200, (code, body)
+    parser = PreParser()
+    parser.feed(body)
+    assert len(parser.blocks) == 1, 'Export must contain exactly one <pre>'
+    return json.loads(parser.blocks[0])
+
+def quiz_paths():
+    return sorted(re.findall(r'class="quiz-tile" href="([^"]+)"', request('/moderate')[2]))
+
+def run():
+    token = csrf(request('/moderate/quizzes/new')[2])
+    paths = []
+    try:
+        code, headers, _ = request('/moderate/quizzes', {'csrf': token, 'title': 'Transfer test <quiz> & café'})
+        assert code == 303
+        path = headers['Location']
+        paths.append(path)
+        for i in range(2):
+            data = {'csrf': token, 'question': f'Question {i + 1} "quoted" </pre><img src=x onerror=alert(1)>',
+                    'option_1': 'First & café', 'option_2': 'Second', 'correct_2': '1'}
+            if i == 0: data['active'] = '1'
+            assert request(path + '/questions', data)[0] == 303
+        assert '>Export</a>' in request(path)[2], 'Quiz page is missing the Export link'
+        original = exported(path)
+        assert set(original) == {'title', 'questions'}
+        for i, question in enumerate(original['questions']):
+            assert set(question) == {'text', 'active', 'options'}
+            assert question['active'] is (i == 0)
+            assert [o['text'] for o in question['options']] == ['First & café', 'Second']
+            assert [o['correct'] for o in question['options']] == [False, True]
+            assert all(set(o) == {'text', 'correct'} for o in question['options'])
+        assert 'Import quiz' in request('/moderate')[2], 'Missing Import quiz button'
+        code, _, form = request(IMPORT)
+        assert code == 200 and 'Quiz JSON' in form and '>Import</button>' in form
+        token = csrf(form)
+        assert request(IMPORT, {'quiz_json': json.dumps(original)})[0] == 403
+        assert request(IMPORT, auth=None)[0] == 401
+        assert request(path + '/export', auth=None)[0] == 401
+        assert request('/moderate/quizzes/999999999/export')[0] == 404
+
+        def import_valid(document):
+            code, headers, body = request(IMPORT, {'csrf': token, 'quiz_json': json.dumps(document)})
+            assert code == 303, (code, body)
+            imported = headers['Location']
+            assert imported not in paths, 'Import must always create a new quiz'
+            paths.append(imported)
+            assert request(imported)[0] == 200
+            return exported(imported)
+
+        assert import_valid(original) == original
+        assert import_valid(original) == original
+        defaults = copy.deepcopy(original)
+        defaults['questions'][0].pop('active')
+        defaults['questions'][0]['options'][0].pop('correct')
+        assert import_valid(defaults) == original
+        assert import_valid({'title': 'Empty transfer quiz', 'questions': []})['questions'] == []
+        normalized = {'title': '  Trimmed  ', 'questions': [{'text': '  Question  ', 'options': [
+            {'text': ' ', 'correct': True}, {'text': ' A ', 'correct': True}, {'text': ' B ', 'correct': True}]}]}
+        assert import_valid(normalized) == {'title': 'Trimmed', 'questions': [{'text': 'Question', 'active': True,
+            'options': [{'text': 'A', 'correct': True}, {'text': 'B', 'correct': True}]}]}
+
+        invalid = ['{', '', 'null', '[]', '{}', '["Array quiz", []]', '{"title":"Wrong"}',
+                   '{"title":"Wrong","questions":null}', '{"title":42,"questions":[]}',
+                   json.dumps({'title': ' \n ', 'questions': []})]
+        for change in [ {'text': ' '}, {'options': []}, {'options': [{'text': 'Only', 'correct': True}]},
+                        {'active': 'true'}, {'active': None}, {'text': 5}, {'options': None},
+                        {'options': [['A', True], ['B', False]]},
+                        {'options': [{'text': 'A'}, {'text': 'B'}]},
+                        {'options': [{'text': 'A'}, {'text': 'B'}, {'text': ' ', 'correct': True}]},
+                        {'options': [{'text': 'A', 'correct': 'false'}, {'text': 'B', 'correct': True}]},
+                        {'options': [{'text': 'A', 'correct': None}, {'text': 'B', 'correct': True}]},
+                        {'options': [{'correct': True}, {'text': 'B'}]} ]:
+            doc = copy.deepcopy(original)
+            doc['title'] = 'Must not be imported'
+            doc['questions'][1].update(change)  # A valid first question must not be saved either.
+            invalid.append(json.dumps(doc))
+        invalid.append(json.dumps({'title': 'Invalid question array', 'questions': [
+            ['Q', True, [{'text': 'A', 'correct': True}, {'text': 'B'}]]
+        ]}))
+        before = quiz_paths()
+        for bad in invalid:
+            code, _, body = request(IMPORT, {'csrf': token, 'quiz_json': bad})
+            assert code == 422 and 'role="alert"' in body, (bad, code, body)
+            assert html.escape(bad, quote=True).replace('&#x27;', '&#39;') in body
+            assert quiz_paths() == before, 'Invalid import changed the list of quizzes'
+        assert exported(path) == original, 'Source quiz must be unchanged'
+    finally:
+        for path in paths:
+            assert request(path + '/delete', {'csrf': token})[0] == 303
+    print('PASS: quiz transfers, exact schema, defaults, ordering, duplicates, validation, authentication')
+
+if __name__ == '__main__': run()
