+#!/usr/bin/env python3
+"""Real-browser transfer tests; uses the existing standard-library CDP driver."""
+import copy
+import json
+import pathlib
+import socket
+import subprocess
+import tempfile
+import time
+import urllib.request
+from browser import CDP
+from smoke import AUTH, csrf, request
+
+
+def run():
+    pathlib.Path('storage').mkdir(exist_ok=True)
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1', 0))
+        port = sock.getsockname()[1]
+    paths = []
+    token = csrf(request('/moderate/quizzes/new')[2])
+    with tempfile.TemporaryDirectory(prefix='transfer-browser-', dir='storage') as profile:
+        with open('storage/transfer-chromium.log', 'w') as log:
+            process = subprocess.Popen(['chromium', '--headless', '--no-sandbox', '--disable-dev-shm-usage',
+                '--disable-background-networking', '--disable-component-update', '--no-first-run',
+                '--no-default-browser-check', f'--remote-debugging-port={port}', f'--user-data-dir={profile}',
+                'about:blank'], stdout=log, stderr=log)
+        try:
+            for _ in range(100):
+                try:
+                    tabs = json.load(urllib.request.urlopen(f'http://127.0.0.1:{port}/json/list'))
+                    if tabs: break
+                except OSError: pass
+                time.sleep(.05)
+            c = CDP(tabs[0]['webSocketDebuggerUrl'])
+            c.command('Page.enable')
+            c.command('Runtime.enable')
+            c.command('Log.enable')
+            c.command('Network.enable')
+            c.command('Network.setExtraHTTPHeaders', {'headers': {'Authorization': AUTH}})
+            c.command('Emulation.setDeviceMetricsOverride', {'width': 1440, 'height': 1000, 'deviceScaleFactor': 1, 'mobile': False})
+            c.navigate('/moderate')
+            c.click('Import quiz')
+            c.wait('document.querySelector("#quiz_json") !== null')
+            assert c.evaluate('document.querySelector("label[for=quiz_json]").textContent') == 'Quiz JSON'
+            c.evaluate('document.querySelector("#quiz_json").value = "{"')
+            c.click('Import')
+            c.wait('document.querySelector("[role=alert]") !== null')
+            assert c.evaluate('document.querySelector("#quiz_json").value') == '{'
+            assert 'Invalid Quiz JSON' in c.evaluate('document.querySelector("[role=alert]").textContent')
+
+            hostile = '</pre></textarea><img src=x onerror="window.quizzyXss=true"> & café "quoted"'
+            doc = {'title': 'Browser transfer <& café>', 'questions': [
+                {'text': hostile, 'active': False, 'options': [{'text': 'A', 'correct': True}, {'text': 'B'}]},
+                {'text': 'Second ' + 'x' * 500, 'options': [{'text': 'C'}, {'text': 'D', 'correct': True}]}
+            ]}
+            c.evaluate(f'document.querySelector("#quiz_json").value = {json.dumps(json.dumps(doc))}')
+            c.click('Import')
+            c.wait(f'document.querySelector("h1")?.textContent === {json.dumps(doc["title"])}')
+            paths.append(c.evaluate('location.pathname'))
+            assert c.evaluate('document.querySelectorAll("li[data-question-id]").length') == 2
+            assert c.evaluate('Array.from(document.querySelectorAll("[name=active]")).map(x=>x.checked)') == [False, True]
+            assert c.evaluate('typeof window.quizzyXss') == 'undefined'
+            assert c.evaluate('document.querySelectorAll(".question-item img").length') == 0
+            c.click('Export')
+            c.wait('document.querySelector("pre") !== null')
+            assert c.evaluate('document.querySelectorAll("pre").length') == 1
+            exported_json = c.evaluate('document.querySelector("pre").textContent')
+            exported = json.loads(exported_json)
+            expected = copy.deepcopy(doc)
+            expected['questions'][0]['options'][1]['correct'] = False
+            expected['questions'][1]['active'] = True
+            expected['questions'][1]['options'][0]['correct'] = False
+            assert exported == expected
+            assert c.evaluate('document.querySelectorAll("pre img,pre script").length') == 0
+            assert c.evaluate('typeof window.quizzyXss') == 'undefined'
+            c.screenshot('export-desktop')
+            c.command('Emulation.setDeviceMetricsOverride', {'width': 390, 'height': 844, 'deviceScaleFactor': 1, 'mobile': True})
+            assert c.evaluate('document.documentElement.scrollWidth <= innerWidth'), 'Export overflows mobile viewport'
+            c.screenshot('export-phone')
+            c.navigate('/moderate')
+            c.click('Import quiz')
+            c.wait('document.querySelector("#quiz_json") !== null')
+            assert c.evaluate('document.documentElement.scrollWidth <= innerWidth'), 'Import overflows mobile viewport'
+            c.evaluate(f'document.querySelector("#quiz_json").value = {json.dumps(exported_json)}')
+            c.screenshot('import-phone')
+            c.click('Import')
+            c.wait(f'document.querySelector("h1")?.textContent === {json.dumps(doc["title"])}')
+            paths.append(c.evaluate('location.pathname'))
+            assert paths[0] != paths[1]
+            c.click('Export')
+            c.wait('document.querySelector("pre") !== null')
+            assert json.loads(c.evaluate('document.querySelector("pre").textContent')) == expected
+            c.navigate('/moderate')
+            count_before = c.evaluate('document.querySelectorAll(".quiz-list > li").length')
+            c.click('Import quiz')
+            c.wait('document.querySelector("#quiz_json") !== null')
+            invalid = copy.deepcopy(doc)
+            invalid['questions'][1]['text'] = ' '
+            text = "\n\n" + json.dumps(invalid)
+            c.evaluate(f'document.querySelector("#quiz_json").value = {json.dumps(text)}')
+            c.click('Import')
+            c.wait('document.querySelector("[role=alert]") !== null')
+            assert 'Question 2: Question is required' in c.evaluate('document.querySelector("[role=alert]").textContent')
+            assert c.evaluate('document.querySelector("#quiz_json").value') == text
+            assert c.evaluate('typeof window.quizzyXss') == 'undefined'
+            assert c.evaluate('document.querySelectorAll(".card img,.card script").length') == 0
+            c.navigate('/moderate')
+            assert c.evaluate('document.querySelectorAll(".quiz-list > li").length') == count_before
+            errors = [e for e in c.errors if '/favicon.ico' not in json.dumps(e) and '422' not in json.dumps(e)]
+            assert not errors, errors
+            print('PASS: Chromium import/export labels, copying, duplicate titles, errors, escaping, mobile layout')
+        finally:
+            process.terminate()
+            process.wait(timeout=10)
+            for path in paths:
+                assert request(path + '/delete', {'csrf': token})[0] == 303
+
+if __name__ == '__main__': run()
