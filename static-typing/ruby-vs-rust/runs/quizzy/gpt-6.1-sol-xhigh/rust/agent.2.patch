@@ -0,0 +1,29 @@
+use crate::db::Question;
+
+pub fn validate_question(q: &Question) -> Vec<&'static str> {
+    let mut messages = vec![];
+    if q.text.trim().is_empty() {
+        messages.push("Question is required");
+    }
+    let options: Vec<_> = q
+        .options
+        .iter()
+        .filter(|o| !o.text.trim().is_empty())
+        .collect();
+    if options.len() < 2 {
+        messages.push("Add at least two options");
+    }
+    if !options.iter().any(|o| o.correct) {
+        messages.push("Mark at least one option as correct");
+    }
+    messages
+}
+
+/// Use the same text/empty-row handling for the form and imported questions.
+pub fn normalize_question(q: &mut Question) {
+    q.text = q.text.trim().into();
+    q.options.retain(|o| !o.text.trim().is_empty());
+    for option in &mut q.options {
+        option.text = option.text.trim().into();
+    }
+}
