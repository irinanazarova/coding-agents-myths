diff --git a/assets/live.js b/assets/live.js
new file mode 100644
index 0000000..3f91c79
--- /dev/null
+++ b/assets/live.js
@@ -0,0 +1,282 @@
+'use strict';
+(() => {
+  const config = JSON.parse(document.getElementById('live-config').textContent);
+  if (!config) return;
+  const moderator = config.role === 'moderator';
+  const content = document.getElementById('live-content');
+  const controls = document.getElementById('live-controls');
+  const counter = document.getElementById('live-counter');
+  const connection = document.getElementById('connection-status');
+  let current = null;
+  let renderedVersion = null;
+  let source = null;
+  let polling = null;
+  let pending = null;
+  let sending = false;
+  let controlBusy = false;
+  let heartbeat = null;
+  let answerRetry = 500;
+  let liveError = document.getElementById('live-error');
+  if (!liveError) {
+    liveError = document.createElement('p');
+    liveError.id = 'live-error';
+    liveError.setAttribute('role', 'alert');
+    liveError.hidden = true;
+    document.querySelector('.screen-controls__info').append(liveError);
+  }
+  function el(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  }
+  function button(text, className, action) {
+    const node = el('button', className, text);
+    node.type = 'button';
+    node.addEventListener('click', action);
+    return node;
+  }
+  function letter(n) {
+    let result = '';
+    do { result = String.fromCharCode(65 + n % 26) + result; n = Math.floor(n / 26) - 1; } while (n >= 0);
+    return result;
+  }
+  function error(message) {
+    liveError.textContent = message;
+    liveError.hidden = !message;
+  }
+  async function fetchWithTimeout(url, options = {}) {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), 8000);
+    try { return await fetch(url, {...options, signal: controller.signal, cache: 'no-store'}); }
+    finally { clearTimeout(timer); }
+  }
+  async function post(suffix, data) {
+    const response = await fetchWithTimeout(config.base + suffix, {
+      method: 'POST', headers: {Accept: 'application/json'},
+      body: new URLSearchParams({csrf: config.csrf, ...data})
+    });
+    if (!response.ok && response.status !== 409) throw new Error('Request failed');
+    return response.status === 204 ? null : await response.json();
+  }
+  function adopt(state) {
+    if (current && state.version < current.version) return;
+    // A poll started before joining must not undo a successful remembered identity.
+    if (!moderator && current?.name && !state.name && state.phase !== 'ended') return;
+    if (current && state.version === current.version && !moderator && state.answer_version < current.answer_version) return;
+    current = state;
+    if (pending && (state.phase !== 'open' || state.question?.id !== pending.question)) { pending = null; error(''); }
+    if (state.phase === 'ended') {
+      source?.close();
+      source = null;
+      clearInterval(polling); polling = null;
+      clearInterval(heartbeat); heartbeat = null;
+      connection.textContent = '';
+      error('');
+    }
+    render();
+  }
+  async function command(action) {
+    if (controlBusy) return;
+    controlBusy = true;
+    render();
+    try { adopt(await post('/control', {action, version: current.version})); error(''); }
+    catch (_) { error('Connection lost. Try again when reconnected.'); refresh(); }
+    finally { controlBusy = false; render(); }
+  }
+  function pick(question, option) {
+    pending = {question, option};
+    render();
+    sendAnswer();
+  }
+  async function sendAnswer() {
+    if (sending || !pending) return;
+    sending = true;
+    const intent = pending;
+    try {
+      const state = await post('/answer', intent);
+      if (pending === intent) pending = null;
+      answerRetry = 500;
+      error('');
+      adopt(state);
+    } catch (_) {
+      if (pending && current.phase === 'open') {
+        error('Connection lost. Retrying your answer…');
+        await new Promise(resolve => setTimeout(resolve, answerRetry + Math.random() * 500));
+        answerRetry = Math.min(answerRetry * 2, 8000);
+      } else { error(''); }
+    } finally {
+      sending = false;
+      if (pending) sendAnswer();
+    }
+  }
+  function render() {
+    const state = current;
+    if (!state) return;
+    // Do not replace a join form while a visitor is typing their name.
+    if (!moderator && !state.name && state.phase !== 'ended' && content.querySelector('.join-form')) return;
+    if (counter) {
+      counter.textContent = state.phase === 'open' ? `Answers: ${state.answers} / ${state.players}` : `Players: ${state.players}`;
+      counter.hidden = state.phase === 'waiting' || state.phase === 'ended';
+    }
+    if (moderator && renderedVersion === state.version) {
+      const lobbyPlayers = content.querySelector('.lobby-players');
+      if (lobbyPlayers) lobbyPlayers.textContent = `Players: ${state.players}`;
+      controls.querySelectorAll('button').forEach(node => { node.disabled = controlBusy; });
+      return;
+    }
+    renderedVersion = state.version;
+    content.replaceChildren();
+    controls?.replaceChildren();
+    if (state.phase === 'ended') {
+      content.append(el('h1', moderator ? 'lobby__title' : 'play-title', 'The quiz is over'));
+      return;
+    }
+    if (moderator && state.phase === 'waiting') {
+      const lobby = el('section', 'lobby');
+      const intro = el('div');
+      intro.append(el('h1', 'lobby__title', state.title), el('p', 'lobby__join', 'Join the quiz on your phone'), el('p', 'lobby__url', config.url));
+      const players = el('p', 'counter-pill lobby-players', `Players: ${state.players}`);
+      players.setAttribute('role', 'status');
+      intro.append(players);
+      if (!state.total) intro.append(el('p', '', 'No active questions. Starting will end this game.'));
+      const qr = el('div', 'qr');
+      const image = el('img');
+      image.src = config.base + '/qr.svg';
+      image.alt = 'QR code for joining the game';
+      qr.append(image);
+      lobby.append(intro, qr);
+      content.append(lobby);
+      const start = button('Start', 'btn btn--sun', () => command('start'));
+      start.disabled = controlBusy;
+      controls.append(start);
+      return;
+    }
+    if (!moderator && !state.name) {
+      content.append(el('h1', 'play-title', state.title), el('p', 'play-lead', 'Join the live quiz'));
+      const form = el('form', 'join-form');
+      form.method = 'post'; form.action = config.base;
+      const label = el('label', '', 'Your name'); label.htmlFor = 'player-name';
+      const input = el('input', 'input');
+      input.id = 'player-name'; input.name = 'name'; input.placeholder = 'Your name';
+      input.setAttribute('aria-label', 'Your name'); input.required = true; input.maxLength = 80; input.autocomplete = 'nickname';
+      const token = el('input'); token.type = 'hidden'; token.name = 'csrf'; token.value = config.csrf;
+      const join = el('button', 'btn btn--pink', 'Join'); join.type = 'submit';
+      form.append(label, input, token, join);
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (join.disabled) return;
+        if (!input.value.trim()) { error('Enter your name.'); input.focus(); return; }
+        join.disabled = true;
+        try {
+          const result = await post('', {name: input.value});
+          config.csrf = result.csrf;
+          error('');
+          adopt(result.state);
+          connect(); startHeartbeat();
+        } catch (_) {
+          error('Could not join. Check your connection and try again.');
+          refresh();
+        } finally { join.disabled = false; }
+      });
+      content.append(form);
+      return;
+    }
+    if (!moderator) content.append(el('p', 'player-greeting', `Hi, ${state.name}!`));
+    if (state.phase === 'waiting') {
+      const waiting = el('div', 'waiting');
+      waiting.append(el('div', 'waiting__gem', '?'), el('h1', 'play-title', state.title), el('p', 'play-lead', 'Waiting for the quiz to start…'));
+      content.append(waiting);
+      return;
+    }
+    const question = state.question;
+    if (!question) return;
+    content.append(el('div', moderator ? 'stage-question__num' : 'play-question__num', `Question ${state.number} of ${state.total}`));
+    content.append(el('h1', moderator ? 'stage-question__body' : 'play-question__body', question.text));
+    const closed = state.phase === 'closed';
+    const options = el('ul', moderator ? 'stage-options' + (closed ? ' stage-options--results' : '') : 'play-options' + (closed ? ' is-locked is-revealed' : ''));
+    const selected = pending?.question === question.id ? pending.option : state.answer;
+    question.options.forEach((option, i) => {
+      const row = el('li', moderator ? 'stage-option' : 'player-option-item');
+      row.dataset.optionId = option.id;
+      const node = moderator ? row : button('', 'play-option', () => pick(question.id, option.id));
+      if (!moderator) node.setAttribute('aria-label', option.text);
+      const prefix = moderator ? 'stage-option' : 'play-option';
+      node.append(el('span', prefix + '__letter', letter(i)), el('span', prefix + '__title', option.text));
+      if (!moderator) {
+        node.disabled = closed;
+        node.setAttribute('aria-pressed', String(selected === option.id));
+        if (selected === option.id) {
+          node.classList.add('is-picked');
+          node.append(el('span', 'play-option__mark', 'Your answer'));
+        }
+        row.append(node);
+      }
+      if (closed && option.correct) {
+        node.classList.add('is-correct');
+        if (moderator) node.append(el('span', 'correct-label', 'Correct'));
+      }
+      if (moderator && closed) {
+        const count = el('span', 'stage-option__count', String(option.count));
+        count.setAttribute('aria-label', `${option.count} answers`);
+        node.append(count);
+      }
+      options.append(row);
+    });
+    content.append(options);
+    if (moderator) {
+      const action = closed ? (state.number === state.total ? 'end' : 'next') : 'finish';
+      const text = closed ? (state.number === state.total ? 'End quiz' : 'Next') : 'Finish';
+      const control = button(text, 'btn btn--sun', () => command(action));
+      control.disabled = controlBusy;
+      controls.append(control);
+    } else if (closed) {
+      const result = el('p', 'play-status ' + (state.result === 'Correct!' ? 'play-status--right' : state.result === 'Wrong!' ? 'play-status--wrong' : 'play-status--neutral'), state.result);
+      result.setAttribute('role', 'status');
+      content.append(result, el('p', 'meta waiting-next', 'Waiting for the next question…'));
+    } else {
+      content.append(el('p', 'meta answer-hint', pending ? 'Sending your answer…' : 'Tap an option. You can change your answer until the question closes.'));
+    }
+  }
+  async function refresh() {
+    if (current?.phase === 'ended') return;
+    try {
+      const response = await fetchWithTimeout(config.base + '/state');
+      if (response.ok) adopt(await response.json());
+    } catch (_) { /* EventSource and the fallback retry without interrupting the game. */ }
+  }
+  function connect() {
+    source?.close();
+    if (current?.phase === 'ended') return;
+    connection.textContent = 'Connecting…';
+    source = new EventSource(config.base + '/events');
+    source.addEventListener('state', event => adopt(JSON.parse(event.data)));
+    source.onopen = () => {
+      connection.textContent = 'Live';
+      if (!pending) error('');
+      clearInterval(polling); polling = null;
+    };
+    source.onerror = () => {
+      if (current?.phase === 'ended') return;
+      connection.textContent = 'Reconnecting…';
+      if (!polling) {
+        refresh();
+        polling = setInterval(refresh, 4000 + Math.random() * 2000);
+      }
+    };
+  }
+  function startHeartbeat() {
+    if (moderator || !current?.name || current.phase === 'ended' || heartbeat) return;
+    const beat = () => post('/presence', {}).catch(() => {});
+    beat();
+    heartbeat = setInterval(beat, 10000 + Math.random() * 1500);
+  }
+  document.addEventListener('visibilitychange', () => {
+    if (!document.hidden) { refresh(); if (current?.name && current.phase !== 'ended') post('/presence', {}).catch(() => {}); }
+  });
+  window.addEventListener('online', () => { refresh(); connect(); });
+  window.addEventListener('pagehide', () => source?.close());
+  window.addEventListener('pageshow', event => { if (event.persisted) { connect(); refresh(); } });
+  adopt(config.state);
+  connect(); startHeartbeat();
+})();
diff --git a/docs/live-games.md b/docs/live-games.md
new file mode 100644
index 0000000..1cbae71
--- /dev/null
+++ b/docs/live-games.md
@@ -0,0 +1,115 @@
+# Live games
+
+## Storage and lifecycle
+
+`src/games.rs` initializes additive SQLite tables alongside the existing quiz
+schema. Every **Start a game** creates a cryptographically random, unambiguous
+join code and a new `games` row. In one transaction it snapshots the quiz title
+and only active questions/options, in their preparation order. Snapshot IDs,
+players, and answers are game-specific. Import/export still transfers only quiz
+contents; it never transfers games or player identities.
+
+The persistent state machine is:
+
+```
+waiting --Start--> open --Finish--> closed --Next--> open …
+                                      └--End quiz--> ended (last question only)
+```
+
+An empty snapshot goes directly from waiting to ended on Start. A version number
+increments with every phase transition. Moderator commands include the version
+rendered in their browser; stale/double requests return 409 with fresh state, not
+another transition. The SQLite mutex serializes Finish with answering, so an
+answer either commits before closure or is rejected. Each (question, player)
+has one answer, updated atomically on a new pick. The phone serializes requests
+and coalesces rapid taps so the last user intent is the last submitted pick.
+A per-answer revision prevents a delayed response from undoing newer UI state.
+
+Quiz editing cannot affect a snapshot. Deleting a preparation quiz unlinks, but
+does not destroy, its games. Game state, names, identity tokens, and answers
+survive restarts. The transient presence cache is rebuilt as phones reconnect.
+The quiz page lists its games, newest first, with an Open game link in each item.
+
+## Routes and authorization
+
+- `POST /moderate/quizzes/{id}/games`: create and redirect to the big screen.
+- `/moderate/games/{code}`: big screen; `/state`, `/events`, `/control`, and
+  `/qr.svg` below it are also protected by the existing Basic auth middleware.
+- `GET /play/{code}`: public join/phone page. POST joins (JSON for the JS client,
+  or a redirect for an ordinary form). `/state` and `/events` below it provide
+  role-filtered state; `/answer` and `/presence` accept player POSTs.
+
+Joining installs a random 256-bit identity cookie, HttpOnly, SameSite=Lax, scoped
+only to `/play/{code}`, with a one-year lifetime. Tokens are scoped again by game
+in every database lookup. A second tab or reopening the join URL restores that
+player; a cookie from another game is not accepted. Mutations require HMAC CSRF
+tokens tied to the game and identity. Joining after end creates no player.
+
+Player and moderator JSON use dedicated view types, never serialization of the
+quiz preparation structs. Open questions contain option ID/text only: no
+`correct`, `count`, `result`, future question, or answer-key fields. Closed
+questions add correctness, and moderator views add historical per-option counts.
+Players receive only their own name/selection/result and cannot read anyone
+else's answers. Anonymous visitors only receive the join/end state. All state
+and game HTML is no-store. Host names are unrestricted; the HTTP join URL and
+QR payload are constructed from the same request Host. QR SVG generation is
+local (`qrcode` crate), with no web service or remote resources.
+
+## Live transport and crowded Wi-Fi
+
+Each browser has one EventSource connection, with 15-second transport keepalive
+comments. Each game has separate watch channels for moderator updates, phase
+updates shared by phones, and each player's personal answer updates. An answer
+notifies the moderator and that player only, not every phone: no quadratic
+answer fan-out. Watch channels coalesce bursts and never accumulate an unbounded
+queue for a slow phone. A fresh, role-filtered snapshot is read after subscribing
+and on every notification, so reconnects need no historical event replay.
+
+The lobby updates its counter without regenerating the QR image. Open moderator
+queries read answer counts only for active players; open phone snapshots avoid
+result aggregation entirely. Option indexes support closed-result queries.
+Client state is rendered using DOM textContent, not user-supplied innerHTML.
+
+Presence is per player, not per tab. Phones renew a 35-second activity lease every
+10–11.5 seconds with jitter; an SSE attachment also renews it. After the last
+connection closes, an 8-second grace period avoids counter flicker during quick
+Wi-Fi reconnects. A two-second reaper notifies moderators about expiry. Silently
+unreachable sockets expire via their heartbeat lease. Only active players and
+their submitted answers enter the open `Answers: n / m` counter; final option
+counts retain all submitted answers, even from players who left.
+
+EventSource automatically retries after two seconds and always receives current
+state. During a stream error, jittered 4–6-second polling provides a fallback;
+polling stops when SSE reconnects. HTTP requests have timeouts. Pending answers
+retry with jitter/backoff while their question remains open; stale/closed picks
+are rejected on the server. Visibility/online events refresh state. End stops
+stream reconnection, heartbeat, and polling. SIGTERM/Ctrl-C broadcasts a stop
+signal to streams before Axum drains connections, permitting prompt restarts.
+
+## Verification
+
+All crates were fetched and both debug/test and release builds verified offline.
+Run the existing CRUD/import/export suites too; the preparation app is preserved.
+
+```
+cargo test --offline --locked
+cargo clippy --offline --locked --all-targets -- -D warnings
+python3 tests/live.py
+python3 tests/live_browser.py
+python3 tests/live_persistence.py setup
+# Optional: leave a real SSE reader attached to test graceful shutdown:
+python3 tests/live_persistence.py watch
+# Stop and restart bin/serve with the same environment/storage, then:
+python3 tests/live_persistence.py verify
+```
+
+HTTP/SSE tests cover repeated games, authentication, CSRF, correctness embargo,
+multiple correct options, active/inactive ordering, changed/stale/closed answers,
+late joins, end, empty snapshots, and quiz deletion independence. Chromium tests
+use separate cookie contexts for phones, mobile/desktop dimensions, and exercise
+rapid picks, multi-tab identity, disconnect/rejoin counters, Wi-Fi recovery,
+source filtering, no live reloads, results, end restrictions, and safe name text.
+Restart tests preserve an open question, player cookie, and answer across a real
+server restart. Rust tests additionally check scoped notification fan-out and
+presence expiry/grace deterministically. Test fixtures/logs/screenshots live in
+ignored `storage/`; test cleanup uses SQLite directly only for its own games.
