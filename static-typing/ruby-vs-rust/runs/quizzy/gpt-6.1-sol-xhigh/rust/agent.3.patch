diff --git a/tests/live.py b/tests/live.py
new file mode 100644
index 0000000..9dcf503
--- /dev/null
+++ b/tests/live.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""HTTP + real SSE regression for live games. Creates isolated fixtures."""
+import json, re, urllib.request, time
+from smoke import request, csrf, BASE, AUTH
+
+
+def config(html):
+    return json.loads(re.search(r'<script id="live-config" type="application/json">(.*?)</script>', html, re.S).group(1))
+
+
+class Player:
+    def __init__(self, code):
+        self.path = '/play/' + code
+        self.cookie = None
+        self.token = config(self.req('')[2])['csrf']
+
+    def req(self, suffix, data=None, extra=None):
+        headers = {'Cookie': self.cookie} if self.cookie else {}
+        headers.update(extra or {})
+        return request(self.path + suffix, data, auth=None, extra_headers=headers)
+
+    def join(self, name):
+        code, headers, body = self.req('', {'csrf': self.token, 'name': name}, {'Accept': 'application/json'})
+        assert code == 200, (code, body)
+        if headers.get('Set-Cookie'): self.cookie = headers['Set-Cookie'].split(';')[0]
+        result = json.loads(body)
+        self.token = result['csrf']
+        return result['state']
+
+    def state(self):
+        return json.loads(self.req('/state')[2])
+
+    def answer(self, question, option):
+        return self.req('/answer', {'csrf': self.token, 'question': question, 'option': option})
+
+
+class Events:
+    def __init__(self, path, auth=None, cookie=None):
+        headers = {}
+        if auth: headers['Authorization'] = auth
+        if cookie: headers['Cookie'] = cookie
+        self.response = urllib.request.urlopen(urllib.request.Request(BASE + path, headers=headers), timeout=8)
+        assert self.response.headers['Content-Type'].startswith('text/event-stream')
+
+    def next(self):
+        while True:
+            raw = self.response.readline()
+            if not raw: raise EOFError('SSE stream ended before the expected event')
+            line = raw.decode().strip()
+            if line.startswith('data: '): return json.loads(line[6:])
+            if not line: continue
+
+    def until(self, condition):
+        for _ in range(30):
+            state = self.next()
+            if condition(state): return state
+        raise AssertionError('Expected SSE state was not delivered')
+
+    def close(self):
+        self.response.close()
+
+
+def run():
+    token = csrf(request('/moderate/quizzes/new')[2])
+    code, headers, _ = request('/moderate/quizzes', {'csrf': token, 'title': 'Live <regression>'})
+    assert code == 303
+    quiz = headers['Location']
+    games = []
+    streams = []
+    try:
+        assert 'Start a game' in request(quiz)[2], 'Missing Start a game on the quiz page'
+        for i in range(4):
+            data = {'csrf': token, 'question': f'Question text {i}', 'option_1': f'Alpha {i}', 'option_2': f'Beta {i}', 'option_3': f'Gamma {i}', 'correct_1': '1', 'correct_3': '1'}
+            if i != 1: data['active'] = '1'
+            assert request(quiz + '/questions', data)[0] == 303
+        def new_game():
+            status, headers, _ = request(quiz + '/games', {'csrf': token})
+            assert status == 303
+            path = headers['Location']; games.append(path)
+            return path
+        path = new_game()
+        code = path.split('/')[-1]
+        assert request(path, auth=None)[0] == 401
+        assert request(path + '/state', auth=None)[0] == 401
+        assert request(path + '/events', auth=None)[0] == 401
+        assert request(path + '/control', {'action': 'start'}, auth=None)[0] == 401
+        assert request(path + '/control', {'action': 'start', 'version': 0})[0] == 403
+        html = request(path, extra_headers={'Host': 'talk.example:3000'})[2]
+        boot = config(html)
+        assert boot['url'] == f'http://talk.example:3000/play/{code}'
+        assert boot['state']['players'] == 0 and boot['state']['total'] == 3
+        status, headers, svg = request(path + '/qr.svg', extra_headers={'Host': 'talk.example:3000'})
+        assert status == 200 and headers['Content-Type'] == 'image/svg+xml' and '<svg' in svg and '<path' in svg
+        alice, bob = Player(code), Player(code)
+        assert alice.join('Alice')['name'] == 'Alice'
+        assert bob.join('Bob')['name'] == 'Bob'
+        assert alice.join('Another name')['name'] == 'Alice', 'Rejoining must not duplicate a remembered player'
+        assert config(alice.req('')[2])['state']['name'] == 'Alice'
+        mod = Events(path + '/events', AUTH); streams.append(mod)
+        a_events = Events(alice.path + '/events', cookie=alice.cookie); streams.append(a_events)
+        b_events = Events(bob.path + '/events', cookie=bob.cookie); streams.append(b_events)
+        assert mod.next()['players'] == 2
+        assert a_events.next()['phase'] == 'waiting'
+        assert b_events.next()['phase'] == 'waiting'
+        def control(action, expected=None):
+            before = json.loads(request(path + '/state')[2])
+            status, _, body = request(path + '/control', {'csrf': token, 'action': action, 'version': before['version'] if expected is None else expected})
+            return status, json.loads(body)
+        status, open_state = control('start')
+        assert status == 200 and open_state['number'] == 1 and open_state['total'] == 3
+        assert mod.until(lambda s: s['phase'] == 'open')['answers'] == 0
+        assert a_events.until(lambda s: s['phase'] == 'open')['question']['text'] == 'Question text 0'
+        assert b_events.until(lambda s: s['phase'] == 'open')['question']['text'] == 'Question text 0'
+        assert control('start', 0)[0] == 409
+        q = alice.state()['question']; options = q['options']
+        for player in [alice, bob]:
+            state = player.state()
+            assert all('correct' not in o and 'count' not in o for o in state['question']['options'])
+            assert 'result' not in state and 'players' not in state
+            source = player.req('')[2]
+            assert '"correct"' not in source and '"result"' not in source
+        assert alice.req('/answer', {'question': q['id'], 'option': options[0]['id']})[0] == 403
+        assert Player(code).answer(q['id'], options[0]['id'])[0] == 403
+        assert alice.answer(q['id'], options[0]['id'])[0] == 200
+        assert mod.until(lambda s: s['answers'] == 1)['players'] == 2
+        assert a_events.until(lambda s: s.get('answer') == options[0]['id'])['phase'] == 'open'
+        assert alice.answer(q['id'], options[2]['id'])[0] == 200
+        assert json.loads(request(path + '/state')[2])['answers'] == 1
+        assert bob.answer(q['id'], options[1]['id'])[0] == 200
+        assert control('next')[0] == 409, 'Cannot advance an open question'
+        status, closed = control('finish')
+        assert status == 200
+        assert [o['count'] for o in closed['question']['options']] == [0, 1, 1]
+        assert [o['correct'] for o in closed['question']['options']] == [True, False, True]
+        assert a_events.until(lambda s: s['phase'] == 'closed')['result'] == 'Correct!'
+        assert b_events.until(lambda s: s['phase'] == 'closed')['result'] == 'Wrong!'
+        assert alice.answer(q['id'], options[1]['id'])[0] == 409
+        assert alice.state()['answer'] == options[2]['id']
+        charlie = Player(code)
+        assert charlie.join('Charlie')['result'] == 'No answer'
+        status, second = control('next')
+        assert status == 200 and second['number'] == 2
+        assert second['question']['text'] == 'Question text 2', 'Inactive question must be skipped'
+        assert alice.answer(q['id'], options[0]['id'])[0] == 409, 'Stale question must not accept answers'
+        q2 = alice.state()['question']
+        assert alice.answer(q2['id'], options[0]['id'])[0] == 409, 'Option must belong to the current question'
+        dave = Player(code)
+        assert dave.join('Dave')['phase'] == 'open', 'Late join must follow the current question'
+        assert control('finish')[0] == 200
+        assert all(p.state()['result'] == 'No answer' for p in [alice, bob, charlie, dave])
+        assert control('next')[1]['number'] == 3
+        assert control('finish')[0] == 200
+        assert control('next')[0] == 409
+        assert control('end')[1]['phase'] == 'ended'
+        assert a_events.until(lambda s: s['phase'] == 'ended')['phase'] == 'ended'
+        assert 'question' not in alice.state()
+        visitor = Player(code)
+        assert visitor.state()['phase'] == 'ended'
+        assert visitor.join('Too late')['phase'] == 'ended'
+        assert visitor.cookie is None
+        second_game = new_game()
+        new_code = second_game.split('/')[-1]
+        assert new_code != code
+        fresh = json.loads(request(second_game + '/state')[2])
+        assert fresh['players'] == 0 and fresh['phase'] == 'waiting'
+        # A cookie for another game is never a player identity here.
+        assert config(request('/play/' + new_code, auth=None, extra_headers={'Cookie': alice.cookie})[2])['state'].get('name') is None
+        # Deactivate every preparation question; a new empty game should end safely.
+        question_ids = re.findall(r'data-question-id="(\d+)"', request(quiz)[2])
+        for qid in question_ids:
+            assert request(quiz + '/questions/' + qid + '/active', {'csrf': token})[0] == 303
+        empty = new_game()
+        assert json.loads(request(empty + '/state')[2])['total'] == 0
+        status, _, body = request(empty + '/control', {'csrf': token, 'version': 0, 'action': 'start'})
+        assert status == 200 and json.loads(body)['phase'] == 'ended'
+        # Game snapshots survive quiz edits/deletion, without changing archived contents.
+        assert request(quiz, {'csrf': token, 'title': 'Edited after snapshot'})[0] == 303
+        assert json.loads(request(second_game + '/state')[2])['title'] == 'Live <regression>'
+        assert request(quiz + '/delete', {'csrf': token})[0] == 303
+        assert request(second_game)[0] == 200
+        quiz = None
+        print('Live HTTP/SSE passed: auth, CSRF, QR, remembered players, live counters, answer changes, correctness embargo, inactive skip, results, late joins, stale/closed rejection, end, independent snapshots.')
+    finally:
+        for stream in streams: stream.close()
+        if quiz: request(quiz + '/delete', {'csrf': token})
+        # No public deletion of archived games. Test-only cleanup of known IDs.
+        import sqlite3
+        with sqlite3.connect('storage/quizzy.sqlite3') as db:
+            db.execute('PRAGMA foreign_keys=ON')
+            for game in games: db.execute('DELETE FROM games WHERE code=?', (game.split('/')[-1],))
+
+if __name__ == '__main__': run()
