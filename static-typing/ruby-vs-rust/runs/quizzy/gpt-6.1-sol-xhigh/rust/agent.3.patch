+        let data = serde_json::to_string(&state(&app, "TEST", &headers("token-a"), false).unwrap())
+            .unwrap();
+        assert!(data.contains("Current question"));
+        for forbidden in ["correct", "count", "result", "Unreleased", "Future option"] {
+            assert!(!data.contains(forbidden), "Leaked {forbidden}");
+        }
+        let anonymous = state(&app, "TEST", &HeaderMap::new(), false).unwrap();
+        assert!(anonymous.question.is_none());
+        let wrong_game = state(&app, "SECOND", &headers("token-a"), false).unwrap();
+        assert!(wrong_game.name.is_none());
+    }
+    #[test]
+    fn results_reveal_only_after_finish_and_count_active_players_once() {
+        let app = fixture();
+        app.db()
+            .unwrap()
+            .execute_batch(
+                "INSERT INTO game_answers(question_id,player_id,option_id) VALUES (1,1,1),(1,2,2);
+            UPDATE games SET phase='closed',version=2 WHERE id=1;",
+            )
+            .unwrap();
+        app.live.seen(1, 1, true);
+        app.live.seen(1, 1, true); // Two tabs, one player.
+        let alice = state(&app, "TEST", &headers("token-a"), false).unwrap();
+        assert_eq!(alice.result, Some("Correct!"));
+        assert_eq!(alice.question.unwrap().options[0].correct, Some(true));
+        assert_eq!(
+            state(&app, "TEST", &headers("token-b"), false)
+                .unwrap()
+                .result,
+            Some("Wrong!")
+        );
+        let moderator = state(&app, "TEST", &HeaderMap::new(), true).unwrap();
+        assert_eq!(moderator.players, Some(1));
+        assert_eq!(moderator.answers, Some(1));
+        assert_eq!(moderator.question.unwrap().options[1].count, Some(1)); // Historical answers still in results.
+        app.live.disconnect(1, 1);
+        assert_eq!(app.live.active(1), vec![1]); // Other tab remains connected.
+        app.db()
+            .unwrap()
+            .execute("DELETE FROM game_answers WHERE player_id=2", [])
+            .unwrap();
+        assert_eq!(
+            state(&app, "TEST", &headers("token-b"), false)
+                .unwrap()
+                .result,
+            Some("No answer")
+        );
+    }
+    #[test]
+    fn answer_notifications_do_not_fan_out_to_other_phones_or_games() {
+        let hub = LiveHub::default();
+        let moderator = hub.moderator(1);
+        let phase = hub.phases(1);
+        let alice = hub.personal(1, 1);
+        let bob = hub.personal(1, 2);
+        let other_game = hub.moderator(2);
+        hub.notify(1, false, Some(1));
+        assert!(moderator.has_changed().unwrap());
+        assert!(alice.has_changed().unwrap());
+        assert!(!phase.has_changed().unwrap());
+        assert!(!bob.has_changed().unwrap());
+        assert!(!other_game.has_changed().unwrap());
+        hub.notify(1, true, None);
+        assert!(phase.has_changed().unwrap());
+    }
+    #[test]
+    fn presence_expires_and_tolerates_short_wifi_interruptions() {
+        let now = Instant::now();
+        let mut p = Presence {
+            seen: now,
+            connections: 1,
+            disconnected: None,
+        };
+        assert!(p.active());
+        p.seen = now - Duration::from_secs(36);
+        assert!(!p.active());
+        p.seen = now;
+        p.connections = 0;
+        p.disconnected = Some(now - Duration::from_secs(2));
+        assert!(p.active());
+        p.disconnected = Some(now - Duration::from_secs(9));
+        assert!(!p.active());
+    }
+}
