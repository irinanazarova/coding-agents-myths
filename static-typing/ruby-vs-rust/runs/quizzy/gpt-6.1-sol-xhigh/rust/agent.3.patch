+/* Keep game views local, high-contrast and usable on a phone or a conference screen. */
+.live-screen { background: var(--c-blue); color: var(--c-lavender); gap: 30px; }
+.live-screen .screen-title { margin-left: auto; overflow-wrap: anywhere; }
+.moderator-tag { font: 600 14px/1 var(--f-body); opacity: .75; }
+.live-screen .lobby__title { color: var(--c-sun); }
+.qr img { width: 100%; height: 100%; display: block; }
+.correct-label { font-size: .55em; font-weight: 800; background: var(--c-success); color: white; padding: .4em .65em; border-radius: 100px; }
+.live-screen .stage-option__title { min-width: 0; }
+.live-screen .stage-option__count { margin-left: auto; }
+.live-screen #live-error { font-size: 14px; max-width: 260px; }
+.live-player #connection-status { font-size: 13px; }
+.live-player .play-options { list-style: none; margin: 0; padding: 0; }
+.live-player .player-greeting { font-weight: 700; margin-bottom: 18px; overflow-wrap: anywhere; }
+.live-player .waiting { margin: auto 0; padding: 40px 0; }
+.live-player .play-option__mark { white-space: normal; max-width: 75px; }
+.live-player .answer-hint, .live-player .waiting-next { margin-top: 18px; }
+.live-player .play-status { margin-top: 24px; }
+.live-player #live-error { padding: 14px; border: 2px solid var(--c-pink); border-radius: 12px; }
+.game-list { list-style: none; padding: 0; display: grid; gap: 12px; }
+.game-item { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 0; }
+@media (max-width: 600px) {
+  .live-screen .screen-title { font-size: 16px; }
+  .moderator-tag { display: none; }
+  .screen-controls { flex-wrap: wrap; }
+  .screen-controls__info { gap: 12px; font-size: 14px; }
+  .live-screen { padding-bottom: 155px; }
+  .live-screen .lobby__title { font-size: 48px; }
+  .live-screen .lobby__url { font-size: 26px; }
+  .stage-option { flex-wrap: wrap; }
+  .correct-label { font-size: 14px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .waiting__gem { animation: none; }
