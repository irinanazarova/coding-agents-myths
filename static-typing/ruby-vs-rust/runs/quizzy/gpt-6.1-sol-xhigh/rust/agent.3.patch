+pub fn initialize(db: &Connection) -> rusqlite::Result<()> {
+    db.execute_batch(
+        "CREATE TABLE IF NOT EXISTS games (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            quiz_id INTEGER REFERENCES quizzes(id) ON DELETE SET NULL,
+            code TEXT NOT NULL UNIQUE,
+            title TEXT NOT NULL,
+            phase TEXT NOT NULL DEFAULT 'waiting' CHECK(phase IN ('waiting','open','closed','ended')),
+            current INTEGER NOT NULL DEFAULT -1,
+            version INTEGER NOT NULL DEFAULT 0,
+            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
+        );
+        CREATE TABLE IF NOT EXISTS game_questions (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            position INTEGER NOT NULL,
+            text TEXT NOT NULL,
+            UNIQUE(game_id, position)
+        );
+        CREATE TABLE IF NOT EXISTS game_options (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            question_id INTEGER NOT NULL REFERENCES game_questions(id) ON DELETE CASCADE,
+            position INTEGER NOT NULL,
+            text TEXT NOT NULL,
+            correct INTEGER NOT NULL CHECK(correct IN (0,1))
+        );
+        CREATE INDEX IF NOT EXISTS game_options_order ON game_options(question_id,position);
+        CREATE TABLE IF NOT EXISTS players (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            name TEXT NOT NULL,
+            token TEXT NOT NULL UNIQUE
+        );
+        CREATE INDEX IF NOT EXISTS players_game ON players(game_id);
+        CREATE TABLE IF NOT EXISTS game_answers (
+            question_id INTEGER NOT NULL REFERENCES game_questions(id) ON DELETE CASCADE,
+            player_id INTEGER NOT NULL REFERENCES players(id) ON DELETE CASCADE,
+            option_id INTEGER NOT NULL REFERENCES game_options(id),
+            revision INTEGER NOT NULL DEFAULT 1,
+            PRIMARY KEY(question_id, player_id)
+        );
+        CREATE INDEX IF NOT EXISTS game_answers_option ON game_answers(option_id);",
+    )
+}
+
+// All correctness/count keys are entirely absent while open (not merely hidden by CSS).
+#[derive(Debug, Serialize)]
+struct OptionView {
+    id: i64,
+    text: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    correct: Option<bool>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    count: Option<i64>,
+}
+#[derive(Debug, Serialize)]
+struct QuestionView {
+    id: i64,
+    text: String,
+    options: Vec<OptionView>,
+}
+#[derive(Debug, Serialize)]
+struct LiveState {
+    title: String,
+    phase: String,
+    version: i64,
+    number: i64,
+    total: i64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    question: Option<QuestionView>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    name: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    answer: Option<i64>,
+    answer_version: i64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    result: Option<&'static str>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    players: Option<usize>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    answers: Option<usize>,
+}
+struct Game {
+    id: i64,
+    title: String,
+    phase: String,
+    current: i64,
+    version: i64,
+}
+fn game(db: &Connection, code: &str) -> Result<Game> {
+    db.query_row(
+        "SELECT id,title,phase,current,version FROM games WHERE code=?",
+        [code],
+        |r| {
+            Ok(Game {
+                id: r.get(0)?,
+                title: r.get(1)?,
+                phase: r.get(2)?,
+                current: r.get(3)?,
+                version: r.get(4)?,
+            })
+        },
+    )
+    .optional()?
+    .ok_or(AppError::NotFound)
+}
+fn random_token() -> Result<String> {
+    let mut bytes = [0u8; 32];
+    getrandom::fill(&mut bytes).map_err(|e| AppError::Internal(e.to_string()))?;
+    Ok(URL_SAFE_NO_PAD.encode(bytes))
+}
+fn new_code() -> Result<String> {
+    // Unambiguous characters, with 40 bits of entropy. Retain a unique DB constraint as well.
+    let alphabet = b"23456789ABCDEFGHJKLMNPQRSTUVWXYZ";
+    let mut bytes = [0u8; 8];
+    getrandom::fill(&mut bytes).map_err(|e| AppError::Internal(e.to_string()))?;
+    Ok(bytes
+        .iter()
+        .map(|n| alphabet[*n as usize % alphabet.len()] as char)
+        .collect())
+}
+fn cookie_token(headers: &HeaderMap, code: &str) -> Option<String> {
+    let name = format!("quizzy_player_{code}");
+    headers
+        .get(header::COOKIE)?
+        .to_str()
+        .ok()?
+        .split(';')
+        .find_map(|cookie| {
+            let (key, value) = cookie.trim().split_once('=')?;
+            (key == name).then(|| value.to_owned())
+        })
+}
+fn player(
+    db: &Connection,
+    game_id: i64,
+    headers: &HeaderMap,
+    code: &str,
+) -> Result<Option<(i64, String)>> {
+    let Some(token) = cookie_token(headers, code) else {
+        return Ok(None);
+    };
+    Ok(db
+        .query_row(
+            "SELECT id,name FROM players WHERE game_id=? AND token=?",
+            params![game_id, token],
+            |r| Ok((r.get(0)?, r.get(1)?)),
+        )
+        .optional()?)
+}
+fn player_csrf(app: &App, code: &str, headers: &HeaderMap) -> String {
+    let identity = cookie_token(headers, code).unwrap_or_default();
+    URL_SAFE_NO_PAD.encode(signature(
+        &app.secret,
+        format!("quizzy play v1:{code}:{identity}").as_bytes(),
+    ))
+}
+fn check_player_csrf(app: &App, code: &str, headers: &HeaderMap, fields: &Fields) -> Result<()> {
+    let supplied = URL_SAFE_NO_PAD
+        .decode(field(fields, "csrf"))
+        .map_err(|_| AppError::Forbidden)?;
+    let identity = cookie_token(headers, code).unwrap_or_default();
+    use hmac::{Hmac, Mac};
+    use sha2::Sha256;
+    let mut mac = Hmac::<Sha256>::new_from_slice(app.secret.as_bytes()).unwrap();
+    mac.update(format!("quizzy play v1:{code}:{identity}").as_bytes());
+    mac.verify_slice(&supplied).map_err(|_| AppError::Forbidden)
+}
+
+/// One moderator channel, one phase channel, and personal channels per game.
+/// Answer traffic does not fan out to every phone on conference Wi-Fi.
+#[derive(Default)]
+pub struct LiveHub {
+    rooms: Mutex<HashMap<i64, Room>>,
+}
+struct Presence {
+    seen: Instant,
+    connections: usize,
+    disconnected: Option<Instant>,
+}
+impl Presence {
+    fn active(&self) -> bool {
+        self.seen.elapsed() < Duration::from_secs(35)
+            && self
+                .disconnected
+                .is_none_or(|t| t.elapsed() < Duration::from_secs(8))
+    }
+}
+struct Room {
+    moderator: watch::Sender<u64>,
+    phase: watch::Sender<u64>,
+    personal: HashMap<i64, watch::Sender<u64>>,
+    presence: HashMap<i64, Presence>,
+    last_count: usize,
+}
+impl Default for Room {
+    fn default() -> Self {
+        Self {
+            moderator: watch::channel(0).0,
+            phase: watch::channel(0).0,
+            personal: HashMap::new(),
+            presence: HashMap::new(),
+            last_count: 0,
+        }
+    }
+}
+fn bump(sender: &watch::Sender<u64>) {
+    sender.send_modify(|v| *v = v.wrapping_add(1));
+}
+impl LiveHub {
+    fn moderator(&self, id: i64) -> watch::Receiver<u64> {
+        self.rooms
+            .lock()
+            .unwrap()
+            .entry(id)
+            .or_default()
+            .moderator
+            .subscribe()
+    }
+    fn phases(&self, id: i64) -> watch::Receiver<u64> {
+        self.rooms
+            .lock()
+            .unwrap()
+            .entry(id)
+            .or_default()
+            .phase
+            .subscribe()
+    }
+    fn personal(&self, id: i64, player_id: i64) -> watch::Receiver<u64> {
+        self.rooms
+            .lock()
+            .unwrap()
+            .entry(id)
+            .or_default()
+            .personal
+            .entry(player_id)
+            .or_insert_with(|| watch::channel(0).0)
+            .subscribe()
+    }
+    fn notify(&self, id: i64, phase: bool, player: Option<i64>) {
+        let mut rooms = self.rooms.lock().unwrap();
+        let room = rooms.entry(id).or_default();
+        bump(&room.moderator);
+        if phase {
+            bump(&room.phase);
+        }
+        if let Some(p) = player
+            && let Some(sender) = room.personal.get(&p)
+        {
+            bump(sender);
+        }
+    }
+    fn active(&self, id: i64) -> Vec<i64> {
+        self.rooms
+            .lock()
+            .unwrap()
+            .get(&id)
+            .map(|room| {
+                room.presence
+                    .iter()
+                    .filter(|(_, p)| p.active())
+                    .map(|(id, _)| *id)
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+    fn seen(&self, id: i64, player_id: i64, connect: bool) {
+        let mut rooms = self.rooms.lock().unwrap();
+        let room = rooms.entry(id).or_default();
+        let p = room.presence.entry(player_id).or_insert(Presence {
+            seen: Instant::now(),
+            connections: 0,
+            disconnected: None,
+        });
+        p.seen = Instant::now();
+        if connect {
+            p.connections += 1;
+        }
+        p.disconnected = None;
+        Self::update_count(room);
+    }
+    fn disconnect(&self, id: i64, player_id: i64) {
+        let mut rooms = self.rooms.lock().unwrap();
+        if let Some(room) = rooms.get_mut(&id)
+            && let Some(p) = room.presence.get_mut(&player_id)
+        {
+            p.connections = p.connections.saturating_sub(1);
+            if p.connections == 0 {
+                p.disconnected = Some(Instant::now());
+            }
+        }
+    }
+    fn update_count(room: &mut Room) {
+        let count = room.presence.values().filter(|p| p.active()).count();
+        if count != room.last_count {
+            room.last_count = count;
+            bump(&room.moderator);
+        }
+    }
+    pub async fn reap(self: Arc<Self>) {
+        let mut interval = tokio::time::interval(Duration::from_secs(2));
+        loop {
+            interval.tick().await;
+            let mut rooms = self.rooms.lock().unwrap();
+            for room in rooms.values_mut() {
+                Self::update_count(room);
+            }
+        }
+    }
+}
+struct PresenceGuard {
+    hub: Arc<LiveHub>,
+    game: i64,
+    player: i64,
+}
+impl Drop for PresenceGuard {
+    fn drop(&mut self) {
+        self.hub.disconnect(self.game, self.player);
+    }
+}
+
+fn state(app: &App, code: &str, headers: &HeaderMap, moderator: bool) -> Result<LiveState> {
+    let db = app.db()?;
+    let g = game(&db, code)?;
+    let total: i64 = db.query_row(
+        "SELECT COUNT(*) FROM game_questions WHERE game_id=?",
+        [g.id],
+        |r| r.get(0),
+    )?;
+    let p = if moderator {
+        None
+    } else {
+        player(&db, g.id, headers, code)?
+    };
+    let mut view = LiveState {
+        title: g.title,
+        phase: g.phase.clone(),
+        version: g.version,
+        number: g.current + 1,
+        total,
+        question: None,
+        name: p.as_ref().map(|(_, name)| name.clone()),
+        answer: None,
+        answer_version: 0,
+        result: None,
+        players: None,
+        answers: None,
+    };
+    let active = if moderator {
+        app.live.active(g.id)
+    } else {
+        vec![]
+    };
+    if moderator {
+        view.players = Some(active.len());
+        view.answers = Some(0);
+    }
+    if (moderator || p.is_some()) && (g.phase == "open" || g.phase == "closed") {
+        let (qid, text) = db.query_row(
+            "SELECT id,text FROM game_questions WHERE game_id=? AND position=?",
+            params![g.id, g.current],
+            |r| Ok((r.get::<_, i64>(0)?, r.get::<_, String>(1)?)),
+        )?;
+        let options = if g.phase == "closed" && moderator {
+            let mut stmt = db.prepare("SELECT o.id,o.text,o.correct,COUNT(a.player_id) FROM game_options o LEFT JOIN game_answers a ON a.option_id=o.id WHERE o.question_id=? GROUP BY o.id ORDER BY o.position")?;
+            stmt.query_map([qid], |r| {
+                Ok(OptionView {
+                    id: r.get(0)?,
+                    text: r.get(1)?,
+                    correct: Some(r.get(2)?),
+                    count: Some(r.get(3)?),
+                })
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?
+        } else {
+            let sql = if g.phase == "closed" {
+                "SELECT id,text,correct FROM game_options WHERE question_id=? ORDER BY position"
+            } else {
+                "SELECT id,text,NULL FROM game_options WHERE question_id=? ORDER BY position"
+            };
+            let mut stmt = db.prepare(sql)?;
+            stmt.query_map([qid], |r| {
+                Ok(OptionView {
+                    id: r.get(0)?,
+                    text: r.get(1)?,
+                    correct: r.get(2)?,
+                    count: None,
+                })
+            })?
+            .collect::<rusqlite::Result<Vec<_>>>()?
+        };
+        if let Some((pid, _)) = p {
+            view.answer = db
+                .query_row(
+                    "SELECT option_id FROM game_answers WHERE question_id=? AND player_id=?",
+                    params![qid, pid],
+                    |r| r.get(0),
+                )
+                .optional()?;
+            view.answer_version = db
+                .query_row(
+                    "SELECT revision FROM game_answers WHERE question_id=? AND player_id=?",
+                    params![qid, pid],
+                    |r| r.get(0),
+                )
+                .optional()?
+                .unwrap_or(0);
+            if g.phase == "closed" {
+                view.result = Some(match view.answer {
+                    None => "No answer",
+                    Some(id)
+                        if options
+                            .iter()
+                            .any(|o| o.id == id && o.correct == Some(true)) =>
+                    {
+                        "Correct!"
+                    }
+                    _ => "Wrong!",
+                });
+            }
+        }
+        if moderator {
+            let active: std::collections::HashSet<_> = active.iter().collect();
+            let answered = db
+                .prepare("SELECT player_id FROM game_answers WHERE question_id=?")?
+                .query_map([qid], |r| r.get::<_, i64>(0))?
+                .collect::<rusqlite::Result<Vec<_>>>()?;
+            view.answers = Some(answered.iter().filter(|p| active.contains(p)).count());
+        }
+        view.question = Some(QuestionView {
+            id: qid,
+            text,
+            options,
+        });
+    }
+    Ok(view)
+}
+
+pub fn routes() -> Router<AppState> {
+    Router::new()
+        .route("/moderate/quizzes/{id}/games", post(create))
+        .route("/moderate/games/{code}", get(moderator_page))
+        .route("/moderate/games/{code}/state", get(moderator_state))
+        .route("/moderate/games/{code}/events", get(moderator_events))
+        .route("/moderate/games/{code}/control", post(control))
+        .route("/moderate/games/{code}/qr.svg", get(qr))
+        .route("/play/{code}", get(player_page).post(join))
+        .route("/play/{code}/state", get(player_state))
+        .route("/play/{code}/events", get(player_events))
+        .route("/play/{code}/answer", post(answer))
+        .route("/play/{code}/presence", post(presence))
+}
+async fn create(
+    State(app): State<AppState>,
+    Path(id): Path<i64>,
+    Form(fields): Form<Fields>,
+) -> Result<Redirect> {
+    app.check_csrf(&fields)?;
+    let mut db = app.db()?;
+    let tx = db.transaction()?;
+    let title = crate::quiz_title(&tx, id)?;
+    let questions = db::questions(&tx, id)?;
+    let code = loop {
+        let code = new_code()?;
+        if !tx.query_row(
+            "SELECT EXISTS(SELECT 1 FROM games WHERE code=?)",
+            [&code],
+            |r| r.get::<_, bool>(0),
+        )? {
+            break code;
+        }
+    };
+    tx.execute(
+        "INSERT INTO games(quiz_id,code,title) VALUES (?,?,?)",
+        params![id, code, title],
+    )?;
+    let gid = tx.last_insert_rowid();
+    for (position, q) in questions.into_iter().filter(|q| q.active).enumerate() {
+        tx.execute(
+            "INSERT INTO game_questions(game_id,position,text) VALUES (?,?,?)",
+            params![gid, position as i64, q.text],
+        )?;
+        let qid = tx.last_insert_rowid();
+        for (pos, o) in q.options.iter().enumerate() {
+            tx.execute(
+                "INSERT INTO game_options(question_id,position,text,correct) VALUES (?,?,?,?)",
+                params![qid, pos as i64, o.text, o.correct],
+            )?;
+        }
+    }
+    tx.commit()?;
+    Ok(Redirect::to(&format!("/moderate/games/{code}")))
+}
+async fn control(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    Form(fields): Form<Fields>,
+) -> Result<Response> {
+    app.check_csrf(&fields)?;
+    let changed = {
+        let db = app.db()?;
+        let g = game(&db, &code)?;
+        let expected: i64 = field(&fields, "version")
+            .parse()
+            .map_err(|_| AppError::BadRequest)?;
+        let total: i64 = db.query_row(
+            "SELECT COUNT(*) FROM game_questions WHERE game_id=?",
+            [g.id],
+            |r| r.get(0),
+        )?;
+        let transition = match (g.phase.as_str(), field(&fields, "action")) {
+            ("waiting", "start") if total == 0 => Some(("ended", -1)),
+            ("waiting", "start") => Some(("open", 0)),
+            ("open", "finish") => Some(("closed", g.current)),
+            ("closed", "next") if g.current + 1 < total => Some(("open", g.current + 1)),
+            ("closed", "end") if g.current + 1 == total => Some(("ended", g.current)),
+            _ => None,
+        };
+        if let Some((phase, current)) = transition
+            && expected == g.version
+        {
+            db.execute(
+                "UPDATE games SET phase=?,current=?,version=version+1 WHERE id=?",
+                params![phase, current, g.id],
+            )?;
+            Some(g.id)
+        } else {
+            None
+        }
+    };
+    if let Some(id) = changed {
+        app.live.notify(id, true, None);
+    }
+    Ok((
+        if changed.is_some() {
+            StatusCode::OK
+        } else {
+            StatusCode::CONFLICT
+        },
+        Json(state(&app, &code, &HeaderMap::new(), true)?),
+    )
+        .into_response())
+}
+fn join_url(headers: &HeaderMap, code: &str) -> String {
+    let host = headers
+        .get(header::HOST)
+        .and_then(|h| h.to_str().ok())
+        .unwrap_or("localhost:3000");
+    format!("http://{host}/play/{code}")
+}
+fn boot_page(title: &str, body: &str, config: serde_json::Value) -> String {
+    let json = config
+        .to_string()
+        .replace('&', "\\u0026")
+        .replace('<', "\\u003c")
+        .replace('>', "\\u003e");
+    format!(
+        r#"<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{} · Quizzy</title><link rel="stylesheet" href="/assets/quizzy.css"><link rel="stylesheet" href="/assets/app.css"><link rel="stylesheet" href="/assets/live.css"><script src="/assets/live.js" defer></script></head><body>{body}<script id="live-config" type="application/json">{json}</script></body></html>"#,
+        views::escape(title)
+    )
+}
+async fn moderator_page(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+) -> Result<Html<String>> {
+    let initial = state(&app, &code, &headers, true)?;
+    let gid = game(&*app.db()?, &code)?.id;
+    let quiz_id: Option<i64> =
+        app.db()?
+            .query_row("SELECT quiz_id FROM games WHERE id=?", [gid], |r| r.get(0))?;
+    let back = quiz_id
+        .map(|id| format!("/moderate/quizzes/{id}"))
+        .unwrap_or("/moderate".into());
+    let url = join_url(&headers, &code);
+    let body = format!(
+        r#"<main class="screen live-screen"><header class="screen__top"><span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span><span class="screen-title">{}</span><span class="moderator-tag">Moderator</span></header><div class="screen__body" id="live-content"></div><footer class="screen-controls"><div class="screen-controls__info"><a href="{back}">Back to quiz</a><span id="live-counter" role="status"></span><span id="connection-status" role="status"></span></div><div id="live-controls" class="buttons"></div></footer><noscript>Enable JavaScript for the live game.</noscript></main>"#,
+        views::escape(&initial.title)
+    );
+    Ok(Html(boot_page(
+        &initial.title,
+        &body,
+        serde_json::json!({"role":"moderator","base":format!("/moderate/games/{code}"),"csrf":app.csrf,"url":url,"state":initial}),
+    )))
+}
+async fn qr(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+) -> Result<Response> {
+    game(&*app.db()?, &code)?;
+    let qr = qrcode::QrCode::new(join_url(&headers, &code))
+        .map_err(|e| AppError::Internal(e.to_string()))?;
+    let svg = qr
+        .render::<qrcode::render::svg::Color>()
+        .min_dimensions(360, 360)
+        .dark_color(qrcode::render::svg::Color("#000000"))
+        .light_color(qrcode::render::svg::Color("#ffffff"))
+        .build();
+    Ok(([(header::CONTENT_TYPE, "image/svg+xml")], svg).into_response())
+}
+async fn player_page(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+) -> Result<Html<String>> {
+    let g = game(&*app.db()?, &code)?;
+    if let Some((pid, _)) = player(&*app.db()?, g.id, &headers, &code)?
+        && g.phase != "ended"
+    {
+        app.live.seen(g.id, pid, false);
+    }
+    let initial = state(&app, &code, &headers, false)?;
+    let body = r#"<main class="play live-player"><header class="play__top"><span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span><span id="connection-status" role="status"></span></header><div id="live-content" class="play__body play__body--top"></div><p id="live-error" role="alert" hidden></p><noscript>Enable JavaScript to join and play the live quiz.</noscript></main>"#;
+    Ok(Html(boot_page(
+        &g.title,
+        body,
+        serde_json::json!({"role":"player","base":format!("/play/{code}"),"csrf":player_csrf(&app,&code,&headers),"state":initial}),
+    )))
+}
+async fn join(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> Result<Response> {
+    check_player_csrf(&app, &code, &headers, &fields)?;
+    let (gid, pid, token) = {
+        let db = app.db()?;
+        let g = game(&db, &code)?;
+        if g.phase == "ended" {
+            drop(db);
+            if wants_json(&headers) {
+                return Ok(Json(serde_json::json!({"state":state(&app,&code,&headers,false)?,"csrf":player_csrf(&app,&code,&headers)})).into_response());
+            }
+            return Ok((
+                StatusCode::GONE,
+                Html(boot_page(
+                    &g.title,
+                    "<main class=\"play\"><h1>The quiz is over</h1></main>",
+                    serde_json::json!(null),
+                )),
+            )
+                .into_response());
+        }
+        if player(&db, g.id, &headers, &code)?.is_some() {
+            drop(db);
+            return joined_response(&app, &code, headers, None);
+        }
+        let name = field(&fields, "name").trim();
+        if name.is_empty() || name.chars().count() > 80 {
+            return Err(AppError::BadRequest);
+        }
+        let token = random_token()?;
+        db.execute(
+            "INSERT INTO players(game_id,name,token) VALUES (?,?,?)",
+            params![g.id, name, token],
+        )?;
+        (g.id, db.last_insert_rowid(), token)
+    };
+    app.live.seen(gid, pid, false);
+    joined_response(&app, &code, headers, Some(token))
+}
+fn wants_json(headers: &HeaderMap) -> bool {
+    headers
+        .get(header::ACCEPT)
+        .and_then(|v| v.to_str().ok())
+        .is_some_and(|s| s.contains("application/json"))
+}
+fn joined_response(
+    app: &App,
+    code: &str,
+    mut headers: HeaderMap,
+    token: Option<String>,
+) -> Result<Response> {
+    let ajax = wants_json(&headers);
+    let cookie = token.map(|token| {
+        headers.insert(header::COOKIE, format!("quizzy_player_{code}={token}").parse().unwrap());
+        format!("quizzy_player_{code}={token}; Path=/play/{code}; HttpOnly; SameSite=Lax; Max-Age=31536000")
+    });
+    let mut response = if ajax {
+        Json(serde_json::json!({"state":state(app,code,&headers,false)?,"csrf":player_csrf(app,code,&headers)})).into_response()
+    } else {
+        Redirect::to(&format!("/play/{code}")).into_response()
+    };
+    if let Some(cookie) = cookie {
+        response
+            .headers_mut()
+            .insert(header::SET_COOKIE, cookie.parse().unwrap());
+    }
+    Ok(response)
+}
+async fn answer(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> Result<Response> {
+    check_player_csrf(&app, &code, &headers, &fields)?;
+    let qid: i64 = field(&fields, "question")
+        .parse()
+        .map_err(|_| AppError::BadRequest)?;
+    let oid: i64 = field(&fields, "option")
+        .parse()
+        .map_err(|_| AppError::BadRequest)?;
+    let (gid, pid, accepted) = {
+        let db = app.db()?;
+        let g = game(&db, &code)?;
+        let (pid, _) = player(&db, g.id, &headers, &code)?.ok_or(AppError::Forbidden)?;
+        let valid = g.phase == "open" && db.query_row("SELECT EXISTS(SELECT 1 FROM game_questions q JOIN game_options o ON o.question_id=q.id WHERE q.game_id=? AND q.position=? AND q.id=? AND o.id=?)", params![g.id,g.current,qid,oid], |r| r.get::<_,bool>(0))?;
+        if valid {
+            db.execute("INSERT INTO game_answers(question_id,player_id,option_id) VALUES (?,?,?) ON CONFLICT(question_id,player_id) DO UPDATE SET option_id=excluded.option_id, revision=game_answers.revision+1", params![qid,pid,oid])?;
+        }
+        (g.id, pid, valid)
+    };
+    if accepted {
+        app.live.seen(gid, pid, false);
+        app.live.notify(gid, false, Some(pid));
+    }
+    Ok((
+        if accepted {
+            StatusCode::OK
+        } else {
+            StatusCode::CONFLICT
+        },
+        Json(state(&app, &code, &headers, false)?),
+    )
+        .into_response())
+}
+async fn presence(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> Result<StatusCode> {
+    check_player_csrf(&app, &code, &headers, &fields)?;
+    let g = game(&*app.db()?, &code)?;
+    let (pid, _) = player(&*app.db()?, g.id, &headers, &code)?.ok_or(AppError::Forbidden)?;
+    if g.phase != "ended" {
+        app.live.seen(g.id, pid, false);
+    }
+    Ok(StatusCode::NO_CONTENT)
+}
+async fn moderator_state(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+) -> Result<Json<LiveState>> {
+    Ok(Json(state(&app, &code, &headers, true)?))
+}
+async fn player_state(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
