+
+/// Additive, idempotent migrations for databases made by earlier versions.
+/// Names and declarations are internal constants, never request input.
+pub fn add_column(
+    db: &Connection,
+    table: &str,
+    column: &str,
+    declaration: &str,
+) -> rusqlite::Result<()> {
+    let columns = db
+        .prepare(&format!("PRAGMA table_info({table})"))?
+        .query_map([], |r| r.get::<_, String>(1))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    if !columns.iter().any(|name| name == column) {
+        db.execute_batch(&format!(
+            "ALTER TABLE {table} ADD COLUMN {column} {declaration}"
+        ))?;
+    }
+    Ok(())
+}
+
+pub fn number_of_winners(db: &Connection, id: i64) -> rusqlite::Result<i64> {
+    db.query_row(
+        "SELECT number_of_winners FROM quizzes WHERE id=?",
+        [id],
+        |r| r.get(0),
     )
 }
 
