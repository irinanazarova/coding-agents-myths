+#!/usr/bin/env python3
+"""Chromium prize workflow, separate phone identities, and post-game reconnection."""
+import json, socket, sqlite3, subprocess, tempfile, time, urllib.request
+from browser import CDP
+from smoke import request, csrf, AUTH, BASE
+
+
+def main():
+    token = csrf(request('/moderate/quizzes/new')[2]); quiz = None; game = None; clients = []
+    port_socket = socket.socket(); port_socket.bind(('127.0.0.1', 0)); port = port_socket.getsockname()[1]; port_socket.close()
+    with tempfile.TemporaryDirectory(dir='storage', prefix='prizes-chromium-', ignore_cleanup_errors=True) as profile, open('storage/prizes-chromium.log', 'w') as log:
+        process = subprocess.Popen(['chromium', '--headless', '--no-sandbox', '--disable-dev-shm-usage', '--disable-background-timer-throttling', '--remote-allow-origins=*', f'--remote-debugging-port={port}', f'--user-data-dir={profile}', 'about:blank'], stdout=log, stderr=log)
+        try:
+            deadline = time.time() + 15
+            while True:
+                try: info = json.load(urllib.request.urlopen(f'http://127.0.0.1:{port}/json/version')); break
+                except Exception:
+                    if time.time() > deadline: raise
+                    time.sleep(.1)
+            browser = CDP(info['webSocketDebuggerUrl'])
+            def page(moderator=False):
+                context = browser.command('Target.createBrowserContext')['browserContextId']
+                target = browser.command('Target.createTarget', {'url': 'about:blank', 'browserContextId': context})['targetId']
+                pages = json.load(urllib.request.urlopen(f'http://127.0.0.1:{port}/json/list'))
+                client = CDP(next(p['webSocketDebuggerUrl'] for p in pages if p['id'] == target))
+                for domain in ['Page', 'Runtime', 'Network', 'Log']: client.command(domain + '.enable')
+                client.command('Emulation.setDeviceMetricsOverride', {'width': 1440 if moderator else 390, 'height': 1000 if moderator else 844, 'deviceScaleFactor': 1, 'mobile': not moderator})
+                if moderator: client.command('Network.setExtraHTTPHeaders', {'headers': {'Authorization': AUTH}})
+                clients.append(client); return client
+            def text(c, value): c.wait(f'document.body.innerText.includes({json.dumps(value)})')
+            def set_field(c, selector, value): c.evaluate(f'document.querySelector({json.dumps(selector)}).value={json.dumps(value)}')
+            def winners(): return m.evaluate('Array.from(document.querySelectorAll(".leaderboard__row.is-winner .leaderboard__name")).map(n=>n.textContent)')
+            m = page(True); m.navigate('/moderate/quizzes/new')
+            assert m.evaluate('document.querySelector("#number-of-winners").value') == '3'
+            assert m.evaluate('document.querySelector("#number-of-winners").type') == 'number'
+            assert m.evaluate('document.querySelector("label[for=number-of-winners]").textContent') == 'Number of winners'
+            set_field(m, '#title', 'Prizes in the browser'); m.click('Save quiz')
+            text(m, 'Start a game'); quiz = m.evaluate('location.pathname')
+            m.click('Settings'); m.wait('document.querySelector("#number-of-winners") !== null')
+            set_field(m, '#number-of-winners', '2'); m.click('Save quiz'); text(m, 'Start a game')
+            m.click('Settings'); m.wait('document.querySelector("#number-of-winners") !== null')
+            assert m.evaluate('document.querySelector("#number-of-winners").value') == '2'
+            set_field(m, '#number-of-winners', '3'); m.click('Save quiz'); text(m, 'Start a game')
+            for i in range(3):
+                assert request(quiz + '/questions', {'csrf': token, 'question': f'Browser prize question {i+1}', 'active': '1', 'option_1': 'Right', 'correct_1': '1', 'option_2': 'Wrong'})[0] == 303
+            m.navigate(quiz); m.click('Start a game'); m.wait('document.querySelector(".lobby__url") !== null')
+            game = m.evaluate('location.pathname'); code = game.split('/')[-1]
+            phones = [page() for _ in range(5)]; names = ['Alice', 'Bob', 'Carol', 'Dave', 'Eve']
+            for phone, name in zip(phones, names):
+                phone.navigate('/play/' + code); phone.wait('document.querySelector("#player-name") !== null')
+                phone.fill('Your name', name); phone.click('Join'); text(phone, 'Hi, ' + name + '!')
+            text(m, 'Players: 5')
+            origins = [c.evaluate('performance.timeOrigin') for c in [m] + phones]
+            for question in range(3):
+                started = time.monotonic(); m.click('Start' if question == 0 else 'Next')
+                for c in [m] + phones: text(c, f'Question {question+1} of 3')
+                assert time.monotonic() - started < 1.5, 'Question delivery lagged'
+                for i, phone in enumerate(phones):
+                    if i < [4, 2, 1][question]:
+                        phone.click_selector('button[aria-label=Right]')
+                        phone.wait('document.querySelector("[aria-label=Right]").textContent.includes("Your answer") && !document.body.innerText.includes("Sending your answer")')
+                        time.sleep(.04)
+                    assert not any(s in phone.evaluate('document.body.innerText') for s in ['points', 'point', 'Place', 'You won!'])
+                m.click('Finish'); text(phones[0], 'Correct!')
+                m.wait('Array.from(document.querySelectorAll("button")).some(n=>n.textContent=== ' + json.dumps('Next' if question < 2 else 'End quiz') + ')')
+            m.click('End quiz'); text(m, 'Leaderboard')
+            assert m.evaluate('Array.from(document.querySelectorAll(".leaderboard__name")).map(n=>n.textContent)') == names
+            assert m.evaluate('Array.from(document.querySelectorAll(".leaderboard__place")).map(n=>n.textContent)') == ['1','2','3','4','5']
+            assert m.evaluate('Array.from(document.querySelectorAll(".leaderboard__points")).map(n=>n.textContent)') == ['3 points','2 points','1 point','1 point','0 points']
+            for i, phone in enumerate(phones):
+                text(phone, f'Place {i+1} of 5'); text(phone, ['3 points','2 points','1 point','1 point','0 points'][i])
+                assert phone.evaluate('document.documentElement.scrollWidth <= innerWidth')
+            m.click('Top 3'); m.wait('document.querySelectorAll(".winner-mark").length === 3')
+            assert winners() == ['Alice', 'Bob', 'Carol']
+            for phone in phones[:3]: text(phone, 'You won!')
+            assert all('You won!' not in p.evaluate('document.body.innerText') for p in phones[3:])
+            # Reset and draw modify the phone and screen live, not only upon navigation.
+            m.click('Reset winners'); m.wait('document.querySelectorAll(".winner-mark").length === 0')
+            for phone in phones: phone.wait('!document.body.innerText.includes("You won!")')
+            for _ in range(16):
+                m.click('Draw')
+                m.wait('document.querySelectorAll(".winner-mark").length === 3 && !Array.from(document.querySelectorAll("#live-controls button")).some(n=>n.disabled)')
+                won = winners(); assert won[:2] == ['Alice', 'Bob'] and won[2] in ['Carol','Dave']
+                for phone, name in zip(phones, names): phone.wait('document.body.innerText.includes("You won!") === ' + str(name in won).lower())
+            m.screenshot('prizes-leaderboard-desktop'); phones[0].screenshot('prizes-winner-phone')
+            # A disconnected ended-game phone receives current winners on reconnect.
+            phones[0].command('Network.emulateNetworkConditions', {'offline': True, 'latency': 0, 'downloadThroughput': 0, 'uploadThroughput': 0})
+            m.click('Reset winners'); m.wait('document.querySelectorAll(".winner-mark").length === 0')
+            phones[0].command('Network.emulateNetworkConditions', {'offline': False, 'latency': 0, 'downloadThroughput': -1, 'uploadThroughput': -1})
+            phones[0].wait('!document.body.innerText.includes("You won!")')
+            for c, origin in zip([m] + phones, origins): assert c.evaluate('performance.timeOrigin') == origin, 'Live updates must not reload'
+            m.click('Top 3'); text(phones[0], 'You won!')
+            phones[0].navigate('/play/' + code); text(phones[0], 'You won!')
+            m.click('Reset winners'); phones[0].wait('!document.body.innerText.includes("You won!")')
+            errors = [e for c in clients for e in c.errors if 'ERR_INTERNET_DISCONNECTED' not in json.dumps(e) and '/favicon.ico' not in json.dumps(e)]
+            assert not errors, errors
+            print('Chromium prizes passed: settings, instantaneous questions, ordered list, pluralization, phone places, live marks, draw/reset, no reloads and post-game reconnect.')
+        finally:
+            process.terminate(); process.wait(timeout=10)
+            if quiz: request(quiz + '/delete', {'csrf': token})
+            if game:
+                with sqlite3.connect('storage/quizzy.sqlite3') as db:
+                    db.execute('PRAGMA foreign_keys=ON'); db.execute('DELETE FROM games WHERE code=?', (game.split('/')[-1],))
+
+if __name__ == '__main__': main()
