+            m.navigate(quiz + '/edit'); fill(m, 'Timer seconds', 0); m.click('Save quiz'); m.wait('document.body.innerText.includes("Start a game")')
+            new_game(m); m.click('Start'); text(m, 'Timer question 1'); assert timer(m) is None
+            m.command('Emulation.setDeviceMetricsOverride', {'width': 390, 'height': 844, 'deviceScaleFactor': 1, 'mobile': True})
+            m.navigate(quiz + '/edit'); m.screenshot('timer-settings-phone')
+            assert m.evaluate('document.documentElement.scrollWidth <= innerWidth'), 'Settings overflow on phone'
+            errors = [e for c in clients for e in c.errors if '/favicon.ico' not in json.dumps(e)]
+            assert not errors, errors
+            print('Timer Chromium passed: exact labels/defaults, saved fields, 1:30 and 0:07, ticking, refresh, player invisibility, live auto-Finish, Next, early Finish and zero timer.')
+        finally:
+            for c in clients:
+                try: c.command('Page.navigate', {'url': 'about:blank'}); c.sock.close()
+                except Exception: pass
+            if quiz: request(quiz + '/delete', {'csrf': token})
+            with sqlite3.connect('storage/quizzy.sqlite3') as db:
+                db.execute('PRAGMA foreign_keys=ON')
+                for game in games: db.execute('DELETE FROM games WHERE code=?', (game.split('/')[-1],))
+            process.terminate()
+            try: process.wait(timeout=8)
+            except subprocess.TimeoutExpired: process.kill(); process.wait()
