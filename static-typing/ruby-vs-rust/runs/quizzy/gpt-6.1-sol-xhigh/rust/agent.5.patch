+#!/usr/bin/env python3
+"""Standalone restart regression in a temporary storage folder; requires a release build."""
+import json, os, pathlib, socket, subprocess, tempfile, time, urllib.request
+
+
+def run():
+    root = pathlib.Path(__file__).resolve().parents[1]
+    sock = socket.socket(); sock.bind(('127.0.0.1', 0)); port = sock.getsockname()[1]; sock.close()
+    os.environ['TEST_URL'] = f'http://127.0.0.1:{port}'
+    os.environ['QUIZZY_MODERATOR_USERNAME'] = 'moderator'
+    os.environ['QUIZZY_MODERATOR_PASSWORD'] = 'password'
+    from smoke import request, csrf
+    from live import config
+    env = dict(os.environ, PORT=str(port), SECRET_KEY_BASE='isolated-timer-persistence')
+    with tempfile.TemporaryDirectory(prefix='timer-restart-', dir=root / 'storage') as cwd, open(root / 'storage/timer-restart.log', 'w') as log:
+        process = None
+        def start():
+            nonlocal process
+            process = subprocess.Popen([root / 'target/release/quizzy'], cwd=cwd, env=env, stdout=log, stderr=log)
+            end = time.time() + 10
+            while True:
+                try:
+                    if request('/up', auth=None)[0] == 200: break
+                except Exception: pass
+                assert process.poll() is None, 'Server did not start'
+                if time.time() > end: raise AssertionError('Readiness timeout')
+                time.sleep(.05)
+        def stop():
+            nonlocal process
+            process.terminate(); process.wait(timeout=8); process = None
+        def state(game): return json.loads(request(game + '/state')[2])
+        try:
+            start()
+            token = csrf(request('/moderate/quizzes/new')[2])
+            _, headers, _ = request('/moderate/quizzes', {'csrf': token, 'title': 'Persistent timer', 'timer_minutes': 0, 'timer_seconds': 6})
+            quiz = headers['Location']
+            assert request(quiz + '/questions', {'csrf': token, 'question': 'Persistent question', 'active': 1,
+                'option_1': 'Right', 'correct_1': 1, 'option_2': 'Wrong'})[0] == 303
+            _, headers, _ = request(quiz + '/games', {'csrf': token}); game = headers['Location']
+            assert request(game + '/control', {'csrf': token, 'action': 'start', 'version': 0})[0] == 200
+            opened = state(game); deadline = opened['deadline_at_ms']
+            stop(); time.sleep(.7); start()
+            restored = config(request(game)[2])['state']
+            assert restored['phase'] == 'open' and restored['version'] == opened['version']
+            assert restored['deadline_at_ms'] == deadline
+            assert restored['server_now_ms'] > opened['server_now_ms'] + 600
+            source = request(quiz + '/edit')[2]
+            assert 'name="timer_seconds"' in source and 'value="6"' in source
+            # Let the deadline pass while stopped. Startup must close it, not restart its timer.
+            stop(); time.sleep(6); start()
+            closed = state(game)
+            assert closed['phase'] == 'closed' and closed['version'] == opened['version'] + 1
+            assert 'deadline_at_ms' not in closed
+            time.sleep(.3)
+            assert state(game)['version'] == closed['version']
+            print('Timer restart passed: settings and deadline persist, countdown resumes, overdue question closes exactly once before readiness.')
+        finally:
+            if process is not None: stop()
+
+if __name__ == '__main__': run()
