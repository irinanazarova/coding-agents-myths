+pub fn quiz(id: i64, title: &str, questions: &[Question], csrf: &str, history: &str) -> String {
+    let active = questions.iter().filter(|q| q.active).count();
+    let mut html = format!(
+        r#"<div class="breadcrumbs"><a href="/moderate">← All quizzes</a></div><div class="page-head"><div><h1>{}</h1><div class="meta mt-2">{active} of {} questions active · <a href="/moderate/quizzes/{id}/edit">Settings</a></div></div><div class="buttons"><form method="post" action="/moderate/quizzes/{id}/games">{}<button class="btn btn--pink" type="submit">Start a game</button></form><a class="btn btn--ghost" href="/moderate/quizzes/{id}/export">Export</a><a class="btn btn--ghost" href="/moderate/quizzes/{id}/preview">Preview</a></div></div><section class="section mt-0"><div class="section-head"><h2>Questions</h2><a class="btn" href="/moderate/quizzes/{id}/questions/new">Add question</a></div>"#,
+        escape(title),
+        questions.len(),
+        token(csrf)
+    );
+    if questions.is_empty() {
+        html.push_str(r#"<div class="empty"><h3>No questions yet</h3><p>Add your first question to bring this quiz to life.</p></div>"#);
+    }
+    html.push_str(r#"<ol class="question-list">"#);
+    let mut number = 0;
+    for (index, q) in questions.iter().enumerate() {
+        let path = format!("/moderate/quizzes/{id}/questions/{}", q.id);
+        let num = if q.active {
+            number += 1;
+            number.to_string()
+        } else {
+            "—".into()
+        };
