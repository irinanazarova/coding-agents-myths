+    format!(
+        r#"<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{} · Quizzy</title><link rel="stylesheet" href="/assets/quizzy.css"><link rel="stylesheet" href="/assets/app.css"><script src="/assets/app.js" defer></script></head><body><header class="admin-header"><a href="/moderate" class="logo admin-header__logo"><span class="logo__mark">?</span>Quizzy</a><span class="admin-header__tag">Moderator</span></header><main class="admin-main">{}</main></body></html>"#,
+        escape(title),
+        content
+    )
+}
+
+pub fn token(csrf: &str) -> String {
+    format!(r#"<input type="hidden" name="csrf" value="{csrf}">"#)
+}
+
+fn errors(messages: &[&str]) -> String {
+    if messages.is_empty() {
+        return String::new();
+    }
+    let mut html = String::from(r#"<div class="errors" role="alert"><ul>"#);
+    for message in messages {
+        write!(html, "<li>{}</li>", escape(message)).unwrap();
+    }
+    html.push_str("</ul></div>");
+    html
+}
