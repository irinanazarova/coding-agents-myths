+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn timer_fields_are_whole_nonnegative_numbers_with_checked_arithmetic() {
+        for (fields, expected) in [
+            (["0", "0"], [0, 0]),
+            (["1", "30"], [1, 30]),
+            (["0", "90"], [0, 90]),
+        ] {
+            assert_eq!(parse_timer(fields), Some(expected));
+        }
+        for fields in [
+            ["-1", "0"],
+            ["0", "-1"],
+            ["1.5", "0"],
+            ["", "0"],
+            ["0", "NaN"],
+            ["9223372036854775807", "0"],
+            ["0", "9223372036854775807"],
+        ] {
+            assert!(parse_timer(fields).is_none(), "{fields:?}");
+        }
+    }
+
+    #[test]
+    fn empty_correct_rows_do_not_count() {
+        let q = Question {
+            id: 0,
+            text: "Question".into(),
+            active: true,
+            options: vec![
+                OptionRow {
+                    text: "One".into(),
+                    correct: false,
+                },
+                OptionRow {
+                    text: "Two".into(),
+                    correct: false,
+                },
+                OptionRow {
+                    text: "  ".into(),
+                    correct: true,
+                },
+            ],
+        };
+        assert_eq!(
+            validate_question(&q),
+            vec!["Mark at least one option as correct"]
+        );
+    }
+    #[test]
+    fn multiple_correct_options_are_valid() {
+        let mut fields = Fields::new();
+        for (key, value) in [
+            ("question", "Question"),
+            ("option_2", "Two"),
+            ("option_1", "One"),
+            ("correct_1", "1"),
+            ("correct_2", "1"),
+        ] {
+            fields.insert(key.into(), value.into());
+        }
+        let q = parse_question(0, &fields);
+        assert!(validate_question(&q).is_empty());
+        assert_eq!(q.options[0].text, "One");
+        assert!(!q.active);
+    }
+    #[test]
+    fn database_cascades_and_keeps_order() {
+        let db = Connection::open_in_memory().unwrap();
+        db::initialize(&db).unwrap();
+        db.execute("INSERT INTO quizzes(title) VALUES ('Test')", [])
+            .unwrap();
+        db.execute("INSERT INTO questions(quiz_id,text,active,position) VALUES (1,'Second',0,1),(1,'First',1,0)", []).unwrap();
+        db::write_options(
+            &db,
