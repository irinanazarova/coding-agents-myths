diff --git a/assets/app.js b/assets/app.js
new file mode 100644
index 0000000..3a79824
--- /dev/null
+++ b/assets/app.js
@@ -0,0 +1,140 @@
+'use strict';
+
+// All destructive actions use the browser's native confirmation dialog.
+document.addEventListener('submit', (event) => {
+  const form = event.target;
+  if (form.dataset.confirm && !window.confirm(form.dataset.confirm)) event.preventDefault();
+});
+document.addEventListener('change', (event) => {
+  const form = event.target.closest('form[data-auto-submit]');
+  if (form) form.requestSubmit();
+});
+
+const rows = document.getElementById('option-rows');
+if (rows) {
+  function renumber() {
+    Array.from(rows.children).forEach((row, index) => {
+      const n = index + 1;
+      const text = row.querySelector('input:not([type=checkbox])');
+      text.id = text.name = `option_${n}`;
+      text.placeholder = `Option ${n}`;
+      text.setAttribute('aria-label', `Option ${n}`);
+      const label = row.querySelector('label.visually-hidden');
+      label.htmlFor = text.id;
+      label.textContent = `Option ${n}`;
+      const correct = row.querySelector('input[type=checkbox]');
+      correct.name = `correct_${n}`;
+      correct.setAttribute('aria-label', `Option ${n} is correct`);
+      const remove = row.querySelector('[data-remove-option]');
+      remove.setAttribute('aria-label', `Remove option ${n}`);
+      remove.title = `Remove option ${n}`;
+    });
+  }
+  document.getElementById('add-option').addEventListener('click', () => {
+    const row = document.createElement('div');
+    row.className = 'option-row';
+    // This is static markup only; moderator text is never injected as HTML.
+    row.innerHTML = '<label class="visually-hidden"></label><input class="input"><label class="checkbox"><input type="checkbox" value="1"> Correct</label><button class="btn btn--danger btn--icon" type="button" data-remove-option>✕</button>';
+    rows.append(row);
+    renumber();
+    row.querySelector('.input').focus();
+  });
+  rows.addEventListener('click', (event) => {
+    const remove = event.target.closest('[data-remove-option]');
+    if (remove) {
+      remove.closest('.option-row').remove();
+      renumber();
+    }
+  });
+}
+
+const preview = document.getElementById('preview');
+if (preview) {
+  const questions = JSON.parse(document.getElementById('preview-data').textContent);
+  let index = 0;
+  let score = 0;
+  let answered = false;
+  let finished = false;
+
+  function el(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  }
+  function button(text, className, action) {
+    const node = el('button', className, text);
+    node.type = 'button';
+    node.addEventListener('click', action);
+    return node;
+  }
+  function startOver() {
+    index = 0; score = 0; answered = false; finished = false;
+    render();
+  }
+  function letter(n) {
+    let result = '';
+    do { result = String.fromCharCode(65 + n % 26) + result; n = Math.floor(n / 26) - 1; } while (n >= 0);
+    return result;
+  }
+  function render() {
+    preview.replaceChildren();
+    if (!questions.length) {
+      preview.append(el('h2', 'play-question__body', 'No active questions'), el('p', 'meta', 'Add or activate a question to try this quiz.'));
+      return;
+    }
+    if (finished) {
+      const result = el('div', 'result-card preview-result');
+      result.append(el('p', 'meta', 'Preview complete'), el('h2', '', `Score: ${score}/${questions.length}`));
+      result.append(button('Start over', 'btn btn--pink', startOver));
+      preview.append(result);
+      return;
+    }
+    const question = questions[index];
+    preview.append(el('div', 'play-question__num', `Question ${index + 1} of ${questions.length}`));
+    const heading = el('h2', 'play-question__body', question.text);
+    preview.append(heading);
+    const options = el('div', 'play-options');
+    const status = el('div', 'play-status');
+    status.setAttribute('role', 'status');
+    status.hidden = true;
+    const actions = el('div', 'preview-actions');
+    const next = button(index + 1 === questions.length ? 'See score' : 'Next question', 'btn btn--pink', () => {
+      if (!answered) return;
+      if (index + 1 === questions.length) finished = true;
+      else { index += 1; answered = false; }
+      render();
+    });
+    next.hidden = true;
+    actions.append(next, button('Start over', 'btn btn--ghost', startOver));
+    question.options.forEach((option, optionIndex) => {
+      const choice = button('', 'play-option', () => {
+        if (answered) return;
+        answered = true;
+        if (option.correct) score += 1;
+        Array.from(options.children).forEach((node, i) => {
+          node.disabled = true;
+          if (question.options[i].correct) {
+            node.classList.add('is-correct');
+            node.append(el('span', 'option-result', '✓ Correct'));
+          }
+          if (i === optionIndex) {
+            node.classList.add('is-picked');
+            if (!option.correct) node.classList.add('is-wrong');
+          }
+        });
+        status.textContent = option.correct ? 'Correct!' : 'Wrong!';
+        status.className = `play-status ${option.correct ? 'play-status--right' : 'play-status--wrong'}`;
+        status.hidden = false;
+        next.hidden = false;
+        next.focus();
+      });
+      const optionLetter = el('span', 'play-option__letter', letter(optionIndex));
+      optionLetter.setAttribute('aria-hidden', 'true');
+      choice.append(optionLetter, el('span', 'play-option__title', option.text));
+      options.append(choice);
+    });
+    preview.append(options, status, actions);
+  }
+  render();
+}
diff --git a/assets/live.css b/assets/live.css
new file mode 100644
index 0000000..758c740
--- /dev/null
+++ b/assets/live.css
@@ -0,0 +1,56 @@
+/* Keep game views local, high-contrast and usable on a phone or a conference screen. */
+.live-screen { background: var(--c-blue); color: var(--c-lavender); gap: 30px; }
+.live-screen .screen-title { margin-left: auto; overflow-wrap: anywhere; }
+.moderator-tag { font: 600 14px/1 var(--f-body); opacity: .75; }
+.live-screen .lobby__title { color: var(--c-sun); }
+.qr img { width: 100%; height: 100%; display: block; }
+.correct-label { font-size: .55em; font-weight: 800; background: var(--c-success); color: white; padding: .4em .65em; border-radius: 100px; }
+.live-screen .stage-option__title { min-width: 0; }
+.live-screen .stage-option__count { margin-left: auto; }
+.live-screen #live-error { font-size: 14px; max-width: 260px; }
+.live-player #connection-status { font-size: 13px; }
+.live-player .play-options { list-style: none; margin: 0; padding: 0; }
+.live-player .player-greeting { font-weight: 700; margin-bottom: 18px; overflow-wrap: anywhere; }
+.live-player .waiting { margin: auto 0; padding: 40px 0; }
+.live-player .play-option__mark { white-space: normal; max-width: 75px; }
+.live-player .answer-hint, .live-player .waiting-next { margin-top: 18px; }
+.live-player .play-status { margin-top: 24px; }
+.live-player #live-error { padding: 14px; border: 2px solid var(--c-pink); border-radius: 12px; }
+.game-list { list-style: none; padding: 0; display: grid; gap: 12px; }
+.game-item { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 0; }
+@media (max-width: 600px) {
+  .live-screen .screen-title { font-size: 16px; }
+  .moderator-tag { display: none; }
+  .screen-controls { flex-wrap: wrap; }
+  .screen-controls__info { gap: 12px; font-size: 14px; }
+  .live-screen { padding-bottom: 155px; }
+  .live-screen .lobby__title { font-size: 48px; }
+  .live-screen .lobby__url { font-size: 26px; }
+  .stage-option { flex-wrap: wrap; }
+  .correct-label { font-size: 14px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .waiting__gem { animation: none; }
+}
+
+/* Final standings stay readable on both a projected display and a phone. */
+.live-screen .leaderboard-title { color: var(--c-lavender); margin: 20px 0; }
+.leaderboard { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
+.leaderboard__row { display: flex; align-items: center; gap: 20px; border-radius: 14px; padding: 16px 22px; background: rgba(255,255,255,.08); font-size: clamp(18px, 2vw, 30px); }
+.leaderboard__place { color: var(--c-sun); font-weight: 800; min-width: 1.5em; }
+.leaderboard__name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
+.leaderboard__points { white-space: nowrap; }
+.leaderboard__row.is-winner { box-shadow: inset 0 0 0 2px var(--c-sun); }
+.winner-mark { border-radius: 100px; background: var(--c-sun); color: var(--c-blue); font-size: .65em; font-weight: 800; padding: .4em .7em; }
+.final-place { color: var(--c-blue); font-size: clamp(28px, 7vw, 42px); margin: 32px 0 12px; }
+.final-points { font-size: 26px; font-weight: 700; }
+.final-winner { font-size: 36px; font-weight: 800; color: var(--c-success); margin: 24px 0; }
+@media (max-width: 650px) {
+  .leaderboard__row { gap: 10px; padding: 12px; flex-wrap: wrap; }
+  .leaderboard__name { flex-basis: 40%; }
+  .winner-mark { margin-left: auto; }
+}
+
+.stage-question-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
+.stage-question-heading .stage-question__num { margin-bottom: 0; }
+.question-countdown { color: var(--c-sun); font-size: clamp(32px, 4vw, 60px); font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.2; white-space: nowrap; }
diff --git a/assets/live.js b/assets/live.js
new file mode 100644
index 0000000..9c78e62
--- /dev/null
+++ b/assets/live.js
@@ -0,0 +1,333 @@
+'use strict';
+(() => {
+  const config = JSON.parse(document.getElementById('live-config').textContent);
+  if (!config) return;
+  const moderator = config.role === 'moderator';
+  const content = document.getElementById('live-content');
+  const controls = document.getElementById('live-controls');
+  const counter = document.getElementById('live-counter');
+  const connection = document.getElementById('connection-status');
+  let current = null;
+  let renderedVersion = null;
+  let source = null;
+  let polling = null;
+  let pending = null;
+  let sending = false;
+  let controlBusy = false;
+  let heartbeat = null;
+  let answerRetry = 500;
+  let countdownUntil = null;
+  let timerSample = null;
+  let liveError = document.getElementById('live-error');
+  if (!liveError) {
+    liveError = document.createElement('p');
+    liveError.id = 'live-error';
+    liveError.setAttribute('role', 'alert');
+    liveError.hidden = true;
+    document.querySelector('.screen-controls__info').append(liveError);
+  }
+  function el(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  }
+  function button(text, className, action) {
+    const node = el('button', className, text);
+    node.type = 'button';
+    node.addEventListener('click', action);
+    return node;
+  }
+  function letter(n) {
+    let result = '';
+    do { result = String.fromCharCode(65 + n % 26) + result; n = Math.floor(n / 26) - 1; } while (n >= 0);
+    return result;
+  }
+  function error(message) {
+    liveError.textContent = message;
+    liveError.hidden = !message;
+  }
+  async function fetchWithTimeout(url, options = {}) {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), 8000);
+    try { return await fetch(url, {...options, signal: controller.signal, cache: 'no-store'}); }
+    finally { clearTimeout(timer); }
+  }
+  async function post(suffix, data) {
+    const response = await fetchWithTimeout(config.base + suffix, {
+      method: 'POST', headers: {Accept: 'application/json'},
+      body: new URLSearchParams({csrf: config.csrf, ...data})
+    });
+    if (!response.ok && response.status !== 409) throw new Error('Request failed');
+    return response.status === 204 ? null : await response.json();
+  }
+  function adopt(state) {
+    if (current && state.version < current.version) return;
+    // A poll started before joining must not undo a successful remembered identity.
+    if (!moderator && current?.name && !state.name) return;
+    if (current && state.version === current.version && !moderator && state.answer_version < current.answer_version) return;
+    if (moderator) {
+      if (state.phase === 'open' && Number.isFinite(state.deadline_at_ms)) {
+        // Server-relative time avoids relying on the conference computer's clock.
+        // New snapshots never reset the duration: they carry the persisted deadline.
+        if (!timerSample || timerSample.deadline !== state.deadline_at_ms || state.server_now_ms >= timerSample.now) {
+          countdownUntil = performance.now() + Math.max(0, state.deadline_at_ms - state.server_now_ms);
+          timerSample = {deadline: state.deadline_at_ms, now: state.server_now_ms};
+        }
+      } else { countdownUntil = null; timerSample = null; }
+    }
+    current = state;
+    if (pending && (state.phase !== 'open' || state.question?.id !== pending.question)) { pending = null; error(''); }
+    if (state.phase === 'ended') {
+      clearInterval(heartbeat); heartbeat = null;
+      error('');
+    }
+    render();
+  }
+  function tickCountdown() {
+    const node = document.getElementById('live-timer');
+    if (!node || countdownUntil === null) return;
+    const remaining = Math.max(0, Math.ceil((countdownUntil - performance.now()) / 1000));
+    const text = `${Math.floor(remaining / 60)}:${String(remaining % 60).padStart(2, '0')}`;
+    if (node.textContent !== text) node.textContent = text;
+  }
+  if (moderator) setInterval(tickCountdown, 100);
+  async function command(action) {
+    if (controlBusy) return;
+    controlBusy = true;
+    render();
+    try { adopt(await post('/control', {action, version: current.version})); error(''); }
+    catch (_) { error('Connection lost. Try again when reconnected.'); refresh(); }
+    finally { controlBusy = false; render(); }
+  }
+  function pick(question, option) {
+    pending = {question, option};
+    render();
+    sendAnswer();
+  }
+  async function sendAnswer() {
+    if (sending || !pending) return;
+    sending = true;
+    const intent = pending;
+    try {
+      const state = await post('/answer', intent);
+      if (pending === intent) pending = null;
+      answerRetry = 500;
+      error('');
+      adopt(state);
+    } catch (_) {
+      if (pending && current.phase === 'open') {
+        error('Connection lost. Retrying your answer…');
+        await new Promise(resolve => setTimeout(resolve, answerRetry + Math.random() * 500));
+        answerRetry = Math.min(answerRetry * 2, 8000);
+      } else { error(''); }
+    } finally {
+      sending = false;
+      if (pending) sendAnswer();
+    }
+  }
+  function render() {
+    const state = current;
+    if (!state) return;
+    // Do not replace a join form while a visitor is typing their name.
+    if (!moderator && !state.name && state.phase !== 'ended' && content.querySelector('.join-form')) return;
+    if (counter) {
+      counter.textContent = state.phase === 'open' ? `Answers: ${state.answers} / ${state.players}` : `Players: ${state.players}`;
+      counter.hidden = state.phase === 'waiting' || state.phase === 'ended';
+    }
+    if (moderator && renderedVersion === state.version) {
+      const lobbyPlayers = content.querySelector('.lobby-players');
+      if (lobbyPlayers) lobbyPlayers.textContent = `Players: ${state.players}`;
+      controls.querySelectorAll('button').forEach(node => { node.disabled = controlBusy; });
+      return;
+    }
+    renderedVersion = state.version;
+    content.replaceChildren();
+    controls?.replaceChildren();
+    if (state.phase === 'ended') {
+      content.append(el('h1', moderator ? 'lobby__title' : 'play-title', 'The quiz is over'));
+      const points = n => `${n} ${n === 1 ? 'point' : 'points'}`;
+      if (moderator) {
+        content.append(el('h2', 'leaderboard-title', 'Leaderboard'));
+        const board = el('ol', 'leaderboard');
+        board.setAttribute('aria-label', 'Leaderboard');
+        for (const player of state.leaderboard || []) {
+          const row = el('li', 'leaderboard__row' + (player.winner ? ' is-winner' : ''));
+          row.dataset.playerId = player.id;
+          const place = el('span', 'leaderboard__place', String(player.place));
+          place.setAttribute('aria-label', `Place ${player.place}`);
+          row.append(place, el('span', 'leaderboard__name', player.name), el('span', 'leaderboard__points', points(player.points)));
+          if (player.winner) row.append(el('span', 'winner-mark', 'Winner'));
+          board.append(row);
+        }
+        if (!state.leaderboard?.length) content.append(el('p', '', 'No players joined this game.'));
+        content.append(board);
+        for (const [text, action, style] of [[`Top ${state.number_of_winners}`, 'top', 'btn--sun'], ['Draw', 'draw', 'btn--pink'], ['Reset winners', 'reset', 'btn--ghost']]) {
+          const control = button(text, 'btn ' + style, () => command(action));
+          control.disabled = controlBusy;
+          controls.append(control);
+        }
+      } else if (state.name && state.place !== undefined) {
+        content.append(el('p', 'player-greeting', `Hi, ${state.name}!`));
+        content.append(el('h2', 'final-place', `Place ${state.place} of ${state.total_players}`));
+        content.append(el('p', 'final-points', points(state.points)));
+        const result = el('p', 'final-winner', state.winner ? 'You won!' : '');
+        result.setAttribute('role', 'status');
+        content.append(result);
+      }
+      return;
+    }
+    if (moderator && state.phase === 'waiting') {
+      const lobby = el('section', 'lobby');
+      const intro = el('div');
+      intro.append(el('h1', 'lobby__title', state.title), el('p', 'lobby__join', 'Join the quiz on your phone'), el('p', 'lobby__url', config.url));
+      const players = el('p', 'counter-pill lobby-players', `Players: ${state.players}`);
+      players.setAttribute('role', 'status');
+      intro.append(players);
+      if (!state.total) intro.append(el('p', '', 'No active questions. Starting will end this game.'));
+      const qr = el('div', 'qr');
+      const image = el('img');
+      image.src = config.base + '/qr.svg';
+      image.alt = 'QR code for joining the game';
+      qr.append(image);
+      lobby.append(intro, qr);
+      content.append(lobby);
+      const start = button('Start', 'btn btn--sun', () => command('start'));
+      start.disabled = controlBusy;
+      controls.append(start);
+      return;
+    }
+    if (!moderator && !state.name) {
+      content.append(el('h1', 'play-title', state.title), el('p', 'play-lead', 'Join the live quiz'));
+      const form = el('form', 'join-form');
+      form.method = 'post'; form.action = config.base;
+      const label = el('label', '', 'Your name'); label.htmlFor = 'player-name';
+      const input = el('input', 'input');
+      input.id = 'player-name'; input.name = 'name'; input.placeholder = 'Your name';
+      input.setAttribute('aria-label', 'Your name'); input.required = true; input.maxLength = 80; input.autocomplete = 'nickname';
+      const token = el('input'); token.type = 'hidden'; token.name = 'csrf'; token.value = config.csrf;
+      const join = el('button', 'btn btn--pink', 'Join'); join.type = 'submit';
+      form.append(label, input, token, join);
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (join.disabled) return;
+        if (!input.value.trim()) { error('Enter your name.'); input.focus(); return; }
+        join.disabled = true;
+        try {
+          const result = await post('', {name: input.value});
+          config.csrf = result.csrf;
+          error('');
+          adopt(result.state);
+          connect(); startHeartbeat();
+        } catch (_) {
+          error('Could not join. Check your connection and try again.');
+          refresh();
+        } finally { join.disabled = false; }
+      });
+      content.append(form);
+      return;
+    }
+    if (!moderator) content.append(el('p', 'player-greeting', `Hi, ${state.name}!`));
+    if (state.phase === 'waiting') {
+      const waiting = el('div', 'waiting');
+      waiting.append(el('div', 'waiting__gem', '?'), el('h1', 'play-title', state.title), el('p', 'play-lead', 'Waiting for the quiz to start…'));
+      content.append(waiting);
+      return;
+    }
+    const question = state.question;
+    if (!question) return;
+    const heading = el('div', moderator ? 'stage-question-heading' : '');
+    heading.append(el('div', moderator ? 'stage-question__num' : 'play-question__num', `Question ${state.number} of ${state.total}`));
+    if (moderator && state.phase === 'open' && countdownUntil !== null) {
+      const timer = el('span', 'question-countdown');
+      timer.id = 'live-timer';
+      timer.setAttribute('aria-label', 'Time remaining');
+      heading.append(timer);
+    }
+    content.append(heading);
+    tickCountdown();
+    content.append(el('h1', moderator ? 'stage-question__body' : 'play-question__body', question.text));
+    const closed = state.phase === 'closed';
+    const options = el('ul', moderator ? 'stage-options' + (closed ? ' stage-options--results' : '') : 'play-options' + (closed ? ' is-locked is-revealed' : ''));
+    const selected = pending?.question === question.id ? pending.option : state.answer;
+    question.options.forEach((option, i) => {
+      const row = el('li', moderator ? 'stage-option' : 'player-option-item');
+      row.dataset.optionId = option.id;
+      const node = moderator ? row : button('', 'play-option', () => pick(question.id, option.id));
+      if (!moderator) node.setAttribute('aria-label', option.text);
+      const prefix = moderator ? 'stage-option' : 'play-option';
+      node.append(el('span', prefix + '__letter', letter(i)), el('span', prefix + '__title', option.text));
+      if (!moderator) {
+        node.disabled = closed;
+        node.setAttribute('aria-pressed', String(selected === option.id));
+        if (selected === option.id) {
+          node.classList.add('is-picked');
+          node.append(el('span', 'play-option__mark', 'Your answer'));
+        }
+        row.append(node);
+      }
+      if (closed && option.correct) {
+        node.classList.add('is-correct');
+        if (moderator) node.append(el('span', 'correct-label', 'Correct'));
+      }
+      if (moderator && closed) {
+        const count = el('span', 'stage-option__count', String(option.count));
+        count.setAttribute('aria-label', `${option.count} answers`);
+        node.append(count);
+      }
+      options.append(row);
+    });
+    content.append(options);
+    if (moderator) {
+      const action = closed ? (state.number === state.total ? 'end' : 'next') : 'finish';
+      const text = closed ? (state.number === state.total ? 'End quiz' : 'Next') : 'Finish';
+      const control = button(text, 'btn btn--sun', () => command(action));
+      control.disabled = controlBusy;
+      controls.append(control);
+    } else if (closed) {
+      const result = el('p', 'play-status ' + (state.result === 'Correct!' ? 'play-status--right' : state.result === 'Wrong!' ? 'play-status--wrong' : 'play-status--neutral'), state.result);
