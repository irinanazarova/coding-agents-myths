+fn parse_question(id: i64, fields: &Fields) -> Question {
+    let mut numbers: Vec<usize> = fields
+        .keys()
+        .filter_map(|key| key.strip_prefix("option_")?.parse().ok())
+        .collect();
+    numbers.sort_unstable();
+    let options = numbers
+        .into_iter()
+        .map(|n| OptionRow {
+            text: field(fields, &format!("option_{n}")).into(),
+            correct: field(fields, &format!("correct_{n}")) == "1",
+        })
+        .collect();
+    Question {
+        id,
+        text: field(fields, "question").into(),
+        active: field(fields, "active") == "1",
+        options,
+    }
+}
