+#!/usr/bin/env python3
+"""Prize/scoring regression using real HTTP and SSE (no third-party packages)."""
+import json, sqlite3, time
+from smoke import request, csrf, AUTH
+from live import Player, Events
+
+
+def run():
+    token = csrf(request('/moderate/quizzes/new')[2])
+    assert 'Number of winners' in request('/moderate/quizzes/new')[2], 'Missing Number of winners setting'
+    for invalid in ['0', '-1', '1.5', '', 'invalid', '9223372036854775808']:
+        assert request('/moderate/quizzes', {'csrf': token, 'title': 'Invalid prizes', 'number_of_winners': invalid})[0] == 422
+    status, headers, _ = request('/moderate/quizzes', {'csrf': token, 'title': 'Prize regression', 'number_of_winners': '2'})
+    assert status == 303
+    quiz = headers['Location']; games = []; streams = []
+    try:
+        assert 'value="2"' in request(quiz + '/edit')[2]
+        for i in range(3):
+            assert request(quiz + '/questions', {'csrf': token, 'question': f'Prize question {i+1}', 'active': '1', 'option_1': 'Right', 'correct_1': '1', 'option_2': 'Wrong'})[0] == 303
+        def new_game():
+            status, headers, _ = request(quiz + '/games', {'csrf': token}); assert status == 303
+            path = headers['Location']; games.append(path); return path
+        path = new_game(); code = path.split('/')[-1]
+        def command(action, expected=None):
+            version = json.loads(request(path + '/state')[2])['version'] if expected is None else expected
+            status, _, body = request(path + '/control', {'csrf': token, 'action': action, 'version': version})
+            return status, json.loads(body)
+        def control(action):
+            status, state = command(action); assert status == 200, (action, state); return state
+        assert command('top')[0] == 409, 'No prizes during play'
+        players = [Player(code) for _ in range(5)]
+        for p, name in zip(players, ['Alice', 'Bob', 'Carol', 'Dave', 'Eve']): p.join(name)
+        alice, bob, carol, dave, eve = players
+        mod = Events(path + '/events', AUTH); streams.append(mod); mod.next()
+        phones = []
+        for p in players:
+            stream = Events(p.path + '/events', cookie=p.cookie); streams.append(stream); stream.next(); phones.append(stream)
+        for i in range(3):
+            started = time.monotonic(); state = control('start' if i == 0 else 'next')
+            for stream in [mod] + phones: stream.until(lambda s: s['version'] == state['version'])
+            assert time.monotonic() - started < 1.5, 'Question fan-out should be immediate'
+            q = state['question']; right, wrong = [o['id'] for o in q['options']]
+            for p in players:
+                s = p.state(); assert not any(k in s for k in ['points', 'place', 'leaderboard', 'winner'])
+            if i == 0:
+                alice.answer(q['id'], right); carol.answer(q['id'], right)
+                time.sleep(.1); bob.answer(q['id'], right)
+                time.sleep(.1); dave.answer(q['id'], right)
+                time.sleep(.1); carol.answer(q['id'], wrong); carol.answer(q['id'], right)
+            elif i == 1:
+                for p in [alice, bob, carol, dave]: p.answer(q['id'], right)
+            else:
+                alice.answer(q['id'], right)
+                for p in [bob, carol, dave, eve]:
+                    p.answer(q['id'], right); p.answer(q['id'], wrong)
+            closed = control('finish')
+            assert 'points' not in alice.state(), 'No running scores even after Finish'
+            assert eve.answer(q['id'], right)[0] == 409
+        ended = control('end')
+        for stream in [mod] + phones: stream.until(lambda s: s['version'] == ended['version'])
+        board = ended['leaderboard']
+        assert [p['name'] for p in board] == ['Alice', 'Bob', 'Dave', 'Carol', 'Eve'], board
+        assert [p['points'] for p in board] == [3, 2, 2, 2, 0]
+        assert [p['place'] for p in board] == [1, 2, 3, 4, 5]
+        assert carol.state()['place'] == 4 and eve.state()['points'] == 0
+        assert alice.state()['total_players'] == 5 and 'leaderboard' not in alice.state()
+        stale = ended['version']
+        top = control('top'); assert [p['name'] for p in top['leaderboard'] if p['winner']] == ['Alice', 'Bob']
+        for p, stream in zip(players, phones):
+            live = stream.until(lambda s: s['version'] == top['version'])
+            assert live['winner'] == (p in [alice, bob])
+        assert command('reset', stale)[0] == 409, 'Stale prize command cannot overwrite winners'
+        for _ in range(36):
+            draw = control('draw'); winners = [p['name'] for p in draw['leaderboard'] if p['winner']]
+            assert len(winners) == 2 and 'Alice' in winners and 'Eve' not in winners
+            for p, stream in zip(players, phones):
+                live = stream.until(lambda s: s['version'] == draw['version'])
+                assert live['winner'] == (live['name'] in winners)
+        reset = control('reset'); assert not any(p['winner'] for p in reset['leaderboard'])
+        for stream in phones: assert not stream.until(lambda s: s['version'] == reset['version'])['winner']
+        # Setting changes affect new games only. N > positive scores awards everyone with points.
+        request(quiz, {'csrf': token, 'title': 'Prize regression', 'number_of_winners': '20'})
+        assert json.loads(request(path + '/state')[2])['number_of_winners'] == 2
+        path = new_game(); code = path.split('/')[-1]
+        positive, zero = Player(code), Player(code); positive.join('Positive'); zero.join('Zero')
+        q = control('start')['question']; positive.answer(q['id'], q['options'][0]['id']); control('finish')
+        for _ in range(2): control('next'); control('finish')
+        control('end')
+        for action in ['top', 'draw']:
+            assert [p['name'] for p in control(action)['leaderboard'] if p['winner']] == ['Positive']
+        control('reset')
+        # No players and all-zero players also end and draw safely.
+        path = new_game(); code = path.split('/')[-1]; Player(code).join('No points')
+        control('start'); control('finish')
+        for _ in range(2): control('next'); control('finish')
+        control('end'); assert not any(p['winner'] for p in control('draw')['leaderboard'])
+        path = new_game(); control('start'); control('finish')
+        for _ in range(2): control('next'); control('finish')
+        assert control('end')['leaderboard'] == []
+        assert control('top')['leaderboard'] == []
+        print('Prizes HTTP/SSE passed: timing, changed picks, no running scores, ranking, live Top/Draw/Reset, cutoff ties, zero scores, snapshot settings, empty games.')
+    finally:
+        for stream in streams: stream.close()
+        request(quiz + '/delete', {'csrf': token})
+        with sqlite3.connect('storage/quizzy.sqlite3') as db:
+            db.execute('PRAGMA foreign_keys=ON')
+            for game in games: db.execute('DELETE FROM games WHERE code=?', (game.split('/')[-1],))
+
+if __name__ == '__main__': run()
