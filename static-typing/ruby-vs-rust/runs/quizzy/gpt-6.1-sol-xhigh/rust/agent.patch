--- /dev/null
+++ b/docs/timers.md
@@ -0,0 +1,45 @@
+# Persistent per-question timers
+
+- Preparation quizzes have `timer_minutes` and `timer_seconds`, both nonnegative
+  integers defaulting to zero. Seconds above 59 are accepted as extra duration.
+  Form validation uses checked integer arithmetic; bad settings re-render the
+  entered values without changing the saved quiz. Older title-only clients keep
+  the current timer, just as they keep the prize settings.
+- New games snapshot the combined duration in `games.timer_seconds`. Quiz edits
+  and deletes cannot alter this or any other game snapshot.
+- Opening a question (Start or Next) sets its `opened_at_us` and nullable
+  `closes_at_us` in the same transaction as phase/current/version. A zero duration
+  produces no deadline. GETs and reconnects never write a new opening timestamp.
+- A server task checks deadlines every 100 ms. A single SQLite UPDATE closes only
+  due **current**, **open** questions and increments their game version exactly
+  once. It cannot advance, end, or double-finish a game. It pushes the same phase
+  notification and uses the same result rendering as manual Finish.
+- Requests for state, answers and controls also check expiry under the shared
+  database mutex, so answers at/after the deadline cannot sneak in between worker
+  ticks. Answer acceptance explicitly checks the deadline too. Manual Finish,
+  automatic Finish, and answers are serialized by that mutex. Stale control
+  versions receive fresh state with HTTP 409.
+- Startup closes overdue questions before binding the listener. Unexpired
+  questions resume with their original absolute deadlines. The timer task stops
+  during graceful shutdown, alongside the existing SSE shutdown handling.
+- Only an open moderator state contains `deadline_at_ms` and `server_now_ms`.
+  The browser uses their difference anchored to `performance.now()`, not its
+  potentially misconfigured wall clock, and displays ceiling seconds in M:SS.
+  Countdown ticks update only the timer text; they do not request state or cause
+  server fan-out. Players receive neither field and create no countdown widget.
+  The server, not browser JavaScript, performs Finish.
+- `QuizContents` remains unchanged: exports contain title/questions/options only.
+  Imports use database defaults and ignore any supplied timer settings.
+- Migrations are additive/idempotent. Legacy quizzes and games have zero duration;
+  old open questions with no deadline remain manually controlled.
+
+## Regression coverage
+
+`cargo test --offline --locked` exercises exact deadline boundaries, old-deadline
+isolation after Next, early Finish, zero/legacy behavior, privacy, input overflow,
+and migration idempotence. `tests/timer.py` tests real HTTP/SSE auto-Finish with no
+moderator browser, settings, refresh, imports/exports and all timer modes.
+`tests/timer_browser.py` uses actual Chromium to verify exact labels, ticking and
+M:SS formats, reload, early/automatic Finish, Next, phone privacy and layout.
+`tests/timer_persistence.py` restarts an isolated release server before and after
+expiry to check settings, continued deadlines and startup recovery.
diff --git a/src/contents.rs b/src/contents.rs
new file mode 100644
index 0000000..fe1a81b
--- /dev/null
+++ b/src/contents.rs
@@ -0,0 +1,284 @@
+//! Portable quiz contents, deliberately separate from database rows/IDs.
+use crate::{
+    db::{self, OptionRow, Question},
+    questions::{normalize_question, validate_question},
+};
+use rusqlite::{Connection, params};
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Deserialize, Serialize)]
+pub struct QuizContents {
+    title: String,
+    questions: Vec<QuestionContents>,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+struct QuestionContents {
+    text: String,
+    #[serde(default = "default_active")]
+    active: bool,
+    options: Vec<OptionContents>,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+struct OptionContents {
+    text: String,
+    #[serde(default)]
+    correct: bool,
+}
+
+fn default_active() -> bool {
+    true
+}
+
+impl QuizContents {
+    pub fn from_quiz(title: String, questions: Vec<Question>) -> Self {
+        Self {
+            title,
+            questions: questions
+                .into_iter()
+                .map(|q| QuestionContents {
+                    text: q.text,
+                    active: q.active,
+                    options: q
+                        .options
+                        .into_iter()
+                        .map(|o| OptionContents {
+                            text: o.text,
+                            correct: o.correct,
+                        })
+                        .collect(),
+                })
+                .collect(),
+        }
+    }
+}
+
+// Serde's derived struct deserializer also accepts positional arrays. JSON
+// contents must use objects at each level, not that alternate representation.
+fn check_object_shapes(json: &str) -> Result<(), Vec<String>> {
+    let value: serde_json::Value =
+        serde_json::from_str(json).map_err(|error| vec![format!("Invalid Quiz JSON: {error}")])?;
+    if !value.is_object() {
+        return Err(vec!["Invalid Quiz JSON: Quiz must be an object".into()]);
+    }
+    if let Some(questions) = value.get("questions").and_then(serde_json::Value::as_array) {
+        for (index, question) in questions.iter().enumerate() {
+            if !question.is_object() {
+                return Err(vec![format!(
+                    "Invalid Quiz JSON: Question {} must be an object",
+                    index + 1
+                )]);
+            }
+            if let Some(options) = question
+                .get("options")
+                .and_then(serde_json::Value::as_array)
+            {
+                for (option_index, option) in options.iter().enumerate() {
+                    if !option.is_object() {
+                        return Err(vec![format!(
+                            "Invalid Quiz JSON: Question {}, option {} must be an object",
+                            index + 1,
+                            option_index + 1
+                        )]);
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Parse and validate *all* contents before any database writes.
+/// Missing fields/types are JSON errors, except the two optional boolean flags.
+pub fn parse(json: &str) -> Result<(String, Vec<Question>), Vec<String>> {
+    check_object_shapes(json)?;
+    let contents: QuizContents =
+        serde_json::from_str(json).map_err(|error| vec![format!("Invalid Quiz JSON: {error}")])?;
+    let mut messages = Vec::new();
+    if contents.title.trim().is_empty() {
+        messages.push("Title is required".to_owned());
+    }
+    let mut questions: Vec<_> = contents
+        .questions
+        .into_iter()
+        .map(|q| Question {
+            id: 0,
+            text: q.text,
+            active: q.active,
+            options: q
+                .options
+                .into_iter()
+                .map(|o| OptionRow {
+                    text: o.text,
+                    correct: o.correct,
+                })
+                .collect(),
+        })
+        .collect();
+    for (index, question) in questions.iter_mut().enumerate() {
+        for message in validate_question(question) {
+            messages.push(format!("Question {}: {message}", index + 1));
+        }
+        normalize_question(question);
+    }
+    if messages.is_empty() {
+        Ok((contents.title.trim().into(), questions))
+    } else {
+        Err(messages)
+    }
+}
+
+/// Always create a new quiz; roll back every row if any database write fails.
+pub fn insert(db: &mut Connection, title: &str, questions: &[Question]) -> rusqlite::Result<i64> {
+    let tx = db.transaction()?;
+    tx.execute("INSERT INTO quizzes(title) VALUES (?)", [title])?;
+    let id = tx.last_insert_rowid();
+    for (position, q) in questions.iter().enumerate() {
+        tx.execute(
+            "INSERT INTO questions(quiz_id, text, active, position) VALUES (?, ?, ?, ?)",
+            params![id, q.text, q.active, position as i64],
+        )?;
+        db::write_options(&tx, tx.last_insert_rowid(), &q.options)?;
+    }
+    tx.commit()?;
+    Ok(id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::{Value, json};
+
+    fn sample() -> Value {
+        json!({"title": "Quiz", "questions": [
+            {"text": "First", "options": [{"text":"A"}, {"text":"B", "correct":true}]},
+            {"text": "Second", "active":false, "options": [{"text":"C", "correct":true}, {"text":"D"}]}
+        ]})
+    }
+
+    #[test]
+    fn round_trip_has_only_contents_and_explicit_flags() {
+        let (title, questions) = parse(&sample().to_string()).unwrap();
+        let mut db = Connection::open_in_memory().unwrap();
+        db::initialize(&db).unwrap();
+        let id = insert(&mut db, &title, &questions).unwrap();
+        let duplicate = insert(&mut db, &title, &questions).unwrap();
+        assert_ne!(id, duplicate);
+        let exported = serde_json::to_value(QuizContents::from_quiz(
+            db::title(&db, id).unwrap().unwrap(),
+            db::questions(&db, id).unwrap(),
+        ))
+        .unwrap();
+        let mut expected = sample();
+        expected["questions"][0]["active"] = json!(true);
+        expected["questions"][0]["options"][0]["correct"] = json!(false);
+        expected["questions"][1]["options"][1]["correct"] = json!(false);
+        assert_eq!(exported, expected);
+    }
+
+    #[test]
+    fn empty_quiz_is_valid() {
+        let (title, questions) = parse(r#"{"title":" Empty ","questions":[]}"#).unwrap();
+        assert_eq!(title, "Empty");
+        assert!(questions.is_empty());
+    }
+
+    #[test]
+    fn form_normalization_and_multiple_correct_answers() {
+        let input = json!({"title":" Quiz ","questions":[{"text":" Q ","options":[
+            {"text":" ","correct":true}, {"text":" A ","correct":true}, {"text":" B ","correct":true}
+        ]}]});
+        let (title, questions) = parse(&input.to_string()).unwrap();
+        assert_eq!(title, "Quiz");
+        assert_eq!(questions[0].text, "Q");
+        assert_eq!(questions[0].options.len(), 2);
+        assert_eq!(questions[0].options[0].text, "A");
+        assert_eq!(questions[0].options[1].text, "B");
+        assert!(questions[0].options.iter().all(|o| o.correct));
+    }
+
+    #[test]
+    fn errors_identify_question_and_ignore_empty_correct_rows() {
+        let mut input = sample();
+        input["questions"][1]["text"] = json!(" ");
+        input["questions"][1]["options"] = json!([
+            {"text":"A"}, {"text":"B"}, {"text":"  ","correct":true}
+        ]);
+        let errors = parse(&input.to_string()).unwrap_err();
+        assert_eq!(
+            errors,
+            [
+                "Question 2: Question is required",
+                "Question 2: Mark at least one option as correct"
+            ]
+        );
+    }
+
+    #[test]
+    fn rejects_malformed_missing_and_wrongly_typed_fields() {
+        for input in [
+            "",
+            "{",
+            "null",
+            "[]",
+            "{}",
+            r#"{"title":"Q"}"#,
+            r#"{"title":"Q","questions":null}"#,
+            r#"{"title":1,"questions":[]}"#,
+        ] {
+            assert!(parse(input).is_err(), "{input}");
+        }
+        for value in [json!(null), json!("true"), json!(1)] {
+            let mut input = sample();
+            input["questions"][0]["active"] = value.clone();
+            assert!(parse(&input.to_string()).is_err());
+            input = sample();
+            input["questions"][0]["options"][0]["correct"] = value;
+            assert!(parse(&input.to_string()).is_err());
+        }
+        let mut input = sample();
+        input["title"] = json!(" \n ");
+        assert_eq!(
+            parse(&input.to_string()).unwrap_err(),
+            ["Title is required"]
+        );
+        input = sample();
+        input["questions"][1]["options"] = json!([{"text":"Only", "correct":true}]);
+        assert!(
+            parse(&input.to_string())
+                .unwrap_err()
+                .contains(&"Question 2: Add at least two options".into())
+        );
+    }
+
+    #[test]
+    fn objects_cannot_be_replaced_by_positional_arrays() {
+        for input in [
+            json!(["Quiz", []]),
+            json!({"title":"Quiz", "questions":[["Q", true, [{"text":"A", "correct":true}, {"text":"B"}]]]}),
+            json!({"title":"Quiz", "questions":[{"text":"Q", "options":[["A", true], ["B", false]]}]}),
+        ] {
+            assert!(parse(&input.to_string()).is_err(), "{input}");
+        }
+    }
+
+    #[test]
+    fn database_failure_rolls_back_quiz_questions_and_options() {
+        let mut db = Connection::open_in_memory().unwrap();
+        db::initialize(&db).unwrap();
+        db.execute_batch(
+            "CREATE TRIGGER fail_second BEFORE INSERT ON questions WHEN NEW.text = 'Second'
+            BEGIN SELECT RAISE(ABORT, 'test failure'); END;",
+        )
+        .unwrap();
+        let (title, questions) = parse(&sample().to_string()).unwrap();
+        assert!(insert(&mut db, &title, &questions).is_err());
+        for table in ["quizzes", "questions", "options"] {
+            let count: i64 = db
+                .query_row(&format!("SELECT COUNT(*) FROM {table}"), [], |r| r.get(0))
+                .unwrap();
+            assert_eq!(count, 0, "{table} must roll back");
+        }
+    }
+}
diff --git a/src/db.rs b/src/db.rs
new file mode 100644
index 0000000..d6dd85d
--- /dev/null
+++ b/src/db.rs
@@ -0,0 +1,155 @@
+use rusqlite::{Connection, OptionalExtension, params};
+use serde::Serialize;
+
+#[derive(Debug, Clone, Serialize)]
+pub struct OptionRow {
+    pub text: String,
+    pub correct: bool,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct Question {
+    pub id: i64,
+    pub text: String,
+    pub active: bool,
+    pub options: Vec<OptionRow>,
+}
+
+pub fn initialize(db: &Connection) -> rusqlite::Result<()> {
+    db.busy_timeout(std::time::Duration::from_secs(5))?;
+    db.execute_batch(
+        "PRAGMA foreign_keys = ON;
+         PRAGMA journal_mode = WAL;
+         CREATE TABLE IF NOT EXISTS quizzes (
+             id INTEGER PRIMARY KEY AUTOINCREMENT,
+             title TEXT NOT NULL CHECK(length(trim(title)) > 0)
+         );
+         CREATE TABLE IF NOT EXISTS questions (
+             id INTEGER PRIMARY KEY AUTOINCREMENT,
+             quiz_id INTEGER NOT NULL REFERENCES quizzes(id) ON DELETE CASCADE,
+             text TEXT NOT NULL,
+             active INTEGER NOT NULL DEFAULT 1 CHECK(active IN (0, 1)),
+             position INTEGER NOT NULL
+         );
+         CREATE INDEX IF NOT EXISTS questions_order ON questions(quiz_id, position, id);
+         CREATE TABLE IF NOT EXISTS options (
+             id INTEGER PRIMARY KEY AUTOINCREMENT,
+             question_id INTEGER NOT NULL REFERENCES questions(id) ON DELETE CASCADE,
+             text TEXT NOT NULL,
+             correct INTEGER NOT NULL CHECK(correct IN (0, 1)),
+             position INTEGER NOT NULL
+         );
+         CREATE INDEX IF NOT EXISTS options_order ON options(question_id, position);",
+    )?;
+    add_column(
+        db,
+        "quizzes",
+        "number_of_winners",
+        "INTEGER NOT NULL DEFAULT 3 CHECK(number_of_winners >= 1)",
+    )?;
+    for column in ["timer_minutes", "timer_seconds"] {
+        add_column(
+            db,
+            "quizzes",
+            column,
+            &format!("INTEGER NOT NULL DEFAULT 0 CHECK({column} >= 0)"),
+        )?;
+    }
+    Ok(())
+}
+
+/// Additive, idempotent migrations for databases made by earlier versions.
+/// Names and declarations are internal constants, never request input.
+pub fn add_column(
+    db: &Connection,
+    table: &str,
+    column: &str,
+    declaration: &str,
+) -> rusqlite::Result<()> {
+    let columns = db
+        .prepare(&format!("PRAGMA table_info({table})"))?
+        .query_map([], |r| r.get::<_, String>(1))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    if !columns.iter().any(|name| name == column) {
+        db.execute_batch(&format!(
+            "ALTER TABLE {table} ADD COLUMN {column} {declaration}"
+        ))?;
+    }
+    Ok(())
+}
+
+pub fn number_of_winners(db: &Connection, id: i64) -> rusqlite::Result<i64> {
+    db.query_row(
+        "SELECT number_of_winners FROM quizzes WHERE id=?",
+        [id],
+        |r| r.get(0),
+    )
+}
+
+/// Local quiz settings, deliberately separate from the contents/export model.
+pub fn timer(db: &Connection, id: i64) -> rusqlite::Result<[i64; 2]> {
+    db.query_row(
+        "SELECT timer_minutes,timer_seconds FROM quizzes WHERE id=?",
+        [id],
+        |r| Ok([r.get(0)?, r.get(1)?]),
+    )
+}
+
+pub fn title(db: &Connection, id: i64) -> rusqlite::Result<Option<String>> {
+    db.query_row("SELECT title FROM quizzes WHERE id = ?", [id], |r| r.get(0))
+        .optional()
+}
+
+pub fn questions(db: &Connection, quiz_id: i64) -> rusqlite::Result<Vec<Question>> {
+    let mut stmt = db.prepare(
+        "SELECT id, text, active FROM questions WHERE quiz_id = ? ORDER BY position, id",
+    )?;
+    let rows = stmt.query_map([quiz_id], |r| {
+        Ok(Question {
+            id: r.get(0)?,
+            text: r.get(1)?,
+            active: r.get(2)?,
+            options: vec![],
+        })
+    })?;
+    let mut questions = rows.collect::<rusqlite::Result<Vec<_>>>()?;
+    for question in &mut questions {
+        let mut stmt = db.prepare(
+            "SELECT text, correct FROM options WHERE question_id = ? ORDER BY position, id",
+        )?;
+        question.options = stmt
+            .query_map([question.id], |r| {
+                Ok(OptionRow {
+                    text: r.get(0)?,
+                    correct: r.get(1)?,
+                })
+            })?
+            .collect::<rusqlite::Result<_>>()?;
+    }
+    Ok(questions)
+}
+
+pub fn write_options(
+    db: &Connection,
+    question_id: i64,
+    options: &[OptionRow],
+) -> rusqlite::Result<()> {
+    db.execute("DELETE FROM options WHERE question_id = ?", [question_id])?;
+    for (position, option) in options.iter().enumerate() {
+        db.execute(
+            "INSERT INTO options(question_id, text, correct, position) VALUES (?, ?, ?, ?)",
+            params![question_id, option.text, option.correct, position as i64],
+        )?;
+    }
+    Ok(())
+}
+
+pub fn resequence(db: &Connection, quiz_id: i64, ids: &[i64]) -> rusqlite::Result<()> {
+    for (position, id) in ids.iter().enumerate() {
+        db.execute(
+            "UPDATE questions SET position = ? WHERE id = ? AND quiz_id = ?",
+            params![position as i64, id, quiz_id],
+        )?;
+    }
+    Ok(())
+}
