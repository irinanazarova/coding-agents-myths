+            assert c.evaluate('document.querySelectorAll(".play-option:disabled").length') == 0
+            c.navigate(quiz_path)
+            c.dialogs.append(True)
+            c.click_selector(f'[data-question-id="{ids[3]}"] button.btn--danger')
+            c.wait('document.querySelectorAll("[data-question-id]").length === 3')
+            c.click('Settings')
+            c.wait('document.querySelector("#title") !== null')
+            c.evaluate('document.querySelector("#title").value = "Renamed in browser"')
