+#!/bin/sh
+set -eu
+cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
+: "${SECRET_KEY_BASE:?Set SECRET_KEY_BASE}"
+: "${QUIZZY_MODERATOR_USERNAME:?Set QUIZZY_MODERATOR_USERNAME}"
