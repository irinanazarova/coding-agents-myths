+#!/usr/bin/env python3
+"""Run setup, restart the server, then verify. `watch` checks SSE drains on shutdown."""
+import json, pathlib, sqlite3, sys, urllib.request
+from smoke import request, csrf, BASE
+from live import Player, config
+
+fixture = pathlib.Path('storage/live-persistence-test.json')
+
+
+def setup():
+    assert not fixture.exists(), 'Verify the previous fixture first'
+    token = csrf(request('/moderate/quizzes/new')[2])
+    _, headers, _ = request('/moderate/quizzes', {'csrf': token, 'title': 'Persistent live game'})
+    quiz = headers['Location']
+    for i in range(2):
+        assert request(quiz + '/questions', {'csrf': token, 'question': 'Persist question ' + str(i), 'option_1': 'Right', 'option_2': 'Wrong', 'correct_1': '1', 'active': '1'})[0] == 303
+    _, headers, _ = request(quiz + '/games', {'csrf': token})
+    game = headers['Location']; code = game.split('/')[-1]
+    p = Player(code); p.join('Persistent Alice')
+    assert request(game + '/control', {'csrf': token, 'action': 'start', 'version': 0})[0] == 200
+    q = p.state()['question']
+    assert p.answer(q['id'], q['options'][0]['id'])[0] == 200
+    fixture.write_text(json.dumps({'quiz': quiz, 'game': game, 'cookie': p.cookie, 'csrf': p.token, 'mod_csrf': token, 'question': q}))
+    print('Live persistence fixture created in an open question with an answer.')
+
+
+def watch():
+    data = json.loads(fixture.read_text())
+    path = '/play/' + data['game'].split('/')[-1] + '/events'
+    response = urllib.request.urlopen(urllib.request.Request(BASE + path, headers={'Cookie': data['cookie']}), timeout=20)
+    assert response.headers['Content-Type'].startswith('text/event-stream')
+    print('SSE connected', flush=True)
+    while response.readline(): pass
+    print('SSE drained cleanly on shutdown', flush=True)
+
+
+def verify():
+    data = json.loads(fixture.read_text())
+    try:
+        p = Player(data['game'].split('/')[-1]); p.cookie = data['cookie']; p.token = data['csrf']
+        restored = config(p.req('')[2])['state']
+        assert restored['phase'] == 'open' and restored['name'] == 'Persistent Alice'
+        assert restored['question'] == data['question']
+        assert restored['answer'] == data['question']['options'][0]['id']
+        assert restored['total'] == 2 and restored['number'] == 1
+        game = data['game']; token = data['mod_csrf']
+        assert json.loads(request(game + '/state')[2])['players'] == 1
+        assert request(game + '/control', {'csrf': token, 'action': 'finish', 'version': 1})[0] == 200
+        assert p.state()['result'] == 'Correct!'
+        assert request(game + '/control', {'csrf': token, 'action': 'next', 'version': 2})[0] == 200
+        assert p.state()['question']['text'] == 'Persist question 1'
+        print('Live restart persistence passed: phase, progress, snapshot, remembered identity, last answer and usable controls.')
+    finally:
+        request(data['quiz'] + '/delete', {'csrf': data['mod_csrf']})
+        with sqlite3.connect('storage/quizzy.sqlite3') as db:
+            db.execute('PRAGMA foreign_keys=ON'); db.execute('DELETE FROM games WHERE code=?', (data['game'].split('/')[-1],))
+        fixture.unlink()
+
+
+if __name__ == '__main__': {'setup': setup, 'watch': watch, 'verify': verify}[sys.argv[1]]()
