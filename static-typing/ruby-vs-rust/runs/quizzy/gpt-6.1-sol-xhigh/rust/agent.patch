+fn save_quiz(app: &App, id: Option<i64>, fields: &Fields) -> Result<Response> {
+    app.check_csrf(fields)?;
+    let db = app.db()?;
+    if let Some(id) = id {
+        quiz_title(&db, id)?;
+    }
+    let title = field(fields, "title");
+    let previous = if let Some(id) = id {
+        db::number_of_winners(&db, id)?
+    } else {
+        3
+    };
+    // Older clients that only send a title keep the current setting.
+    let default = previous.to_string();
+    let winners = fields
+        .get("number_of_winners")
+        .map(String::as_str)
+        .unwrap_or(&default);
+    let parsed = winners.parse::<i64>().ok().filter(|n| *n >= 1);
+    let previous_timer = match id {
+        Some(id) => db::timer(&db, id)?,
+        None => [0, 0],
+    }
+    .map(|n| n.to_string());
+    let timer = ["timer_minutes", "timer_seconds"].map(|key| fields.get(key).map(String::as_str));
+    let timer = [
+        timer[0].unwrap_or(&previous_timer[0]),
+        timer[1].unwrap_or(&previous_timer[1]),
+    ];
+    let parsed_timer = parse_timer(timer);
+    let mut messages = vec![];
+    if parsed_timer.is_none() {
+        messages.push("Timer minutes and Timer seconds must be non-negative whole numbers with a supported total duration");
+    }
+    if title.trim().is_empty() {
+        messages.push("Title is required");
+    }
+    if parsed.is_none() {
+        messages.push("Number of winners must be a whole number of at least 1");
+    }
+    if !messages.is_empty() {
+        return Ok((
+            StatusCode::UNPROCESSABLE_ENTITY,
+            Html(views::quiz_form(
+                id, title, winners, timer, &app.csrf, &messages,
+            )),
+        )
+            .into_response());
+    }
+    let winners = parsed.unwrap();
+    let [minutes, seconds] = parsed_timer.unwrap();
+    let id = match id {
+        Some(id) => {
+            db.execute(
+                "UPDATE quizzes SET title=?,number_of_winners=?,timer_minutes=?,timer_seconds=? WHERE id=?",
+                params![title.trim(), winners, minutes, seconds, id],
+            )?;
+            id
+        }
+        None => {
+            db.execute(
+                "INSERT INTO quizzes(title,number_of_winners,timer_minutes,timer_seconds) VALUES (?,?,?,?)",
+                params![title.trim(), winners, minutes, seconds],
+            )?;
+            db.last_insert_rowid()
+        }
+    };
+    Ok(go_to_quiz(id))
+}
+/// Checked arithmetic keeps duration/deadline calculations within SQLite's integer range.
+fn parse_timer(timer: [&str; 2]) -> Option<[i64; 2]> {
+    let minutes = timer[0].parse::<i64>().ok().filter(|n| *n >= 0)?;
+    let seconds = timer[1].parse::<i64>().ok().filter(|n| *n >= 0)?;
+    minutes
+        .checked_mul(60)?
+        .checked_add(seconds)?
+        .checked_mul(1_000_000)?;
+    Some([minutes, seconds])
+}
