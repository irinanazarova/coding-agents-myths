@@ -0,0 +1,155 @@
+#!/usr/bin/env python3
+"""Real Chromium, separate moderator/phone contexts, no third-party Python dependencies."""
+import json, pathlib, socket, sqlite3, subprocess, tempfile, time, urllib.request
+from browser import CDP
+from smoke import request, csrf, AUTH, BASE
+
+
+def main():
+    token = csrf(request('/moderate/quizzes/new')[2])
+    quiz_data = {'title': 'Live conference', 'questions': [
+        {'text': 'What is the capital of France?', 'active': True, 'options': [
+            {'text': 'Berlin'}, {'text': 'Paris', 'correct': True}, {'text': 'Tokyo'}]},
+        {'text': 'This question is inactive', 'active': False, 'options': [
+            {'text': 'Skip me', 'correct': True}, {'text': 'Also skip me'}]},
+        {'text': 'Choose a prime number', 'options': [
+            {'text': '2', 'correct': True}, {'text': '4'}, {'text': '3', 'correct': True}]},
+        {'text': 'Ready to finish?', 'options': [{'text': 'Yes', 'correct': True}, {'text': 'No'}]}
+    ]}
+    status, headers, _ = request('/moderate/quizzes/import', {'csrf': token, 'quiz_json': json.dumps(quiz_data)})
+    assert status == 303
+    quiz = headers['Location']
+    game = None
+    port_socket = socket.socket(); port_socket.bind(('127.0.0.1', 0)); port = port_socket.getsockname()[1]; port_socket.close()
+    clients = []
+    with tempfile.TemporaryDirectory(dir='storage', prefix='live-chromium-') as profile, open('storage/live-chromium.log', 'w') as log:
+        process = subprocess.Popen(['chromium', '--headless', '--no-sandbox', '--disable-dev-shm-usage', '--disable-background-timer-throttling', '--remote-allow-origins=*', f'--remote-debugging-port={port}', f'--user-data-dir={profile}', 'about:blank'], stdout=log, stderr=log)
+        try:
+            end = time.time() + 15
+            while True:
+                try:
+                    info = json.load(urllib.request.urlopen(f'http://127.0.0.1:{port}/json/version')); break
+                except Exception:
+                    if time.time() > end: raise
+                    time.sleep(.1)
+            control = CDP(info['webSocketDebuggerUrl'])
+            def page(context=None, moderator=False):
+                context = context or control.command('Target.createBrowserContext')['browserContextId']
+                target = control.command('Target.createTarget', {'url': 'about:blank', 'browserContextId': context})['targetId']
+                pages = json.load(urllib.request.urlopen(f'http://127.0.0.1:{port}/json/list'))
+                c = CDP(next(p['webSocketDebuggerUrl'] for p in pages if p['id'] == target))
+                for domain in ['Page', 'Runtime', 'Network', 'Log']: c.command(domain + '.enable')
+                c.command('Emulation.setDeviceMetricsOverride', {'width': 1440 if moderator else 390, 'height': 1000 if moderator else 844, 'deviceScaleFactor': 1, 'mobile': not moderator})
+                if moderator: c.command('Network.setExtraHTTPHeaders', {'headers': {'Authorization': AUTH}})
+                clients.append(c)
+                return c, context, target
+            def text(c, value):
+                c.wait(f'document.body.innerText.includes({json.dumps(value)})')
+            def choose(c, value): c.click_selector('button[aria-label=' + json.dumps(value) + ']')
+            def origin(c): return c.evaluate('performance.timeOrigin')
+            def join(c, name):
+                c.wait('document.querySelector("#player-name") !== null')
+                c.fill('Your name', name); c.click('Join'); text(c, 'Hi, ' + name + '!')
+            def no_reload(c, expected): assert origin(c) == expected, 'Live update reloaded the page'
+            def wait_long(c, expression, seconds=14):
+                end = time.time() + seconds
+                while time.time() < end:
+                    if c.evaluate(expression): return
+                    time.sleep(.1)
+                raise AssertionError(c.evaluate('document.body.innerText'))
+            m, _, _ = page(moderator=True)
+            m.navigate(quiz)
+            m.click('Start a game')
+            m.wait('location.pathname.startsWith("/moderate/games/") && document.querySelector(".lobby__url") !== null')
+            game = m.evaluate('location.pathname')
+            code = game.split('/')[-1]
+            url = m.evaluate('document.querySelector(".lobby__url").textContent')
+            assert url == BASE + '/play/' + code
+            m.wait('document.querySelector(".qr img").complete && document.querySelector(".qr img").naturalWidth > 0')
+            text(m, 'Players: 0')
+            m_origin = origin(m)
+            a, a_context, _ = page(); b, b_context, b_target = page(); visitor, _, _ = page()
+            for c in [a, b, visitor]: c.navigate('/play/' + code)
+            a_origin = origin(a); b_origin = origin(b)
+            join(a, 'Alice'); join(b, 'Bob')
+            no_reload(a, a_origin); no_reload(b, b_origin)
+            text(m, 'Players: 2')
+            assert m.evaluate('Array.from(document.querySelectorAll(".lobby-players,#live-counter")).filter(x=>!x.hidden && x.textContent === "Players: 2").length') == 1
+            text(a, 'Waiting for the quiz to start')
+            m.screenshot('live-lobby-desktop')
+            m.click('Start')
+            for c in [m, a, b]: text(c, 'Question 1 of 3'); text(c, 'What is the capital of France?')
+            text(m, 'Answers: 0 / 2')
+            assert a.evaluate('JSON.stringify(JSON.parse(document.querySelector("#live-config").textContent)).includes("correct")') is False
+            assert a.evaluate('document.querySelectorAll(".is-correct").length') == 0
+            # Rapid picks are serialized; only the last pick counts.
+            a.evaluate('document.querySelector("[aria-label=Paris]").click();document.querySelector("[aria-label=Berlin]").click();document.querySelector("[aria-label=Paris]").click()')
+            a.wait('document.querySelector("[aria-label=Paris]").textContent.includes("Your answer") && !document.body.innerText.includes("Sending your answer")')
+            text(m, 'Answers: 1 / 2')
+            # Same browser, new tab: remembered identity and last answer, no double-counting.
+            twin, _, twin_target = page(context=a_context)
+            twin.navigate('/play/' + code); text(twin, 'Hi, Alice!')
+            twin.wait('document.querySelector("[aria-label=Paris]").textContent.includes("Your answer")')
+            assert 'Your name' not in twin.evaluate('document.body.innerText')
+            text(m, 'Answers: 1 / 2')
+            choose(twin, 'Berlin'); a.wait('document.querySelector("[aria-label=Berlin]").textContent.includes("Your answer")')
+            choose(a, 'Paris'); twin.wait('document.querySelector("[aria-label=Paris]").textContent.includes("Your answer")')
+            control.command('Target.closeTarget', {'targetId': twin_target}); clients.remove(twin)
+            choose(b, 'Tokyo'); text(m, 'Answers: 2 / 2')
+            m.click('Finish')
+            text(a, 'Correct!'); text(b, 'Wrong!')
+            m.wait('document.querySelectorAll(".stage-option.is-correct").length === 1')
+            assert m.evaluate('Array.from(document.querySelectorAll(".stage-option__count")).map(x=>x.textContent)') == ['0', '1', '1']
+            assert a.evaluate('document.querySelectorAll(".play-option:disabled").length') == 3
+            assert a.evaluate('document.documentElement.scrollWidth <= innerWidth')
+            a.screenshot('live-result-phone'); m.screenshot('live-results-desktop')
+            m.click('Next')
+            for c in [m, a, b]: text(c, 'Question 2 of 3'); text(c, 'Choose a prime number')
+            assert 'inactive' not in m.evaluate('document.body.innerText')
+            # A late visitor joins directly into the open question.
+            join(visitor, 'Charlie'); text(visitor, 'Question 2 of 3')
+            text(m, 'Answers: 0 / 3')
+            choose(a, '3'); text(m, 'Answers: 1 / 3')
+            # A closed tab eventually leaves the active denominator, without losing identity.
+            control.command('Target.closeTarget', {'targetId': b_target}); clients.remove(b)
+            wait_long(m, 'document.querySelector("#live-counter").textContent === "Answers: 1 / 2"')
+            b, _, _ = page(context=b_context); b.navigate('/play/' + code)
+            text(b, 'Hi, Bob!'); text(b, 'Question 2 of 3'); text(m, 'Answers: 1 / 3')
+            # Lose Wi-Fi during Finish. Reconnection must deliver a current snapshot.
+            a.command('Network.emulateNetworkConditions', {'offline': True, 'latency': 0, 'downloadThroughput': 0, 'uploadThroughput': 0})
+            m.click('Finish'); text(b, 'No answer'); text(visitor, 'No answer')
+            a.command('Network.emulateNetworkConditions', {'offline': False, 'latency': 0, 'downloadThroughput': -1, 'uploadThroughput': -1})
+            text(a, 'Correct!')
+            assert m.evaluate('document.querySelectorAll(".correct-label").length') == 2
+            m.click('Next')
+            for c in [m, a, b, visitor]: text(c, 'Question 3 of 3')
+            m.click('Finish'); text(a, 'No answer'); text(m, 'End quiz')
+            assert m.evaluate('Array.from(document.querySelectorAll("#live-controls button")).map(x=>x.textContent)') == ['End quiz']
+            m.click('End quiz')
+            for c in [m, a, b, visitor]: text(c, 'The quiz is over')
+            no_reload(m, m_origin); no_reload(a, a_origin)
+            newcomer, _, _ = page(); newcomer.navigate('/play/' + code); text(newcomer, 'The quiz is over')
+            assert newcomer.evaluate('document.querySelector(".join-form") === null')
+            assert a.evaluate('document.querySelectorAll(".play-option").length') == 0
+            # Player text is never injected as markup.
+            second_status, second_headers, _ = request(quiz + '/games', {'csrf': token})
+            assert second_status == 303
+            hostile_game = second_headers['Location']
+            hostile, _, _ = page(); hostile.navigate('/play/' + hostile_game.split('/')[-1])
+            join(hostile, '<img src=x onerror=alert(1)>')
+            assert hostile.evaluate('document.querySelectorAll("#live-content img").length') == 0
+            request(hostile_game + '/control', {'csrf': token, 'action': 'start', 'version': 0})
+            request(hostile_game + '/control', {'csrf': token, 'action': 'finish', 'version': 1})
+            with sqlite3.connect('storage/quizzy.sqlite3') as db:
+                db.execute('PRAGMA foreign_keys=ON'); db.execute('DELETE FROM games WHERE code=?', (hostile_game.split('/')[-1],))
+            errors = [e for c in clients for e in c.errors if 'ERR_INTERNET_DISCONNECTED' not in json.dumps(e) and '/favicon.ico' not in json.dumps(e)]
+            assert not errors, errors
+            print('Chromium live-game tests passed: labels, mobile layout, live counters, rapid picks, multi-tab identity, native option buttons, results, late joining, active presence, Wi-Fi reconnect, no reloads, ending and safe text.')
+        finally:
+            process.terminate(); process.wait(timeout=10)
+            request(quiz + '/delete', {'csrf': token})
+            if game:
+                with sqlite3.connect('storage/quizzy.sqlite3') as db:
+                    db.execute('PRAGMA foreign_keys=ON'); db.execute('DELETE FROM games WHERE code=?', (game.split('/')[-1],))
+
+if __name__ == '__main__': main()
