+#!/usr/bin/env python3
+"""Run `setup`, restart bin/serve with the same env, then run `verify`."""
+import json, pathlib, sys
+from smoke import request, csrf
+from transfer import exported
+
+fixture = pathlib.Path('storage/persistence-test.json')
+
+def setup():
+    assert not fixture.exists(), 'Verify/clean up the previous fixture first'
+    token = csrf(request('/moderate/quizzes/new')[2])
+    _, headers, _ = request('/moderate/quizzes', {'csrf': token, 'title': 'Persistent quiz'})
+    quiz = headers['Location']
+    for i in range(3):
+        data = {'csrf': token, 'question': f'Persistent question {i + 1}', 'option_1': 'Alpha', 'option_2': 'Beta', 'option_3': 'Gamma', 'option_4': '', 'correct_1': '1', 'correct_3': '1'}
+        if i != 1: data['active'] = '1'
+        assert request(quiz + '/questions', data)[0] == 303
+    import re
+    ids = re.findall(r'data-question-id="(\d+)"', request(quiz)[2])
+    assert request(quiz + '/questions/' + ids[2] + '/move', {'csrf': token, 'direction': 'up'})[0] == 303
+    original = exported(quiz)
+    code, headers, _ = request('/moderate/quizzes/import', {'csrf': token, 'quiz_json': json.dumps(original)})
+    assert code == 303
+    imported = headers['Location']
+    assert imported != quiz and exported(imported) == original
+    snapshots = {path: request(path)[2] for path in [quiz, quiz + '/preview', quiz + '/edit', quiz + '/questions/' + ids[0] + '/edit', quiz + '/export', imported, imported + '/export', imported + '/preview']}
+    fixture.write_text(json.dumps({'quizzes': [quiz, imported], 'token': token, 'snapshots': snapshots}))
+    print('Persistence fixture created. Restart bin/serve, then run verify.')
+
+def verify():
+    data = json.loads(fixture.read_text())
+    try:
+        for path, expected in data['snapshots'].items():
+            code, _, actual = request(path)
+            assert code == 200 and actual == expected, path
+        print('Restart persistence passed: titles, questions, options, correct flags, Active, order, exports, and imported quizzes.')
+    finally:
+        for quiz in data['quizzes']:
+            assert request(quiz + '/delete', {'csrf': data['token']})[0] == 303
+        fixture.unlink()
+
+if __name__ == '__main__':
+    {'setup': setup, 'verify': verify}[sys.argv[1]]()
