+async fn join(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> Result<Response> {
+    check_player_csrf(&app, &code, &headers, &fields)?;
+    let (gid, pid, token) = {
+        let db = app.db()?;
+        let g = game(&db, &code)?;
+        if g.phase == "ended" {
+            drop(db);
+            if wants_json(&headers) {
+                return Ok(Json(serde_json::json!({"state":state(&app,&code,&headers,false)?,"csrf":player_csrf(&app,&code,&headers)})).into_response());
+            }
+            return Ok((
+                StatusCode::GONE,
+                Html(boot_page(
+                    &g.title,
+                    "<main class=\"play\"><h1>The quiz is over</h1></main>",
+                    serde_json::json!(null),
+                )),
+            )
+                .into_response());
+        }
+        if player(&db, g.id, &headers, &code)?.is_some() {
+            drop(db);
+            return joined_response(&app, &code, headers, None);
+        }
+        let name = field(&fields, "name").trim();
+        if name.is_empty() || name.chars().count() > 80 {
+            return Err(AppError::BadRequest);
+        }
+        let token = random_token()?;
+        db.execute(
+            "INSERT INTO players(game_id,name,token) VALUES (?,?,?)",
+            params![g.id, name, token],
+        )?;
+        (g.id, db.last_insert_rowid(), token)
+    };
+    app.live.seen(gid, pid, false);
+    joined_response(&app, &code, headers, Some(token))
+}
+fn wants_json(headers: &HeaderMap) -> bool {
+    headers
+        .get(header::ACCEPT)
+        .and_then(|v| v.to_str().ok())
+        .is_some_and(|s| s.contains("application/json"))
+}
+fn joined_response(
+    app: &App,
+    code: &str,
+    mut headers: HeaderMap,
+    token: Option<String>,
+) -> Result<Response> {
+    let ajax = wants_json(&headers);
+    let cookie = token.map(|token| {
+        headers.insert(header::COOKIE, format!("quizzy_player_{code}={token}").parse().unwrap());
+        format!("quizzy_player_{code}={token}; Path=/play/{code}; HttpOnly; SameSite=Lax; Max-Age=31536000")
+    });
+    let mut response = if ajax {
+        Json(serde_json::json!({"state":state(app,code,&headers,false)?,"csrf":player_csrf(app,code,&headers)})).into_response()
+    } else {
+        Redirect::to(&format!("/play/{code}")).into_response()
+    };
+    if let Some(cookie) = cookie {
+        response
+            .headers_mut()
+            .insert(header::SET_COOKIE, cookie.parse().unwrap());
+    }
+    Ok(response)
+}
+async fn answer(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> Result<Response> {
+    check_player_csrf(&app, &code, &headers, &fields)?;
+    let qid: i64 = field(&fields, "question")
+        .parse()
+        .map_err(|_| AppError::BadRequest)?;
+    let oid: i64 = field(&fields, "option")
+        .parse()
+        .map_err(|_| AppError::BadRequest)?;
+    let (gid, pid, accepted) = {
+        let db = app.db()?;
+        expire_timers(&app, &db)?;
+        let g = game(&db, &code)?;
+        let (pid, _) = player(&db, g.id, &headers, &code)?.ok_or(AppError::Forbidden)?;
+        let answered_at = now_us();
+        let valid = g.phase == "open" && db.query_row("SELECT EXISTS(SELECT 1 FROM game_questions q JOIN game_options o ON o.question_id=q.id WHERE q.game_id=? AND q.position=? AND q.id=? AND o.id=? AND (q.closes_at_us IS NULL OR q.closes_at_us>?))", params![g.id,g.current,qid,oid,answered_at], |r| r.get::<_,bool>(0))?;
+        if valid {
+            let opened: Option<i64> = db.query_row(
+                "SELECT opened_at_us FROM game_questions WHERE id=?",
+                [qid],
+                |r| r.get(0),
+            )?;
+            // Legacy open questions lack a timestamp; subsequent questions are fully timed.
+            let elapsed = opened
+                .map(|start| answered_at.saturating_sub(start).max(0))
+                .unwrap_or(0);
+            db.execute("INSERT INTO game_answers(question_id,player_id,option_id,elapsed_us) VALUES (?,?,?,?) ON CONFLICT(question_id,player_id) DO UPDATE SET option_id=excluded.option_id, elapsed_us=excluded.elapsed_us, revision=game_answers.revision+1", params![qid,pid,oid,elapsed])?;
+        }
+        (g.id, pid, valid)
+    };
+    if accepted {
+        app.live.seen(gid, pid, false);
+        app.live.notify(gid, false, Some(pid));
+    }
+    Ok((
+        if accepted {
+            StatusCode::OK
+        } else {
+            StatusCode::CONFLICT
+        },
+        Json(state(&app, &code, &headers, false)?),
+    )
+        .into_response())
+}
+async fn presence(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    Form(fields): Form<Fields>,
+) -> Result<StatusCode> {
+    check_player_csrf(&app, &code, &headers, &fields)?;
+    let g = game(&*app.db()?, &code)?;
+    let (pid, _) = player(&*app.db()?, g.id, &headers, &code)?.ok_or(AppError::Forbidden)?;
+    if g.phase != "ended" {
+        app.live.seen(g.id, pid, false);
+    }
+    Ok(StatusCode::NO_CONTENT)
+}
