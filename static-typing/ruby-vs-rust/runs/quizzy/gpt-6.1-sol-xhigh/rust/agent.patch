+}
+async fn delete_question(
+    State(app): State<AppState>,
+    Path((quiz_id, id)): Path<(i64, i64)>,
+    Form(fields): Form<Fields>,
+) -> Result<Response> {
+    app.check_csrf(&fields)?;
+    let mut db = app.db()?;
+    find_question(&db, quiz_id, id)?;
+    let tx = db.transaction()?;
+    tx.execute(
+        "DELETE FROM questions WHERE id = ? AND quiz_id = ?",
+        params![id, quiz_id],
+    )?;
+    let ids: Vec<_> = db::questions(&tx, quiz_id)?.iter().map(|q| q.id).collect();
+    db::resequence(&tx, quiz_id, &ids)?;
+    tx.commit()?;
+    Ok(go_to_quiz(quiz_id))
+}
+async fn move_question(
+    State(app): State<AppState>,
+    Path((quiz_id, id)): Path<(i64, i64)>,
+    Form(fields): Form<Fields>,
+) -> Result<Response> {
+    app.check_csrf(&fields)?;
+    let mut db = app.db()?;
+    let tx = db.transaction()?;
+    let mut ids: Vec<_> = db::questions(&tx, quiz_id)?.iter().map(|q| q.id).collect();
+    let index = ids
+        .iter()
+        .position(|q| *q == id)
+        .ok_or(AppError::NotFound)?;
+    let other = match field(&fields, "direction") {
+        "up" => index.saturating_sub(1),
+        "down" => (index + 1).min(ids.len() - 1),
+        _ => return Err(AppError::BadRequest),
+    };
+    ids.swap(index, other);
+    db::resequence(&tx, quiz_id, &ids)?;
+    tx.commit()?;
+    Ok(go_to_quiz(quiz_id))
+}
