+/* Small adaptations of the exported design for live, accessible controls. */
+:focus-visible { outline: 3px solid var(--c-pink); outline-offset: 4px; }
+h1, h3, .quiz-tile, .question-item__body, .question-item__options li { overflow-wrap: anywhere; }
+.question-item__content { min-width: 0; }
+.option-add { margin-bottom: 28px; }
+.option-row .checkbox { font-size: 15px; }
+.quiz-list .card { margin-bottom: 0; }
+.empty p { margin-bottom: 0; }
+.preview-player { max-width: 560px; margin: 0 auto; }
+.preview-player .play { min-height: 0; border-radius: 24px; border: 2px solid var(--c-blue); overflow: hidden; }
+.preview-player .play__body { padding: 24px; }
+.preview-player .play__top { padding: 20px 24px; border-bottom: 2px solid var(--c-blue); }
+.preview-player .play-question__body { font-size: clamp(24px, 3vw, 34px); }
+.preview-player .play-option { width: 100%; font-family: inherit; text-align: left; cursor: pointer; border: 0; }
+.preview-player .play-option:disabled { cursor: default; opacity: 1; }
+.preview-player .play-option.is-correct { background: var(--c-success); color: white; box-shadow: none; }
+.preview-player .play-option.is-wrong { background: var(--c-pink); color: white; box-shadow: none; }
+.preview-player .play-option.is-picked { outline: 3px solid var(--c-night); outline-offset: 2px; }
+.preview-player .play-option__title { overflow-wrap: anywhere; min-width: 0; }
+.preview-player .option-result { margin-left: auto; font-weight: 700; font-size: 14px; }
+.preview-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
+.preview-result { padding: 24px 0; }
+.preview-result h2 { font-size: clamp(28px, 5vw, 42px); }
+@media (max-width: 600px) {
+  .admin-header__tag { font-size: 16px; }
+  .admin-main { padding-top: 28px; }
+  .card { padding: 20px; }
+  .option-row { display: flex; gap: 10px; flex-wrap: wrap; }
+  .option-row > .input { flex: 1 1 100%; }
+  .option-row > .checkbox { margin-right: auto; }
+  .preview-player .play__body { padding: 20px; }
+  .preview-actions .btn { flex: 1; }
+}
+[hidden] { display: none !important; }
+@media (max-width: 600px) {
+  .question-item { grid-template-columns: auto minmax(0, 1fr); gap: 12px; }
