+        for (index, option) in q.options.iter().enumerate() {
+            write!(
+                html,
+                r#"<li{}>{}. {}{}</li>"#,
+                if option.correct {
+                    r#" class="is-correct""#
+                } else {
+                    ""
+                },
+                letter(index),
+                escape(&option.text),
+                if option.correct {
+                    r#"<span class="visually-hidden"> (correct)</span>"#
+                } else {
+                    ""
+                }
+            )
+            .unwrap();
+        }
+        write!(html, r#"</ul></div><div class="question-item__actions"><div class="buttons"><form method="post" action="{path}/move">{}<button class="btn btn--ghost btn--icon" name="direction" value="up" aria-label="Move up" title="Move up" {}>↑</button><button class="btn btn--ghost btn--icon" name="direction" value="down" aria-label="Move down" title="Move down" {}>↓</button></form></div><form method="post" action="{path}/active" data-auto-submit>{}<label class="checkbox"><input type="checkbox" name="active" value="1" {}> Active</label><noscript><button class="btn btn--sm">Save</button></noscript></form><div class="buttons"><a class="btn btn--sm" href="{path}/edit">Edit</a><form method="post" action="{path}/delete" data-confirm="Delete this question?">{}<button class="btn btn--sm btn--danger" type="submit">Delete</button></form></div></div></li>"#, token(csrf), if index == 0 { "disabled" } else { "" }, if index + 1 == questions.len() { "disabled" } else { "" }, token(csrf), if q.active { "checked" } else { "" }, token(csrf)).unwrap();
+    }
+    html.push_str("</ol></section>");
+    html.push_str(history);
+    page(title, &html)
+}
+
+pub fn letter(mut index: usize) -> String {
+    let mut letters = String::new();
+    loop {
+        letters.insert(0, (b'A' + (index % 26) as u8) as char);
+        if index < 26 {
+            break;
+        }
+        index = index / 26 - 1;
+    }
+    letters
+}
+
+pub fn question_form(
+    quiz_id: i64,
+    title: &str,
+    q: &Question,
+    csrf: &str,
+    messages: &[&str],
+) -> String {
+    let heading = if q.id == 0 {
+        "New question"
+    } else {
+        "Edit question"
+    };
+    let path = if q.id == 0 {
+        format!("/moderate/quizzes/{quiz_id}/questions")
+    } else {
+        format!("/moderate/quizzes/{quiz_id}/questions/{}", q.id)
+    };
+    let mut html = format!(
+        r#"<div class="breadcrumbs"><a href="/moderate/quizzes/{quiz_id}">← {}</a></div><div class="page-head"><h1>{heading}</h1></div><div class="card">{}<form method="post" action="{path}">{}<div class="field"><label for="question">Question</label><textarea class="input" id="question" name="question" rows="3" required>{}</textarea></div><div class="field"><span class="field-label">Options</span><span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span></div><div class="option-rows" id="option-rows">"#,
+        escape(title),
+        errors(messages),
+        token(csrf),
+        escape(&q.text)
+    );
+    for (index, OptionRow { text, correct }) in q.options.iter().enumerate() {
+        let n = index + 1;
+        write!(html, r#"<div class="option-row"><label class="visually-hidden" for="option_{n}">Option {n}</label><input class="input" id="option_{n}" name="option_{n}" aria-label="Option {n}" placeholder="Option {n}" value="{}"><label class="checkbox"><input type="checkbox" name="correct_{n}" value="1" aria-label="Option {n} is correct" {}> Correct</label><button class="btn btn--danger btn--icon" type="button" data-remove-option aria-label="Remove option {n}" title="Remove option {n}">✕</button></div>"#, escape(text), if *correct { "checked" } else { "" }).unwrap();
+    }
+    write!(html, r#"</div><div class="buttons option-add"><button class="btn btn--ghost btn--sm" type="button" id="add-option">Add option</button></div><div class="field"><label class="checkbox"><input type="checkbox" name="active" value="1" {}> Active</label><span class="field-hint">Only active questions are played.</span></div><div class="buttons"><button class="btn btn--pink" type="submit">Save question</button><a class="btn btn--ghost" href="/moderate/quizzes/{quiz_id}">Cancel</a></div></form></div>"#, if q.active { "checked" } else { "" }).unwrap();
+    page(heading, &html)
+}
+
+pub fn preview(quiz_id: i64, title: &str, questions: &[Question]) -> String {
+    let active: Vec<_> = questions.iter().filter(|q| q.active).collect();
+    // Escape JSON as well as HTML: a question containing </script> must be harmless.
+    let json = serde_json::to_string(&active)
+        .unwrap()
+        .replace('&', "\\u0026")
+        .replace('<', "\\u003c")
+        .replace('>', "\\u003e");
+    let html = format!(
+        r#"<div class="breadcrumbs"><a href="/moderate/quizzes/{quiz_id}">← Back to quiz</a></div><div class="page-head"><div><h1>Preview</h1><div class="meta mt-2">{} · Try it as a player. Answers are not saved.</div></div></div><div class="preview-player"><div class="play"><div class="play__top"><span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span><span class="meta">Preview</span></div><div class="play__body play__body--top" id="preview"><noscript>Enable JavaScript to try this quiz.</noscript></div></div></div><script id="preview-data" type="application/json">{json}</script>"#,
+        escape(title)
+    );
+    page("Preview", &html)
+}
