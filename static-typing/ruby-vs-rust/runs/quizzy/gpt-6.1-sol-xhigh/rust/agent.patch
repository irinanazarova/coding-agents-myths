+pub fn quiz_list(quizzes: &[(i64, String, usize, usize)]) -> String {
+    let mut html = String::from(
+        r#"<div class="page-head"><h1>Quizzes</h1><div class="buttons"><form method="get" action="/moderate/quizzes/import"><button class="btn btn--ghost" type="submit">Import quiz</button></form><a class="btn btn--pink" href="/moderate/quizzes/new">New quiz</a></div></div>"#,
