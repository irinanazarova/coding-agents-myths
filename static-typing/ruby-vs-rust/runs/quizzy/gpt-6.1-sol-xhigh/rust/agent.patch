+pub fn routes() -> Router<AppState> {
+    Router::new()
+        .route("/moderate/quizzes/{id}/games", post(create))
+        .route("/moderate/games/{code}", get(moderator_page))
+        .route("/moderate/games/{code}/state", get(moderator_state))
+        .route("/moderate/games/{code}/events", get(moderator_events))
+        .route("/moderate/games/{code}/control", post(control))
+        .route("/moderate/games/{code}/qr.svg", get(qr))
+        .route("/play/{code}", get(player_page).post(join))
+        .route("/play/{code}/state", get(player_state))
+        .route("/play/{code}/events", get(player_events))
+        .route("/play/{code}/answer", post(answer))
+        .route("/play/{code}/presence", post(presence))
+}
+async fn create(
+    State(app): State<AppState>,
+    Path(id): Path<i64>,
+    Form(fields): Form<Fields>,
+) -> Result<Redirect> {
+    app.check_csrf(&fields)?;
+    let mut db = app.db()?;
+    let tx = db.transaction()?;
+    let title = crate::quiz_title(&tx, id)?;
+    let questions = db::questions(&tx, id)?;
+    let winners = db::number_of_winners(&tx, id)?;
+    let [minutes, seconds] = db::timer(&tx, id)?;
+    let timer_seconds = minutes
+        .checked_mul(60)
+        .and_then(|m| m.checked_add(seconds))
+        .ok_or_else(|| AppError::Internal("Timer duration overflow".into()))?;
+    let code = loop {
+        let code = new_code()?;
+        if !tx.query_row(
+            "SELECT EXISTS(SELECT 1 FROM games WHERE code=?)",
+            [&code],
+            |r| r.get::<_, bool>(0),
+        )? {
+            break code;
+        }
+    };
+    tx.execute(
+        "INSERT INTO games(quiz_id,code,title,number_of_winners,timer_seconds) VALUES (?,?,?,?,?)",
+        params![id, code, title, winners, timer_seconds],
+    )?;
+    let gid = tx.last_insert_rowid();
+    for (position, q) in questions.into_iter().filter(|q| q.active).enumerate() {
+        tx.execute(
+            "INSERT INTO game_questions(game_id,position,text) VALUES (?,?,?)",
+            params![gid, position as i64, q.text],
+        )?;
+        let qid = tx.last_insert_rowid();
+        for (pos, o) in q.options.iter().enumerate() {
+            tx.execute(
+                "INSERT INTO game_options(question_id,position,text,correct) VALUES (?,?,?,?)",
+                params![qid, pos as i64, o.text, o.correct],
+            )?;
+        }
+    }
+    tx.commit()?;
+    Ok(Redirect::to(&format!("/moderate/games/{code}")))
+}
+async fn control(
+    State(app): State<AppState>,
+    Path(code): Path<String>,
+    Form(fields): Form<Fields>,
+) -> Result<Response> {
+    app.check_csrf(&fields)?;
+    let expected: i64 = field(&fields, "version")
+        .parse()
+        .map_err(|_| AppError::BadRequest)?;
+    let changed = {
+        let mut db = app.db()?;
+        expire_timers(&app, &db)?;
+        apply_control(&mut db, &code, expected, field(&fields, "action"))?
+    };
+    if let Some(id) = changed {
+        app.live.notify(id, true, None);
+    }
+    Ok((
+        if changed.is_some() {
+            StatusCode::OK
+        } else {
+            StatusCode::CONFLICT
+        },
+        Json(state(&app, &code, &HeaderMap::new(), true)?),
+    )
+        .into_response())
+}
+/// Phase, question opening time, winners and revision are committed atomically.
+fn apply_control(
+    db: &mut Connection,
+    code: &str,
+    expected: i64,
+    action: &str,
+) -> Result<Option<i64>> {
+    let tx = db.transaction()?;
+    let g = game(&tx, code)?;
+    if expected != g.version {
+        return Ok(None);
+    }
+    if matches!(action, "top" | "draw" | "reset") {
+        if g.phase != "ended" {
+            return Ok(None);
+        }
+        let winners = if action == "reset" {
+            vec![]
+        } else {
+            choose_winners(
+                &leaderboard(&tx, g.id)?,
+                g.number_of_winners,
+                action == "draw",
+            )?
+        };
+        tx.execute("UPDATE players SET winner=0 WHERE game_id=?", [g.id])?;
+        for id in winners {
+            tx.execute(
+                "UPDATE players SET winner=1 WHERE id=? AND game_id=?",
+                params![id, g.id],
+            )?;
+        }
+        tx.execute("UPDATE games SET version=version+1 WHERE id=?", [g.id])?;
+    } else {
+        let total: i64 = tx.query_row(
+            "SELECT COUNT(*) FROM game_questions WHERE game_id=?",
+            [g.id],
+            |r| r.get(0),
+        )?;
+        let transition = match (g.phase.as_str(), action) {
+            ("waiting", "start") if total == 0 => Some(("ended", -1)),
+            ("waiting", "start") => Some(("open", 0)),
+            ("open", "finish") => Some(("closed", g.current)),
+            ("closed", "next") if g.current + 1 < total => Some(("open", g.current + 1)),
+            ("closed", "end") if g.current + 1 == total => Some(("ended", g.current)),
+            _ => None,
+        };
+        let Some((phase, current)) = transition else {
+            return Ok(None);
+        };
+        if phase == "open" {
+            let opened = now_us();
+            let deadline = if g.timer_seconds > 0 {
+                Some(opened.saturating_add(g.timer_seconds.saturating_mul(1_000_000)))
+            } else {
+                None
+            };
+            tx.execute(
+                "UPDATE game_questions SET opened_at_us=?,closes_at_us=? WHERE game_id=? AND position=?",
+                params![opened, deadline, g.id, current],
+            )?;
+        }
+        tx.execute(
+            "UPDATE games SET phase=?,current=?,version=version+1 WHERE id=?",
+            params![phase, current, g.id],
+        )?;
+    }
+    tx.commit()?;
+    Ok(Some(g.id))
+}
