+    #[serde(skip_serializing_if = "Option::is_none")]
+    winner: Option<bool>,
+}
+#[derive(Debug, Serialize)]
+struct Standing {
+    id: i64,
+    place: usize,
+    name: String,
+    points: i64,
+    winner: bool,
+}
+
+/// Every registered player is ranked, even when their phone has disconnected.
+/// Only the final pick contributes, and only correct picks contribute time.
+fn leaderboard(db: &Connection, game_id: i64) -> Result<Vec<Standing>> {
+    let mut stmt = db.prepare(
+        "SELECT p.id,p.name,p.winner,
+        COALESCE(SUM(CASE WHEN o.correct=1 THEN 1 ELSE 0 END),0) AS points,
+        COALESCE(SUM(CASE WHEN o.correct=1 THEN a.elapsed_us ELSE 0 END),0) AS elapsed
+        FROM players p LEFT JOIN game_answers a ON a.player_id=p.id
+        LEFT JOIN game_options o ON o.id=a.option_id
+        WHERE p.game_id=? GROUP BY p.id ORDER BY points DESC,elapsed ASC,p.id ASC",
+    )?;
+    let mut rows = stmt
+        .query_map([game_id], |r| {
+            Ok(Standing {
+                id: r.get(0)?,
+                place: 0,
+                name: r.get(1)?,
+                winner: r.get(2)?,
+                points: r.get(3)?,
+            })
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    for (i, row) in rows.iter_mut().enumerate() {
+        row.place = i + 1;
+    }
+    Ok(rows)
+}
+
+fn now_us() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_micros()
+        .min(i64::MAX as u128) as i64
+}
+
+/// Atomic equivalent of Finish for every due current question. It cannot advance a
+/// game, finish twice, or touch the next question after an early manual Finish.
+fn expire_due(db: &Connection, now: i64) -> Result<Vec<i64>> {
+    let mut stmt = db.prepare(
+        "UPDATE games SET phase='closed',version=version+1
+         WHERE phase='open' AND id IN (
+            SELECT q.game_id FROM game_questions q JOIN games g ON g.id=q.game_id
+            WHERE q.position=g.current AND q.closes_at_us IS NOT NULL AND q.closes_at_us<=?
+         ) RETURNING id",
+    )?;
+    Ok(stmt
+        .query_map([now], |r| r.get(0))?
+        .collect::<rusqlite::Result<Vec<_>>>()?)
+}
+
+fn expire_timers(app: &App, db: &Connection) -> Result<()> {
+    for id in expire_due(db, now_us())? {
+        app.live.notify(id, true, None);
+    }
+    Ok(())
+}
+
+pub fn finish_expired(app: &App) -> Result<()> {
+    expire_timers(app, &*app.db()?)
+}
+
+/// Persistent deadlines are authoritative; no browser is needed for expiry.
+/// Also runs at startup so overdue questions close before the server is ready.
+pub async fn run_timers(app: AppState) {
+    let mut interval = tokio::time::interval(Duration::from_millis(100));
+    interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    let mut stopping = app.stopping.subscribe();
+    loop {
+        tokio::select! {
+            _ = stopping.changed() => break,
+            _ = interval.tick() => {
+                if let Err(error) = finish_expired(&app) {
+                    eprintln!("Unable to finish expired questions: {error:?}");
+                }
+            }
+        }
+    }
+}
+
+/// Unbiased bounded randomness, used by Fisher-Yates at the points cutoff.
+fn random_below(bound: usize) -> Result<usize> {
+    let bound = bound as u64;
+    let threshold = bound.wrapping_neg() % bound;
+    loop {
+        let mut bytes = [0u8; 8];
+        getrandom::fill(&mut bytes).map_err(|e| AppError::Internal(e.to_string()))?;
+        let value = u64::from_le_bytes(bytes);
+        if value >= threshold {
+            return Ok((value % bound) as usize);
+        }
+    }
+}
+
+fn choose_winners(board: &[Standing], n: i64, draw: bool) -> Result<Vec<i64>> {
+    choose_winners_with(board, n, draw, random_below)
+}
+
+fn choose_winners_with(
+    board: &[Standing],
+    n: i64,
+    draw: bool,
+    mut random_index: impl FnMut(usize) -> Result<usize>,
+) -> Result<Vec<i64>> {
+    let eligible: Vec<_> = board.iter().filter(|p| p.points > 0).collect();
+    let count = usize::try_from(n).unwrap_or(usize::MAX).min(eligible.len());
+    if count == 0 {
+        return Ok(vec![]);
+    }
+    if !draw || count == eligible.len() {
+        return Ok(eligible[..count].iter().map(|p| p.id).collect());
+    }
+    let cutoff = eligible[count - 1].points;
+    let mut winners: Vec<_> = eligible
+        .iter()
+        .filter(|p| p.points > cutoff)
+        .map(|p| p.id)
+        .collect();
+    let mut tied: Vec<_> = eligible
+        .iter()
+        .filter(|p| p.points == cutoff)
+        .map(|p| p.id)
+        .collect();
+    for i in (1..tied.len()).rev() {
+        let j = random_index(i + 1)?;
+        tied.swap(i, j);
+    }
+    winners.extend(tied.into_iter().take(count - winners.len()));
+    Ok(winners)
+}
+
+struct Game {
+    id: i64,
+    title: String,
+    phase: String,
+    current: i64,
+    version: i64,
