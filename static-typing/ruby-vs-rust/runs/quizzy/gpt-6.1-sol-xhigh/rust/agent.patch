+fn save_question(app: &App, quiz_id: i64, id: i64, fields: &Fields) -> Result<Response> {
+    app.check_csrf(fields)?;
+    let mut db = app.db()?;
+    let title = quiz_title(&db, quiz_id)?;
+    if id != 0 {
+        find_question(&db, quiz_id, id)?;
+    }
+    let mut q = parse_question(id, fields);
+    let messages = validate_question(&q);
+    if !messages.is_empty() {
+        return Ok((
+            StatusCode::UNPROCESSABLE_ENTITY,
+            Html(views::question_form(
+                quiz_id, &title, &q, &app.csrf, &messages,
+            )),
+        )
+            .into_response());
+    }
+    normalize_question(&mut q);
+    let tx = db.transaction()?;
+    let question_id = if id == 0 {
+        tx.execute("INSERT INTO questions(quiz_id, text, active, position) VALUES (?, ?, ?, (SELECT COALESCE(MAX(position), -1) + 1 FROM questions WHERE quiz_id = ?))", params![quiz_id, q.text.trim(), q.active, quiz_id])?;
+        tx.last_insert_rowid()
+    } else {
+        tx.execute(
+            "UPDATE questions SET text = ?, active = ? WHERE id = ? AND quiz_id = ?",
+            params![q.text.trim(), q.active, id, quiz_id],
+        )?;
+        id
+    };
+    db::write_options(&tx, question_id, &q.options)?;
+    tx.commit()?;
+    Ok(go_to_quiz(quiz_id))
+}
