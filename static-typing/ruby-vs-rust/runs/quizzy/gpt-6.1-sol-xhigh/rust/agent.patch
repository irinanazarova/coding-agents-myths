+#!/usr/bin/env python3
+"""Real Chromium timer UI regression using the standard-library CDP helper."""
+import json, pathlib, socket, sqlite3, subprocess, tempfile, time, urllib.request
+from browser import CDP
+from smoke import request, csrf, AUTH
+
+
+def main():
+    token = csrf(request('/moderate/quizzes/new')[2])
+    quiz = None; games = []; clients = []
+    sock = socket.socket(); sock.bind(('127.0.0.1', 0)); port = sock.getsockname()[1]; sock.close()
+    with tempfile.TemporaryDirectory(dir='storage', prefix='timer-chromium-') as profile, open('storage/timer-chromium.log', 'w') as log:
+        process = subprocess.Popen(['chromium', '--headless', '--no-sandbox', '--disable-dev-shm-usage',
+            '--disable-background-networking', '--disable-background-timer-throttling', '--remote-allow-origins=*',
+            f'--remote-debugging-port={port}', f'--user-data-dir={profile}', 'about:blank'], stdout=log, stderr=log)
+        try:
+            end = time.time() + 15
+            while True:
+                try:
+                    info = json.load(urllib.request.urlopen(f'http://127.0.0.1:{port}/json/version')); break
+                except Exception:
+                    if time.time() > end: raise
+                    time.sleep(.1)
+            controller = CDP(info['webSocketDebuggerUrl'])
+            def page(moderator=False):
+                context = controller.command('Target.createBrowserContext')['browserContextId']
+                target = controller.command('Target.createTarget', {'url': 'about:blank', 'browserContextId': context})['targetId']
+                targets = json.load(urllib.request.urlopen(f'http://127.0.0.1:{port}/json/list'))
+                c = CDP(next(t['webSocketDebuggerUrl'] for t in targets if t['id'] == target))
+                for domain in ['Page', 'Runtime', 'Network', 'Log']: c.command(domain + '.enable')
+                c.command('Emulation.setDeviceMetricsOverride', {'width': 1440 if moderator else 390,
+                    'height': 1000 if moderator else 844, 'deviceScaleFactor': 1, 'mobile': not moderator})
+                if moderator: c.command('Network.setExtraHTTPHeaders', {'headers': {'Authorization': AUTH}})
+                clients.append(c); return c
+            def fill(c, label, value):
+                c.evaluate(f"document.getElementById(Array.from(document.querySelectorAll('label')).find(n=>n.textContent==={json.dumps(label)}).htmlFor).value={json.dumps(str(value))}")
+            def timer(c): return c.evaluate('document.querySelector("#live-timer")?.textContent')
+            def text(c, text): c.wait(f'document.body.innerText.includes({json.dumps(text)})')
+            def wait_long(c, expression, seconds=15):
+                end = time.time() + seconds
+                while time.time() < end:
+                    if c.evaluate(expression): return
+                    time.sleep(.05)
+                raise AssertionError(c.evaluate('document.body.innerText'))
+            def new_game(m):
+                m.navigate(quiz); m.click('Start a game')
+                m.wait('location.pathname.startsWith("/moderate/games/") && document.querySelector(".lobby__url") !== null')
+                game = m.evaluate('location.pathname'); games.append(game); return game
+
+            m = page(True); p = page()
+            m.navigate('/moderate/quizzes/new')
+            assert m.evaluate('document.querySelector("#timer-minutes").value') == '0'
+            assert m.evaluate('document.querySelector("#timer-seconds").value') == '0'
+            fill(m, 'Title', 'Conference timer'); fill(m, 'Timer minutes', 1); fill(m, 'Timer seconds', 30)
+            m.click('Save quiz'); m.wait('document.querySelector(".question-list") !== null || document.body.innerText.includes("Add question")')
+            quiz = m.evaluate('location.pathname')
+            assert quiz.startswith('/moderate/quizzes/') and not quiz.endswith('new')
+            for i in range(2):
+                assert request(quiz + '/questions', {'csrf': token, 'question': f'Timer question {i+1}', 'active': 1,
+                    'option_1': 'Right', 'correct_1': 1, 'option_2': 'Wrong'})[0] == 303
+            m.navigate(quiz + '/edit')
+            assert m.evaluate('document.querySelector("#timer-minutes").value') == '1'
+            assert m.evaluate('document.querySelector("#timer-seconds").value') == '30'
+            m.screenshot('timer-settings-desktop')
+            game = new_game(m)
+            assert timer(m) is None
+            p.navigate('/play/' + game.split('/')[-1]); p.fill('Your name', 'Timer Alice'); p.click('Join'); text(p, 'Hi, Timer Alice!')
+            m.click('Start'); m.wait('document.querySelector("#live-timer") !== null')
+            assert timer(m) == '1:30', timer(m)
+            text(p, 'Timer question 1')
+            assert timer(p) is None and '1:30' not in p.evaluate('document.body.innerText')
+            m.screenshot('timer-countdown-desktop'); p.screenshot('timer-player-phone')
+            m.click('Finish'); text(m, 'Correct'); m.wait('document.querySelector("#live-timer") === null')
+            text(p, 'No answer')
+            # A shorter new game checks actual ticking, refresh, answer results, Next and expiry.
+            m.navigate(quiz + '/edit'); fill(m, 'Timer minutes', 0); fill(m, 'Timer seconds', 7); m.click('Save quiz')
+            m.wait('document.body.innerText.includes("Start a game")')
+            game = new_game(m)
+            p.navigate('/play/' + game.split('/')[-1]); p.fill('Your name', 'Timer Bob'); p.click('Join'); text(p, 'Hi, Timer Bob!')
+            m.click('Start'); m.wait('document.querySelector("#live-timer")?.textContent === "0:07"')
+            text(p, 'Timer question 1'); p.click_selector('button[aria-label="Right"]')
+            p.wait('document.querySelector("[aria-label=Right]").textContent.includes("Your answer")')
+            m.wait('document.querySelector("#live-timer")?.textContent === "0:05"')
+            m.command('Page.reload'); m.wait('document.readyState === "complete" && document.querySelector("#live-timer") !== null')
+            assert timer(m) in ['0:05', '0:04'], timer(m)
+            old_origin = m.evaluate('performance.timeOrigin')
+            wait_long(m, 'Array.from(document.querySelectorAll("button")).some(n=>n.textContent==="Next")')
+            assert m.evaluate('performance.timeOrigin') == old_origin, 'Expiry should update live, not reload'
+            assert timer(m) is None; text(p, 'Correct!')
+            m.click('Next'); m.wait('document.querySelector("#live-timer")?.textContent === "0:07"')
+            text(p, 'Timer question 2'); assert timer(p) is None
+            m.click('Finish'); m.wait('document.querySelector("#live-timer") === null'); text(p, 'No answer')
+            m.click('End quiz'); text(m, 'The quiz is over')
+            assert timer(m) is None
+            # Zero disables the timer. Verify both the edit view and live screen on a phone-sized viewport.
+            m.navigate(quiz + '/edit'); fill(m, 'Timer seconds', 0); m.click('Save quiz'); m.wait('document.body.innerText.includes("Start a game")')
+            new_game(m); m.click('Start'); text(m, 'Timer question 1'); assert timer(m) is None
+            m.command('Emulation.setDeviceMetricsOverride', {'width': 390, 'height': 844, 'deviceScaleFactor': 1, 'mobile': True})
+            m.navigate(quiz + '/edit'); m.screenshot('timer-settings-phone')
+            assert m.evaluate('document.documentElement.scrollWidth <= innerWidth'), 'Settings overflow on phone'
+            errors = [e for c in clients for e in c.errors if '/favicon.ico' not in json.dumps(e)]
+            assert not errors, errors
+            print('Timer Chromium passed: exact labels/defaults, saved fields, 1:30 and 0:07, ticking, refresh, player invisibility, live auto-Finish, Next, early Finish and zero timer.')
+        finally:
+            for c in clients:
+                try: c.command('Page.navigate', {'url': 'about:blank'}); c.sock.close()
+                except Exception: pass
+            if quiz: request(quiz + '/delete', {'csrf': token})
+            with sqlite3.connect('storage/quizzy.sqlite3') as db:
+                db.execute('PRAGMA foreign_keys=ON')
+                for game in games: db.execute('DELETE FROM games WHERE code=?', (game.split('/')[-1],))
+            process.terminate()
+            try: process.wait(timeout=8)
+            except subprocess.TimeoutExpired: process.kill(); process.wait()
+
+if __name__ == '__main__': main()
