+#[tokio::main]
+async fn main() -> std::result::Result<(), Box<dyn std::error::Error>> {
+    let required = |name: &str| -> std::result::Result<String, Box<dyn std::error::Error>> {
+        let value = std::env::var(name).map_err(|_| format!("Set {name}"))?;
+        if value.is_empty() {
+            return Err(format!("{name} must not be empty").into());
+        }
+        Ok(value)
+    };
+    let secret = required("SECRET_KEY_BASE")?;
+    let credentials = format!(
+        "{}:{}",
+        required("QUIZZY_MODERATOR_USERNAME")?,
+        required("QUIZZY_MODERATOR_PASSWORD")?
+    );
+    std::fs::create_dir_all("storage")?;
+    let db = Connection::open("storage/quizzy.sqlite3")?;
+    db::initialize(&db)?;
+    games::initialize(&db)?;
+    let app = Arc::new(App {
+        db: Mutex::new(db),
+        live: Arc::new(games::LiveHub::default()),
+        stopping: tokio::sync::watch::channel(false).0,
+        credential_signature: signature(&secret, credentials.as_bytes()),
+        csrf: URL_SAFE_NO_PAD.encode(signature(&secret, b"quizzy moderator csrf v1")),
+        secret,
+    });
+    games::finish_expired(&app)
+        .map_err(|e| std::io::Error::other(format!("Timer recovery failed: {e:?}")))?;
+    tokio::spawn(games::run_timers(app.clone()));
+    tokio::spawn(app.live.clone().reap());
+    let stopping = app.stopping.clone();
+    let router = Router::new()
+        .merge(games::routes())
+        .route("/", get(|| async { Redirect::to("/moderate") }))
+        .route("/up", get(up))
+        .route("/assets/{name}", get(asset))
+        .route("/moderate", get(quizzes))
+        .route("/moderate/", get(quizzes))
+        .route("/moderate/quizzes/new", get(new_quiz))
+        .route(
+            "/moderate/quizzes/import",
+            get(import_form).post(import_quiz),
+        )
+        .route("/moderate/quizzes", post(create_quiz))
+        .route("/moderate/quizzes/{id}", get(show_quiz).post(update_quiz))
+        .route("/moderate/quizzes/{id}/edit", get(edit_quiz))
+        .route("/moderate/quizzes/{id}/delete", post(delete_quiz))
+        .route("/moderate/quizzes/{id}/preview", get(preview))
+        .route("/moderate/quizzes/{id}/export", get(export_quiz))
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/new",
+            get(new_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions",
+            post(create_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{id}",
+            post(update_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{id}/edit",
+            get(edit_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{id}/delete",
+            post(delete_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{id}/active",
+            post(active_question),
+        )
+        .route(
+            "/moderate/quizzes/{quiz_id}/questions/{id}/move",
+            post(move_question),
+        )
+        .fallback(|| async { AppError::NotFound })
+        .layer(middleware::from_fn_with_state(app.clone(), protect))
+        .with_state(app);
+    let port: u16 = std::env::var("PORT").unwrap_or("3000".into()).parse()?;
+    let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::UNSPECIFIED, port)).await?;
+    println!("Quizzy is ready on http://0.0.0.0:{port}");
+    axum::serve(listener, router)
+        .with_graceful_shutdown(async move {
+            shutdown().await;
+            stopping.send_replace(true);
+        })
+        .await?;
+    Ok(())
+}
