+fn events(app: AppState, code: String, headers: HeaderMap, moderator: bool) -> Result<Response> {
+    let (gid, pid) = {
+        let db = app.db()?;
+        let g = game(&db, &code)?;
+        (
+            g.id,
+            if moderator {
+                None
+            } else {
+                player(&db, g.id, &headers, &code)?.map(|(id, _)| id)
+            },
+        )
+    };
+    let mut phase = if moderator {
+        app.live.moderator(gid)
+    } else {
+        app.live.phases(gid)
+    };
+    let mut personal = app.live.personal(gid, pid.unwrap_or(0));
+    let mut stopping = app.stopping.subscribe();
+    let guard = pid.map(|player| {
+        app.live.seen(gid, player, true);
+        PresenceGuard {
+            hub: app.live.clone(),
+            game: gid,
+            player,
+        }
+    });
+    let stream = async_stream::stream! {
+        let _guard = guard;
+        loop {
+            if *stopping.borrow() { break; }
+            // Coalesced notifications always produce a fresh, complete, authorized snapshot.
+            phase.borrow_and_update();
+            personal.borrow_and_update();
+            let current = match state(&app,&code,&headers,moderator) { Ok(s) => s, Err(_) => break };
+            yield Ok::<Event,Infallible>(Event::default().event("state").retry(Duration::from_secs(2)).json_data(current).unwrap());
+            tokio::select! {
+                _ = stopping.changed() => break,
+                change = phase.changed() => { if change.is_err() { break; } },
+                change = personal.changed() => { if change.is_err() { break; } },
+            }
+        }
+    };
+    Ok(Sse::new(stream)
+        .keep_alive(
+            KeepAlive::new()
+                .interval(Duration::from_secs(15))
+                .text("quizzy"),
+        )
+        .into_response())
+}
+
+pub fn history(db: &Connection, quiz_id: i64) -> Result<String> {
+    use std::fmt::Write;
+    let mut stmt =
+        db.prepare("SELECT code,phase,created_at FROM games WHERE quiz_id=? ORDER BY id DESC")?;
+    let games = stmt
+        .query_map([quiz_id], |r| {
+            Ok((
+                r.get::<_, String>(0)?,
+                r.get::<_, String>(1)?,
+                r.get::<_, String>(2)?,
+            ))
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    if games.is_empty() {
+        return Ok(String::new());
+    }
+    let mut html =
+        String::from("<section class=\"section\"><h2>Games</h2><ul class=\"game-list\">");
+    for (code, phase, date) in games {
+        write!(html,r#"<li class="card game-item"><div><strong>{code}</strong><div class="meta">{} · {date} UTC</div></div><a class="btn" href="/moderate/games/{code}">Open game</a></li>"#, match phase.as_str() { "waiting" => "Waiting to start", "ended" => "The quiz is over", _ => "In progress" }).unwrap();
+    }
+    html.push_str("</ul></section>");
+    Ok(html)
+}
