@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Run setup, restart bin/serve (same secret), then verify. Own fixtures only."""
+import json, pathlib, sqlite3, sys, time
+from smoke import request, csrf
+from live import Player, Events
+
+fixture = pathlib.Path('storage/prizes-persistence.json')
+
+
+def command(path, token, action):
+    before = json.loads(request(path + '/state')[2])
+    status, _, body = request(path + '/control', {'csrf': token, 'version': before['version'], 'action': action})
+    assert status == 200, (action, status, body)
+    return json.loads(body)
+
+
+def setup():
+    assert not fixture.exists(), 'Verify the existing fixture first'
+    token = csrf(request('/moderate/quizzes/new')[2])
+    _, headers, _ = request('/moderate/quizzes', {'csrf': token, 'title': 'Persistent prizes', 'number_of_winners': '1'})
+    quiz = headers['Location']; games = []; identities = []
+    request(quiz + '/questions', {'csrf': token, 'question': 'Persistent timing', 'active': '1', 'option_1': 'Right', 'option_2': 'Wrong', 'correct_1': '1'})
+    for ended in [True, False]:
+        _, headers, _ = request(quiz + '/games', {'csrf': token}); path = headers['Location']; games.append(path)
+        code = path.split('/')[-1]
+        slow, fast = Player(code), Player(code); slow.join('Slow'); fast.join('Fast')
+        q = command(path, token, 'start')['question']
+        fast.answer(q['id'], q['options'][0]['id']); time.sleep(.05); slow.answer(q['id'], q['options'][0]['id'])
+        identities.append([{'cookie': p.cookie, 'token': p.token} for p in [slow, fast]])
+        if ended:
+            command(path, token, 'finish'); state = command(path, token, 'end')
+            assert [p['name'] for p in state['leaderboard']] == ['Fast', 'Slow']
+            command(path, token, 'top')
+    with sqlite3.connect('storage/quizzy.sqlite3') as db:
+        timing = db.execute('SELECT q.id,q.opened_at_us,a.player_id,a.elapsed_us FROM game_questions q JOIN games g ON g.id=q.game_id JOIN game_answers a ON a.question_id=q.id WHERE g.code=? ORDER BY a.player_id', (games[1].split('/')[-1],)).fetchall()
+    fixture.write_text(json.dumps({'quiz': quiz, 'token': token, 'games': games, 'identities': identities, 'timing': timing}))
+    print('Prize persistence fixtures ready: ended winners and open timed answers.')
+
+
+def verify():
+    data = json.loads(fixture.read_text()); stream = None
+    try:
+        assert 'value="1"' in request(data['quiz'] + '/edit')[2]
+        ended, opened = data['games']; token = data['token']
+        board = json.loads(request(ended + '/state')[2])
+        assert board['number_of_winners'] == 1
+        assert [(p['name'], p['winner']) for p in board['leaderboard']] == [('Fast', True), ('Slow', False)]
+        def players(index):
+            result = []
+            for identity in data['identities'][index]:
+                p = Player(data['games'][index].split('/')[-1]); p.cookie = identity['cookie']; p.token = identity['token']; result.append(p)
+            return result
+        slow, fast = players(0)
+        assert fast.state()['winner'] and fast.state()['place'] == 1 and fast.state()['points'] == 1
+        assert not slow.state()['winner'] and slow.state()['place'] == 2
+        stream = Events(fast.path + '/events', cookie=fast.cookie); assert stream.next()['winner']
+        reset = command(ended, token, 'reset')
+        assert not stream.until(lambda s: s['version'] == reset['version'])['winner']
+        with sqlite3.connect('storage/quizzy.sqlite3') as db:
+            timing = db.execute('SELECT q.id,q.opened_at_us,a.player_id,a.elapsed_us FROM game_questions q JOIN games g ON g.id=q.game_id JOIN game_answers a ON a.question_id=q.id WHERE g.code=? ORDER BY a.player_id', (opened.split('/')[-1],)).fetchall()
+            assert [list(row) for row in timing] == data['timing'], 'Restart must preserve timing'
+        slow, fast = players(1)
+        q = fast.state()['question']; fast.answer(q['id'], q['options'][0]['id'])
+        with sqlite3.connect('storage/quizzy.sqlite3') as db:
+            picked = db.execute('SELECT a.elapsed_us FROM game_answers a JOIN players p ON p.id=a.player_id WHERE p.token=?', (fast.cookie.split('=')[1],)).fetchone()[0]
+            assert picked > max(row[3] for row in data['timing'])
+        command(opened, token, 'finish'); ended = command(opened, token, 'end')
+        assert [p['name'] for p in ended['leaderboard']] == ['Slow', 'Fast'], 'Last pick, measured from the original opening, decides speed'
+        command(opened, token, 'top'); assert slow.state()['winner'] and not fast.state()['winner']
+        print('Prize restart passed: setting, places, points, winners, resumed SSE, opening timestamp and last-pick elapsed time.')
+    finally:
+        if stream: stream.close()
+        request(data['quiz'] + '/delete', {'csrf': data['token']})
+        with sqlite3.connect('storage/quizzy.sqlite3') as db:
+            db.execute('PRAGMA foreign_keys=ON')
+            for game in data['games']: db.execute('DELETE FROM games WHERE code=?', (game.split('/')[-1],))
+        fixture.unlink()
+
+if __name__ == '__main__': {'setup': setup, 'verify': verify}[sys.argv[1]]()
