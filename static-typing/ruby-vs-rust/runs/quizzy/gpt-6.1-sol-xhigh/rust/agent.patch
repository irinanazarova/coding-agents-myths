+#!/usr/bin/env python3
+"""Timer HTTP/SSE regression; run against bin/serve. Uses only Python stdlib."""
+import html, json, re, sqlite3, time
+from smoke import request, csrf, AUTH
+from live import config, Player, Events
+
+
+def value(source, name):
+    return html.unescape(re.search(r'<input[^>]*name="' + name + r'"[^>]*value="([^"]*)"', source).group(1))
+
+
+def run():
+    source = request('/moderate/quizzes/new')[2]
+    for name, label in [('timer_minutes', 'Timer minutes'), ('timer_seconds', 'Timer seconds')]:
+        assert label in source, f'Missing {label} setting'
+        assert value(source, name) == '0', f'{label} must default to zero'
+    token = csrf(source)
+    quizzes, games, streams = [], [], []
+    try:
+        def create(minutes=0, seconds=0):
+            status, headers, _ = request('/moderate/quizzes', {
+                'csrf': token, 'title': 'Timer regression', 'timer_minutes': minutes, 'timer_seconds': seconds})
+            assert status == 303
+            quiz = headers['Location']; quizzes.append(quiz)
+            for i in range(2):
+                assert request(quiz + '/questions', {'csrf': token, 'question': f'Timed question {i + 1}',
+                    'active': 1, 'option_1': 'Right', 'correct_1': 1, 'option_2': 'Wrong'})[0] == 303
+            return quiz
+
+        def game(quiz):
+            status, headers, _ = request(quiz + '/games', {'csrf': token})
+            assert status == 303
+            path = headers['Location']; games.append(path)
+            return path
+
+        def state(path): return json.loads(request(path + '/state')[2])
+        def command(path, action, version=None):
+            status, _, body = request(path + '/control', {'csrf': token, 'action': action,
+                'version': state(path)['version'] if version is None else version})
+            return status, json.loads(body)
+
+        quiz = create(0, 3)
+        source = request(quiz + '/edit')[2]
+        assert value(source, 'timer_minutes') == '0' and value(source, 'timer_seconds') == '3'
+        for minutes, seconds in [(-1, 2), (0, -1), ('1.5', 2), (0, 'NaN'), ('999999999999999999999', 0), ('', 0)]:
+            status, _, source = request(quiz, {'csrf': token, 'title': 'Invalid timer',
+                'timer_minutes': minutes, 'timer_seconds': seconds})
+            assert status == 422, (minutes, seconds, status)
+            assert value(source, 'timer_minutes') == str(minutes)
+            assert value(source, 'timer_seconds') == str(seconds)
+            assert value(request(quiz + '/edit')[2], 'timer_seconds') == '3'
+        # A legacy title-only edit must preserve the timer.
+        assert request(quiz, {'csrf': token, 'title': 'Timer regression'})[0] == 303
+        assert value(request(quiz + '/edit')[2], 'timer_seconds') == '3'
+        export_source = request(quiz + '/export')[2]
+        exported = json.loads(html.unescape(re.search(r'<pre[^>]*>(.*?)</pre>', export_source, re.S).group(1)))
+        assert set(exported) == {'title', 'questions'}
+        exported['timer_minutes'] = 99; exported['timer_seconds'] = 99
+        status, headers, _ = request('/moderate/quizzes/import', {'csrf': token, 'quiz_json': json.dumps(exported)})
+        assert status == 303
+        imported = headers['Location']; quizzes.append(imported)
+        source = request(imported + '/edit')[2]
+        assert value(source, 'timer_minutes') == value(source, 'timer_seconds') == '0'
+
+        path = game(quiz); code = path.split('/')[-1]
+        assert 'deadline_at_ms' not in state(path), 'No timer in lobby'
+        p = Player(code); p.join('Timed Alice')
+        pe = Events('/play/' + code + '/events', cookie=p.cookie); streams.append(pe)
+        me = Events(path + '/events', auth=AUTH); streams.append(me)
+        assert command(path, 'start')[0] == 200
+        opened = state(path); deadline = opened['deadline_at_ms']
+        assert 2000 < deadline - opened['server_now_ms'] <= 3000
+        q = p.state()['question']
+        assert 'deadline_at_ms' not in p.state() and 'server_now_ms' not in p.state()
+        assert 'deadline_at_ms' not in p.req('')[2], 'Player HTML must not contain timer metadata'
+        assert p.answer(q['id'], q['options'][0]['id'])[0] == 200
+        time.sleep(.8)
+        reloaded = config(request(path)[2])['state']
+        assert reloaded['deadline_at_ms'] == deadline, 'Reload restarted the timer'
+        # Editing the quiz cannot alter this running game; the next question retains 3 seconds.
+        assert request(quiz, {'csrf': token, 'title': 'Timer edited', 'timer_minutes': 0, 'timer_seconds': 0})[0] == 303
+        # No requests or moderator browser drive expiry: the server pushes the same result as Finish.
+        closed = me.until(lambda s: s['phase'] == 'closed')
+        assert closed['version'] == opened['version'] + 1 and closed['question']['options'][0]['count'] == 1
+        assert 'deadline_at_ms' not in closed
+        assert pe.until(lambda s: s['phase'] == 'closed')['result'] == 'Correct!'
+        assert p.answer(q['id'], q['options'][1]['id'])[0] == 409
+        assert command(path, 'finish', opened['version'])[0] == 409
+        status, second = command(path, 'next')
+        assert status == 200 and second['number'] == 2 and second['deadline_at_ms'] > deadline
+        assert 2000 < second['deadline_at_ms'] - second['server_now_ms'] <= 3000
+        assert command(path, 'finish')[0] == 200
+        finished = state(path)
+        time.sleep(3.2)
+        assert state(path)['version'] == finished['version'], 'Old deadline caused a duplicate transition'
+        assert command(path, 'end')[1]['phase'] == 'ended'
+
+        no_timer = game(quiz)
+        assert 'deadline_at_ms' not in command(no_timer, 'start')[1]
+        time.sleep(3.2)
+        assert state(no_timer)['phase'] == 'open', 'Zero timer must not auto-finish'
+        assert command(no_timer, 'finish')[1]['phase'] == 'closed'
+        minutes = create(1, 30); minute_game = game(minutes)
+        opened = command(minute_game, 'start')[1]
+        assert 89000 < opened['deadline_at_ms'] - opened['server_now_ms'] <= 90000
+        print('Timer HTTP/SSE passed: defaults, validation, persistence, export exclusion, role filtering, refresh, automatic and early Finish, Next, zero timer and minutes.')
+    finally:
+        for s in streams: s.close()
+        for q in quizzes: request(q + '/delete', {'csrf': token})
+        with sqlite3.connect('storage/quizzy.sqlite3') as db:
+            db.execute('PRAGMA foreign_keys=ON')
+            for g in games: db.execute('DELETE FROM games WHERE code=?', (g.split('/')[-1],))
+
+if __name__ == '__main__': run()
