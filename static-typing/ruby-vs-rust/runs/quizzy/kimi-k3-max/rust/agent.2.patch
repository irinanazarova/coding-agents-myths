+/// Insert a quiz with all its questions in one transaction, so an import
+/// either lands completely or not at all. `questions` is a list of
+/// (text, active, options) triples in display order.
+pub fn import_quiz(
+    conn: &mut Connection,
+    title: &str,
+    questions: &[(String, bool, Vec<(String, bool)>)],
+) -> Result<i64> {
+    let tx = conn.transaction()?;
+    let quiz_id = create_quiz(&tx, title)?;
+    for (text, active, options) in questions {
+        create_question(&tx, quiz_id, text, *active, options)?;
+    }
+    tx.commit()?;
+    Ok(quiz_id)
+}
