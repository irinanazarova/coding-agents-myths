+// ---------- Export / import ----------
+
+/// The export page: the quiz as JSON inside the page's only <pre>, ready to
+/// copy and import in another Quizzy.
+pub fn export_page(quiz: &Quiz, json: &str) -> String {
+    let body = format!(
+        r#"    <div class="breadcrumbs"><a href="/moderate/quizzes/{id}">← {title}</a></div>
+    <div class="page-head"><h1>Export quiz</h1></div>
+    <div class="card">
+      <p class="muted">Copy this JSON and use “Import quiz” in any Quizzy to recreate the quiz there.</p>
+      <pre class="code-block">{json}</pre>
+    </div>"#,
+        id = quiz.id,
+        title = esc(&quiz.title),
+        json = esc(json),
+    );
+    admin_layout("Export quiz", &body)
+}
+
+/// The import page: paste quiz JSON, submit with Import. Re-renders with the
+/// errors and the submitted JSON when anything is invalid (nothing is
+/// imported in that case).
+pub fn import_form(json_value: &str, errors: &[String]) -> String {
+    let body = format!(
+        r#"    <div class="breadcrumbs"><a href="/moderate">← All quizzes</a></div>
+    <div class="page-head"><h1>Import quiz</h1></div>
+    <div class="card">
+{errors}
+      <form method="post" action="/moderate/import" novalidate>
+        <div class="field">
+          <label class="field-label" for="quiz-json">Quiz JSON</label>
+          <textarea class="input input--code" id="quiz-json" name="quiz_json" rows="14" required>{value}</textarea>
+          <span class="field-hint">Paste a quiz exported from Quizzy. Importing always creates a new quiz, even when a quiz with the same title already exists.</span>
+        </div>
+        <div class="buttons">
+          <button class="btn btn--pink" type="submit">Import</button>
+          <a class="btn btn--ghost" href="/moderate">Cancel</a>
+        </div>
+      </form>
+    </div>"#,
+        errors = errors_box(errors),
+        value = esc(json_value),
+    );
+    admin_layout("Import quiz", &body)
+}
