+//! Moving quizzes between Quizzy instances: export renders a quiz as JSON in
+//! the documented transfer format; import parses and validates such JSON.
+//!
+//! The format carries exactly the quiz contents — the title and, per question
+//! (in order), its text, active flag and options (in order) with their text
+//! and correct flag. Import applies the same rules as the question form and
+//! is all-or-nothing: any error means nothing is imported.
+
+use crate::db::{Question, Quiz};
+use crate::json::{self, Value};
+
+pub struct ImportQuiz {
+    pub title: String,
+    pub questions: Vec<ImportQuestion>,
+}
+
+pub struct ImportQuestion {
+    pub text: String,
+    pub active: bool,
+    pub options: Vec<(String, bool)>,
+}
+
+// ---------- Export ----------
+
+/// Render the quiz in the transfer format: exactly `title` and `questions`,
+/// with `text`/`active`/`options` per question and `text`/`correct` per
+/// option. Questions and options keep their stored order.
+pub fn export_json(quiz: &Quiz, questions: &[Question]) -> String {
+    let mut out = String::new();
+    out.push_str("{\n");
+    out.push_str(&format!("  \"title\": {},\n", json::quote(&quiz.title)));
+    if questions.is_empty() {
+        out.push_str("  \"questions\": []\n");
+    } else {
+        out.push_str("  \"questions\": [\n");
+        for (i, q) in questions.iter().enumerate() {
+            out.push_str("    {\n");
+            out.push_str(&format!("      \"text\": {},\n", json::quote(&q.text)));
+            out.push_str(&format!("      \"active\": {},\n", q.active));
+            if q.options.is_empty() {
+                out.push_str("      \"options\": []\n");
+            } else {
+                out.push_str("      \"options\": [\n");
+                for (j, o) in q.options.iter().enumerate() {
+                    let comma = if j + 1 == q.options.len() { "" } else { "," };
+                    out.push_str(&format!(
+                        "        {{\"text\": {}, \"correct\": {}}}{comma}\n",
+                        json::quote(&o.text),
+                        o.correct
+                    ));
+                }
+                out.push_str("      ]\n");
+            }
+            let comma = if i + 1 == questions.len() { "" } else { "," };
+            out.push_str(&format!("    }}{comma}\n"));
+        }
+        out.push_str("  ]\n");
+    }
+    out.push_str("}\n");
+    out
+}
+
+// ---------- Import ----------
+
+/// Parse and validate quiz JSON. Returns all the errors found (nothing is
+/// imported in that case): invalid JSON, wrong shapes, or questions breaking
+/// the question-form rules.
+pub fn parse_import(input: &str) -> Result<ImportQuiz, Vec<String>> {
+    let value = match json::parse(input) {
+        Ok(v) => v,
+        Err(e) => return Err(vec![format!("The JSON is invalid: {e}.")]),
+    };
+    if !matches!(value, Value::Object(_)) {
+        return Err(vec!["The quiz must be a JSON object with a title and questions.".to_string()]);
+    }
+    let mut errors = Vec::new();
+
+    let title = match value.get("title") {
+        Some(Value::String(t)) if !t.trim().is_empty() => t.trim().to_string(),
+        Some(Value::String(_)) | None => {
+            errors.push("Enter a title".to_string());
+            String::new()
+        }
+        Some(_) => {
+            errors.push("The quiz title must be a string".to_string());
+            String::new()
+        }
+    };
+
+    let mut questions = Vec::new();
+    match value.get("questions") {
+        Some(Value::Array(items)) => {
+            for (i, item) in items.iter().enumerate() {
+                if let Some(q) = parse_question(i + 1, item, &mut errors) {
+                    questions.push(q);
+                }
+            }
+        }
+        Some(_) => errors.push("The questions must be a list".to_string()),
+        None => errors.push("The quiz needs a \"questions\" list".to_string()),
+    }
+
+    if errors.is_empty() { Ok(ImportQuiz { title, questions }) } else { Err(errors) }
+}
+
+/// Validate one question like the question form does. `active` is optional
+/// (default true). Returns None when any rule broke.
+fn parse_question(n: usize, value: &Value, errors: &mut Vec<String>) -> Option<ImportQuestion> {
+    if !matches!(value, Value::Object(_)) {
+        errors.push(format!("Question {n} must be an object"));
+        return None;
+    }
+
+    let text = match value.get("text") {
+        Some(Value::String(t)) if !t.trim().is_empty() => t.trim().to_string(),
+        Some(Value::String(_)) | None => {
+            errors.push(format!("Question {n}: enter the question text"));
+            String::new()
+        }
+        Some(_) => {
+            errors.push(format!("Question {n}: the question text must be a string"));
+            String::new()
+        }
+    };
+
+    let active = match value.get("active") {
+        Some(Value::Bool(b)) => *b,
+        Some(_) => {
+            errors.push(format!("Question {n}: \"active\" must be true or false"));
+            true
+        }
+        None => true,
+    };
+
+    // Options: parse each; entries with a hard error make the counts below
+    // meaningless, so skip the count checks in that case (the errors already
+    // fail the import).
+    let mut options = Vec::new();
+    let mut options_clean = true;
+    match value.get("options") {
+        Some(Value::Array(items)) => {
+            for (j, item) in items.iter().enumerate() {
+                if !parse_option(n, j + 1, item, &mut options, errors) {
+                    options_clean = false;
+                }
+            }
+        }
+        Some(_) => {
+            errors.push(format!("Question {n}: the options must be a list"));
+            options_clean = false;
+        }
+        None => {
+            errors.push(format!("Question {n} needs an \"options\" list"));
+            options_clean = false;
+        }
+    }
+    if options_clean {
+        // The question-form rules: at least two options, at least one correct.
+        if options.len() < 2 {
+            errors.push(format!("Question {n}: add at least two options"));
+        }
+        if !options.iter().any(|(_, correct)| *correct) {
+            errors.push(format!("Question {n}: mark at least one option as correct"));
+        }
+    }
+
+    Some(ImportQuestion { text, active, options })
+}
+
+/// Parse one option; empty rows are skipped like the question form does.
+/// `correct` is optional (default false). Returns false on a hard error.
+fn parse_option(
+    qn: usize,
+    on: usize,
+    value: &Value,
+    options: &mut Vec<(String, bool)>,
+    errors: &mut Vec<String>,
+) -> bool {
+    if !matches!(value, Value::Object(_)) {
+        errors.push(format!("Question {qn}: option {on} must be an object"));
+        return false;
+    }
+    let mut ok = true;
+    let text = match value.get("text") {
+        Some(Value::String(t)) => t.trim().to_string(),
+        Some(_) => {
+            errors.push(format!("Question {qn}: option {on}: the option text must be a string"));
+            ok = false;
+            String::new()
+        }
+        None => {
+            errors.push(format!("Question {qn}: option {on}: enter the option text"));
+            ok = false;
+            String::new()
+        }
+    };
+    let correct = match value.get("correct") {
+        Some(Value::Bool(b)) => *b,
+        Some(_) => {
+            errors.push(format!("Question {qn}: option {on}: \"correct\" must be true or false"));
+            ok = false;
+            false
+        }
+        None => false,
+    };
+    if ok && !text.is_empty() {
+        options.push((text, correct));
+    }
+    ok
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn quiz() -> Quiz {
+        Quiz { id: 7, title: "Frontend Fest 2026".to_string() }
+    }
+
+    #[test]
+    fn export_writes_exactly_the_transfer_keys() {
+        let questions = vec![Question {
+            id: 1,
+            quiz_id: 7,
+            position: 1,
+            text: "Which HTTP status code means \"Too Many Requests\"?".to_string(),
+            active: true,
+            options: vec![
+                crate::db::Opt { id: 1, text: "418".to_string(), correct: false },
+                crate::db::Opt { id: 2, text: "429".to_string(), correct: true },
+            ],
+        }];
+        let out = export_json(&quiz(), &questions);
+        let parsed = json::parse(&out).expect("export is valid JSON");
+        assert_eq!(parsed.get("title").and_then(as_str), Some("Frontend Fest 2026"));
+        let Some(Value::Array(qs)) = parsed.get("questions") else { panic!() };
+        assert_eq!(qs[0].get("active"), Some(&Value::Bool(true)));
+        let Some(Value::Array(opts)) = qs[0].get("options") else { panic!() };
+        assert_eq!(opts[0].get("correct"), Some(&Value::Bool(false)));
+        // Roundtrip through import.
+        let imported = parse_import(&out).expect("export re-imports");
+        assert_eq!(imported.questions.len(), 1);
+        assert_eq!(imported.questions[0].options.len(), 2);
+    }
+
+    fn as_str(v: &Value) -> Option<&str> {
+        match v {
+            Value::String(s) => Some(s),
+            _ => None,
+        }
+    }
+
+    #[test]
+    fn export_empty_quiz() {
+        let out = export_json(&quiz(), &[]);
+        assert!(out.contains("\"questions\": []"));
+        let imported = parse_import(&out).expect("empty quiz imports");
+        assert!(imported.questions.is_empty());
+    }
+
+    #[test]
+    fn import_defaults_active_and_correct() {
+        let src = r#"{"title": "T", "questions": [{"text": "Q?", "options": [{"text": "a"}, {"text": "b", "correct": true}]}]}"#;
+        let q = parse_import(src).expect("valid");
+        assert!(q.questions[0].active);
+        assert!(!q.questions[0].options[0].1);
+        assert!(q.questions[0].options[1].1);
+    }
+
+    #[test]
+    fn import_keeps_order() {
+        let src = r#"{"title": "T", "questions": [
+            {"text": "First?", "options": [{"text": "a", "correct": true}, {"text": "b"}]},
+            {"text": "Second?", "active": false, "options": [{"text": "x", "correct": true}, {"text": "y"}, {"text": "z"}]}
+        ]}"#;
+        let q = parse_import(src).expect("valid");
+        assert_eq!(q.questions[0].text, "First?");
+        assert_eq!(q.questions[1].text, "Second?");
+        assert!(!q.questions[1].active);
+        assert_eq!(q.questions[1].options[2].0, "z");
+    }
+
+    #[test]
+    fn import_rejects_form_rule_breaks() {
+        // One option only.
+        assert!(parse_import(r#"{"title": "T", "questions": [{"text": "Q?", "options": [{"text": "a", "correct": true}]}]}"#).is_err());
+        // No correct option.
+        assert!(parse_import(r#"{"title": "T", "questions": [{"text": "Q?", "options": [{"text": "a"}, {"text": "b"}]}]}"#).is_err());
+        // Blank question text.
+        assert!(parse_import(r#"{"title": "T", "questions": [{"text": "  ", "options": [{"text": "a", "correct": true}, {"text": "b"}]}]}"#).is_err());
+        // Blank title.
+        assert!(parse_import(r#"{"title": " ", "questions": []}"#).is_err());
+    }
+
+    #[test]
+    fn import_rejects_wrong_shapes() {
+        assert!(parse_import("not json").is_err());
+        assert!(parse_import("[1,2]").is_err());
+        assert!(parse_import(r#"{"title": "T"}"#).is_err());
+        assert!(parse_import(r#"{"title": "T", "questions": [{"text": "Q?"}]}"#).is_err());
+        assert!(parse_import(r#"{"title": "T", "questions": [{"text": "Q?", "active": "yes", "options": [{"text": "a", "correct": true}, {"text": "b"}]}]}"#).is_err());
+        assert!(parse_import(r#"{"title": 3, "questions": []}"#).is_err());
+    }
+
+    #[test]
+    fn import_skips_blank_options_like_the_form() {
+        let src = r#"{"title": "T", "questions": [{"text": "Q?", "options": [{"text": ""}, {"text": "a", "correct": true}, {"text": "b"}]}]}"#;
+        let q = parse_import(src).expect("blank option skipped");
+        assert_eq!(q.questions[0].options.len(), 2);
+        // A correct flag on a skipped (blank) option does not count.
+        let bad = r#"{"title": "T", "questions": [{"text": "Q?", "options": [{"text": "", "correct": true}, {"text": "a"}, {"text": "b"}]}]}"#;
+        assert!(parse_import(bad).is_err());
+    }
+}
