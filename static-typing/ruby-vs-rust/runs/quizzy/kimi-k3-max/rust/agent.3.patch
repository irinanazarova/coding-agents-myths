--- /dev/null
+++ b/src/game.rs
@@ -0,0 +1,243 @@
+//! Live game support: join-code and token generation, QR codes, the game
+//! phase machine, and the shared live-updating JavaScript.
+
+use crate::db::{self, Game, GameStatus, Question, Quiz};
+use rusqlite::Connection;
+
+/// Unambiguous alphabet for join codes (no 0/O, 1/I).
+const CODE_ALPHABET: &[u8] = b"ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
+
+/// Read random bytes from /dev/urandom, with a time-based fallback.
+fn random_bytes(n: usize) -> Vec<u8> {
+    use std::io::Read;
+    if let Ok(mut f) = std::fs::File::open("/dev/urandom") {
+        let mut buf = vec![0u8; n];
+        if f.read_exact(&mut buf).is_ok() {
+            return buf;
+        }
+    }
+    // Fallback: hash the current time, pid and address of a stack value.
+    let mut out = Vec::with_capacity(n);
+    let mut seed = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_nanos() as u64)
+        .unwrap_or(0x9e3779b97f4a7c15)
+        ^ (std::process::id() as u64) << 32;
+    while out.len() < n {
+        seed ^= seed << 13;
+        seed ^= seed >> 7;
+        seed ^= seed << 17;
+        out.extend_from_slice(&seed.to_le_bytes());
+    }
+    out.truncate(n);
+    out
+}
+
+/// A short join code like "K7RZX".
+pub fn join_code() -> String {
+    random_bytes(5)
+        .iter()
+        .map(|b| (CODE_ALPHABET[(b % 32) as usize]) as char)
+        .collect()
+}
+
+/// A player cookie token (URL- and cookie-safe hex).
+pub fn player_token() -> String {
+    random_bytes(16).iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// FNV-1a hash of the fragment, used as the live-update version: the page
+/// only re-renders when the visible content actually changed.
+pub fn version_of(fragment: &str) -> String {
+    let mut h: u64 = 0xcbf29ce484222325;
+    for b in fragment.as_bytes() {
+        h ^= *b as u64;
+        h = h.wrapping_mul(0x100000001b3);
+    }
+    format!("{h:016x}")
+}
+
+/// Render `text` as an inline SVG QR code (dark modules on the design's
+/// night ink; the .qr container provides the white quiet zone).
+pub fn qr_svg(text: &str) -> String {
+    use qrcodegen::{QrCode, QrCodeEcc};
+    let Ok(qr) = QrCode::encode_text(text, QrCodeEcc::Medium) else {
+        return String::new();
+    };
+    let size = qr.size();
+    let mut d = String::new();
+    for y in 0..size {
+        for x in 0..size {
+            if qr.get_module(x, y) {
+                d.push_str(&format!("M{x} {y}h1v1h-1z"));
+            }
+        }
+    }
+    format!(
+        r##"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {size} {size}" shape-rendering="crispEdges"><path d="{d}" fill="#0d0640"/></svg>"##
+    )
+}
+
+/// Everything the big screen and the phones need to know about a game.
+pub struct GameView {
+    pub game: Game,
+    pub quiz: Quiz,
+    pub players: i64,
+    /// Active questions in display order (games skip inactive ones).
+    pub active: Vec<Question>,
+}
+
+impl GameView {
+    pub fn load(conn: &Connection, game_id: i64) -> Option<GameView> {
+        let game = db::get_game(conn, game_id).ok().flatten()?;
+        let quiz = db::get_quiz(conn, game.quiz_id).ok().flatten()?;
+        let players = db::count_players(conn, game_id).unwrap_or(0);
+        let active = db::list_questions(conn, game.quiz_id)
+            .unwrap_or_default()
+            .into_iter()
+            .filter(|q| q.active)
+            .collect();
+        Some(GameView { game, quiz, players, active })
+    }
+
+    /// The question currently on stage (kept even if it was deactivated
+    /// mid-game; new games simply skip inactive questions).
+    pub fn current_question(&self, conn: &Connection) -> Option<Question> {
+        let qid = self.game.question_id?;
+        if let Some(q) = self.active.iter().find(|q| q.id == qid) {
+            return Some(q.clone());
+        }
+        db::get_question(conn, qid).ok().flatten()
+    }
+
+    /// 1-based index of the current question among the active ones, and the
+    /// total — the "Question 1 of 3" numbers.
+    pub fn progress(&self, conn: &Connection) -> Option<(usize, usize)> {
+        let qid = self.game.question_id?;
+        if let Some(idx) = self.active.iter().position(|q| q.id == qid) {
+            return Some((idx + 1, self.active.len()));
+        }
+        // Current question deactivated mid-game: number it by its position.
+        let cur = db::get_question(conn, qid).ok().flatten()?;
+        let before = self
+            .active
+            .iter()
+            .filter(|q| (q.position, q.id) < (cur.position, cur.id))
+            .count();
+        Some((before + 1, self.active.len() + 1))
+    }
+
+    /// The next active question after the current one, if any.
+    pub fn next_question(&self, conn: &Connection) -> Option<Question> {
+        let qid = self.game.question_id?;
+        if let Some(idx) = self.active.iter().position(|q| q.id == qid) {
+            return self.active.get(idx + 1).cloned();
+        }
+        // Current question deactivated mid-game: skip ahead by position.
+        let cur = db::get_question(conn, qid).ok().flatten()?;
+        self.active
+            .iter()
+            .find(|q| (q.position, q.id) > (cur.position, cur.id))
+            .cloned()
+    }
+
+    /// Advance the state machine one step. `action` is one of
+    /// start | finish | next | end (unknown actions are ignored).
+    pub fn apply(conn: &Connection, game: &Game, action: &str) {
+        match (action, &game.status, game.question_open) {
+            ("start", GameStatus::Lobby, _) => {
+                let active: Vec<Question> = db::list_questions(conn, game.quiz_id)
+                    .unwrap_or_default()
+                    .into_iter()
+                    .filter(|q| q.active)
+                    .collect();
+                match active.first() {
+                    Some(q) => {
+                        let _ = db::game_show_question(conn, game.id, q.id);
+                    }
+                    // No active questions: the quiz is over before it began.
+                    None => {
+                        let _ = db::game_finish(conn, game.id);
+                    }
+                }
+            }
+            ("finish", GameStatus::Playing, true) => {
+                let _ = db::game_close_question(conn, game.id);
+            }
+            ("next", GameStatus::Playing, false) => {
+                let view = GameView::load(conn, game.id);
+                match view.as_ref().and_then(|v| v.next_question(conn)) {
+                    Some(q) => {
+                        let _ = db::game_show_question(conn, game.id, q.id);
+                    }
+                    None => {
+                        let _ = db::game_finish(conn, game.id);
+                    }
+                }
+            }
+            ("end", GameStatus::Playing, _) => {
+                let _ = db::game_finish(conn, game.id);
+            }
+            _ => {}
+        }
+    }
+}
+
+/// The JavaScript that keeps the big screen and the phones in sync: it polls
+/// the state fragment once per second (cheap, and it recovers by itself on
+/// crowded conference Wi-Fi), swaps the HTML when the version changed, and
+/// turns in-page form submits / option taps into fetch calls so nobody ever
+/// reloads. Without JS the plain forms still work (303 redirects).
+pub const LIVE_JS: &str = r##"(function () {
+  var el = document.getElementById("live");
+  if (!el) return;
+  // Resolve URLs against the origin (never includes credentials, even when
+  // the moderator browses with user:pass@ in the address bar).
+  function abs(u) {
+    return new URL(u, location.origin).toString();
+  }
+  var url = abs(el.getAttribute("data-state-url"));
+  var version = el.getAttribute("data-version") || "";
+  function refresh() {
+    fetch(url, { headers: { "X-Quizzy-Live": "1" }, cache: "no-store" })
+      .then(function (res) {
+        if (!res.ok) return null;
+        var v = res.headers.get("X-Game-Version") || "";
+        return res.text().then(function (body) {
+          if (v && v !== version) {
+            version = v;
+            el.innerHTML = body;
+          }
+        });
+      })
+      .catch(function () {});
+  }
+  setInterval(refresh, 1000);
+  document.addEventListener("submit", function (ev) {
+    var form = ev.target;
+    if (!form || !form.hasAttribute("data-live")) return;
+    ev.preventDefault();
+    var data = new URLSearchParams(new FormData(form));
+    if (ev.submitter && ev.submitter.name) data.set(ev.submitter.name, ev.submitter.value);
+    fetch(abs(form.getAttribute("action")), {
+      method: "POST",
+      body: data,
+      headers: { "X-Quizzy-Live": "1" },
+    })
+      .catch(function () {})
+      .then(refresh);
+  });
+  document.addEventListener("click", function (ev) {
+    var t = ev.target;
+    var btn = t && t.closest ? t.closest("button[data-option-url]") : null;
+    if (!btn) return;
+    ev.preventDefault();
+    fetch(abs(btn.getAttribute("data-option-url")), {
+      method: "POST",
