+// ---------- Live game: player phone ----------
+
+fn phone_layout(quiz: &Quiz, inner_body: &str, live_attrs: &str, with_js: bool) -> String {
+    let js = if with_js { format!("<script>{LIVE_JS}</script>") } else { String::new() };
+    format!(
+        r#"<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Quizzy · {title}</title>
+<link rel="stylesheet" href="/assets/quizzy.css">
+</head>
+<body>
+  <div class="play">
+    <div class="play__top"><span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span><span>{title}</span></div>
+    <div class="play__body play__body--top"{live_attrs}>
+{inner_body}
+    </div>
+  </div>
+{js}
+</body>
+</html>"#,
+        title = esc(&quiz.title),
+    )
+}
+
+/// The join page: asks for "Your name", no account needed.
+pub fn join_page(quiz: &Quiz, code: &str, name_value: &str, errors: &[String]) -> String {
+    let body = format!(
+        r#"      <h1 class="play-title">{title}</h1>
+      <p class="play-lead">Enter your name to join the game.</p>
+{errors}
+      <form class="join-form" method="post" action="/play/{code}/join">
+        <div class="field">
+          <label class="field-label" for="player-name">Your name</label>
+          <input class="input" id="player-name" type="text" name="name" value="{name}" maxlength="40" autocomplete="off" autofocus required>
+        </div>
+        <button class="btn btn--pink" type="submit">Join</button>
+      </form>"#,
+        title = esc(&quiz.title),
+        errors = errors_box(errors),
+        name = esc(name_value),
+    );
+    phone_layout(quiz, &body, "", false)
+}
+
+/// Shown when the join link is opened after the game ended.
+pub fn play_over_page(quiz: &Quiz) -> String {
+    let body = r#"      <div class="waiting">
+        <div class="waiting__gem">?</div>
+        <h1 class="play-title">The quiz is over</h1>
+        <p class="play-lead">This game has already ended.</p>
+      </div>"#;
+    phone_layout(quiz, body, "", false)
+}
+
+/// The player page shell; #live is kept fresh by the polling JS.
+pub fn play_page(quiz: &Quiz, code: &str, fragment: &str, version: &str) -> String {
+    let attrs = format!(
+        r#" id="live" data-state-url="/play/{code}/state" data-version="{version}""#
+    );
+    phone_layout(quiz, fragment, &attrs, true)
+}
+
+/// What the phone shows right now. While a question is open the fragment
+/// contains no hint of the correct options — not even in the page source.
+pub fn play_fragment(conn: &Connection, view: &GameView, player: &Player) -> String {
+    match view.game.status {
+        GameStatus::Lobby => format!(
+            r#"      <div class="waiting">
+        <div class="waiting__gem">?</div>
+        <h1 class="play-title">Hi, {name}!</h1>
+        <p class="play-lead">Waiting for the quiz to start…</p>
+      </div>"#,
+            name = esc(&player.name),
+        ),
+        GameStatus::Finished => r#"      <div class="waiting">
+        <div class="waiting__gem">?</div>
+        <h1 class="play-title">The quiz is over</h1>
+        <p class="play-lead">Thanks for playing!</p>
+      </div>"#
+            .to_string(),
+        GameStatus::Playing => {
+            let Some(q) = view.current_question(conn) else {
+                return r#"      <div class="waiting">
+        <div class="waiting__gem">?</div>
+        <h1 class="play-title">One moment…</h1>
+        <p class="play-lead">Waiting for the next question…</p>
+      </div>"#
+                    .to_string();
+            };
+            let (n, total) = view.progress(conn).unwrap_or((1, view.active.len().max(1)));
+            let picked = db::player_answer(conn, player.id, q.id).ok().flatten();
+            let mut opts = String::new();
+            if view.game.question_open {
+                for (j, o) in q.options.iter().enumerate() {
+                    let (class, mark) = if picked == Some(o.id) {
+                        (" is-picked", r#"<span class="play-option__mark">Your answer</span>"#)
+                    } else {
+                        ("", "")
+                    };
+                    opts.push_str(&format!(
+                        r#"<button class="play-option{class}" type="submit" name="option" value="{oid}" data-option-url="/play/{code}/answer"><span class="play-option__letter">{letter}</span><span class="play-option__title">{text}</span>{mark}</button>
+            "#,
+                        oid = o.id,
+                        code = view.game.code,
+                        letter = letter(j),
+                        text = esc(&o.text),
+                    ));
+                }
+                format!(
+                    r#"      <div class="play-question__num">Question {n} of {total}</div>
+      <div class="play-question__body">{text}</div>
+      <div class="play-options"><form method="post" action="/play/{code}/answer">
+            {opts}</form></div>"#,
+                    text = esc(&q.text),
+                    code = view.game.code,
+                )
+            } else {
+                for (j, o) in q.options.iter().enumerate() {
+                    let mut class = String::from("play-option");
+                    if o.correct {
+                        class.push_str(" is-correct");
+                    }
+                    if picked == Some(o.id) {
+                        class.push_str(" is-picked");
+                    }
+                    let mut mark = String::new();
+                    if picked == Some(o.id) {
+                        mark.push_str(r#"<span class="play-option__mark">Your answer</span>"#);
+                    }
+                    if o.correct {
+                        mark.push_str(r#"<span class="play-option__mark">Correct</span>"#);
+                    }
+                    opts.push_str(&format!(
+                        r#"<div class="{class}"><span class="play-option__letter">{letter}</span><span class="play-option__title">{text}</span>{mark}</div>
+            "#,
+                        letter = letter(j),
+                        text = esc(&o.text),
+                    ));
+                }
+                let (status_class, verdict) = match picked {
+                    None => ("play-status play-status--neutral", "No answer"),
+                    Some(oid) => {
+                        if q.options.iter().find(|o| o.id == oid).map(|o| o.correct).unwrap_or(false) {
+                            ("play-status play-status--right", "Correct!")
+                        } else {
+                            ("play-status play-status--wrong", "Wrong!")
+                        }
+                    }
+                };
+                format!(
+                    r#"      <div class="play-question__num">Question {n} of {total}</div>
+      <div class="play-question__body">{text}</div>
+      <div class="play-options is-locked is-revealed">
+            {opts}</div>
+      <div class="{status_class}" role="status">{verdict}</div>"#,
+                    text = esc(&q.text),
+                )
+            }
+        }
+    }
+}
