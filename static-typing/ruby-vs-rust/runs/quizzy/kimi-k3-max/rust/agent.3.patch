+            match player {
+                // The browser remembers the player: continue the game.
+                Some(player) => {
+                    let Some(view) = GameView::load(conn, game.id) else { return Resp::not_found() };
+                    let fragment = views::play_fragment(conn, &view, &player);
+                    let version = game::version_of(&fragment);
+                    Resp::html(views::play_page(&quiz, &game.code, &fragment, &version)).no_store()
+                }
+                None => match game.status {
+                    GameStatus::Finished => Resp::html(views::play_over_page(&quiz)).no_store(),
+                    _ => Resp::html(views::join_page(&quiz, &game.code, "", &[])).no_store(),
+                },
+            }
+        }
+        ("POST", ["play", code, "join"]) => {
+            let Some(game) = db::get_game_by_code(conn, code).ok().flatten() else { return Resp::not_found() };
+            let Some(quiz) = db::get_quiz(conn, game.quiz_id).ok().flatten() else { return Resp::not_found() };
+            let cookie = player_cookie(&game.code);
+            // Already joined from this browser? Keep the same player.
+            if let Some(_player) = req
+                .cookie(&cookie)
+                .and_then(|token| db::get_player_by_token(conn, game.id, token).ok().flatten())
+            {
+                return Resp::redirect(&format!("/play/{code}"));
+            }
+            if game.status == GameStatus::Finished {
+                return Resp::redirect(&format!("/play/{code}"));
+            }
+            let name = req.param("name").unwrap_or("").trim().to_string();
+            if name.is_empty() {
+                return Resp::html(views::join_page(
+                    &quiz,
+                    &game.code,
+                    "",
+                    &["Enter your name".to_string()],
+                ))
