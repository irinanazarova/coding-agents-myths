+
+// ---------- Games ----------
+
+fn game_from_row(row: &rusqlite::Row) -> Result<Game> {
+    let status = match row.get::<_, String>(3)?.as_str() {
+        "playing" => GameStatus::Playing,
+        "finished" => GameStatus::Finished,
+        _ => GameStatus::Lobby,
+    };
+    Ok(Game {
+        id: row.get(0)?,
+        quiz_id: row.get(1)?,
+        code: row.get(2)?,
+        status,
+        question_id: row.get(4)?,
+        question_open: row.get::<_, i64>(5)? != 0,
+    })
+}
+
+const GAME_COLUMNS: &str = "id, quiz_id, code, status, question_id, question_open";
+
+/// Create a game in the lobby. Retries with a fresh code if the (very
+/// unlikely) UNIQUE collision on `code` happens.
+pub fn create_game(conn: &Connection, quiz_id: i64, code: &str) -> Result<i64> {
+    conn.execute(
+        "INSERT INTO games (quiz_id, code) VALUES (?1, ?2)",
+        params![quiz_id, code],
+    )?;
+    Ok(conn.last_insert_rowid())
+}
+
+pub fn get_game(conn: &Connection, id: i64) -> Result<Option<Game>> {
+    let mut stmt = conn.prepare(&format!("SELECT {GAME_COLUMNS} FROM games WHERE id = ?1"))?;
+    let mut rows = stmt.query(params![id])?;
+    match rows.next()? {
+        Some(row) => Ok(Some(game_from_row(row)?)),
+        None => Ok(None),
+    }
+}
+
+pub fn get_game_by_code(conn: &Connection, code: &str) -> Result<Option<Game>> {
+    let mut stmt = conn.prepare(&format!("SELECT {GAME_COLUMNS} FROM games WHERE code = ?1"))?;
+    let mut rows = stmt.query(params![code])?;
+    match rows.next()? {
+        Some(row) => Ok(Some(game_from_row(row)?)),
+        None => Ok(None),
+    }
+}
+
+/// Show the first/next question: game is playing, answers are accepted.
+pub fn game_show_question(conn: &Connection, game_id: i64, question_id: i64) -> Result<()> {
+    conn.execute(
+        "UPDATE games SET status = 'playing', question_id = ?2, question_open = 1 WHERE id = ?1",
+        params![game_id, question_id],
+    )?;
+    Ok(())
+}
+
+/// Close the current question (answers frozen, results shown).
+pub fn game_close_question(conn: &Connection, game_id: i64) -> Result<()> {
+    conn.execute(
+        "UPDATE games SET question_open = 0 WHERE id = ?1",
+        params![game_id],
+    )?;
+    Ok(())
+}
+
+/// End the whole game.
+pub fn game_finish(conn: &Connection, game_id: i64) -> Result<()> {
+    conn.execute(
+        "UPDATE games SET status = 'finished', question_open = 0 WHERE id = ?1",
+        params![game_id],
+    )?;
+    Ok(())
+}
+
+// ---------- Players ----------
+
+pub fn create_player(conn: &Connection, game_id: i64, name: &str, token: &str) -> Result<i64> {
+    conn.execute(
+        "INSERT INTO players (game_id, name, token) VALUES (?1, ?2, ?3)",
+        params![game_id, name, token],
+    )?;
+    Ok(conn.last_insert_rowid())
+}
+
+/// Find a player of this game by its cookie token.
+pub fn get_player_by_token(conn: &Connection, game_id: i64, token: &str) -> Result<Option<Player>> {
+    if token.is_empty() {
+        return Ok(None);
+    }
+    let mut stmt =
+        conn.prepare("SELECT id, name FROM players WHERE game_id = ?1 AND token = ?2")?;
+    let mut rows = stmt.query(params![game_id, token])?;
+    match rows.next()? {
+        Some(row) => Ok(Some(Player { id: row.get(0)?, name: row.get(1)? })),
+        None => Ok(None),
+    }
+}
+
+/// Number of players currently in the game.
+pub fn count_players(conn: &Connection, game_id: i64) -> Result<i64> {
+    conn.query_row(
+        "SELECT COUNT(*) FROM players WHERE game_id = ?1",
+        params![game_id],
+        |row| row.get(0),
+    )
+}
+
+// ---------- Answers ----------
+
+/// Record (or change, while the question is open) a player's answer.
+pub fn upsert_answer(conn: &Connection, player_id: i64, question_id: i64, option_id: i64) -> Result<()> {
+    conn.execute(
+        "INSERT INTO answers (player_id, question_id, option_id) VALUES (?1, ?2, ?3)
+         ON CONFLICT (player_id, question_id)
+         DO UPDATE SET option_id = excluded.option_id, updated_at = datetime('now')",
+        params![player_id, question_id, option_id],
+    )?;
+    Ok(())
+}
+
+/// The option this player picked for the question, if any.
+pub fn player_answer(conn: &Connection, player_id: i64, question_id: i64) -> Result<Option<i64>> {
+    let mut stmt =
+        conn.prepare("SELECT option_id FROM answers WHERE player_id = ?1 AND question_id = ?2")?;
+    let mut rows = stmt.query(params![player_id, question_id])?;
+    match rows.next()? {
+        Some(row) => Ok(Some(row.get(0)?)),
+        None => Ok(None),
+    }
+}
+
+/// How many players of this game answered the question.
+pub fn count_answers(conn: &Connection, game_id: i64, question_id: i64) -> Result<i64> {
+    conn.query_row(
+        "SELECT COUNT(*) FROM answers a JOIN players p ON p.id = a.player_id
+         WHERE p.game_id = ?1 AND a.question_id = ?2",
+        params![game_id, question_id],
+        |row| row.get(0),
+    )
+}
+
+/// Per-option answer counts for the results view: (option_id, count) for
+/// every option of the question, restricted to players of this game.
+pub fn option_counts(conn: &Connection, game_id: i64, question_id: i64) -> Result<Vec<(i64, i64)>> {
+    let mut stmt = conn.prepare(
+        "SELECT o.id,
+                (SELECT COUNT(*) FROM answers a JOIN players p ON p.id = a.player_id
+                 WHERE p.game_id = ?1 AND a.option_id = o.id)
+         FROM options o WHERE o.question_id = ?2 ORDER BY o.position, o.id",
+    )?;
+    let rows = stmt.query_map(params![game_id, question_id], |row| {
+        Ok((row.get::<_, i64>(0)?, row.get::<_, i64>(1)?))
+    })?;
+    rows.collect()
+}
