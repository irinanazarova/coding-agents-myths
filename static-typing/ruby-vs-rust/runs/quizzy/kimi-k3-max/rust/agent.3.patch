+fn play(req: &Request, conn: &Connection, segs: &[&str]) -> Resp {
+    match (req.method.as_str(), segs) {
+        ("GET", ["play", code]) => {
+            let Some(game) = db::get_game_by_code(conn, code).ok().flatten() else { return Resp::not_found() };
