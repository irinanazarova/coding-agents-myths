+                    ("next", "Next")
+                } else {
+                    ("end", "End quiz")
+                };
+                format!("{body}
+{}", stage_controls(view, "", &action(value, label)))
+            }
+        }
+        GameStatus::Finished => {
+            let body = format!(
+                r#"      <div class="screen__body">
+        <div class="screen__kicker">{title}</div>
+        <div class="stage-question__body">The quiz is over</div>
+      </div>"#,
+                title = esc(&view.quiz.title),
+            );
+            format!("{body}
+{}", stage_controls(view, "", ""))
+        }
+    }
+}
