+// ---------- Leaderboard & winners ----------
+
+/// The final ranking of a game: one row per player, most points first; ties
+/// on points are broken by the total time of the player's correct answers
+/// (lower is faster), then by join order for a stable output.
+pub fn leaderboard(conn: &Connection, game_id: i64) -> Result<Vec<Leader>> {
+    // Points and time come from the same join: a correct answer counts only
+    // for a question that was actually opened in this game.
+    let mut stmt = conn.prepare(
+        "SELECT p.id, p.name, p.winner,
+                (SELECT COUNT(*) FROM answers a
+                   JOIN options o ON o.id = a.option_id AND o.correct = 1
+                   JOIN question_opens qo ON qo.question_id = a.question_id AND qo.game_id = p.game_id
+                 WHERE a.player_id = p.id),
+                (SELECT COALESCE(SUM(MAX(a.answered_ms - qo.opened_ms, 0)), 0) FROM answers a
+                   JOIN options o ON o.id = a.option_id AND o.correct = 1
+                   JOIN question_opens qo ON qo.question_id = a.question_id AND qo.game_id = p.game_id
+                 WHERE a.player_id = p.id)
+         FROM players p WHERE p.game_id = ?1
+         ORDER BY 4 DESC, 5 ASC, p.id ASC",
+    )?;
+    let rows = stmt.query_map(params![game_id], |row| {
+        Ok(Leader {
+            player_id: row.get(0)?,
+            name: row.get(1)?,
+            winner: row.get::<_, i64>(2)? != 0,
+            points: row.get(3)?,
+            time_ms: row.get(4)?,
+        })
+    })?;
+    rows.collect()
+}
