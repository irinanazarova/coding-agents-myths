+        3
+    } else {
+        match winners_raw.parse::<i64>() {
+            Ok(n) if n >= 1 => n,
+            _ => {
+                errors.push("Number of winners must be at least 1".to_string());
+                3
+            }
+        }
+    };
+    (winners, errors)
+}
