@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Minimal Chrome DevTools Protocol driver (no external deps).
+
+Implements just enough WebSocket framing + CDP to open tabs, evaluate JS,
+and observe live updates in Quizzy's big screen / phone pages.
+"""
+import base64, json, os, socket, struct, sys, time, urllib.request
+
+DEBUG_HOST, DEBUG_PORT = "127.0.0.1", 9222
+
+
+class WS:
+    def __init__(self, url):
+        assert url.startswith("ws://")
+        rest = url[5:]
+        hostport, _, path = rest.partition("/")
+        host, _, port = hostport.partition(":")
+        self.sock = socket.create_connection((host, int(port or 80)))
+        key = base64.b64encode(os.urandom(16)).decode()
+        req = (f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\nUpgrade: websocket\r\n"
+               f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n")
+        self.sock.sendall(req.encode())
+        buf = b""
+        while b"\r\n\r\n" not in buf:
+            buf += self.sock.recv(4096)
+        assert b"101" in buf.split(b"\r\n")[0], buf
+        self.buf = b""
+
+    def send(self, payload: str):
+        data = payload.encode()
+        header = bytearray([0x81])
+        n = len(data)
+        if n < 126:
+            header.append(0x80 | n)
+        elif n < 65536:
+            header.append(0x80 | 126)
+            header += struct.pack(">H", n)
+        else:
+            header.append(0x80 | 127)
+            header += struct.pack(">Q", n)
+        mask = os.urandom(4)
+        header += mask
+        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
+        self.sock.sendall(bytes(header) + masked)
+
+    def _read_exact(self, n):
+        while len(self.buf) < n:
+            chunk = self.sock.recv(65536)
+            if not chunk:
+                raise ConnectionError("ws closed")
+            self.buf += chunk
+        out, self.buf = self.buf[:n], self.buf[n:]
+        return out
+
+    def recv(self):
+        while True:
+            b1, b2 = self._read_exact(2)
+            opcode = b1 & 0x0F
+            n = b2 & 0x7F
+            if n == 126:
+                (n,) = struct.unpack(">H", self._read_exact(2))
+            elif n == 127:
+                (n,) = struct.unpack(">Q", self._read_exact(8))
+            payload = self._read_exact(n)
+            if opcode == 1:  # text
+                return payload.decode()
+            if opcode == 9:  # ping -> pong
+                self.sock.sendall(b"\x8a\x80" + os.urandom(4))
+            # ignore pong/close/binary
+
+
+class CDP:
+    def __init__(self):
+        for _ in range(50):
+            try:
+                with urllib.request.urlopen(f"http://{DEBUG_HOST}:{DEBUG_PORT}/json/version") as r:
+                    info = json.load(r)
+                break
+            except Exception:
+                time.sleep(0.2)
+        else:
+            raise RuntimeError("chromium devtools not reachable")
+        self.ws = WS(info["webSocketDebuggerUrl"])
+        self.next_id = 0
+        self.pending = {}
+
+    def _roundtrip(self, msg):
+        self.ws.send(json.dumps(msg))
+        while True:
+            data = json.loads(self.ws.recv())
+            if data.get("id") == msg["id"]:
+                return data
+
+    def cmd(self, method, params=None, session=None):
+        self.next_id += 1
+        msg = {"id": self.next_id, "method": method, "params": params or {}}
+        if session:
+            msg["sessionId"] = session
+        res = self._roundtrip(msg)
+        if "error" in res:
+            raise RuntimeError(f"{method}: {res['error']}")
+        return res.get("result", {})
+
+    def new_tab(self, url):
+        t = self.cmd("Target.createTarget", {"url": "about:blank"})
+        tid = t["targetId"]
+        s = self.cmd("Target.attachToTarget", {"targetId": tid, "flatten": True})["sessionId"]
+        self.cmd("Page.enable", session=s)
+        self.cmd("Page.navigate", {"url": url}, session=s)
+        return Tab(self, s)
+
+
+class Tab:
+    def __init__(self, cdp, session):
+        self.cdp, self.session = cdp, session
+
+    def js(self, expr):
+        r = self.cdp.cmd("Runtime.evaluate", {
+            "expression": expr, "returnByValue": True, "awaitPromise": True}, session=self.session)
+        return r.get("result", {}).get("value")
+
+    def text(self):
+        return self.js("document.body ? document.body.innerText : ''") or ""
+
+    def html(self):
+        return self.js("document.documentElement.outerHTML") or ""
+
+    def wait_for(self, needle, timeout=5.0):
+        """Wait until the page's visible text contains `needle`; return latency."""
+        start = time.monotonic()
+        while time.monotonic() - start < timeout:
+            if needle in self.text():
+                return time.monotonic() - start
+            time.sleep(0.1)
+        raise AssertionError(f"timed out waiting for {needle!r}; page says:\n{self.text()[:800]}")
+
+
+if __name__ == "__main__":
+    print("cdp module — import and use CDP()/Tab")
+
+def new_context(cdp):
+    return cdp.cmd("Target.createBrowserContext")["browserContextId"]
+
+def new_tab(cdp, url, context=None):
+    params = {"url": "about:blank"}
+    if context:
+        params["browserContextId"] = context
+    t = cdp.cmd("Target.createTarget", params)
+    tid = t["targetId"]
+    s = cdp.cmd("Target.attachToTarget", {"targetId": tid, "flatten": True})["sessionId"]
+    cdp.cmd("Page.enable", session=s)
+    cdp.cmd("Page.navigate", {"url": url}, session=s)
+    return Tab(cdp, s)
diff --git a/test/e2e.sh b/test/e2e.sh
new file mode 100755
index 0000000..8cb3d3c
--- /dev/null
+++ b/test/e2e.sh
@@ -0,0 +1,180 @@
+#!/usr/bin/env bash
+# End-to-end smoke test for the prizes release: settings field, scoring by
+# points + speed, leaderboard, Top N / Draw / Reset winners, phone views.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+PORT="${TEST_PORT:-3999}"
+BASE="http://localhost:$PORT"
+DB="storage/test-e2e.db"
+rm -f "$DB" "$DB-wal" "$DB-shm"
+
+cargo build --release --offline
+
+PORT=$PORT SECRET_KEY_BASE=e2e QUIZZY_MODERATOR_USERNAME=mod \
+  QUIZZY_MODERATOR_PASSWORD=pass QUIZZY_DATABASE_PATH=$DB \
+  ./target/release/quizzy &
+SERVER=$!
+trap 'kill $SERVER 2>/dev/null || true' EXIT
+
+for i in $(seq 1 60); do
+  curl -sf "$BASE/up" > /dev/null 2>&1 && break
+  sleep 0.2
+done
+
+PASS=0; FAIL=0
+ok()   { PASS=$((PASS+1)); echo "ok   $1"; }
+bad()  { FAIL=$((FAIL+1)); echo "FAIL $1"; }
+has()  { if [[ "$2" == *"$3"* ]]; then ok "$1"; else bad "$1 — missing: $3"; fi; }
+hasnt(){ if [[ "$2" == *"$3"* ]]; then bad "$1 — unexpected: $3"; else ok "$1"; fi; }
+
+AUTH="-u mod:pass"
+M="$BASE/moderate"
+
+# ---------- Quiz settings: the "Number of winners" field ----------
+NEW_FORM=$(curl -s $AUTH "$M/quizzes/new")
+has "new form has the label" "$NEW_FORM" "Number of winners"
+has "new form defaults to 3" "$NEW_FORM" 'name="winners" value="3"'
+
+QURL=$(curl -s $AUTH -o /dev/null -w '%{redirect_url}' -X POST "$M/quizzes" \
+  --data-urlencode "title=Conf Quiz" --data-urlencode "winners=2")
+QID=${QURL##*/}
+SETTINGS=$(curl -s $AUTH "$M/quizzes/$QID/edit")
+has "settings shows saved winners" "$SETTINGS" 'name="winners" value="2"'
+
+BAD=$(curl -s $AUTH -X POST "$M/quizzes" --data-urlencode "title=Bad" --data-urlencode "winners=0")
+has "winners=0 is rejected" "$BAD" "Number of winners must be at least 1"
+DEFURL=$(curl -s $AUTH -o /dev/null -w '%{redirect_url}' -X POST "$M/quizzes" \
+  --data-urlencode "title=Defaulted")
+DEFID=${DEFURL##*/}
+DEFFORM=$(curl -s $AUTH "$M/quizzes/$DEFID/edit")
+has "missing winners param defaults to 3" "$DEFFORM" 'name="winners" value="3"'
+
+# ---------- Questions ----------
+add_q() { # quiz question correct_idx opt1 opt2 opt3
+  curl -s $AUTH -o /dev/null -X POST "$M/quizzes/$1/questions" \
+    --data-urlencode "option_count=3" \
+    --data-urlencode "question=$2" \
+    --data-urlencode "option_text_1=$4" \
+    --data-urlencode "option_text_2=$5" \
+    --data-urlencode "option_text_3=$6" \
+    ${3:+--data-urlencode "option_correct_$3=1"} \
+    --data-urlencode "active=1"
+}
+add_q "$QID" "First question?" 1 Alpha Beta Gamma
+add_q "$QID" "Second question?" 2 Red Green Blue
+Q1=$(sqlite3 "$DB" "SELECT id FROM questions WHERE quiz_id=$QID ORDER BY position LIMIT 1")
+Q2=$(sqlite3 "$DB" "SELECT id FROM questions WHERE quiz_id=$QID ORDER BY position LIMIT 1 OFFSET 1")
+R1=$(sqlite3 "$DB" "SELECT id FROM options WHERE question_id=$Q1 AND correct=1")
+W1=$(sqlite3 "$DB" "SELECT id FROM options WHERE question_id=$Q1 AND correct=0 LIMIT 1")
+R2=$(sqlite3 "$DB" "SELECT id FROM options WHERE question_id=$Q2 AND correct=1")
+W2=$(sqlite3 "$DB" "SELECT id FROM options WHERE question_id=$Q2 AND correct=0 LIMIT 1")
+
+# ---------- Game & players ----------
+GURL=$(curl -s $AUTH -o /dev/null -w '%{redirect_url}' -X POST "$M/quizzes/$QID/games")
+GID=${GURL##*/}
+STAGE=$(curl -s $AUTH "$M/quizzes/$QID/games/$GID")
+CODE=$(echo "$STAGE" | grep -o 'play/[A-Z0-9]\{5\}' | head -1 | cut -d/ -f2)
+[[ -n "$CODE" ]] && ok "join code found: $CODE" || { echo "no join code"; exit 1; }
+
+join() { curl -s -c "test/$1.jar" -b "test/$1.jar" -o /dev/null -X POST "$BASE/play/$CODE/join" --data-urlencode "name=$1"; }
+rm -f test/*.jar
+join Ann; join Bob; join Cid; join Dee   # Dee never answers
+
+act() { curl -s $AUTH -o /dev/null -X POST "$M/quizzes/$QID/games/$GID/action" --data-urlencode "action=$1"; }
+answer() { curl -s -c "test/$1.jar" -b "test/$1.jar" -o /dev/null -X POST "$BASE/play/$CODE/answer" --data-urlencode "option=$2"; }
+phone() { curl -s -b "test/$1.jar" "$BASE/play/$CODE"; }
+stage() { curl -s $AUTH "$M/quizzes/$QID/games/$GID"; }
+
+# ---------- Play: Q1 ----------
+act start
+sleep 0.2; answer Ann "$W1"   # Ann re-picks: the last pick counts (result + time)
+sleep 0.3; answer Ann "$R1"
+sleep 0.5; answer Bob "$R1"   # Bob correct but slower than Ann
+sleep 0.7; answer Cid "$W1"   # wrong
+STAGE_OPEN=$(curl -s $AUTH "$M/quizzes/$QID/games/$GID/state")
+has "big screen counts answers while open" "$STAGE_OPEN" "Answers:"
+act finish
+
+ANN_Q1=$(curl -s -b "test/Ann.jar" "$BASE/play/$CODE/state")
+has "phone shows verdict after finish" "$ANN_Q1" "Correct!"
+hasnt "no points during the game" "$ANN_Q1" "points"
+STAGE_Q1=$(curl -s $AUTH "$M/quizzes/$QID/games/$GID/state")
+has "big screen reveals the correct option" "$STAGE_Q1" "Correct"
+act next
+
+# ---------- Play: Q2 ----------
+sleep 0.3; answer Ann "$R2"   # Ann: 2 points
+sleep 1.2; answer Cid "$R2"   # Cid: 1 point, slow
+sleep 0.2; answer Bob "$W2"   # Bob: 1 point, fast (Q1 time 0.8s)
+act finish
+act end
+
+# ---------- Leaderboard on the big screen ----------
+FIN=$(stage)
+has "leaderboard heading" "$FIN" "Leaderboard"
+has "Top button with N" "$FIN" 'value="top">Top 2<'
+has "Draw button" "$FIN" 'value="draw">Draw<'
+has "Reset winners button" "$FIN" 'value="reset">Reset winners<'
+has "Ann row: 2 points" "$FIN" 'Ann</span><span class="leader__score">2 points</span>'
+has "Bob row: 1 point"  "$FIN" 'Bob</span><span class="leader__score">1 point</span>'
+has "Cid row: 1 point"  "$FIN" 'Cid</span><span class="leader__score">1 point</span>'
+# Order: Ann (2) then Bob (1, faster) then Cid (1, slower)
+ORDER=$(echo "$FIN" | grep -o 'leader__place">[0-9]*</span><span class="leader__name">[A-Za-z]*' | sed 's/.*name">//')
+[[ "$ORDER" == $'Ann\nBob\nCid\nDee' ]] && ok "leaderboard order is Ann, Bob, Cid, Dee" || bad "leaderboard order: $ORDER"
+
+# ---------- Phones show place and points ----------
+ANN_FIN=$(phone Ann); BOB_FIN=$(phone Bob); CID_FIN=$(phone Cid); DEE_FIN=$(phone Dee)
+has "Dee phone place" "$DEE_FIN" "Place 4 of 4"
+has "Dee phone: 0 points" "$DEE_FIN" "0 points"
+has "Dee leaderboard row: 0 points" "$FIN" 'Dee</span><span class="leader__score">0 points</span>' 
+has "Ann phone place" "$ANN_FIN" "Place 1 of 4"
+has "Ann phone points" "$ANN_FIN" "2 points"
+has "Bob phone place" "$BOB_FIN" "Place 2 of 4"
+has "Bob phone points" "$BOB_FIN" "1 point"
+has "Cid phone place" "$CID_FIN" "Place 3 of 4"
+hasnt "no winners yet (Ann)" "$ANN_FIN" "You won!"
+hasnt "no winner marks yet on stage" "$FIN" "Winner<"
+
+# ---------- Top 2 ----------
+act top
+FIN=$(stage)
+has "Top 2 marks Ann"   "$FIN" 'Ann <span class="leader__badge">Winner</span>'
+has "Top 2 marks Bob"   "$FIN" 'Bob <span class="leader__badge">Winner</span>'
+hasnt "Top 2 does not mark Cid" "$FIN" 'Cid <span class="leader__badge">Winner</span>'
+has "Ann phone: You won!" "$(phone Ann)" "You won!"
+has "Bob phone: You won!" "$(phone Bob)" "You won!"
+hasnt "Cid phone: no banner" "$(phone Cid)" "You won!"
+hasnt "Dee (0 points) never wins with Top" "$(phone Dee)" "You won!"
+has "Cid phone still shows place" "$(phone Cid)" "Place 3 of 4"
+
+# ---------- Reset winners ----------
+act reset
+hasnt "reset clears stage marks" "$(stage)" "Winner</span>"
+hasnt "reset clears phone banner" "$(phone Ann)" "You won!"
+
+# ---------- Draw: Ann (>1 point) wins for sure; one of Bob/Cid drawn ----------
+act draw
+FIN=$(stage)
+has "draw always keeps Ann" "$FIN" 'Ann <span class="leader__badge">Winner</span>'
+NB=$(echo "$FIN" | grep -c 'leader__badge">Winner' || true)
+[[ "$NB" == "2" ]] && ok "draw picked exactly 2 winners" || bad "draw picked $NB winners"
+hasnt "Dee (0 points) never wins a draw" "$(phone Dee)" "You won!"
+# Repeated draws should eventually change the drawn player.
+CHANGED=""
+for i in $(seq 1 40); do
+  act draw
+  F=$(stage)
+  if echo "$F" | grep -q 'Cid <span class="leader__badge">Winner</span>'; then CHANGED=cid; fi
+  if echo "$F" | grep -q 'Bob <span class="leader__badge">Winner</span>'; then
+    [[ "$CHANGED" == "cid" ]] && break
+  fi
+done
+[[ -n "$CHANGED" ]] && ok "draw re-draws among tied players" || bad "draw never changed"
+
+# ---------- /up ----------
+has "/up is 200 OK" "$(curl -s "$BASE/up")" "OK"
+
+echo
+echo "passed: $PASS, failed: $FAIL"
+[[ $FAIL -eq 0 ]]
