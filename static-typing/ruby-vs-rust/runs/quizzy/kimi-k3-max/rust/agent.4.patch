+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn leader(id: i64, points: i64) -> Leader {
+        Leader { player_id: id, name: format!("P{id}"), points, time_ms: 0, winner: false }
+    }
+
+    #[test]
+    fn top_takes_first_n_scoring_players() {
+        let board = vec![leader(1, 3), leader(2, 2), leader(3, 1), leader(4, 0)];
+        assert_eq!(pick_top(&board, 3), vec![1, 2, 3]);
+        assert_eq!(pick_top(&board, 2), vec![1, 2]);
+        assert_eq!(pick_top(&board, 10), vec![1, 2, 3]);
+        // Players with 0 points never win.
+        let board = vec![leader(1, 3), leader(2, 0), leader(3, 0)];
+        assert_eq!(pick_top(&board, 3), vec![1]);
+        assert!(pick_top(&[], 3).is_empty());
+    }
+
+    #[test]
+    fn draw_keeps_better_places_and_draws_among_tied() {
+        // Points 5,2,2,2,2 with N=3: place 1 wins, 2 prizes drawn among the
+        // four players with 2 points.
+        let board = vec![leader(1, 5), leader(2, 2), leader(3, 2), leader(4, 2), leader(5, 2)];
+        let winners = pick_draw(&board, 3);
+        assert_eq!(winners.len(), 3);
+        assert!(winners.contains(&1));
+        assert!(winners.iter().all(|id| *id == 1 || board[*id as usize - 1].points == 2));
+        // Each click draws again: over many draws the selection must vary.
+        let differs = (0..60).any(|_| pick_draw(&board, 3) != winners);
+        assert!(differs, "the draw never changed over 60 tries");
+    }
+
+    #[test]
+    fn draw_never_picks_zero_point_players() {
+        let board = vec![leader(1, 2), leader(2, 0), leader(3, 0)];
+        assert_eq!(pick_draw(&board, 3), vec![1]);
+        assert!(pick_draw(&[leader(1, 0)], 3).is_empty());
+    }
+
+    #[test]
+    fn draw_with_everyone_tied_draws_exactly_n() {
+        let board = vec![leader(1, 2), leader(2, 2), leader(3, 2), leader(4, 2), leader(5, 2)];
+        let winners = pick_draw(&board, 3);
+        assert_eq!(winners.len(), 3);
+        let mut unique = winners.clone();
+        unique.sort_unstable();
+        unique.dedup();
+        assert_eq!(unique.len(), 3, "no duplicate winners");
+    }
+
+    #[test]
+    fn draw_with_fewer_players_than_prizes() {
+        let board = vec![leader(1, 1), leader(2, 2)];
+        let mut winners = pick_draw(&board, 3);
+        winners.sort_unstable();
+        assert_eq!(winners, vec![1, 2], "all scoring players win");
+        // Only one of them scored.
+        let board = vec![leader(1, 0), leader(2, 2)];
+        assert_eq!(pick_draw(&board, 3), vec![2]);
+    }
+}
