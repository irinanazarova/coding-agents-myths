+
+    /// A game with two questions; players answer with crafted timestamps so
+    /// the ranking (points first, then total correct-answer time) is exact.
+    #[test]
+    fn leaderboard_ranks_by_points_then_speed() {
+        let conn = Connection::open_in_memory().unwrap();
+        migrate(&conn).unwrap();
+        let quiz_id = create_quiz(&conn, "Quiz", 3).unwrap();
+        let q1 = create_question(&conn, quiz_id, "Q1", true, &[
+            ("right".to_string(), true),
+            ("wrong".to_string(), false),
+        ]).unwrap();
+        let q2 = create_question(&conn, quiz_id, "Q2", true, &[
+            ("right".to_string(), true),
+            ("wrong".to_string(), false),
+        ]).unwrap();
+        let game_id = create_game(&conn, quiz_id, "TESTC").unwrap();
+        let ann = create_player(&conn, game_id, "Ann", "tok-a").unwrap();
+        let bob = create_player(&conn, game_id, "Bob", "tok-b").unwrap();
+        let cid = create_player(&conn, game_id, "Cid", "tok-c").unwrap();
+        let right1 = conn.query_row("SELECT id FROM options WHERE question_id = ?1 AND correct = 1", params![q1], |r| r.get::<_, i64>(0)).unwrap();
+        let wrong1 = conn.query_row("SELECT id FROM options WHERE question_id = ?1 AND correct = 0", params![q1], |r| r.get::<_, i64>(0)).unwrap();
+        let right2 = conn.query_row("SELECT id FROM options WHERE question_id = ?1 AND correct = 1", params![q2], |r| r.get::<_, i64>(0)).unwrap();
+
+        // Question opens at fixed moments.
+        conn.execute("INSERT INTO question_opens (game_id, question_id, opened_ms) VALUES (?1, ?2, 1000)", params![game_id, q1]).unwrap();
+        conn.execute("INSERT INTO question_opens (game_id, question_id, opened_ms) VALUES (?1, ?2, 5000)", params![game_id, q2]).unwrap();
+
+        let answer = |player: i64, question: i64, option: i64, ms: i64| {
+            conn.execute(
+                "INSERT INTO answers (player_id, question_id, option_id, answered_ms) VALUES (?1, ?2, ?3, ?4)",
+                params![player, question, option, ms],
+            ).unwrap();
+        };
+        // Ann: both right, 1000ms + 1500ms total.
+        answer(ann, q1, right1, 2000);
+        answer(ann, q2, right2, 6500);
+        // Bob: one right, fast (500ms). Cid: one right, slow (2000ms).
+        answer(bob, q1, right1, 1500);
+        answer(bob, q2, wrong1, 6000); // wrong option id belongs to q1; still wrong
+        answer(cid, q1, right1, 3000);
+
+        let board = leaderboard(&conn, game_id).unwrap();
+        let names: Vec<&str> = board.iter().map(|e| e.name.as_str()).collect();
+        assert_eq!(names, vec!["Ann", "Bob", "Cid"], "points first, speed breaks ties");
+        assert_eq!(board[0].points, 2);
+        assert_eq!(board[0].time_ms, 2500);
+        assert_eq!(board[1].points, 1);
+        assert_eq!(board[1].time_ms, 500);
+        assert_eq!(board[2].points, 1);
+        assert_eq!(board[2].time_ms, 2000);
+
+        // Winners round-trip through set/clear.
+        set_winners(&conn, game_id, &[ann, cid]).unwrap();
+        let board = leaderboard(&conn, game_id).unwrap();
+        let winners: Vec<&str> = board.iter().filter(|e| e.winner).map(|e| e.name.as_str()).collect();
+        assert_eq!(winners, vec!["Ann", "Cid"]);
+        clear_winners(&conn, game_id).unwrap();
+        assert!(leaderboard(&conn, game_id).unwrap().iter().all(|e| !e.winner));
+    }
+
+    #[test]
+    fn quiz_winners_defaults_to_three_and_updates() {
+        let conn = Connection::open_in_memory().unwrap();
+        migrate(&conn).unwrap();
+        let id = create_quiz(&conn, "Quiz", 3).unwrap();
+        assert_eq!(get_quiz(&conn, id).unwrap().unwrap().winners, 3);
+        update_quiz(&conn, id, "Quiz", 5).unwrap();
+        assert_eq!(get_quiz(&conn, id).unwrap().unwrap().winners, 5);
+        // Never below 1.
+        update_quiz(&conn, id, "Quiz", 0).unwrap();
+        assert_eq!(get_quiz(&conn, id).unwrap().unwrap().winners, 1);
+    }
+}
