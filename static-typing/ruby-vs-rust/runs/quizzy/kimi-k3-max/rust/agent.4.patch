+/// Replace the game's winner set with exactly these players.
+pub fn set_winners(conn: &Connection, game_id: i64, player_ids: &[i64]) -> Result<()> {
+    conn.execute("UPDATE players SET winner = 0 WHERE game_id = ?1", params![game_id])?;
+    if !player_ids.is_empty() {
+        let marks = player_ids.iter().map(|_| "?").collect::<Vec<_>>().join(", ");
+        let sql = format!(
+            "UPDATE players SET winner = 1 WHERE game_id = ? AND id IN ({marks})"
+        );
+        let all = std::iter::once(game_id).chain(player_ids.iter().copied());
+        conn.execute(&sql, rusqlite::params_from_iter(all))?;
+    }
+    Ok(())
+}
+
+/// Remove all winners of the game.
+pub fn clear_winners(conn: &Connection, game_id: i64) -> Result<()> {
+    conn.execute("UPDATE players SET winner = 0 WHERE game_id = ?1", params![game_id])?;
+    Ok(())
+}
