+/// "Top N": the first N players of the leaderboard win — except players
+/// with 0 points, who never win (so with fewer than N scoring players,
+/// exactly the scoring ones win).
+pub fn pick_top(board: &[Leader], n: i64) -> Vec<i64> {
+    board
+        .iter()
+        .take(n.max(1) as usize)
+        .filter(|e| e.points > 0)
+        .map(|e| e.player_id)
+        .collect()
+}
+
+/// "Draw": every player with more points than the N-th place wins; the
+/// remaining prizes are drawn at random among the players with exactly the
+/// N-th place's points (speed doesn't matter). Players with 0 points never
+/// win. Each call draws again.
+pub fn pick_draw(board: &[Leader], n: i64) -> Vec<i64> {
+    let n = n.max(1) as usize;
+    // With fewer than N players there is no N-th place: treat its points as
+    // 0, so every scoring player wins and nobody is drawn.
+    let nth = if board.len() >= n { board[n - 1].points } else { 0 };
+    let mut winners: Vec<i64> = board
+        .iter()
+        .filter(|e| e.points > nth)
+        .map(|e| e.player_id)
+        .collect();
+    if nth > 0 {
+        let mut pool: Vec<i64> = board
+            .iter()
+            .filter(|e| e.points == nth)
+            .map(|e| e.player_id)
+            .collect();
+        shuffle(&mut pool);
+        let remaining = n.saturating_sub(winners.len());
+        winners.extend(pool.into_iter().take(remaining));
+    }
+    winners
+}
+
+/// Fisher-Yates with bytes from /dev/urandom.
+fn shuffle(ids: &mut [i64]) {
+    if ids.len() < 2 {
+        return;
+    }
+    let bytes = random_bytes(ids.len() * 8);
+    for i in (1..ids.len()).rev() {
+        let raw: [u8; 8] = bytes[i * 8..i * 8 + 8].try_into().unwrap_or([0; 8]);
+        let j = (u64::from_le_bytes(raw) as usize) % (i + 1);
+        ids.swap(i, j);
+    }
+}
