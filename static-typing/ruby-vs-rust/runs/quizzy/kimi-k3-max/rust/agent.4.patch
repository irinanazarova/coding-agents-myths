+#!/usr/bin/env python3
+"""Full live-game test in headless Chromium: big screen + two phones follow
+the moderator close to instantly; winners flow (Top N / Draw / Reset)."""
+import subprocess, sys, time, urllib.request
+sys.path.insert(0, "test")
+from cdp import CDP, new_context, new_tab
+
+PORT = 3998
+BASE = f"http://127.0.0.1:{PORT}"
+DB = "storage/test-browser.db"
+
+def sh(args, **kw):
+    return subprocess.run(args, shell=True, check=True, text=True,
+                          capture_output=True, **kw).stdout
+
+for suffix in ("", "-wal", "-shm"):
+    subprocess.run(f"rm -f {DB}{suffix}", shell=True)
+
+server = subprocess.Popen(
+    ["./target/release/quizzy"],
+    env={"PATH": "/usr/bin:/bin", "PORT": str(PORT), "SECRET_KEY_BASE": "bt",
+         "QUIZZY_MODERATOR_USERNAME": "mod", "QUIZZY_MODERATOR_PASSWORD": "pass",
+         "QUIZZY_DATABASE_PATH": DB})
+chrome = subprocess.Popen(
+    ["chromium", "--headless=new", "--no-sandbox", "--disable-gpu",
+     "--remote-debugging-port=9222", "--user-data-dir=/tmp/quizzy-chrome",
+     "about:blank"],
+    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+checks = {"pass": 0, "fail": 0}
+def check(name, cond):
+    checks["pass" if cond else "fail"] += 1
+    print(("ok   " if cond else "FAIL ") + name)
+
+try:
+    for _ in range(60):
+        try:
+            urllib.request.urlopen(f"{BASE}/up", timeout=0.3)
+            break
+        except Exception:
+            time.sleep(0.2)
+
+    # Seed: quiz with 1 question (option 1 correct), winners = 2.
+    qurl = sh(f'curl -s -u mod:pass -o /dev/null -w "%{{redirect_url}}" -X POST '
+              f'{BASE}/moderate/quizzes --data-urlencode "title=Browser Quiz" '
+              f'--data-urlencode "winners=2"')
+    qid = qurl.rstrip("/").split("/")[-1]
+    sh(f'curl -s -u mod:pass -o /dev/null -X POST {BASE}/moderate/quizzes/{qid}/questions '
+       f'--data-urlencode "option_count=3" --data-urlencode "question=Capital of France?" '
+       f'--data-urlencode "option_text_1=Paris" --data-urlencode "option_correct_1=1" '
+       f'--data-urlencode "option_text_2=London" --data-urlencode "option_text_3=Rome" '
+       f'--data-urlencode "active=1"')
+    gurl = sh(f'curl -s -u mod:pass -o /dev/null -w "%{{redirect_url}}" -X POST '
+              f'{BASE}/moderate/quizzes/{qid}/games')
+    gid = gurl.rstrip("/").split("/")[-1]
+    stage_url = f"{BASE}/moderate/quizzes/{qid}/games/{gid}"
+    html = sh(f"curl -s -u mod:pass {stage_url}")
+    import re
+    code = re.search(r"play/([A-Z0-9]{5})", html).group(1)
+
+    cdp = CDP()
+    stage = new_tab(cdp, f"http://mod:pass@127.0.0.1:{PORT}/moderate/quizzes/{qid}/games/{gid}")
+    stage.wait_for("Start")
+
+    # Two players join through the join page, each in its own browser context.
+    phones = {}
+    for name in ("Ann", "Bob"):
+        tab = new_tab(cdp, f"{BASE}/play/{code}", context=new_context(cdp))
+        tab.wait_for("Your name")
+        tab.js(f'document.querySelector("#player-name").value = "{name}";')
+        tab.js('document.querySelector(".join-form button[type=submit]").click();')
+        tab.wait_for(f"Hi, {name}!")
+        phones[name] = tab
+    check("both players joined", True)
+    stage.wait_for("Players: 2")
+
+    # --- Start: phones must follow close to instantly. ---
+    t0 = time.monotonic()
+    stage.js('document.querySelector("button[value=start]").click()')
+    lat = phones["Ann"].wait_for("Question 1 of 1")
+    check(f"phone followed Start in {lat:.2f}s (< 1.5s)", lat < 1.5)
+    check("phone shows options, no correctness hint",
+          "Paris" in phones["Ann"].text() and "is-correct" not in phones["Ann"].html())
+
+    phones["Ann"].js('document.querySelector("button.play-option").click()')
+    phones["Ann"].wait_for("Your answer")
+    time.sleep(1.0)  # Bob is clearly slower
+    phones["Bob"].js('document.querySelector("button.play-option").click()')
+    phones["Bob"].wait_for("Your answer")
+    stage.wait_for("Answers: 2 / 2")
+
+    # --- Finish, then End quiz ---
+    stage.js('document.querySelector("button[value=finish]").click()')
+    lat = phones["Ann"].wait_for("Correct!")
+    check(f"phone followed Finish in {lat:.2f}s (< 1.5s)", lat < 1.5)
+    check("no points during the game", "point" not in phones["Ann"].text())
+
+    t0 = time.monotonic()
+    stage.js('document.querySelector("button[value=end]").click()')
+    lat = stage.wait_for("Leaderboard")
+    check(f"big screen shows leaderboard in {lat:.2f}s (< 1.5s)", lat < 1.5)
+    lat = phones["Ann"].wait_for("Place 1 of 2")
+    check(f"phone shows result in {lat:.2f}s (< 1.5s)", lat < 1.5)
+    check("Ann: place + points", "1 point" in phones["Ann"].text())
+    phones["Bob"].wait_for("Place 2 of 2")
+    check("Bob: place + points",
+          "Place 2 of 2" in phones["Bob"].text() and "1 point" in phones["Bob"].text())
+    st = stage.text()
+    check("stage rows in order", st.find("Ann") != -1 and st.find("Ann") < st.find("Bob"))
+    check("stage shows points", "1 point" in st)
+    check("winner buttons present",
+          all(b in st for b in ("Top 2", "Draw", "Reset winners")))
+    check("no winners yet", "You won!" not in phones["Ann"].text())
+
+    # --- Top 2 ---
+    stage.js('document.querySelector("button[value=top]").click()')
+    lat = phones["Ann"].wait_for("You won!")
+    check(f"Ann phone: You won! in {lat:.2f}s (< 1.5s)", lat < 1.5)
+    phones["Bob"].wait_for("You won!")
+    check("Bob phone: You won!", "You won!" in phones["Bob"].text())
+    check("stage marks winners", stage.html().count('leader__badge">Winner') == 2)
+    check("phone keeps place + points after winning",
+          "Place 1 of 2" in phones["Ann"].text() and "1 point" in phones["Ann"].text())
+
+    # --- Reset winners ---
+    stage.js('document.querySelector("button[value=reset]").click()')
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline and "You won!" in phones["Ann"].text():
+        time.sleep(0.1)
+    check("reset clears the phone banner", "You won!" not in phones["Ann"].text())
+    check("reset clears stage badges", 'leader__badge">Winner' not in stage.html())
+
+    # --- Draw (both tied at 1 point -> both win) ---
+    stage.js('document.querySelector("button[value=draw]").click()')
+    phones["Ann"].wait_for("You won!")
+    phones["Bob"].wait_for("You won!")
+    check("draw picked both tied players",
+          "You won!" in phones["Ann"].text() and "You won!" in phones["Bob"].text())
+
+finally:
+    server.terminate()
+    chrome.terminate()
+    print(f"\npassed: {checks['pass']}, failed: {checks['fail']}")
+    sys.exit(1 if checks["fail"] else 0)
