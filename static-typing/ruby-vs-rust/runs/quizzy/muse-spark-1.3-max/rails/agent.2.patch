+<header class="admin-header">
+  <span class="logo"><span class="logo__mark">?</span>Quizzy</span>
+  <span class="admin-header__tag">Moderator</span>
+</header>
+
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+  <div class="page-head"><h1>Import quiz</h1></div>
+  <div class="card">
+    <%= form_with url: moderate_import_path, method: :post, local: true, html: { id: "import-form" } do %>
+      <% if @errors.any? %>
+        <div class="errors">
+          <ul>
+            <% @errors.each do |e| %>
+              <li><%= e %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+      <div class="field">
+        <label for="quiz_json">Quiz JSON</label>
+        <textarea class="input" rows="15" id="quiz_json" name="quiz_json" aria-label="Quiz JSON" placeholder="Quiz JSON" style="font-family: monospace; min-height: 300px;"><%= h @quiz_json %></textarea>
+        <span class="field-hint">Paste the exported quiz JSON here.</span>
+      </div>
+      <div class="buttons">
+        <button type="submit" class="btn btn--pink">Import</button>
+        <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
