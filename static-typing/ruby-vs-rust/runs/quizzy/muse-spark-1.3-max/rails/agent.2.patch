+    def export
+      @questions = @quiz.questions.includes(:options).order(:position, :id)
+      data = {
+        "title" => @quiz.title,
+        "questions" => @questions.map do |q|
+          {
+            "text" => q.body,
+            "active" => !!q.active?,
+            "options" => q.options.order(:position, :id).map { |o| { "text" => o.text, "correct" => !!o.correct? } }
+          }
+        end
+      }
+      @export_json = JSON.pretty_generate(data)
+    end
