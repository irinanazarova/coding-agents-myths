diff --git a/test/application_system_test_case.rb b/test/application_system_test_case.rb
new file mode 100644
index 0000000..258e346
--- /dev/null
+++ b/test/application_system_test_case.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+require "capybara/cuprite"
+
+Capybara.register_driver(:cuprite_live) do |app|
+  Capybara::Cuprite::Driver.new(
+    app,
+    browser_path: "/usr/bin/chromium",
+    browser_options: { "no-sandbox": nil, "disable-gpu": nil, "disable-dev-shm-usage": nil },
+    process_timeout: 30,
+    timeout: 30,
+    window_size: [1280, 800]
+  )
+end
+
+Capybara.javascript_driver = :cuprite_live
+Capybara.default_max_wait_time = 10
+
+class ApplicationSystemTestCase < ActionDispatch::SystemTestCase
+  driven_by :cuprite_live
+end
diff --git a/test/integration/game_edge_test.rb b/test/integration/game_edge_test.rb
new file mode 100644
index 0000000..462a6c7
--- /dev/null
+++ b/test/integration/game_edge_test.rb
@@ -0,0 +1,196 @@
+require "test_helper"
+
+class GameEdgeTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "mod"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "secret"
+    @auth = { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("mod", "secret") }
+  end
+
+  test "empty quiz game" do
+    quiz = Quiz.create!(title: "Empty")
+    # No questions
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game = Game.last
+    assert_equal "waiting", game.status
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    assert_response :success
+    assert_match "Players: 0", response.body
+    assert_match "Start", response.body
+    # Start should end immediately
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/start", headers: @auth
+    game.reload
+    assert_equal "ended", game.status
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    assert_match "The quiz is over", response.body
+    puts "✓ Empty quiz ends immediately"
+
+    # All inactive
+    quiz2 = Quiz.create!(title: "Inactive")
+    q = quiz2.questions.create!(body: "Q?", active: false, position: 1)
+    q.options.create!(text: "A", correct: true, position: 1)
+    q.options.create!(text: "B", correct: false, position: 2)
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game2 = Game.last
+    post "/moderate/quizzes/#{quiz.id}/games/#{game2.id}/start", headers: @auth
+    game2.reload
+    assert_equal "ended", game2.status
+    puts "✓ All inactive ends"
+  end
+
+  test "single question flow shows End quiz not Next" do
+    quiz = Quiz.create!(title: "Single")
+    q = quiz.questions.create!(body: "Q1?", active: true, position: 1)
+    q.options.create!(text: "A", correct: true, position: 1)
+    q.options.create!(text: "B", correct: false, position: 2)
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game = Game.last
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/start", headers: @auth
+    game.reload
+    assert_equal "open", game.status
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    assert_match "Question 1 of 1", response.body
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/finish", headers: @auth
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    assert_match "End quiz", response.body
+    assert_no_match(/>Next</, response.body)
+    puts "✓ Single shows End quiz"
+  end
+
+  test "multi-correct question" do
+    quiz = Quiz.create!(title: "Multi")
+    q = quiz.questions.create!(body: "Pick corrects?", active: true, position: 1)
+    q.options.create!(text: "A correct", correct: true, position: 1)
+    q.options.create!(text: "B correct", correct: true, position: 2)
+    q.options.create!(text: "C wrong", correct: false, position: 3)
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game = Game.last
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/start", headers: @auth
+    # Alice picks A (correct) -> Correct!
+    alice = game.players.create!(name: "Alice")
+    optA = q.options.find_by(text: "A correct")
+    optC = q.options.find_by(text: "C wrong")
+    post "/play/#{game.code}/answer", params: { option_id: optA.id, token: alice.token }
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/finish", headers: @auth
+    get "/play/#{game.code}/state", params: { token: alice.token }
+    data = JSON.parse(response.body)
+    assert_equal "Correct!", data["result_text"]
+    # Bob picks C wrong -> Wrong!
+    bob = game.players.create!(name: "Bob")
+    # Need to answer before finish? But already finished. So create new game for Bob wrong test
+    # Actually test Bob in same game but after finish cannot answer; need to test before finish
+    # Let's create game2 for wrong test
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game2 = Game.last
+    post "/moderate/quizzes/#{quiz.id}/games/#{game2.id}/start", headers: @auth
+    bob2 = game2.players.create!(name: "Bob")
+    post "/play/#{game2.code}/answer", params: { option_id: optC.id, token: bob2.token }
+    post "/moderate/quizzes/#{quiz.id}/games/#{game2.id}/finish", headers: @auth
+    get "/play/#{game2.code}/state", params: { token: bob2.token }
+    data2 = JSON.parse(response.body)
+    assert_equal "Wrong!", data2["result_text"]
+    puts "✓ Multi-correct: Correct! and Wrong! OK"
+
+    # Moderator should mark both correct with Correct (2 occurrences)
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    # Count occurrences of ">Correct<" (our marking)
+    count = response.body.scan(/>Correct</).size
+    assert_equal 2, count, "expected 2 Correct markings, got #{count} in #{response.body[0..2000]}"
+    puts "✓ Multi-correct moderator shows 2 Correct"
+  end
+
+  test "join during open and closed" do
+    quiz = Quiz.create!(title: "Late")
+    q = quiz.questions.create!(body: "Q?", active: true, position: 1)
+    q.options.create!(text: "A", correct: true, position: 1)
+    q.options.create!(text: "B", correct: false, position: 2)
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game = Game.last
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/start", headers: @auth
+    # Join during open via endpoint
+    post "/play/#{game.code}/join", params: { player: { name: "LateOpen" } }
+    assert_response :redirect
+    follow_redirect!
+    assert_match "Hi, LateOpen!", response.body
+    assert_match "Q?", response.body # should see current question immediately
+    puts "✓ Join during open sees question"
+
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/finish", headers: @auth
+    # Clear cookies to simulate new player? Our test jar has LateOpen cookie, need to clear?
+    # Use direct POST with new name but existing cookie will return existing player (LateOpen) instead of new?
+    # Our join checks existing cookie first: if existing, redirect without creating new.
+    # To test new join when closed, need to clear cookie jar.
+    # In integration test, we can delete cookie:
+    cookies.delete("quizzy_player_#{game.code}")
+    post "/play/#{game.code}/join", params: { player: { name: "LateClosed" } }
+    assert_response :redirect
+    follow_redirect!
+    assert_match "Hi, LateClosed!", response.body
+    assert_match "No answer", response.body
+    puts "✓ Join during closed sees No answer"
+  end
+
+  test "answer ignored when closed" do
+    quiz = Quiz.create!(title: "Ignore")
+    q = quiz.questions.create!(body: "Q?", active: true, position: 1)
+    optA = nil
+    q.options.create!(text: "A", correct: true, position: 1)
+    q.options.create!(text: "B", correct: false, position: 2)
+    optA = q.options.find_by(text: "A")
+    optB = q.options.find_by(text: "B")
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game = Game.last
+    alice = game.players.create!(name: "Alice")
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/start", headers: @auth
+    post "/play/#{game.code}/answer", params: { option_id: optA.id, token: alice.token }
+    assert_equal optA.id, Answer.find_by(player_id: alice.id, question_id: q.id).option_id
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/finish", headers: @auth
+    # Try to change after closed – should be ignored
+    post "/play/#{game.code}/answer", params: { option_id: optB.id, token: alice.token }
+    assert_equal optA.id, Answer.find_by(player_id: alice.id, question_id: q.id).option_id
+    puts "✓ Answer ignored when closed"
+  end
+
+  test "code case-insensitive and auth required" do
+    quiz = Quiz.create!(title: "Auth")
+    q = quiz.questions.create!(body: "Q?", active: true, position: 1)
+    q.options.create!(text: "A", correct: true, position: 1)
+    q.options.create!(text: "B", correct: false, position: 2)
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game = Game.last
+    # Moderator pages require auth
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}"
+    assert_response :unauthorized
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}/state"
+    assert_response :unauthorized
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/start"
+    assert_response :unauthorized
+    puts "✓ Moderator auth required"
+
+    # Player no auth, case-insensitive
+    get "/play/#{game.code.downcase}"
+    assert_response :success
+    assert_match "Your name", response.body
+    puts "✓ Player case-insensitive, no auth"
+  end
+
+  test "player name escaping and blank" do
+    quiz = Quiz.create!(title: "Escape")
+    q = quiz.questions.create!(body: "Q?", active: true, position: 1)
+    q.options.create!(text: "A", correct: true, position: 1)
+    q.options.create!(text: "B", correct: false, position: 2)
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game = Game.last
+    # Blank name should 422
+    post "/play/#{game.code}/join", params: { player: { name: "   " } }
+    assert_response :unprocessable_entity
+    puts "✓ Blank name 422"
+    # HTML escaping
+    post "/play/#{game.code}/join", params: { player: { name: "<b>Alice</b>" } }
+    assert_response :redirect
+    follow_redirect!
+    assert_match "Hi, &lt;b&gt;Alice&lt;/b&gt;!", response.body
+    assert_no_match(/<b>Alice<\/b>/, response.body)
+    puts "✓ Name escaped"
+  end
+end
diff --git a/test/integration/game_live_test.rb b/test/integration/game_live_test.rb
new file mode 100644
index 0000000..64f9da7
--- /dev/null
+++ b/test/integration/game_live_test.rb
@@ -0,0 +1,291 @@
+require "test_helper"
+
+class GameLiveTest < ActionDispatch::IntegrationTest
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "mod"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "secret"
+    @auth = { "Authorization" => ActionController::HttpAuthentication::Basic.encode_credentials("mod", "secret") }
+  end
+
+  test "full game flow" do
+    # Create quiz with 3 questions, middle inactive
+    quiz = Quiz.create!(title: "Conf Talk")
+    q1 = quiz.questions.create!(body: "Q1 Capital of France?", active: true, position: 1)
+    q1.options.create!(text: "Paris", correct: true, position: 1)
+    q1.options.create!(text: "London", correct: false, position: 2)
+    q2 = quiz.questions.create!(body: "Q2 Inactive?", active: false, position: 2)
+    q2.options.create!(text: "A", correct: true, position: 1)
+    q2.options.create!(text: "B", correct: false, position: 2)
+    q3 = quiz.questions.create!(body: "Q3 2+2?", active: true, position: 3)
+    q3.options.create!(text: "4", correct: true, position: 1)
+    q3.options.create!(text: "5", correct: false, position: 2)
+
+    # Quiz page has Start a game
+    get "/moderate/quizzes/#{quiz.id}", headers: @auth
+    assert_response :success
+    assert_match "Start a game", response.body
+    puts "✓ Quiz page has Start a game"
+
+    # Create game
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    assert_response :redirect
+    game = Game.last
+    assert_equal quiz.id, game.quiz_id
+    assert_equal "waiting", game.status
+    assert_match(/[A-Z0-9]{5}/, game.code)
+    puts "✓ Game created code=#{game.code} status=#{game.status}"
+
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    assert_response :success
+    # Check waiting page
+    assert_match quiz.title, response.body
+    assert_match "Players: 0", response.body
+    assert_match "Start", response.body
+    # Join link
+    assert_match "/play/#{game.code}", response.body
+    # QR code (svg)
+    assert_match "<svg", response.body
+    puts "✓ Waiting page has title, Players, join link, QR"
+
+    # Check state JSON
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}/state", headers: @auth.merge("Accept" => "application/json")
+    assert_response :success
+    data = JSON.parse(response.body)
+    assert_equal "waiting", data["status"]
+    assert_equal "Players: 0", data["players_text"]
+    assert_equal "start", data["action"]
+    puts "✓ Moderator state JSON waiting OK: #{data.inspect[0..200]}"
+
+    # Player join: get join page (no auth)
+    get "/play/#{game.code}"
+    assert_response :success
+    assert_match "Your name", response.body
+    assert_match "Join", response.body
+    puts "✓ Join page has Your name + Join"
+
+    # Join as Alice
+    post "/play/#{game.code}/join", params: { player: { name: "Alice" } }
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_match "Hi, Alice!", response.body
+    puts "✓ Alice joined, sees Hi Alice"
+
+    # Check cookie remembers: get again should show player, not join
+    get "/play/#{game.code}"
+    assert_response :success
+    assert_match "Hi, Alice!", response.body
+    assert_no_match(/Your name.*Join.*Your name/m, response.body) # rough: should not show join form? Actually greeting present, join form absent
+    # More precise: should not have Join button for new player? It has greeting, so it's player view
+    puts "✓ Alice remembered via cookie"
+
+    # Join as Bob in separate session (clear cookies, new)
+    # Simulate second player by clearing cookies and joining
+    # In integration test, cookies are shared; need to use separate?
+    # For now, create Bob directly via model to test counts, then test join via new request with cleared cookie
+    bob = game.players.create!(name: "Bob", token: SecureRandom.hex(16))
+    puts "✓ Bob created directly, players=#{game.players.count}"
+
+    # Moderator should see Players: 2
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}/state", headers: @auth.merge("Accept" => "application/json")
+    data = JSON.parse(response.body)
+    assert_equal 2, data["players_count"]
+    assert_equal "Players: 2", data["players_text"]
+    puts "✓ Players count 2 in state"
+
+    # Start game
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/start", headers: @auth
+    assert_response :redirect
+    game.reload
+    assert_equal "open", game.status
+    assert_equal q1.id, game.current_question_id
+    puts "✓ Started, current=#{game.current_question_id}"
+
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    assert_response :success
+    assert_match "Question 1 of 2", response.body
+    assert_match "Q1 Capital", response.body
+    assert_match "Paris", response.body
+    assert_match "London", response.body
+    assert_match "Answers: 0 / 2", response.body
+    assert_match "Finish", response.body
+    puts "✓ Open page shows Question 1 of 2, Answers 0/2, Finish"
+
+    # Player state for Alice when open: should have question, no correct leak
+    # Need to set Alice cookie: find Alice token
+    alice = game.players.find_by(name: "Alice")
+    # Clear cookies and set Alice token
+    # Integration test cookies: need to manually set?
+    # Use cookies hash?
+    # For state, we can pass token param as fallback
+    get "/play/#{game.code}/state", params: { token: alice.token }
+    assert_response :success
+    pdata = JSON.parse(response.body)
+    assert_equal "open", pdata["game_status"]
+    assert_equal "Question 1 of 2", pdata["progress"]
+    assert_equal true, pdata["can_answer"]
+    assert_nil pdata["result_text"]
+    # Check no "correct" substring in JSON keys/values (before closed)
+    json_str = response.body.downcase
+    assert_no_match(/correct/, json_str, "Player JSON must not contain 'correct' before closed, got: #{response.body}")
+    puts "✓ Player state open OK, no leak: #{response.body[0..300]}"
+
+    # Alice answers correctly (Paris)
+    paris = q1.options.find_by(text: "Paris")
+    london = q1.options.find_by(text: "London")
+    # Need to set cookie for Alice to answer? Use token param? Our answer reads cookie or token param? It reads cookie first, then params[:token]. But option_id is in params, token also in params – need to handle.
+    # Our current_player checks cookies then params[:token]. So we can pass token param.
+    post "/play/#{game.code}/answer", params: { option_id: paris.id, token: alice.token }
+    assert_response :redirect
+    # Check answer saved
+    ans = Answer.find_by(player_id: alice.id, question_id: q1.id)
+    assert_equal paris.id, ans.option_id
+    puts "✓ Alice answered Paris"
+
+    # Alice changes to London (last counts)
+    post "/play/#{game.code}/answer", params: { option_id: london.id, token: alice.token }
+    ans.reload
+    assert_equal london.id, ans.option_id
+    puts "✓ Alice changed to London, last counts"
+
+    # Change back to Paris for Correct test
+    post "/play/#{game.code}/answer", params: { option_id: paris.id, token: alice.token }
+    ans.reload
+    assert_equal paris.id, ans.option_id
+
+    # Bob answers wrong (London)
+    post "/play/#{game.code}/answer", params: { option_id: london.id, token: bob.token }
+    bans = Answer.find_by(player_id: bob.id, question_id: q1.id)
+    assert_equal london.id, bans.option_id
+    puts "✓ Bob answered London"
+
+    # Moderator Answers should be 2/2
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}/state", headers: @auth.merge("Accept" => "application/json")
+    data = JSON.parse(response.body)
+    assert_equal "Answers: 2 / 2", data["answers_text"]
+    puts "✓ Answers 2/2"
+
+    # Check player HTML when open has no Correct leak (for Alice)
+    # Simulate Alice request with cookie: need to set cookie header manually
+    # Use cookies[] helper? In integration test, we can set cookies via `cookies[...] = ...`
+    # Let's try setting cookie via headers? Actually `get` with headers Cookie?
+    # Our cookie key is quizzy_player_#{code}
+    get "/play/#{game.code}", headers: { "Cookie" => "quizzy_player_#{game.code}=#{alice.token}" }
+    assert_response :success
+    assert_match "Q1 Capital", response.body
+    assert_match "Your answer", response.body
+    # Check no "Correct" in visible? The page when open should not contain "Correct" at all in HTML (including JS)?
+    # Our JS is clean, but check.
+    # Note: response.body includes inline JS which is clean, and options without Correct.
+    # So downcase should not contain "correct"
+    html_down = response.body.downcase
+    # Allow? Check: should not contain "correct"
+    if html_down.include?("correct")
+      puts "⚠ Player HTML when open contains 'correct':"
+      # Find context
+      idx = html_down.index("correct")
+      puts response.body[[0, idx-200].max, 500]
+      flunk "Player HTML leaks correct before closed"
+    else
+      puts "✓ Player HTML when open has no 'correct' leak"
+    end
+
+    # Finish
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/finish", headers: @auth
+    game.reload
+    assert_equal "closed", game.status
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    assert_response :success
+    # Should show counts and Correct
+    assert_match "Correct", response.body
+    # Counts: Paris 1, London 1 – each should show 1. Check for "1" appears? At least check counts present.
+    # Our view shows counts via <span class="stage-option__count">1</span>
+    assert_match "stage-option__count", response.body
+    puts "✓ Closed shows Correct + counts"
+
+    # Player Alice should see Correct! (since she picked Paris correct)
+    get "/play/#{game.code}/state", params: { token: alice.token }
+    pdata = JSON.parse(response.body)
+    assert_equal "closed", pdata["game_status"]
+    assert_equal "Correct!", pdata["result_text"]
+    puts "✓ Alice result Correct!"
+
+    # Bob should see Wrong!
+    get "/play/#{game.code}/state", params: { token: bob.token }
+    pdata = JSON.parse(response.body)
+    assert_equal "Wrong!", pdata["result_text"]
+    puts "✓ Bob result Wrong!"
+
+    # Charlie joins late (after Finish, before end) – should be allowed, sees No answer for closed?
+    charlie = game.players.create!(name: "Charlie")
+    get "/play/#{game.code}/state", params: { token: charlie.token }
+    pdata = JSON.parse(response.body)
+    assert_equal "closed", pdata["game_status"]
+    assert_equal "No answer", pdata["result_text"]
+    puts "✓ Charlie late join sees No answer"
+
+    # Player HTML when closed should show result
+    get "/play/#{game.code}", headers: { "Cookie" => "quizzy_player_#{game.code}=#{alice.token}" }
+    assert_match "Correct!", response.body
+    puts "✓ Alice HTML shows Correct!"
+
+    # Next to Q3
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/next_step", headers: @auth
+    game.reload
+    assert_equal "open", game.status
+    assert_equal q3.id, game.current_question_id
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    assert_match "Question 2 of 2", response.body
+    assert_match "Q3 2", response.body
+    puts "✓ Next shows Question 2 of 2 (skipped inactive)"
+
+    # Finish Q3 without answers
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/finish", headers: @auth
+    game.reload
+    assert_equal "closed", game.status
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    # Should show End quiz (last)
+    assert_match "End quiz", response.body
+    puts "✓ Last closed shows End quiz"
+
+    # End quiz
+    post "/moderate/quizzes/#{quiz.id}/games/#{game.id}/end_quiz", headers: @auth
+    game.reload
+    assert_equal "ended", game.status
+    get "/moderate/quizzes/#{quiz.id}/games/#{game.id}", headers: @auth
+    assert_match "The quiz is over", response.body
+    puts "✓ Moderator shows The quiz is over"
+
+    # Player should see over
+    get "/play/#{game.code}/state", params: { token: alice.token }
+    pdata = JSON.parse(response.body)
+    assert_equal "ended", pdata["game_status"]
+    assert_equal true, pdata["is_over"]
+    puts "✓ Player state ended"
+
+    get "/play/#{game.code}", headers: { "Cookie" => "quizzy_player_#{game.code}=#{alice.token}" }
+    assert_match "The quiz is over", response.body
+    puts "✓ Player HTML shows over"
+
+    # New visitor after end should see over, no join
+    # Clear cookie: use fresh code without cookie? In test, cookies persist, need to clear?
+    # Use new game code? Actually we can test by not sending cookie header, but integration test cookies may still have? We sent via header, not via cookies jar, so jar may not have. Let's just get without token/cookie and ensure over.
+    # To clear jar, we can do `cookies.delete`? Let's just check that join is blocked:
+    # Try to join after end
+    post "/play/#{game.code}/join", params: { player: { name: "Dave" } }
+    assert_response :redirect
+    follow_redirect!
+    assert_match "The quiz is over", response.body
+    assert_no_match(/Your name/, response.body)
+    puts "✓ After end, join shows over, no join form"
+
+    # Second game has own players/answers
+    post "/moderate/quizzes/#{quiz.id}/games", headers: @auth
+    game2 = Game.last
+    assert_not_equal game.id, game2.id
+    assert_equal 0, game2.players.count
+    assert_equal 0, game2.answers.count
+    assert_equal 3, game.players.count # Alice, Bob, Charlie
+    puts "✓ Second game isolated players/answers"
+  end
+end
diff --git a/test/system/live_game_test.rb b/test/system/live_game_test.rb
new file mode 100644
index 0000000..c88c247
--- /dev/null
+++ b/test/system/live_game_test.rb
@@ -0,0 +1,183 @@
+require "application_system_test_case"
+
+class LiveGameTest < ApplicationSystemTestCase
+  setup do
+    ENV["QUIZZY_MODERATOR_USERNAME"] = "mod"
+    ENV["QUIZZY_MODERATOR_PASSWORD"] = "secret"
+    @auth = ActionController::HttpAuthentication::Basic.encode_credentials("mod", "secret")
+  end
+
+  test "live game via browser" do
+    quiz = Quiz.create!(title: "Live Talk")
+    q1 = quiz.questions.create!(body: "Capital?", active: true, position: 1)
+    q1.options.create!(text: "Paris", correct: true, position: 1)
+    q1.options.create!(text: "London", correct: false, position: 2)
+    q2 = quiz.questions.create!(body: "2+2?", active: true, position: 2)
+    q2.options.create!(text: "4", correct: true, position: 1)
+    q2.options.create!(text: "5", correct: false, position: 2)
+
+    # Use Capybara sessions for isolation
+    # Moderator needs auth header
+    page.driver.headers = { "Authorization" => @auth }
+    visit "/moderate/quizzes/#{quiz.id}"
+    assert_text "Live Talk"
+    assert_button "Start a game"
+    click_on "Start a game"
+    assert_match %r{/moderate/}, current_url
+    assert_text quiz.title
+    assert_text "Players: 0"
+    assert_button "Start"
+    assert_selector "#join-url"
+    join_url_text = find("#join-url").text.strip
+    puts "JOIN URL: #{join_url_text}"
+    assert_selector "#qr-code svg"
+    code = join_url_text[/\/play\/([A-Z0-9]+)/i, 1]
+    assert code, "no code"
+    puts "CODE=#{code}"
+
+    # Save moderator cookies? No, use separate sessions via using_session
+    # For players, we need separate browser contexts (separate cookies).
+    # Capybara using_session will share same browser? Actually using_session with same driver shares browser but different cookies? In Cuprite, each session is separate? Let's use separate sessions.
+
+    using_session(:alice) do
+      visit "/play/#{code}"
+      assert_text "Your name"
+      fill_in "Your name", with: "Alice"
+      click_on "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    # Back to moderator (default session) should see Players: 1 live
+    # Note: default session is :default? After using_session, need to switch back?
+    using_session(:default) do
+      page.driver.headers = { "Authorization" => @auth }
+      assert_text "Players: 1", wait: 10
+    end
+
+    using_session(:bob) do
+      visit "/play/#{code}"
+      fill_in "Your name", with: "Bob"
+      click_on "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    using_session(:default) do
+      assert_text "Players: 2", wait: 10
+    end
+
+    # Alice remembered
+    using_session(:alice) do
+      visit "/play/#{code}"
+      assert_text "Hi, Alice!"
+    end
+
+    # Moderator Start
+    using_session(:default) do
+      click_on "Start"
+      assert_text "Question 1 of 2", wait: 10
+      assert_text "Capital?"
+      assert_text "Answers: 0 / 2"
+      assert_button "Finish"
+    end
+
+    using_session(:alice) do
+      assert_text "Capital?", wait: 10
+      assert_text "Paris"
+      # No leak
+      assert_no_text "Correct!"
+      html = page.html.downcase
+      assert_not_includes html, "correct", "leak before finish: #{page.html[0..1000]}"
+    end
+
+    using_session(:bob) do
+      assert_text "Capital?", wait: 10
+    end
+
+    # Alice picks Paris
+    using_session(:alice) do
+      find("button", text: "Paris").click
+      assert_text "Your answer", wait: 10
+    end
+
+    using_session(:default) do
+      assert_text "Answers: 1 / 2", wait: 10
+    end
+
+    # Alice changes to London then back
+    using_session(:alice) do
+      find("button", text: "London").click
+      sleep 1
+    end
+    using_session(:default) do
+      assert_text "Answers: 1 / 2", wait: 10
+    end
+    using_session(:alice) do
+      find("button", text: "Paris").click
+      sleep 1
+    end
+
+    using_session(:bob) do
+      find("button", text: "London").click
+      assert_text "Your answer", wait: 10
+    end
+    using_session(:default) do
+      assert_text "Answers: 2 / 2", wait: 10
+    end
+
+    # Finish
+    using_session(:default) do
+      click_on "Finish"
+      assert_text "Correct", wait: 10
+      assert_selector ".stage-option__count"
+    end
+
+    using_session(:alice) do
+      assert_text "Correct!", wait: 10
+    end
+    using_session(:bob) do
+      assert_text "Wrong!", wait: 10
+    end
+
+    # Charlie late
+    using_session(:charlie) do
+      visit "/play/#{code}"
+      assert_text "Your name", wait: 5
+      fill_in "Your name", with: "Charlie"
+      click_on "Join"
+      assert_text "Hi, Charlie!", wait: 10
+      assert_text "No answer", wait: 10
+    end
+
+    using_session(:default) do
+      assert_button "Next"
+      click_on "Next"
+      assert_text "Question 2 of 2", wait: 10
+    end
+
+    using_session(:alice) do
+      assert_text "2+2?", wait: 10
+    end
+
+    using_session(:default) do
+      click_on "Finish"
+      assert_button "End quiz", wait: 10
+      click_on "End quiz"
+      assert_text "The quiz is over", wait: 10
+    end
+
+    using_session(:alice) do
+      assert_text "The quiz is over", wait: 10
+    end
+    using_session(:bob) do
+      assert_text "The quiz is over", wait: 10
+    end
+
+    using_session(:dave) do
+      visit "/play/#{code}"
+      assert_text "The quiz is over", wait: 5
+      assert_no_button "Join"
+    end
+
+    puts "ALL LIVE PASSED"
+  end
+end
