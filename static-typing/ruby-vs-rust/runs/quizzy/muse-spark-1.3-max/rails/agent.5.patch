diff --git a/app/models/game.rb b/app/models/game.rb
index dc62266..3250275 100644
--- a/app/models/game.rb
+++ b/app/models/game.rb
@@ -278,6 +278,91 @@ class Game < ApplicationRecord
     end
   end
 
+  # --- Timer ---
+
+  def timer_duration_seconds
+    q = quiz
+    return 0 if q.nil?
+    begin
+      q.timer_total_seconds.to_i
+    rescue StandardError
+      0
+    end
+  end
+
+  def timer_enabled?
+    timer_duration_seconds > 0
+  end
+
+  def timer_active?
+    open? && timer_enabled? && question_opened_at.present?
+  end
+
+  def timer_expires_at
+    return nil unless open?
+    return nil unless timer_enabled?
+    opened = question_opened_at
+    return nil if opened.nil?
+    opened + timer_duration_seconds.seconds
+  end
+
+  def timer_expires_at_ms
+    exp = timer_expires_at
+    return nil if exp.nil?
+    (exp.to_f * 1000).to_i
+  end
+
+  # Remaining milliseconds, clamped >= 0. Returns nil if no active timer.
+  def timer_remaining_ms(now = Time.current)
+    exp = timer_expires_at
+    return nil if exp.nil?
+    ms = ((exp.to_f - now.to_f) * 1000).ceil
+    ms = 0 if ms < 0
+    ms
+  end
+
+  # Remaining whole seconds, ceil so 4.2s shows as 5 (until truly 0).
+  # Returns nil if no active timer.
+  def timer_remaining_seconds(now = Time.current)
+    ms = timer_remaining_ms(now)
+    return nil if ms.nil?
+    ((ms + 999) / 1000).to_i
+  end
+
+  def timer_text(now = Time.current)
+    secs = timer_remaining_seconds(now)
+    return nil if secs.nil?
+    Game.format_timer(secs)
+  end
+
+  def self.format_timer(total_seconds)
+    total_seconds = total_seconds.to_i
+    total_seconds = 0 if total_seconds < 0
+    minutes = total_seconds / 60
+    seconds = total_seconds % 60
+    "#{minutes}:#{format('%02d', seconds)}"
+  end
+
+  # If timer expired while open, finish the question (as if Finish clicked).
+  # Returns true if it finished, false otherwise. Safe to call on every poll.
+  def expire_timer_if_needed!
+    # Reload to avoid stale status/opened_at
+    begin
+      reload
+    rescue StandardError
+      # ignore reload errors
+    end
+    return false unless open?
+    return false unless timer_enabled?
+    opened = question_opened_at
+    return false if opened.nil?
+    dur = timer_duration_seconds
+    return false if dur <= 0
+    expires = opened + dur.seconds
+    return false if Time.current < expires
+    finish!
+  end
+
   private
 
   def ensure_code
