+// ---------- export / import ----------
+#[derive(Serialize)]
+struct ExportQuiz {
+    title: String,
+    questions: Vec<ExportQuestion>,
+}
+#[derive(Serialize)]
+struct ExportQuestion {
+    text: String,
+    active: bool,
+    options: Vec<ExportOption>,
+}
+#[derive(Serialize)]
+struct ExportOption {
+    text: String,
+    correct: bool,
+}
+
+async fn export_quiz_handler(
+    State(state): State<AppState>,
+    Path(id): Path<i64>,
+) -> impl IntoResponse {
+    let conn = db_connect(&state).unwrap();
+    let Some(quiz) = get_quiz(&conn, id) else {
+        return (StatusCode::NOT_FOUND, Html(admin_layout("Not found", "<h1>Quiz not found</h1>"))).into_response();
+    };
+    let questions = list_questions(&conn, id);
+    let mut eqs: Vec<ExportQuestion> = Vec::new();
+    for q in questions {
+        let opts = list_options(&conn, q.id);
+        let mut eopts: Vec<ExportOption> = Vec::new();
+        for o in opts {
+            eopts.push(ExportOption {
+                text: o.body,
+                correct: o.is_correct,
+            });
+        }
+        eqs.push(ExportQuestion {
+            text: q.body,
+            active: q.active,
+            options: eopts,
+        });
+    }
+    let eq = ExportQuiz {
+        title: quiz.title.clone(),
+        questions: eqs,
+    };
+    let json = serde_json::to_string_pretty(&eq).unwrap();
+    let body = format!(
+        r#"<div class="breadcrumbs"><a href="/moderate/quizzes/{}">← {}</a></div><div class="page-head"><div><h1>Export: {}</h1></div><div class="buttons"><a class="btn btn--ghost" href="/moderate/quizzes/{}">Back to quiz</a></div></div><div class="card"><p class="field-hint" style="margin-top:0">Copy the JSON below to reuse this quiz at another conference or share it with a colleague.</p><pre>{}</pre></div>"#,
+        id,
+        html_escape(&quiz.title),
+        html_escape(&quiz.title),
+        id,
+        html_escape(&json)
+    );
+    Html(admin_layout(&format!("Export: {}", quiz.title), &body)).into_response()
+}
+
+fn render_import_form(json_val: &str, errors: &[String]) -> String {
+    let mut err_html = String::new();
+    if !errors.is_empty() {
+        err_html.push_str(r#"<div class="errors"><ul>"#);
+        for e in errors {
+            err_html.push_str(&format!("<li>{}</li>", html_escape(e)));
+        }
+        err_html.push_str("</ul></div>");
+    }
+    let inner = format!(
+        r#"<div class="breadcrumbs"><a href="/moderate">← All quizzes</a></div><div class="page-head"><h1>Import quiz</h1></div><div class="card">{}<form method="post" action="/moderate/quizzes/import"><div class="field"><label for="quiz_json">Quiz JSON</label><textarea class="input" id="quiz_json" name="quiz_json" rows="15" placeholder="Paste quiz JSON here">{}</textarea></div><div class="buttons"><button class="btn btn--pink" type="submit">Import</button><a class="btn btn--ghost" href="/moderate">Cancel</a></div></form></div>"#,
+        err_html,
+        html_escape(json_val)
+    );
+    admin_layout("Import quiz", &inner)
+}
+
+async fn import_form_handler(State(_state): State<AppState>) -> impl IntoResponse {
+    Html(render_import_form("", &[])).into_response()
+}
+
+struct ValidatedOption {
+    text: String,
+    correct: bool,
+}
+struct ValidatedQuestion {
+    text: String,
+    active: bool,
+    options: Vec<ValidatedOption>,
+}
+
+fn validate_import(json_str: &str) -> Result<(String, Vec<ValidatedQuestion>), Vec<String>> {
+    let trimmed = json_str.trim();
+    if trimmed.is_empty() {
+        return Err(vec!["Quiz JSON can't be blank".to_string()]);
+    }
+    let v: serde_json::Value = match serde_json::from_str(trimmed) {
+        Ok(v) => v,
+        Err(e) => return Err(vec![format!("Invalid JSON: {}", e)]),
+    };
+    let obj = match v.as_object() {
+        Some(o) => o,
+        None => return Err(vec!["Invalid quiz format: expected an object".to_string()]),
+    };
+    let mut errors: Vec<String> = Vec::new();
+    let title_opt = obj.get("title").and_then(|x| x.as_str());
+    let title: String = match title_opt {
+        Some(s) if !s.trim().is_empty() => s.trim().to_string(),
+        _ => {
+            errors.push("Title can't be blank".to_string());
+            String::new()
+        }
+    };
+    let questions_slice_opt = obj.get("questions").and_then(|x| x.as_array());
+    if questions_slice_opt.is_none() {
+        errors.push("Questions must be a list".to_string());
+        return Err(errors);
+    }
+    let questions_arr = questions_slice_opt.unwrap();
+    let mut validated_questions: Vec<ValidatedQuestion> = Vec::new();
+    for (idx, qv) in questions_arr.iter().enumerate() {
+        let qnum = idx + 1;
+        let qobj = match qv.as_object() {
+            Some(o) => o,
+            None => {
+                errors.push(format!("Question {}: Invalid question format", qnum));
+                continue;
+            }
+        };
+        let text_opt = qobj.get("text").and_then(|x| x.as_str());
+        let text_trimmed = text_opt.map(|s| s.trim().to_string()).unwrap_or_default();
+        let text_valid = text_opt.is_some() && !text_trimmed.is_empty();
+        if !text_valid {
+            errors.push(format!("Question {}: Question can't be blank", qnum));
+        }
+        let mut active_val: bool = true;
+        if let Some(av) = qobj.get("active") {
+            match av.as_bool() {
+                Some(b) => active_val = b,
+                None => {
+                    errors.push(format!("Question {}: Invalid active value", qnum));
+                }
+            }
+        }
+        let opts_arr_opt = qobj.get("options").and_then(|x| x.as_array());
+        let opts_arr = match opts_arr_opt {
+            Some(a) => a,
+            None => {
+                errors.push(format!("Question {}: Add at least two options", qnum));
+                continue;
+            }
+        };
+        let mut validated_opts: Vec<ValidatedOption> = Vec::new();
+        for (oidx, ov) in opts_arr.iter().enumerate() {
+            let onum = oidx + 1;
+            let oobj = match ov.as_object() {
+                Some(o) => o,
+                None => {
+                    errors.push(format!("Question {}, Option {}: Invalid option format", qnum, onum));
+                    continue;
+                }
+            };
+            let otext_val = oobj.get("text");
+            let otext_str_opt = otext_val.and_then(|x| x.as_str());
+            let Some(otext_str) = otext_str_opt else {
+                errors.push(format!("Question {}, Option {}: Option text can't be blank", qnum, onum));
+                continue;
+            };
+            let otext_trimmed = otext_str.trim().to_string();
+            if otext_trimmed.is_empty() {
+                continue;
+            }
+            let correct_val: bool = match oobj.get("correct") {
+                None => false,
+                Some(cv) => match cv.as_bool() {
+                    Some(b) => b,
+                    None => {
+                        errors.push(format!("Question {}, Option {}: Invalid correct value", qnum, onum));
+                        continue;
+                    }
+                },
+            };
+            validated_opts.push(ValidatedOption {
+                text: otext_trimmed,
+                correct: correct_val,
+            });
+        }
+        if validated_opts.len() < 2 {
+            errors.push(format!("Question {}: Add at least two options", qnum));
+        }
+        if validated_opts.iter().filter(|o| o.correct).count() == 0 {
+            errors.push(format!("Question {}: Mark at least one option as correct", qnum));
+        }
+        validated_questions.push(ValidatedQuestion {
+            text: text_trimmed.clone(),
+            active: active_val,
+            options: validated_opts,
+        });
+    }
+    if !errors.is_empty() {
+        return Err(errors);
+    }
+    Ok((title, validated_questions))
+}
+
+async fn import_quiz_handler(
+    State(state): State<AppState>,
+    Form(form): Form<HashMap<String, String>>,
+) -> impl IntoResponse {
+    let json_str = form
+        .get("quiz_json")
+        .or(form.get("quiz-json"))
+        .or(form.get("quizJSON"))
+        .or(form.get("json"))
+        .cloned()
+        .unwrap_or_default();
+    match validate_import(&json_str) {
+        Err(errors) => Html(render_import_form(&json_str, &errors)).into_response(),
+        Ok((title, validated_questions)) => {
+            let mut conn = db_connect(&state).unwrap();
+            let tx = conn.transaction().unwrap();
+            tx.execute("INSERT INTO quizzes (title) VALUES (?1)", params![title])
+                .unwrap();
+            let quiz_id = tx.last_insert_rowid();
+            for (qi, q) in validated_questions.iter().enumerate() {
+                let pos = (qi as i64) + 1;
+                tx.execute(
+                    "INSERT INTO questions (quiz_id, body, active, position) VALUES (?1, ?2, ?3, ?4)",
+                    params![quiz_id, q.text, if q.active { 1 } else { 0 }, pos],
+                )
+                .unwrap();
+                let qid = tx.last_insert_rowid();
+                for (oi, o) in q.options.iter().enumerate() {
+                    tx.execute(
+                        "INSERT INTO options (question_id, body, is_correct, position) VALUES (?1, ?2, ?3, ?4)",
+                        params![qid, o.text, if o.correct { 1 } else { 0 }, oi as i64],
+                    )
+                    .unwrap();
+                }
+            }
+            tx.commit().unwrap();
+            Redirect::to(&format!("/moderate/quizzes/{}", quiz_id)).into_response()
+        }
+    }
+}
