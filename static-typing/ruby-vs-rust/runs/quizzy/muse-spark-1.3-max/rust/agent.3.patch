--- /dev/null
+++ b/assets/play.js
@@ -0,0 +1,220 @@
+(function(){
+  var CODE = "__CODE__";
+  var ORIGIN = (window.location.protocol + "//" + window.location.host);
+  var BASE = ORIGIN + "/play/" + CODE;
+  var POLL_MS = 500;
+  function esc(s){ return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#x27;"); }
+  function letter(i){ if(i<26) return String.fromCharCode(65+i); return String(i+1); }
+  function getToken(){
+    try{
+      var v = localStorage.getItem('quizzy_player_'+CODE);
+      if(v) return v;
+    }catch(e){}
+    try{
+      var ck = document.cookie || '';
+      var parts = ck.split(';');
+      for(var i=0;i<parts.length;i++){
+        var p = parts[i].trim();
+        var prefix1 = 'quizzy_'+CODE+'=';
+        var prefix2 = 'qz_'+CODE+'=';
+        if(p.indexOf(prefix1)===0) return decodeURIComponent(p.substring(prefix1.length));
+        if(p.indexOf(prefix2)===0) return decodeURIComponent(p.substring(prefix2.length));
+      }
+      // fallback: any cookie that looks like hex token 32 chars? try all
+      for(var j=0;j<parts.length;j++){
+        var pp = parts[j].trim();
+        var eq = pp.indexOf('=');
+        if(eq>0){
+          var val = decodeURIComponent(pp.substring(eq+1));
+          if(/^[0-9a-f]{32}$/.test(val)) return val;
+        }
+      }
+    }catch(e){}
+    return null;
+  }
+  function setToken(t){
+    try{ localStorage.setItem('quizzy_player_'+CODE, t); }catch(e){}
+    try{ document.cookie = 'quizzy_'+CODE+'='+encodeURIComponent(t)+'; Path=/; Max-Age=31536000; SameSite=Lax'; }catch(e){}
+  }
+  function stateUrl(){
+    var t = getToken();
+    if(t) return BASE + '/state?token='+encodeURIComponent(t);
+    return BASE + '/state';
+  }
+  function fetchState(){
+    var t = getToken();
+    var headers = {'Accept':'application/json'};
+    if(t) headers['X-Player-Token'] = t;
+    fetch(stateUrl(), {credentials:'same-origin', headers: headers}).then(function(r){
+      if(!r.ok) return;
+      return r.json();
+    }).then(function(st){
+      if(st) render(st);
+    }).catch(function(e){});
+  }
+  function render(st){
+    var body = document.getElementById('play-body');
+    if(!body) return;
+    var status = st.status;
+    if(status==='finished'){
+      if(!document.getElementById('quiz-over')){
+        body.innerHTML = '<div class="waiting"><div class="waiting__gem">✓</div><h1 id="quiz-over">The quiz is over</h1></div>';
+      }
+      return;
+    }
+    if(!st.joined){
+      if(!document.getElementById('join-form')){
+        var h = '<h1 class="play-title">'+esc(st.quiz_title)+'</h1>';
+        h += '<form id="join-form" method="post" action="'+BASE+'/join">';
+        h += '<div class="field"><label for="name">Your name</label><input class="input" id="name" name="name" placeholder="Your name" required autocomplete="nickname" maxlength="50"></div>';
+        h += '<div class="join-form"><button class="btn btn--pink" type="submit">Join</button></div>';
+        h += '</form>';
+        body.innerHTML = h;
+        bindJoin();
+      } else {
+        // update title if needed? keep input value
+        var titleEl = body.querySelector('.play-title');
+        if(titleEl && titleEl.textContent !== st.quiz_title) titleEl.textContent = st.quiz_title;
+      }
+      return;
+    }
+    var name = st.player_name || '';
+    if(status==='lobby'){
+      var hi = document.getElementById('hi-name');
+      if(hi && hi.textContent === ('Hi, '+name+'!') && body.querySelector('.waiting')){
+        return;
+      }
+      body.innerHTML = '<div class="waiting"><div class="waiting__gem">?</div><h1 id="hi-name">Hi, '+esc(name)+'!</h1><div class="play-lead">Waiting for the quiz to start…</div></div>';
+      return;
+    }
+    if(status==='open'){
+      var q = st.question;
+      if(!q) return;
+      var total = st.total_questions;
+      var num = st.current_number || 1;
+      // avoid re-render if same question and same answer (preserve button state, avoid flicker)
+      var curBody = document.getElementById('q-body');
+      var curProg = document.getElementById('q-progress');
+      var wantProg = 'Question '+num+' of '+total;
+      var pickedId = st.my_answer;
+      if(curBody && curProg && curProg.textContent===wantProg && curBody.textContent===q.body){
+        // check if picked markers match
+        var btns = body.querySelectorAll('#play-options button[data-option-id]');
+        if(btns.length===q.options.length){
+          var match = true;
+          for(var i=0;i<btns.length;i++){
+            var oid = parseInt(btns[i].getAttribute('data-option-id'),10);
+            var shouldPicked = (pickedId!==null && pickedId!==undefined && oid===pickedId);
+            var isPicked = btns[i].classList.contains('is-picked');
+            if(shouldPicked!==isPicked){ match=false; break; }
+            // also check Your answer mark
+            var hasMark = btns[i].textContent.indexOf('Your answer')>=0;
+            if(shouldPicked!==hasMark){ match=false; break; }
+          }
+          if(match) return;
+        }
+      }
+      var h2 = '<div class="play-question__num" id="q-progress">'+wantProg+'</div>';
+      h2 += '<div class="play-question__body" id="q-body">'+esc(q.body)+'</div>';
+      h2 += '<div class="play-options" id="play-options">';
+      for(var k=0;k<q.options.length;k++){
+        var o = q.options[k];
+        var L = letter(k);
+        var isPicked2 = (pickedId!==null && pickedId!==undefined && o.id===pickedId);
+        var cls = 'play-option';
+        if(isPicked2) cls += ' is-picked';
+        h2 += '<button class="'+cls+'" type="button" data-option-id="'+o.id+'"><span class="play-option__letter">'+L+'</span><span class="play-option__title">'+esc(o.body)+'</span>';
+        if(isPicked2) h2 += '<span class="play-option__mark">Your answer</span>';
+        h2 += '</button>';
+      }
+      h2 += '</div>';
+      body.innerHTML = h2;
+      bindOptions();
+      return;
+    }
+    if(status==='closed'){
+      var qc = st.question;
+      if(!qc) return;
+      var total2 = st.total_questions;
+      var num2 = st.current_number || 1;
+      var wantProg2 = 'Question '+num2+' of '+total2;
+      var resText = st.result_text || '';
+      var resCls = st.result_class || 'play-status--neutral';
+      var curRes = document.getElementById('play-result');
+      var curBody2 = document.getElementById('q-body');
+      var curProg2 = document.getElementById('q-progress');
+      if(curRes && curBody2 && curProg2 && curProg2.textContent===wantProg2 && curBody2.textContent===qc.body && curRes.textContent===resText){
+        // check picked markers
+        var divs = body.querySelectorAll('#play-options .play-option');
+        if(divs.length===qc.options.length){
+          var ok = true;
+          for(var m=0;m<divs.length;m++){
+            var oid2 = qc.options[m].id;
+            var should2 = (st.my_answer!==null && st.my_answer!==undefined && oid2===st.my_answer);
+            var is2 = divs[m].classList.contains('is-picked');
+            if(should2!==is2){ ok=false; break; }
+          }
+          if(ok) return;
+        }
+      }
+      var h3 = '<div class="play-question__num" id="q-progress">'+wantProg2+'</div>';
+      h3 += '<div class="play-question__body" id="q-body">'+esc(qc.body)+'</div>';
+      h3 += '<div class="play-options is-locked" id="play-options">';
+      for(var n=0;n<qc.options.length;n++){
+        var oc = qc.options[n];
+        var Lc = letter(n);
+        var pickedC = (st.my_answer!==null && st.my_answer!==undefined && oc.id===st.my_answer);
+        var clsc = 'play-option';
+        if(pickedC) clsc += ' is-picked';
+        h3 += '<div class="'+clsc+'"><span class="play-option__letter">'+Lc+'</span><span class="play-option__title">'+esc(oc.body)+'</span>';
+        if(pickedC) h3 += '<span class="play-option__mark">Your answer</span>';
+        h3 += '</div>';
+      }
+      h3 += '</div>';
+      h3 += '<div class="play-status '+resCls+'" id="play-result">'+resText+'</div>';
+      body.innerHTML = h3;
+      return;
+    }
+  }
+  function postAnswer(optionId){
+    var t = getToken();
+    var b = 'option_id='+encodeURIComponent(optionId);
+    if(t) b += '&token='+encodeURIComponent(t);
+    var hdrs = {'Content-Type':'application/x-www-form-urlencoded','Accept':'application/json','X-Requested-With':'XMLHttpRequest'};
+    if(t) hdrs['X-Player-Token'] = t;
+    fetch(BASE+'/answer', {method:'POST', credentials:'same-origin', headers: hdrs, body: b}).then(function(){ fetchState(); }).catch(function(){ fetchState(); });
+  }
+  function bindOptions(){
+    var btns = document.querySelectorAll('#play-options button[data-option-id]');
+    for(var i=0;i<btns.length;i++){
+      (function(btn){
+        btn.onclick = function(){ postAnswer(btn.getAttribute('data-option-id')); };
+      })(btns[i]);
+    }
+  }
+  function bindJoin(){
+    var f = document.getElementById('join-form');
+    if(!f) return;
+    f.onsubmit = function(e){
+      e.preventDefault();
+      var input = document.getElementById('name');
+      var nm = input ? input.value.trim() : '';
+      if(!nm){
+        if(input) input.focus();
+        return;
+      }
+      var b2 = 'name='+encodeURIComponent(nm);
+      fetch(BASE+'/join', {method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/x-www-form-urlencoded','Accept':'application/json','X-Requested-With':'XMLHttpRequest'}, body: b2}).then(function(r){
+        if(!r.ok) return null;
+        return r.json();
+      }).then(function(j){
+        if(j && j.token) setToken(j.token);
+        fetchState();
+      }).catch(function(){ fetchState(); });
+    };
+  }
+  bindJoin();
+  bindOptions();
+  setInterval(fetchState, POLL_MS);
+  fetchState();
+})();
diff --git a/docs/notes.md b/docs/notes.md
index b402bef..ac3aba0 100644
--- a/docs/notes.md
+++ b/docs/notes.md
@@ -36,3 +36,13 @@
 - Import validation via `serde_json::Value` + manual checks (no panics on wrong types): blank→`Title can't be blank`, missing/non-array questions→`Questions must be a list`, per-question `Question N: Question can't be blank` / `Add at least two options` / `Mark at least one option as correct` / `Invalid active|correct value` / `Option text can't be blank`; blank option strings skipped like form, missing/non-string text is error; `active` defaults true, `correct` defaults false, extra keys ignored
 - Atomic: validate all in memory first, then `BEGIN` transaction inserting quiz + questions (pos 1..N) + options (pos 0..) preserving JSON order; `tx.commit` or rollback; success `303` to `/moderate/quizzes/{new_id}` (always new row, duplicate titles allowed)
 - Deps: added direct `serde_json = "1.0.151"` (already vendored via axum); `cargo build --release --offline` still works, `Cargo.lock` updated with direct edge; no new vendor needed
+
+## Live Game (2026-10-07)
+- Tables: `games(id, quiz_id, code UNIQUE 5-char, status lobby/open/closed/finished, current_question_id)`, `players(id, game_id, name, token UNIQUE 32-hex)`, `answers(id, game_id, player_id, question_id, option_id, UNIQUE(player_id, question_id))` with WAL + busy_timeout 5s for crowded Wi-Fi concurrency
+- Codes: `ABCDEFGHJKLMNPQRSTUVWXYZ23456789` (no I,O,0,1) via `/dev/urandom` + xorshift fallback; tokens 16 random bytes hex; QR via `qrcode 0.14` `svg` only (no `image` dep, tiny offline build)
+- Routes: `POST /moderate/quizzes/{id}/games` (Start a game form) → `GET /moderate/games/{code}` big screen + `GET .../state` JSON + `POST .../start|finish|next|end`; player `GET /play/{code}` + `GET .../state` + `POST .../join|answer` (urlencoded + JSON, cookie/query/header token)
+- Moderator auth: Basic + `quizzy_mod` HttpOnly session cookie (in-memory HashSet, set on Basic success) so `fetch()` polling works; fixes Chromium `fetch` with `user:pass@host` base URL error by using `ORIGIN = protocol+//+host` absolute URLs (relative fetch fails with "Request cannot be constructed from URL that includes credentials", XHR works)
+- Big screen: lobby shows title, `host/play/CODE` plain text (no scheme, Host header), inline QR SVG same string, `Players: N`, Start; open shows `Question X of N`, body, `ol.stage-options>li`, `Answers: X / Y`, Finish; closed adds per-option `stage-option__count` + `Correct` mark + bars, Next/End quiz; finished `The quiz is over`; all server-rendered + JS `setInterval 500ms` re-render preserving QR (not in JSON for Wi-Fi), actions via `fetch POST` + immediate state
+- Player: join form `Your name` label+placeholder + Join; `Hi, name!` waiting; open `button.play-option` + `Your answer` mark, upsert last pick; closed `Correct!/Wrong!/No answer` via server `result_text/class` (JS has no Correct/Wrong strings, JSON omits `is_correct` before closed, page source clean); finished `The quiz is over`; remember via `quizzy_CODE` cookie + `localStorage quizzy_player_CODE`, state checks cookie/query/header; can join lobby/open/closed, not finished
+- Live: polling 500ms, small JSON, ignore fetch errors for crowded Wi-Fi, change-detection to avoid flicker/input loss; all labels exact, lists in li, confirm() for deletes only
+- Offline: `qrcode` vendored (`cargo vendor` after temp-disable config), `cargo build --release --offline` ~4s, `include_str!` for `big_screen.js`/`play.js` (inlined, no extra requests)
