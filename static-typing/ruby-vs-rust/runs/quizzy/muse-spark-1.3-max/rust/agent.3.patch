+async fn player_answer_handler(
+    State(state): State<AppState>,
+    Path(code): Path<String>,
+    Query(query): Query<HashMap<String, String>>,
+    req: axum::extract::Request,
+) -> impl IntoResponse {
+    let (parts, body) = req.into_parts();
+    let headers = parts.headers;
+    let bytes = axum::body::to_bytes(body, 1024 * 1024).await.unwrap_or_default();
+    let body_str = String::from_utf8_lossy(&bytes).to_string();
+    let content_type = headers
+        .get(header::CONTENT_TYPE)
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or("")
+        .to_string();
+    let mut option_id_opt: Option<i64> = None;
+    let mut body_token: Option<String> = None;
+    if content_type.contains("application/json") {
+        if let Ok(v) = serde_json::from_str::<serde_json::Value>(&body_str) {
+            if let Some(n) = v.get("option_id").and_then(|x| x.as_i64()) {
+                option_id_opt = Some(n);
+            } else if let Some(s) = v.get("option_id").and_then(|x| x.as_str()) {
+                if let Ok(n) = s.parse::<i64>() {
+                    option_id_opt = Some(n);
+                }
+            } else if let Some(n) = v.get("optionId").and_then(|x| x.as_i64()) {
+                option_id_opt = Some(n);
+            }
+            if let Some(t) = v.get("token").and_then(|x| x.as_str()) {
+                body_token = Some(t.to_string());
+            }
+        }
+        if option_id_opt.is_none() {
+            if let Some(s) = query.get("option_id") {
+                if let Ok(n) = s.parse::<i64>() {
+                    option_id_opt = Some(n);
+                }
+            }
+        }
+    } else {
+        let map = parse_urlencoded_body(&body_str);
+        for key in ["option_id", "optionId", "option", "answer"] {
+            if let Some(v) = map.get(key) {
+                if let Ok(n) = v.trim().parse::<i64>() {
+                    option_id_opt = Some(n);
+                    break;
+                }
+            }
+        }
+        if let Some(t) = map.get("token") {
+            body_token = Some(t.clone());
+        }
+        if option_id_opt.is_none() {
+            if let Some(s) = query.get("option_id") {
+                if let Ok(n) = s.parse::<i64>() {
+                    option_id_opt = Some(n);
+                }
+            }
+        }
+    }
+    let conn = db_connect(&state).unwrap();
+    let Some(game) = get_game_by_code(&conn, &code) else {
+        if wants_json(&headers) {
+            return (StatusCode::NOT_FOUND, axum::Json(serde_json::json!({"error":"not found"}))).into_response();
+        } else {
+            return (StatusCode::NOT_FOUND, Html("<h1>Game not found</h1>".to_string())).into_response();
+        }
+    };
+    // find player: query token or body token or header/cookie
+    let qt_combined: Option<String> = query.get("token").cloned().or(body_token.clone());
+    let player = find_player_for_game(&conn, &game, &headers, qt_combined.as_deref());
+    let Some(pl) = player else {
+        if wants_json(&headers) {
+            return (StatusCode::UNAUTHORIZED, axum::Json(serde_json::json!({"error":"join first"}))).into_response();
+        } else {
+            return Redirect::to(&format!("/play/{}", game.code)).into_response();
+        }
+    };
+    // only allow when open
+    if game.status != "open" {
+        if wants_json(&headers) {
+            let quiz = get_quiz(&conn, game.quiz_id).unwrap_or(Quiz { id: game.quiz_id, title: String::new() });
+            let st = build_play_state(&conn, &game, &quiz, Some(&pl));
+            return axum::Json(st).into_response();
+        } else {
+            return Redirect::to(&format!("/play/{}", game.code)).into_response();
+        }
+    }
+    let Some(qid) = game.current_question_id else {
+        if wants_json(&headers) {
+            return (StatusCode::BAD_REQUEST, axum::Json(serde_json::json!({"error":"no question"}))).into_response();
+        } else {
+            return Redirect::to(&format!("/play/{}", game.code)).into_response();
+        }
+    };
+    let Some(oid) = option_id_opt else {
+        if wants_json(&headers) {
+            return (StatusCode::BAD_REQUEST, axum::Json(serde_json::json!({"error":"missing option"}))).into_response();
+        } else {
+            return Redirect::to(&format!("/play/{}", game.code)).into_response();
+        }
+    };
+    // validate option belongs to current question
+    let valid: Option<i64> = conn
+        .query_row(
+            "SELECT id FROM options WHERE id=?1 AND question_id=?2",
+            params![oid, qid],
+            |r| r.get(0),
+        )
+        .optional()
+        .unwrap();
+    if valid.is_none() {
+        if wants_json(&headers) {
+            return (StatusCode::BAD_REQUEST, axum::Json(serde_json::json!({"error":"invalid option"}))).into_response();
+        } else {
+            return Redirect::to(&format!("/play/{}", game.code)).into_response();
+        }
+    }
+    // upsert answer
+    conn.execute(
+        "INSERT INTO answers (game_id, player_id, question_id, option_id) VALUES (?1, ?2, ?3, ?4) ON CONFLICT(player_id, question_id) DO UPDATE SET option_id=excluded.option_id",
+        params![game.id, pl.id, qid, oid],
+    )
+    .unwrap();
+    if wants_json(&headers) {
+        let quiz = get_quiz(&conn, game.quiz_id).unwrap_or(Quiz { id: game.quiz_id, title: String::new() });
+        // reload game (status unchanged, but for consistency)
+        let game2 = get_game_by_code(&conn, &code).unwrap_or(game);
+        let st = build_play_state(&conn, &game2, &quiz, Some(&pl));
+        axum::Json(st).into_response()
+    } else {
+        Redirect::to(&format!("/play/{}", game.code)).into_response()
+    }
+}
