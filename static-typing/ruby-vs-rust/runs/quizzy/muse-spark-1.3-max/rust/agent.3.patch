index 0000000..dd560bc
--- /dev/null
+++ b/assets/big_screen.js
@@ -0,0 +1,119 @@
+(function(){
+  var CODE = "__CODE__";
+  var ORIGIN = (window.location.protocol + "//" + window.location.host);
+  var STATE_URL = ORIGIN + "/moderate/games/" + CODE + "/state";
+  var POLL_MS = 500;
+  function esc(s){ return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#x27;"); }
+  function letter(i){ if(i<26) return String.fromCharCode(65+i); return String(i+1); }
+  function fetchState(){
+    fetch(STATE_URL, {credentials:'same-origin', headers:{'Accept':'application/json'}}).then(function(r){
+      if(!r.ok) return;
+      return r.json();
+    }).then(function(st){
+      if(st) render(st);
+    }).catch(function(e){});
+  }
+  function render(st){
+    var body = document.getElementById('screen-body');
+    var controlsInfo = document.getElementById('controls-info');
+    var controlsBtns = document.getElementById('controls-buttons');
+    if(!body) return;
+    var status = st.status;
+    if(status==='lobby'){
+      var pc = document.getElementById('players-counter');
+      var ju = document.getElementById('join-url');
+      if(pc && ju && body.querySelector('.lobby')){
+        pc.textContent = 'Players: '+st.players_count;
+        if(ju.textContent !== st.join_display) ju.textContent = st.join_display;
+        if(controlsBtns && !document.getElementById('btn-start')){
+          controlsBtns.innerHTML = '<button class="btn btn--pink btn--lg" id="btn-start" type="button">Start</button>';
+          bindButtons();
+        }
+        if(controlsInfo) controlsInfo.innerHTML = '<span>Players: '+st.players_count+'</span>';
+        return;
+      }
+      var existingQr = document.getElementById('qr');
+      var qrInner = existingQr ? existingQr.innerHTML : '';
+      var h = '<div class="lobby"><div>';
+      h += '<h1 class="lobby__title">'+esc(st.quiz_title)+'</h1>';
+      h += '<div class="lobby__join">Join at</div>';
+      h += '<div class="lobby__url" id="join-url">'+esc(st.join_display)+'</div>';
+      h += '<div class="counter-pill" id="players-counter">Players: '+st.players_count+'</div>';
+      h += '</div><div class="qr" id="qr">'+qrInner+'</div></div>';
+      body.innerHTML = h;
+      if(controlsInfo) controlsInfo.innerHTML = '<span>Players: '+st.players_count+'</span>';
+      if(controlsBtns) controlsBtns.innerHTML = '<button class="btn btn--pink btn--lg" id="btn-start" type="button">Start</button>';
+      bindButtons();
+    } else if(status==='open' || status==='closed'){
+      var q = st.question;
+      if(!q){ fetchState(); return; }
+      var total = st.total_questions;
+      var num = st.current_number || 1;
+      var isResults = (status==='closed');
+      var h2 = '<div class="stage-question__num" id="q-progress">Question '+num+' of '+total+'</div>';
+      h2 += '<div class="stage-question__body" id="q-body">'+esc(q.body)+'</div>';
+      h2 += '<ol class="stage-options'+(isResults?' stage-options--results':'')+'" id="q-options">';
+      for(var i=0;i<q.options.length;i++){
+        var o = q.options[i];
+        var L = letter(i);
+        var cls = 'stage-option';
+        if(isResults && o.is_correct) cls += ' is-correct';
+        h2 += '<li class="'+cls+'"><span class="stage-option__letter">'+L+'</span><span class="stage-option__title">'+esc(o.body)+'</span>';
+        if(isResults){
+          h2 += '<span class="stage-option__count">'+o.count+'</span>';
+          if(o.is_correct) h2 += '<span class="mark mark--right">Correct</span>';
+        }
+        h2 += '</li>';
+      }
+      h2 += '</ol>';
+      h2 += '<div class="answers-counter" id="answers-counter">Answers: '+st.answers_count+' / '+st.players_count+'</div>';
+      body.innerHTML = h2;
+      if(isResults){
+        try{
+          var lis = body.querySelectorAll('#q-options li');
+          var totalA = st.answers_count || 0;
+          for(var j=0;j<lis.length;j++){
+            var oo = q.options[j];
+            var share = totalA>0 ? Math.round((oo.count/totalA)*100) : 0;
+            var bar = document.createElement('span');
+            bar.className = 'stage-option__bar';
+            bar.style.width = share+'%';
+            lis[j].insertBefore(bar, lis[j].firstChild);
+          }
+        }catch(e){}
+      }
+      if(controlsInfo) controlsInfo.innerHTML = '<span>Answers: '+st.answers_count+' / '+st.players_count+'</span>';
+      if(controlsBtns){
+        if(status==='open'){
+          controlsBtns.innerHTML = '<button class="btn btn--pink btn--lg" id="btn-finish" type="button">Finish</button>';
+        }else{
+          if(st.is_last){
+            controlsBtns.innerHTML = '<button class="btn btn--pink btn--lg" id="btn-end" type="button">End quiz</button>';
+          }else{
+            controlsBtns.innerHTML = '<button class="btn btn--pink btn--lg" id="btn-next" type="button">Next</button>';
+          }
+        }
+        bindButtons();
+      }
+    } else if(status==='finished'){
+      body.innerHTML = '<div class="stage-question__body" id="quiz-over">The quiz is over</div>';
+      if(controlsInfo) controlsInfo.innerHTML = '';
+      if(controlsBtns) controlsBtns.innerHTML = '';
+    }
+  }
+  function postAction(url){
+    fetch(url, {method:'POST', credentials:'same-origin', headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'}}).then(function(){ fetchState(); }).catch(function(){ fetchState(); });
+  }
+  function bindButtons(){
+    var bStart = document.getElementById('btn-start');
+    if(bStart) bStart.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/start'); };
+    var bFinish = document.getElementById('btn-finish');
+    if(bFinish) bFinish.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/finish'); };
+    var bNext = document.getElementById('btn-next');
+    if(bNext) bNext.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/next'); };
+    var bEnd = document.getElementById('btn-end');
+    if(bEnd) bEnd.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/end'); };
+  }
+  bindButtons();
+  setInterval(fetchState, POLL_MS);
+})();
diff --git a/assets/play.js b/assets/play.js
