+                _ => ("No answer", "play-status--neutral"),
+            };
+            return format!(
+                r##"<div class="play-question__num" id="q-progress">Question {num} of {total}</div><div class="play-question__body" id="q-body">{qbody}</div><div class="play-options is-locked" id="play-options">{opts}</div><div class="play-status {cls}" id="play-result">{res}</div>"##,
+                num = num,
