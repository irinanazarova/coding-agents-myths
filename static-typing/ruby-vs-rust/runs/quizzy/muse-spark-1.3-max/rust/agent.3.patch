+static TOKEN_COUNTER: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn game_random_bytes(n: usize) -> Vec<u8> {
+    if let Ok(mut f) = std::fs::File::open("/dev/urandom") {
+        use std::io::Read as _;
+        let mut buf = vec![0u8; n];
+        if f.read_exact(&mut buf).is_ok() {
+            return buf;
+        }
+    }
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_nanos() as u64)
+        .unwrap_or(123456789);
+    let cnt = TOKEN_COUNTER.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let pid = std::process::id() as u64;
+    let mut seed = now
+        .wrapping_add(cnt.wrapping_mul(0x9e3779b97f4a7c15))
+        .wrapping_add(pid.wrapping_mul(0xbf58476d1ce4e5b9));
+    if seed == 0 {
+        seed = 0x853c49e6748fea9b;
+    }
+    let mut out = Vec::with_capacity(n);
+    for _ in 0..n {
+        seed ^= seed >> 12;
+        seed ^= seed << 25;
+        seed ^= seed >> 27;
+        let v = seed.wrapping_mul(0x2545F4914F6CDD1D);
+        out.push((v >> 56) as u8);
+    }
+    out
+}
