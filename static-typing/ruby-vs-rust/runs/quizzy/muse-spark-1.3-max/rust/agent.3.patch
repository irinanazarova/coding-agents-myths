+fn do_start(conn: &Connection, game: &Game) -> Game {
+    if game.status != "lobby" {
+        return game.clone();
+    }
+    let active = active_questions_for(conn, game.quiz_id);
+    if active.is_empty() {
+        conn.execute("UPDATE games SET status='finished', current_question_id=NULL WHERE id=?1", params![game.id]).unwrap();
+        let mut g = game.clone();
+        g.status = "finished".to_string();
+        g.current_question_id = None;
+        return g;
+    }
+    let first = &active[0];
+    conn.execute(
+        "UPDATE games SET status='open', current_question_id=?1 WHERE id=?2",
+        params![first.id, game.id],
+    )
+    .unwrap();
+    let mut g = game.clone();
+    g.status = "open".to_string();
+    g.current_question_id = Some(first.id);
+    g
+}
+
+fn do_finish(conn: &Connection, game: &Game) -> Game {
+    if game.status != "open" {
+        return game.clone();
+    }
+    conn.execute("UPDATE games SET status='closed' WHERE id=?1", params![game.id]).unwrap();
+    let mut g = game.clone();
+    g.status = "closed".to_string();
+    g
+}
+
+fn do_next(conn: &Connection, game: &Game) -> Game {
+    if game.status != "closed" {
+        return game.clone();
+    }
+    let active = active_questions_for(conn, game.quiz_id);
+    if active.is_empty() {
+        conn.execute("UPDATE games SET status='finished' WHERE id=?1", params![game.id]).unwrap();
+        let mut g = game.clone();
+        g.status = "finished".to_string();
+        return g;
+    }
+    let cur = game.current_question_id;
+    let idx = cur.and_then(|cid| active.iter().position(|q| q.id == cid));
+    if let Some(i) = idx {
+        if i + 1 < active.len() {
+            let nxt = &active[i + 1];
+            conn.execute(
+                "UPDATE games SET status='open', current_question_id=?1 WHERE id=?2",
+                params![nxt.id, game.id],
+            )
+            .unwrap();
+            let mut g = game.clone();
+            g.status = "open".to_string();
+            g.current_question_id = Some(nxt.id);
+            return g;
+        } else {
+            // last -> finish
+            conn.execute("UPDATE games SET status='finished' WHERE id=?1", params![game.id]).unwrap();
+            let mut g = game.clone();
+            g.status = "finished".to_string();
+            return g;
+        }
+    } else {
+        // current not in active (deactivated?) -> go to first?
+        // Find next after position? Simplest: go to first active
+        let nxt = &active[0];
+        // If game had no valid current, start at first open?
+        // But this is Next from closed with invalid current: just finish? Let's go to first.
+        conn.execute(
+            "UPDATE games SET status='open', current_question_id=?1 WHERE id=?2",
+            params![nxt.id, game.id],
+        )
+        .unwrap();
+        let mut g = game.clone();
+        g.status = "open".to_string();
+        g.current_question_id = Some(nxt.id);
+        return g;
+    }
+}
+
+fn do_end(conn: &Connection, game: &Game) -> Game {
+    if game.status == "finished" {
+        return game.clone();
+    }
+    conn.execute("UPDATE games SET status='finished' WHERE id=?1", params![game.id]).unwrap();
+    let mut g = game.clone();
+    g.status = "finished".to_string();
+    g
+}
