+        // fallback waiting
+        return format!(
+            r##"<div class="waiting"><div class="waiting__gem">?</div><h1 id="hi-name">Hi, {name}!</h1><div class="play-lead">Waiting for the quiz to start…</div></div>"##,
+            name = html_escape(&name),
+        );
+    }
+    if st.status == "closed" {
+        if let Some(q) = &st.question {
+            let num = st.current_number.unwrap_or(1);
+            let total = st.total_questions;
+            let mut opts_html = String::new();
+            for (i, o) in q.options.iter().enumerate() {
+                let l = letter_for(i);
+                let picked = st.my_answer == Some(o.id);
+                let mut cls = String::from("play-option");
+                if picked {
+                    cls.push_str(" is-picked");
+                }
+                let mark = if picked {
+                    r##"<span class="play-option__mark">Your answer</span>"##
+                } else {
