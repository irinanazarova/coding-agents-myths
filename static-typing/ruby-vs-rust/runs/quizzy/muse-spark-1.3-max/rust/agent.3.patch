+        if let Ok(s) = v.to_str() {
+            let s = s.trim();
+            if !s.is_empty() {
+                if let Some(p) = get_player_by_token(conn, game.id, s) {
+                    return Some(p);
+                }
+            }
+        }
+    }
+    let cookies = parse_cookies(headers);
+    let code = &game.code;
+    for key in [
+        format!("quizzy_{}", code),
+        format!("qz_{}", code),
+        "quizzy_player".to_string(),
+        "player_token".to_string(),
+        "player".to_string(),
