+}
+
+fn compute_scores(conn: &Connection, game_id: i64) -> Vec<ScoreRow> {
+    let players = list_players(conn, game_id);
+    let mut rows: Vec<ScoreRow> = Vec::new();
+    for pl in players {
+        // points + total time of correct answers
+        // Use elapsed_ms if present, else 0. Handle missing columns gracefully.
+        let (points, total_time): (i64, i64) = (|| {
+            // try with elapsed_ms
+            if let Ok((c, s)) = conn.query_row(
+                "SELECT COUNT(*), COALESCE(SUM(COALESCE(a.elapsed_ms,0)),0) FROM answers a JOIN options o ON a.option_id=o.id WHERE a.game_id=?1 AND a.player_id=?2 AND o.is_correct=1",
+                params![game_id, pl.id],
+                |row| {
+                    let c: i64 = row.get(0)?;
+                    let s: i64 = row.get(1)?;
+                    Ok((c, s))
+                },
+            ) {
+                return (c, s);
+            }
+            // fallback without elapsed (old DB)
+            if let Ok(c) = conn.query_row(
+                "SELECT COUNT(*) FROM answers a JOIN options o ON a.option_id=o.id WHERE a.game_id=?1 AND a.player_id=?2 AND o.is_correct=1",
+                params![game_id, pl.id],
+                |row| {
+                    let c: i64 = row.get(0)?;
+                    Ok(c)
+                },
+            ) {
+                return (c, 0);
+            }
+            (0, 0)
+        })();
+        rows.push(ScoreRow {
+            player_id: pl.id,
+            name: pl.name.clone(),
+            points,
+            total_time_ms: total_time,
+        });
+    }
+    // sort: points desc, total_time asc, name asc (case-insensitive), id asc
+    rows.sort_by(|a, b| {
+        b.points
+            .cmp(&a.points)
+            .then_with(|| a.total_time_ms.cmp(&b.total_time_ms))
+            .then_with(|| a.name.to_lowercase().cmp(&b.name.to_lowercase()))
+            .then_with(|| a.player_id.cmp(&b.player_id))
+    });
+    rows
+}
+
+fn compute_top_winner_ids(scores: &[ScoreRow], n: usize) -> Vec<i64> {
+    if n == 0 {
+        return Vec::new();
+    }
+    let mut out = Vec::new();
+    for s in scores.iter().take(n) {
+        if s.points > 0 {
+            out.push(s.player_id);
+        }
+    }
+    out
+}
+
+fn compute_draw_winner_ids(scores: &[ScoreRow], n: usize) -> Vec<i64> {
+    if n == 0 || scores.is_empty() {
+        return Vec::new();
+    }
+    let scored: Vec<&ScoreRow> = scores.iter().filter(|s| s.points > 0).collect();
+    if scored.is_empty() {
+        return Vec::new();
+    }
+    if scored.len() <= n {
+        return scored.iter().map(|s| s.player_id).collect();
+    }
+    // scored.len() > n: cutoff is points of N-th in leaderboard (which is scored since top N are scored)
+    // leaderboard is already sorted; N-th index is n-1
+    let cutoff = scores[n - 1].points;
+    // cutoff must be >0 here because scored.len() > n implies first n are scored
+    if cutoff <= 0 {
+        // fallback: all scored (should not happen when scored.len()>n)
+        return scored.iter().map(|s| s.player_id).collect();
+    }
+    let mut winners: Vec<i64> = Vec::new();
+    for s in scores.iter() {
+        if s.points > cutoff {
+            winners.push(s.player_id);
+        }
+    }
+    let remaining = n.saturating_sub(winners.len());
+    if remaining == 0 {
+        return winners;
+    }
+    let mut candidates: Vec<i64> = scores
+        .iter()
+        .filter(|s| s.points == cutoff)
+        .map(|s| s.player_id)
+        .collect();
+    random_shuffle(&mut candidates);
+    candidates.truncate(remaining);
+    winners.extend(candidates);
+    winners
+}
