+fn quiz_timer_total_seconds(quiz: &Quiz) -> i64 {
+    let m = quiz.timer_minutes.max(0);
+    let sec = quiz.timer_seconds.max(0);
+    m.saturating_mul(60).saturating_add(sec)
+}
+
+fn format_timer(total_secs: i64) -> String {
+    let t = total_secs.max(0);
+    format!("{}:{:02}", t / 60, t % 60)
+}
+
+fn timer_remaining_ms(game: &Game, quiz: &Quiz, now: i64) -> Option<i64> {
+    let total = quiz_timer_total_seconds(quiz);
+    if total <= 0 {
+        return None;
+    }
+    match game.question_opened_at {
+        Some(opened) => {
+            let expires = opened.saturating_add(total.saturating_mul(1000));
+            Some(expires.saturating_sub(now))
+        }
+        None => Some(total.saturating_mul(1000)),
+    }
+}
+
+fn timer_remaining_text(game: &Game, quiz: &Quiz, now: i64) -> Option<String> {
+    timer_remaining_ms(game, quiz, now).map(|ms| {
+        let secs = ((ms.max(0) + 999) / 1000) as i64;
+        // When expired (ms<=0) show 0:00
+        format_timer(secs)
+    })
+}
