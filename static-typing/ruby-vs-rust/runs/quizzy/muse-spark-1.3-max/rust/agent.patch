+async fn preview_answer_handler(
+    State(state): State<AppState>,
+    Path(id): Path<i64>,
+    Query(q): Query<AnswerQuery>,
+    req: axum::extract::Request,
+) -> impl IntoResponse {
+    let conn = db_connect(&state).unwrap();
+    let Some(_quiz) = get_quiz(&conn, id) else {
+        return (StatusCode::NOT_FOUND, Html(admin_layout("Not found", "<h1>Quiz not found</h1>"))).into_response();
+    };
+    let all = list_questions(&conn, id);
+    let active_qs: Vec<Question> = all.into_iter().filter(|qq| qq.active).collect();
+    let total = active_qs.len();
+    let q_idx = q.q.unwrap_or(0);
+    let score = q.score.unwrap_or(0).max(0);
+    if q_idx >= total {
+        return Redirect::to(&format!(
+            "/moderate/quizzes/{}/preview/result?score={}",
+            id, score
+        ))
+        .into_response();
+    }
+    // parse option_id from body
+    let (_parts, body) = req.into_parts();
+    let bytes = axum::body::to_bytes(body, 1024 * 1024).await.unwrap_or_default();
+    let body_str = String::from_utf8_lossy(&bytes).to_string();
+    let mut option_id: Option<i64> = None;
+    for pair in body_str.split('&') {
+        if pair.is_empty() {
+            continue;
+        }
+        let (k, v) = pair.split_once('=').unwrap_or((pair, ""));
+        let key = percent_decode(k);
+        let val = percent_decode(v);
+        if key == "option_id" {
+            if let Ok(n) = val.parse::<i64>() {
+                option_id = Some(n);
+            }
+        }
+    }
+    let Some(oid) = option_id else {
+        // no option, redirect back to same question
+        return Redirect::to(&format!(
+            "/moderate/quizzes/{}/preview?q={}&score={}",
+            id, q_idx, score
+        ))
+        .into_response();
+    };
+    let current = &active_qs[q_idx];
+    let opts = list_options(&conn, current.id);
+    let picked = opts.iter().find(|o| o.id == oid);
+    let is_correct = picked.map(|o| o.is_correct).unwrap_or(false);
+    let new_score = if is_correct { score + 1 } else { score };
+    Redirect::to(&format!(
+        "/moderate/quizzes/{}/preview?q={}&score={}&picked={}",
+        id, q_idx, new_score, oid
+    ))
+    .into_response()
+}
