+      } else {
+        h += '<ol class="leaderboard" id="leaderboard">';
+        for(var k=0;k<lb.length;k++){
+          var e = lb[k];
+          var cls2 = 'leader' + (e.is_winner ? ' is-winner' : '');
+          h += '<li class="'+cls2+'"><span class="leader__place">'+e.place+'</span><span class="leader__name">'+esc(e.name)+'</span><span class="leader__score">'+esc(e.points_text)+'</span>';
+          if(e.is_winner) h += '<span class="mark mark--winner">Winner</span>';
+          h += '</li>';
+        }
+        h += '</ol>';
+      }
+      h += '</div></div>';
+      body.innerHTML = h;
+      if(controlsInfo) controlsInfo.innerHTML = '<span>Players: '+st.players_count+'</span><span>'+nw+' winners</span>';
+      if(controlsBtns){
+        var topLabel = 'Top ' + nw;
+        controlsBtns.innerHTML = '<button class="btn btn--pink btn--lg" id="btn-top" type="button">'+esc(topLabel)+'</button><button class="btn btn--light btn--lg" id="btn-draw" type="button">Draw</button><button class="btn btn--ghost btn--lg" id="btn-reset" type="button">Reset winners</button>';
+        bindButtons();
+      }
+    }
+  }
+  function postAction(url){
+    fetch(url, {method:'POST', credentials:'same-origin', headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'}}).then(function(){ fetchState(); }).catch(function(){ fetchState(); });
+  }
+  function bindButtons(){
+    var bStart = document.getElementById('btn-start');
+    if(bStart) bStart.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/start'); };
+    var bFinish = document.getElementById('btn-finish');
+    if(bFinish) bFinish.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/finish'); };
+    var bNext = document.getElementById('btn-next');
+    if(bNext) bNext.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/next'); };
+    var bEnd = document.getElementById('btn-end');
+    if(bEnd) bEnd.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/end'); };
+    var bTop = document.getElementById('btn-top');
+    if(bTop) bTop.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/top'); };
+    var bDraw = document.getElementById('btn-draw');
+    if(bDraw) bDraw.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/draw'); };
+    var bReset = document.getElementById('btn-reset');
+    if(bReset) bReset.onclick = function(){ postAction(ORIGIN + '/moderate/games/'+CODE+'/reset-winners'); };
+  }
+  bindButtons();
+  setInterval(fetchState, POLL_MS);
+  setInterval(tickTimer, 200);
+  fetchState();
+})();
diff --git a/assets/play.js b/assets/play.js
new file mode 100644
