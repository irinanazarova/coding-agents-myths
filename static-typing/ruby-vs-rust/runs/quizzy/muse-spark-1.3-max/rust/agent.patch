+async fn update_quiz_handler(
+    State(state): State<AppState>,
+    Path(id): Path<i64>,
+    Form(form): Form<HashMap<String, String>>,
+) -> impl IntoResponse {
+    let conn = db_connect(&state).unwrap();
+    let Some(quiz) = get_quiz(&conn, id) else {
+        return (StatusCode::NOT_FOUND, Html(admin_layout("Not found", "<h1>Quiz not found</h1>"))).into_response();
+    };
+    let title = form.get("title").map(|s| s.trim().to_string()).unwrap_or_default();
+    // Number of winners: support several field names for robustness
+    let nw_raw = form
+        .get("num_winners")
+        .or(form.get("number_of_winners"))
+        .or(form.get("winners"))
+        .or(form.get("numWinners"))
+        .cloned()
+        .unwrap_or_else(|| quiz_num_winners(&quiz).to_string());
+    let nw_trimmed = nw_raw.trim().to_string();
+    // Timer: support several field names for robustness
+    let tm_raw = form
+        .get("timer_minutes")
+        .or(form.get("timer-minutes"))
+        .or(form.get("timerMinutes"))
+        .or(form.get("timer_mins"))
+        .or(form.get("minutes"))
+        .cloned()
+        .unwrap_or_else(|| quiz.timer_minutes.max(0).to_string());
+    let ts_raw = form
+        .get("timer_seconds")
+        .or(form.get("timer-seconds"))
+        .or(form.get("timerSeconds"))
+        .or(form.get("timer_secs"))
+        .or(form.get("seconds"))
+        .cloned()
+        .unwrap_or_else(|| quiz.timer_seconds.max(0).to_string());
+    let tm_trimmed = tm_raw.trim().to_string();
+    let ts_trimmed = ts_raw.trim().to_string();
+    let mut errors: Vec<String> = Vec::new();
+    if title.is_empty() {
+        errors.push("Title can't be blank".to_string());
+    }
+    let nw_parsed: Option<i64> = nw_trimmed.parse::<i64>().ok();
+    match nw_parsed {
+        Some(n) if n >= 1 => {}
+        _ => {
+            errors.push("Number of winners must be at least 1".to_string());
+        }
+    }
+    // Timer validation: blank means 0, must be >=0 integer
+    let tm_parsed: Option<i64> = if tm_trimmed.is_empty() {
+        Some(0)
+    } else {
+        tm_trimmed.parse::<i64>().ok()
+    };
+    match tm_parsed {
+        Some(n) if n >= 0 => {}
+        _ => {
+            errors.push("Timer minutes must be 0 or more".to_string());
+        }
+    }
+    let ts_parsed: Option<i64> = if ts_trimmed.is_empty() {
+        Some(0)
+    } else {
+        ts_trimmed.parse::<i64>().ok()
+    };
+    match ts_parsed {
+        Some(n) if n >= 0 => {}
+        _ => {
+            errors.push("Timer seconds must be 0 or more".to_string());
+        }
+    }
+    if !errors.is_empty() {
+        let title_val = form.get("title").cloned().unwrap_or_default();
+        let body = render_settings_form(id, &quiz.title, &title_val, &nw_trimmed, &tm_trimmed, &ts_trimmed, &errors);
+        return Html(admin_layout("Settings", &body)).into_response();
+    }
+    let nw = nw_parsed.unwrap();
+    let tm = tm_parsed.unwrap().max(0);
+    let ts = ts_parsed.unwrap().max(0);
+    // Update with timer; fallback if columns missing
+    if conn
+        .execute(
+            "UPDATE quizzes SET title=?1, num_winners=?2, timer_minutes=?3, timer_seconds=?4 WHERE id=?5",
+            params![title, nw, tm, ts, id],
+        )
+        .is_err()
+    {
+        let _ = conn.execute(
+            "UPDATE quizzes SET title=?1, num_winners=?2 WHERE id=?3",
+            params![title, nw, id],
+        );
+    }
+    Redirect::to(&format!("/moderate/quizzes/{}", id)).into_response()
+}
