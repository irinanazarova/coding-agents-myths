+async fn game_action_handler(
+    State(state): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    action: &str,
+) -> Response {
+    let conn = db_connect(&state).unwrap();
+    let Some(game_raw) = get_game_by_code(&conn, &code) else {
+        if wants_json(&headers) {
+            return (StatusCode::NOT_FOUND, axum::Json(serde_json::json!({"error":"not found"}))).into_response();
+        } else {
+            return (StatusCode::NOT_FOUND, Html(admin_layout("Not found", "<h1>Game not found</h1>"))).into_response();
+        }
+    };
+    // Auto-finish expired timer before applying requested action
+    let quiz_for_expiry = get_quiz(&conn, game_raw.quiz_id).unwrap_or(Quiz { id: game_raw.quiz_id, title: String::new(), num_winners: 3, timer_minutes: 0, timer_seconds: 0 });
+    let game = maybe_auto_finish(&conn, &game_raw, &quiz_for_expiry);
+    let new_game = match action {
+        "start" => do_start(&conn, &game),
+        "finish" => do_finish(&conn, &game),
+        "next" => do_next(&conn, &game),
+        "end" => do_end(&conn, &game),
+        _ => game.clone(),
+    };
+    if wants_json(&headers) {
+        let quiz = get_quiz(&conn, new_game.quiz_id).unwrap_or(Quiz { id: new_game.quiz_id, title: String::new(), num_winners: 3, timer_minutes: 0, timer_seconds: 0 });
+        let host = host_from_headers(&headers);
+        let st = build_mod_state(&conn, &new_game, &quiz, &host);
+        axum::Json(st).into_response()
+    } else {
+        Redirect::to(&format!("/moderate/games/{}", new_game.code)).into_response()
+    }
+}
