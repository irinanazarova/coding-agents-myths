+                        r#"<div class="breadcrumbs"><a href="/moderate">← All quizzes</a></div><div class="page-head"><h1>New quiz</h1></div><div class="card"><div class="errors"><ul><li>Timer minutes must be 0 or more</li></ul></div><form method="post" action="/moderate/quizzes"><div class="field"><label for="title">Title</label><input class="input" type="text" id="title" name="title" value="{}" required></div><div class="buttons"><button class="btn btn--pink" type="submit">Save quiz</button><a class="btn btn--ghost" href="/moderate">Cancel</a></div></form></div>"#,
+                        html_escape(&title),
+                    );
+                    return Html(admin_layout("New quiz", &body)).into_response();
+                }
+            }
+        }
+    }
+    if let Some(raw) = form
+        .get("timer_seconds")
+        .or(form.get("timer-seconds"))
+        .or(form.get("timerSeconds"))
+    {
+        let t = raw.trim();
+        if !t.is_empty() {
+            match t.parse::<i64>() {
+                Ok(n) if n >= 0 => ts_val = n,
+                _ => {
+                    let body = format!(
+                        r#"<div class="breadcrumbs"><a href="/moderate">← All quizzes</a></div><div class="page-head"><h1>New quiz</h1></div><div class="card"><div class="errors"><ul><li>Timer seconds must be 0 or more</li></ul></div><form method="post" action="/moderate/quizzes"><div class="field"><label for="title">Title</label><input class="input" type="text" id="title" name="title" value="{}" required></div><div class="buttons"><button class="btn btn--pink" type="submit">Save quiz</button><a class="btn btn--ghost" href="/moderate">Cancel</a></div></form></div>"#,
+                        html_escape(&title),
+                    );
+                    return Html(admin_layout("New quiz", &body)).into_response();
+                }
+            }
+        }
+    }
+    if conn
+        .execute(
+            "INSERT INTO quizzes (title, num_winners, timer_minutes, timer_seconds) VALUES (?1, ?2, ?3, ?4)",
+            params![title, nw_val, tm_val, ts_val],
+        )
+        .is_err()
+    {
+        conn.execute(
+            "INSERT INTO quizzes (title, num_winners) VALUES (?1, ?2)",
+            params![title, nw_val],
+        )
+        .unwrap();
+    }
+    let id = conn.last_insert_rowid();
+    Redirect::to(&format!("/moderate/quizzes/{}", id)).into_response()
+}
