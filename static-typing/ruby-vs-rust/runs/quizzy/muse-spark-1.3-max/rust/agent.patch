+                } else {
+                    ""
+                };
+                opts_html.push_str(&format!(
+                    r##"<div class="{cls}"><span class="play-option__letter">{l}</span><span class="play-option__title">{body}</span>{mark}</div>"##,
+                    cls = cls,
+                    l = html_escape(&l),
+                    body = html_escape(&o.body),
+                    mark = mark,
+                ));
+            }
+            let (res_text, res_cls) = match st.result.as_deref() {
+                Some("correct") => ("Correct!", "play-status--right"),
