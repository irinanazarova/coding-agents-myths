+fn list_quizzes(conn: &Connection) -> Vec<Quiz> {
+    // Try with timer columns; fallback if migration hasn't run
+    if let Ok(mut stmt) = conn
+        .prepare("SELECT id, title, COALESCE(num_winners,3), COALESCE(timer_minutes,0), COALESCE(timer_seconds,0) FROM quizzes ORDER BY id ASC")
+    {
+        if let Ok(rows) = stmt.query_map([], |row| {
+            Ok(Quiz {
+                id: row.get(0)?,
+                title: row.get(1)?,
+                num_winners: row.get(2).unwrap_or(3),
+                timer_minutes: row.get(3).unwrap_or(0),
+                timer_seconds: row.get(4).unwrap_or(0),
+            })
+        }) {
+            let v: Vec<Quiz> = rows.filter_map(|r| r.ok()).collect();
+            return v;
+        }
+    }
+    let mut stmt = conn
+        .prepare("SELECT id, title, COALESCE(num_winners,3) FROM quizzes ORDER BY id ASC")
+        .unwrap();
+    let rows = stmt
+        .query_map([], |row| {
+            Ok(Quiz {
+                id: row.get(0)?,
+                title: row.get(1)?,
+                num_winners: row.get(2).unwrap_or(3),
+                timer_minutes: 0,
+                timer_seconds: 0,
+            })
+        })
+        .unwrap();
+    rows.filter_map(|r| r.ok()).collect()
+}
+
+fn get_quiz(conn: &Connection, id: i64) -> Option<Quiz> {
+    // Try with timer columns first
+    if let Ok(mut stmt) = conn
+        .prepare("SELECT id, title, COALESCE(num_winners,3), COALESCE(timer_minutes,0), COALESCE(timer_seconds,0) FROM quizzes WHERE id=?1")
+    {
+        if let Ok(opt) = stmt
+            .query_row(params![id], |row| {
+                Ok(Quiz {
+                    id: row.get(0)?,
+                    title: row.get(1)?,
+                    num_winners: row.get(2).unwrap_or(3),
+                    timer_minutes: row.get(3).unwrap_or(0),
+                    timer_seconds: row.get(4).unwrap_or(0),
+                })
+            })
+            .optional()
+        {
+            if opt.is_some() {
+                return opt;
+            }
+            // If no row, return None (don't fallback)
+            // Check if quiz exists at all? If query succeeded but no row, quiz doesn't exist.
+            // Still need to distinguish missing-column error (which would have failed prepare).
+            // Since prepare succeeded, None means not found.
+            return None;
+        }
+    }
+    conn.query_row(
+        "SELECT id, title, COALESCE(num_winners,3) FROM quizzes WHERE id=?1",
+        params![id],
+        |row| {
+            Ok(Quiz {
+                id: row.get(0)?,
+                title: row.get(1)?,
+                num_winners: row.get(2).unwrap_or(3),
+                timer_minutes: 0,
+                timer_seconds: 0,
+            })
+        },
+    )
+    .optional()
+    .unwrap()
+}
