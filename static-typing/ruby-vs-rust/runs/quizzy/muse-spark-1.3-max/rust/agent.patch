+async fn preview_show_handler(
+    State(state): State<AppState>,
+    Path(id): Path<i64>,
+    Query(q): Query<PreviewQuery>,
+) -> impl IntoResponse {
+    let conn = db_connect(&state).unwrap();
+    let Some(quiz) = get_quiz(&conn, id) else {
+        return (StatusCode::NOT_FOUND, Html(admin_layout("Not found", "<h1>Quiz not found</h1>"))).into_response();
+    };
+    let all = list_questions(&conn, id);
+    let active_qs: Vec<Question> = all.into_iter().filter(|qq| qq.active).collect();
+    let total = active_qs.len();
+    if total == 0 {
+        let content = format!(
+            r#"<div class="play-question__num">Question 0 of 0</div><div class="play-question__body">No active questions</div><div class="play-status play-status--neutral">Add questions and mark them active to preview.</div><div class="buttons" style="margin-top:20px;justify-content:center"><a class="btn btn--pink" href="/moderate/quizzes/{}/preview">Start over</a><a class="btn btn--light" href="/moderate/quizzes/{}">Back to quiz</a></div>"#,
+            id, id
+        );
+        return Html(preview_layout(&quiz.title, id, &content)).into_response();
+    }
+    // If no q param, redirect to q=0
+    if q.q.is_none() {
+        return Redirect::to(&format!("/moderate/quizzes/{}/preview?q=0&score=0", id)).into_response();
+    }
+    let q_idx = q.q.unwrap_or(0);
+    let score = q.score.unwrap_or(0).max(0);
+    if q_idx >= total {
+        // out of bounds -> redirect to result
+        return Redirect::to(&format!(
+            "/moderate/quizzes/{}/preview/result?score={}",
+            id, score
+        ))
+        .into_response();
+    }
+    let current = &active_qs[q_idx];
+    let opts = list_options(&conn, current.id);
+    if let Some(picked_id) = q.picked {
+        // answered state
+        let picked_opt = opts.iter().find(|o| o.id == picked_id);
+        let is_right = picked_opt.map(|o| o.is_correct).unwrap_or(false);
+        let status_text = if is_right { "Correct!" } else { "Wrong!" };
+        let status_class = if is_right {
+            "play-status--right"
+        } else {
+            "play-status--wrong"
+        };
+        let mut ohtml = String::new();
+        for (i, o) in opts.iter().enumerate() {
+            let letter = letter_for(i);
+            let mut cls = String::from("play-option");
+            if o.is_correct {
+                cls.push_str(" is-correct");
+            }
+            if o.id == picked_id {
+                cls.push_str(" is-picked");
+            }
+            let mark = if o.is_correct {
+                r#"<span class="play-option__mark">✓</span>"#
+            } else {
+                ""
+            };
+            ohtml.push_str(&format!(
+                r#"<div class="{}"><span class="play-option__letter">{}</span><span class="play-option__title">{}</span>{}</div>"#,
+                cls,
+                letter,
+                html_escape(&o.body),
+                mark
+            ));
+        }
+        let next_html = if q_idx + 1 < total {
+            format!(
+                r#"<a class="btn btn--pink" href="/moderate/quizzes/{}/preview?q={}&score={}">Next question</a>"#,
+                id,
+                q_idx + 1,
+                score
+            )
+        } else {
+            format!(
+                r#"<a class="btn btn--pink" href="/moderate/quizzes/{}/preview/result?score={}">See score</a>"#,
+                id, score
+            )
+        };
+        let content = format!(
+            r#"<div class="play-question__num">Question {} of {}</div><div class="play-question__body">{}</div><div class="play-options is-locked is-revealed">{}</div><div class="play-status {}">{}</div><div class="play-score"><span>Score: {}/{}</span></div><div class="buttons" style="margin-top:20px">{}</div><div class="buttons" style="margin-top:12px"><a class="btn btn--ghost" href="/moderate/quizzes/{}/preview">Start over</a></div>"#,
+            q_idx + 1,
+            total,
+            html_escape(&current.body),
+            ohtml,
+            status_class,
+            status_text,
+            score,
+            total,
+            next_html,
+            id
+        );
+        Html(preview_layout(&quiz.title, id, &content)).into_response()
+    } else {
+        // unanswered
+        let mut ohtml = String::new();
+        for (i, o) in opts.iter().enumerate() {
+            let letter = letter_for(i);
+            ohtml.push_str(&format!(
+                r#"<form method="post" action="/moderate/quizzes/{}/preview/answer?q={}&score={}"><button class="play-option" type="submit" name="option_id" value="{}"><span class="play-option__letter">{}</span><span class="play-option__title">{}</span></button></form>"#,
+                id,
+                q_idx,
+                score,
+                o.id,
+                letter,
+                html_escape(&o.body)
+            ));
+        }
+        let content = format!(
+            r#"<div class="play-question__num">Question {} of {}</div><div class="play-question__body">{}</div><div class="play-options">{}</div><div class="buttons" style="margin-top:20px"><a class="btn btn--ghost" href="/moderate/quizzes/{}/preview">Start over</a></div>"#,
+            q_idx + 1,
+            total,
+            html_escape(&current.body),
+            ohtml,
+            id
+        );
+        Html(preview_layout(&quiz.title, id, &content)).into_response()
+    }
+}
