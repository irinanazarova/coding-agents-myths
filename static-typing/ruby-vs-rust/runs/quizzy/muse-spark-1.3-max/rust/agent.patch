diff --git a/assets/big_screen.js b/assets/big_screen.js
new file mode 100644
index 0000000..e48f0f1
--- /dev/null
+++ b/assets/big_screen.js
@@ -0,0 +1,227 @@
+(function(){
+  var CODE = "__CODE__";
+  var ORIGIN = (window.location.protocol + "//" + window.location.host);
+  var STATE_URL = ORIGIN + "/moderate/games/" + CODE + "/state";
+  var POLL_MS = 250;
+  function esc(s){ return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#x27;"); }
+  function letter(i){ if(i<26) return String.fromCharCode(65+i); return String(i+1); }
+  function fmtTimer(secs){ secs=Math.max(0, Math.ceil(secs)); var m=Math.floor(secs/60); var s=secs%60; return m+":"+(s<10?"0":"")+s; }
+  function fetchState(){
+    fetch(STATE_URL, {credentials:'same-origin', headers:{'Accept':'application/json'}}).then(function(r){
+      if(!r.ok) return;
+      return r.json();
+    }).then(function(st){
+      if(st) render(st);
+    }).catch(function(e){});
+  }
+  function tickTimer(){
+    try{
+      if(!window._timerActive) return;
+      var el = document.getElementById('timer');
+      if(!el) return;
+      var rm = window._timerRemainingMs;
+      var fetched = window._timerFetchedAt;
+      if(typeof rm!=="number" || !fetched) return;
+      var elapsed = Date.now() - fetched;
+      var left = rm - elapsed;
+      if(left<0) left=0;
+      var secs = Math.ceil(left/1000);
+      var txt = fmtTimer(secs);
+      if(el.textContent!==txt) el.textContent=txt;
+      if(left<=0){
+        var qid = window._timerQuestionId;
+        if(!window._autoFinishSent || window._autoFinishQ!==qid){
+          window._autoFinishSent=true;
+          window._autoFinishQ=qid;
+          postAction(ORIGIN + '/moderate/games/'+CODE+'/finish');
+        }
+      }
+    }catch(e){}
+  }
+  function render(st){
+    var body = document.getElementById('screen-body');
+    var controlsInfo = document.getElementById('controls-info');
+    var controlsBtns = document.getElementById('controls-buttons');
+    if(!body) return;
+    var status = st.status;
+    if(status==='lobby'){
+      window._timerActive=false;
+      window._autoFinishSent=false;
+      var pc = document.getElementById('players-counter');
+      var ju = document.getElementById('join-url');
+      if(pc && ju && body.querySelector('.lobby')){
+        pc.textContent = 'Players: '+st.players_count;
+        if(ju.textContent !== st.join_display) ju.textContent = st.join_display;
+        if(controlsBtns && !document.getElementById('btn-start')){
+          controlsBtns.innerHTML = '<button class="btn btn--pink btn--lg" id="btn-start" type="button">Start</button>';
+          bindButtons();
+        }
+        if(controlsInfo) controlsInfo.innerHTML = '<span>Players: '+st.players_count+'</span>';
