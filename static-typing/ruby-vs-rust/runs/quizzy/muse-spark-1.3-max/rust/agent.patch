+fn count_questions(conn: &Connection, quiz_id: i64) -> (i64, i64) {
+    let total: i64 = conn
+        .query_row(
+            "SELECT COUNT(*) FROM questions WHERE quiz_id=?1",
+            params![quiz_id],
+            |r| r.get(0),
+        )
+        .unwrap_or(0);
+    let active: i64 = conn
+        .query_row(
+            "SELECT COUNT(*) FROM questions WHERE quiz_id=?1 AND active=1",
+            params![quiz_id],
+            |r| r.get(0),
+        )
+        .unwrap_or(0);
+    (total, active)
+}
