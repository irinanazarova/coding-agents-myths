+async fn winners_action_handler(
+    State(state): State<AppState>,
+    Path(code): Path<String>,
+    headers: HeaderMap,
+    action: &str,
+) -> Response {
+    let conn = db_connect(&state).unwrap();
+    let Some(game) = get_game_by_code(&conn, &code) else {
+        if wants_json(&headers) {
+            return (StatusCode::NOT_FOUND, axum::Json(serde_json::json!({"error":"not found"}))).into_response();
+        } else {
+            return (StatusCode::NOT_FOUND, Html(admin_layout("Not found", "<h1>Game not found</h1>"))).into_response();
+        }
+    };
+    let quiz = get_quiz(&conn, game.quiz_id).unwrap_or(Quiz { id: game.quiz_id, title: String::new(), num_winners: 3, timer_minutes: 0, timer_seconds: 0 });
+    let game = maybe_auto_finish(&conn, &game, &quiz);
+    // Only pick winners when finished; otherwise just return state
+    if game.status == "finished" {
+        let scores = compute_scores(&conn, game.id);
+        let n = quiz_num_winners(&quiz).max(1) as usize;
+        match action {
+            "top" => {
+                let ids = compute_top_winner_ids(&scores, n);
+                set_winners(&conn, game.id, &ids);
+            }
+            "draw" => {
+                let ids = compute_draw_winner_ids(&scores, n);
+                set_winners(&conn, game.id, &ids);
+            }
+            "reset" => {
+                set_winners(&conn, game.id, &[]);
+            }
+            _ => {}
+        }
+    }
+    if wants_json(&headers) {
+        let game2 = get_game_by_code(&conn, &code).unwrap_or(game);
+        let host = host_from_headers(&headers);
+        let st = build_mod_state(&conn, &game2, &quiz, &host);
+        axum::Json(st).into_response()
+    } else {
+        Redirect::to(&format!("/moderate/games/{}", game.code)).into_response()
+    }
+}
