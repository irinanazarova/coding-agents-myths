+          return;
+        }
+      }
+      window._lastFinishedSig = sig;
+      var h = '<div class="leaderboard-layout"><div><div class="screen__kicker">Results</div><h1 class="leaderboard-layout__title" id="quiz-over">The quiz is over</h1></div><div>';
