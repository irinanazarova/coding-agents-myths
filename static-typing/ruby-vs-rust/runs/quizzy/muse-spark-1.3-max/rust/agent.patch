+fn random_shuffle<T>(v: &mut [T]) {
+    let n = v.len();
+    if n <= 1 {
+        return;
+    }
+    let bytes = game_random_bytes(n * 4);
+    for i in (1..n).rev() {
+        let off = i * 4;
+        let r = if off + 4 <= bytes.len() {
+            u32::from_be_bytes([bytes[off], bytes[off + 1], bytes[off + 2], bytes[off + 3]]) as usize
+        } else {
+            (now_ms() as usize).wrapping_add(i * 0x9e3779b9)
+        };
+        let j = r % (i + 1);
+        v.swap(i, j);
+    }
+}
