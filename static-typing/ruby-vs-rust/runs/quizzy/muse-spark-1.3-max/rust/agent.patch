+++ b/assets/play.js
@@ -0,0 +1,251 @@
+(function(){
+  var CODE = "__CODE__";
+  var ORIGIN = (window.location.protocol + "//" + window.location.host);
+  var BASE = ORIGIN + "/play/" + CODE;
+  var POLL_MS = 250;
+  function esc(s){ return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#x27;"); }
+  function letter(i){ if(i<26) return String.fromCharCode(65+i); return String(i+1); }
+  function getToken(){
+    try{
+      var v = localStorage.getItem('quizzy_player_'+CODE);
+      if(v) return v;
+    }catch(e){}
+    try{
+      var ck = document.cookie || '';
+      var parts = ck.split(';');
+      for(var i=0;i<parts.length;i++){
+        var p = parts[i].trim();
+        var prefix1 = 'quizzy_'+CODE+'=';
+        var prefix2 = 'qz_'+CODE+'=';
+        if(p.indexOf(prefix1)===0) return decodeURIComponent(p.substring(prefix1.length));
+        if(p.indexOf(prefix2)===0) return decodeURIComponent(p.substring(prefix2.length));
+      }
+      // fallback: any cookie that looks like hex token 32 chars? try all
+      for(var j=0;j<parts.length;j++){
+        var pp = parts[j].trim();
+        var eq = pp.indexOf('=');
+        if(eq>0){
+          var val = decodeURIComponent(pp.substring(eq+1));
+          if(/^[0-9a-f]{32}$/.test(val)) return val;
+        }
+      }
+    }catch(e){}
+    return null;
+  }
+  function setToken(t){
+    try{ localStorage.setItem('quizzy_player_'+CODE, t); }catch(e){}
+    try{ document.cookie = 'quizzy_'+CODE+'='+encodeURIComponent(t)+'; Path=/; Max-Age=31536000; SameSite=Lax'; }catch(e){}
+  }
+  function stateUrl(){
+    var t = getToken();
+    if(t) return BASE + '/state?token='+encodeURIComponent(t);
+    return BASE + '/state';
+  }
+  function fetchState(){
+    var t = getToken();
+    var headers = {'Accept':'application/json'};
+    if(t) headers['X-Player-Token'] = t;
+    fetch(stateUrl(), {credentials:'same-origin', headers: headers}).then(function(r){
+      if(!r.ok) return;
+      return r.json();
+    }).then(function(st){
+      if(st) render(st);
+    }).catch(function(e){});
+  }
+  function render(st){
+    var body = document.getElementById('play-body');
+    if(!body) return;
+    var status = st.status;
+    if(status==='finished'){
+      if(!st.joined){
+        if(!document.getElementById('quiz-over')){
+          body.innerHTML = '<div class="waiting"><div class="waiting__gem">✓</div><h1 id="quiz-over">The quiz is over</h1></div>';
+        }
+        return;
+      }
+      var wantPlace = st.place_text || '';
+      var wantPoints = st.points_text || '';
+      var wantWon = !!st.is_winner;
+      var curOver = document.getElementById('quiz-over');
+      var curPlace = document.getElementById('place');
+      var curPoints = document.getElementById('points');
+      var curWon = document.getElementById('won');
+      if(curOver && curPlace && curPoints && curPlace.textContent===wantPlace && curPoints.textContent===wantPoints && !!curWon===wantWon){
+        return;
+      }
+      // if no place/points yet (e.g. old server), fall back to simple over screen then update when available
+      if(!wantPlace && !wantPoints && !curOver){
+        body.innerHTML = '<div class="waiting"><div class="waiting__gem">✓</div><h1 id="quiz-over">The quiz is over</h1></div>';
+        return;
+      }
+      if(!wantPlace && !wantPoints){
+        if(!curOver){
+          body.innerHTML = '<div class="waiting"><div class="waiting__gem">✓</div><h1 id="quiz-over">The quiz is over</h1></div>';
+        }
+        return;
+      }
+      var hf = '<div class="waiting"><div class="waiting__gem">✓</div><h1 id="quiz-over">The quiz is over</h1><div class="result-card">';
+      if(wantPlace) hf += '<div class="result-card__label" id="place">'+esc(wantPlace)+'</div>';
+      if(wantPoints) hf += '<div class="result-card__score" id="points">'+esc(wantPoints)+'</div>';
+      hf += '</div>';
+      if(wantWon) hf += '<div class="winner-banner" id="won">You won!<small>Show this screen to claim your prize</small></div>';
+      hf += '</div>';
+      body.innerHTML = hf;
+      return;
+    }
+    if(!st.joined){
+      if(!document.getElementById('join-form')){
+        var h = '<h1 class="play-title">'+esc(st.quiz_title)+'</h1>';
+        h += '<form id="join-form" method="post" action="'+BASE+'/join">';
+        h += '<div class="field"><label for="name">Your name</label><input class="input" id="name" name="name" placeholder="Your name" required autocomplete="nickname" maxlength="50"></div>';
+        h += '<div class="join-form"><button class="btn btn--pink" type="submit">Join</button></div>';
+        h += '</form>';
+        body.innerHTML = h;
+        bindJoin();
+      } else {
+        // update title if needed? keep input value
+        var titleEl = body.querySelector('.play-title');
+        if(titleEl && titleEl.textContent !== st.quiz_title) titleEl.textContent = st.quiz_title;
+      }
+      return;
+    }
+    var name = st.player_name || '';
+    if(status==='lobby'){
+      var hi = document.getElementById('hi-name');
+      if(hi && hi.textContent === ('Hi, '+name+'!') && body.querySelector('.waiting')){
+        return;
+      }
+      body.innerHTML = '<div class="waiting"><div class="waiting__gem">?</div><h1 id="hi-name">Hi, '+esc(name)+'!</h1><div class="play-lead">Waiting for the quiz to start…</div></div>';
+      return;
+    }
+    if(status==='open'){
+      var q = st.question;
+      if(!q) return;
+      var total = st.total_questions;
+      var num = st.current_number || 1;
+      // avoid re-render if same question and same answer (preserve button state, avoid flicker)
+      var curBody = document.getElementById('q-body');
+      var curProg = document.getElementById('q-progress');
+      var wantProg = 'Question '+num+' of '+total;
+      var pickedId = st.my_answer;
+      if(curBody && curProg && curProg.textContent===wantProg && curBody.textContent===q.body){
+        // check if picked markers match
+        var btns = body.querySelectorAll('#play-options button[data-option-id]');
+        if(btns.length===q.options.length){
+          var match = true;
+          for(var i=0;i<btns.length;i++){
+            var oid = parseInt(btns[i].getAttribute('data-option-id'),10);
+            var shouldPicked = (pickedId!==null && pickedId!==undefined && oid===pickedId);
+            var isPicked = btns[i].classList.contains('is-picked');
+            if(shouldPicked!==isPicked){ match=false; break; }
+            // also check Your answer mark
+            var hasMark = btns[i].textContent.indexOf('Your answer')>=0;
+            if(shouldPicked!==hasMark){ match=false; break; }
+          }
+          if(match) return;
+        }
+      }
+      var h2 = '<div class="play-question__num" id="q-progress">'+wantProg+'</div>';
+      h2 += '<div class="play-question__body" id="q-body">'+esc(q.body)+'</div>';
+      h2 += '<div class="play-options" id="play-options">';
+      for(var k=0;k<q.options.length;k++){
+        var o = q.options[k];
+        var L = letter(k);
+        var isPicked2 = (pickedId!==null && pickedId!==undefined && o.id===pickedId);
+        var cls = 'play-option';
+        if(isPicked2) cls += ' is-picked';
+        h2 += '<button class="'+cls+'" type="button" data-option-id="'+o.id+'"><span class="play-option__letter">'+L+'</span><span class="play-option__title">'+esc(o.body)+'</span>';
+        if(isPicked2) h2 += '<span class="play-option__mark">Your answer</span>';
+        h2 += '</button>';
+      }
+      h2 += '</div>';
+      body.innerHTML = h2;
+      bindOptions();
+      return;
+    }
+    if(status==='closed'){
+      var qc = st.question;
+      if(!qc) return;
+      var total2 = st.total_questions;
+      var num2 = st.current_number || 1;
+      var wantProg2 = 'Question '+num2+' of '+total2;
+      var resText = st.result_text || '';
+      var resCls = st.result_class || 'play-status--neutral';
+      var curRes = document.getElementById('play-result');
+      var curBody2 = document.getElementById('q-body');
+      var curProg2 = document.getElementById('q-progress');
+      if(curRes && curBody2 && curProg2 && curProg2.textContent===wantProg2 && curBody2.textContent===qc.body && curRes.textContent===resText){
+        // check picked markers
+        var divs = body.querySelectorAll('#play-options .play-option');
+        if(divs.length===qc.options.length){
+          var ok = true;
+          for(var m=0;m<divs.length;m++){
+            var oid2 = qc.options[m].id;
+            var should2 = (st.my_answer!==null && st.my_answer!==undefined && oid2===st.my_answer);
+            var is2 = divs[m].classList.contains('is-picked');
+            if(should2!==is2){ ok=false; break; }
+          }
+          if(ok) return;
+        }
+      }
+      var h3 = '<div class="play-question__num" id="q-progress">'+wantProg2+'</div>';
+      h3 += '<div class="play-question__body" id="q-body">'+esc(qc.body)+'</div>';
+      h3 += '<div class="play-options is-locked" id="play-options">';
+      for(var n=0;n<qc.options.length;n++){
+        var oc = qc.options[n];
+        var Lc = letter(n);
+        var pickedC = (st.my_answer!==null && st.my_answer!==undefined && oc.id===st.my_answer);
+        var clsc = 'play-option';
+        if(pickedC) clsc += ' is-picked';
+        h3 += '<div class="'+clsc+'"><span class="play-option__letter">'+Lc+'</span><span class="play-option__title">'+esc(oc.body)+'</span>';
+        if(pickedC) h3 += '<span class="play-option__mark">Your answer</span>';
+        h3 += '</div>';
+      }
+      h3 += '</div>';
+      h3 += '<div class="play-status '+resCls+'" id="play-result">'+resText+'</div>';
