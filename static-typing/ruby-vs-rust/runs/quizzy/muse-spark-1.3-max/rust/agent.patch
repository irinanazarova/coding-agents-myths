+fn is_timer_expired(game: &Game, quiz: &Quiz, now: i64) -> bool {
+    if game.status != "open" {
+        return false;
+    }
+    let total = quiz_timer_total_seconds(quiz);
+    if total <= 0 {
+        return false;
+    }
+    match game.question_opened_at {
+        Some(opened) => {
+            let expires = opened.saturating_add(total.saturating_mul(1000));
+            now >= expires
+        }
+        None => false,
+    }
+}
+
+fn maybe_auto_finish(conn: &Connection, game: &Game, quiz: &Quiz) -> Game {
+    if game.status != "open" {
+        return game.clone();
+    }
+    let total = quiz_timer_total_seconds(quiz);
+    if total <= 0 {
+        return game.clone();
+    }
+    let now = now_ms();
+    match game.question_opened_at {
+        Some(_opened) => {
+            if is_timer_expired(game, quiz, now) {
+                let _ = conn.execute(
+                    "UPDATE games SET status='closed' WHERE id=?1 AND status='open'",
+                    params![game.id],
+                );
+                let mut g = game.clone();
+                g.status = "closed".to_string();
+                return g;
+            }
+            game.clone()
+        }
+        None => {
+            // Old game without opened_at: start timer now
+            let _ = conn.execute(
+                "UPDATE games SET question_opened_at=?1 WHERE id=?2",
+                params![now, game.id],
+            );
+            let mut g = game.clone();
+            g.question_opened_at = Some(now);
+            g
+        }
+    }
+}
+
+fn build_mod_state(conn: &Connection, game: &Game, quiz: &Quiz, host: &str) -> ModGameState {
+    let active = active_questions_for(conn, game.quiz_id);
+    let total = active.len();
+    let players_count = count_players(conn, game.id);
+    let join_display = format!("{}/play/{}", host, game.code);
+    let join_full = format!("http://{}/play/{}", host, game.code);
+    let status = game.status.clone();
+    let nw = quiz_num_winners(quiz);
+    let timer_total = quiz_timer_total_seconds(quiz);
+    if status == "lobby" {
+        return ModGameState {
+            status,
+            quiz_title: quiz.title.clone(),
+            code: game.code.clone(),
+            quiz_id: quiz.id,
+            join_display,
+            join_full,
+            players_count,
+            total_questions: total,
+            current_number: None,
+            is_last: false,
+            question: None,
+            answers_count: 0,
+            leaderboard: Vec::new(),
+            winners: Vec::new(),
+            num_winners: nw,
+            timer_seconds: timer_total,
+            remaining_ms: None,
+            remaining_text: None,
+            opened_at: None,
+        };
+    }
+    if status == "finished" {
+        let scores = compute_scores(conn, game.id);
+        let win_set = get_winners_set(conn, game.id);
+        let mut lb: Vec<LeaderEntry> = Vec::new();
+        for (idx, s) in scores.iter().enumerate() {
+            lb.push(LeaderEntry {
+                place: idx + 1,
+                player_id: s.player_id,
+                name: s.name.clone(),
+                points: s.points,
+                points_text: points_text(s.points),
+                total_time_ms: s.total_time_ms,
+                is_winner: win_set.contains(&s.player_id),
+            });
+        }
+        let winners: Vec<i64> = lb.iter().filter(|e| e.is_winner).map(|e| e.player_id).collect();
+        return ModGameState {
+            status,
+            quiz_title: quiz.title.clone(),
+            code: game.code.clone(),
+            quiz_id: quiz.id,
+            join_display,
+            join_full,
+            players_count,
+            total_questions: total,
+            current_number: None,
+            is_last: true,
+            question: None,
+            answers_count: 0,
+            leaderboard: lb,
+            winners,
+            num_winners: nw,
+            timer_seconds: timer_total,
+            remaining_ms: None,
+            remaining_text: None,
+            opened_at: None,
+        };
+    }
+    // open or closed: need current question
+    let cq_id = game.current_question_id;
+    let mut current_number: Option<usize> = None;
+    let mut is_last = false;
+    let mut qstate: Option<ModQuestionState> = None;
+    let mut answers_count: i64 = 0;
+    if let Some(qid) = cq_id {
+        // find index in active list
+        if let Some(idx) = active.iter().position(|q| q.id == qid) {
+            current_number = Some(idx + 1);
+            is_last = idx + 1 == total;
+            // load question body + options
+            if let Some(q) = active.get(idx) {
+                let opts = list_options(conn, q.id);
+                let counts = counts_per_option(conn, game.id, q.id);
+                answers_count = count_answers_for(conn, game.id, q.id);
+                let mut vopts = Vec::new();
+                for o in opts {
+                    vopts.push(ModOptionState {
+                        id: o.id,
+                        body: o.body.clone(),
+                        count: *counts.get(&o.id).unwrap_or(&0),
+                        is_correct: o.is_correct,
+                    });
+                }
+                qstate = Some(ModQuestionState {
+                    id: q.id,
+                    body: q.body.clone(),
+                    options: vopts,
+                });
+            }
+        } else {
+            // current question not in active (was deactivated or deleted) - try to load directly
+            if let Some(qrow) = conn
+                .query_row(
+                    "SELECT id, quiz_id, body, active, position FROM questions WHERE id=?1",
+                    params![qid],
+                    |row| {
+                        let a: i64 = row.get(3)?;
+                        Ok(Question {
+                            id: row.get(0)?,
+                            quiz_id: row.get(1)?,
+                            body: row.get(2)?,
+                            active: a != 0,
+                            position: row.get(4)?,
+                        })
+                    },
+                )
+                .optional()
+                .unwrap()
+            {
+                let opts = list_options(conn, qrow.id);
+                let counts = counts_per_option(conn, game.id, qrow.id);
+                answers_count = count_answers_for(conn, game.id, qrow.id);
+                let mut vopts = Vec::new();
+                for o in opts {
+                    vopts.push(ModOptionState {
+                        id: o.id,
+                        body: o.body.clone(),
+                        count: *counts.get(&o.id).unwrap_or(&0),
+                        is_correct: o.is_correct,
+                    });
+                }
+                // number unknown, use 1?
+                current_number = Some(1);
+                is_last = total <= 1;
+                qstate = Some(ModQuestionState {
+                    id: qrow.id,
+                    body: qrow.body.clone(),
+                    options: vopts,
+                });
+            }
+        }
+    }
+    let nw2 = quiz_num_winners(quiz);
+    // Timer: only while open with configured duration
+    let (rem_ms, rem_text, opened) = if status == "open" && timer_total > 0 {
+        let now = now_ms();
+        let ms = timer_remaining_ms(game, quiz, now);
+        let txt = timer_remaining_text(game, quiz, now);
+        // Clamp negative to 0 for display (server auto-finish will close on next poll)
+        let ms_clamped = ms.map(|v| v.max(0));
+        let txt_clamped = txt.or(Some("0:00".to_string()));
+        (ms_clamped, txt_clamped, game.question_opened_at)
+    } else {
+        (None, None, None)
+    };
+    ModGameState {
+        status,
+        quiz_title: quiz.title.clone(),
+        code: game.code.clone(),
+        quiz_id: quiz.id,
+        join_display,
+        join_full,
+        players_count,
+        total_questions: total,
+        current_number,
+        is_last,
+        question: qstate,
+        answers_count,
+        leaderboard: Vec::new(),
+        winners: Vec::new(),
+        num_winners: nw2,
+        timer_seconds: timer_total,
+        remaining_ms: rem_ms,
+        remaining_text: rem_text,
+        opened_at: opened,
+    }
+}
+
+fn build_play_state(
+    conn: &Connection,
+    game: &Game,
+    quiz: &Quiz,
+    player_opt: Option<&Player>,
+) -> PlayState {
+    let active = active_questions_for(conn, game.quiz_id);
+    let total = active.len();
+    let status = game.status.clone();
+    let joined = player_opt.is_some();
+    let player_name = player_opt.map(|p| p.name.clone());
+    if status == "lobby" {
+        return PlayState {
+            status,
+            quiz_title: quiz.title.clone(),
+            code: game.code.clone(),
+            joined,
+            player_name,
+            total_questions: total,
+            current_number: None,
+            question: None,
+            my_answer: None,
+            result: None,
+            result_text: None,
+            result_class: None,
+            place: None,
+            total_players: None,
+            place_text: None,
+            points: None,
+            points_text: None,
+            is_winner: None,
+        };
+    }
+    if status == "finished" {
+        // Leaderboard for this player: place + points + winner
+        let scores = compute_scores(conn, game.id);
+        let total_players = scores.len();
+        let win_set = get_winners_set(conn, game.id);
+        let mut place: Option<usize> = None;
+        let mut pts: Option<i64> = None;
+        let mut pts_text: Option<String> = None;
+        let mut place_text: Option<String> = None;
+        let mut won: Option<bool> = None;
+        if let Some(pl) = player_opt {
+            for (idx, s) in scores.iter().enumerate() {
+                if s.player_id == pl.id {
+                    let p = idx + 1;
+                    place = Some(p);
+                    pts = Some(s.points);
+                    pts_text = Some(points_text(s.points));
+                    place_text = Some(format!("Place {} of {}", p, total_players));
+                    won = Some(win_set.contains(&pl.id));
+                    break;
+                }
+            }
+            // If player not in scores (should not happen), fallback
+            if place.is_none() {
+                place = Some(total_players);
+                pts = Some(0);
+                pts_text = Some(points_text(0));
+                place_text = Some(format!("Place {} of {}", total_players, total_players));
+                won = Some(false);
+            }
+        }
+        return PlayState {
+            status,
+            quiz_title: quiz.title.clone(),
+            code: game.code.clone(),
+            joined,
+            player_name,
+            total_questions: total,
+            current_number: None,
+            question: None,
+            my_answer: None,
+            result: None,
+            result_text: None,
+            result_class: None,
+            place,
+            total_players: Some(total_players),
+            place_text,
+            points: pts,
+            points_text: pts_text,
+            is_winner: won,
+        };
+    }
+    // open or closed
+    let cq_id = game.current_question_id;
+    let mut current_number: Option<usize> = None;
+    let mut qstate: Option<PlayQuestionState> = None;
+    let mut my_answer: Option<i64> = None;
+    let mut result: Option<String> = None;
+    let mut result_text: Option<String> = None;
+    let mut result_class: Option<String> = None;
+    if let Some(qid) = cq_id {
+        // find question (prefer active list, fallback direct)
+        let mut qbody: Option<String> = None;
+        let mut qopts: Vec<OptionItem> = Vec::new();
+        if let Some(idx) = active.iter().position(|q| q.id == qid) {
+            current_number = Some(idx + 1);
+            let q = &active[idx];
+            qbody = Some(q.body.clone());
+            qopts = list_options(conn, q.id);
+        } else {
+            // fallback direct load
+            if let Some(qrow) = conn
+                .query_row(
+                    "SELECT id, body FROM questions WHERE id=?1",
+                    params![qid],
+                    |row| {
+                        let id: i64 = row.get(0)?;
+                        let body: String = row.get(1)?;
+                        Ok((id, body))
+                    },
+                )
+                .optional()
+                .unwrap()
+            {
+                current_number = Some(1);
+                qbody = Some(qrow.1);
+                qopts = list_options(conn, qrow.0);
+            }
+        }
+        if let Some(body) = qbody {
+            let mut vopts = Vec::new();
+            for o in &qopts {
+                vopts.push(PlayOptionState {
+                    id: o.id,
+                    body: o.body.clone(),
+                });
+            }
+            qstate = Some(PlayQuestionState {
+                body,
+                options: vopts,
+            });
+            if let Some(pl) = player_opt {
+                my_answer = get_player_answer(conn, pl.id, qid);
+                if status == "closed" {
+                    if let Some(aid) = my_answer {
+                        // check correctness without leaking other options
+                        let is_corr: Option<i64> = conn
+                            .query_row(
+                                "SELECT is_correct FROM options WHERE id=?1",
+                                params![aid],
+                                |r| r.get(0),
+                            )
+                            .optional()
+                            .unwrap();
+                        match is_corr {
+                            Some(1) => {
+                                result = Some("correct".to_string());
+                                result_text = Some("Correct!".to_string());
+                                result_class = Some("play-status--right".to_string());
+                            }
+                            Some(_) => {
+                                result = Some("wrong".to_string());
+                                result_text = Some("Wrong!".to_string());
+                                result_class = Some("play-status--wrong".to_string());
+                            }
+                            None => {
+                                result = Some("wrong".to_string());
+                                result_text = Some("Wrong!".to_string());
+                                result_class = Some("play-status--wrong".to_string());
+                            }
+                        }
+                    } else {
+                        result = Some("no_answer".to_string());
+                        result_text = Some("No answer".to_string());
+                        result_class = Some("play-status--neutral".to_string());
+                    }
+                }
+            } else {
+                // not joined: no answer/result
+            }
+        }
+    }
+    PlayState {
+        status,
+        quiz_title: quiz.title.clone(),
+        code: game.code.clone(),
+        joined,
+        player_name,
+        total_questions: total,
+        current_number,
+        question: qstate,
+        my_answer,
+        result,
+        result_text,
+        result_class,
+        place: None,
+        total_players: None,
+        place_text: None,
+        points: None,
+        points_text: None,
+        is_winner: None,
+    }
+}
+
