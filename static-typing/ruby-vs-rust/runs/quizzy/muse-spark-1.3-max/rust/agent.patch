+fn host_from_headers(headers: &HeaderMap) -> String {
+    if let Some(v) = headers.get(header::HOST) {
+        if let Ok(s) = v.to_str() {
+            let s = s.trim();
+            if !s.is_empty() {
+                return s.to_string();
+            }
+        }
+    }
+    if let Some(v) = headers.get("x-forwarded-host") {
+        if let Ok(s) = v.to_str() {
+            let s = s.trim();
+            if !s.is_empty() {
+                return s.to_string();
+            }
+        }
+    }
+    let port = env::var("PORT").unwrap_or_else(|_| "3000".to_string());
+    format!("localhost:{}", port)
+}
+
+fn parse_cookies(headers: &HeaderMap) -> HashMap<String, String> {
+    let mut map = HashMap::new();
+    for val in headers.get_all(header::COOKIE) {
+        if let Ok(s) = val.to_str() {
+            for part in s.split(';') {
+                let part = part.trim();
+                if part.is_empty() {
+                    continue;
+                }
+                if let Some((k, v)) = part.split_once('=') {
+                    map.insert(k.trim().to_string(), v.trim().to_string());
+                }
+            }
+        }
+    }
+    map
+}
+
+fn wants_json(headers: &HeaderMap) -> bool {
+    if let Some(v) = headers.get("x-requested-with") {
+        if let Ok(s) = v.to_str() {
+            let l = s.to_lowercase();
+            if l.contains("xmlhttprequest") || l.contains("fetch") {
+                return true;
+            }
+        }
+    }
+    if let Some(v) = headers.get(header::ACCEPT) {
+        if let Ok(s) = v.to_str() {
+            if s.contains("application/json") {
+                return true;
+            }
+        }
+    }
+    false
+}
