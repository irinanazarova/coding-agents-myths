+// ---------- questions ----------
+#[derive(Debug)]
+struct RawOption {
+    text: String,
+    is_correct: bool,
+}
+
+fn parse_question_form(form: &HashMap<String, String>) -> (String, bool, Vec<RawOption>, Vec<(String, bool)>) {
+    let body = form.get("body").cloned().unwrap_or_default();
+    // also support "question" name fallback
+    let body = if body.is_empty() {
+        form.get("question").cloned().unwrap_or_default()
+    } else {
+        body
+    };
+    let active = form.contains_key("active");
+    // collect indices
+    let mut indices: Vec<usize> = Vec::new();
+    for k in form.keys() {
+        if let Some(rest) = k.strip_prefix("option_text_") {
+            if let Ok(n) = rest.parse::<usize>() {
+                indices.push(n);
+            }
+        }
+    }
+    // Also support option_text without index? e.g. option_text[] not used
+    indices.sort_unstable();
+    indices.dedup();
+    let mut raw: Vec<(String, bool)> = Vec::new();
+    for n in indices {
+        let key_t = format!("option_text_{}", n);
+        let key_c = format!("option_correct_{}", n);
+        let text = form.get(&key_t).cloned().unwrap_or_default();
+        let correct = form.contains_key(&key_c);
+        raw.push((text, correct));
+    }
+    // filtered
+    let mut filtered: Vec<RawOption> = Vec::new();
+    for (t, c) in &raw {
+        if t.trim().is_empty() {
+            continue;
+        }
+        filtered.push(RawOption {
+            text: t.trim().to_string(),
+            is_correct: *c,
+        });
+    }
+    // raw for re-render: keep original (not trimmed? keep as typed)
+    let raw_keep: Vec<(String, bool)> = raw;
+    (body, active, filtered, raw_keep)
+}
+
+fn render_question_form(
+    quiz: &Quiz,
+    action: &str,
+    heading: &str,
+    body_val: &str,
+    active_checked: bool,
+    rows: &[(String, bool)],
+    errors: &[String],
+) -> String {
+    let mut err_html = String::new();
+    if !errors.is_empty() {
+        err_html.push_str(r#"<div class="errors"><ul>"#);
+        for e in errors {
+            err_html.push_str(&format!("<li>{}</li>", html_escape(e)));
+        }
+        err_html.push_str("</ul></div>");
+        // Also ensure plain text visible? The above already shows exact strings.
+    }
+    let mut rows_html = String::new();
+    for (i, (text, correct)) in rows.iter().enumerate() {
+        let n = i + 1;
+        let checked = if *correct { " checked" } else { "" };
+        rows_html.push_str(&format!(
+            r#"<div class="option-row"><div style="display:flex;flex-direction:column;gap:4px;flex:1"><label for="option-text-{n}">Option {n}</label><input class="input" type="text" id="option-text-{n}" name="option_text_{n}" value="{}" placeholder="Option text"></div><label class="checkbox" for="option-correct-{n}"><input type="checkbox" id="option-correct-{n}" name="option_correct_{n}" value="on"{checked}> Option {n} is correct</label></div>"#,
+            html_escape(text),
+            n = n,
+            checked = checked
+        ));
+    }
+    let active_checked_str = if active_checked { " checked" } else { "" };
+    let inner = format!(
+        r#"<div class="breadcrumbs"><a href="/moderate/quizzes/{}">← {}</a></div><div class="page-head"><h1>{}</h1></div><div class="card"><form method="post" action="{}" id="question-form"><div class="field"><label for="question">Question</label><textarea class="input" id="question" name="body" rows="3" required>{}</textarea></div><div class="field"><span class="field-label">Options</span><span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span></div>{}<div class="option-rows" id="option-rows">{}</div><div class="buttons" style="margin-bottom:28px"><button class="btn btn--ghost btn--sm" type="button" id="add-option">Add option</button></div><div class="field"><label class="checkbox"><input type="checkbox" name="active" value="on"{}> Active</label><span class="field-hint">Only active questions are played.</span></div><div class="buttons"><button class="btn btn--pink" type="submit">Save question</button><a class="btn btn--ghost" href="/moderate/quizzes/{}">Cancel</a></div></form></div><script>document.getElementById('add-option').addEventListener('click', function() {{ var container = document.getElementById('option-rows'); var count = container.querySelectorAll('.option-row').length + 1; var div = document.createElement('div'); div.className = 'option-row'; div.innerHTML = '<div style="display:flex;flex-direction:column;gap:4px;flex:1"><label for="option-text-'+count+'">Option '+count+'</label><input class="input" type="text" id="option-text-'+count+'" name="option_text_'+count+'" value="" placeholder="Option text"></div><label class="checkbox" for="option-correct-'+count+'"><input type="checkbox" id="option-correct-'+count+'" name="option_correct_'+count+'" value="on"> Option '+count+' is correct</label>'; container.appendChild(div); }});</script>"#,
+        quiz.id,
+        html_escape(&quiz.title),
+        heading,
+        action,
+        html_escape(body_val),
+        err_html,
+        rows_html,
+        active_checked_str,
+        quiz.id
+    );
+    admin_layout(heading, &inner)
+}
