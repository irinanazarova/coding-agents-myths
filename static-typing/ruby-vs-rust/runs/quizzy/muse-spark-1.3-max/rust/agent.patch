+fn render_big_screen_inner(
+    st: &ModGameState,
+    qr_svg: &str,
+    quiz_id: i64,
+) -> (String, String, String) {
+    let _ = quiz_id;
+    if st.status == "lobby" {
+        let body = format!(
+            r##"<div class="lobby"><div><h1 class="lobby__title">{title}</h1><div class="lobby__join">Join at</div><div class="lobby__url" id="join-url">{join}</div><div class="counter-pill" id="players-counter">Players: {n}</div></div><div class="qr" id="qr">{qr}</div></div>"##,
+            title = html_escape(&st.quiz_title),
+            join = html_escape(&st.join_display),
+            n = st.players_count,
+            qr = qr_svg,
+        );
+        let info = format!(r##"<span>Players: {}</span>"##, st.players_count);
+        let btns = r##"<button class="btn btn--pink btn--lg" id="btn-start" type="button">Start</button>"##.to_string();
+        return (body, info, btns);
+    }
+    if st.status == "finished" {
+        // Leaderboard: one <li> per player in order with place, name, points, Winner mark
+        let mut items = String::new();
+        for e in &st.leaderboard {
+            let winner_cls = if e.is_winner { " is-winner" } else { "" };
+            let winner_mark = if e.is_winner {
+                r##"<span class="mark mark--winner">Winner</span>"##.to_string()
+            } else {
+                String::new()
+            };
+            items.push_str(&format!(
+                r##"<li class="leader{winner_cls}"><span class="leader__place">{place}</span><span class="leader__name">{name}</span><span class="leader__score">{pts}</span>{mark}</li>"##,
+                winner_cls = winner_cls,
+                place = e.place,
+                name = html_escape(&e.name),
+                pts = html_escape(&e.points_text),
+                mark = winner_mark,
+            ));
+        }
+        let board = if st.leaderboard.is_empty() {
+            r##"<div class="empty">No players yet.</div>"##.to_string()
+        } else {
+            format!(r##"<ol class="leaderboard" id="leaderboard">{}</ol>"##, items)
+        };
+        let body = format!(
+            r##"<div class="leaderboard-layout"><div><div class="screen__kicker">Results</div><h1 class="leaderboard-layout__title" id="quiz-over">The quiz is over</h1></div><div>{}</div></div>"##,
+            board
+        );
+        let info = format!(
+            r##"<span>Players: {}</span><span>{} winners</span>"##,
+            st.players_count, st.num_winners
+        );
+        let top_label = format!("Top {}", st.num_winners);
+        let btns = format!(
+            r##"<button class="btn btn--pink btn--lg" id="btn-top" type="button">{top}</button><button class="btn btn--light btn--lg" id="btn-draw" type="button">Draw</button><button class="btn btn--ghost btn--lg" id="btn-reset" type="button">Reset winners</button>"##,
+            top = html_escape(&top_label),
+        );
+        return (body, info, btns);
+    }
+    // open or closed
+    let is_results = st.status == "closed";
+    if let Some(q) = &st.question {
+        let num = st.current_number.unwrap_or(1);
+        let total = st.total_questions;
+        let mut opts_html = String::new();
+        for (i, o) in q.options.iter().enumerate() {
+            let l = letter_for(i);
+            let mut cls = String::from("stage-option");
+            if is_results && o.is_correct {
+                cls.push_str(" is-correct");
+            }
+            if is_results {
+                let share = if st.answers_count > 0 {
+                    ((o.count as f64 / st.answers_count as f64) * 100.0).round() as i64
+                } else {
+                    0
+                };
+                let correct_mark = if o.is_correct {
+                    r##"<span class="mark mark--right">Correct</span>"##
+                } else {
+                    ""
+                };
+                opts_html.push_str(&format!(
+                    r##"<li class="{cls}"><span class="stage-option__bar" style="width:{share}%"></span><span class="stage-option__letter">{l}</span><span class="stage-option__title">{body}</span><span class="stage-option__count">{count}</span>{mark}</li>"##,
+                    cls = cls,
+                    share = share,
+                    l = html_escape(&l),
+                    body = html_escape(&o.body),
+                    count = o.count,
+                    mark = correct_mark,
+                ));
+            } else {
+                opts_html.push_str(&format!(
+                    r##"<li class="{cls}"><span class="stage-option__letter">{l}</span><span class="stage-option__title">{body}</span></li>"##,
+                    cls = cls,
+                    l = html_escape(&l),
+                    body = html_escape(&o.body),
+                ));
+            }
+        }
+        let ol_cls = if is_results {
+            "stage-options stage-options--results"
+        } else {
+            "stage-options"
+        };
+        // Timer: only while open with configured duration
+        let timer_html = if st.status == "open" && st.timer_seconds > 0 {
+            if let Some(txt) = &st.remaining_text {
+                format!(
+                    r##"<div class="timer" id="timer">{}</div>"##,
+                    html_escape(txt)
+                )
+            } else {
+                String::new()
+            }
+        } else {
+            String::new()
+        };
+        let body = format!(
+            r##"<div class="stage-question__num" id="q-progress">Question {num} of {total}</div><div class="stage-question__body" id="q-body">{qbody}</div>{timer}<ol class="{ol}" id="q-options">{opts}</ol><div class="answers-counter" id="answers-counter">Answers: {a} / {p}</div>"##,
+            num = num,
+            total = total,
+            qbody = html_escape(&q.body),
+            timer = timer_html,
+            ol = ol_cls,
+            opts = opts_html,
+            a = st.answers_count,
+            p = st.players_count,
+        );
+        let info = format!(
+            r##"<span>Answers: {a} / {p}</span>"##,
+            a = st.answers_count,
+            p = st.players_count
+        );
+        let btns = if st.status == "open" {
+            r##"<button class="btn btn--pink btn--lg" id="btn-finish" type="button">Finish</button>"##.to_string()
+        } else if st.is_last {
+            r##"<button class="btn btn--pink btn--lg" id="btn-end" type="button">End quiz</button>"##.to_string()
+        } else {
+            r##"<button class="btn btn--pink btn--lg" id="btn-next" type="button">Next</button>"##.to_string()
+        };
+        return (body, info, btns);
+    }
+    // fallback: no question but open/closed? treat as over?
+    let body = r##"<div class="stage-question__body" id="quiz-over">The quiz is over</div>"##.to_string();
+    (body, String::new(), String::new())
+}
