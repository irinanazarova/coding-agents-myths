+fn find_player_for_game(
+    conn: &Connection,
+    game: &Game,
+    headers: &HeaderMap,
+    query_token: Option<&str>,
+) -> Option<Player> {
+    if let Some(qt) = query_token {
+        let q = qt.trim();
+        if !q.is_empty() {
+            if let Some(p) = get_player_by_token(conn, game.id, q) {
+                return Some(p);
+            }
+            // try decoded
+            let dec = percent_decode(q);
+            if dec != q {
+                if let Some(p) = get_player_by_token(conn, game.id, &dec) {
+                    return Some(p);
+                }
+            }
+        }
+    }
+    if let Some(v) = headers.get("x-player-token") {
+        if let Ok(s) = v.to_str() {
+            let s = s.trim();
+            if !s.is_empty() {
+                if let Some(p) = get_player_by_token(conn, game.id, s) {
+                    return Some(p);
+                }
+            }
+        }
+    }
+    let cookies = parse_cookies(headers);
+    let code = &game.code;
+    for key in [
+        format!("quizzy_{}", code),
+        format!("qz_{}", code),
+        "quizzy_player".to_string(),
+        "player_token".to_string(),
+        "player".to_string(),
+    ] {
+        if let Some(v) = cookies.get(&key) {
+            let vv = v.trim().trim_matches('"');
+            if let Some(p) = get_player_by_token(conn, game.id, vv) {
+                return Some(p);
+            }
+            let dec = percent_decode(vv);
+            if dec != vv {
+                if let Some(p) = get_player_by_token(conn, game.id, &dec) {
+                    return Some(p);
+                }
+            }
+        }
+    }
+    for v in cookies.values() {
+        if v.len() > 200 {
+            continue;
+        }
+        let vv = v.trim().trim_matches('"');
+        if let Some(p) = get_player_by_token(conn, game.id, vv) {
+            return Some(p);
+        }
+        let dec = percent_decode(vv);
+        if dec != vv {
+            if let Some(p) = get_player_by_token(conn, game.id, &dec) {
+                return Some(p);
+            }
+        }
+    }
+    None
+}
