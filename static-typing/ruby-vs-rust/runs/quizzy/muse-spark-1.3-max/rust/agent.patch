+async fn move_question_handler(
+    State(state): State<AppState>,
+    Path((id, qid)): Path<(i64, i64)>,
+    up: bool,
+) -> Response {
+    let conn = db_connect(&state).unwrap();
+    let questions = list_questions(&conn, id);
+    let pos = questions.iter().position(|q| q.id == qid);
+    if let Some(idx) = pos {
+        if up && idx > 0 {
+            let cur = &questions[idx];
+            let prev = &questions[idx - 1];
+            conn.execute(
+                "UPDATE questions SET position=?1 WHERE id=?2",
+                params![prev.position, cur.id],
+            )
+            .unwrap();
+            conn.execute(
+                "UPDATE questions SET position=?1 WHERE id=?2",
+                params![cur.position, prev.id],
+            )
+            .unwrap();
+            // If positions equal (shouldn't), ensure order by swapping with offset
+            if cur.position == prev.position {
+                conn.execute(
+                    "UPDATE questions SET position = position + 1 WHERE id=?1",
+                    params![prev.id],
+                )
+                .unwrap();
+            }
+        } else if !up && idx + 1 < questions.len() {
+            let cur = &questions[idx];
+            let next = &questions[idx + 1];
+            conn.execute(
+                "UPDATE questions SET position=?1 WHERE id=?2",
+                params![next.position, cur.id],
+            )
+            .unwrap();
+            conn.execute(
+                "UPDATE questions SET position=?1 WHERE id=?2",
+                params![cur.position, next.id],
+            )
+            .unwrap();
+            if cur.position == next.position {
+                conn.execute(
+                    "UPDATE questions SET position = position - 1 WHERE id=?1",
+                    params![next.id],
+                )
+                .unwrap();
+            }
+        }
+    }
+    Redirect::to(&format!("/moderate/quizzes/{}", id)).into_response()
+}
+
+async fn move_up_handler(
+    State(state): State<AppState>,
+    Path((id, qid)): Path<(i64, i64)>,
