+async fn toggle_active_handler(
+    State(state): State<AppState>,
+    Path((id, qid)): Path<(i64, i64)>,
+    req: axum::extract::Request,
+) -> impl IntoResponse {
+    // Parse form manually to handle empty body
+    let (_parts, body) = req.into_parts();
+    let bytes = axum::body::to_bytes(body, 1024 * 1024).await.unwrap_or_default();
+    let body_str = String::from_utf8_lossy(&bytes).to_string();
+    // Parse urlencoded
+    let mut active_present = false;
+    // Also need to handle _form? Just check for active=
+    // Simple parse: split & then =
+    for pair in body_str.split('&') {
+        let (k, _v) = pair.split_once('=').unwrap_or((pair, ""));
+        // decode percent? For our purpose, k == "active" is enough (no encoding)
+        // Use serde_urlencoded for robustness? Do manual decode of + and %?
+        let key = percent_decode(k);
+        if key == "active" {
+            active_present = true;
+            break;
+        }
+    }
+    // If body empty and no active, it means unchecked. But what if request had no body at all?
+    // That's also unchecked. Good.
+    // However, if the form was submitted with checkbox checked, active_present will be true.
+    // If unchecked, false.
+    // Edge: if client sends no Content-Type and empty, still false.
+    let conn = db_connect(&state).unwrap();
+    // Verify question belongs to quiz
+    if get_question(&conn, id, qid).is_none() {
+        return (StatusCode::NOT_FOUND, Html(admin_layout("Not found", "<h1>Question not found</h1>"))).into_response();
+    }
+    conn.execute(
+        "UPDATE questions SET active=?1 WHERE id=?2",
+        params![if active_present { 1 } else { 0 }, qid],
+    )
+    .unwrap();
+    Redirect::to(&format!("/moderate/quizzes/{}", id)).into_response()
+}
+
+fn percent_decode(s: &str) -> String {
+    let mut out = String::new();
+    let mut chars = s.chars().peekable();
+    while let Some(c) = chars.next() {
+        if c == '+' {
+            out.push(' ');
+        } else if c == '%' {
+            let h1 = chars.next().unwrap_or('0');
+            let h2 = chars.next().unwrap_or('0');
+            let hex = format!("{}{}", h1, h2);
+            if let Ok(b) = u8::from_str_radix(&hex, 16) {
+                out.push(b as char);
+            } else {
+                out.push('%');
+                out.push(h1);
+                out.push(h2);
+            }
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
