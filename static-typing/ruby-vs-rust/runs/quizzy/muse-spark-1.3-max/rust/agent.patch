+// ---------- auth ----------
+async fn auth_middleware(State(state): State<AppState>, req: axum::extract::Request, next: Next) -> Response {
+    let path = req.uri().path().to_string();
+    if !path.starts_with("/moderate") {
+        return next.run(req).await;
+    }
+    let headers = req.headers().clone();
+    let ok_basic = check_basic(&headers, &state.mod_user, &state.mod_pass);
+    // check session cookie
+    let mut has_valid_session = false;
+    for val in headers.get_all(header::COOKIE) {
+        if let Ok(s) = val.to_str() {
+            for part in s.split(';') {
+                let part = part.trim();
+                if let Some((k, v)) = part.split_once('=') {
+                    let k = k.trim();
+                    let v = v.trim().trim_matches('"').to_string();
+                    if k == "quizzy_mod" {
+                        if let Ok(set) = state.sessions.lock() {
+                            if set.contains(&v) {
+                                has_valid_session = true;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    if ok_basic {
+        // ensure session cookie set for fetch() polling (browsers may not send Basic for fetch)
+        let need_new = !has_valid_session;
+        let token_to_set: Option<String> = if need_new {
+            let tok = generate_player_token();
+            if let Ok(mut set) = state.sessions.lock() {
+                set.insert(tok.clone());
+                // cap size to avoid unbounded growth
+                if set.len() > 10000 {
+                    // clear old? just keep recent 5000 (approx by draining)
+                    let to_remove: Vec<String> = set.iter().take(set.len() - 5000).cloned().collect();
+                    for r in to_remove {
+                        set.remove(&r);
+                    }
+                }
+            }
+            Some(tok)
+        } else {
+            None
+        };
+        let mut resp = next.run(req).await;
+        if let Some(tok) = token_to_set {
+            let cookie_val = format!("quizzy_mod={}; Path=/; HttpOnly; SameSite=Lax; Max-Age=86400", tok);
+            resp.headers_mut().append(header::SET_COOKIE, cookie_val.parse().unwrap());
+        }
+        return resp;
+    }
+    if has_valid_session {
+        return next.run(req).await;
+    }
+    (
+        StatusCode::UNAUTHORIZED,
+        [(header::WWW_AUTHENTICATE, "Basic realm=\"Moderator\"")],
+        "Unauthorized",
+    )
+        .into_response()
+}
+
+fn check_basic(headers: &HeaderMap, user: &str, pass: &str) -> bool {
+    let Some(val) = headers.get(header::AUTHORIZATION) else {
+        return false;
+    };
+    let Ok(s) = val.to_str() else {
+        return false;
+    };
+    let Some(b64) = s.strip_prefix("Basic ") else {
+        return false;
+    };
+    let Ok(decoded) = BASE64.decode(b64.trim()) else {
+        return false;
+    };
+    let Ok(creds) = String::from_utf8(decoded) else {
+        return false;
+    };
+    let Some((u, p)) = creds.split_once(':') else {
+        return false;
+    };
+    // constant-time-ish compare not needed but do simple
+    u == user && p == pass
+}
