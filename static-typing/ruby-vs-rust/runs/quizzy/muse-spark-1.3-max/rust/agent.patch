+async fn delete_quiz_handler(
+    State(state): State<AppState>,
+    Path(id): Path<i64>,
+) -> impl IntoResponse {
+    let conn = db_connect(&state).unwrap();
+    // delete options, questions, quiz (cascade should handle but do manually for safety)
+    let questions = list_questions(&conn, id);
+    for q in questions {
+        conn.execute("DELETE FROM options WHERE question_id=?1", params![q.id])
+            .unwrap();
+    }
+    conn.execute("DELETE FROM questions WHERE quiz_id=?1", params![id])
+        .unwrap();
+    conn.execute("DELETE FROM quizzes WHERE id=?1", params![id])
+        .unwrap();
+    Redirect::to("/moderate").into_response()
+}
