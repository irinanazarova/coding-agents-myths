+async fn create_question_handler(
+    State(state): State<AppState>,
+    Path(id): Path<i64>,
+    Form(form): Form<HashMap<String, String>>,
+) -> impl IntoResponse {
+    let conn = db_connect(&state).unwrap();
+    let Some(quiz) = get_quiz(&conn, id) else {
+        return (StatusCode::NOT_FOUND, Html(admin_layout("Not found", "<h1>Quiz not found</h1>"))).into_response();
+    };
+    let (body, active, filtered, raw_keep) = parse_question_form(&form);
+    let mut errors: Vec<String> = Vec::new();
+    if body.trim().is_empty() {
+        errors.push("Question can't be blank".to_string());
+    }
+    if filtered.len() < 2 {
+        errors.push("Add at least two options".to_string());
+    }
+    if filtered.iter().filter(|r| r.is_correct).count() == 0 {
+        // Only check if we have at least 2? Spec says at least one must be correct. Show even if <2? Probably show both if both fail.
+        errors.push("Mark at least one option as correct".to_string());
+    }
+    // If body empty, we still check options? Yes.
+    if !errors.is_empty() {
+        // keep what typed: use raw_keep if not empty, else 4 empty
+        let rows = if raw_keep.is_empty() {
+            vec![
+                (String::new(), false),
+                (String::new(), false),
+                (String::new(), false),
+                (String::new(), false),
+            ]
+        } else {
+            raw_keep
+        };
+        // For active checkbox: preserve submitted active? parse already gives active bool.
+        let html = render_question_form(
+            &quiz,
+            &format!("/moderate/quizzes/{}/questions", id),
+            "New question",
+            &body,
+            // If form had no active key, it was unchecked; but need to preserve: active bool already reflects that.
+            // However, if form missing active due to unchecked, active=false, so unchecked. Good.
+            active,
+            &rows,
+            &errors,
+        );
+        return Html(html).into_response();
+    }
+    // save
+    let pos: i64 = conn
+        .query_row(
+            "SELECT COALESCE(MAX(position), 0) + 1 FROM questions WHERE quiz_id=?1",
+            params![id],
+            |r| r.get(0),
+        )
+        .unwrap_or(1);
+    conn.execute(
+        "INSERT INTO questions (quiz_id, body, active, position) VALUES (?1, ?2, ?3, ?4)",
+        params![id, body.trim(), if active { 1 } else { 0 }, pos],
+    )
+    .unwrap();
+    let qid = conn.last_insert_rowid();
+    for (i, opt) in filtered.iter().enumerate() {
+        conn.execute(
+            "INSERT INTO options (question_id, body, is_correct, position) VALUES (?1, ?2, ?3, ?4)",
