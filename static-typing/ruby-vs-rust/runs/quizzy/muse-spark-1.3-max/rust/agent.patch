+        );
+        CREATE TABLE IF NOT EXISTS players (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            name TEXT NOT NULL,
+            token TEXT NOT NULL UNIQUE,
+            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
+        );
+        CREATE TABLE IF NOT EXISTS answers (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            player_id INTEGER NOT NULL REFERENCES players(id) ON DELETE CASCADE,
+            question_id INTEGER NOT NULL REFERENCES questions(id) ON DELETE CASCADE,
+            option_id INTEGER NOT NULL REFERENCES options(id) ON DELETE CASCADE,
+            answered_at INTEGER,
+            elapsed_ms INTEGER,
+            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+            UNIQUE(player_id, question_id)
+        );
+        CREATE INDEX IF NOT EXISTS idx_games_code ON games(code);
+        CREATE INDEX IF NOT EXISTS idx_games_quiz ON games(quiz_id);
+        CREATE INDEX IF NOT EXISTS idx_players_game ON players(game_id);
+        CREATE INDEX IF NOT EXISTS idx_players_token ON players(token);
+        CREATE INDEX IF NOT EXISTS idx_answers_game_q ON answers(game_id, question_id);
+        CREATE INDEX IF NOT EXISTS idx_answers_player_q ON answers(player_id, question_id);
+        CREATE TABLE IF NOT EXISTS game_winners (
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            player_id INTEGER NOT NULL REFERENCES players(id) ON DELETE CASCADE,
+            PRIMARY KEY(game_id, player_id)
+        );
+        CREATE INDEX IF NOT EXISTS idx_winners_game ON game_winners(game_id);
+        ",
+    )
+    .expect("migrate");
+    // --- migrations for existing DBs (added for prizes/scoring) ---
+    if !column_exists(&conn, "quizzes", "num_winners") {
+        let _ = conn.execute(
+            "ALTER TABLE quizzes ADD COLUMN num_winners INTEGER NOT NULL DEFAULT 3",
+            [],
+        );
+    }
+    let _ = conn.execute(
+        "UPDATE quizzes SET num_winners=3 WHERE num_winners IS NULL OR num_winners < 1",
+        [],
+    );
+    if !column_exists(&conn, "quizzes", "timer_minutes") {
+        let _ = conn.execute(
+            "ALTER TABLE quizzes ADD COLUMN timer_minutes INTEGER NOT NULL DEFAULT 0",
+            [],
+        );
+    }
+    if !column_exists(&conn, "quizzes", "timer_seconds") {
+        let _ = conn.execute(
+            "ALTER TABLE quizzes ADD COLUMN timer_seconds INTEGER NOT NULL DEFAULT 0",
+            [],
+        );
+    }
+    let _ = conn.execute(
+        "UPDATE quizzes SET timer_minutes=0 WHERE timer_minutes IS NULL OR timer_minutes < 0",
+        [],
+    );
+    let _ = conn.execute(
+        "UPDATE quizzes SET timer_seconds=0 WHERE timer_seconds IS NULL OR timer_seconds < 0",
+        [],
+    );
+    if !column_exists(&conn, "games", "question_opened_at") {
+        let _ = conn.execute("ALTER TABLE games ADD COLUMN question_opened_at INTEGER", []);
+    }
+    if !column_exists(&conn, "answers", "answered_at") {
+        let _ = conn.execute("ALTER TABLE answers ADD COLUMN answered_at INTEGER", []);
+    }
+    if !column_exists(&conn, "answers", "elapsed_ms") {
+        let _ = conn.execute("ALTER TABLE answers ADD COLUMN elapsed_ms INTEGER", []);
+    }
+    let _ = conn.execute_batch(
+        "CREATE TABLE IF NOT EXISTS game_winners (
+            game_id INTEGER NOT NULL REFERENCES games(id) ON DELETE CASCADE,
+            player_id INTEGER NOT NULL REFERENCES players(id) ON DELETE CASCADE,
+            PRIMARY KEY(game_id, player_id)
+        );
+        CREATE INDEX IF NOT EXISTS idx_winners_game ON game_winners(game_id);",
+    );
+}
