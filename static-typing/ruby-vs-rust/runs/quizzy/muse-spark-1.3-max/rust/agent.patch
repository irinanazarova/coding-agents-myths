+async fn player_join_handler(
+    State(state): State<AppState>,
+    Path(code): Path<String>,
+    Query(query): Query<HashMap<String, String>>,
+    req: axum::extract::Request,
+) -> impl IntoResponse {
+    let (parts, body) = req.into_parts();
+    let headers = parts.headers;
+    let bytes = axum::body::to_bytes(body, 1024 * 1024).await.unwrap_or_default();
+    let body_str = String::from_utf8_lossy(&bytes).to_string();
+    let content_type = headers
+        .get(header::CONTENT_TYPE)
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or("")
+        .to_string();
+    // parse name from body (urlencoded or json) or query?
+    let mut name_opt: Option<String> = None;
+    if content_type.contains("application/json") {
+        if let Ok(v) = serde_json::from_str::<serde_json::Value>(&body_str) {
+            if let Some(n) = v.get("name").and_then(|x| x.as_str()) {
+                name_opt = Some(n.to_string());
+            } else if let Some(n) = v.get("player_name").and_then(|x| x.as_str()) {
+                name_opt = Some(n.to_string());
+            }
+        }
+        // also try query?
+        if name_opt.is_none() {
+            if let Some(n) = query.get("name") {
+                name_opt = Some(n.clone());
+            }
+        }
+    } else {
+        let map = parse_urlencoded_body(&body_str);
+        if let Some(n) = map.get("name") {
+            name_opt = Some(n.clone());
+        } else if let Some(n) = map.get("player_name") {
+            name_opt = Some(n.clone());
+        } else if let Some(n) = map.get("player[name]") {
+            name_opt = Some(n.clone());
+        }
+        if name_opt.is_none() {
+            if let Some(n) = query.get("name") {
+                name_opt = Some(n.clone());
+            }
+        }
+    }
+    let conn = db_connect(&state).unwrap();
+    let Some(game_raw) = get_game_by_code(&conn, &code) else {
+        if wants_json(&headers) {
+            return (StatusCode::NOT_FOUND, axum::Json(serde_json::json!({"error":"not found"}))).into_response();
+        } else {
+            return (StatusCode::NOT_FOUND, Html("<h1>Game not found</h1>".to_string())).into_response();
+        }
+    };
+    let quiz_for_expiry_join = get_quiz(&conn, game_raw.quiz_id).unwrap_or(Quiz { id: game_raw.quiz_id, title: String::new(), num_winners: 3, timer_minutes: 0, timer_seconds: 0 });
+    let game = maybe_auto_finish(&conn, &game_raw, &quiz_for_expiry_join);
+    if game.status == "finished" {
+        if wants_json(&headers) {
+            return (
+                StatusCode::FORBIDDEN,
+                axum::Json(serde_json::json!({"error":"The quiz is over"})),
+            )
+                .into_response();
+        } else {
+            return Redirect::to(&format!("/play/{}", game.code)).into_response();
+        }
+    }
+    // if already joined (via token), return existing? Check token from headers/query/body?
+    // Try to find existing player: token from query, header, cookie, or body token?
+    let mut body_token: Option<String> = None;
+    if content_type.contains("application/json") {
+        if let Ok(v) = serde_json::from_str::<serde_json::Value>(&body_str) {
+            if let Some(t) = v.get("token").and_then(|x| x.as_str()) {
+                body_token = Some(t.to_string());
+            }
+        }
+    } else {
+        let map = parse_urlencoded_body(&body_str);
+        if let Some(t) = map.get("token") {
+            body_token = Some(t.clone());
+        }
+    }
+    let qt = query
+        .get("token")
+        .cloned()
+        .or(body_token)
+        .or_else(|| None);
+    let existing: Option<Player> = find_player_for_game(&conn, &game, &headers, qt.as_deref());
+    // If name missing/blank but already joined, just return existing (for polling with join? no)
+    let raw_name = name_opt.unwrap_or_default();
+    let trimmed = raw_name.trim().to_string();
+    if trimmed.is_empty() {
+        // if already joined, return existing token (helps JS that posts empty? no)
+        if let Some(p) = existing {
+            if wants_json(&headers) {
+                let cookie_val = format!("quizzy_{}={}; Path=/; Max-Age=31536000; SameSite=Lax", game.code, p.token);
+                return (
+                    StatusCode::OK,
+                    [(header::SET_COOKIE, cookie_val)],
+                    axum::Json(serde_json::json!({"ok":true, "name": p.name, "token": p.token})),
+                )
+                    .into_response();
+            } else {
+                return Redirect::to(&format!("/play/{}", game.code)).into_response();
+            }
+        }
+        if wants_json(&headers) {
+            return (
+                StatusCode::UNPROCESSABLE_ENTITY,
+                axum::Json(serde_json::json!({"error":"Name can't be blank"})),
+            )
+                .into_response();
+        } else {
+            // re-render with error? Simplest redirect back (form has required, so this rarely happens)
+            return Redirect::to(&format!("/play/{}", game.code)).into_response();
+        }
+    }
+    // truncate name to 50 chars
+    let mut final_name = trimmed;
+    if final_name.chars().count() > 50 {
+        final_name = final_name.chars().take(50).collect();
+    }
+    // If already joined with same token, update name? Or create new? If existing found and name matches? Actually if browser already has token, they shouldn't re-join; but if they submit join form again with different name, should we create new player or update? Spec: browser remembers player: opening join link again continues as same player. That implies if token exists, we should NOT create new, just continue. But if they explicitly submit join form again (with token still present?), should we treat as new? Our player page for joined doesn't show join form, so they can't submit again unless they clear storage? Edge: if they clear localStorage but cookie remains, they'd still be recognized via cookie and see waiting, not join form. So join handler with existing token + new name is rare. Simplest: if existing found, update its name to new name and return same token (so name change works). Or create new? Let's update.
+    if let Some(p) = existing {
+        // update name if different
+        if p.name != final_name {
+            conn.execute("UPDATE players SET name=?1 WHERE id=?2", params![final_name, p.id]).unwrap();
+        }
+        let updated = get_player_by_token(&conn, game.id, &p.token).unwrap_or(p);
+        if wants_json(&headers) {
+            let cookie_val = format!("quizzy_{}={}; Path=/; Max-Age=31536000; SameSite=Lax", game.code, updated.token);
+            return (
+                StatusCode::OK,
+                [(header::SET_COOKIE, cookie_val)],
+                axum::Json(serde_json::json!({"ok":true, "name": updated.name, "token": updated.token})),
+            )
+                .into_response();
+        } else {
+            let cookie_val = format!("quizzy_{}={}; Path=/; Max-Age=31536000; SameSite=Lax", game.code, updated.token);
+            return (
+                StatusCode::SEE_OTHER,
+                [(header::SET_COOKIE, cookie_val), (header::LOCATION, format!("/play/{}", game.code))],
+                "",
+            )
+                .into_response();
+        }
+    }
+    // create new player
+    // ensure token unique
+    let token = loop {
+        let t = generate_player_token();
+        let cnt: i64 = conn
+            .query_row("SELECT COUNT(*) FROM players WHERE token=?1", params![t], |r| r.get(0))
+            .unwrap_or(1);
+        if cnt == 0 {
+            break t;
+        }
+    };
+    conn.execute(
+        "INSERT INTO players (game_id, name, token) VALUES (?1, ?2, ?3)",
+        params![game.id, final_name, token],
+    )
+    .unwrap();
+    if wants_json(&headers) {
+        let cookie_val = format!("quizzy_{}={}; Path=/; Max-Age=31536000; SameSite=Lax", game.code, token);
+        (
+            StatusCode::OK,
+            [(header::SET_COOKIE, cookie_val)],
+            axum::Json(serde_json::json!({"ok":true, "name": final_name, "token": token})),
+        )
+            .into_response()
+    } else {
+        let cookie_val = format!("quizzy_{}={}; Path=/; Max-Age=31536000; SameSite=Lax", game.code, token);
+        (
+            StatusCode::SEE_OTHER,
+            [(header::SET_COOKIE, cookie_val), (header::LOCATION, format!("/play/{}", game.code))],
+            "",
+        )
+            .into_response()
+    }
+}
